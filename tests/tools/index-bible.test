#!/bin/sh
# Test for `tools/tpt index-bible`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="index-bible"
tracked="$repo/src/sources/bibles/douay-rheims/index.yaml"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

# The tracked index is current: a rebuild reproduces it byte for byte.
run_tool check >/dev/null

# A build is deterministic, and it never touches the repository when it is
# pointed somewhere else.
run_tool build --bible-root "$sandbox/one" >/dev/null
run_tool build --bible-root "$sandbox/two" >/dev/null
if ! cmp -s "$sandbox/one/douay-rheims/index.yaml" "$sandbox/two/douay-rheims/index.yaml"; then
	echo "build output is not byte-stable across runs" >&2
	exit 1
fi
if ! cmp -s "$sandbox/one/douay-rheims/index.yaml" "$tracked"; then
	echo "a fresh build does not match the tracked index" >&2
	exit 1
fi

# The index declares the contract mass-propers enforces before resolving.
for want in "schema: triptych-bible-index/v1" "rights: public-domain" \
	"publishable: true" "numbering: vulgate"; do
	if ! grep -q "^$want\$" "$tracked"; then
		echo "the index is missing $want" >&2
		exit 1
	fi
done

# No Project Gutenberg boilerplate may reach a tracked index.
if grep -qi "gutenberg-tm\|START OF THE PROJECT GUTENBERG\|Project Gutenberg License\|gutenberg.org/license" "$tracked"; then
	echo "licence boilerplate leaked into the index" >&2
	exit 1
fi

# The Advent introit is the standing proof that a citation resolves end to end:
# Ad te levavi is Vulgate Psalm 24 and Hebrew Psalm 25.
# The reading view wraps, so compare against a single flattened line.
introit="$("$tool" mass-propers --calendar roman-1962 --mass advent-1 --bible douay-rheims |
	tr '\n' ' ' | tr -s ' ')"
case "$introit" in
*"have I lifted up my soul"*) ;;
*) echo "the 1962 introit did not resolve to its verse text" >&2; exit 1 ;;
esac
crossed="$("$tool" mass-propers --calendar postconciliar --mass advent-1 --bible douay-rheims |
	tr '\n' ' ' | tr -s ' ')"
case "$crossed" in
*"have I lifted up my soul"*) ;;
*) echo "the converted postconciliar citation did not resolve" >&2; exit 1 ;;
esac

# A citation the postconciliar calendar makes in Nova Vulgata numbering resolves
# through its recorded override, not to whatever the Vulgate prints at those
# numbers: Joel 3:1-5 is the outpoured spirit, never the valley of Josaphat.
vigil="$("$tool" mass-propers --calendar postconciliar --mass pentecost --bible douay-rheims |
	tr '\n' ' ' | tr -s ' ')"
case "$vigil" in
*"I will pour out my spirit upon all flesh"*) ;;
*) echo "the Pentecost vigil Joel citation did not resolve to its own text" >&2; exit 1 ;;
esac
case "$vigil" in
*"valley of Josaphat"*)
	echo "the Joel citation still resolves to the Vulgate text at those numbers" >&2
	exit 1 ;;
esac

# The overrides are validated against the calendar, not trusted: one that has
# stopped addressing real text fails the build rather than silently lapsing.
mkdir -p cal
cp -R "$repo/src/sources/calendars/roman-1962" cal/
mkdir -p cal/postconciliar
sed 's|"Joel 3:1-5": "Joel 2:28-32"|"Joel 3:1-5": "Joel 9:1"|' \
	"$repo/src/sources/calendars/postconciliar/propers.yaml" >cal/postconciliar/propers.yaml
status=0
run_tool build --root cal --bible-root "$sandbox/broken" >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "an override addressing no text should exit 2, got $status" >&2
	exit 1
fi

# An override naming a reference the calendar no longer cites is equally dead.
sed 's|"Joel 3:1-5": "Joel 2:28-32"|"Joel 3:2-6": "Joel 2:28-32"|' \
	"$repo/src/sources/calendars/postconciliar/propers.yaml" >cal/postconciliar/propers.yaml
status=0
run_tool build --root cal --bible-root "$sandbox/dead" >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "an override for an uncited reference should exit 2, got $status" >&2
	exit 1
fi

# A divergent citation with no override refuses: it is reported unresolved and
# kept out of the index, because a plausible wrong verse is worse than none.
sed '/"Joel 3:1-5": "Joel 2:28-32"/d' \
	"$repo/src/sources/calendars/postconciliar/propers.yaml" >cal/postconciliar/propers.yaml
run_tool build --root cal --bible-root "$sandbox/bare" --verbose >bare.txt 2>&1
if ! grep -q "unresolved postconciliar Joel 3:1-5" bare.txt; then
	echo "an unrecorded divergent citation was not reported unresolved" >&2
	exit 1
fi
if grep -q "valley of Josaphat" "$sandbox/bare/douay-rheims/index.yaml"; then
	echo "a refused citation still put the wrong verse in the index" >&2
	exit 1
fi

# Machine form is one key-sorted object and reports the coverage it achieved.
run_tool check --format json >one.json
run_tool check --format json >two.json
if ! cmp -s one.json two.json; then
	echo "json output is not byte-stable across runs" >&2
	exit 1
fi
for want in '"passages"' '"calendars"' '"roman-1962"' '"unresolved"'; do
	if ! grep -q "$want" one.json; then
		echo "payload is missing $want" >&2
		exit 1
	fi
done

# A stale index is reported rather than silently accepted.
mkdir -p stale/douay-rheims
sed 's/^numbering: vulgate$/numbering: hebrew/' "$tracked" >stale/douay-rheims/index.yaml
status=0
run_tool check --bible-root stale >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "a stale index should exit 2, got $status" >&2
	exit 1
fi
status=0
run_tool check --bible-root missing >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "an absent index should exit 2, got $status" >&2
	exit 1
fi

# An edition with no source record is refused by name rather than half-built.
status=0
run_tool build --bible no-such-bible --bible-root "$sandbox/none" >/dev/null 2>&1 || status=$?
if [ "$status" -ne 3 ]; then
	echo "an unknown edition should exit 3, got $status" >&2
	exit 1
fi
if [ -e "$sandbox/none" ]; then
	echo "a refused build must not create an output directory" >&2
	exit 1
fi

if run_tool check --format nonesuch >/dev/null 2>&1; then
	echo "expected failure for an unknown format" >&2
	exit 1
fi

echo ok
