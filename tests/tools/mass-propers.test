#!/bin/sh
# Test for `tools/tpt mass-propers`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="mass-propers"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

# The reading view names the mass, its edition, and every proper slot.
out="$(run_tool --calendar roman-1962 --mass advent-1)"
for want in "First Sunday of Advent" "Missale Romanum" "Introit" "Collect" "Excita, quaesumus"; do
	case "$out" in
	*"$want"*) ;;
	*) echo "reading view is missing $want" >&2; exit 1 ;;
	esac
done

# Scripture propers show their reference; without a bible there is no verse text.
case "$out" in
*"Psalm 24:1-3"*) ;;
*) echo "scripture proper did not print its reference" >&2; exit 1 ;;
esac

# The recorded English reaches this verb, by the same merge the browser gets.
# This assertion used to read the other way -- it required the fallback note
# here -- and it passed because only `structure` merged the sidecar, so the
# reading view answered "no en translation recorded" over an oration whose
# English the site was publishing. The test encoded the defect.
english="$(run_tool --calendar roman-1962 --mass advent-1 --lang en)"
case "$english" in
*"Exert, we beseech thee, O Lord, thy power, and come"*) ;;
*) echo "recorded English did not reach the reading view" >&2; exit 1 ;;
esac

# Latin is the tracked text, so a language nothing records falls back and says so.
absent="$(run_tool --calendar roman-1962 --mass advent-1 --lang fr)"
case "$absent" in
*"no fr translation recorded"*) ;;
*) echo "expected a note when the requested language is absent" >&2; exit 1 ;;
esac

# A proper deliberately left without English says so, rather than reading as a gap.
# Asked of postconciliar/advent-1 until its English was filled in: that calendar's
# `untranslated` ledger is now empty, so nothing in it can demonstrate the state
# and the assertion tested the absence of a ledger rather than the note. The
# 1962 overlay still ledgers 66 slots, and several masses are tried so that
# translating one of them does not turn this red.
deliberate=""
for mass in commemoratione-omnium-fidelium-defunctorum commune-summorum-pontificum \
	good-friday easter-vigil; do
	found="$(run_tool --calendar roman-1962 --mass "$mass" --lang en)"
	case "$found" in
	*"no en recorded, deliberately"*)
		deliberate="$found"
		break
		;;
	esac
done
if [ -z "$deliberate" ]; then
	echo "ledgered untranslated proper did not say it was deliberate" >&2
	exit 1
fi

# Machine forms carry the record only; rendering options stay off the payload.
run_tool --calendar roman-1962 --mass advent-1 --format json >one.json
run_tool --calendar roman-1962 --mass advent-1 --format json >two.json
if ! cmp -s one.json two.json; then
	echo "json output is not byte-stable across runs" >&2
	exit 1
fi
# Asserted at the top level and not by grepping the document. `lang` is also a
# FIELD of every recorded translation, and those are part of the record: once
# this verb merged the sidecar, a whole-file grep for '"lang"' condemned the
# data it was meant to protect. What must stay off the payload is the OPTION.
python3 - one.json <<'PY'
import json, sys
payload = json.load(open(sys.argv[1]))
for leaked in ("bible", "lang", "witness"):
    if leaked in payload:
        raise SystemExit(f"rendering option {leaked!r} leaked into the payload")
PY
for want in '"calendar"' '"mass"' '"edition"'; do
	if ! grep -q "$want" one.json; then
		echo "payload is missing $want" >&2
		exit 1
	fi
done

run_tool --calendar roman-1962 --mass advent-1 --format yaml | grep -q '^calendar: roman-1962'

# `list` reports every mass in the canonical container, and is byte-stable.
run_tool list --calendar roman-1962 >first.txt 2>/dev/null
run_tool list --calendar roman-1962 >second.txt 2>/dev/null
if ! cmp -s first.txt second.txt; then
	echo "list output is not byte-stable across runs" >&2
	exit 1
fi
count="$(wc -l <first.txt | tr -d ' ')"
# A floor, not an exact count: the temporal cycle is still being filled in, so
# this guards against losing masses without breaking every time one is added.
if [ "$count" -lt 334 ]; then
	echo "expected at least 334 masses in the 1962 calendar, got $count" >&2
	exit 1
fi
if ! grep -q 'advent-1' first.txt; then
	echo "list omitted a seasonal mass" >&2
	exit 1
fi

# Failures are distinguishable: unknown mass is not-found, bad input is input.
if run_tool --calendar roman-1962 --mass no-such-mass >/dev/null 2>&1; then
	echo "expected failure for an unknown mass key" >&2
	exit 1
fi
run_tool --calendar roman-1962 --mass no-such-mass >/dev/null 2>&1 || status=$?
if [ "${status:-0}" -ne 3 ]; then
	echo "unknown mass should exit 3, got ${status:-0}" >&2
	exit 1
fi

# A Vulgate bible resolves a Vulgate calendar's citation as written.
mkdir -p bibles/vg
cat >bibles/vg/index.yaml <<'YAML'
schema: triptych-bible-index/v1
edition: Demo
source_id: work.demo
rights: public-domain
publishable: true
numbering: vulgate
passages:
  'Psalm 24:1-3': 'To thee, O Lord, have I lifted up my soul.'
  'Psalm 146': 'Praise ye the Lord, because psalm is good.'
  'Psalm 147': 'Praise the Lord, O Jerusalem.'
YAML
if ! run_tool --calendar roman-1962 --mass advent-1 --bible vg --bible-root bibles |
	grep -q 'lifted up my soul'; then
	echo "matching numbering should resolve the verse" >&2
	exit 1
fi

# The same chant is Psalm 25 in the postconciliar missal and Psalm 24 in the
# Vulgate; the citation is converted, not refused.
crossed="$(run_tool --calendar postconciliar --mass advent-1 --bible vg --bible-root bibles)"
case "$crossed" in
*"lifted up my soul"*) ;;
*) echo "hebrew citation was not resolved against a vulgate bible" >&2; exit 1 ;;
esac
# The missal's own citation stands, with the bible's chapter named beside it.
case "$crossed" in
*"Psalm 25:1-3"*"vulgate: Psalm 24:1-3"*) ;;
*) echo "the conversion was not shown beside the calendar's citation" >&2; exit 1 ;;
esac

# A split psalm cited without a verse is reported, never guessed at.
mkdir -p calendars/demo-hebrew
cat >calendars/demo-hebrew/propers.yaml <<'YAML'
edition: Demo Missal
psalm_numbering: hebrew
sections:
  '01':
    kind: seasonal
    masses:
    - key: split
      name: Ambiguous Split
      propers:
      - name: Introit
        source: scripture
        verses:
        - book: Psalms
          ranges:
          - begin: {chapter: 147}
          ref: Psalm 147
YAML
split="$(run_tool --root calendars --calendar demo-hebrew --mass split --bible vg --bible-root bibles)"
case "$split" in
*"Psalm 147"*"a verse is needed"*) ;;
*) echo "expected an ambiguous split to be named, not guessed" >&2; exit 1 ;;
esac
case "$split" in
*"Praise"*) echo "an ambiguous split must not print verse text" >&2; exit 1 ;;
esac

# An unusable numbering system is refused as bad input rather than converted.
mkdir -p bibles/odd
sed 's/^numbering: vulgate$/numbering: nonesuch/' bibles/vg/index.yaml >bibles/odd/index.yaml
status=0
run_tool --calendar postconciliar --mass advent-1 --bible odd --bible-root bibles >/dev/null 2>&1 ||
	status=$?
if [ "${status:-0}" -ne 2 ]; then
	echo "unknown psalm numbering should exit 2, got ${status:-0}" >&2
	exit 1
fi
status=0

# An unindexed bible is refused by name rather than silently ignored.
if run_tool --calendar roman-1962 --mass advent-1 --bible no-such-bible >/dev/null 2>&1; then
	echo "expected failure for an unindexed bible" >&2
	exit 1
fi
if ! run_tool --calendar roman-1962 --mass advent-1 --bible no-such-bible 2>&1 |
	grep -q 'no indexed bible'; then
	echo "expected the unindexed bible to be named in the diagnostic" >&2
	exit 1
fi

for bad in "--calendar roman-1962" "--mass advent-1" "--calendar nope --mass advent-1"; do
	# shellcheck disable=SC2086
	if run_tool $bad >/dev/null 2>&1; then
		echo "expected failure for: $bad" >&2
		exit 1
	fi
done

if run_tool --calendar roman-1962 --mass advent-1 --format nonesuch >/dev/null 2>&1; then
	echo "expected failure for an unknown format" >&2
	exit 1
fi

# `structure` writes the browser's data: every citation resolved to explicit
# loci in both numbering systems, so no numbering logic reaches the page.
structure="$(mktemp -d)"
# Replace the earlier trap rather than adding one: a second `trap ... EXIT`
# supersedes the first, so it must clean up the sandbox too.
trap 'rm -rf "$sandbox" "$structure"' EXIT INT TERM
run_tool structure --out "$structure" >/dev/null

for calendar in roman-1962 postconciliar; do
	if [ ! -f "$structure/structure/propers/$calendar.json" ]; then
		echo "structure wrote no file for $calendar" >&2
		exit 1
	fi
done

# Ad te levavi is Vulgate Psalm 24 and Hebrew Psalm 25. Both must be present
# and correct: the browser picks by its translation's numbering, so a missing
# or wrong system silently renders a different psalm.
python3 - "$structure/structure/propers/roman-1962.json" <<'PY'
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
masses = {mass["key"]: mass for mass in document["masses"]}
introit = next(
    proper for proper in masses["advent-1"]["propers"] if proper["name"] == "Introit"
)
citation = introit["citations"][0]
assert citation["ref"] == "Psalm 24:1-3", citation["ref"]
assert citation["token"] == "Ps", citation["token"]
assert citation["unresolved"] is None, citation["unresolved"]
assert citation["loci"]["vulgate"] == [{"chapter": 24, "first": 1, "last": 3}], citation
assert citation["loci"]["hebrew"] == [{"chapter": 25, "first": 1, "last": 3}], citation

# A citation that cannot be converted carries the reason and NO loci: a page
# that explains itself beats one that renders the wrong psalm confidently.
postconciliar = json.load(open(sys.argv[1].replace("roman-1962", "postconciliar"), encoding="utf-8"))
refused = [
    citation
    for mass in postconciliar["masses"]
    for proper in mass["propers"]
    for rows in [proper["citations"],
                 *(cycle["citations"] for cycle in proper["cycles"].values())]
    for citation in rows
    if citation["unresolved"]
]
assert refused, "the known mis-numbered antiphons should refuse"
for citation in refused:
    assert citation["loci"] == {}, citation
    assert citation["unresolved"], citation

# Cycle readings are kept per year, not merged into one indistinguishable list.
cycled = [
    proper
    for mass in postconciliar["masses"]
    for proper in mass["propers"]
    if proper["cycles"]
]
assert cycled, "the postconciliar calendar carries cycle-varying propers"
PY

# A proper may carry two English translations, and something visible has to
# choose between them. The manifest is that choice: it is derived from what was
# actually published, ordered by coverage, and every proper's list is sorted
# into the same order, so a consumer that reads it and one that simply takes the
# first entry in its language land on the same witness.
cummiskey='edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861'
transcription='artifact.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861.temporal-orations-en'
mkdir -p witness/two
cat >witness/two/propers.yaml <<YAML
schema: triptych-calendar-masses/v1
calendar: two
edition: Demo Missal
series: demo
ordering: demo
registry: demo
orthography: demo
citation_convention: demo
verification: demo
psalm_numbering: vulgate
sections:
  '01':
    kind: seasonal
    masses:
    - key: t
      name: T
      registry: 't1'
      season: advent
      propers:
      - name: Collect
        source: composed
        text: "Excita, quaesumus, Domine."
        translations:
        - lang: en
          rights: public-domain
          source_id: $transcription
          text: "Stir up thy power, we beseech thee, O Lord."
        - lang: en
          rights: public-domain
          source_id: $cummiskey
          text: "Exert, we beseech thee, O Lord, thy power."
      - name: Secret
        source: composed
        text: "Haec sacra nos."
        translations:
        - lang: en
          rights: public-domain
          source_id: $cummiskey
          text: "Grant, O Lord."
YAML
run_tool structure --root witness --calendar two --out witness-out >/dev/null

python3 - witness-out/structure/propers/two.json "$cummiskey" "$transcription" <<'PY'
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
wide, narrow = sys.argv[2], sys.argv[3]
manifest = document["translations"]
assert [row["source_id"] for row in manifest] == [wide, narrow], manifest
# Counted, not assumed: a control that implies completeness is worse than none.
assert [row["held"] for row in manifest] == [2, 1], manifest
assert all(row["composed"] == 2 for row in manifest), manifest

propers = {proper["name"]: proper for proper in document["masses"][0]["propers"]}
# Recorded narrow-witness-first in the source; the file must not preserve that.
# List order is the whole of the default, so it cannot be left to typing order.
assert [t["source_id"] for t in propers["Collect"]["translations"]] == [wide, narrow]
assert [t["source_id"] for t in propers["Secret"]["translations"]] == [wide]
PY

# A terminal has no dropdown, so both witnesses are shown and each is named;
# showing one silently would hide exactly what a reader asked to compare.
both="$(run_tool --root witness --calendar two --mass t --lang en)"
for want in "Stir up thy power" "Exert, we beseech thee" "$cummiskey" "$transcription"; do
	case "$both" in
	*"$want"*) ;;
	*) echo "the reading view did not show both witnesses and name them: $want" >&2; exit 1 ;;
	esac
done

# --witness narrows to one, and then there is nothing to attribute.
one="$(run_tool --root witness --calendar two --mass t --lang en --witness "$cummiskey")"
case "$one" in
*"Stir up thy power"*) echo "--witness did not narrow to the named witness" >&2; exit 1 ;;
esac
case "$one" in
*"Exert, we beseech thee"*) ;;
*) echo "--witness dropped the translation it was asked for" >&2; exit 1 ;;
esac

# A witness that translated nothing here is an absence stated, never filled in
# from whichever other witness happens to have the proper.
missing="$(run_tool --root witness --calendar two --mass t --lang en --witness "$transcription")"
case "$missing" in
*"no en translation from $transcription recorded"*) ;;
*) echo "expected the missing witness to be named where the text would be" >&2; exit 1 ;;
esac
case "$missing" in
*"Grant, O Lord"*) echo "a missing witness must not be filled in from another" >&2; exit 1 ;;
esac

# `census` derives the count of both calendars once. One census used to exist in
# three retyped copies that disagreed by as much as sixty masses in a section,
# so what matters here is that the derivation is stable and that a document
# which has fallen behind it is refused rather than believed.
run_tool census >census-one.md
run_tool census >census-two.md
if ! cmp -s census-one.md census-two.md; then
	echo "census output is not byte-stable across runs" >&2
	exit 1
fi
for want in "census:begin" "| Calendar | Section | Masses |" \
	"| Calendar | Rank | Entries | Celebrations |" "| (no rank) |" "| Measure |" "census:end"; do
	if ! grep -q -- "$want" census-one.md; then
		echo "census output is missing $want" >&2
		exit 1
	fi
done

# The rank rows sum to the calendar's own `Masses`, so the table can be read as
# one book rather than as two counts that happen to sit together. Summed here
# from the emitted block rather than from the tool's own dict, because the block
# is what a reader adds up.
for calendar in roman-pre-1955 roman-1962 postconciliar; do
	# A rank row has four cells and a section row five, so the field count
	# tells the two tables apart without either of them being numbered.
	entries="$(awk -F'|' -v c=" $calendar " \
		'NF == 6 && $2 == c { total += $4 } END { print total + 0 }' census-one.md)"
	masses="$(awk -F'|' -v c=" $calendar " \
		'NF == 7 && $2 == c { total += $4 } END { print total + 0 }' census-one.md)"
	if [ "$entries" != "$masses" ]; then
		echo "$calendar rank entries ($entries) do not sum to its masses ($masses)" >&2
		exit 1
	fi
done

# The English coverage is REPORTED and never written: stdout is the block, so a
# document rewritten from it cannot pick the figures up, and the operator still
# sees them. The hand-typed copy of these numbers lives in a file this tool does
# not own; see the comment on `english_coverage`.
run_tool census 2>coverage.txt >/dev/null
if ! grep -q 'English orations:' coverage.txt; then
	echo "census did not report the English coverage on stderr" >&2
	exit 1
fi
if grep -q 'English orations:' census-one.md; then
	echo "the English coverage must not reach the block" >&2
	exit 1
fi

# `--check` stays a gate and says only whether the documents are current. A gate
# printing figures it does not gate teaches its operators to skim past it.
run_tool census --check 2>check-noise.txt >/dev/null
if grep -q 'English orations:' check-noise.txt; then
	echo "--check must not print the coverage it does not gate" >&2
	exit 1
fi

# The tracked documents are current, and `--check` writes nothing.
run_tool census --check >/dev/null

# A drifted document is named and exits 1; `--write` restores it and leaves the
# prose outside the region alone.
begin="$(head -1 census-one.md)"
mkdir -p docroot/docs docroot/guidance
printf 'before\n\n%s\nstale\n<!-- census:end -->\n\nafter\n' "$begin" >docroot/docs/the-mass.md
cp docroot/docs/the-mass.md docroot/guidance/propers-for-agents.md
status=0
run_tool census --check --doc-root docroot >stale.txt 2>/dev/null || status=$?
if [ "$status" -ne 1 ]; then
	echo "a stale document should exit 1, got $status" >&2
	exit 1
fi
if [ "$(grep -c '^stale	' stale.txt)" -ne 2 ]; then
	echo "both stale documents should be named" >&2
	exit 1
fi
run_tool census --write --doc-root docroot >/dev/null
run_tool census --check --doc-root docroot >/dev/null
for kept in '^before$' '^after$'; do
	if ! grep -q "$kept" docroot/docs/the-mass.md; then
		echo "census --write did not leave the prose outside the region alone" >&2
		exit 1
	fi
done

# `--check` gates the rank rows exactly as it gates the older ones. Proved by
# altering one rank count in an otherwise current copy: a document whose rank
# table alone has drifted is refused, so the new rows cannot rot quietly behind
# a table that still looks right.
sed 's/^| \(.*\) | (no rank) | \([0-9]*\) |/| \1 | (no rank) | 999 |/' \
	census-one.md >docroot/docs/the-mass.md
cp docroot/docs/the-mass.md docroot/guidance/propers-for-agents.md
if cmp -s census-one.md docroot/docs/the-mass.md; then
	echo "the rank drift fixture changed nothing; the row shape moved" >&2
	exit 1
fi
if run_tool census --check --doc-root docroot >/dev/null 2>&1; then
	echo "a drifted rank row should be refused" >&2
	exit 1
fi
run_tool census --write --doc-root docroot >/dev/null
run_tool census --check --doc-root docroot >/dev/null

# --- the weekday reading course -------------------------------------------
# The reformed Lectionary reads Sundays on a three-year course lettered A/B/C
# and the weekdays of Ordinary Time on a two-year course numbered I/II, carried
# in `weekday_cycles` beside `cycles`. Every walk this tool makes over one
# course must make the same walk over the other, or a whole year of readings
# reaches no page, no citation count and no psalm conversion.
mkdir -p weekdays/two-year
cat >weekdays/two-year/propers.yaml <<'YAML'
schema: triptych-calendar-masses/v1
calendar: postconciliar
edition: Demo Missal
series: demo
ordering: demo
registry: demo
orthography: demo
citation_convention: demo
verification: demo
psalm_numbering: hebrew
sections:
  '01':
    kind: seasonal
    masses:
    - key: ot-17-monday
      name: Monday of the Seventeenth Week in Ordinary Time
      registry: 'pc-T-ot-17-monday'
      season: ordinary-time
      propers:
      - name: First Reading
        source: scripture
        weekday_cycles:
          'I':
            verses:
            - book: Exodus
              ranges:
              - begin: {chapter: 32, verse: 15}
                end: {chapter: 32, verse: 24}
              ref: Exodus 32:15-24
          'II':
            verses:
            - book: Jeremiah
              ranges:
              - begin: {chapter: 13, verse: 1}
                end: {chapter: 13, verse: 11}
              ref: Jeremiah 13:1-11
      - name: Responsorial Psalm
        source: scripture
        weekday_cycles:
          'I':
            psalm_numbering: vulgate
            verses:
            - book: Psalms
              ranges:
              - begin: {chapter: 24, verse: 1}
                end: {chapter: 24, verse: 3}
              ref: Psalm 24:1-3
          'II':
            verses:
            - book: Psalms
              ranges:
              - begin: {chapter: 1, verse: 1}
                end: {chapter: 1, verse: 2}
              ref: Psalm 1:1-2
      - name: Gospel
        source: scripture
        verses:
        - book: Matthew
          ranges:
          - begin: {chapter: 13, verse: 31}
            end: {chapter: 13, verse: 35}
          ref: Matthew 13:31-35
YAML

# The reading view labels each year of the course by its own cycle key, so a
# reader sees `I:` and `II:` where the weekday year decides. What must never
# happen is a letter and a numeral printed as alternatives of the same kind.
ferial="$(run_tool --root weekdays --calendar two-year --mass ot-17-monday)"
for want in "I: Exodus 32:15-24" "II: Jeremiah 13:1-11" "Matthew 13:31-35"; do
	case "$ferial" in
	*"$want"*) ;;
	*) echo "the reading view did not print $want" >&2; exit 1 ;;
	esac
done

run_tool structure --root weekdays --calendar two-year --out weekday-out >/dev/null
python3 - weekday-out/structure/propers/two-year.json <<'PY'
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
propers = {proper["name"]: proper for proper in document["masses"][0]["propers"]}

# Each year's citations are kept apart, exactly as the Sunday course's are: a
# page that merged them would offer this year's reader last year's reading.
reading = propers["First Reading"]
assert sorted(reading["weekday_cycles"]) == ["I", "II"], reading["weekday_cycles"]
assert reading["weekday_cycles"]["I"]["citations"][0]["ref"] == "Exodus 32:15-24", reading
assert reading["weekday_cycles"]["II"]["citations"][0]["ref"] == "Jeremiah 13:1-11", reading
# Resolved to explicit loci like every other citation, so no numbering logic
# reaches the page.
assert reading["weekday_cycles"]["I"]["citations"][0]["loci"], reading
# The two courses are separate keys and the Sunday one is not filled in from
# the weekday one.
assert reading["cycles"] == {}, reading["cycles"]

# A proper that reads on no course carries the key at all: an empty mapping on
# every proper of every calendar would rewrite the tracked structure files to
# say that nothing varies by a course nothing yet reads.
assert "weekday_cycles" not in propers["Gospel"], propers["Gospel"]
assert propers["Gospel"]["citations"][0]["ref"] == "Matthew 13:31-35"
PY

# The census counts a cycle-varying proper ONCE -- it is one slot of one Mass,
# and only one of its years is ever said -- and reports the two courses apart,
# because they are two different cycles.
block="$(run_tool census --root weekdays)"
case "$block" in
*'| Propers | 3 |'*) ;;
*) echo "a weekday-cycle proper must count once, got: $block" >&2; exit 1 ;;
esac
case "$block" in
*'| — carrying a `weekday_cycles` mapping | 2 |'*) ;;
*) echo "the census did not count the weekday course, got: $block" >&2; exit 1 ;;
esac
case "$block" in
*'| — carrying a `cycles` mapping | 0 |'*) ;;
*) echo "the Sunday course row must stand beside it, got: $block" >&2; exit 1 ;;
esac
# Scripture-bearing is read from the cycles where the proper declares no source
# of its own, on either course.
case "$block" in
*'| — of those, scripture-bearing | 3 |'*) ;;
*) echo "weekday readings must count as scripture-bearing, got: $block" >&2; exit 1 ;;
esac

# The weekday row is printed only where a calendar carries one. The block is
# tracked in two documents and compared byte for byte, so a row of zeroes added
# on the day the KEY landed would have made both documents stale before any
# data existed to report.
if run_tool census --root witness | grep -q 'weekday_cycles'; then
	echo "a calendar carrying no weekday course must not print the row" >&2
	exit 1
fi

# Psalm numbering is inherited through both courses alike. A proper takes its
# calendar's system unless it declares its own, and each cycle may declare again
# -- which is how eleven antiphons carrying a Vulgate number inside a
# Hebrew-declaring file are held apart from the Lectionary's own numbering.
python3 - "$repo" weekdays/two-year/propers.yaml <<'PY'
import sys
from importlib.machinery import SourceFileLoader

propers = SourceFileLoader("under_test", f"{sys.argv[1]}/tools/mass-propers").load_module()
import yaml

document = yaml.safe_load(open(sys.argv[2], encoding="utf-8"))
mass = document["sections"]["01"]["masses"][0]
found = {entry["ref"]: numbering for entry, numbering in propers.numbered_entries(mass, "hebrew")}
assert found == {
    "Exodus 32:15-24": "hebrew",
    "Jeremiah 13:1-11": "hebrew",
    # The cycle's own declaration wins over the file's.
    "Psalm 24:1-3": "vulgate",
    "Psalm 1:1-2": "hebrew",
    "Matthew 13:31-35": "hebrew",
}, found
PY

# A document carrying no markers is refused rather than appended to.
printf 'no markers here\n' >docroot/docs/the-mass.md
if run_tool census --check --doc-root docroot >/dev/null 2>&1; then
	echo "expected failure for a document with no census region" >&2
	exit 1
fi
if grep -q 'census:begin' docroot/docs/the-mass.md; then
	echo "a markerless document must not be written to" >&2
	exit 1
fi

echo ok
