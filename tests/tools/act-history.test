#!/bin/sh
# Test for `tools/tpt act-history`: exit 0 = pass (the stable gate).
#
# guidance/repository.md requires one of these beside every registered tool, and
# this was the id that had none while the rule said it did. Nothing here writes
# into the repository: every invocation reads the committed inventories, and the
# one verb that writes is pointed at a sandbox.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="act-history"

run_tool() {
	"$tool" "$tool_id" "$@"
}

inventories="$repo/src/sources/inventories"
holy_week="$inventories/roman-holy-week-acts-v1.toml"
missal="$inventories/latin-missal-acts-v1.toml"
law="$inventories/canon-law-acts-v1.toml"

help="$(run_tool --help)"
# The registry's usage line has gone stale on this tool before; the verbs the
# tool actually accepts are the ones its own help names.
for verb in check graph structure plate commonality emit; do
	case "$help" in
	*"$verb"*) ;;
	*) echo "--help does not name the $verb verb" >&2; exit 1 ;;
	esac
done

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

# --- check -------------------------------------------------------------------

# The default source is the Holy Week tracer.
out="$(run_tool check)"
case "$out" in
*"ok: 12 acts, 2 lines"*) ;;
*) echo "check on the default source: expected 12 acts on 2 lines, got: $out" >&2; exit 1 ;;
esac

expect_json() {
	want="$1"
	source="$2"
	got="$(run_tool check --source "$source" --json)"
	case "$got" in
	*"$want"*) ;;
	*) echo "check $source: expected $want in: $got" >&2; exit 1 ;;
	esac
}

# The missal slice is the wide one: seventeen lines, and both station kinds, so
# the weaker claim stands beside the stronger rather than replacing it.
expect_json '"acts":59' "$missal"
expect_json '"lines":17' "$missal"
expect_json '"station_kinds":{"printed":26,"promulgated":33}' "$missal"
# Fifteen of the seventeen lines stand as roots: where a line's other side has no
# witness here, the branch is a root and its emptiness is the record.
run_tool check --source "$missal" --json >missal-check.json
python3 - <<'PY'
import json

document = json.load(open("missal-check.json"))
assert len(document["roots"]) == 15, document["roots"]
PY
# A use kept in print with no act behind the continuity is still an edge, and it
# declares what it rests on rather than passing as an act.
expect_json '"use-continuity"' "$missal"
# It extends the tracer rather than copying it, and says so.
expect_json '"extends_chain":["roman-holy-week-acts-v1.toml","latin-missal-acts-v1.toml"]' "$missal"

# The same shape reads a code, in the code's own words.
expect_json '"acts":47' "$law"
expect_json '"lines":4' "$law"
expect_json '"unit_word":"canon"' "$law"

# --- graph -------------------------------------------------------------------

# What may cross a line, and what a crossing has to say for itself. Asserted
# against the corpus rather than against a fabricated act, because the rule is
# about what is recorded here; the constructed cases live in
# tools/tests/test_act_history_reception.py, where a rejoining is built and its
# refusals are run.
#
# A single cross-line parent is a FORK -- a line is born at an act on another
# line, and that is how every line but the first begins. A cross-line parent
# among SEVERAL is a MERGE, which asserts that one tradition received from
# another, and it may be drawn only where the act declares the reception and
# cites the instrument that documents it. No tracked slice declares one, so
# every crossing below must be a birth, and this pass says which rule each
# crossing passes under rather than assuming there is only one. The same pass
# checks that the order is topological, which is the whole claim `graph` makes
# and what lets a drawing place a station to the right of what it descends from.
for source in "$holy_week" "$missal" "$law"; do
	run_tool graph --source "$source" --json >graph.json
	python3 - "$source" <<'PY'
import json
import sys

source = sys.argv[1]
rows = json.load(open("graph.json"))["rows"]
line = {row["act"]: row["line"] for row in rows}
seen = set()
forks = 0
merges = 0
for row in rows:
    for parent in row["parents"]:
        assert parent in line, f"{source}: {row['act']} descends from unknown {parent}"
        assert parent in seen, f"{source}: {row['act']} stands before its parent {parent}"
        if line[parent] != line[row["act"]]:
            assert len(row["parents"]) == 1, (
                f"{source}: {row['act']} on {line[row['act']]} merges a parent on"
                f" {line[parent]}; no tracked slice rejoins two lines"
            )
            assert parent not in row["receives"], (
                f"{source}: {row['act']} calls its ONLY parent a reception; one parent"
                " synthesises nothing, so a crossing with one parent is a birth"
            )
            forks += 1
    merges += len(row["parents"]) > 1
    seen.add(row["act"])
assert not any(row["receives"] for row in rows), (
    f"{source}: a tracked slice now records a rejoining, which is a claim about two"
    " traditions and not a refactor; the assertions below assume none"
)
assert forks, f"{source}: no line is born at an act, so nothing here runs in parallel"
if source.endswith("latin-missal-acts-v1.toml"):
    # The slice the page opens on is the one that exercises the shape, and a
    # merge is the part a straight track cannot show: it is a claim that a
    # reception happened, and `check` refuses one that cites nothing.
    assert merges, "the missal slice records no reception at all"
PY
done

# A printed station reads as the weaker claim it is, in the graph as everywhere.
case "$(run_tool graph --source "$missal")" in
*"* praedicatorum"*) ;;
*) echo "graph does not mark a printed station" >&2; exit 1 ;;
esac

# --- structure, and the manifest ---------------------------------------------

# The manifest names what is THERE, not what the run built. A run into an empty
# directory therefore names exactly the one slice it wrote.
run_tool structure --source "$law" --out one >/dev/null
python3 - <<'PY'
import json

document = json.load(open("one/structure/act-history/index.json"))
assert [row["id"] for row in document["slices"]] == ["code-of-canon-law"], document
assert document["default"] == "code-of-canon-law", document
PY

# A second slice into the same root joins it, and the landing slice is DECLARED
# rather than sorted into: `code-of-canon-law` was written first and sorts first,
# and the moment `latin-missal` is there the manifest opens on it.
run_tool structure --source "$holy_week" --out one >/dev/null
python3 - <<'PY'
import json

document = json.load(open("one/structure/act-history/index.json"))
listed = [row["id"] for row in document["slices"]]
assert listed == ["code-of-canon-law", "roman-holy-week"], document
assert document["default"] == "code-of-canon-law", document
PY

run_tool structure --source "$missal" --out one >/dev/null
python3 - <<'PY'
import json
import os

document = json.load(open("one/structure/act-history/index.json"))
root = "one/structure/act-history"

# This run built one slice and the manifest names three: a file whose purpose is
# to stop the page guessing a slice id must not go stale the moment somebody
# rebuilds one of them.
assert [row["id"] for row in document["slices"]] == [
    "latin-missal", "code-of-canon-law", "roman-holy-week"], document

# Declared, and read as a name. Row order alone would have kept the reader on
# code-of-canon-law.
assert document["default"] == "latin-missal", document

held = {
    "latin-missal": ("liturgy", 59, 17),
    "code-of-canon-law": ("law", 47, 4),
    "roman-holy-week": ("liturgy", 12, 2),
}
for row in document["slices"]:
    # The row is the path the page composes, so the file must be at it: a
    # manifest that advertised a 404 would be worse than the probe it replaced.
    map_file = os.path.join(root, row["id"] + ".json")
    assert os.path.isfile(map_file), map_file
    payload = json.load(open(map_file))
    assert payload["slice"] == row["id"], row
    # And the counts are the file's own, never a second copy that can drift.
    assert len(payload["stations"]) == row["stations"], row
    assert len(payload["lines"]) == row["lines"], row
    assert (row["vocabulary"], row["stations"], row["lines"]) == held[row["id"]], row
PY

# Byte-stable for unchanged inputs, manifest and map alike.
cp one/structure/act-history/index.json first-index.json
cp one/structure/act-history/latin-missal.json first-map.json
run_tool structure --source "$missal" --out one >/dev/null
if ! cmp -s first-index.json one/structure/act-history/index.json; then
	echo "the manifest is not byte-stable across runs" >&2
	exit 1
fi
if ! cmp -s first-map.json one/structure/act-history/latin-missal.json; then
	echo "the map file is not byte-stable across runs" >&2
	exit 1
fi

# A stray file beside the map files is not a slice and is not advertised as one.
echo '{"schema":"something-else"}' >one/structure/act-history/notes.json
# Nor is a copy filed under a name it does not answer to: the id is what the page
# composes its fragment paths from, so a map naming some other slice is not
# reachable there and listing it would be the 404 the manifest exists to stop.
cp one/structure/act-history/latin-missal.json one/structure/act-history/alias.json
run_tool structure --source "$holy_week" --out one >/dev/null
for stray in '"notes"' '"alias"'; do
	if grep -q "$stray" one/structure/act-history/index.json; then
		echo "the manifest listed $stray, which is not a slice it can serve" >&2
		exit 1
	fi
done

# --- plate: the printed map's source ------------------------------------------

# The topology IS the content, so it is the topology that is asserted. The DOT
# is the only artifact this repository can produce: LOOM's `octi` turns it into
# an octilinear drawing and is not installed here, so nothing below runs it and
# nothing below pretends to.
for source in "$holy_week" "$missal" "$law"; do
	run_tool plate --source "$source" --out plates >/dev/null
done

python3 - <<'PY'
import re

# A parse of the emitted DOT rather than of the tool's own JSON: the file is
# what a reader hands to octi, so a property that held only in the report and
# not in the file would be a property of nothing.
NODE = re.compile(r'^  "([^"]+)" \[(.*)\];$')
EDGE = re.compile(r'^  "([^"]+)" -- "([^"]+)" \[(.*)\];$')


def read(name):
    nodes, edges = {}, []
    for line in open(f"plates/{name}.dot", encoding="utf-8").read().splitlines():
        found = EDGE.match(line)
        if found:
            edges.append((found.group(1), found.group(2), dict(re.findall(r'(\w+)="([^"]*)"', found.group(3)))))
            continue
        found = NODE.match(line)
        if found:
            nodes[found.group(1)] = dict(re.findall(r'(\w+)="([^"]*)"', found.group(2)))
    return nodes, edges


nodes, edges = read("latin-missal")

# The slice that exercises the whole grammar, and the counts guidance/act-
# histories.md states for it.
assert len(nodes) == 59, len(nodes)
assert len({node["line"] for node in nodes.values()}) == 17

# A lane is a tradition, and one tradition is one lane. A line drawn on two
# lanes would be two traditions on the plate whatever the data says.
lanes = {}
for node in nodes.values():
    lanes.setdefault(node["line"], set()).add(node["lane"])
for line, held in lanes.items():
    assert len(held) == 1, (line, held)
assert len({next(iter(held)) for held in lanes.values()}) == 17, "two lines share a lane"

# Every node stands where its `pos` says, and the x of that position is monotone
# in the date: descent is read off the axis, which is why the edges carry no
# arrowheads, so a station standing left of an act it descends from would be a
# lie the drawing tells with no caption to correct it.
placed = {}
for name, node in nodes.items():
    x, y = node["pos"].split(",")
    assert y == str(int(node["lane"]) * 100), node
    placed[name] = int(x)
by_date = sorted(nodes, key=lambda name: (nodes[name]["date"], name))
for earlier, later in zip(by_date, by_date[1:]):
    if nodes[earlier]["date"] == nodes[later]["date"]:
        assert placed[earlier] == placed[later], (earlier, later)
    else:
        assert placed[earlier] < placed[later], (earlier, later)

# Fifteen roots: where a line's other side has no witness here, the branch is a
# root and its emptiness is the record.
assert sum(node["role"] == "root" for node in nodes.values()) == 15

# Five lines are ONE station and nothing more -- a use that ended, standing as a
# terminus. It is the thing the map exists to make visible and the thing a
# timeline cannot show.
stations = {}
for node in nodes.values():
    stations[node["line"]] = stations.get(node["line"], 0) + 1
alone = sorted(line for line, count in stations.items() if count == 1)
assert len(alone) == 5, alone
for line in alone:
    only = next(name for name, node in nodes.items() if node["line"] == line)
    assert nodes[only].get("terminus") == "true", only

# RULE 2, which is the part of this design with no prior art. A cross-lane edge
# is one of exactly two things and says which on itself: a birth, which is the
# child's first station, or a reception, which no tracked slice declares. So
# every crossing here is a birth and carries `fork`, and none carries
# `reception`. Everything else that crosses on the plate crosses without an
# interchange, and that is what says coexistence without reception.
opening = {}
for name, node in nodes.items():
    line = node["line"]
    if line not in opening or (nodes[name]["date"], name) < (nodes[opening[line]]["date"], opening[line]):
        opening[line] = name
forks = 0
for parent, child, attributes in edges:
    assert attributes["line"] == nodes[child]["line"], (parent, child)
    if nodes[parent]["line"] != nodes[child]["line"]:
        assert attributes.get("fork") == "true", (parent, child)
        assert "reception" not in attributes, (parent, child)
        assert opening[nodes[child]["line"]] == child, (parent, child)
        forks += 1
assert forks == 2, forks
assert not any("reception" in attributes for _, _, attributes in edges), (
    "this slice draws a rejoining and the assertions here were written for one that"
    " does not; tools/tests/test_act_history_reception.py holds the constructed case"
)

# An interchange is a documented reception and the only place a reader may
# change trains. There is exactly one in this slice, and both its edges run on
# its own line: this slice's reception is between two descents of one tradition,
# and the cross-line kind is the constructed case the unit tests carry.
interchanges = [name for name, node in nodes.items() if node["role"] == "interchange"]
assert len(interchanges) == 1, interchanges
arriving = [edge for edge in edges if edge[1] == interchanges[0]]
assert len(arriving) == 2, arriving
assert all(nodes[parent]["line"] == nodes[interchanges[0]]["line"] for parent, _, _ in arriving)

# Both station kinds are on the drawing at once, so the weaker claim is read
# beside the stronger rather than wearing its clothes.
kinds = {}
for node in nodes.values():
    kinds[node["station_kind"]] = kinds.get(node["station_kind"], 0) + 1
assert kinds == {"printed": 26, "promulgated": 33}, kinds

# The same shape reads a code, with no lane sharing and no cross-line edge that
# is not a birth.
for name, expected in (("code-of-canon-law", 47), ("roman-holy-week", 12)):
    other_nodes, other_edges = read(name)
    assert len(other_nodes) == expected, (name, len(other_nodes))
    for parent, child, attributes in other_edges:
        assert attributes["line"] == other_nodes[child]["line"], (name, parent, child)
PY

# --- the monochrome grammar, and what it honestly separates -------------------

python3 - <<'PY'
import re

NODE = re.compile(r'^  "([^"]+)" \[(.*)\];$')
EDGE = re.compile(r'^  "([^"]+)" -- "([^"]+)" \[(.*)\];$')
PAIR = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')


def read(name):
    nodes, edges = {}, []
    for line in open(f"plates/{name}.dot", encoding="utf-8").read().splitlines():
        found = EDGE.match(line)
        if found:
            edges.append((found.group(1), found.group(2), dict(PAIR.findall(found.group(3)))))
            continue
        found = NODE.match(line)
        if found:
            nodes[found.group(1)] = dict(PAIR.findall(found.group(2)))
    return nodes, edges


nodes, edges = read("latin-missal")

# ONE KEY PER LINE, and the same key on the station and on the band. A texture
# that moved between a line's stations would be two traditions on the plate.
key = {}
for node in nodes.values():
    key.setdefault(node["line"], set()).add((node["texture"], node["grey"]))
for line, held in key.items():
    assert len(held) == 1, (line, held)
keys = {line: next(iter(held)) for line, held in key.items()}
lane = {node["line"]: int(node["lane"]) for node in nodes.values()}

# Seventeen lines, and seventeen keys, because six textures times three greys is
# eighteen. This is the honest claim and the file makes it in as many words: the
# DASH CHANNEL ALONE separates six, and past eighteen the pairs repeat.
assert len(keys) == 17, keys
assert len(set(keys.values())) == 17, "two lines are drawn identically"
textures = {texture for texture, _ in keys.values()}
greys = {grey for _, grey in keys.values()}
assert len(textures) == 6, textures
assert len(greys) == 3, greys

# The texture turns over fastest, so two lines sharing one are six lanes apart.
# That is what lets a reader follow a tradition across a crossing: the lines
# drawn adjacent, which is where the confusion would be, never share a texture.
for line, (texture, _) in keys.items():
    for other, (other_texture, _) in keys.items():
        if other != line and other_texture == texture:
            assert abs(lane[line] - lane[other]) >= 6, (line, other, texture)

# The band says which line; the WIDTH says what the descent rests on. Two
# channels, and section 9's constant band width is what leaves the second free.
WIDTHS = {
    "act-states-it": ("stated", "3"),
    "book-states-it": ("stated", "3"),
    "attributed": ("attributed", "2"),
    "use-continuity": ("sequence", "1"),
    "line-order": ("sequence", "1"),
}
seen = set()
for parent, child, attributes in edges:
    assert (attributes["texture"], attributes["grey"]) == keys[nodes[child]["line"]], child
    strength, width = WIDTHS[attributes["descent"]]
    assert attributes["strength"] == strength, (child, attributes)
    assert attributes["penwidth"] == width, (child, attributes)
    seen.add(strength)
# Both tiers this slice has, so the width channel is doing work rather than
# standing at one value on every edge.
assert seen == {"stated", "sequence"}, seen

# A solid line carries no dasharray at all: absence is the negative here, as it
# is everywhere else in the file.
for _, _, attributes in edges:
    assert ("dasharray" in attributes) == (attributes["texture"] != "solid"), attributes
PY

# WHAT HAPPENS PAST THE CEILING, which no slice here reaches. Eighteen keys is
# the honest ceiling and a nineteenth line has to be drawn like one already on
# the sheet; the emitter NAMES the pairs rather than claiming a distinction it
# does not draw. Asserted against the keying itself, since building a
# nineteen-line slice to prove it would be building a fiction.
python3 - "$repo" <<'PY'
import importlib.machinery
import importlib.util
import sys

loader = importlib.machinery.SourceFileLoader("act_history", f"{sys.argv[1]}/tools/act-history")
spec = importlib.util.spec_from_loader(loader.name, loader)
tool = importlib.util.module_from_spec(spec)
spec.loader.exec_module(tool)

assert tool.DISTINGUISHED == len(tool.TEXTURES) * len(tool.GREYS) == 18, tool.DISTINGUISHED

# Exactly at the ceiling: eighteen lines, eighteen keys, nothing shared.
keyed = tool.monochrome({f"line-{index:02d}": index for index in range(18)})
assert len({(key["texture"], key["grey"]) for key in keyed.values()}) == 18
assert tool.sharing_a_key(keyed) == []

# One past it: the nineteenth repeats the first, and the file says which.
keyed = tool.monochrome({f"line-{index:02d}": index for index in range(20)})
assert tool.sharing_a_key(keyed) == ["line-18 = line-00", "line-19 = line-01"], \
    tool.sharing_a_key(keyed)
PY

# --- the apparatus: section 9's, computed, and stamped from the release --------

python3 - "$repo" <<'PY'
import hashlib
import json
import re
import sys

repo = sys.argv[1]
PAIR = re.compile(r'(\w+)="((?:[^"\\]|\\.)*)"')
WANTED = ("edition", "provenance", "exceptions", "epistemic", "legend", "grammar",
          "url", "cite", "unmarked")

text = open("plates/latin-missal.dot", encoding="utf-8").read()
declared = next(line for line in text.splitlines() if line.startswith("  graph ["))
carried = dict(PAIR.findall(declared))

# Section 9 wants each of these ON THE PLATE. They are in the graph's own
# attributes, where the pass that places them reads the graph it is placing, and
# in the header, where a person reading the file reads them.
for name in WANTED:
    assert name in carried, name
    assert f"// {name.upper()}" in text, name

# THE EDITION STAMP IS THE RELEASE'S AND NEVER A BUILD CLOCK. Proved against the
# two records it is composed from rather than against a string typed here.
release = json.load(open(f"{repo}/release/public-alpha.json"))["release_id"]
assert f"Release {release}." in carried["edition"], carried["edition"]
recorded = re.search(r'^recorded_on = "([\d-]+)"$',
                     open(f"{repo}/src/sources/inventories/latin-missal-acts-v1.toml",
                          encoding="utf-8").read(), re.M).group(1)
assert f"recorded {recorded}" in carried["edition"], carried["edition"]

# The version pin is the digest of every file the slice was read from, and it is
# checkable with sha256sum. A one-edition site cannot pin a URL; this can.
for relative in ("src/sources/inventories/roman-holy-week-acts-v1.toml",
                 "src/sources/inventories/latin-missal-acts-v1.toml"):
    digest = hashlib.sha256(open(f"{repo}/{relative}", "rb").read()).hexdigest()
    assert f"{relative} sha256 {digest}" in carried["provenance"], relative

# COMPUTED, NOT TYPED. Every count in the apparatus is a count of what the file
# itself carries, so a legend cannot drift from the drawing it describes.
nodes = re.findall(r'^  "[^"]+" \[(.*)\];$', text, re.M)
held = [dict(PAIR.findall(node)) for node in nodes if " -- " not in node]
approximate = sum(1 for node in held if node.get("approximate") == "~")
printed = sum(1 for node in held if node["station_kind"] == "printed")
assert approximate and printed, (approximate, printed)
assert f"{approximate} of {len(held)} stations carry it" in carried["epistemic"]
assert f"{printed} of {len(held)} stations claim NO ACT AT ALL" in carried["exceptions"]
assert all((node.get("approximate") == "~") == (node["date_precision"] != "day")
           for node in held)

# The exceptions are NAMED, not counted in aggregate: section 9 asks for the
# provenance with its exceptions named, and Rule 1 already gives every station
# an instrument, so nothing here is sent to a global bibliography.
for phrase in ("NO RECORDED DESCENT", "NOTHING BUT ORDER", "Read no better than this"):
    assert phrase in carried["exceptions"], phrase
assert "PER STATION, cite the act" in carried["cite"], carried["cite"]

# And the sheet says what it does NOT mark, rather than letting a reader assume
# it does: no label is placed, a crossing is not marked, no sheet size is set.
for phrase in ("NO LABEL IS PLACED", "A CROSSING IS NOT MARKED", "NO SHEET SIZE IS SET"):
    assert phrase in carried["unmarked"], phrase

# The slice that declares no `recorded_on` says so instead of inventing a date,
# which is the whole reason nothing here reads a clock.
other = open("plates/code-of-canon-law.dot", encoding="utf-8").read()
other_graph = next(line for line in other.splitlines() if line.startswith("  graph ["))
elsewhere = dict(PAIR.findall(other_graph))
assert "declares no `recorded_on`" in elsewhere["edition"], elsewhere["edition"]
# And an exception this slice has and the missal does not: a rights position is
# named on the plate rather than left to look like ignorance.
assert "whose text is withheld here" in elsewhere["exceptions"], elsewhere["exceptions"]
PY

# Byte-identical for unchanged input. The plate is a build artifact and Rule 5
# asks it to be reproducible, so a rerun that moved a station would mean the
# drawing carried a fact the source does not.
cp plates/latin-missal.dot first-plate.dot
run_tool plate --source "$missal" --out plates >/dev/null
if ! cmp -s first-plate.dot plates/latin-missal.dot; then
	echo "the plate is not byte-stable across runs" >&2
	exit 1
fi
# And under an environment that would expose a clock, a locale collation or a
# hash-ordered dict, which is where a generator usually stops being reproducible.
# In a subshell: assignments before a shell FUNCTION persist in POSIX sh, and a
# locale leaking into the rest of this file would be a test that passes here for
# a reason nobody wrote down.
(
	export TZ=Pacific/Kiritimati LANG=tr_TR.UTF-8 LC_ALL=C PYTHONHASHSEED=random
	run_tool plate --source "$missal" --out elsewhere >/dev/null
)
if ! cmp -s first-plate.dot elsewhere/latin-missal.dot; then
	echo "the plate depends on the environment it was built in" >&2
	exit 1
fi

# It says how it is rendered and does not pretend to have rendered it. octi is
# not installed here, and a silently skipped step is worse than a named one.
for wanted in 'octi' 'transitmap' 'NOT run'; do
	if ! grep -q "$wanted" plates/latin-missal.dot; then
		echo "the plate does not say how a reader gets the SVG: missing $wanted" >&2
		exit 1
	fi
done

# --- the README a reader of a CLONE gets --------------------------------------

# The README is the only file every clone has, and three facts about a published
# slice are legible nowhere else in it: which words are absent on purpose, what
# rights the readings carry, and that `git gc` produces a repository the reader's
# own tools call corrupt. A fourth is a rule rather than a fact -- nothing moves
# between this repository and another by a git operation, in either direction.
#
# Asserted on the RENDERED text of a slice that withholds and one that does not,
# because the two must differ: a withholding paragraph printed where nothing is
# withheld would be a rights position the slice does not hold, which is worse
# than saying nothing.
python3 - "$repo" "$holy_week" "$law" <<'PY'
import importlib.machinery
import importlib.util
import pathlib
import sys

repo, holy_week, law = sys.argv[1:4]
loader = importlib.machinery.SourceFileLoader("under_test", f"{repo}/tools/act-history")
tool = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(tool)


def readme(path):
    """The README of the slice's first line, as `emit` writes it into the tree."""
    data = tool.load(pathlib.Path(path))
    acts = tool.indexed(data["acts"], "id", "acts")
    first = acts[tool.topological(acts)[0]]
    return data, tool.render_readme(data, tool.indexed(data["lines"], "id", "lines")[first["line"]])


holy_data, open_slice = readme(holy_week)
law_data, withholding_slice = readme(law)

# BOTH, because neither hazard is about the rights position. The gc hazard is
# reader-facing and cannot be fixed from this end -- `emit` sets
# gc.writeCommitGraph in the repository it writes and local config does not
# travel with a clone -- and the lt-hist prohibition binds every emitted slice.
for name, text in (("roman-holy-week", open_slice), ("code-of-canon-law", withholding_slice)):
    for phrase in (
        "git config gc.writeCommitGraph false",
        "LOCAL CONFIG DOES NOT",
        "commit-graph stores a commit date",
        "34 bits",
        "git fsck --strict",
        "1570 ahead of one of 1962",
        "NOTHING MOVES BETWEEN THIS REPOSITORY AND ANOTHER BY A GIT OPERATION",
        "in EITHER direction",
        "~/git/lt-hist/build/roman-",
        "cherry-pick",
        "EXTRACTION OF NAMED FILES FROM A WORKING TREE",
        "Any fold-in extracts named files",
        "lt-hist-rights-audit-v1.toml",
        "NOT A PUBLICATION CLEARANCE",
        "act-history-repository-publication-v1.toml",
    ):
        assert phrase in text, f"{name}: the README does not say {phrase!r}"

# THE COUNTS ARE COUNTED, and the assertion recounts them rather than trusting
# the sentence. A README that named a number the rows do not hold would be the
# defect this project keeps naming, doing it about rights.
counted = {
    table: (sum(1 for row in law_data.get(table, []) if row.get("withheld")), len(law_data[table]))
    for table in ("units", "departures", "interpretations")
}
assert counted == {"units": (134, 159), "departures": (11, 131),
                   "interpretations": (29, 29)}, counted
for phrase in (
    "WORDS ARE MISSING FROM THIS HISTORY ON PURPOSE",
    "134 of 159 canons",
    "11 of 131 departures",
    "29 of 29 interpretations",
    "[text withheld: <the reason>]",
    "[words withheld: <the reason>]",
    # The distinction the whole field exists for: read and withheld, as against
    # never read. A cloner learns it here or nowhere.
    "It says the words EXIST, were READ",
    "nobody has read a canon, its file carries no banner and no words",
    "text established by: <act>",
    # The rights position, out of the rows and quoted whole rather than summarised.
    "a work of the Holy See later than 1929",
    "asserts copyright by name; this project holds",
    "22 of the 47 acts here carry at least one withheld row",
    "public-domain",
    "unresolved",
    "vatican-mitis-iudex",
    "mitis-iudex-2015",
    "recorded `unresolved`",
):
    assert phrase in withholding_slice, f"code-of-canon-law: the README does not say {phrase!r}"

# AND THE SLICE THAT WITHHOLDS NOTHING SAYS SO, in the other direction. It has
# no `[withheld]` table at all, so a reader must be told that the silence is a
# silence and not a withholding -- and must not be handed a rights paragraph
# about words that are all present.
assert not any(row.get("withheld") for table in ("units", "departures", "interpretations")
               for row in holy_data.get(table, []))
for phrase in (
    "NOTHING IN THIS SLICE IS WITHHELD",
    "0 of 38 units",
    "0 of 42 departures",
    "the record holds none: nobody has read them",
    "[incipit withheld: <the reason>]",
    "No file in this repository carries that banner",
    "No witness here records anything but `public-domain`",
    "public-domain  9",
):
    assert phrase in open_slice, f"roman-holy-week: the README does not say {phrase!r}"
for phrase in ("WORDS ARE MISSING FROM THIS HISTORY", "text established by",
               "NOT established a right to redistribute"):
    assert phrase not in open_slice, f"roman-holy-week: the README claims {phrase!r}"
PY

# It reaches the COMMIT OBJECT, and not only the renderer. A paragraph that never
# entered a tree would satisfy every string test above and no reader at all.
run_tool emit --source "$holy_week" --out emitted >/dev/null
git --git-dir=emitted show typica:README.md >emitted-readme
for phrase in 'gc.writeCommitGraph false' 'NOTHING MOVES BETWEEN THIS REPOSITORY' \
	'NOTHING IN THIS SLICE IS WITHHELD' 'NOT A PUBLICATION CLEARANCE'; do
	if ! grep -qF "$phrase" emitted-readme; then
		echo "the emitted README does not carry: $phrase" >&2
		exit 1
	fi
done

# THE README IS PART OF EVERY COMMIT'S TREE, so a nondeterministic one would
# change every commit id on every run. Asserted on the refs, which is every
# commit this slice has.
git --git-dir=emitted for-each-ref --format='%(refname) %(objectname)' >first-refs
run_tool emit --source "$holy_week" --out again >/dev/null
git --git-dir=again for-each-ref --format='%(refname) %(objectname)' >again-refs
if ! cmp -s first-refs again-refs; then
	echo "the emitted history is not byte-stable across runs" >&2
	exit 1
fi
(
	export TZ=Pacific/Kiritimati LANG=tr_TR.UTF-8 LC_ALL=C PYTHONHASHSEED=random
	run_tool emit --source "$holy_week" --out hostile >/dev/null
)
git --git-dir=hostile for-each-ref --format='%(refname) %(objectname)' >hostile-refs
if ! cmp -s first-refs hostile-refs; then
	echo "the emitted history depends on the environment it was built in" >&2
	exit 1
fi
git --git-dir=hostile show typica:README.md >hostile-readme
if ! cmp -s emitted-readme hostile-readme; then
	echo "the README depends on the environment it was built in" >&2
	exit 1
fi

# --- refusals ----------------------------------------------------------------

if run_tool check --source missing.toml >/dev/null 2>&1; then
	echo "expected a missing source to be refused" >&2
	exit 1
fi

cat >wrong-schema.toml <<'TOML'
acts_schema = 99
record_type = "liturgical-act-history"
slice = "wrong-schema"
TOML
if out="$(run_tool check --source wrong-schema.toml 2>&1)"; then
	echo "expected an unknown acts_schema to be refused" >&2
	exit 1
fi
case "$out" in
*acts_schema*) ;;
*) echo "expected the schema named in the complaint, got: $out" >&2; exit 1 ;;
esac

# THE RIGHTS MARKER IS ENFORCED, and the probe that found it was not is run here
# rather than described. A canon of the Code slice already declaring `withheld`
# is given a `text`; before the guard landed, `check` reported zero problems and
# `emit` wrote the words into a commit object underneath the banner saying they
# are absent. tools/tests/test_act_history_withheld.py carries the other row
# kinds and the case the rows cannot show; this is the gate's own copy.
sed 's/^withheld = "holy-see-post-1929"$/&\ntext = "PASTED BY MISTAKE."/' "$law" \
	>leaking.toml
if out="$(run_tool check --source leaking.toml 2>&1)"; then
	echo "expected a canon that withholds its words and carries them to be refused" >&2
	exit 1
fi
case "$out" in
*"withholds its words"*) ;;
*) echo "expected the withholding named in the complaint, got: $out" >&2; exit 1 ;;
esac
# And the words must be unwritable, not merely unrecommended: `check` running
# first is a property of the CLI's ordering, and the refusal has to outlive it.
if run_tool emit --source leaking.toml --out leaked >/dev/null 2>&1; then
	echo "emit wrote a repository for a slice that carries withheld words" >&2
	exit 1
fi
if [ -e leaked ]; then
	echo "emit left a repository behind for a refused slice" >&2
	exit 1
fi

echo ok
