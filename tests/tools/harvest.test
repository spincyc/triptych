#!/bin/sh
# Test for `tools/tpt harvest`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="harvest"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

cat >corpus.yaml <<'YAML'
schema: triptych-missal-commentary-corpus/v1
passages:
- passage: 'Isaiah 63:16-64:7'
- passage: 'Psalms 24:1-24:3'
- passage: 'Luke 21:25-21:33'
YAML

# A query covers at most one chapter: a reference spanning two becomes two
# loci, never one, so nothing commenting on only one chapter is dropped.
plain="$(run_tool --ledger ledger.yaml plan --corpus corpus.yaml --json 2>/dev/null)"
chaptered="$(run_tool --ledger ledger.yaml plan --corpus corpus.yaml --by-chapter --json 2>/dev/null)"
case "$chaptered" in
*'Isaiah 63'*) ;;
*) echo "chapter planning lost Isaiah 63" >&2; exit 1 ;;
esac
case "$chaptered" in
*'Isaiah 64'*) ;;
*) echo "a reference spanning two chapters must yield both" >&2; exit 1 ;;
esac
case "$chaptered" in
*'63:16'*) echo "chapter loci must not carry verse detail" >&2; exit 1 ;;
*) ;;
esac
case "$plain" in
*'Isaiah 63:16-64:7'*) ;;
*) echo "verse-range planning should keep the cited range" >&2; exit 1 ;;
esac

# `ask` is the one verb that spends outside this machine, so the gate here is
# that its dry run does not. A `claude` that records having been run shadows the
# real one for this check: emptying PATH instead would only prove the launcher's
# own `env python3` cannot resolve either. The dry run must still report the
# scale it would run at and the prompt it would send.
mkdir -p shim
cat >shim/claude <<'SH'
#!/bin/sh
echo "$@" >"$(dirname -- "$0")/../asked"
exit 0
SH
chmod +x shim/claude
dry="$(PATH="$PWD/shim:$PATH" run_tool --ledger ledger.yaml ask \
	--corpus corpus.yaml --by-chapter --runs 3 --dry-run --json 2>/dev/null)"
if [ -e asked ]; then
	echo "a dry run invoked the model CLI" >&2
	exit 1
fi
case "$dry" in
*'"status":"dry-run"'*) ;;
*) echo "ask --dry-run should report a dry run, got: $dry" >&2; exit 1 ;;
esac
case "$dry" in
*'"queries":12'*) ;;
*) echo "four loci over three runs is twelve queries, got: $dry" >&2; exit 1 ;;
esac
case "$dry" in
*'Isaiah 63'*) ;;
*) echo "the dry run must show the prompt it would send" >&2; exit 1 ;;
esac
if [ -e build ] || [ -e harvest-runs ]; then
	echo "a dry run must not create its output directory" >&2
	exit 1
fi

# The cutoff and the role vocabulary are enforced at record, not by the prompt.
write_run() {
	cat >"$1" <<YAML
passages:
  'Psalms 24:1-24:3':
    - author: Augustine of Hippo
      title: $2
      role: church-father
      death_year: 430
      aliases: [$3]
YAML
}

write_run bad.yaml 'Enarrationes in Psalmos' "''"
sed -i 's/death_year: 430/death_year: 1950/' bad.yaml
if run_tool --ledger ledger.yaml record --results bad.yaml --model test --audited-on 2026-07-30 >/dev/null 2>&1; then
	echo "expected a post-1900 death_year to be refused" >&2
	exit 1
fi
sed -i 's/death_year: 1950/death_year: 430/; s/role: church-father/role: pundit/' bad.yaml
if run_tool --ledger ledger.yaml record --results bad.yaml --model test --audited-on 2026-07-30 >/dev/null 2>&1; then
	echo "expected an unknown role to be refused" >&2
	exit 1
fi

# One work under two names collapses when either carries the other as an alias.
write_run one.yaml 'Enarrationes in Psalmos' "'Expositions on the Psalms'"
write_run two.yaml 'Expositions on the Psalms' "'Enarrationes in Psalmos'"
run_tool --ledger ledger.yaml record --results one.yaml --model test --audited-on 2026-07-30 >/dev/null
run_tool --ledger ledger.yaml record --results two.yaml --model test --audited-on 2026-07-30 >/dev/null
count="$(run_tool --ledger ledger.yaml propers --json 2>/dev/null | grep -o '"author"' | wc -l | tr -d ' ')"
if [ "$count" -ne 1 ]; then
	echo "an aliased work should collate to one entry, got $count" >&2
	exit 1
fi

# Confidence is agreement across runs, not a number the model supplied.
if ! run_tool --ledger ledger.yaml propers --json 2>/dev/null | grep -q '"confidence":1.0'; then
	echo "a work in every run should reach full confidence" >&2
	exit 1
fi

# Both output forms are available, and --src-list-only drops the scoring.
run_tool --ledger ledger.yaml --format yaml propers 2>/dev/null | grep -q '^works:'
run_tool --ledger ledger.yaml --src-list-only --format yaml propers 2>/dev/null >slim.yaml
if grep -q 'confidence\|score\|passages' slim.yaml; then
	echo "--src-list-only should carry no scoring or passage detail" >&2
	exit 1
fi
grep -q 'author' slim.yaml

# Recording the same run twice is a no-op rather than a second vote.
before="$(run_tool --ledger ledger.yaml propers --json 2>/dev/null)"
run_tool --ledger ledger.yaml record --results one.yaml --model test --audited-on 2026-07-30 >/dev/null
if [ "$before" != "$(run_tool --ledger ledger.yaml propers --json 2>/dev/null)" ]; then
	echo "re-recording an identical run must not change the collation" >&2
	exit 1
fi

# Promoting reports what it wrote in every output form. The text renderer once
# iterated a count as if it were the list of works, so a text-mode promote
# crashed -- after writing the index, leaving the operator no report of it.
run_tool --ledger ledger.yaml --index index.yaml promote --audited-on 2026-07-30 >promote.txt
if ! grep -q 'status: promoted' promote.txt; then
	echo "a text-mode promote must report what it did" >&2
	exit 1
fi
if [ ! -s index.yaml ]; then
	echo "promote should have written the index" >&2
	exit 1
fi
run_tool --ledger ledger.yaml --index index.yaml --json promote --audited-on 2026-07-30 >/dev/null
run_tool --ledger ledger.yaml --index index.yaml --format yaml promote --audited-on 2026-07-30 >/dev/null

# And it writes only once it can report: a render that cannot complete must
# leave nothing behind, because a tool that writes then fails tells an operator
# nothing about what landed. /dev/full fails every write to it.
rm -f unwritten.yaml
if [ -w /dev/full ]; then
	run_tool --ledger ledger.yaml --index unwritten.yaml promote --audited-on 2026-07-30 \
		>/dev/full 2>/dev/null && true
	if [ -e unwritten.yaml ]; then
		echo "a promote whose report failed must not leave an index behind" >&2
		exit 1
	fi
fi

# A dry run never writes.
rm -f none.yaml
run_tool --ledger ledger.yaml --index none.yaml promote --audited-on 2026-07-30 --dry-run >/dev/null
if [ -e none.yaml ]; then
	echo "--dry-run must not write the index" >&2
	exit 1
fi

# Concurrent records must not lose runs. Each verb loads, mutates and dumps the
# whole ledger, so unserialised they overwrite each other and both report
# success; the ledger was seen falling from six runs to three that way.
rm -f concurrent.yaml concurrent.yaml.lock
i=1
while [ "$i" -le 8 ]; do
	write_run "c$i.yaml" "Concurrent $i" "''"
	i=$((i + 1))
done
i=1
while [ "$i" -le 8 ]; do
	run_tool --ledger concurrent.yaml record --results "c$i.yaml" --model test \
		--audited-on 2026-07-30 >/dev/null &
	i=$((i + 1))
done
wait
recorded="$(grep -c 'run_id:' concurrent.yaml)"
if [ "$recorded" -ne 8 ]; then
	echo "eight concurrent records should leave eight runs, got $recorded" >&2
	exit 1
fi

# Recorded evidence is the one thing this tool cannot rebuild, so a write that
# would leave fewer runs than the file holds is refused rather than done.
if "${PYTHON:-python3}" - "$repo" concurrent.yaml >/dev/null 2>&1 <<'PY'
import sys
from pathlib import Path
from importlib.machinery import SourceFileLoader
harvest = SourceFileLoader("harvest", f"{sys.argv[1]}/tools/harvest").load_module()
path = Path(sys.argv[2])
harvest._dump_ledger(path, {"schema": "x", "runs": harvest._ledger_runs(harvest._load(path))[:2]})
PY
then
	echo "expected a shrinking ledger write to be refused" >&2
	exit 1
fi
if [ "$(grep -c 'run_id:' concurrent.yaml)" -ne 8 ]; then
	echo "a refused write must leave the ledger untouched" >&2
	exit 1
fi

# The work-alias table decides which titles name one work. It is derived from
# the aliases the runs asserted, and validated: one title reaching two groups is
# the failure it exists to prevent.
run_tool --ledger ledger.yaml --alias-table aliases.yaml aliases --rebuild \
	--audited-on 2026-07-30 --json >/dev/null
if ! grep -q 'expositions on the psalms' aliases.yaml; then
	echo "the derived table should group the two names the runs equated" >&2
	exit 1
fi
run_tool --ledger ledger.yaml --alias-table aliases.yaml aliases --json 2>/dev/null \
	| grep -q '"status":"current"'

cat >split.yaml <<'YAML'
schema: triptych-commentary-work-aliases/v1
groups:
- author: Augustine of Hippo
  work: Enarrationes in Psalmos
  titles: [enarrationes in psalmos, expositions on the psalms]
- author: Augustine of Hippo
  work: De civitate Dei
  titles: [de civitate dei, expositions on the psalms]
YAML
if run_tool --ledger ledger.yaml --alias-table split.yaml promote --audited-on 2026-07-30 \
	>/dev/null 2>&1; then
	echo "a title mapping into two groups must be refused" >&2
	exit 1
fi

# A run asserting an alias the table has not accounted for ages it, and promote
# stops rather than promoting a work identity nobody has looked at.
write_run three.yaml 'Enarrationes in Psalmos' "'Commentary on the Psalms'"
run_tool --ledger ledger.yaml record --results three.yaml --model test --audited-on 2026-07-31 >/dev/null
run_tool --ledger ledger.yaml --alias-table aliases.yaml aliases --json 2>/dev/null \
	| grep -q '"status":"stale"'
if run_tool --ledger ledger.yaml --alias-table aliases.yaml --index index.yaml \
	promote --audited-on 2026-07-31 >/dev/null 2>&1; then
	echo "promoting against a table the ledger outgrew must be refused" >&2
	exit 1
fi

for bad in "plan" "record --results one.yaml --model test" "propers --top notanumber"; do
	# shellcheck disable=SC2086
	if run_tool $bad >/dev/null 2>&1; then
		echo "expected failure for: $bad" >&2
		exit 1
	fi
done

echo ok
