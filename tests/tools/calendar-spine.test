#!/bin/sh
# Test for `tools/tpt calendar-spine`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="calendar-spine"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

# The 1962 total must match the collated inventory: 275 dated universal rows.
total="$(run_tool --calendar roman-1962 2>/dev/null | wc -l | tr -d ' ')"
if [ "$total" -ne 275 ]; then
	echo "expected 275 rows in the 1962 spine, got $total" >&2
	exit 1
fi

# Both calendars are ordered by civil date, and the order is stable.
check_sorted() {
	run_tool --calendar "$1" 2>/dev/null | cut -f2 >dates.txt
	sort dates.txt >sorted.txt
	if ! cmp -s dates.txt sorted.txt; then
		echo "$1 spine is not in calendar-date order" >&2
		exit 1
	fi
	if [ "$(head -1 dates.txt | cut -d- -f1)" != "01" ]; then
		echo "$1 spine does not begin in January" >&2
		exit 1
	fi
}

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"
check_sorted roman-1962
check_sorted postconciliar

# Output is byte-stable for unchanged inputs.
run_tool --json >first.json 2>/dev/null
run_tool --json >second.json 2>/dev/null
if ! cmp -s first.json second.json; then
	echo "output is not byte-stable across runs" >&2
	exit 1
fi

# Keys and registries are unique within each calendar.
for calendar in roman-1962 postconciliar; do
	run_tool --calendar "$calendar" 2>/dev/null | cut -f6 >keys.txt
	if [ "$(sort keys.txt | uniq -d | wc -l | tr -d ' ')" -ne 0 ]; then
		echo "$calendar has duplicate keys:" >&2
		sort keys.txt | uniq -d >&2
		exit 1
	fi
	run_tool --calendar "$calendar" 2>/dev/null | cut -f4 >registries.txt
	if [ "$(sort registries.txt | uniq -d | wc -l | tr -d ' ')" -ne 0 ]; then
		echo "$calendar has duplicate registries:" >&2
		sort registries.txt | uniq -d >&2
		exit 1
	fi
done

# Separately keyed Masses on one civil date remain separate spine rows.  The
# first keeps the date registry; every later row takes its explicit source
# discriminator.  Their singular ranks and titles must not be joined again.
run_tool --calendar postconciliar 2>/dev/null | awk -F'\t' '$2 == "08-07"' >august-7.txt
if [ "$(wc -l <august-7.txt | tr -d ' ')" -ne 2 ]; then
	echo "expected two postconciliar rows on August 7" >&2
	exit 1
fi
if ! awk -F'\t' '$4 == "pc-08-07" && $5 == "Optional memorial" && $6 == "saints-sixtus-ii-pope-companions-martyrs" && $7 == "Saints Sixtus II, Pope, and Companions, Martyrs" {found=1} END {exit !found}' august-7.txt; then
	echo "the August 7 martyrs do not retain the base date identity" >&2
	exit 1
fi
if ! awk -F'\t' '$4 == "pc-08-07-cajetan" && $5 == "Optional memorial" && $6 == "saint-cajetan-priest" && $7 == "Saint Cajetan, Priest" {found=1} END {exit !found}' august-7.txt; then
	echo "Saint Cajetan does not carry the source-authored date discriminator" >&2
	exit 1
fi

# The source-authored discriminator contract fails closed.  It is not inferred
# from a display name, and it cannot silently renumber the first row on a date.
/usr/bin/python3 - "$repo/tools/calendar-spine" <<'PY'
import copy
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

loader = SourceFileLoader("calendar_spine_discriminator", sys.argv[1])
spec = spec_from_loader(loader.name, loader)
module = module_from_spec(spec)
loader.exec_module(module)

base = [
    {"month": 8, "day": 7, "title": "Saint Alpha", "rank": "Optional memorial", "discriminator": None},
    {"month": 8, "day": 7, "title": "Saint Beta", "rank": "Optional memorial", "discriminator": "beta"},
]

original_sources = module.SOURCES
original_parsers = module.PARSERS
try:
    module.SOURCES = {"postconciliar": (None, ())}
    for label, rows, expected in (
        ("impossible calendar date", [dict(base[0], month=2, day=30)], "impossible calendar date"),
        ("first-row discriminator", [dict(base[0], discriminator="alpha")], "first row on a date"),
        ("missing discriminator", [base[0], dict(base[1], discriminator=None)], "requires a source-authored"),
        ("duplicate discriminator", [base[0], base[1], dict(base[1], title="Saint Gamma")], "duplicate calendar-spine registry"),
        ("invalid discriminator", [base[0], dict(base[1], discriminator="Saint Beta")], "lowercase kebab-case"),
    ):
        module.PARSERS = {"postconciliar": lambda _directory, _names, rows=rows: copy.deepcopy(rows)}
        try:
            module.spine("postconciliar")
        except ValueError as error:
            if expected not in str(error):
                raise SystemExit(f"{label}: wrong diagnostic: {error}")
        else:
            raise SystemExit(f"{label}: invalid source was accepted")
finally:
    module.SOURCES = original_sources
    module.PARSERS = original_parsers
PY

# Classification follows each edition's own title: the 1962 books print
# February 2 and March 25 as Marian, the postconciliar books as of the Lord.
kind_on() {
	run_tool --calendar "$1" 2>/dev/null | awk -F'\t' -v d="$2" '$2 == d {print $3; exit}'
}
for probe in "roman-1962 02-02 marian" "roman-1962 03-25 marian" \
	"postconciliar 02-02 christological" "postconciliar 03-25 christological" \
	"roman-1962 08-15 marian" "roman-1962 08-14 marian" \
	"roman-1962 12-30 seasonal" \
	"roman-1962 09-14 christological" "postconciliar 09-14 christological"; do
	set -- $probe
	got="$(kind_on "$1" "$2")"
	if [ "$got" != "$3" ]; then
		echo "$1 $2: expected $3, got ${got:-nothing}" >&2
		exit 1
	fi
done

# Within the Christmas octave the edition's punctuation decides: a colon
# introduces the day's own celebration (Stephen, John, the Innocents), a
# semicolon only a commemoration, so the octave day itself stays seasonal.
for probe in "roman-1962 12-26 sanctoral" "roman-1962 12-27 sanctoral" \
	"roman-1962 12-28 sanctoral" \
	"roman-1962 12-29 seasonal" "roman-1962 12-31 seasonal"; do
	set -- $probe
	got="$(kind_on "$1" "$2")"
	if [ "$got" != "$3" ]; then
		echo "$1 $2: expected $3, got ${got:-nothing}" >&2
		exit 1
	fi
done

# Only the three colon-introduced days leave the seasonal kind; the other
# octave days must not follow them.
seasonal="$(run_tool --calendar roman-1962 --kind seasonal 2>/dev/null | wc -l | tr -d ' ')"
if [ "$seasonal" -ne 3 ]; then
	echo "expected 3 seasonal 1962 entries, got $seasonal" >&2
	exit 1
fi

# A saint's feast that names Our Lady stays a saint's feast, and a saint whose
# name merely contains "Domini" is not read as a feast of the Lord.
for probe in "roman-1962 03-19 sanctoral" "roman-1962 08-16 sanctoral" \
	"roman-1962 07-26 sanctoral" "roman-1962 08-04 sanctoral" \
	"postconciliar 03-19 sanctoral" "postconciliar 07-26 sanctoral" \
	"postconciliar 08-08 sanctoral"; do
	set -- $probe
	got="$(kind_on "$1" "$2")"
	if [ "$got" != "$3" ]; then
		echo "$1 $2: expected $3, got ${got:-nothing}" >&2
		exit 1
	fi
done

# --kind filters, and every kind in the roster is a legal choice.
marian="$(run_tool --calendar postconciliar --kind marian 2>/dev/null | wc -l | tr -d ' ')"
if [ "$marian" -ne 14 ]; then
	echo "expected 14 postconciliar Marian entries, got $marian" >&2
	exit 1
fi
if run_tool --kind nonesuch >/dev/null 2>&1; then
	echo "expected an unknown kind to be refused" >&2
	exit 1
fi
if run_tool --calendar nonesuch >/dev/null 2>&1; then
	echo "expected an unknown calendar to be refused" >&2
	exit 1
fi

# Every row carries a registry id prefixed for its calendar.
if run_tool --calendar roman-1962 2>/dev/null | cut -f4 | grep -qv '^1962-'; then
	echo "a 1962 row carries a foreign registry prefix" >&2
	exit 1
fi
if run_tool --calendar postconciliar 2>/dev/null | cut -f4 | grep -qv '^pc-'; then
	echo "a postconciliar row carries a foreign registry prefix" >&2
	exit 1
fi

echo ok
