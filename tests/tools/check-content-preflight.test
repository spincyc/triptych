#!/bin/sh
# Test for `tools/tpt check-content-preflight`: exit 0 = pass.
#
# A content-preflight gate judges this tool by exit code alone, so the
# refusals below matter as much as the passes: a tool that accepted
# everything would satisfy every "does it pass" assertion and gate nothing.
# Each check therefore appears twice — once over a leaf that satisfies it and
# once over the same leaf with exactly that one thing broken.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="check-content-preflight"
ninth="liturgy/roman-rite/1962/propers/temporal/49-ninth-after-pentecost"

run_tool() {
	"$tool" "$tool_id" "$@"
}

fail() {
	echo "$1" >&2
	exit 1
}

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		fail "expected failure: $*"
	fi
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# --list is the enumeration every other assertion is written against.
run_tool --list >"$sandbox/first.txt"
listed="$(wc -l <"$sandbox/first.txt" | tr -d ' ')"
[ "$listed" = 6 ] || fail "--list named $listed checks, expected 6"
run_tool --list >"$sandbox/second.txt"
cmp -s "$sandbox/first.txt" "$sandbox/second.txt" || fail "--list is not byte-stable"
sort -c "$sandbox/first.txt" || fail "--list is not in sorted order"

# Every published 1962 proper leaf that carries a component manifest. These
# are documents the whole evaluation loop has already accepted, so a check
# that refuses one is refusing correct work.
leaves=0
for provider in claude gpt; do
	for leaf in "$repo/src/$provider"/liturgy/roman-rite/1962/propers/*/*/; do
		[ -f "$leaf/proper-components.toml" ] || continue
		slug="${leaf#"$repo/src/$provider/"}"
		slug="${slug%/}"
		run_tool --provider "$provider" --document "$slug" >/dev/null ||
			fail "published leaf refused: src/$provider/$slug"
		leaves=$((leaves + 1))
	done
done
[ "$leaves" -gt 0 ] || fail "found no published leaves: the regression checked nothing"

# Each check named alone must also pass on a published leaf, because that is
# how the gate runs them. `provenance-matches-run` is not one of them: it
# holds the leaf's provenance record against the run producing it, and the run
# that produced a published leaf is over. It is exercised below, over a
# synthetic leaf whose record can be written to state a run.
while read -r check; do
	[ "$check" = provenance-matches-run ] && continue
	run_tool --provider claude --document "$ninth" --check "$check" >/dev/null ||
		fail "$check refused a published leaf when run alone"
done <"$sandbox/first.txt"

# The whole preflight, with no check named, runs the five the tree can answer
# and leaves that one out rather than passing it for want of an answer.
run_tool --provider claude --document "$ninth" >"$sandbox/sweep.txt" ||
	fail "the whole preflight refused a published leaf"
if grep -q provenance-matches-run "$sandbox/sweep.txt"; then
	fail "the sweep reported a check it cannot answer"
fi

# --- A synthetic leaf, so each refusal can be produced one at a time -------

tree="$sandbox/tree"
mkdir -p "$tree/src/claude/probe/research" \
	"$tree/src/sources/works/catholic-church/missale-romanum" \
	"$tree/src/sources/works/probe-rights" \
	"$tree/src/sources/corpora"

cat >"$tree/src/sources/works/catholic-church/missale-romanum/work.toml" <<'TOML'
id = "work.catholic-church.missale-romanum"
record_type = "work"
TOML

# One public-domain artifact and one restricted one, the restricted one
# reached the way a real binding reaches it: through the passage that names it.
public_artifact="artifact.english-college-of-douay.douay-rheims-bible.challoner-1749.verse-text"
restricted_passage="passage.united-states-conference-of-catholic-bishops.new-american-bible-revised-edition.usccb-web.galatians"
restricted_artifact="artifact.united-states-conference-of-catholic-bishops.new-american-bible-revised-edition.usccb-web.galatians"

cat >"$tree/src/sources/works/probe-rights/douay.toml" <<TOML
record_type = "artifact"
id = "$public_artifact"
storage = "tracked"
rights_status = "public-domain"
TOML

cat >"$tree/src/sources/works/probe-rights/nabre-artifact.toml" <<TOML
record_type = "artifact"
id = "$restricted_artifact"
storage = "restricted"
rights_status = "restricted"
TOML

cat >"$tree/src/sources/works/probe-rights/nabre-passage.toml" <<TOML
record_type = "passage"
id = "$restricted_passage"
artifact_id = "$restricted_artifact"
TOML

write_bindings() {
	cat >"$tree/src/claude/probe/research/source-bindings.toml" <<TOML
schema = 1
record_type = "bindings"

[[bindings]]
source_id = "$public_artifact"
role = "translation-control"

[[bindings]]
source_id = "$restricted_passage"
role = "${1:-context}"
TOML
}

write_leaf() {
	cat >"$tree/src/claude/probe/main.tex" <<TEX
\\section*{Commentary}
Augustine, \\work{Enarrationes in Psalmos} 8, is read at the Introit.
Guéranger is summarised for the devotional reception only.

\\begin{namedtranslation}{$1}
O Lord our Lord, how admirable is thy name.
\\end{namedtranslation}

\\section*{References}
\\begin{itemize}
\\item Augustine, \\work{Enarrationes in Psalmos} 8. Registered in the
repository's source library as \\texttt{$2}.
\\item Prosper Guéranger, \\work{The Liturgical Year}, vol.~II.
\\textit{Cited only as a witness to devotional reception; it supplies no
English printed in this guide.}
\\end{itemize}
TEX
}

write_manifest() {
	cat >"$tree/src/claude/probe/proper-components.toml" <<TOML
schema = 1
record_type = "proper-components"
element_keys = ["introit", "collect", "gospel"]

[[components]]
key = "source-grounded-synthesis"
kind = "source-grounded-synthesis"
path = "main.tex"
element_keys = ["introit", "collect"]

[[relations]]
key = "probe-relation"
element_keys = [$1]
evidence = ["source-grounded-synthesis"]
TOML
}

good_translation='English: Douay--Rheims (Challoner), Ps. 8:2'
good_id='work.catholic-church.missale-romanum'
good_relation='"introit", "collect"'

probe() {
	run_tool --root "$tree" --provider claude --document probe "$@"
}

reject_probe() {
	if probe "$@" >/dev/null 2>&1; then
		fail "expected failure: probe $*"
	fi
}

# The whole preflight, green, so every refusal below is one thing changing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
write_bindings
probe >/dev/null || fail "the synthetic leaf does not pass as written"

# references-used: an entry nothing in the body names.
write_leaf "$good_translation" "$good_id"
cat >>"$tree/src/claude/probe/main.tex" <<'TEX'
\item Francis Blomefield, \work{An Essay towards a Topographical History of
the County of Norfolk}, vol.~4.
\end{itemize}
TEX
reject_probe --check references-used
probe --check relation-coverage >/dev/null ||
	fail "an unused reference broke a check that is not about references"

# identifiers-resolve: an identifier the source library does not register.
write_leaf "$good_translation" "edition.no-such-house.no-such-book.1861"
reject_probe --check identifiers-resolve
probe --check references-used >/dev/null ||
	fail "an unregistered identifier broke a check that is not about ids"

# An identifier split for the typesetter is still one identifier, not a
# truncated one that resolves to nothing.
write_leaf "$good_translation" "work.catholic-church.\\allowbreak
missale-romanum"
probe --check identifiers-resolve >/dev/null ||
	fail "an \\allowbreak inside an id was read as two ids"

# relation-coverage: a relation joining an element its evidence unit does not
# claim.
write_leaf "$good_translation" "$good_id"
write_manifest '"introit", "collect", "gospel"'
reject_probe --check relation-coverage
probe --check unquoted-not-quoted >/dev/null ||
	fail "an uncovered relation broke a check that is not about the manifest"
write_manifest "$good_relation"

# unquoted-not-quoted: a quotation credited to the source the References say
# supplies no printed English.
write_leaf "English: Guéranger, \\work{The Liturgical Year}, p.~224" "$good_id"
reject_probe --check unquoted-not-quoted
probe --check references-used >/dev/null ||
	fail "a contradicted quotation broke a check that is not about quotation"

# restricted-not-reproduced: the leaf declares the reproduction, by making a
# restricted artifact the control for its published English.
write_leaf "$good_translation" "$good_id"
write_bindings translation-control
reject_probe --check restricted-not-reproduced
probe --check references-used >/dev/null ||
	fail "a rights defect broke a check that is not about rights"
write_bindings

# restricted-not-reproduced: the leaf prints it, whatever the binding claims.
# The binding still says the source is only context.
write_leaf "New American Bible, Revised Edition, Gal. 5:16--24" "$good_id"
reject_probe --check restricted-not-reproduced
write_leaf "$good_translation" "$good_id"
probe --check restricted-not-reproduced >/dev/null ||
	fail "the public-domain translation control was refused"

# A leaf-local alias of the printed-passage environment is still a printed
# passage. Six of the twenty published propers use one.
cat >"$tree/src/claude/probe/format.tex" <<'TEX'
\newenvironment{fulltextenglish}[1]{\begin{sourcecard}{#1}\small}{\end{sourcecard}}
TEX
sed -e 's/namedtranslation/fulltextenglish/g' \
	-e "s/$good_translation/New American Bible, Revised Edition/" \
	"$tree/src/claude/probe/main.tex" >"$sandbox/aliased.tex"
cp "$sandbox/aliased.tex" "$tree/src/claude/probe/main.tex"
reject_probe --check restricted-not-reproduced
rm "$tree/src/claude/probe/format.tex"
write_leaf "$good_translation" "$good_id"

# A leaf with no manifest at all cannot have its relations checked, and says
# so rather than passing over nothing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
rm "$tree/src/claude/probe/proper-components.toml"
reject_probe --check relation-coverage
write_manifest "$good_relation"

# provenance-matches-run: the leaf's record of what produced it, against the
# run producing it. Five facts, and any one of them wrong is a refusal.
run_digest="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
run_seed="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

write_provenance() {
	cat >"$tree/src/claude/probe/generation-metadata.tex" <<TEX
\\AIDocumentRevisionTimestamp{2026-09-01T00:00:00Z}
\\AIGenerationProvenance{${1:-proper}}{${2:-16}}{${3:-$run_digest}}{${4:-0123456789abcdef}}{${5:-$run_seed}}{unknown}
\\AIModelContribution{a-model}{unexposed}{an agent}
TEX
}

against_run() {
	probe --check provenance-matches-run \
		--run-workflow proper --run-workflow-version 16 \
		--run-workflow-digest "$run_digest" \
		--run-id 0123456789abcdef --run-seed-commit "$run_seed" "$@"
}

write_provenance
against_run >/dev/null || fail "a record of this run was refused"

# The defect this check was written for: a version copied out of the leaf's
# own history instead of read off the packet header.
write_provenance proper 10
if against_run >/dev/null 2>&1; then
	fail "a record stating another workflow version was accepted"
fi

# A run id from the run before this one.
write_provenance proper 16 "$run_digest" feedfacefeedface
if against_run >/dev/null 2>&1; then
	fail "a record stating another run id was accepted"
fi

# A record that says the facts were unreadable, when the header carried them.
write_provenance unknown unknown unknown unknown unknown
if against_run >/dev/null 2>&1; then
	fail "a record stating nothing about its run was accepted"
fi

# No record at all.
: >"$tree/src/claude/probe/generation-metadata.tex"
if against_run >/dev/null 2>&1; then
	fail "a leaf with no provenance record was accepted"
fi
rm "$tree/src/claude/probe/generation-metadata.tex"
if against_run >/dev/null 2>&1; then
	fail "a leaf with no generation metadata was accepted"
fi

# And with no run to compare against, it is refused rather than skipped.
write_provenance
reject_probe --check provenance-matches-run
reject_probe --check provenance-matches-run --run-workflow proper
rm "$tree/src/claude/probe/generation-metadata.tex"

# --- Refusals about the invocation itself ----------------------------------

# Asking nothing is not a pass.
reject
# A leaf that does not exist, a provider that does not, and an id that tries
# to leave the provider root.
reject --provider claude --document liturgy/roman-rite/1962/propers/temporal/99-invented
reject --provider no-such-provider --document "$ninth"
reject --root "$tree" --provider claude --document ../../etc
# An unknown check name and an unknown flag are refused rather than ignored.
reject --provider claude --document "$ninth" --check no-such-check
reject --badflag

echo ok
