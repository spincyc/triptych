#!/bin/sh
# Test for `tools/tpt check-content-preflight`: exit 0 = pass.
#
# A content-preflight gate judges this tool by exit code alone, so the
# refusals below matter as much as the passes: a tool that accepted
# everything would satisfy every "does it pass" assertion and gate nothing.
# Each check therefore appears twice — once over a leaf that satisfies it and
# once over the same leaf with exactly that one thing broken.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="check-content-preflight"
ninth="liturgy/roman-rite/1962/propers/temporal/49-ninth-after-pentecost"

run_tool() {
	"$tool" "$tool_id" "$@"
}

fail() {
	echo "$1" >&2
	exit 1
}

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		fail "expected failure: $*"
	fi
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# --list is the enumeration every other assertion is written against.
run_tool --list >"$sandbox/first.txt"
listed="$(wc -l <"$sandbox/first.txt" | tr -d ' ')"
[ "$listed" = 4 ] || fail "--list named $listed checks, expected 4"
run_tool --list >"$sandbox/second.txt"
cmp -s "$sandbox/first.txt" "$sandbox/second.txt" || fail "--list is not byte-stable"
sort -c "$sandbox/first.txt" || fail "--list is not in sorted order"

# Every published 1962 proper leaf that carries a component manifest. These
# are documents the whole evaluation loop has already accepted, so a check
# that refuses one is refusing correct work.
leaves=0
for provider in claude gpt; do
	for leaf in "$repo/src/$provider"/liturgy/roman-rite/1962/propers/*/*/; do
		[ -f "$leaf/proper-components.toml" ] || continue
		slug="${leaf#"$repo/src/$provider/"}"
		slug="${slug%/}"
		run_tool --provider "$provider" --document "$slug" >/dev/null ||
			fail "published leaf refused: src/$provider/$slug"
		leaves=$((leaves + 1))
	done
done
[ "$leaves" -gt 0 ] || fail "found no published leaves: the regression checked nothing"

# Each check named alone must also pass on a published leaf, because that is
# how the gate runs them.
while read -r check; do
	run_tool --provider claude --document "$ninth" --check "$check" >/dev/null ||
		fail "$check refused a published leaf when run alone"
done <"$sandbox/first.txt"

# --- A synthetic leaf, so each refusal can be produced one at a time -------

tree="$sandbox/tree"
mkdir -p "$tree/src/claude/probe" \
	"$tree/src/sources/works/catholic-church/missale-romanum" \
	"$tree/src/sources/corpora"

cat >"$tree/src/sources/works/catholic-church/missale-romanum/work.toml" <<'TOML'
id = "work.catholic-church.missale-romanum"
record_type = "work"
TOML

write_leaf() {
	cat >"$tree/src/claude/probe/main.tex" <<TEX
\\section*{Commentary}
Augustine, \\work{Enarrationes in Psalmos} 8, is read at the Introit.
Guéranger is summarised for the devotional reception only.

\\begin{namedtranslation}{$1}
O Lord our Lord, how admirable is thy name.
\\end{namedtranslation}

\\section*{References}
\\begin{itemize}
\\item Augustine, \\work{Enarrationes in Psalmos} 8. Registered in the
repository's source library as \\texttt{$2}.
\\item Prosper Guéranger, \\work{The Liturgical Year}, vol.~II.
\\textit{Cited only as a witness to devotional reception; it supplies no
English printed in this guide.}
\\end{itemize}
TEX
}

write_manifest() {
	cat >"$tree/src/claude/probe/proper-components.toml" <<TOML
schema = 1
record_type = "proper-components"
element_keys = ["introit", "collect", "gospel"]

[[components]]
key = "source-grounded-synthesis"
kind = "source-grounded-synthesis"
path = "main.tex"
element_keys = ["introit", "collect"]

[[relations]]
key = "probe-relation"
element_keys = [$1]
evidence = ["source-grounded-synthesis"]
TOML
}

good_translation='English: Douay--Rheims (Challoner), Ps. 8:2'
good_id='work.catholic-church.missale-romanum'
good_relation='"introit", "collect"'

probe() {
	run_tool --root "$tree" --provider claude --document probe "$@"
}

reject_probe() {
	if probe "$@" >/dev/null 2>&1; then
		fail "expected failure: probe $*"
	fi
}

# The whole preflight, green, so every refusal below is one thing changing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
probe >/dev/null || fail "the synthetic leaf does not pass as written"

# references-used: an entry nothing in the body names.
write_leaf "$good_translation" "$good_id"
cat >>"$tree/src/claude/probe/main.tex" <<'TEX'
\item Francis Blomefield, \work{An Essay towards a Topographical History of
the County of Norfolk}, vol.~4.
\end{itemize}
TEX
reject_probe --check references-used
probe --check relation-coverage >/dev/null ||
	fail "an unused reference broke a check that is not about references"

# identifiers-resolve: an identifier the source library does not register.
write_leaf "$good_translation" "edition.no-such-house.no-such-book.1861"
reject_probe --check identifiers-resolve
probe --check references-used >/dev/null ||
	fail "an unregistered identifier broke a check that is not about ids"

# An identifier split for the typesetter is still one identifier, not a
# truncated one that resolves to nothing.
write_leaf "$good_translation" "work.catholic-church.\\allowbreak
missale-romanum"
probe --check identifiers-resolve >/dev/null ||
	fail "an \\allowbreak inside an id was read as two ids"

# relation-coverage: a relation joining an element its evidence unit does not
# claim.
write_leaf "$good_translation" "$good_id"
write_manifest '"introit", "collect", "gospel"'
reject_probe --check relation-coverage
probe --check unquoted-not-quoted >/dev/null ||
	fail "an uncovered relation broke a check that is not about the manifest"
write_manifest "$good_relation"

# unquoted-not-quoted: a quotation credited to the source the References say
# supplies no printed English.
write_leaf "English: Guéranger, \\work{The Liturgical Year}, p.~224" "$good_id"
reject_probe --check unquoted-not-quoted
probe --check references-used >/dev/null ||
	fail "a contradicted quotation broke a check that is not about quotation"

# A leaf with no manifest at all cannot have its relations checked, and says
# so rather than passing over nothing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
rm "$tree/src/claude/probe/proper-components.toml"
reject_probe --check relation-coverage
write_manifest "$good_relation"

# --- Refusals about the invocation itself ----------------------------------

# Asking nothing is not a pass.
reject
# A leaf that does not exist, a provider that does not, and an id that tries
# to leave the provider root.
reject --provider claude --document liturgy/roman-rite/1962/propers/temporal/99-invented
reject --provider no-such-provider --document "$ninth"
reject --root "$tree" --provider claude --document ../../etc
# An unknown check name and an unknown flag are refused rather than ignored.
reject --provider claude --document "$ninth" --check no-such-check
reject --badflag

echo ok
