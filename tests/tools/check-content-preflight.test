#!/bin/sh
# Test for `tools/tpt check-content-preflight`: exit 0 = pass.
#
# A content-preflight gate judges this tool by exit code alone, so the
# refusals below matter as much as the passes: a tool that accepted
# everything would satisfy every "does it pass" assertion and gate nothing.
# Each check therefore appears twice — once over a leaf that satisfies it and
# once over the same leaf with exactly that one thing broken.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="check-content-preflight"
ninth="liturgy/roman-rite/1962/propers/temporal/49-ninth-after-pentecost"

run_tool() {
	"$tool" "$tool_id" "$@"
}

fail() {
	echo "$1" >&2
	exit 1
}

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		fail "expected failure: $*"
	fi
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# --list is the enumeration every other assertion is written against.
run_tool --list >"$sandbox/first.txt"
listed="$(wc -l <"$sandbox/first.txt" | tr -d ' ')"
[ "$listed" = 11 ] || fail "--list named $listed checks, expected 11"
run_tool --list >"$sandbox/second.txt"
cmp -s "$sandbox/first.txt" "$sandbox/second.txt" || fail "--list is not byte-stable"
sort -c "$sandbox/first.txt" || fail "--list is not in sorted order"

# Every published 1962 proper leaf that carries a component manifest. These
# are documents the whole evaluation loop has already accepted, so a structural
# check that refuses one is refusing correct work.
#
# Two checks are held out of this loop, and the reason is a finding rather than
# an exemption. `house-voice` and `proposal-fields` screen reader-facing prose
# against `guidance/editorial.md` and the profile, and the corpus does not
# currently satisfy either: house-voice refuses eight of the twelve leaves and
# proposal-fields two, published ones among them. Every refusal inspected is a
# form the guidance names by example -- retrieval mechanics printed in the body
# of published leaf 52, five proposals in gpt leaf 52 that state no "what the
# element-by-element reading misses" field at all -- so the honest reading is
# that these checks found a habit the evaluation loop never screened for, not
# that they are wrong. Which way that gets settled is the maintainer's, and
# recorded in PROJECT-WORK.md. Until it is, asserting that they pass the corpus
# would assert something false, and dropping them from the tool would lose what
# they found.
#
# Being held out of the corpus loop is exactly why each of them gets the pair
# this file promises, over the synthetic probe leaf further down: a corpus
# count moves whenever a leaf is edited, and a rule change has to face a test.
prose_checks="house-voice proposal-fields"

structural_checks() {
	while read -r check; do
		case " $prose_checks " in
		*" $check "*) continue ;;
		esac
		printf '%s\n' "$check"
	done <"$sandbox/first.txt"
}

leaves=0
for provider in claude gpt; do
	for leaf in "$repo/src/$provider"/liturgy/roman-rite/1962/propers/*/*/; do
		[ -f "$leaf/proper-components.toml" ] || continue
		slug="${leaf#"$repo/src/$provider/"}"
		slug="${slug%/}"
		structural_checks | while read -r check; do
			[ "$check" = provenance-matches-run ] && continue
			run_tool --provider "$provider" --document "$slug" \
				--check "$check" >/dev/null ||
				fail "published leaf refused by $check: src/$provider/$slug"
		done
		leaves=$((leaves + 1))
	done
done
[ "$leaves" -gt 0 ] || fail "found no published leaves: the regression checked nothing"

# Each check named alone must also pass on a published leaf, because that is
# how the gate runs them. `provenance-matches-run` is not one of them: it
# holds the leaf's provenance record against the run producing it, and the run
# that produced a published leaf is over. It is exercised below, over a
# synthetic leaf whose record can be written to state a run.
structural_checks | while read -r check; do
	[ "$check" = provenance-matches-run ] && continue
	run_tool --provider claude --document "$ninth" --check "$check" >/dev/null ||
		fail "$check refused a published leaf when run alone"
done

# The whole preflight, with no check named, runs everything the tree can answer
# and leaves that one out rather than passing it for want of an answer. Run
# over a leaf that satisfies the prose checks as well, since the sweep names no
# check and so runs them too.
clean="liturgy/roman-rite/1962/propers/temporal/53-thirteenth-after-pentecost"
run_tool --provider gpt --document "$clean" >"$sandbox/sweep.txt" ||
	fail "the whole preflight refused a published leaf"
if grep -q provenance-matches-run "$sandbox/sweep.txt"; then
	fail "the sweep reported a check it cannot answer"
fi

# Both prose checks refuse a real leaf and accept another, which is the pair
# this file asserts of every other check. A screen that accepted everything
# would satisfy every "does it pass" assertion above and gate nothing.
for check in $prose_checks; do
	run_tool --provider gpt --document "$clean" --check "$check" >/dev/null ||
		fail "$check refused the leaf it is supposed to accept"
done
reject --provider claude \
	--document liturgy/roman-rite/1962/propers/temporal/54-fourteenth-after-pentecost \
	--check house-voice
reject --provider gpt \
	--document liturgy/roman-rite/1962/propers/temporal/52-twelfth-after-pentecost \
	--check proposal-fields

# --- A synthetic leaf, so each refusal can be produced one at a time -------

tree="$sandbox/tree"
# The library validates every record it loads and refuses one that is not at
# a canonical manifest path, so these fixtures live where a real record lives:
# works/<responsible>/<work>/, editions/<edition>/, and artifacts/passages
# below that.
probe_work="$tree/src/sources/works/catholic-church/missale-romanum"
probe_edition="$probe_work/editions/probe-edition"
mkdir -p "$tree/src/claude/probe/research" \
	"$probe_edition/artifacts/douay" \
	"$probe_edition/artifacts/nabre" \
	"$probe_edition/passages" \
	"$tree/src/sources/corpora"

# The source library validates every record it loads, so these fixtures have
# to satisfy its current required-field sets, not the ones they were written
# against. They fell behind a schema change and `bindings-valid` had been
# refusing this synthetic leaf outright since -- masked, because the stale
# check count above failed first.
cat >"$probe_work/work.toml" <<'TOML'
schema = 1
record_type = "work"
id = "work.catholic-church.missale-romanum"
title = "Missale Romanum"
responsible = "Catholic Church"
work_type = "liturgical-book"
TOML

cat >"$probe_edition/edition.toml" <<'TOML'
schema = 1
record_type = "edition"
id = "edition.probe.probe-edition.1749"
work_id = "work.catholic-church.missale-romanum"
title = "A probe edition"
language = "en"
publication = "1749"
TOML

# One public-domain artifact and one restricted one, the restricted one
# reached the way a real binding reaches it: through the passage that names it.
public_artifact="artifact.english-college-of-douay.douay-rheims-bible.challoner-1749.verse-text"
restricted_passage="passage.united-states-conference-of-catholic-bishops.new-american-bible-revised-edition.usccb-web.galatians"
restricted_artifact="artifact.united-states-conference-of-catholic-bishops.new-american-bible-revised-edition.usccb-web.galatians"

printf 'O Lord our Lord, how admirable is thy name.\n' \
	>"$probe_edition/artifacts/douay/text.txt"
douay_sha="$(python3 -c 'import hashlib,sys;print(hashlib.sha256(open(sys.argv[1],"rb").read()).hexdigest())' "$probe_edition/artifacts/douay/text.txt")"
douay_size="$(wc -c <"$probe_edition/artifacts/douay/text.txt" | tr -d ' ')"
cat >"$probe_edition/artifacts/douay/artifact.toml" <<TOML
schema = 1
record_type = "artifact"
id = "$public_artifact"
edition_id = "edition.probe.probe-edition.1749"
artifact_type = "text"
media_type = "text/plain"
storage = "tracked"
path = "src/sources/works/catholic-church/missale-romanum/editions/probe-edition/artifacts/douay/text.txt"
sha256 = "$douay_sha"
byte_size = $douay_size
retrieved = "2026-09-04"
provenance = "Written by this smoke test as a probe."
rights_status = "public-domain"
rights_jurisdiction = "United States"
rights_basis = "published 1749, public domain in the United States"
TOML

cat >"$probe_edition/artifacts/nabre/artifact.toml" <<TOML
schema = 1
record_type = "artifact"
id = "$restricted_artifact"
edition_id = "edition.probe.probe-edition.1749"
artifact_type = "text"
media_type = "text/plain"
storage = "restricted"
rights_status = "restricted"
rights_jurisdiction = "United States"
rights_basis = "in copyright; reproduced nowhere in this repository"
TOML

cat >"$probe_edition/passages/galatians.toml" <<TOML
schema = 1
record_type = "passage"
id = "$restricted_passage"
edition_id = "edition.probe.probe-edition.1749"
artifact_id = "$restricted_artifact"
locus = "Gal. 5:16-24"
states = ["cataloged"]
context = "A probe passage, reproduced nowhere."
TOML

write_bindings() {
	cat >"$tree/src/claude/probe/research/source-bindings.toml" <<TOML
schema = 1
record_type = "bindings"
document = "probe"

[[bindings]]
source_id = "$public_artifact"
role = "translation-control"
loci = ["Ps. 8:2"]
states = ["cataloged"]
context = "The English printed in this probe is this witness's words."

[[bindings]]
source_id = "$restricted_passage"
role = "${1:-context}"
loci = ["Gal. 5:16-24"]
states = ["cataloged"]
context = "Named as context only; no bytes of it are reproduced here."
TOML
}

write_leaf() {
	cat >"$tree/src/claude/probe/main.tex" <<TEX
\\section*{Commentary}
Augustine, \\work{Enarrationes in Psalmos} 8, is read at the Introit.
Guéranger is summarised for the devotional reception only.

\\begin{namedtranslation}{$1}
O Lord our Lord, how admirable is thy name.
\\end{namedtranslation}

\\section*{References}
\\begin{itemize}
\\item Augustine, \\work{Enarrationes in Psalmos} 8. Registered in the
repository's source library as \\texttt{$2}.
\\item Prosper Guéranger, \\work{The Liturgical Year}, vol.~II.
\\textit{Cited only as a witness to devotional reception; it supplies no
English printed in this guide.}
\\end{itemize}
TEX
}

write_manifest() {
	cat >"$tree/src/claude/probe/proper-components.toml" <<TOML
schema = 1
record_type = "proper-components"
element_keys = ["introit", "collect", "gospel"]

[[components]]
key = "source-grounded-synthesis"
kind = "source-grounded-synthesis"
path = "main.tex"
element_keys = ["introit", "collect"]

[[relations]]
key = "probe-relation"
element_keys = [$1]
evidence = ["source-grounded-synthesis"]
TOML
}

good_translation='English: Douay--Rheims (Challoner), Ps. 8:2'
good_id='work.catholic-church.missale-romanum'
good_relation='"introit", "collect"'

probe() {
	run_tool --root "$tree" --provider claude --document probe "$@"
}

reject_probe() {
	if probe "$@" >/dev/null 2>&1; then
		fail "expected failure: probe $*"
	fi
}

# The whole preflight, green, so every refusal below is one thing changing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
write_bindings
probe >/dev/null || fail "the synthetic leaf does not pass as written"

# references-used: an entry nothing in the body names.
write_leaf "$good_translation" "$good_id"
cat >>"$tree/src/claude/probe/main.tex" <<'TEX'
\item Francis Blomefield, \work{An Essay towards a Topographical History of
the County of Norfolk}, vol.~4.
\end{itemize}
TEX
reject_probe --check references-used
probe --check relation-coverage >/dev/null ||
	fail "an unused reference broke a check that is not about references"

# identifiers-resolve: an identifier the source library does not register.
write_leaf "$good_translation" "edition.no-such-house.no-such-book.1861"
reject_probe --check identifiers-resolve
probe --check references-used >/dev/null ||
	fail "an unregistered identifier broke a check that is not about ids"

# An identifier split for the typesetter is still one identifier, not a
# truncated one that resolves to nothing.
write_leaf "$good_translation" "work.catholic-church.\\allowbreak
missale-romanum"
probe --check identifiers-resolve >/dev/null ||
	fail "an \\allowbreak inside an id was read as two ids"

# relation-coverage: a relation joining an element its evidence unit does not
# claim.
write_leaf "$good_translation" "$good_id"
write_manifest '"introit", "collect", "gospel"'
reject_probe --check relation-coverage
probe --check unquoted-not-quoted >/dev/null ||
	fail "an uncovered relation broke a check that is not about the manifest"
write_manifest "$good_relation"

# unquoted-not-quoted: a quotation credited to the source the References say
# supplies no printed English.
write_leaf "English: Guéranger, \\work{The Liturgical Year}, p.~224" "$good_id"
reject_probe --check unquoted-not-quoted
probe --check references-used >/dev/null ||
	fail "a contradicted quotation broke a check that is not about quotation"

# restricted-not-reproduced: the leaf declares the reproduction, by making a
# restricted artifact the control for its published English.
write_leaf "$good_translation" "$good_id"
write_bindings translation-control
reject_probe --check restricted-not-reproduced
probe --check references-used >/dev/null ||
	fail "a rights defect broke a check that is not about rights"
write_bindings

# restricted-not-reproduced: the leaf prints it, whatever the binding claims.
# The binding still says the source is only context.
write_leaf "New American Bible, Revised Edition, Gal. 5:16--24" "$good_id"
reject_probe --check restricted-not-reproduced
write_leaf "$good_translation" "$good_id"
probe --check restricted-not-reproduced >/dev/null ||
	fail "the public-domain translation control was refused"

# A leaf-local alias of the printed-passage environment is still a printed
# passage. Six of the twenty published propers use one.
cat >"$tree/src/claude/probe/format.tex" <<'TEX'
\newenvironment{fulltextenglish}[1]{\begin{sourcecard}{#1}\small}{\end{sourcecard}}
TEX
sed -e 's/namedtranslation/fulltextenglish/g' \
	-e "s/$good_translation/New American Bible, Revised Edition/" \
	"$tree/src/claude/probe/main.tex" >"$sandbox/aliased.tex"
cp "$sandbox/aliased.tex" "$tree/src/claude/probe/main.tex"
reject_probe --check restricted-not-reproduced
rm "$tree/src/claude/probe/format.tex"
write_leaf "$good_translation" "$good_id"

# --- The two prose checks, one rule at a time ------------------------------
#
# The corpus loop above holds these two out, so until now nothing isolated a
# single rule: a rule change could only be judged against a corpus statistic,
# and the statistic moves whenever a leaf is edited. Below, each of them
# accepts the probe and then refuses it for exactly one thing.

# house-voice: the work in the subject position of its own sentence. The
# appended section is what ends the exempt References region above it; a
# sentence appended INSIDE References would prove nothing, that section being
# qualification by design.
write_leaf "$good_translation" "$good_id"
probe --check house-voice >/dev/null ||
	fail "the synthetic leaf does not keep the house voice as written"
cat >>"$tree/src/claude/probe/main.tex" <<'TEX'

\section*{Reception}
Augustine reads the psalm as the cry of the pilgrim Church. This guide has
composed, translated, adapted and paraphrased nothing.
TEX
reject_probe --check house-voice
probe --check references-used >/dev/null ||
	fail "a house-voice defect broke a check that is not about the voice"

# And the same words in a relative clause hanging off a source, which is a
# denominator and a rights basis and not a subject. A screen that refuses this
# tells a reviser to delete the ground of the publication's own lawfulness;
# `guidance/editorial.md` says this check "reports a sentence to rewrite,
# never a sentence to delete".
write_leaf "$good_translation" "$good_id"
cat >>"$tree/src/claude/probe/main.tex" <<'TEX'

\section*{Reception}
The Introit is printed in the Pustet Missal of Ratisbon, 1862, which this
repository tracks as public-domain text, and no Collect of any of the fifteen
identities this repository has collated asks for food or clothing.
TEX
probe --check house-voice >/dev/null ||
	fail "house-voice refused a denominator and a rights basis"
write_leaf "$good_translation" "$good_id"

# proposal-fields: the profile fixes five fields for every exploratory
# proposal. The title carries a macro and the fifth field is headed
# `Disconfirming condition`, because both are forms the published leaves use
# and both were unreadable to an earlier version of this check.
add_proposal() {
	fourth="${1:-What the ordinary reading misses}"
	closing='\end{proposal}'
	if [ "${2:-closed}" = open ]; then
		closing=''
	fi
	cat >>"$tree/src/claude/probe/main.tex" <<TEX

\\section*{The Propers: Interpretive Possibilities}
Everything below is exploratory editorial and AI proposal.

\\begin{proposal}{The Introit's \\latin{Deus} and the Collect's petition}
\\pfield{Anchors}{Introit \\cue{Intr.} and Collect \\cue{Coll.}}
\\pfield{Mechanism}{One address, made twice in two grammatical registers.}
\\pfield{Fruit}{The day's prayer is read as a single act.}
\\pfield{$fourth}{Element by element they are two prayers and not one.}
\\pfield{Disconfirming condition}{The Collect is older than this formulary's
use of it.}
$closing
TEX
}

write_leaf "$good_translation" "$good_id"
add_proposal
probe --check proposal-fields >/dev/null ||
	fail "a proposal stating all five fields was refused"

# Exactly one thing broken: a heading of the author's own devising in place of
# the fourth field. It reads on the page exactly like the field it replaced.
write_leaf "$good_translation" "$good_id"
add_proposal "What this proposal adds"
reject_probe --check proposal-fields
probe --check references-used >/dev/null ||
	fail "a missing proposal field broke a check that is not about proposals"

# A proposal the check cannot read is an error and not a skip: the count it
# prints says of every proposal it managed to parse that it states the five
# fields, and a proposal walked past would be reported as read.
write_leaf "$good_translation" "$good_id"
add_proposal "What the ordinary reading misses" open
reject_probe --check proposal-fields
write_leaf "$good_translation" "$good_id"

# A leaf with no manifest at all cannot have its relations checked, and says
# so rather than passing over nothing.
write_leaf "$good_translation" "$good_id"
write_manifest "$good_relation"
rm "$tree/src/claude/probe/proper-components.toml"
reject_probe --check relation-coverage
write_manifest "$good_relation"

# provenance-matches-run: the leaf's record of what produced it, against the
# run producing it. Five facts, and any one of them wrong is a refusal.
run_digest="aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
run_seed="bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"

write_provenance() {
	cat >"$tree/src/claude/probe/generation-metadata.tex" <<TEX
\\AIDocumentRevisionTimestamp{2026-09-01T00:00:00Z}
\\AIGenerationProvenance{${1:-proper}}{${2:-16}}{${3:-$run_digest}}{${4:-0123456789abcdef}}{${5:-$run_seed}}{unknown}
\\AIModelContribution{a-model}{unexposed}{an agent}
TEX
}

against_run() {
	probe --check provenance-matches-run \
		--run-workflow proper --run-workflow-version 16 \
		--run-workflow-digest "$run_digest" \
		--run-id 0123456789abcdef --run-seed-commit "$run_seed" "$@"
}

write_provenance
against_run >/dev/null || fail "a record of this run was refused"

# The defect this check was written for: a version copied out of the leaf's
# own history instead of read off the packet header.
write_provenance proper 10
if against_run >/dev/null 2>&1; then
	fail "a record stating another workflow version was accepted"
fi

# A run id from the run before this one.
write_provenance proper 16 "$run_digest" feedfacefeedface
if against_run >/dev/null 2>&1; then
	fail "a record stating another run id was accepted"
fi

# A record that says the facts were unreadable, when the header carried them.
write_provenance unknown unknown unknown unknown unknown
if against_run >/dev/null 2>&1; then
	fail "a record stating nothing about its run was accepted"
fi

# No record at all.
: >"$tree/src/claude/probe/generation-metadata.tex"
if against_run >/dev/null 2>&1; then
	fail "a leaf with no provenance record was accepted"
fi
rm "$tree/src/claude/probe/generation-metadata.tex"
if against_run >/dev/null 2>&1; then
	fail "a leaf with no generation metadata was accepted"
fi

# And with no run to compare against, it is refused rather than skipped.
write_provenance
reject_probe --check provenance-matches-run
reject_probe --check provenance-matches-run --run-workflow proper
rm "$tree/src/claude/probe/generation-metadata.tex"

# --- The chronology contract, over a real formulary ------------------------
#
# `guidance/scripture-chronology.md` section 14: a proper that needs a
# biblical date MUST read the chronology corpus and may not infer, research,
# harmonize or recall a replacement. These two checks are how that is
# enforced, and every assertion below RUNS them rather than reading their
# command line. The leaf has to be a registered identity at its real path,
# because the loci come from the calendar's own resolution of the formulary.

chrono="$sandbox/chrono"
fourteenth="liturgy/roman-rite/1962/propers/temporal/54-fourteenth-after-pentecost"
mkdir -p "$chrono/src/claude/$(dirname "$fourteenth")"
cp -R "$repo/src/claude/$fourteenth" "$chrono/src/claude/$fourteenth"
ln -s "$repo/src/sources" "$chrono/src/sources"
rm -f "$chrono/src/claude/$fourteenth/research/chronology.toml"

bound() {
	run_tool --root "$chrono" --provider claude --document "$fourteenth" "$@"
}

reject_bound() {
	if bound "$@" >/dev/null 2>&1; then
		fail "expected failure: bound $*"
	fi
}

# The provenance record is written here rather than edited in place, because
# what the copied leaf happens to state is whatever production last ran over
# it -- it has since been re-authored by `proper-finish` -- and a fixture that
# greps for one version silently stops testing anything when that changes.

state_production() {
	metadata="$chrono/src/claude/$fourteenth/generation-metadata.tex"
	rest="$(grep -v AIGenerationProvenance "$metadata")"
	{
		printf '%s\n' "\\AIGenerationProvenance{$1}{$2}{unknown}{unknown}{unknown}{unknown}"
		printf '%s\n' "$rest"
	} >"$metadata.new"
	mv "$metadata.new" "$metadata"
}

# A leaf produced before the contract binds is reported out of scope rather
# than refused: the work was correct when it was done.
state_production proper 11
bound --check chronology-record-current >/dev/null ||
	fail "a leaf published before the contract was refused"
bound --check chronology-claims-supported >/dev/null ||
	fail "a leaf published before the contract was refused"

# The rescue pipeline binds at every version of itself, because it was written
# after the contract and runs the same gate. A rule keyed on `proper` alone
# read its provenance as no record at all and passed the leaf for want of an
# answer.
state_production proper-finish 1
reject_bound --check chronology-record-current

# Bind it as the full pipeline too: the leaf now says a version that carries
# the contract.
state_production proper 17

# A bound leaf with no chronology record cannot have carried the corpus's ids.
reject_bound --check chronology-record-current
"$tool" proper-chronology record --root "$chrono" --provider claude \
	--document "$fourteenth" --write >/dev/null ||
	fail "the record generator refused a registered formulary"
bound --check chronology-record-current >/dev/null ||
	fail "the record the generator just wrote was refused"

# A record edited to say what a guide wishes the corpus said. This is the
# defect the whole wiring exists for: the figure is well-formed, and a reader
# cannot tell it from the corpus's own.
record="$chrono/src/claude/$fourteenth/research/chronology.toml"
cp "$record" "$sandbox/record.bak"
sed 's/^label = "A. M. 2944, A. C. 1060"$/label = "1055-1015 B.C."/' \
	"$sandbox/record.bak" >"$record"
if cmp -s "$record" "$sandbox/record.bak"; then
	fail "the edit changed nothing, so the refusal below proves nothing"
fi
reject_bound --check chronology-record-current
cp "$sandbox/record.bak" "$record"
bound --check chronology-record-current >/dev/null ||
	fail "the restored record was refused"

dossier="$chrono/src/claude/$fourteenth/sections/10-date-location.tex"

write_dossier() {
	cat >"$dossier" <<TEX
\\section*{Scriptural Date and Location}
\\chronodate{introit}{\\chronology{composition.psalms-of-the-sons-of-korah}{composition}{between the days of Isaias and the return from exile}}
\\chronodate{epistle}{\\chronology{composition.epistle-to-the-galatians}{composition}{${1:-A.D.~57 or 58}}}
\\chronodate{gradual}{${2:-No year is held for this psalm.}}
\\chronodate{alleluia}{No year is held for this psalm.}
\\chronodate{gospel,communion}{\\chronology{composition.gospel-of-matthew}{composition}{about the year 50}}
\\chronodate{offertory}{\\chronology{israel.monarchy.david-at-geth}{superscription-setting}{A.~M.~2944, A.~C.~1060}}
TEX
}

# A leaf that prints only what the corpus asserts, in the corpus's own words,
# with a cell for every appointed Scripture. LaTeX ties and an en-dash are not
# a different date, and the check must not make an author fight its typesetter.
write_dossier
bound --check chronology-claims-supported >/dev/null ||
	fail "a dossier built entirely from corpus assertions was refused"

# Every appointed Scripture needs a cell. An element with none is
# indistinguishable from one whose date was forgotten.
grep -v 'chronodate{alleluia}' "$dossier" >"$sandbox/no-alleluia.tex"
cp "$sandbox/no-alleluia.tex" "$dossier"
reject_bound --check chronology-claims-supported

# A date the corpus does not support. Cornelius a Lapide's A.D. 58 is a real
# reading of a real source and the corpus does not assert it, which is exactly
# the case section 14 is about.
write_dossier 'A.D.~58'
reject_bound --check chronology-claims-supported

# An invented date where the corpus returns undated-in-tradition. There is no
# claim to make at Ps. 117, so a figure in that cell has nothing behind it.
write_dossier '' "David's reign, 1055--1015 B.C."
reject_bound --check chronology-claims-supported

# A real corpus assertion, printed at an element whose verses it says nothing
# about.
write_dossier '' '\\chronology{israel.monarchy.david-at-geth}{superscription-setting}{A.~M.~2944, A.~C.~1060}'
reject_bound --check chronology-claims-supported

# A cell naming several elements prints ONE date for all of them, so the claim
# in it must be one the corpus makes at every element the cell names. Held
# against the union instead, naming an extra element both widened what the cell
# could print and satisfied the coverage rule.
write_dossier
sed 's|.*chronodate{gradual}.*|\\chronodate{gradual,epistle}{\\chronology{composition.epistle-to-the-galatians}{composition}{A.D.~49-50}}|' \
	"$dossier" >"$sandbox/shared.tex"
if cmp -s "$sandbox/shared.tex" "$dossier"; then
	fail "the sed edit changed nothing, so the refusal below proves nothing"
fi
cp "$sandbox/shared.tex" "$dossier"
reject_bound --check chronology-claims-supported

# The widest shape of the same defect: one cell for the whole formulary,
# carrying one year for every appointed text at once.
cat >"$dossier" <<'TEX'
\section*{Scriptural Date and Location}
\chronodate{introit,epistle,gradual,alleluia,gospel,offertory,communion}{\chronology{composition.epistle-to-the-galatians}{composition}{A.D.~49-50}}
TEX
reject_bound --check chronology-claims-supported

# Two cells for one appointed text are two dates and nothing saying which.
write_dossier
printf '%s\n' '\\chronodate{gradual}{No year is held for this psalm.}' >>"$dossier"
reject_bound --check chronology-claims-supported

# A figure typeset by \texttt is a figure the reader sees. The digit scan runs
# over the cell as written, because `prose()` drops \texttt whole and so let
# the same date through with five characters around it.
write_dossier '' 'David reigned \texttt{1055--1015 B.C.}'
reject_bound --check chronology-claims-supported

# A claim standing outside any date cell is held to the same rule.
write_dossier
printf '%s\n' '\\chronology{composition.gospel-of-matthew}{composition}{about the year 51}' >>"$dossier"
reject_bound --check chronology-claims-supported

# The other six checks must be unaffected by any of it.
write_dossier
bound --check references-used >/dev/null ||
	fail "the chronology fixture broke a check that is not about chronology"

# --- Refusals about the invocation itself ----------------------------------

# Asking nothing is not a pass.
reject
# A leaf that does not exist, a provider that does not, and an id that tries
# to leave the provider root.
reject --provider claude --document liturgy/roman-rite/1962/propers/temporal/99-invented
reject --provider no-such-provider --document "$ninth"
reject --root "$tree" --provider claude --document ../../etc
# An unknown check name and an unknown flag are refused rather than ignored.
reject --provider claude --document "$ninth" --check no-such-check
reject --badflag

echo ok
