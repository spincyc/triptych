#!/bin/sh
# Test for `tools/tpt calendar-days`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="calendar-days"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# The computation agrees with every worked table in the guidance.
run_tool check >/dev/null

# A short span keeps the gate quick; the shape is the same at any span.
run_tool structure --out "$sandbox/data" --first 2024 --last 2028 >/dev/null
root="$sandbox/data/structure/calendar"
if [ ! -f "$root/index.json" ]; then
	echo "structure wrote no calendar index" >&2
	exit 1
fi

python3 - "$repo" "$root" <<'PY'
import json, pathlib, sys

repo, root = pathlib.Path(sys.argv[1]), pathlib.Path(sys.argv[2])
years = list(range(2024, 2029))

index = json.loads((root / "index.json").read_text(encoding="utf-8"))
names = [entry["calendar"] for entry in index["calendars"]]
assert "roman-1962" in names and "postconciliar" in names, names
# Nothing computed may be offered as a witness, so the advisory travels with
# every file rather than living in a page the data could be served without.
for word in ("finding aid", "Ordo"):
    assert word in index["advisory"], index["advisory"]

# File counts stay additive: one file per year per calendar, plus one index.
written = sorted(p for p in root.rglob("*.json"))
assert len(written) == len(years) * len(names) + 1, [p.name for p in written]

sys.path.insert(0, str(repo / "scripts"))
import _calendars

for entry in index["calendars"]:
    name = entry["calendar"]
    # The EFFECTIVE document, which for a recension is its base with its
    # departures applied. Reading the file as written passed while the only
    # calendars were whole ones and failed the moment a recension landed: a
    # recension states its departures and nothing else, so every key it
    # inherits looked like a key its calendar does not carry. The tool emits
    # what the day actually appoints, and that is what this must compare with.
    masses = {
        mass["key"]: mass
        for body in _calendars.load_document(
            repo / "src/sources/calendars", name, effective=True
        )["sections"].values()
        for mass in ((body or {}).get("masses") or [])
    }
    # The path template is what a page substitutes into, so it must name the
    # only variable it carries.
    assert "{civil_year}" in entry["path"], entry["path"]

    for civil_year in years:
        document = json.loads((root / name / f"{civil_year}.json").read_text(encoding="utf-8"))
        assert document["civil_year"] == civil_year
        # A computed table never ranks what the guidance does not rank.
        assert document["precedence"]["stated"] is False

        for stamp, candidates in document["days"].items():
            assert stamp.startswith(f"{civil_year}-"), stamp
            assert candidates, stamp
            for candidate in candidates:
                # Every emitted key is a mass this calendar actually carries.
                assert candidate["key"] in masses, (name, stamp, candidate["key"])
                assert 0 <= candidate["rule"] < len(document["rules"]), candidate

        # Every day of the civil year sits in exactly one season of exactly one
        # of the liturgical years the file carries, so a date with no mass can
        # still be named.
        seasons = [
            (span["from"], span["to"])
            for year in document["liturgical_years"]
            for span in year["seasons"]
        ]
        for month, day in ((1, 1), (6, 15), (12, 31)):
            stamp = f"{civil_year}-{month:02d}-{day:02d}"
            covering = [pair for pair in seasons if pair[0] <= stamp <= pair[1]]
            assert len(covering) == 1, (name, stamp, covering)

        for year in document["liturgical_years"]:
            assert year["begins"] < year["ends"]
            # Keyed on what the index DECLARES about this calendar, not on its
            # name: the pre-1955 recension is a second calendar with no cycle,
            # and a name test sent it down the postconciliar branch.
            if not entry["lectionary_cycles"]:
                # A system with no Lectionary cycle must never be given one.
                assert year["lectionary"] is None, (name, year["lectionary"])
            else:
                assert year["lectionary"]["sunday"] in ("A", "B", "C")
                assert year["lectionary"]["weekday"] in ("I", "II")

# The cycle turns at the First Sunday of Advent, not at 1 January, and the
# weekday numeral is resolved independently of the letter.
document = json.loads((root / "postconciliar" / "2026.json").read_text(encoding="utf-8"))
cycles = {year["year"]: year["lectionary"] for year in document["liturgical_years"]}
assert cycles[2026]["sunday"] == "A" and cycles[2026]["weekday"] == "II", cycles
assert cycles[2027]["sunday"] == "B" and cycles[2027]["weekday"] == "I", cycles
assert [y for y in document["liturgical_years"] if y["year"] == 2026][0]["begins"] == "2025-11-30"

# The dates the guidance works out by hand.
keys = {stamp: {c["key"] for c in row} for stamp, row in document["days"].items()}
assert "easter-sunday" in keys["2026-04-05"], keys.get("2026-04-05")
assert "pentecost" in keys["2026-05-24"], keys.get("2026-05-24")
assert "most-holy-trinity" in keys["2026-05-31"], keys.get("2026-05-31")
assert "advent-1" in keys["2026-11-29"], keys.get("2026-11-29")
assert "christ-the-king" in keys["2026-11-22"], keys.get("2026-11-22")
# 2026 omits Ordinary Time week 7, so its Sunday never occurs.
assert not any("ot-7" in row for row in keys.values()), "the omitted week was placed"
assert [y for y in document["liturgical_years"] if y["year"] == 2026][0]["facts"]["omitted_week"] == 7

# A territorial transfer is shown, never chosen: the Ascension stands on both
# the Thursday and the Sunday, each tagged with the option it holds under, and
# neither is offered untagged.
forms = {}
for stamp, row in document["days"].items():
    for candidate in row:
        if candidate["key"] == "ascension":
            forms[stamp] = candidate.get("territorial")
assert forms == {
    "2026-05-14": "ascension-thursday",
    "2026-05-17": "ascension-transferred-to-sunday",
}, forms

# The same for the Body and Blood of Christ, whose Sunday form displaces the
# numbered Sunday that otherwise stands there.
sunday = {c["key"]: c.get("territorial") for c in document["days"]["2026-06-07"]}
assert sunday == {
    "corpus-christi": "corpus-christi-transferred-to-sunday",
    "ot-10": "corpus-christi-thursday",
}, sunday

# The 1962 file must carry no postconciliar vocabulary at all.
older = json.loads((root / "roman-1962" / "2026.json").read_text(encoding="utf-8"))
assert "ordinary" not in json.dumps(older["days"]).lower()
for year in older["liturgical_years"]:
    assert year["ordinary_time_weeks"] == []
    facts = year["facts"]
    assert 1 <= facts["sundays_after_epiphany"] <= 6, facts
    assert 23 <= facts["sundays_after_pentecost"] <= 28, facts
    assert facts["surplus"] in (0, 1), facts
# The Epiphany is not transferred in this calendar, and the file says why.
assert "not computed" in older["territorial"]["epiphany"]["transferred_sunday_form"]

# The Ember Days, the two Litanies and the Sacred Heart, on the anchors the
# guidance states. Easter 2026 is 5 April; the Advent Ember Days of December
# 2026 belong to the liturgical year the same civil-year file also carries.
older_keys = {stamp: {c["key"] for c in row} for stamp, row in older["days"].items()}
for stamp, key in (
    # The greater Litanies keep 25 April; the lesser are the three days before
    # the Ascension, and one formulary serves all four.
    ("2026-04-25", "rogation-mass"),
    ("2026-05-11", "rogation-mass"),
    ("2026-05-12", "rogation-mass"),
    ("2026-05-13", "rogation-mass"),
    ("2026-06-12", "sacred-heart"),
    # After the third Sunday of September, which in 2026 is 20 September.
    ("2026-09-23", "september-ember-wednesday"),
    ("2026-09-25", "september-ember-friday"),
    ("2026-09-26", "september-ember-saturday"),
    # After the Third Sunday of Advent, which in 2026 is 13 December.
    ("2026-12-16", "advent-ember-wednesday"),
    ("2026-12-18", "advent-ember-friday"),
    ("2026-12-19", "advent-ember-saturday"),
):
    assert key in older_keys.get(stamp, set()), (stamp, key, older_keys.get(stamp))
# Each Ember and Litany mass stands on exactly the days computed for it and on
# no others, so a rule that also fired somewhere else would fail here.
for key, want in (
    ("rogation-mass", {"2026-04-25", "2026-05-11", "2026-05-12", "2026-05-13"}),
    ("sacred-heart", {"2026-06-12"}),
    ("september-ember-wednesday", {"2026-09-23"}),
    ("advent-ember-saturday", {"2026-12-19"}),
):
    got = {stamp for stamp, keys in older_keys.items() if key in keys}
    assert got == want, (key, sorted(got), sorted(want))
PY

# A year in which 25 December is a Sunday has no Sunday within the octave, and
# the guidance states no fallback, so the year refuses rather than inventing one.
run_tool structure --out "$sandbox/gap" --first 2022 --last 2022 >/dev/null
python3 - "$sandbox/gap/structure/calendar" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])
document = json.loads((root / "postconciliar" / "2022.json").read_text(encoding="utf-8"))
year = [y for y in document["liturgical_years"] if y["year"] == 2023][0]
refused = [row["what"] for row in year["unresolved"]]
assert "holy-family" in refused, year["unresolved"]
assert "2022-12-25" in document["days"]
assert all("holy-family" not in c["key"] for c in document["days"]["2022-12-25"])
PY

# The postconciliar weekday series: where each position falls, and which day is
# still refused. The builder is exercised directly with an unrestricted key set,
# because the index does not yet carry every weekday formulary — Ordinary Time
# weeks 29 to 34 are still to land — and `Year.put` drops a key the calendar
# does not hold, so the emitted files cannot show those placements and the
# arithmetic would otherwise go unchecked for the whole of that interval.
python3 - "$repo" <<'PY'
import importlib.machinery, importlib.util, pathlib, sys
from datetime import date

repo = pathlib.Path(sys.argv[1])
loader = importlib.machinery.SourceFileLoader("calendar_days", str(repo / "tools/calendar-days"))
spec = importlib.util.spec_from_loader("calendar_days", loader)
tool = importlib.util.module_from_spec(spec)
loader.exec_module(tool)


class Everything(set):
    """Every key, so a placement is not silently dropped for want of a mass."""

    def __contains__(self, item):
        return True


WEEKDAYS = set(tool.WEEKDAYS)
year = tool.build_postconciliar(2026, Everything())
placed = {}
tagged = {}
for when, entries in year.placements.items():
    for entry in entries:
        placed.setdefault(entry["key"], set()).add(when.isoformat())
        tagged.setdefault(when.isoformat(), {})[entry["key"]] = entry.get("territorial")

# Easter 2026 is 5 April, Ash Wednesday 18 February, Pentecost 24 May, the
# Baptism 11 January, L = 6, R = 8 and week 7 is omitted — every one of those
# is a row of the guidance's own worked tables, checked above.
for key, want in (
    ("ash-wednesday", "2026-02-18"),
    ("thursday-after-ash-wednesday", "2026-02-19"),
    ("lent-1-monday", "2026-02-23"),
    ("lent-5-saturday", "2026-03-28"),
    ("holy-monday", "2026-03-30"),
    ("holy-wednesday", "2026-04-01"),
    ("easter-monday", "2026-04-06"),
    ("easter-2-monday", "2026-04-13"),
    # The Thursday of Easter week 6 is Easter +39, where the Ascension stands
    # in its Thursday form. The position exists under both territorial options.
    ("easter-6-thursday", "2026-05-14"),
    ("easter-7-saturday", "2026-05-23"),
    # Week I has no Sunday: its weekdays open on the Monday after the Baptism.
    ("ot-1-monday", "2026-01-12"),
    ("ot-2-monday", "2026-01-19"),
    # Week L keeps its Monday and Tuesday and is suspended after them.
    ("ot-6-tuesday", "2026-02-17"),
    # The resumed week's weekdays are the first after Pentecost, and week
    # XXXIV's Saturday is the Saturday before the First Sunday of Advent.
    ("ot-8-monday", "2026-05-25"),
    ("ot-34-saturday", "2026-11-28"),
    # The days within the Octave of the Nativity, named by civil date at
    # Universal Norms 35. 25 December 2025 is a Thursday, so all three are held.
    ("christmas-december-29", "2025-12-29"),
    ("christmas-december-31", "2025-12-31"),
    # Advent's week-keyed run opens on the Monday after the First Sunday, which
    # is 2025-11-30, and stops at 16 December: week 3 keeps its Monday and
    # Tuesday that year and reaches no further.
    ("advent-1-monday", "2025-12-01"),
    ("advent-2-saturday", "2025-12-13"),
    ("advent-3-tuesday", "2025-12-16"),
    # The date-keyed run picks the days up on 17 December and runs to the
    # morning Mass of 24 December.
    ("advent-december-17", "2025-12-17"),
    ("advent-december-24", "2025-12-24"),
    ("christmas-january-2", "2026-01-02"),
):
    assert placed.get(key) == {want}, (key, sorted(placed.get(key) or ()), want)

# A position the year never reaches is unplaced, never renumbered: week L's
# Wednesday to Saturday are suspended by Ash Wednesday, and 2026 omits week 7
# entire, its six weekday positions with it.
for key in ("ot-6-wednesday", "ot-6-saturday", "ot-7-monday", "ot-7-saturday"):
    assert key not in placed, (key, sorted(placed[key]))
# Thursday of Holy Week carries the Chrism Mass and the Mass of the Lord's
# Supper and is not a weekday position; a third mass there would be invented.
assert "holy-thursday" not in placed, placed.get("holy-thursday")

# The two runs the guidance kept unkeyed until the Order of Readings was read
# for them. What that reading found is asserted here rather than assumed,
# because each of these is the book's arrangement and not arithmetic, and each
# is a way of getting the run wrong.
#
# The THIRD WEEK OF ADVENT HAS FIVE WEEKDAYS: the book prints no Saturday there,
# so no year may place one. The FOURTH WEEK HAS NONE AT ALL, its weekdays lying
# wholly inside the date-keyed run. And a week-keyed position that would fall
# after 16 December is not reached — never anticipated, folded or renumbered.
assert "advent-3-saturday" not in placed, placed.get("advent-3-saturday")
assert not [key for key in placed if key.startswith("advent-4-")], sorted(placed)
for key in ("advent-3-wednesday", "advent-3-thursday", "advent-3-friday"):
    assert key not in placed, (key, sorted(placed[key]))
# 21 December 2025 is the Fourth Sunday of Advent, so the date-keyed run loses
# that position: a weekday of Advent never stands on a Sunday.
assert "advent-december-21" not in placed, placed.get("advent-december-21")

# Neither Epiphany branch is chosen. The Epiphany Sunday of 2026 is 4 January,
# so 5 January carries the 5 January formulary where the Epiphany keeps its
# date and the first of the after-Epiphany run where it has been transferred,
# each tagged with the option it holds under and neither offered untagged.
assert tagged["2026-01-05"] == {
    "christmas-january-5": "epiphany-january-6",
    "christmas-january-7": "epiphany-transferred-to-sunday",
}, tagged["2026-01-05"]
# Where the two branches agree the day is emitted once and untagged.
assert tagged["2026-01-02"] == {"christmas-january-2": None}, tagged["2026-01-02"]
# The days after the Epiphany run to the Saturday before the Baptism, which is
# 11 January 2026 under either branch, and no further.
assert placed.get("christmas-january-12") == {"2026-01-10"}, placed.get("christmas-january-12")
assert all(stamp < "2026-01-11" for key, stamps in placed.items()
           if key.startswith("christmas-january-") for stamp in stamps), placed

# Nothing of these runs is refused any more except the one day that fails closed
# for a reason of its own, and 2026 is not one of its years.
refused = {row["what"]: row["why"] for row in year.unresolved}
assert refused == {}, refused

# `governs` records which Sunday IGMR 363 lists first for the weekdays that
# follow it, and NOTHING reads it for this calendar: `resolve_ferial` is never
# called here, so no ferial formulary is emitted and no weekday is shown a
# Sunday's text. Stage 4 is where that changes, under the scope declared in
# the postconciliar rubrics.
assert year.governors, "no Ordinary Time Sunday governs the weekdays after it"
for sunday, governor in year.governors.items():
    assert sunday.weekday() == 6, sunday
    assert governor["key"].startswith("ot-"), governor
    assert "appoints none" in governor["rule"], governor
assert year.ferial == {}, year.ferial
assert year.borrowed == {}, year.borrowed

# Over the whole emitted span: no weekday position stands on a Sunday or
# outside its own season, a thirty-three-week year never reaches ten of
# Ordinary Time's 204 positions and a thirty-four-week year never reaches four,
# and 30 December fails closed in exactly the years in which no Sunday falls
# within the octave of the Nativity.
SEASON_OF = {"lent": "lent", "holy": "holy-week", "easter": "easter", "ot": "ordinary-time",
             "christmas": "christmas", "advent": "advent"}
# The date-keyed runs, whose last segment is a day of the month rather than a
# weekday name and which this loop must cover all the same.
DATED = ("advent-december-", "christmas-december-", "christmas-january-")
lost = {}
closed = 0
week_keyed = {}
date_keyed = {}
years_reached = {}
for ending in range(tool.FIRST_YEAR, tool.LAST_YEAR + 1):
    built = tool.build_postconciliar(ending, Everything())
    reached = set()
    advent_weeks = 0
    advent_dates = 0
    for when, entries in built.placements.items():
        for entry in entries:
            key = entry["key"]
            if key.split("-")[-1] not in WEEKDAYS and not key.startswith(DATED):
                continue
            if key in ("good-friday",):
                continue
            assert when.weekday() != 6, (ending, key, when)
            assert built.anchors.begins <= when <= built.anchors.last_day, (ending, key, when)
            season = SEASON_OF.get(key.split("-")[0], "lent")
            assert built.season_of(when) == season, (ending, key, when, built.season_of(when))
            if key.startswith("ot-"):
                reached.add(key)
            if key.startswith("advent-") and key.split("-")[-1] in WEEKDAYS:
                advent_weeks += 1
                assert when <= date(ending - 1, 12, 16), (ending, key, when)
            if key.startswith("advent-december-"):
                advent_dates += 1
            if key.endswith("-transferred-epiphany"):
                assert entry.get("territorial") == "epiphany-transferred-to-sunday", entry
            years_reached.setdefault(key, set()).add(ending)
    lost.setdefault(built.facts["ordinary_time_weeks"], set()).add(204 - len(reached))
    week_keyed[advent_weeks] = week_keyed.get(advent_weeks, 0) + 1
    date_keyed[advent_dates] = date_keyed.get(advent_dates, 0) + 1
    if "the weekday position of 30 December" in [row["what"] for row in built.unresolved]:
        closed += 1
        assert date(ending - 1, 12, 25).weekday() == 6, ending
assert lost == {33: {10}, 34: {4}}, lost
assert closed == 15, closed
# The two Advent runs against the counts the guidance states from the computus:
# the week-keyed run holds twelve to seventeen of its seventeen positions, all
# five of the third week's being lost in the 28 years whose Third Sunday of
# Advent falls on 16 or 17 December; the date-keyed run holds seven except in
# the 14 years in which 17 December is itself a Sunday.
assert week_keyed == {12: 28, 13: 14, 14: 14, 15: 15, 16: 15, 17: 15}, week_keyed
assert date_keyed == {6: 14, 7: 87}, date_keyed
# The two entries the Order of Readings restricts by rubric to the regions that
# keep the Epiphany on a Sunday stand only in the years that rubric names, and
# each is emitted under the transferred option alone.
assert len(years_reached["christmas-january-6-transferred-epiphany"]) == 29
assert len(years_reached["christmas-january-7-transferred-epiphany"]) == 15
PY

# `day` answers one date and says what it is.
run_tool day --date 2026-04-05 --calendar roman-1962 --format json >"$sandbox/one.json"
for want in '"easter-sunday"' 'finding aid'; do
	if ! grep -q "$want" "$sandbox/one.json"; then
		echo "day payload is missing $want" >&2
		exit 1
	fi
done

status=0
run_tool day >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "day without --date should exit 2, got $status" >&2
	exit 1
fi

# `coverage` says what is reachable and what is not, by name.
run_tool coverage --first 2026 --last 2026 --format json >"$sandbox/coverage.json"
python3 - "$sandbox/coverage.json" <<'PY'
import json, sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
rows = {row["calendar"]: row for row in payload["coverage"]}
# Every calendar with a mass index, whichever they are: a recension is a
# calendar too, and pinning the set by name failed the day one landed.
assert {"roman-1962", "postconciliar"} <= set(rows), sorted(rows)
for name, row in rows.items():
    assert row["dates"] == 365, (name, row["dates"])
    assert row["dates_resolved"] + row["dates_unresolved"] == row["dates"]
    assert row["dates_resolved"] > 0
    # A mass the guidance cannot date is reported with the reason, never placed.
    for mass in row["masses_never_placed"]:
        assert mass["why"], mass
PY

# Over the whole emitted span every mass in both indexes is reachable. A mass
# that validates, is in the calendar and no date can reach is the defect this
# gate exists to catch, so the number is asserted at zero rather than watched.
run_tool coverage --format json >"$sandbox/span.json"
python3 - "$sandbox/span.json" <<'PY'
import json, sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
for row in payload["coverage"]:
    never = row["masses_never_placed"]
    # A mass no date places and no mass points at, OUTSIDE the Commons. That
    # is the defect this gate exists to catch: a formulary that validates, is
    # in the index, and nothing can ever reach.
    #
    # A Common is a different case and is not an error. The book prints the
    # Commune Sanctorum whole, to be pointed at — "Missa Statuit, de Communi
    # unius Martyris" — and eleven of the 1962 index's thirty Commons are not
    # yet pointed at by any saint transcribed here; five of those are the
    # Saturday Masses of Our Lady, which the rubrics layer offers as the
    # Office of the day and which no date pins either. They are reported and
    # counted, and it is the propers lane's question whether each should be.
    stranded = [
        mass for mass in never
        if mass["section"] != "common" and not mass["declared"]
    ]
    assert not stranded, (row["calendar"], sorted(mass["key"] for mass in stranded))
    # Dated and pointed-at are counted apart, because they are different
    # statements about a mass and one mass can be both: a Sunday is placed by
    # a rule and pointed at by the ferias that take it. So they are bounded
    # rather than summed, and what is asserted is that the three between them
    # leave nothing over.
    assert row["masses_placed"] <= row["masses"], row
    assert row["masses_reached_by_reference"] <= row["masses"], row
    assert row["masses_placed"] + len(never) <= row["masses"], row
    assert row["masses_placed"] > 0, row
    # The reason field still has to work: it is what reports the next mass
    # someone adds to an index the guidance cannot date.
    for mass in never:
        assert mass["why"], mass
PY

# An empty calendar root is an error rather than a silent success.
mkdir -p "$sandbox/empty"
status=0
run_tool check --root "$sandbox/empty" >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "an empty calendar root should exit 2, got $status" >&2
	exit 1
fi

status=0
run_tool structure --root "$sandbox/empty" --out "$sandbox/never" >/dev/null 2>&1 || status=$?
if [ "$status" -ne 2 ]; then
	echo "structure should refuse an empty root, got $status" >&2
	exit 1
fi
if [ -e "$sandbox/never" ]; then
	echo "a refused structure must not create an output directory" >&2
	exit 1
fi

# Machine form is one key-sorted object.
run_tool check --format json >"$sandbox/check.json"
for want in '"calendars"' '"status"'; do
	if ! grep -q "$want" "$sandbox/check.json"; then
		echo "payload is missing $want" >&2
		exit 1
	fi
done

if run_tool check --format nonesuch >/dev/null 2>&1; then
	echo "expected failure for an unknown format" >&2
	exit 1
fi

echo ok
