#!/bin/sh
# Test for `tools/tpt public-alpha`: exit 0 = pass (the stable gate).
# Only the read-only verbs are exercised: `check` validates the manifest and
# `prepare` prints a candidate inventory without recording anything.  `build`
# and `verify` write the site artifact and are left to the release chain.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="public-alpha"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# The policy check passes and reports how the publication set is divided.
run_tool check >"$sandbox/check.txt"
summary="$(head -1 "$sandbox/check.txt")"
case "$summary" in
"public-alpha policy valid: "*" publications ("*" alpha, "*" hold)") ;;
*)
	echo "unexpected policy summary: $summary" >&2
	exit 1
	;;
esac

set -- $(printf '%s\n' "$summary" | tr -dc '0-9 ')
publications="$1"
alpha="$2"
hold="$3"
if [ "$publications" -lt 1 ]; then
	echo "policy check counted no publications" >&2
	exit 1
fi
if [ "$((alpha + hold))" -ne "$publications" ]; then
	echo "alpha $alpha + hold $hold does not total $publications" >&2
	exit 1
fi

# The authorization the artifact rests on is stated, with its one condition.
if ! grep -q 'authorization active' "$sandbox/check.txt"; then
	echo "check did not report the active authorization" >&2
	exit 1
fi
if ! grep -qF 'no-project-initiated-promotion' "$sandbox/check.txt"; then
	echo "check did not restate the promotion condition" >&2
	exit 1
fi

# The summary is byte-stable for unchanged release records.
run_tool check >"$sandbox/check-again.txt"
if ! cmp -s "$sandbox/check.txt" "$sandbox/check-again.txt"; then
	echo "check output is not byte-stable across runs" >&2
	exit 1
fi

# prepare prints a hash inventory and says in the artifact itself that no
# approval was conferred by printing it.
run_tool prepare >"$sandbox/prepare.json"
case "$(head -1 "$sandbox/prepare.json")" in
"{") ;;
*)
	echo "prepare did not print a JSON object" >&2
	exit 1
	;;
esac
if ! grep -q '"approval_conferred": false' "$sandbox/prepare.json"; then
	echo "prepare did not declare approval_conferred false" >&2
	exit 1
fi
for key in '"schema_version"' '"pdfs"' '"site_sources"' '"sha256"'; do
	if ! grep -qF "$key" "$sandbox/prepare.json"; then
		echo "prepare inventory lacks $key" >&2
		exit 1
	fi
done
if [ "$(grep -c '"sha256"' "$sandbox/prepare.json")" -lt "$alpha" ]; then
	echo "prepare hashed fewer files than there are alpha publications" >&2
	exit 1
fi

run_tool prepare >"$sandbox/prepare-again.json"
if ! cmp -s "$sandbox/prepare.json" "$sandbox/prepare-again.json"; then
	echo "prepare inventory is not byte-stable across runs" >&2
	exit 1
fi

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $*" >&2
		exit 1
	fi
}

# A verb is required, and only the four named verbs exist.
reject
reject bogus
# The private preview is a property of the built artifact, not of validation.
reject check --preview
reject prepare --preview
# A deployment target constrains verification alone.
reject check --deployment-target github-pages
reject verify --deployment-target nonesuch

# The browser's data root is assembled from bibles.json and from nothing else.
# That is the one rule keeping a licensed edition off the site, so it is tested
# directly rather than through a full build: an edition whose fragments sit on
# disk but which the manifest does not offer must never be copied, and must
# never survive verification if it is planted in an assembled root.
python3 - "$repo" "$sandbox/data-root" <<'PY'
import importlib.machinery
import importlib.util
import json
import shutil
import sys
from pathlib import Path

repo, sandbox = Path(sys.argv[1]), Path(sys.argv[2])
loader = importlib.machinery.SourceFileLoader(
    "public_alpha", str(repo / "tools/public-alpha")
)
tool = importlib.util.module_from_spec(
    importlib.util.spec_from_loader(loader.name, loader)
)
loader.exec_module(tool)


def write(path, payload):
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(payload) + "\n", encoding="utf-8")


# The real repository: every edition the data root carries is an edition
# bibles.json offers. Knox is retrieved outside the tree precisely because it
# may not be republished, and so is offered by no manifest.
offered = set(tool.offered_bible_ids())
assert offered, "the repository manifest offers no editions"
assert "knox" not in offered, offered
assert tool.data_root_edition_ids(tool.web_data_files()) == offered

# Exercise the approval inventory itself, not only its path classifier: every
# and only the explicitly bound browser-structure families must reach the
# exact-byte site-source closure.
real_structure_prefix = tool.WEB_DATA_ROOT_RELATIVE / "structure"
real_structure_expected = {
    path.relative_to(tool.ROOT).as_posix()
    for kind in tool.BOUND_STRUCTURE_KINDS
    for path in (tool.ROOT / real_structure_prefix / kind).rglob("*.json")
    if path.is_file() and not path.is_symlink()
}
real_structure_bound = {
    relative
    for relative in tool.site_source_paths()
    if relative.startswith(real_structure_prefix.as_posix() + "/")
}
assert real_structure_bound == real_structure_expected, (
    sorted(real_structure_bound - real_structure_expected),
    sorted(real_structure_expected - real_structure_bound),
)
real_browser_expected = {
    path.relative_to(tool.ROOT).as_posix()
    for directory in tool.WEB_BROWSER_DIRECTORIES
    for path in (tool.ROOT / tool.WEB_BROWSER_ROOT_RELATIVE / directory).glob("*")
    if path.is_file() and not path.is_symlink() and path.suffix in (".html", ".css", ".js")
}
real_browser_bound = {
    relative
    for relative in tool.site_source_paths()
    if relative.startswith(tool.WEB_BROWSER_ROOT_RELATIVE.as_posix() + "/")
}
assert real_browser_bound == real_browser_expected, (
    sorted(real_browser_bound - real_browser_expected),
    sorted(real_browser_expected - real_browser_bound),
)

# A sandbox holding one offered edition and one that is on disk only.
tool.ROOT = sandbox
# The page ships with the data it reads, so a sandbox carrying a data root
# carries a browser too; without one the assembly refuses, which is the
# invariant that keeps a corpus from going live with nothing to serve it.
# A served page is a whole document, because the artifact renders it into the
# site's layout rather than copying it.
WHOLE_PAGE = """<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Fixture</title>
<link rel="stylesheet" href="../shared/browser-core.css">
</head>
<body>
<a class="skip-link" href="#reading">Skip to the content</a>
<main id="reading">fixture</main>
<script src="../shared/browser-core.js"></script>
</body>
</html>
"""
for directory in tool.WEB_BROWSER_DIRECTORIES:
    page = sandbox / "src/web/browser" / directory / "index.html"
    page.parent.mkdir(parents=True, exist_ok=True)
    page.write_text(WHOLE_PAGE, encoding="utf-8")
data = sandbox / "src/web/data"
write(
    data / "bibles.json",
    {"bibles": [{"id": "offered", "label": "Offered", "language": "la",
                 "numbering": "vulgate", "psalter": "gallican",
                 "rights": "public-domain"}]},
)
write(
    data / "structure/propers/test.json",
    {"masses": [{"propers": [{"citations": [{
        "ref": "Psalm 24:1-3", "token": "Ps", "unresolved": None,
        "loci": {"vulgate": [{"chapter": 24, "first": 1, "last": 3}],
                 "hebrew": [{"chapter": 25, "first": 1, "last": 3}]},
    }]}]}]},
)
write(data / "structure/calendar/test/2026.json", {"days": []})
write(data / "structure/ordinary/test.json", {"sections": []})
write(data / "structure/rubrics/test.json", {"rules": []})
write(data / "structure/sources/index.json", {"works": []})
write(data / "structure/catena/test.json", {"sources": []})
protected_manifest = (
    sandbox / "src/sources/works/example/fatima-antiphonary/editions/fixture/"
    "artifacts/protected/artifact.toml"
)
protected_manifest.parent.mkdir(parents=True, exist_ok=True)
protected_manifest.write_text(
    'id = "artifact.example.fatima-antiphonary.protected"\n'
    'edition_id = "edition.example.fatima-antiphonary"\n'
    'rights_status = "unresolved"\n',
    encoding="utf-8",
)
# The approval closure binds the exact generated liturgy and source-browser
# structures it serves, but not unrelated generated JSON or the many Bible
# fragments governed by the separately bound bibles.json decision.
assert tool.is_bound_web_data_source(data / "bibles.json")
for kind in ("calendar", "propers", "rubrics", "ordinary", "sources"):
    assert tool.is_bound_web_data_source(data / f"structure/{kind}/test.json"), kind
for relative in (
    "structure/catena/test.json",
    "sources/test.json",
    "offered/chapters/Ps/24.json",
):
    assert not tool.is_bound_web_data_source(data / relative), relative
for edition in ("offered", "licensed"):
    write(
        sandbox / f"src/sources/bibles/{edition}/chapters/Ps/24.json",
        {"book": "Ps", "chapter": 24, "verses": {"1": "Ad te levavi"}},
    )

files = tool.web_data_files()
assert tool.data_root_edition_ids(files) == {"offered"}, sorted(files)
assert not any("licensed" in path for path in files), sorted(files)

# Generated liturgical JSON is a downloadable public surface, not merely an
# implementation detail of the browser. Permission-scoped text, generic
# licensed-free text and rich restricted provenance are refused before the copy
# map is assembled, even when an upstream generator or a stale tracked file
# lets one through.
proper_path = data / "structure/propers/test.json"
safe_proper = json.loads(proper_path.read_text(encoding="utf-8"))
write(
    proper_path,
    {"masses": [{"common_from": {
        "scope": "missal-propers-except-collect",
        "source_id": "edition.example.fatima-antiphonary",
        "locus": "private page locator",
        "options": [{"mass": "Common of the Blessed Virgin Mary"}],
    }}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "protected source identity" in str(exc), exc
    assert "edition.example.fatima-antiphonary" in str(exc), exc
else:
    raise AssertionError("protected Common source identity was accepted")
write(
    proper_path,
    {"masses": [{"common_from": {
        "scope": "missal-propers-except-collect",
        "options": [{"mass": "Common of the Blessed Virgin Mary"}],
    }}]},
)
tool.web_data_files()
write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "permission",
        "source_id": "edition.example.permission", "text": "restricted",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "permission-scoped rights" in str(exc), exc
else:
    raise AssertionError("permission-scoped proper JSON was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "public-domain",
        "rights_status": "permission", "text": "restricted",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "permission-scoped rights" in str(exc), exc
else:
    raise AssertionError("permission-backed proper JSON was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "licensed-free",
        "rights_status": "permission", "text": "restricted",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "permission-scoped rights" in str(exc), exc
else:
    raise AssertionError("licensed-free plus permission proper JSON was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "licensed-free",
        "source_id": "edition.english-language-liturgical-consultation.praying-together.1998",
        "text": "restricted",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "ELLC witness" in str(exc), exc
else:
    raise AssertionError("generic licensed-free proper JSON was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "public-domain",
        "source_id": (
            "edition.english-language-liturgical-consultation."
            "praying-together.1998"
        ),
        "text": "mislabelled restricted source",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "ELLC witness" in str(exc), exc
else:
    raise AssertionError("ELLC source identity with a safe-looking rights label was accepted")

for field in ("rights", "rights_status"):
    for unsafe in ("licensed", "unresolved", "licensed-free"):
        row = {"lang": "en", "text": "restricted", field: unsafe}
        if field == "rights_status":
            row["rights"] = "public-domain"
        write(
            proper_path,
            {"masses": [{"propers": [{"translations": [row]}]}]},
        )
        try:
            tool.web_data_files()
        except tool.ReleaseError as exc:
            assert "no explicit authorization" in str(exc), (field, unsafe, exc)
        else:
            raise AssertionError(f"{field}={unsafe} proper JSON was accepted")

# The positive boundary is explicit too: a non-licensed public-domain row is
# still distributable and the independent gate does not erase it.
write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "public-domain",
        "rights_status": "public-domain", "text": "safe",
    }]}]}]},
)
tool.web_data_files()

write(
    proper_path,
    {"masses": [{"propers": [{"translations": [{
        "lang": "en", "rights": "public-domain",
        "rights_status": "project-created", "text": "inconsistently labelled",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "do not name the same public authorization" in str(exc), exc
else:
    raise AssertionError("inconsistent public rights vocabularies were accepted")

write(
    proper_path,
    {"masses": [{"advisory": (
        "English Language Liturgical Consultation source-study notice"
    )}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "restricted-authority metadata" in str(exc), exc
else:
    raise AssertionError("ELLC source-study metadata was accepted in assembled JSON")

write(
    proper_path,
    {"masses": [{"absent": {"english": "icel-surface-restricted"}}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "restricted-authority metadata" in str(exc), exc
else:
    raise AssertionError("provider-specific restricted state was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{
        "unavailable_translations": [{
            "lang": "en", "state": "rights-restricted",
            "source_id": "edition.example.private", "sha256": "not-public",
        }],
    }]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "rights-restricted public projection" in str(exc), exc
    assert "sha256" in str(exc) and "source_id" in str(exc), exc
else:
    raise AssertionError("rich rights-restricted projection was accepted")

write(
    proper_path,
    {"masses": [{"propers": [{
        "unavailable_translations": [{
            "target": {"artifact_id": "private"},
            "lang": "en", "state": "rights-restricted",
        }],
    }]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "unsafe target" in str(exc), exc
else:
    raise AssertionError("nested metadata in a rights-restricted target was accepted")

write(
    proper_path,
    {"masses": [{"text_status": {
        "state": "unavailable", "reasons": [{
            "kind": "rights-withheld", "source_id": "edition.example.private",
        }],
    }}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "must project only as target, lang and state" in str(exc), exc
else:
    raise AssertionError("rich rights-withheld reason was accepted")

# The public absence itself remains useful and contains no private provenance.
write(
    proper_path,
    {"masses": [{"propers": [{
        "unavailable_translations": [{
            "target": "Collect", "lang": "en", "state": "rights-restricted",
        }],
    }]}]},
)
tool.web_data_files()
write(
    proper_path,
    {"masses": [{"propers": [{
        "unavailable_translations": [{
            "target": {
                "mass": "demo", "form_id": "main", "proper": "Collect",
                "cycle": "all", "occurrence": 1, "extent": "body",
            },
            "lang": "en", "state": "rights-restricted",
        }],
    }]}]},
)
tool.web_data_files()
write(proper_path, safe_proper)

ordinary_path = data / "structure/ordinary/test.json"
write(
    ordinary_path,
    {"absences": [
        {"key": "text-rights-withheld", "count": 2,
         "state": "rights-restricted", "kind": "rights-withheld"},
        {"key": "witness-gap", "count": 1,
         "state": "unavailable", "kind": "witness-gap"},
    ]},
)
tool.web_data_files()
write(
    ordinary_path,
    {"absences": [{
        "key": "text-rights-withheld", "count": 2,
        "state": "rights-restricted", "kind": "rights-withheld",
        "what": "private source and permission prose",
    }]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "must contain exactly key, count, state and kind" in str(exc), exc
else:
    raise AssertionError("rich public Ordinary absence catalog was accepted")

write(
    ordinary_path,
    {"sections": [{"elements": [{"translations": [{
        "lang": "en", "rights": "licensed-free",
        "source_id": (
            "edition.international-commission-on-english-in-the-liturgy."
            "music-for-the-roman-missal"
        ),
        "text": "restricted",
    }]}]}]},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "ICEL witness" in str(exc), exc
else:
    raise AssertionError("ICEL Ordinary JSON was accepted")
write(ordinary_path, {"sections": []})

sandbox_structure_prefix = tool.WEB_DATA_ROOT_RELATIVE / "structure"
sandbox_structure_expected = {
    path.relative_to(tool.ROOT).as_posix()
    for kind in tool.BOUND_STRUCTURE_KINDS
    for path in (tool.ROOT / sandbox_structure_prefix / kind).rglob("*.json")
    if path.is_file() and not path.is_symlink()
}
sandbox_structure_bound = {
    relative
    for relative in tool.site_source_paths()
    if relative.startswith(sandbox_structure_prefix.as_posix() + "/")
}
assert sandbox_structure_bound == sandbox_structure_expected, (
    sorted(sandbox_structure_bound - sandbox_structure_expected),
    sorted(sandbox_structure_expected - sandbox_structure_bound),
)

site = sandbox / "site"
root = tool.SITE_DATA_ROOT.as_posix()
tool.assemble_web_data(site, True, {})
# The served pages are rendered into the site's chrome, not copied: a reader who
# follows a link from the library must not arrive somewhere that looks like a
# different site. Copying them is exactly how they went live without the header.
for entrance in tool.WEB_BROWSER_ENTRANCES:
    served = (site / entrance / "index.html").read_text(encoding="utf-8")
    assert '<header class="site-header">' in served, served
    assert '<link rel="stylesheet" href="../assets/site.css">' in served, served
    assert '<link rel="stylesheet" href="../shared/browser-core.css">' in served, served
    assert '<script src="../shared/browser-core.js"></script>' in served, served
    assert "fixture" in served, served
    # One skip link, the layout's, pointing at the layout's main element.
    assert served.count('class="skip-link"') == 1, served
# `shared` holds the machinery, not a page, so nothing is served from it.
assert not (site / "shared/index.html").exists()

# A page carrying markup the layout has no place for is refused rather than
# silently stripped: a stylesheet dropped here reaches the reader as a page that
# renders almost right.
strayed = sandbox / "src/web/browser/liturgy/index.html"
kept = strayed.read_text(encoding="utf-8")
strayed.write_text(
    kept.replace("<title>Fixture</title>", '<title>Fixture</title>\n<style>a{color:red}</style>'),
    encoding="utf-8",
)
try:
    tool.web_browser_pages() and tool.render_browser_page(
        strayed, "liturgy/index.html", True, {}
    )
except tool.ReleaseError as exc:
    assert "no place for" in str(exc), exc
else:
    raise AssertionError("a page carrying unplaceable head markup was accepted")
strayed.write_text(kept, encoding="utf-8")

assert (site / f"{root}/offered/chapters/Ps/24.json").is_file()
assert not (site / f"{root}/licensed").exists()
# The offered edition is Vulgate-numbered, so the Hebrew loci of the same
# citation demand nothing: numbering is a property of the system, not a
# translation to be shipped twice.
assert not (site / f"{root}/offered/chapters/Ps/25.json").exists()
assert tool.verify_web_data(site) == []

# Planted after assembly, an unoffered edition still fails verification.
planted = site / f"{root}/licensed/chapters/Ps/24.json"
planted.parent.mkdir(parents=True)
planted.write_text("{}\n", encoding="utf-8")
errors = tool.verify_web_data(site)
assert any("unpublishable" in error and "licensed" in error for error in errors), errors
shutil.rmtree(site / f"{root}/licensed")

# A cited chapter with no fragment in the artifact is a reader-visible hole.
(site / f"{root}/offered/chapters/Ps/24.json").unlink()
errors = tool.verify_web_data(site)
assert any("no fragment for" in error for error in errors), errors

# A stray edition dropped into the generated data root is refused as well: the
# manifest, not a directory listing, decides what may be published.
write(
    data / "stray/chapters/Ps/24.json",
    {"book": "Ps", "chapter": 24, "verses": {"1": "should never be copied"}},
)
try:
    tool.web_data_files()
except tool.ReleaseError as exc:
    assert "stray" in str(exc), exc
else:
    raise AssertionError("a stray edition in the data root was accepted")
PY

echo ok
