#!/bin/sh
# Test for tools/tpt: exit 0 = pass.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"

"$tool" --help >/dev/null

if ! "$tool" --list >/dev/null; then
    echo "tpt --list did not execute" >&2
    exit 1
fi

if ! "$tool" --list --json | grep -q '"name"'; then
    echo "tpt --list --json did not emit JSON" >&2
    exit 1
fi

if ! "$tool" --info citations --json | grep -q '"purpose"'; then
    echo "tpt --info --json did not report purpose" >&2
    exit 1
fi

run_output="$($tool citations parse "Psalm 24:1-3" --json)"
case "$run_output" in
*'"book":"Psalms"'*) ;;
*)
	echo "tpt run citations parse should emit Psalms" >&2
	echo "$run_output" >&2
	exit 1
esac

compat_output="$($tool citations parse "Psalm 24:1-3" --json)"
case "$compat_output" in
*'"book":"Psalms"'*) ;;
*)
	echo "tpt compatibility invocation failed for citations" >&2
	echo "$compat_output" >&2
	exit 1
esac

path_output="$($tool --path citations)"
case "$path_output" in
*"/citations") ;;
*)
	echo "tpt path citations returned unexpected path: $path_output" >&2
	exit 1
esac

if ! "$tool" --check >/dev/null; then
    echo "tpt --check failed against the real registry" >&2
    exit 1
fi

if "$tool" does-not-exist >/dev/null 2>&1; then
    echo "tpt should fail for unknown tools" >&2
    exit 1
fi

echo ok
