#!/bin/sh
# Test for `tools/tpt mass-ordinary`: exit 0 = pass (the stable gate).
# Only `structure` writes, and it is aimed at a sandbox here; everything else
# reads the inventories and prints.
#
# TWO KINDS OF ASSERTION MATTER HERE, and neither is about a crash.
#
# The first is absence. Every postconciliar element missing one of this layer's
# two languages names a precise reason; acquisition, rights, modelling,
# outside-layer, and non-textual states must not collapse into one claim. An
# element that shows nothing where a prayer belongs would otherwise tell the
# reader that the Mass omits it. Every silence therefore names its reason in
# every form this tool prints.
#
# The second is the seats. The slots are the missal's own statement of where a
# proper stands, they anchor to the frame's own elements — including its
# rubrics — and `mass-today --expanded` and the browser both read them from
# here. A slot whose anchor no longer exists loses a proper silently.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="mass-ordinary"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# `check` validates the inventories and reports whether the written files are
# current. It writes nothing.
# 2026-10-19: re-pinned from 189 elements, 2 witnesses, en 189/0, la 112/77,
# all-uncollated relations and 6 exclusions. C2 G5 seated eleven appointment
# elements (3 Preface, 6 Communicantes, 2 Hanc igitur) and G6 excluded six
# second-Postcommunion/Et famulos rows (194); C3 added the Holy Spirit Preface
# opening and the Communicantes continuation (196), held the Pentecost
# Communicantes head and Hanc igitur from two new witnesses (Lasance English,
# the 1962 editorial projection Latin), and graded seven rows collated.
# C26 adds three missing Latin sides from one independent Mame witness and
# eleven bounded Latin comparisons. No source element, English wording or
# event enters; only Common/Hanc and the three new Mame sides gain exactness.
summary="$(run_tool check --calendar roman-1962 | head -1)"
case "$summary" in
*"roman-1962: 6 sections, 196 elements, 5 witnesses, 0 variants, 9 slots; en 186 held/10 missing, la 120 held/76 missing; relations en antecedent/collated 1, en antecedent/uncollated 185, la antecedent/collated 118, la antecedent/uncollated 2; 12 target-recension exclusions"*) ;;
*)
	echo "unexpected summary line: $summary" >&2
	exit 1
	;;
esac

# `structure` writes what the browser fetches, and only where --out points.
run_tool structure --out "$sandbox/data" >/dev/null
root="$sandbox/data/structure/ordinary"
if [ ! -d "$root" ]; then
	echo "structure wrote no ordinary" >&2
	exit 1
fi

python3 - "$root" <<'PY'
import hashlib, json, pathlib, re, sys

root = pathlib.Path(sys.argv[1])
index = json.loads((root / "index.json").read_text(encoding="utf-8"))
assert index["calendars"], "the index names no calendar"
files = sorted(p for p in root.glob("*.json") if p.name != "index.json")
assert files, "structure wrote no calendar file"

for path in files:
    payload = json.loads(path.read_text(encoding="utf-8"))
    assert payload["schema"] == "triptych-ordinary-structure/v1", payload["schema"]
    assert payload["advisory"], f"{path.name}: no caution about itself"
    serialized = json.dumps(payload, ensure_ascii=False).lower()
    for forbidden in (
        "english-language-liturgical", "english language liturgical",
        "international-commission-on-english", "international commission on english",
        "licensed-free", "icel", "ellc",
    ):
        assert forbidden not in serialized, (path.name, forbidden)

    for absence in payload["absences"]:
        assert set(absence) == {"key", "count", "state", "kind", "label"}, absence
        # 2026-10-19: rights-unresolved -> unresolved joins the table, the
        # tool's ABSENCE_STATES, now that C2 G5's postconciliar
        # appointed-text-printed-with-formulary is the first key of that kind.
        wanted = {
            "rights-withheld": "rights-restricted",
            "rights-unresolved": "unresolved",
        }.get(absence["kind"], "unavailable")
        assert absence["state"] == wanted, absence

    elements = {
        element["key"]: element
        for section in payload["sections"]
        for element in section["elements"]
    }
    assert elements, path.name
    if payload["calendar"] == "postconciliar":
        # 2026-10-19: 59 -> 61 and 25 -> 27, C2 G5's two appointed stand-ins
        # (praefatio-appointed, dimissio-appointed), English-restricted both.
        assert len(elements) == 61, len(elements)
        absence_counts = {one["key"]: one["count"] for one in payload["absences"]}
        assert absence_counts["approved-english-publication-restriction"] == 27, absence_counts
        assert absence_counts["antecedent-held-not-carried"] == 1, absence_counts
        assert absence_counts["antecedent-diverges-at-named-words"] == 3, absence_counts

        # Independent choices remain independent. A reader selects exactly one
        # option from each group; it must never concatenate three Penitential
        # Acts, two Creeds, or four Eucharistic Prayers into one rite.
        groups = {one["group"]: one for one in payload["variants"]}
        assert set(groups) == {"penitential-act", "creed", "eucharistic-prayer"}, groups
        assert all(one["mode"] == "one-of" for one in groups.values()), groups
        assert [one["id"] for one in groups["penitential-act"]["options"]] == [
            "pa-i", "pa-ii", "pa-iii",
        ]
        assert [one["id"] for one in groups["creed"]["options"]] == [
            "creed-nicene", "creed-apostles",
        ]
        memberships = {
            key: element["alternatives"]
            for key, element in elements.items()
            if element["alternatives"]
        }
        assert memberships["ritus-initiales/actus-paenitentialis-i"] == [
            {"group": "penitential-act", "option": "pa-i"},
        ]
        assert memberships["ritus-initiales/actus-paenitentialis-ii"] == [
            {"group": "penitential-act", "option": "pa-ii"},
        ]
        assert memberships["ritus-initiales/actus-paenitentialis-iii"] == [
            {"group": "penitential-act", "option": "pa-iii"},
        ]
        assert memberships["symbolum/symbolum-nicaenum"] == [
            {"group": "creed", "option": "creed-nicene"},
        ]
        assert memberships["symbolum/symbolum-apostolicum"] == [
            {"group": "creed", "option": "creed-apostles"},
        ]

        # Applicability is structured as a bounded disjunction. In particular,
        # the Gloria's Sunday branch excludes Advent and Lent without falsely
        # suppressing a solemnity or feast that occurs in those seasons.
        gloria = elements["ritus-initiales/gloria-in-excelsis"]
        assert gloria["conditions"][0]["kind"] == "include-when-any", gloria
        assert gloria["conditions"][0]["unknown"] == "unresolved", gloria
        assert gloria["conditions"][0]["predicates"] == [
            "sunday-outside-advent-and-lent",
            "solemnity-or-feast",
            "particular-celebration-of-more-solemn-character",
        ], gloria
        kyrie = elements["ritus-initiales/kyrie"]
        assert kyrie["conditions"][0]["kind"] == "omit-when-option", kyrie
        assert kyrie["conditions"][0]["unknown"] == "unresolved", kyrie
        assert kyrie["conditions"][0]["group"] == "penitential-act", kyrie
        assert kyrie["conditions"][0]["options"] == ["pa-iii"], kyrie
        for key in ("symbolum/symbolum-nicaenum", "symbolum/symbolum-apostolicum"):
            condition = elements[key]["conditions"][0]
            assert condition["kind"] == "include-when-any", (key, condition)
            assert condition["unknown"] == "unresolved", (key, condition)
            assert condition["predicates"] == [
                "sunday-or-solemnity",
                "particular-celebration-of-more-solemn-character",
            ], (key, condition)

        second_reading = elements["liturgia-verbi/lectio-secunda"]["conditions"][0]
        assert second_reading["kind"] == "include-when-any", second_reading
        assert second_reading["predicates"] == ["second-reading-appointed"], second_reading
        assert second_reading["unknown"] == "unresolved", second_reading
        prayer_four = elements["prex-eucharistica/prex-eucharistica-iv"]["conditions"][0]
        assert prayer_four["kind"] == "include-when-any", prayer_four
        assert prayer_four["predicates"] == ["mass-has-no-proper-preface"], prayer_four
        assert prayer_four["unknown"] == "unresolved", prayer_four

    elif payload["calendar"] == "roman-1962":
        # 2026-10-19: 189 -> 196, en (189, 0) -> (186, 10), la (112, 77) ->
        # (117, 79): C2 G5 +11 appointment elements (10 text-free stand-ins and
        # sanctus-post-praefationem), G6 -6 English-only conclusio rows, C3 +2
        # (Preface opening, Communicantes continuation) and the held Pentecost
        # Communicantes head and Hanc igitur.
        assert len(elements) == 196, len(elements)
        languages = {one["lang"]: one for one in payload["languages"]}
        assert (languages["en"]["held"], languages["en"]["missing"]) == (186, 10), languages
        assert (languages["la"]["held"], languages["la"]["missing"]) == (120, 76), languages
        # 2026-10-19: six conclusio exclusions join (C2 G6, the verified 1962
        # Ordo passages print no second Postcommunion or Et famulos).
        expected = {
            "conclusio/et-famulos",
            "conclusio/oratio-et-famulos-heading",
            "conclusio/postcommunio-mundet",
            "conclusio/rubrica-oratio-addita",
            "conclusio/rubrica-postcommunio-paschalis",
            "conclusio/rubrica-postcommunio-secunda",
            "oblatio/a-cunctis",
            "oblatio/nota-incarnationis",
            "oblatio/rubrica-collecta-concede",
            "oblatio/rubrica-secreta",
            "oblatio/rubrica-secreta-concede",
            "oblatio/secreta-ii",
        }
        exclusions = {one["key"]: one for one in payload["exclusions"]}
        assert set(exclusions) == expected, exclusions
        assert not (set(elements) & expected), set(elements) & expected
        for key, exclusion in exclusions.items():
            assert exclusion["state"] == "not-in-target-recension", (key, exclusion)
            assert exclusion["basis"], (key, exclusion)
            assert exclusion["sources"], (key, exclusion)
            assert exclusion["sources"] == sorted(set(exclusion["sources"])), exclusion
            assert all(isinstance(source, str) and source for source in exclusion["sources"]), exclusion
            assert exclusion["evidence"], (key, exclusion)
            assert all(row["source_id"] in exclusion["sources"] for row in exclusion["evidence"]), exclusion
            assert all(row["lang"] == "en" for row in exclusion["evidence"]), exclusion
            assert all(row["relation"] == "antecedent" for row in exclusion["evidence"]), exclusion
            assert all("text" not in row for row in exclusion["evidence"]), exclusion
        absence_counts = {one["key"]: one["count"] for one in payload["absences"]}
        # 2026-10-19: G6 excluded both not-in-the-1962-ordo orations (2 -> 0)
        # and four witness-own-english rows (67 -> 63); G5 typed the stand-ins
        # (appointment-not-established, preface-not-in-witness,
        # proper-canon-form-not-held, both sides each); C3 held the Pentecost
        # Communicantes head and Hanc igitur (12 -> 8) and typed two English
        # variants. C26 supplies three separately owned Latin sides: missing is now 10 + 76.
        assert absence_counts == {
            "appointment-not-established": 6,
            "communicantes-continuation-english-lacks-1962-clause": 1,
            "no-facing-latin": 5,
            "not-in-the-1962-ordo": 0,
            "preface-not-in-witness": 2,
            "proper-canon-form-not-held": 8,
            "proper-communicantes-english-variant": 1,
            "witness-own-english": 63,
        }, absence_counts
        assert sum(absence_counts.values()) == 86, absence_counts

        # The source-specific Cummiskey gap is not rewritten as facing Latin.
        # Each Latin side owns its Mame provenance and exact actor partition.
        # The active English replacement is Lasance, not the original
        # Cummiskey block whose source-level speaker remains unchanged.
        mame = "edition.catholic-church.missale-romanum.1922-tours-mame-editio-quarta-iuxta-typicam"
        cummiskey = "edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861"
        lasance = "edition.francis-xavier-lasance.the-new-roman-missal.benziger-revised-1945"
        english_prayers = {
            "munda-cor-meum": "CLEANSE my heart and my lips, O almighty God, Who didst cleanse with a burning coal the lips of the prophet Isaias; and vouchsafe in Thy loving kindness so to purify me that I may be enabled worthily to announce Thy holy Gospel. Through Christ our Lord. Amen.",
            "dominus-sit-in-corde-meo": "The Lord be in my heart and on my lips, that I may worthily and becomingly announce His gospel. Amen.",
            "per-evangelica-dicta": "P. May our sins be blotted out by the words of the Gospel.",
        }
        witnesses = {(one["source_id"], one["lang"]): one for one in payload["translations"]}
        assert witnesses[(mame, "la")]["held"] == 3, witnesses
        assert witnesses[(cummiskey, "la")]["held"] == 114, witnesses
        for local in ("munda-cor-meum", "dominus-sit-in-corde-meo", "per-evangelica-dicta"):
            element = elements["oblatio/" + local]
            sides = {row["lang"]: row for row in element["translations"]}
            english = sides["en"]
            assert english["source_id"] == lasance, (local, english)
            assert english["rights"] == "public-domain", (local, english)
            assert (english["relation"], english["collation"]) == ("antecedent", "uncollated"), (local, english)
            assert "LASANCE HISTORICAL ENGLISH, NOT APPROVED1962ENGLISH" in english["note"], (local, english)
            assert english["text"] == english_prayers[local], (local, english)
            assert english["turns"] == [{
                "key": "priest-1", "speaker": "priest",
                "dialogue_role": None,
                "printed_marker": "P." if local == "per-evangelica-dicta" else None,
                "action": None, "text": english_prayers[local],
            }], (local, english)
            latin = sides["la"]
            assert latin["source_id"] == mame and latin["rights"] == "public-domain", (local, latin)
            assert "English only" in latin["note"], (local, latin["note"])
            assert element["absent"]["latin"] is None, local
            assert len(latin["turns"]) == 1, (local, latin)
            turn = latin["turns"][0]
            assert (turn["speaker"], turn["dialogue_role"], turn["printed_marker"], turn["action"]) == ("priest", None, None, None), turn
            assert turn["text"] == latin["text"], local
        per = elements["oblatio/per-evangelica-dicta"]
        english = next(row for row in per["translations"] if row["lang"] == "en")
        assert per["speaker"] == "all" and len(english["turns"]) == 1, per
        assert english["turns"][0]["speaker"] == "priest", english
        assert english["turns"][0]["printed_marker"] == "P.", english
        assert english["turns"][0]["dialogue_role"] is None, english

    elif payload["calendar"] == "roman-pre-1955":
        # No 1920 exclusion is inferred from notes that speak only about 1962.
        # 2026-10-19: 195 -> 206, C2 G5's eleven appointment elements; the
        # pre-1955 frame excludes nothing.
        assert len(elements) == 206, len(elements)
        assert payload["exclusions"] == [], payload["exclusions"]
        for key in (
            "oblatio/a-cunctis",
            "oblatio/nota-incarnationis",
            "oblatio/rubrica-collecta-concede",
            "oblatio/rubrica-secreta",
            "oblatio/rubrica-secreta-concede",
            "oblatio/secreta-ii",
        ):
            assert key in elements, key

    if payload["calendar"] in ("roman-1962", "roman-pre-1955"):
        # Five base blocks have one source turn. A replacement owns its own
        # partition, including an unknown actor; neither actor nor dialogue
        # role can be inferred from an R. or P. glyph.
        partitioned = {
            "praeparatio/confiteor-sacerdotis": "priest",
            "praeparatio/confiteor-ministrorum": "server",
            "oblatio/laus-tibi-christe": "server",
            "oblatio/suscipiat-dominus": "server",
            "conclusio/deo-gratias": "server",
        }
        # The checked Lasance praeparatio derivative (SHA256 db17b99005f277fe
        # 5d8471fe89aa0378c5145f65713604d55cd41f69d5eacb3b), seq12/14,
        # printed758/758-759, explicitly records no P./R. on these bodies.
        # Their priest/server actors come from the source context, not a cue
        # inherited from Cummiskey. Only Roman1962 English uses this join.
        lasance_confiteors = {
            "praeparatio/confiteor-sacerdotis": "596bc7253087d5ae57847cc2f0e855a731f7b563f6a842674ca6afd0ce6820a2",
            "praeparatio/confiteor-ministrorum": "9a1169016c0c5c6136579937b7c586a9ed9e6fdf69b8ed3bc8beb6e961db60e6",
        }
        # Independent pins from the registered Lasance checked-English TSVs
        # and the explicit english_replacements declarations in the 1962
        # inventory, not from mass-ordinary's output. Keys, actors, printed
        # cues and separately established functional roles belong to that
        # witness. The Cummiskey Latin/pre-1955 expectations below remain
        # separate. In particular, R. need not establish a server actor.
        # Tuple fields: turn key, source actor, printed marker, dialogue role.
        P = ("priest-1", "priest", "P.", None)
        S = ("server-1", "server", "R.", None)
        U = ("response-1", None, "R.", None)
        PV = ("priest-1", "priest", "P.", "versicle")
        SR = ("server-1", "server", "R.", "response")
        UR = ("response-1", None, "R.", "response")
        lasance_cases = {
            # ordo-praeparatio-checked-english-v1, seq401 through3202,
            # printed756-762/AP754-760; Confiteors are seq12 and14.
            "praeparatio/introibo-ad-altare-dei":
                ("3aea67a439f39ada2d74662abcdf10b8182334f788bffeafd7df9c6d6be1f258", [P, S]),
            "praeparatio/judica-me-deus":
                ("5196174b88ecd0d8592ef7b111d72bd35501370af78de570e7270fd1eb2e66a0", [P, S]),
            "praeparatio/emitte-lucem-tuam":
                ("2400547a22c7aa77cb65eeb0125ee6377034d13fd5b81027e6fe3aa4d0516025", [P, S]),
            "praeparatio/confitebor-tibi-in-cithara":
                ("226ad3b64deeae090e4edd65e93f4edcc234e537f46e811b6497c0c434c5b2e9", [P, S]),
            "praeparatio/gloria-patri":
                ("2b82573987d9a48f44655620b6032f320ce7df9941a4a372127c16e0ce7e8ecf", [P, S]),
            "praeparatio/introibo-ad-altare-dei-repetitio":
                ("3aea67a439f39ada2d74662abcdf10b8182334f788bffeafd7df9c6d6be1f258", [P, SR]),
            "praeparatio/adjutorium-nostrum":
                ("39770b260d8fe749015b133b58ee6bcc87e0a2e6f664eb7f9fa0ada9683f35e7", [PV, SR]),
            "praeparatio/confiteor-sacerdotis":
                (lasance_confiteors["praeparatio/confiteor-sacerdotis"], [("confiteor-sacerdotis", "priest", None, None)]),
            "praeparatio/misereatur-tui":
                ("a1143e8a3d50f37cb61ec3a6d0e60399240b8838b58659b55661dc9ce9d70176", [S, P]),
            "praeparatio/confiteor-ministrorum":
                (lasance_confiteors["praeparatio/confiteor-ministrorum"], [("confiteor-ministrorum", "server", None, None)]),
            "praeparatio/misereatur-vestri":
                ("cfe38a8883223472f79a262eaa710abb8dded768a7d2cc6f8e1edf874b10c807", [P, SR]),
            "praeparatio/indulgentiam":
                ("b8235e5f5dda8ac4604cf30e3895beaf7a35b4a40e2cf31183749cc74f245efc", [P, SR]),
            "praeparatio/deus-tu-conversus":
                ("f4ee8800d1f8360b5f54c9fa75662e20d4ab115cd68828ae5c10702be9162789", [PV, SR]),
            "praeparatio/ostende-nobis":
                ("cf4e577e9982e1ab373dad3b63141e299400c969edac970f17cd543477534106", [PV, SR]),
            "praeparatio/domine-exaudi":
                ("c780cd214f0551eebd53e74182b7f2410b48cf962dfbff5744118da18d2e6d67", [PV, SR]),
            "praeparatio/dominus-vobiscum":
                ("436006006ea6821d75a5afa75e2fcb61939ad758c3f2e41c2f4b31624eda1471", [PV, SR, ("priest-2", "priest", "P.", None)]),
            "praeparatio/kyrie-eleison":
                ("b65fce7733a4758ee700f3071c849e06e5054f852582b04679a0f5fa95c48257", [P, S, ("priest-2", "priest", "P.", None)]),
            "praeparatio/christe-eleison":
                ("498ec041e2486431e578ce3126f3dbef99ed075bf2bd65943fd38cf3b23953a7", [S, P, ("server-2", "server", "R.", None)]),
            "praeparatio/kyrie-eleison-repetitio":
                ("60fc754e6d10a616b5238362bd75f501322f3b512b7f4369885db152e4a2cd37", [P, S, ("priest-2", "priest", "P.", None)]),
            "praeparatio/dominus-vobiscum-post-gloriam":
                ("36ab6ac0c0692438977ad5d69dd2a4e2f615d35ca25571a90159f948eeef7531", [PV, SR]),
            # ordo-oblatio-checked-english-v1, seq3-7/14-15/36-44,
            # printed764-772/AP762-770.
            "oblatio/dominus-vobiscum-ante-evangelium":
                ("2be4b190935efaf7818cad3d040004dcca0c07e8db6b3a7855741c3e91ad4eb1", [PV, UR, ("priest-2", "priest", "P.", None), ("response-2", None, "R.", None)]),
            "oblatio/laus-tibi-christe":
                ("de85863ec4f3cde9ea9a85c3dc597b82998dd693ff8127397ca8c63f0341300e", [S]),
            "oblatio/dominus-vobiscum-ante-offertorium":
                ("36ab6ac0c0692438977ad5d69dd2a4e2f615d35ca25571a90159f948eeef7531", [PV, UR]),
            "oblatio/suscipiat-dominus":
                ("005a8a623c2fe851b40262c1d07250628b6fc67be900f40edc9bb25e8e30767a", [U]),
            "oblatio/per-omnia-saecula":
                ("6b1002e5f3cc3a61728d679e5ce5538d70dad28ea19fdad249a53664803c05ec", [PV, UR]),
            "oblatio/sursum-corda":
                ("a68759dd5a5c633c110d5575093242edb274d801524f66560d0df52965bb4b2f", [PV, UR, ("priest-2", "priest", "P.", "versicle"), ("response-2", None, "R.", "response"), ("priest-3", "priest", "P.", "versicle"), ("response-3", None, "R.", "response")]),
            # ordo-canon-checked-english-v1 seq2801/2901, printed786/AP785.
            "canon/per-omnia-saecula":
                ("2a16656154816dfb8c404952af0476dbb3e4cfc5a6c225bb2d0ff01a52d7c56d", [("priest-1", "priest", None, None), S]),
            # ordo-communio-checked-english-v1 seq3201/3301/3401,
            # 3601/3701/3801/3901, printed786-787/AP785-786.
            "communio/pater-noster":
                ("c1d689189e02609b476b3c0c2fd61ef35839a3211656e9a8af449d19d350d7d9", [("priest-1", "priest", None, None), S, ("priest-2", "priest", "P.", None)]),
            "communio/per-omnia-saecula-post-libera-nos":
                ("2a16656154816dfb8c404952af0476dbb3e4cfc5a6c225bb2d0ff01a52d7c56d", [("priest-1", "priest", None, None), S]),
            "communio/pax-domini":
                ("d38b766e7e0539dd3cfaa925a4436f77ad9d0a26044fa9372f24507d103aa491", [P, S]),
            # ordo-conclusio-checked-english-v1 seq6101/6201/6301,
            # 6801/6901,7501-7801,8201: no target-derived dialogue roles.
            "conclusio/dominus-vobiscum-ante-postcommunionem":
                ("436006006ea6821d75a5afa75e2fcb61939ad758c3f2e41c2f4b31624eda1471", [P, S, ("priest-2", "priest", "P.", None)]),
            "conclusio/requiescant-in-pace":
                ("9b299ba1781e66ac259d52049048e7556d0628af2c06f34df57bdd255670427b", [("priest-1", "priest", None, None), ("server-1", "server", None, None)]),
            "conclusio/initium-sancti-evangelii":
                ("da4e57536f54725c44411c042cb5fde0d3d001059eeb52eb5a130569c2b31714", [P, S, ("priest-2", "priest", "P.", None), ("server-2", "server", "R.", None)]),
            "conclusio/deo-gratias":
                ("fa1530111c17a356c2920765d88ebbc2d05c014b645bf1157bda6ff757cfef62", [S]),
        }
        lasance_seen = set()

        def checked_lasance_shape(key, row):
            assert row["source_id"] == "edition.francis-xavier-lasance.the-new-roman-missal.benziger-revised-1945", (key, row)
            assert row["rights"] == "public-domain", (key, row)
            assert (row["relation"], row["collation"]) == ("antecedent", "uncollated"), (key, row)
            digest, wanted = lasance_cases[key]
            assert hashlib.sha256(row["text"].encode()).hexdigest() == digest, (key, row)
            assert [
                (turn["key"], turn["speaker"], turn["printed_marker"], turn["dialogue_role"], turn["action"])
                for turn in row["turns"]
            ] == [(*shape, None) for shape in wanted], (key, row["turns"])
            assert "\n".join(turn["text"] for turn in row["turns"]) == row["text"], key
            assert row["text"].count("\n") == len(wanted) - 1, (key, row)
            lasance_seen.add(key)
            return wanted

        reached = set()
        for key, speaker in partitioned.items():
            rows = elements[key]["translations"]
            assert {row["lang"] for row in rows} == {"en", "la"}, (key, rows)
            for row in rows:
                assert len(row["turns"]) == 1, (key, row["lang"], row["turns"])
                turn = row["turns"][0]
                if payload["calendar"] == "roman-1962" and row["lang"] == "en":
                    expected_key, expected_speaker, marker, expected_role = checked_lasance_shape(key, row)[0]
                else:
                    if key in lasance_confiteors:
                        assert row["source_id"] == "edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861", (key, row)
                    expected_key, expected_speaker = key.rsplit("/", 1)[1], speaker
                    expected_role = "response" if (payload["calendar"], key) == ("roman-1962", "conclusio/deo-gratias") else None
                    marker = "P." if speaker == "priest" else "R."
                assert turn["key"] == expected_key, (key, turn)
                assert turn["speaker"] == expected_speaker, (key, turn)
                assert turn["dialogue_role"] == expected_role and turn["action"] is None, (key, turn)
                assert turn["text"] == row["text"], (key, row["lang"])
                assert turn["printed_marker"] == marker, (key, turn)
                if marker is None:
                    assert not turn["text"].startswith(("P. ", "R. ")), (key, turn)
                    assert turn["text"].startswith("I CONFESS "), (key, turn)
                else:
                    assert turn["text"].startswith(marker + " "), (key, turn)
                reached.add((key, row["lang"]))
        assert reached == {
            (key, lang) for key in partitioned for lang in ("en", "la")
        }, reached

        # C4 step 2 (2026-10-19): ten printed blocks of dialogue are held as
        # reviewed child rows, one per printed turn, numbered seq*100+n from the
        # block they divide. Each language partitions those rows in order; the
        # turns rejoin to the element's text. The base expectations are for
        # 1861; English replacement expectations are independently pinned above.
        # A dialogue role requires its own declaration, not an inherited cue.
        # The pre-1955 projection has none. Ant./Anth. is not a printed cue.
        V, R = "versicle", "response"
        divided = {
            "praeparatio/introibo-ad-altare-dei": (4, [("priest", None, None), ("server", "R.", None)]),
            "praeparatio/judica-me-deus": (6, [("priest", None, None), ("server", "R.", None)]),
            "praeparatio/emitte-lucem-tuam": (7, [("priest", "P.", None), ("server", "R.", None)]),
            "praeparatio/confitebor-tibi-in-cithara": (8, [("priest", "P.", None), ("server", "R.", None)]),
            "praeparatio/gloria-patri": (9, [("priest", "P.", None), ("server", "R.", None)]),
            "praeparatio/introibo-ad-altare-dei-repetitio": (10, [("priest", "P.", None), ("server", "R.", R)]),
            "oblatio/per-omnia-saecula": (57, [("priest", "P.", V), ("server", "R.", R)]),
            "oblatio/sursum-corda": (59, [("priest", "P.", V), ("server", "R.", R)] * 3),
            "communio/pax-domini": (6, [("priest", "P.", None), ("server", "R.", R)]),
            "conclusio/dominus-vobiscum-ite-missa-est": (12, [
                ("priest", None, V), ("server", "R.", R), ("priest", None, None), ("server", "R.", R),
            ]),
        }
        roles_here = payload["calendar"] == "roman-1962"
        if roles_here:
            divided["praeparatio/adjutorium-nostrum"] = (11, [("priest", "P.", V), ("server", "R.", R)])
            divided['praeparatio/deus-tu-conversus'] = (17, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['praeparatio/ostende-nobis'] = (18, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['praeparatio/domine-exaudi'] = (19, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['praeparatio/dominus-vobiscum'] = (20, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['praeparatio/misereatur-tui'] = (13, [('server', 'R.', None), ('priest', 'P.', None)])
            divided['praeparatio/misereatur-vestri'] = (15, [('priest', 'P.', None), ('server', 'R.', 'response')])
            divided['praeparatio/indulgentiam'] = (16, [('priest', 'P.', None), ('server', 'R.', 'response')])
            divided['praeparatio/kyrie-eleison'] = (26, [('priest', 'P.', None), ('server', 'R.', None), ('priest', 'P.', None)])
            divided['praeparatio/christe-eleison'] = (27, [('server', 'R.', None), ('priest', 'P.', None), ('server', 'R.', None)])
            divided['praeparatio/kyrie-eleison-repetitio'] = (28, [('priest', 'P.', None), ('server', 'R.', None), ('priest', 'P.', None)])
            divided['praeparatio/dominus-vobiscum-post-gloriam'] = (32, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['oblatio/dominus-vobiscum-ante-evangelium'] = (8, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response'), ('priest', 'P.', None), ('server', 'R.', None)])
            divided['oblatio/dominus-vobiscum-ante-offertorium'] = (18, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['conclusio/dominus-vobiscum-ante-postcommunionem'] = (5, [('priest', None, None), ('server', 'R.', None), ('priest', None, None)])
            divided['canon/per-omnia-saecula'] = (30, [('priest', 'P.', None), ('server', 'R.', 'response')])
            divided['communio/pater-noster'] = (3, [('priest', None, None), ('server', 'R.', 'response'), ('priest', 'P.', None)])
            divided['communio/per-omnia-saecula-post-libera-nos'] = (5, [('priest', 'P.', None), ('server', 'R.', 'response')])
            divided['conclusio/requiescant-in-pace'] = (14, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response')])
            divided['conclusio/initium-sancti-evangelii'] = (19, [('priest', 'P.', 'versicle'), ('server', 'R.', 'response'), ('priest', 'P.', None), ('server', 'R.', 'response')])
        for key, (parent, expected) in divided.items():
            rows = elements[key]["translations"]
            assert {row["lang"] for row in rows} == {"en", "la"}, (key, rows)
            for row in rows:
                turns = row["turns"]
                wanted = expected + [(None, None, None)] if row["lang"] == "en" and key in {"praeparatio/kyrie-eleison", "praeparatio/christe-eleison", "praeparatio/kyrie-eleison-repetitio"} else expected
                if roles_here and row["lang"] == "en" and key in lasance_cases:
                    wanted = [shape[1:] for shape in checked_lasance_shape(key, row)]
                assert len(turns) == len(wanted), (key, row["lang"], turns)
                assert "\n".join(turn["text"] for turn in turns) == row["text"], key
                assert row["text"].count("\n") == len(wanted) - 1, (key, row["lang"])
                for turn, (speaker, marker, role) in zip(turns, wanted):
                    assert turn["speaker"] == speaker, (key, turn)
                    assert turn["printed_marker"] == marker, (key, turn)
                    assert turn["dialogue_role"] == (role if roles_here else None), (key, turn)
                    assert turn["action"] is None, (key, turn)
                    if marker:
                        assert turn["text"].startswith(marker + " "), (key, turn)
                    else:
                        assert not turn["text"].startswith(("P. ", "R. ")), (key, turn)
        if roles_here:
            assert lasance_seen == set(lasance_cases), lasance_seen
        # Cummiskey's Ant./Anth. labels survive in its own columns. Lasance's
        # checked English instead starts with the source priest's P. cue.
        antiphon = {
            row["lang"]: row["turns"][0]["text"]
            for row in elements["praeparatio/introibo-ad-altare-dei"]["translations"]
        }
        assert antiphon["la"].startswith("Ant. "), antiphon
        if roles_here:
            assert antiphon["en"] == "P. I will go in to the altar of God.", antiphon
        else:
            assert antiphon["en"].startswith("Anth. "), antiphon

        # Element headings set the incipit without the printed cue letter; the
        # reviewed marker is recorded beside it and the artifact keeps the cell.
        headed = {
            "oblatio/dominus-vobiscum-ante-evangelium": "P.",
            "oblatio/laus-tibi-christe": "R.",
            "oblatio/dominus-vobiscum-ante-offertorium": "P.",
            "oblatio/suscipiat-dominus": "R.",
            "oblatio/per-omnia-saecula": "P.",
            "oblatio/sursum-corda": "P.",
            "communio/per-omnia-saecula-post-libera-nos": "P.",
            "communio/pax-domini": "P.",
        }
        for key, element in elements.items():
            assert element.get("incipit_printed_marker") == headed.get(key), (key, element.get("incipit_printed_marker"))
            for field in ("name", "latin_incipit"):
                value = element.get(field) or ""
                assert not re.match(r"^(?:[PRVS]\.|[\u2123\u211f]\.?)\s", value), (key, field, value)

        # C2 gap G19 (2026-10-19): the Latin the 1962 Pentecost Missal mode
        # exercises is collated word by word against the 1962 Ordo. A
        # word-exact element is exact-target; a variant or an abbreviated body
        # is collated, names its differences and stays an antecedent. The
        # pre-1955 projection of the same rows inherits no 1962 finding.
        collated_la = {}
        for key, element in elements.items():
            for row in element["translations"] or []:
                if row["lang"] == "la" and row.get("collation") == "collated":
                    collated_la[key] = row
        if payload["calendar"] == "roman-1962":
            not_exact = {
                "praeparatio/confiteor-sacerdotis", "praeparatio/indulgentiam",
                "oblatio/suscipe-sancte-pater", "oblatio/in-spiritu-humilitatis",
                "oblatio/ne-perdas-cum-impiis", "oblatio/gloria-patri",
                "oblatio/suscipiat-dominus", "canon/simili-modo",
                "canon/forma-sanguinis", "canon/supplices", "canon/per-quem",
                "communio/agnus-dei",
            }
            # C26's nine partial Prefaces are compared, never silently
            # expanded or promoted as complete exact target wording.
            partial_prefaces = {
                "praefatio/praefatio-de-ss-trinitate", "praefatio/praefatio-de-nativitate",
                "praefatio/praefatio-de-epiphania", "praefatio/praefatio-de-quadragesima",
                "praefatio/praefatio-de-sancta-cruce", "praefatio/praefatio-paschalis",
                "praefatio/praefatio-de-ascensione", "praefatio/praefatio-de-beata-maria-virgine",
                "praefatio/praefatio-de-apostolis",
            }
            not_exact |= partial_prefaces
            bounded_findings = partial_prefaces | {"praefatio/praefatio-communis", "canon/hanc-igitur"}
            exact = {key for key, row in collated_la.items() if row.get("target_wording") == "word-exact"}
            assert set(collated_la) - exact == not_exact, sorted(set(collated_la) - exact)
            assert len(exact) == 97 and len(collated_la) == 118, (len(exact), len(collated_la))
            antecedent_only = {"praeparatio/indulgentiam", "conclusio/dominus-vobiscum-ante-postcommunionem"}
            assert set(divided) - antecedent_only <= exact, sorted(set(divided) - antecedent_only - exact)
            for key, row in collated_la.items():
                if key in bounded_findings:
                    # These independently page-checked findings use human
                    # edition/locus citations. Existing source-bound findings
                    # and the three Mame passages keep their passage IDs.
                    assert row["collation_finding"].startswith(
                        ("Missale Romanum, editio typica 1962;", "Missale Romanum, editio typica 1962,")), (key, row["collation_finding"])
                else:
                    assert row["collation_finding"].startswith(
                        "passage.catholic-church.missale-romanum."), (key, row["collation_finding"])
                if key in exact:
                    assert row["coverage_relationship"] == "exact-target", key
                    assert "COLLATED WORD-EXACT" in row["note"], key
                else:
                    assert "coverage_relationship" not in row, key
                    if key in partial_prefaces:
                        assert "target_wording" not in row, key
                        assert "COLLATED" in row["note"] or "COLLATION COMPLETE" in row["note"], key
                    else:
                        assert "NOT WORD-EXACT" in row["note"], key
            for key in ("praeparatio/gloria-in-excelsis-heading",
                        "conclusio/dominus-vobiscum-ante-postcommunionem"):
                assert key not in collated_la, key
        else:
            assert collated_la == {}, sorted(collated_la)

        # These 20 blocks contain internal speaker changes but each language's
        # artifact still stores the whole printed block in one row. They stay
        # opaque until reviewed child rows exist; punctuation is not a boundary.
        opaque = {
            "praeparatio/adjutorium-nostrum",
            "praeparatio/misereatur-tui",
            "praeparatio/misereatur-vestri",
            "praeparatio/indulgentiam",
            "praeparatio/deus-tu-conversus",
            "praeparatio/ostende-nobis",
            "praeparatio/domine-exaudi",
            "praeparatio/dominus-vobiscum",
            "praeparatio/kyrie-eleison",
            "praeparatio/christe-eleison",
            "praeparatio/kyrie-eleison-repetitio",
            "praeparatio/dominus-vobiscum-post-gloriam",
            "oblatio/dominus-vobiscum-ante-evangelium",
            "oblatio/dominus-vobiscum-ante-offertorium",
            "canon/per-omnia-saecula",
            "communio/pater-noster",
            "communio/per-omnia-saecula-post-libera-nos",
            "conclusio/dominus-vobiscum-ante-postcommunionem",
            "conclusio/requiescant-in-pace",
            "conclusio/initium-sancti-evangelii",
        }
        if roles_here:
            opaque.difference_update(divided)
        assert len(opaque) == (0 if roles_here else 20) and opaque <= set(elements), opaque - set(elements)
        for key in opaque:
            rows = elements[key]["translations"]
            assert {row["lang"] for row in rows} == {"en", "la"}, (key, rows)
            assert all("turns" not in row for row in rows), (key, rows)

    # ---- Absence, with its reason, everywhere ----------------------------
    #
    # An element holds a text in a language or names why it does not. The
    # reason is keyed by the side of the book — `english`, `latin` — because
    # that is how the printing is organised, and a silence with no key is a
    # defect in the source rather than a silence about the rite.
    languages = [one["lang"] for one in payload["languages"]]
    sides = {"en": "english", "la": "latin"}
    for element in elements.values():
        held = {one["lang"] for one in (element["translations"] or [])}
        for lang in languages:
            if lang in held:
                continue
            reason = (element["absent"] or {}).get(sides[lang], None)
            assert reason, (path.name, element["key"], lang)
        # Every reason an element names is accounted for once, above, with how
        # many elements it covers.
        for reason in (element["absent"] or {}).values():
            if reason:
                assert any(one["key"] == reason for one in payload["absences"]), reason

    # A witness that reaches the served file has a recorded rights basis.
    for witness in payload["translations"]:
        assert witness["rights"], witness

    # ---- The seats -------------------------------------------------------
    #
    # A slot anchors to an element this file really emits, cites the rubric
    # that puts it there, and claims a proper name no other slot claims.
    claimed = {}
    order = [
        element["key"]
        for section in payload["sections"]
        for element in section["elements"]
    ]
    last = -1
    for slot in payload["slots"]:
        assert slot["anchor"] in elements, (path.name, slot["key"], slot["anchor"])
        assert slot["where"] in ("before", "after"), slot
        assert slot["locus"], slot["key"]
        assert slot["propers"], slot["key"]
        for name in slot["propers"]:
            assert name not in claimed, (name, claimed.get(name), slot["key"])
            claimed[name] = slot["key"]
        # The slots run forward through the elements, which is what makes the
        # file's own order readable as the order of the rite.
        here = order.index(slot["anchor"])
        assert here >= last, (path.name, slot["key"], here, last)
        last = here
    if payload["slots"]:
        assert payload["slots_derived_from"], path.name
PY

# The same inventories produce the same bytes.
run_tool structure --out "$sandbox/again" >/dev/null
if ! diff -r "$root" "$sandbox/again/structure/ordinary" >/dev/null; then
	echo "structure is not byte-stable across runs" >&2
	exit 1
fi

# Coverage keeps target-recension exclusions visible. Reducing the element and
# absence totals without these twelve records (six until the 2026-10-19 C2 G6
# conclusio exclusions) would make the false 1861 additions
# disappear from the audit instead of recording why they are not 1962 members.
run_tool coverage --json >"$sandbox/coverage.json"
python3 - "$sandbox/coverage.json" "$root" <<'PY'
import json, pathlib, sys

coverage = {
    row["calendar"]: row
    for row in json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["coverage"]
}
structures = pathlib.Path(sys.argv[2])
old = coverage["roman-1962"]
pre = coverage["roman-pre-1955"]
# 2026-10-19: the six C2 G6 conclusio exclusions join; counts as in the
# structure pins above (196 and 206 elements, en 186/10, la 120/76).
expected = {
    "conclusio/et-famulos",
    "conclusio/oratio-et-famulos-heading",
    "conclusio/postcommunio-mundet",
    "conclusio/rubrica-oratio-addita",
    "conclusio/rubrica-postcommunio-paschalis",
    "conclusio/rubrica-postcommunio-secunda",
    "oblatio/a-cunctis",
    "oblatio/nota-incarnationis",
    "oblatio/rubrica-collecta-concede",
    "oblatio/rubrica-secreta",
    "oblatio/rubrica-secreta-concede",
    "oblatio/secreta-ii",
}
assert old["elements"] == 196, old
assert {row["key"] for row in old["exclusions"]} == expected, old["exclusions"]
assert all(row["state"] == "not-in-target-recension" for row in old["exclusions"])
assert old["exclusions"] == json.loads(
    (structures / "roman-1962.json").read_text(encoding="utf-8")
)["exclusions"]
languages = {row["lang"]: row for row in old["language_coverage"]}
assert languages["en"] == {
    "lang": "en", "elements": 196, "held": 186, "missing": 10, "absent": 10,
}, languages
assert languages["la"] == {
    "lang": "la", "elements": 196, "held": 120, "missing": 76, "absent": 76,
}, languages
assert pre["elements"] == 206 and pre["exclusions"] == [], pre
assert coverage["postconciliar"]["exclusions"] == [], coverage["postconciliar"]
PY

# ---- What `show` prints ---------------------------------------------------
#
# A rubric is an instruction and not a prayer. It was set at the same indent in
# the same face as the prayer beside it, so the two rubrics bracketing the
# Placeat read as its first and last lines.
shown="$(run_tool show --calendar roman-1962)"
case "$shown" in
*"[ Bowing before the Altar, the Priest says ]"*) ;;
*)
	echo "a rubric is not set apart from the prayers" >&2
	exit 1
	;;
esac
case "$shown" in
*"[ Let the performance of my homage"*)
	echo "a prayer was set as though it were a rubric" >&2
	exit 1
	;;
esac

# The priest's actions can be hidden, and hiding them touches nothing else.
hidden="$(run_tool show --calendar roman-1962 --no-rubrics)"
case "$hidden" in
*"Bowing before the Altar"*)
	echo "--no-rubrics did not hide the priest's actions" >&2
	exit 1
	;;
esac
case "$hidden" in
*"Placeat tibi sancta Trinitas"*) ;;
*)
	echo "--no-rubrics removed a prayer" >&2
	exit 1
	;;
esac

# A missing text says why, at the place it falls due, rather than showing a
# blank where a prayer belongs. This one has a registered official exemplar but
# no tracked payload that may be joined to the element.
missing="$(run_tool show --calendar postconciliar)"
case "$missing" in
*"[absent: official-exemplar-not-carried]"*) ;;
*)
	echo "a missing element does not name its reason" >&2
	exit 1
	;;
esac

# `--lang la` prints the Latin, and where the witness has none it reports the
# LATIN's own reason. Reading the block by ISO code once found nothing and fell
# through to the English one, which reported the postconciliar Latin restricted:
# a real reason, for the other text. Since the 1861 printing's
# facing column was transcribed. As of 2026-10-19 (C2 G5/G6, C3) the pre-1955
# projection carries Latin for 113 of 206 elements and names the other 93
# absences. The 1962 projection carries 120 Latin blocks among 196 target
# members; its remaining 76 are the witness's English-only blocks and the typed
# appointment absences, after twelve explicit nonmembers are accounted
# separately as recension exclusions rather than false target text.
latin="$(run_tool show --calendar roman-1962 --lang la)"
case "$latin" in
*"[absent: no-facing-latin]"*) ;;
*)
	echo "--lang la does not report the Latin's own reason" >&2
	exit 1
	;;
esac
# 2026-10-19 (C2 G6): both orations this class typed, postcommunio-mundet and
# et-famulos, are now target-recension exclusions, so the class covers no
# emitted element (count 0 above). Its reason printing in the 1962 Latin would
# mean an excluded oration had leaked back into the frame.
case "$latin" in
*"[absent: not-in-the-1962-ordo]"*)
	echo "--lang la prints an excluded abolished-regime oration" >&2
	exit 1
	;;
esac
case "$latin" in
*"[absent: witness-own-english]"*) ;;
*)
	echo "--lang la does not report the witness-owned classification" >&2
	exit 1
	;;
esac
case "$latin" in
*"IN Nomine Patris, et Filii, et Spiritus Sancti"*) ;;
*)
	echo "--lang la printed no Latin from the facing column" >&2
	exit 1
	;;
esac

# Every absence states its KIND, and the six kinds are not interchangeable.
# A source or payload gap, a rights restriction, no known exemplar, a model
# span, material owned by another layer, and a structural non-text are different
# facts. The discriminator is checked here rather than left to prose.
kinds="$(run_tool structure --out "$sandbox/kinds" >/dev/null 2>&1; \
	python3 -c "import json,sys,pathlib
seen={}
for path in sorted(pathlib.Path(sys.argv[1]).rglob('*.json')):
    if path.name == 'index.json': continue
    for row in (json.loads(path.read_text()).get('absences') or []):
        seen[row['key']]=row['kind']
print(' '.join(k+'='+str(v) for k,v in sorted(seen.items())))" "$sandbox/kinds")"
# The rights refusal is now scoped to the reform's OWN new matter. The single
# `editio-typica` key it replaced asserted that refusal over the whole frame.
# A key that says "rights-withheld" must name only what is actually withheld,
# which is what this asserts.
case "$kinds" in
*"editio-typica-new-matter=rights-withheld"*) ;;
*)
	echo "the reform's new matter is not typed as a rights withholding: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"antecedent-held-not-carried=witness-gap"*) ;;
*)
	echo "an unsourced ancient text is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
# Registered official exemplars with no joined payload are witness gaps.
case "$kinds" in
*"official-exemplar-not-carried=witness-gap"*) ;;
*)
	echo "an official exemplar without a payload is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
# Variable texts assigned by the calendar/Propers layer are outside this layer,
# not missing Ordinary witnesses.
case "$kinds" in
*"proper-text-outside-ordinary=outside-layer"*) ;;
*)
	echo "a Proper text is not typed as outside the Ordinary layer: $kinds" >&2
	exit 1
	;;
esac
# Actions and locally supplied matter with no invariant words are not textual
# acquisition failures.
case "$kinds" in
*"no-fixed-text=not-applicable"*"not-a-text=not-applicable"*) ;;
*)
	echo "a non-textual element is not typed as not applicable: $kinds" >&2
	exit 1
	;;
esac
# An element that spans independently sourceable parts is a model gap on either
# language side; acquiring one more excerpt would not make the composite whole.
case "$kinds" in
*"element-spans-mixed-availability=model-gap"*"element-spans-mixed-matter=model-gap"*) ;;
*)
	echo "a composite element is not typed as a model gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"canon-not-split="*)
	echo "the retired whole-Canon model gap still reaches output: $kinds" >&2
	exit 1
	;;
esac
# Quiet priest prayers have no exact exemplar in the registered official
# excerpts. Nobody has refused their use.
case "$kinds" in
*"priest-prayer-said-quietly=no-exemplar"*) ;;
*)
	echo "a quiet prayer without an exemplar is mistyped: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"no-facing-latin=witness-gap"*) ;;
*)
	echo "the 1962 Latin absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"not-in-the-1962-ordo=witness-gap"*) ;;
*)
	echo "the abolished-regime absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"witness-own-english=witness-gap"*) ;;
*)
	echo "the witness-owned absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac

# ---- The antecedent Latin, and the claim it must never make ---------------
#
# Twenty elements of the postconciliar frame now carry Latin, and NOT ONE OF THEM
# IS THE LATIN OF THE BOOK THAT PAGE IS HEADED WITH. Every one is the facing
# column of an 1861 Philadelphia lay hand missal, printing the ancient prayer
# the postconciliar Order received; the editio typica is in copyright and is
# held nowhere in this project.
#
# A reader looking at a page headed `Missale Romanum, editio typica tertia` and
# seeing Latin under an element will take it for that book's Latin unless told
# otherwise AT THAT ELEMENT. So the relation, its grade, and a note saying both
# ride on the translation row itself, beside the words, and this asserts they
# are there rather than trusting that they are.
#
# The two grades must not look alike, and that is the assertion with teeth. The
# study's own coarse `Retained` list names `Domine Iesu Christe, qui dixisti`
# among the texts carried over -- and the 2002 reads `ne respicias peccata
# NOSTRA` where the 1861 reads `peccata MEA`. Landing on the strength of the
# summary would have put the wrong pronoun into the Rite of Peace on every day
# of this calendar. `collated` therefore costs a cited finding, `uncollated`
# says in terms that the identity is not established, and the elements where a
# comparison found a divergence carry nothing at all.
python3 - "$root" "$repo" <<'PY'
import json, pathlib, sys, tomllib

root = pathlib.Path(sys.argv[1])
pc = json.loads((root / "postconciliar.json").read_text(encoding="utf-8"))
old = json.loads((root / "roman-1962.json").read_text(encoding="utf-8"))
pre = json.loads((root / "roman-pre-1955.json").read_text(encoding="utf-8"))

def by_key(payload):
    return {element["key"]: element
            for section in payload["sections"]
            for element in section["elements"]}

def side(element, lang):
    return [one for one in (element["translations"] or []) if one["lang"] == lang]

elements = by_key(pc)
latin = {key: side(element, "la")[0]
         for key, element in elements.items() if side(element, "la")}
assert len(latin) == 20, sorted(latin)
latin_absent = [element["absent"]["latin"] for element in elements.values()
                if not side(element, "la")]
# 2026-10-19: 39 -> 41 and 26 -> 28, C2 G5's two appointed stand-ins, typed
# appointed-text-printed-with-formulary on the Latin side.
assert len(latin_absent) == 41, latin_absent
assert latin_absent.count("editio-typica-new-matter") == 13, latin_absent
assert len(latin_absent) - latin_absent.count("editio-typica-new-matter") == 28

# The English side is quarantined on this assembled surface. No English row or
# source attribution may survive, while the Latin landing remains independent.
english = [key for key, element in elements.items() if side(element, "en")]
assert english == [], english

for key, row in latin.items():
    # The relation is on the row, not on the witness: a book cannot be an
    # antecedent of anything, and a relation encoded in a witness id resolves
    # nowhere. The propers side served 63 translations that way once.
    assert row["relation"] == "antecedent", (key, row.get("relation"))
    assert row["rights"] == "public-domain", (key, row["rights"])
    note = row.get("note") or ""
    assert "NOT THE CONTROLLING EDITION" in note, key
    assert "not served here" in note or "target" in note.lower(), key
    # The grade, and what each grade costs.
    if row["collation"] == "collated":
        assert (row.get("collation_finding") or "").strip(), key
    elif row["collation"] == "uncollated":
        assert not row.get("collation_finding"), key
        assert "uncollated" in note.lower(), key
    else:
        raise AssertionError((key, row["collation"]))

graded = sorted(row["collation"] for row in latin.values())
assert graded.count("collated") == 5, graded
assert graded.count("uncollated") == 15, graded

# The two Roman frames retain Cummiskey's cautions on his own rows. The 1962
# English replacements instead carry Lasance's independent historical-English
# caution, not Cummiskey's boilerplate. Compare the whole source-owned note AND
# its substantive warnings; a change to either the renderer or the declaration
# must not silently remove the historical/non-target and collation boundaries.
inventory = tomllib.loads((
    pathlib.Path(sys.argv[2]) / "src/sources/inventories/roman-1962-ordo-missae-v1.toml"
).read_text(encoding="utf-8"))
lasance_notes = {
    section["key"] + "/" + entry["element"]: entry["english"]
    for section in inventory["sections"]
    for entry in section.get("english_replacements", [])
}
assert {
    section["key"]: len(section.get("english_replacements", []))
    for section in inventory["sections"] if section.get("english_replacements")
} == {"praeparatio": 24, "oblatio": 31, "canon": 20, "communio": 15, "conclusio": 11}
assert len(lasance_notes) == 101
lasance_cautions = {
    "praeparatio": (
        "LASANCE HISTORICAL ENGLISH, NOT THE TARGET EDITION'S ENGLISH.",
        "No full English-to-target clause collation or exact-target relationship is asserted.",
    ),
    "oblatio": (
        "LASANCE HISTORICAL ENGLISH, NOT APPROVED1962ENGLISH.",
        "No complete English-to-target clause collation or exact-target wording claim.",
    ),
}
for section in ("canon", "communio", "conclusio"):
    lasance_cautions[section] = (
        "LASANCE HISTORICAL ENGLISH, NOT APPROVED TARGET-EDITION ENGLISH.",
        "Source-specific ceremonies, unsupported variants and target witness gaps are not resolved.",
    )
seen_lasance_notes = set()
#
# 2026-10-19 (C3, the 1962 Pentecost Ordinary-variable texts): exactly these
# seven 1962 rows carry an element-level collated provenance, and each must
# cite its finding. Every other row keeps the uniform uncollated declaration.
collated_rows = {
    "roman-1962": {
        ("praefatio/praefatio-de-spiritu-sancto-initium", "la"),
        ("praefatio/praefatio-de-spiritu-sancto", "la"),
        ("canon/communicantes", "la"),
        ("canon/communicantes-continuatio", "la"),
        ("canon/communicantes-pentecoste", "la"),
        ("canon/hanc-igitur-pascha-pentecoste", "en"),
        ("canon/hanc-igitur-pascha-pentecoste", "la"),
    },
    "roman-pre-1955": set(),
}
# C26 adds eleven bounded findings and three independent Mame sides. The
# remaining two uncollated Latin units are source paratext and an antecedent
# greeting with no target place; neither is promoted to force completeness.
still_uncollated_1962 = {
    "conclusio/dominus-vobiscum-ante-postcommunionem",
    "praeparatio/gloria-in-excelsis-heading",
}
collated_rows["roman-1962"] |= {
    (key, "la") for key, element in by_key(old).items()
    if side(element, "la") and key not in still_uncollated_1962
}
assert len({key for key, lang in collated_rows["roman-1962"] if lang == "la"}) == 118
for payload in (old, pre):
    seen_collated = set()
    for element in by_key(payload).values():
        for lang in ("en", "la"):
            for row in side(element, lang):
                assert row["relation"] == "antecedent", (payload["calendar"], element["key"], lang)
                if (element["key"], lang) in collated_rows[payload["calendar"]]:
                    seen_collated.add((element["key"], lang))
                    assert row["collation"] == "collated", (payload["calendar"], element["key"], lang)
                    assert (row.get("collation_finding") or "").strip(), (payload["calendar"], element["key"], lang)
                    note = row.get("note") or ""
                    bounded_note_keys = {
                        "praefatio/praefatio-de-ss-trinitate", "praefatio/praefatio-de-quadragesima",
                        "praefatio/praefatio-de-beata-maria-virgine", "praefatio/praefatio-de-apostolis",
                    }
                    assert "COLLATED" in note or (
                        payload["calendar"] == "roman-1962" and lang == "la"
                        and element["key"] in bounded_note_keys and "COLLATION COMPLETE" in note
                    ), (payload["calendar"], element["key"], lang)
                    continue
                assert row["collation"] == "uncollated", (payload["calendar"], element["key"], lang)
                assert not row.get("collation_finding"), (payload["calendar"], element["key"], lang)
                note = row.get("note") or ""
                if payload["calendar"] == "roman-1962" and lang == "en" and element["key"] in lasance_notes:
                    declared = lasance_notes[element["key"]]
                    lasance = "edition.francis-xavier-lasance.the-new-roman-missal.benziger-revised-1945"
                    assert row["source_id"] == declared["witness"] == lasance, (element["key"], row)
                    assert (declared["relation"], declared["collation"]) == ("antecedent", "uncollated"), declared
                    assert note == declared["note"], (element["key"], note)
                    for caution in lasance_cautions[element["key"].split("/", 1)[0]]:
                        assert caution in note, (element["key"], caution, note)
                    seen_lasance_notes.add(element["key"])
                else:
                    assert "ANTECEDENT, NOT THE TARGET EDITION" in note, (payload["calendar"], element["key"], lang)
                    assert "UNCOLLATED" in note, (payload["calendar"], element["key"], lang)
    assert seen_collated == collated_rows[payload["calendar"]], (payload["calendar"], seen_collated)
assert seen_lasance_notes == set(lasance_notes), seen_lasance_notes

# Where a comparison of the two Latins found a divergence, NOTHING is carried,
# and the file still says why. These are the elements the summary would have
# waved through.
for key in ("ritus-communionis/libera-nos",
            "ritus-communionis/domine-iesu-christe-qui-dixisti",
            "ritus-communionis/praeparatio-sacerdotis"):
    assert not side(elements[key], "la"), key
    assert elements[key]["absent"]["latin"] == "antecedent-diverges-at-named-words", key
assert not side(elements["ritus-initiales/kyrie"], "la")
assert elements["ritus-initiales/kyrie"]["absent"]["latin"] == \
    "antecedent-held-not-carried"

# Prayer I is split only at the twelve bounded children the source establishes.
# Nine carry antecedent Latin; the three unsafe children remain explicitly
# absent, and only Quam oblationem has a whole-element collation finding.
prayer_one = [
    one for one in elements.values()
    if {"group": "eucharistic-prayer", "option": "ep-i"}
    in one["alternatives"]
]
assert len(prayer_one) == 12, [one["key"] for one in prayer_one]
prayer_one_latin = {
    one["key"]: side(one, "la")[0]
    for one in prayer_one if side(one, "la")
}
assert len(prayer_one_latin) == 9, sorted(prayer_one_latin)
assert [key for key, row in prayer_one_latin.items() if row["collation"] == "collated"] == [
    "prex-eucharistica/quam-oblationem"
], prayer_one_latin
assert sum(row["collation"] == "uncollated" for row in prayer_one_latin.values()) == 8
prayer_one_absent = {
    one["key"]: one["absent"]["latin"]
    for one in prayer_one if not side(one, "la")
}
assert prayer_one_absent == {
    "prex-eucharistica/communicantes": "element-spans-mixed-matter",
    "prex-eucharistica/qui-pridie": "editio-typica-new-matter",
    "prex-eucharistica/supplices": "element-spans-mixed-matter",
}, prayer_one_absent

# The witness's own accidents are carried and never smoothed toward the target's
# orthography. Normalising them would manufacture a witness to a book nobody
# opened; the notes name them instead.
dialogue = latin["prex-eucharistica/praefationis-dialogus"]["text"]
assert "Dignum et justum est" in dialogue and "iustum" not in dialogue
humility = latin["praeparatio-donorum/in-spiritu-humilitatis"]
assert "nodie" in humility["text"] and "hodie" not in humility["text"]
assert "nodie" in humility["note"], "the misprint is carried and not explained"

# The witness reaches the page under the edition's real id, with a caution that
# leads with the disclaimer rather than the bibliography: both are option text
# in narrow controls, and a truncated label must lose the bibliography.
manifest = {(one["source_id"], one["lang"]): one for one in pc["translations"]}
witness = manifest[
    ("edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861", "la")]
assert witness["held"] == 20, witness
assert witness["label"].startswith("Antecedent Latin (NOT"), witness["label"]
assert witness["caution"].startswith("NOT the Latin of the Missale Romanum"), witness
PY

# The refusals that make the grades mean anything, taken against the tool's own
# rule rather than against a fixture that could drift from it.
python3 - "$repo" <<'PY'
import importlib.machinery, importlib.util, pathlib, sys

# The tool carries no .py suffix, so the loader is named rather than guessed.
path = pathlib.Path(sys.argv[1]) / "tools" / "mass-ordinary"
loader = importlib.machinery.SourceFileLoader("mass_ordinary", str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
tool = importlib.util.module_from_spec(spec)
loader.exec_module(tool)

def refused(block):
    try:
        tool.relation_of(block, "an-element", "la", "a-file")
    except tool.SourceError:
        return True
    return False

ok = {"relation": "antecedent", "collation": "uncollated", "note": "whose words these are"}
assert tool.relation_of(ok, "k", "la", "f")["collation"] == "uncollated"

# A relation nobody can check is a claim nobody made.
assert refused({"relation": "antecedent", "collation": "uncollated"})
# An established identity and an unestablished one must not look the same.
assert refused({"relation": "antecedent", "note": "n"})
assert refused({"relation": "antecedent", "collation": "maybe", "note": "n"})
# A collated grade with no finding is the assertion the other grade exists to
# be distinguished from.
assert refused({"relation": "antecedent", "collation": "collated", "note": "n"})
# A citation on an uncollated row invites the reader to read it as the
# collation that was not made.
assert refused(ok | {"collation_finding": "somewhere.tex:1"})
# And an unknown relation is refused rather than passed through.
assert refused({"relation": "descendant"})
# Inline text without an antecedent declaration is the target edition's own.
assert tool.relation_of({}, "k", "la", "f") == {"relation": "own"}
PY

# ---- The tiers ------------------------------------------------------------
run_tool show --calendar roman-1962 --plain >"$sandbox/plain.txt"
if LC_ALL=C grep -q '[^ -~	]' "$sandbox/plain.txt"; then
	echo "--plain printed a byte above 0x7F" >&2
	exit 1
fi
run_tool show --calendar roman-1962 --json >"$sandbox/one.json"
run_tool show --calendar roman-1962 --json --plain >"$sandbox/two.json"
if ! cmp -s "$sandbox/one.json" "$sandbox/two.json"; then
	echo "--json is not byte-identical across tiers" >&2
	exit 1
fi

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $*" >&2
		exit 1
	fi
}

reject show --calendar nonesuch
reject show --lang xx
reject check --calendar nonesuch

echo ok
