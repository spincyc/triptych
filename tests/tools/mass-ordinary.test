#!/bin/sh
# Test for `tools/tpt mass-ordinary`: exit 0 = pass (the stable gate).
# Only `structure` writes, and it is aimed at a sandbox here; everything else
# reads the inventories and prints.
#
# TWO KINDS OF ASSERTION MATTER HERE, and neither is about a crash.
#
# The first is absence. Every postconciliar element missing one of this layer's
# two languages names a precise reason; acquisition, rights, modelling,
# outside-layer, and non-textual states must not collapse into one claim. An
# element that shows nothing where a prayer belongs would otherwise tell the
# reader that the Mass omits it. Every silence therefore names its reason in
# every form this tool prints.
#
# The second is the seats. The slots are the missal's own statement of where a
# proper stands, they anchor to the frame's own elements — including its
# rubrics — and `mass-today --expanded` and the browser both read them from
# here. A slot whose anchor no longer exists loses a proper silently.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="mass-ordinary"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# `check` validates the inventories and reports whether the written files are
# current. It writes nothing.
summary="$(run_tool check --calendar roman-1962 | head -1)"
case "$summary" in
*"roman-1962: 6 sections, 189 elements, 2 witnesses, 0 variants, 9 slots; en 189 held/0 missing, la 112 held/77 missing; relations en antecedent/uncollated 189, la antecedent/uncollated 112; 6 target-recension exclusions"*) ;;
*)
	echo "unexpected summary line: $summary" >&2
	exit 1
	;;
esac

# `structure` writes what the browser fetches, and only where --out points.
run_tool structure --out "$sandbox/data" >/dev/null
root="$sandbox/data/structure/ordinary"
if [ ! -d "$root" ]; then
	echo "structure wrote no ordinary" >&2
	exit 1
fi

python3 - "$root" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])
index = json.loads((root / "index.json").read_text(encoding="utf-8"))
assert index["calendars"], "the index names no calendar"
files = sorted(p for p in root.glob("*.json") if p.name != "index.json")
assert files, "structure wrote no calendar file"

for path in files:
    payload = json.loads(path.read_text(encoding="utf-8"))
    assert payload["schema"] == "triptych-ordinary-structure/v1", payload["schema"]
    assert payload["advisory"], f"{path.name}: no caution about itself"
    serialized = json.dumps(payload, ensure_ascii=False).lower()
    for forbidden in (
        "english-language-liturgical", "english language liturgical",
        "international-commission-on-english", "international commission on english",
        "licensed-free", "icel", "ellc",
    ):
        assert forbidden not in serialized, (path.name, forbidden)

    for absence in payload["absences"]:
        assert set(absence) == {"key", "count", "state", "kind"}, absence
        wanted = ("rights-restricted"
                  if absence["kind"] == "rights-withheld" else "unavailable")
        assert absence["state"] == wanted, absence

    elements = {
        element["key"]: element
        for section in payload["sections"]
        for element in section["elements"]
    }
    assert elements, path.name
    if payload["calendar"] == "postconciliar":
        assert len(elements) == 59, len(elements)
        absence_counts = {one["key"]: one["count"] for one in payload["absences"]}
        assert absence_counts["approved-english-publication-restriction"] == 25, absence_counts
        assert absence_counts["antecedent-held-not-carried"] == 1, absence_counts
        assert absence_counts["antecedent-diverges-at-named-words"] == 3, absence_counts

        # Independent choices remain independent. A reader selects exactly one
        # option from each group; it must never concatenate three Penitential
        # Acts, two Creeds, or four Eucharistic Prayers into one rite.
        groups = {one["group"]: one for one in payload["variants"]}
        assert set(groups) == {"penitential-act", "creed", "eucharistic-prayer"}, groups
        assert all(one["mode"] == "one-of" for one in groups.values()), groups
        assert [one["id"] for one in groups["penitential-act"]["options"]] == [
            "pa-i", "pa-ii", "pa-iii",
        ]
        assert [one["id"] for one in groups["creed"]["options"]] == [
            "creed-nicene", "creed-apostles",
        ]
        memberships = {
            key: element["alternatives"]
            for key, element in elements.items()
            if element["alternatives"]
        }
        assert memberships["ritus-initiales/actus-paenitentialis-i"] == [
            {"group": "penitential-act", "option": "pa-i"},
        ]
        assert memberships["ritus-initiales/actus-paenitentialis-ii"] == [
            {"group": "penitential-act", "option": "pa-ii"},
        ]
        assert memberships["ritus-initiales/actus-paenitentialis-iii"] == [
            {"group": "penitential-act", "option": "pa-iii"},
        ]
        assert memberships["symbolum/symbolum-nicaenum"] == [
            {"group": "creed", "option": "creed-nicene"},
        ]
        assert memberships["symbolum/symbolum-apostolicum"] == [
            {"group": "creed", "option": "creed-apostles"},
        ]

        # Applicability is structured as a bounded disjunction. In particular,
        # the Gloria's Sunday branch excludes Advent and Lent without falsely
        # suppressing a solemnity or feast that occurs in those seasons.
        gloria = elements["ritus-initiales/gloria-in-excelsis"]
        assert gloria["conditions"][0]["kind"] == "include-when-any", gloria
        assert gloria["conditions"][0]["unknown"] == "unresolved", gloria
        assert gloria["conditions"][0]["predicates"] == [
            "sunday-outside-advent-and-lent",
            "solemnity-or-feast",
            "particular-celebration-of-more-solemn-character",
        ], gloria
        kyrie = elements["ritus-initiales/kyrie"]
        assert kyrie["conditions"][0]["kind"] == "omit-when-option", kyrie
        assert kyrie["conditions"][0]["unknown"] == "unresolved", kyrie
        assert kyrie["conditions"][0]["group"] == "penitential-act", kyrie
        assert kyrie["conditions"][0]["options"] == ["pa-iii"], kyrie
        for key in ("symbolum/symbolum-nicaenum", "symbolum/symbolum-apostolicum"):
            condition = elements[key]["conditions"][0]
            assert condition["kind"] == "include-when-any", (key, condition)
            assert condition["unknown"] == "unresolved", (key, condition)
            assert condition["predicates"] == [
                "sunday-or-solemnity",
                "particular-celebration-of-more-solemn-character",
            ], (key, condition)

        second_reading = elements["liturgia-verbi/lectio-secunda"]["conditions"][0]
        assert second_reading["kind"] == "include-when-any", second_reading
        assert second_reading["predicates"] == ["second-reading-appointed"], second_reading
        assert second_reading["unknown"] == "unresolved", second_reading
        prayer_four = elements["prex-eucharistica/prex-eucharistica-iv"]["conditions"][0]
        assert prayer_four["kind"] == "include-when-any", prayer_four
        assert prayer_four["predicates"] == ["mass-has-no-proper-preface"], prayer_four
        assert prayer_four["unknown"] == "unresolved", prayer_four

    elif payload["calendar"] == "roman-1962":
        assert len(elements) == 189, len(elements)
        languages = {one["lang"]: one for one in payload["languages"]}
        assert (languages["en"]["held"], languages["en"]["missing"]) == (189, 0), languages
        assert (languages["la"]["held"], languages["la"]["missing"]) == (112, 77), languages
        expected = {
            "oblatio/a-cunctis",
            "oblatio/nota-incarnationis",
            "oblatio/rubrica-collecta-concede",
            "oblatio/rubrica-secreta",
            "oblatio/rubrica-secreta-concede",
            "oblatio/secreta-ii",
        }
        exclusions = {one["key"]: one for one in payload["exclusions"]}
        assert set(exclusions) == expected, exclusions
        assert not (set(elements) & expected), set(elements) & expected
        for key, exclusion in exclusions.items():
            assert exclusion["state"] == "not-in-target-recension", (key, exclusion)
            assert exclusion["basis"], (key, exclusion)
            assert exclusion["sources"], (key, exclusion)
            assert exclusion["sources"] == sorted(set(exclusion["sources"])), exclusion
            assert all(isinstance(source, str) and source for source in exclusion["sources"]), exclusion
            assert exclusion["evidence"], (key, exclusion)
            assert all(row["source_id"] in exclusion["sources"] for row in exclusion["evidence"]), exclusion
            assert all(row["lang"] == "en" for row in exclusion["evidence"]), exclusion
            assert all(row["relation"] == "antecedent" for row in exclusion["evidence"]), exclusion
            assert all("text" not in row for row in exclusion["evidence"]), exclusion
        absence_counts = {one["key"]: one["count"] for one in payload["absences"]}
        assert absence_counts == {
            "no-facing-latin": 8,
            "not-in-the-1962-ordo": 2,
            "witness-own-english": 67,
        }, absence_counts
        assert sum(absence_counts.values()) == 77, absence_counts

    elif payload["calendar"] == "roman-pre-1955":
        # No 1920 exclusion is inferred from notes that speak only about 1962.
        assert len(elements) == 195, len(elements)
        assert payload["exclusions"] == [], payload["exclusions"]
        for key in (
            "oblatio/a-cunctis",
            "oblatio/nota-incarnationis",
            "oblatio/rubrica-collecta-concede",
            "oblatio/rubrica-secreta",
            "oblatio/rubrica-secreta-concede",
            "oblatio/secreta-ii",
        ):
            assert key in elements, key

    if payload["calendar"] in ("roman-1962", "roman-pre-1955"):
        # Only five printed blocks are source-owned as single-speaker rows. Each
        # language partitions that exact row once and reconstructs its text;
        # no dialogue role is inferred from an R. or P. glyph.
        partitioned = {
            "praeparatio/confiteor-sacerdotis": "priest",
            "praeparatio/confiteor-ministrorum": "server",
            "oblatio/laus-tibi-christe": "server",
            "oblatio/suscipiat-dominus": "server",
            "conclusio/deo-gratias": "server",
        }
        reached = set()
        for key, speaker in partitioned.items():
            rows = elements[key]["translations"]
            assert {row["lang"] for row in rows} == {"en", "la"}, (key, rows)
            for row in rows:
                assert len(row["turns"]) == 1, (key, row["lang"], row["turns"])
                turn = row["turns"][0]
                assert turn["key"] == key.rsplit("/", 1)[1], (key, turn)
                assert turn["speaker"] == speaker, (key, turn)
                assert turn["dialogue_role"] is None and turn["action"] is None, (key, turn)
                assert turn["text"] == row["text"], (key, row["lang"])
                reached.add((key, row["lang"]))
        assert reached == {
            (key, lang) for key in partitioned for lang in ("en", "la")
        }, reached

        # These 30 blocks contain internal speaker changes but each language's
        # artifact still stores the whole printed block in one row. They stay
        # opaque until reviewed child rows exist; punctuation is not a boundary.
        opaque = {
            "praeparatio/introibo-ad-altare-dei",
            "praeparatio/judica-me-deus",
            "praeparatio/emitte-lucem-tuam",
            "praeparatio/confitebor-tibi-in-cithara",
            "praeparatio/gloria-patri",
            "praeparatio/introibo-ad-altare-dei-repetitio",
            "praeparatio/adjutorium-nostrum",
            "praeparatio/misereatur-tui",
            "praeparatio/misereatur-vestri",
            "praeparatio/indulgentiam",
            "praeparatio/deus-tu-conversus",
            "praeparatio/ostende-nobis",
            "praeparatio/domine-exaudi",
            "praeparatio/dominus-vobiscum",
            "praeparatio/kyrie-eleison",
            "praeparatio/christe-eleison",
            "praeparatio/kyrie-eleison-repetitio",
            "praeparatio/dominus-vobiscum-post-gloriam",
            "oblatio/dominus-vobiscum-ante-evangelium",
            "oblatio/dominus-vobiscum-ante-offertorium",
            "oblatio/per-omnia-saecula",
            "oblatio/sursum-corda",
            "canon/per-omnia-saecula",
            "communio/pater-noster",
            "communio/per-omnia-saecula-post-libera-nos",
            "communio/pax-domini",
            "conclusio/dominus-vobiscum-ante-postcommunionem",
            "conclusio/dominus-vobiscum-ite-missa-est",
            "conclusio/requiescant-in-pace",
            "conclusio/initium-sancti-evangelii",
        }
        assert len(opaque) == 30 and opaque <= set(elements), opaque - set(elements)
        for key in opaque:
            rows = elements[key]["translations"]
            assert {row["lang"] for row in rows} == {"en", "la"}, (key, rows)
            assert all("turns" not in row for row in rows), (key, rows)

    # ---- Absence, with its reason, everywhere ----------------------------
    #
    # An element holds a text in a language or names why it does not. The
    # reason is keyed by the side of the book — `english`, `latin` — because
    # that is how the printing is organised, and a silence with no key is a
    # defect in the source rather than a silence about the rite.
    languages = [one["lang"] for one in payload["languages"]]
    sides = {"en": "english", "la": "latin"}
    for element in elements.values():
        held = {one["lang"] for one in (element["translations"] or [])}
        for lang in languages:
            if lang in held:
                continue
            reason = (element["absent"] or {}).get(sides[lang], None)
            assert reason, (path.name, element["key"], lang)
        # Every reason an element names is accounted for once, above, with how
        # many elements it covers.
        for reason in (element["absent"] or {}).values():
            if reason:
                assert any(one["key"] == reason for one in payload["absences"]), reason

    # A witness that reaches the served file has a recorded rights basis.
    for witness in payload["translations"]:
        assert witness["rights"], witness

    # ---- The seats -------------------------------------------------------
    #
    # A slot anchors to an element this file really emits, cites the rubric
    # that puts it there, and claims a proper name no other slot claims.
    claimed = {}
    order = [
        element["key"]
        for section in payload["sections"]
        for element in section["elements"]
    ]
    last = -1
    for slot in payload["slots"]:
        assert slot["anchor"] in elements, (path.name, slot["key"], slot["anchor"])
        assert slot["where"] in ("before", "after"), slot
        assert slot["locus"], slot["key"]
        assert slot["propers"], slot["key"]
        for name in slot["propers"]:
            assert name not in claimed, (name, claimed.get(name), slot["key"])
            claimed[name] = slot["key"]
        # The slots run forward through the elements, which is what makes the
        # file's own order readable as the order of the rite.
        here = order.index(slot["anchor"])
        assert here >= last, (path.name, slot["key"], here, last)
        last = here
    if payload["slots"]:
        assert payload["slots_derived_from"], path.name
PY

# The same inventories produce the same bytes.
run_tool structure --out "$sandbox/again" >/dev/null
if ! diff -r "$root" "$sandbox/again/structure/ordinary" >/dev/null; then
	echo "structure is not byte-stable across runs" >&2
	exit 1
fi

# Coverage keeps target-recension exclusions visible. Reducing the element and
# absence totals without these six records would make the false 1861 additions
# disappear from the audit instead of recording why they are not 1962 members.
run_tool coverage --json >"$sandbox/coverage.json"
python3 - "$sandbox/coverage.json" "$root" <<'PY'
import json, pathlib, sys

coverage = {
    row["calendar"]: row
    for row in json.loads(pathlib.Path(sys.argv[1]).read_text(encoding="utf-8"))["coverage"]
}
structures = pathlib.Path(sys.argv[2])
old = coverage["roman-1962"]
pre = coverage["roman-pre-1955"]
expected = {
    "oblatio/a-cunctis",
    "oblatio/nota-incarnationis",
    "oblatio/rubrica-collecta-concede",
    "oblatio/rubrica-secreta",
    "oblatio/rubrica-secreta-concede",
    "oblatio/secreta-ii",
}
assert old["elements"] == 189, old
assert {row["key"] for row in old["exclusions"]} == expected, old["exclusions"]
assert all(row["state"] == "not-in-target-recension" for row in old["exclusions"])
assert old["exclusions"] == json.loads(
    (structures / "roman-1962.json").read_text(encoding="utf-8")
)["exclusions"]
languages = {row["lang"]: row for row in old["language_coverage"]}
assert languages["en"] == {
    "lang": "en", "elements": 189, "held": 189, "missing": 0, "absent": 0,
}, languages
assert languages["la"] == {
    "lang": "la", "elements": 189, "held": 112, "missing": 77, "absent": 77,
}, languages
assert pre["elements"] == 195 and pre["exclusions"] == [], pre
assert coverage["postconciliar"]["exclusions"] == [], coverage["postconciliar"]
PY

# ---- What `show` prints ---------------------------------------------------
#
# A rubric is an instruction and not a prayer. It was set at the same indent in
# the same face as the prayer beside it, so the two rubrics bracketing the
# Placeat read as its first and last lines.
shown="$(run_tool show --calendar roman-1962)"
case "$shown" in
*"[ Bowing before the Altar, the Priest says ]"*) ;;
*)
	echo "a rubric is not set apart from the prayers" >&2
	exit 1
	;;
esac
case "$shown" in
*"[ Let the performance of my homage"*)
	echo "a prayer was set as though it were a rubric" >&2
	exit 1
	;;
esac

# The priest's actions can be hidden, and hiding them touches nothing else.
hidden="$(run_tool show --calendar roman-1962 --no-rubrics)"
case "$hidden" in
*"Bowing before the Altar"*)
	echo "--no-rubrics did not hide the priest's actions" >&2
	exit 1
	;;
esac
case "$hidden" in
*"Placeat tibi sancta Trinitas"*) ;;
*)
	echo "--no-rubrics removed a prayer" >&2
	exit 1
	;;
esac

# A missing text says why, at the place it falls due, rather than showing a
# blank where a prayer belongs. This one has a registered official exemplar but
# no tracked payload that may be joined to the element.
missing="$(run_tool show --calendar postconciliar)"
case "$missing" in
*"[absent: official-exemplar-not-carried]"*) ;;
*)
	echo "a missing element does not name its reason" >&2
	exit 1
	;;
esac

# `--lang la` prints the Latin, and where the witness has none it reports the
# LATIN's own reason. Reading the block by ISO code once found nothing and fell
# through to the English one, which reported the postconciliar Latin restricted:
# a real reason, for the other text. Since the 1861 printing's
# facing column was transcribed. The pre-1955 projection carries Latin for 112
# of 195 elements and names the other 83 source blocks. The 1962 projection
# carries the same 112 Latin blocks among 189 target members; its remaining 77
# are the witness's English-only blocks, after six explicit nonmembers are
# accounted separately as recension exclusions rather than false target text.
latin="$(run_tool show --calendar roman-1962 --lang la)"
case "$latin" in
*"[absent: no-facing-latin]"*) ;;
*)
	echo "--lang la does not report the Latin's own reason" >&2
	exit 1
	;;
esac
case "$latin" in
*"[absent: not-in-the-1962-ordo]"*) ;;
*)
	echo "--lang la does not report the abolished-regime classification" >&2
	exit 1
	;;
esac
case "$latin" in
*"[absent: witness-own-english]"*) ;;
*)
	echo "--lang la does not report the witness-owned classification" >&2
	exit 1
	;;
esac
case "$latin" in
*"IN Nomine Patris, et Filii, et Spiritus Sancti"*) ;;
*)
	echo "--lang la printed no Latin from the facing column" >&2
	exit 1
	;;
esac

# Every absence states its KIND, and the six kinds are not interchangeable.
# A source or payload gap, a rights restriction, no known exemplar, a model
# span, material owned by another layer, and a structural non-text are different
# facts. The discriminator is checked here rather than left to prose.
kinds="$(run_tool structure --out "$sandbox/kinds" >/dev/null 2>&1; \
	python3 -c "import json,sys,pathlib
seen={}
for path in sorted(pathlib.Path(sys.argv[1]).rglob('*.json')):
    if path.name == 'index.json': continue
    for row in (json.loads(path.read_text()).get('absences') or []):
        seen[row['key']]=row['kind']
print(' '.join(k+'='+str(v) for k,v in sorted(seen.items())))" "$sandbox/kinds")"
# The rights refusal is now scoped to the reform's OWN new matter. The single
# `editio-typica` key it replaced asserted that refusal over the whole frame.
# A key that says "rights-withheld" must name only what is actually withheld,
# which is what this asserts.
case "$kinds" in
*"editio-typica-new-matter=rights-withheld"*) ;;
*)
	echo "the reform's new matter is not typed as a rights withholding: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"antecedent-held-not-carried=witness-gap"*) ;;
*)
	echo "an unsourced ancient text is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
# Registered official exemplars with no joined payload are witness gaps.
case "$kinds" in
*"official-exemplar-not-carried=witness-gap"*) ;;
*)
	echo "an official exemplar without a payload is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
# Variable texts assigned by the calendar/Propers layer are outside this layer,
# not missing Ordinary witnesses.
case "$kinds" in
*"proper-text-outside-ordinary=outside-layer"*) ;;
*)
	echo "a Proper text is not typed as outside the Ordinary layer: $kinds" >&2
	exit 1
	;;
esac
# Actions and locally supplied matter with no invariant words are not textual
# acquisition failures.
case "$kinds" in
*"no-fixed-text=not-applicable"*"not-a-text=not-applicable"*) ;;
*)
	echo "a non-textual element is not typed as not applicable: $kinds" >&2
	exit 1
	;;
esac
# An element that spans independently sourceable parts is a model gap on either
# language side; acquiring one more excerpt would not make the composite whole.
case "$kinds" in
*"element-spans-mixed-availability=model-gap"*"element-spans-mixed-matter=model-gap"*) ;;
*)
	echo "a composite element is not typed as a model gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"canon-not-split="*)
	echo "the retired whole-Canon model gap still reaches output: $kinds" >&2
	exit 1
	;;
esac
# Quiet priest prayers have no exact exemplar in the registered official
# excerpts. Nobody has refused their use.
case "$kinds" in
*"priest-prayer-said-quietly=no-exemplar"*) ;;
*)
	echo "a quiet prayer without an exemplar is mistyped: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"no-facing-latin=witness-gap"*) ;;
*)
	echo "the 1962 Latin absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"not-in-the-1962-ordo=witness-gap"*) ;;
*)
	echo "the abolished-regime absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac
case "$kinds" in
*"witness-own-english=witness-gap"*) ;;
*)
	echo "the witness-owned absence is not typed as a witness gap: $kinds" >&2
	exit 1
	;;
esac

# ---- The antecedent Latin, and the claim it must never make ---------------
#
# Twenty elements of the postconciliar frame now carry Latin, and NOT ONE OF THEM
# IS THE LATIN OF THE BOOK THAT PAGE IS HEADED WITH. Every one is the facing
# column of an 1861 Philadelphia lay hand missal, printing the ancient prayer
# the postconciliar Order received; the editio typica is in copyright and is
# held nowhere in this project.
#
# A reader looking at a page headed `Missale Romanum, editio typica tertia` and
# seeing Latin under an element will take it for that book's Latin unless told
# otherwise AT THAT ELEMENT. So the relation, its grade, and a note saying both
# ride on the translation row itself, beside the words, and this asserts they
# are there rather than trusting that they are.
#
# The two grades must not look alike, and that is the assertion with teeth. The
# study's own coarse `Retained` list names `Domine Iesu Christe, qui dixisti`
# among the texts carried over -- and the 2002 reads `ne respicias peccata
# NOSTRA` where the 1861 reads `peccata MEA`. Landing on the strength of the
# summary would have put the wrong pronoun into the Rite of Peace on every day
# of this calendar. `collated` therefore costs a cited finding, `uncollated`
# says in terms that the identity is not established, and the elements where a
# comparison found a divergence carry nothing at all.
python3 - "$root" <<'PY'
import json, pathlib, sys

root = pathlib.Path(sys.argv[1])
pc = json.loads((root / "postconciliar.json").read_text(encoding="utf-8"))
old = json.loads((root / "roman-1962.json").read_text(encoding="utf-8"))
pre = json.loads((root / "roman-pre-1955.json").read_text(encoding="utf-8"))

def by_key(payload):
    return {element["key"]: element
            for section in payload["sections"]
            for element in section["elements"]}

def side(element, lang):
    return [one for one in (element["translations"] or []) if one["lang"] == lang]

elements = by_key(pc)
latin = {key: side(element, "la")[0]
         for key, element in elements.items() if side(element, "la")}
assert len(latin) == 20, sorted(latin)
latin_absent = [element["absent"]["latin"] for element in elements.values()
                if not side(element, "la")]
assert len(latin_absent) == 39, latin_absent
assert latin_absent.count("editio-typica-new-matter") == 13, latin_absent
assert len(latin_absent) - latin_absent.count("editio-typica-new-matter") == 26

# The English side is quarantined on this assembled surface. No English row or
# source attribution may survive, while the Latin landing remains independent.
english = [key for key, element in elements.items() if side(element, "en")]
assert english == [], english

for key, row in latin.items():
    # The relation is on the row, not on the witness: a book cannot be an
    # antecedent of anything, and a relation encoded in a witness id resolves
    # nowhere. The propers side served 63 translations that way once.
    assert row["relation"] == "antecedent", (key, row.get("relation"))
    assert row["rights"] == "public-domain", (key, row["rights"])
    note = row.get("note") or ""
    assert "NOT THE CONTROLLING EDITION" in note, key
    assert "not served here" in note or "target" in note.lower(), key
    # The grade, and what each grade costs.
    if row["collation"] == "collated":
        assert (row.get("collation_finding") or "").strip(), key
    elif row["collation"] == "uncollated":
        assert not row.get("collation_finding"), key
        assert "uncollated" in note.lower(), key
    else:
        raise AssertionError((key, row["collation"]))

graded = sorted(row["collation"] for row in latin.values())
assert graded.count("collated") == 5, graded
assert graded.count("uncollated") == 15, graded

# Both Roman frames are headed by a target typical edition later than the 1861
# hand missal whose two columns supply their words. Every artifact-backed row is
# therefore an explicitly uncollated antecedent, in both languages. The
# section-level declaration is deliberately uniform: it makes no invented
# element-level finding.
for payload in (old, pre):
    for element in by_key(payload).values():
        for lang in ("en", "la"):
            for row in side(element, lang):
                assert row["relation"] == "antecedent", (payload["calendar"], element["key"], lang)
                assert row["collation"] == "uncollated", (payload["calendar"], element["key"], lang)
                assert not row.get("collation_finding"), (payload["calendar"], element["key"], lang)
                note = row.get("note") or ""
                assert "ANTECEDENT, NOT THE TARGET EDITION" in note, (payload["calendar"], element["key"], lang)
                assert "UNCOLLATED" in note, (payload["calendar"], element["key"], lang)

# Where a comparison of the two Latins found a divergence, NOTHING is carried,
# and the file still says why. These are the elements the summary would have
# waved through.
for key in ("ritus-communionis/libera-nos",
            "ritus-communionis/domine-iesu-christe-qui-dixisti",
            "ritus-communionis/praeparatio-sacerdotis"):
    assert not side(elements[key], "la"), key
    assert elements[key]["absent"]["latin"] == "antecedent-diverges-at-named-words", key
assert not side(elements["ritus-initiales/kyrie"], "la")
assert elements["ritus-initiales/kyrie"]["absent"]["latin"] == \
    "antecedent-held-not-carried"

# Prayer I is split only at the twelve bounded children the source establishes.
# Nine carry antecedent Latin; the three unsafe children remain explicitly
# absent, and only Quam oblationem has a whole-element collation finding.
prayer_one = [
    one for one in elements.values()
    if {"group": "eucharistic-prayer", "option": "ep-i"}
    in one["alternatives"]
]
assert len(prayer_one) == 12, [one["key"] for one in prayer_one]
prayer_one_latin = {
    one["key"]: side(one, "la")[0]
    for one in prayer_one if side(one, "la")
}
assert len(prayer_one_latin) == 9, sorted(prayer_one_latin)
assert [key for key, row in prayer_one_latin.items() if row["collation"] == "collated"] == [
    "prex-eucharistica/quam-oblationem"
], prayer_one_latin
assert sum(row["collation"] == "uncollated" for row in prayer_one_latin.values()) == 8
prayer_one_absent = {
    one["key"]: one["absent"]["latin"]
    for one in prayer_one if not side(one, "la")
}
assert prayer_one_absent == {
    "prex-eucharistica/communicantes": "element-spans-mixed-matter",
    "prex-eucharistica/qui-pridie": "editio-typica-new-matter",
    "prex-eucharistica/supplices": "element-spans-mixed-matter",
}, prayer_one_absent

# The witness's own accidents are carried and never smoothed toward the target's
# orthography. Normalising them would manufacture a witness to a book nobody
# opened; the notes name them instead.
dialogue = latin["prex-eucharistica/praefationis-dialogus"]["text"]
assert "Dignum et justum est" in dialogue and "iustum" not in dialogue
humility = latin["praeparatio-donorum/in-spiritu-humilitatis"]
assert "nodie" in humility["text"] and "hodie" not in humility["text"]
assert "nodie" in humility["note"], "the misprint is carried and not explained"

# The witness reaches the page under the edition's real id, with a caution that
# leads with the disclaimer rather than the bibliography: both are option text
# in narrow controls, and a truncated label must lose the bibliography.
manifest = {(one["source_id"], one["lang"]): one for one in pc["translations"]}
witness = manifest[
    ("edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861", "la")]
assert witness["held"] == 20, witness
assert witness["label"].startswith("Antecedent Latin (NOT"), witness["label"]
assert witness["caution"].startswith("NOT the Latin of the Missale Romanum"), witness
PY

# The refusals that make the grades mean anything, taken against the tool's own
# rule rather than against a fixture that could drift from it.
python3 - "$repo" <<'PY'
import importlib.machinery, importlib.util, pathlib, sys

# The tool carries no .py suffix, so the loader is named rather than guessed.
path = pathlib.Path(sys.argv[1]) / "tools" / "mass-ordinary"
loader = importlib.machinery.SourceFileLoader("mass_ordinary", str(path))
spec = importlib.util.spec_from_loader(loader.name, loader)
tool = importlib.util.module_from_spec(spec)
loader.exec_module(tool)

def refused(block):
    try:
        tool.relation_of(block, "an-element", "la", "a-file")
    except tool.SourceError:
        return True
    return False

ok = {"relation": "antecedent", "collation": "uncollated", "note": "whose words these are"}
assert tool.relation_of(ok, "k", "la", "f")["collation"] == "uncollated"

# A relation nobody can check is a claim nobody made.
assert refused({"relation": "antecedent", "collation": "uncollated"})
# An established identity and an unestablished one must not look the same.
assert refused({"relation": "antecedent", "note": "n"})
assert refused({"relation": "antecedent", "collation": "maybe", "note": "n"})
# A collated grade with no finding is the assertion the other grade exists to
# be distinguished from.
assert refused({"relation": "antecedent", "collation": "collated", "note": "n"})
# A citation on an uncollated row invites the reader to read it as the
# collation that was not made.
assert refused(ok | {"collation_finding": "somewhere.tex:1"})
# And an unknown relation is refused rather than passed through.
assert refused({"relation": "descendant"})
# Inline text without an antecedent declaration is the target edition's own.
assert tool.relation_of({}, "k", "la", "f") == {"relation": "own"}
PY

# ---- The tiers ------------------------------------------------------------
run_tool show --calendar roman-1962 --plain >"$sandbox/plain.txt"
if LC_ALL=C grep -q '[^ -~	]' "$sandbox/plain.txt"; then
	echo "--plain printed a byte above 0x7F" >&2
	exit 1
fi
run_tool show --calendar roman-1962 --json >"$sandbox/one.json"
run_tool show --calendar roman-1962 --json --plain >"$sandbox/two.json"
if ! cmp -s "$sandbox/one.json" "$sandbox/two.json"; then
	echo "--json is not byte-identical across tiers" >&2
	exit 1
fi

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $*" >&2
		exit 1
	fi
}

reject show --calendar nonesuch
reject show --lang xx
reject check --calendar nonesuch

echo ok
