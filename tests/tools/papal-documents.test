#!/bin/sh
# Exercise the held catalog without network access or source-text downloads.
set -eu
repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/papal-documents"
"$tool" --help >/dev/null
sandbox="$(mktemp -d "$repo/.scratch/catalog_pipeline/smoke.XXXXXX")"
trap 'rm -rf "$sandbox"' EXIT INT TERM
"$tool" check --json >"$sandbox/check.json"
"$tool" list --pope leo-xiv --type encyclical --json >"$sandbox/list.json"
identity="$(python3 - "$sandbox/list.json" <<'PY'
import json, sys
payload = json.load(open(sys.argv[1]))
assert payload['count'] >= 1
print(payload['documents'][0]['id'])
PY
)"
"$tool" show --document "$identity" --json >"$sandbox/show.json"
"$tool" export --document "$identity" --format biblatex --out "$sandbox/one.bib" >/dev/null
"$tool" export --document "$identity" --format beamer --out "$sandbox/one.tex" >/dev/null
python3 - "$sandbox" <<'PY'
import json, pathlib, sys
root = pathlib.Path(sys.argv[1])
report = json.loads((root / 'check.json').read_text())
assert report['ok'] and report['documents'] > 0
row = json.loads((root / 'show.json').read_text())
assert row['pope_id'] == 'leo-xiv' and row['document_type'] == 'encyclical'
assert '@online{' in (root / 'one.bib').read_text()
assert '\\documentclass' in (root / 'one.tex').read_text()
PY
status=0
"$tool" discover --workers 0 --cache "$sandbox/cache" --catalog "$sandbox/no.json" >/dev/null 2>&1 || status=$?
test "$status" -eq 2
test ! -e "$sandbox/no.json"
test ! -e "$sandbox/cache"
echo ok
