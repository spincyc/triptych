#!/bin/sh
set -eu
repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
PYTHONDONTWRITEBYTECODE=1 python3 "$repo/tools/tests/test_document_schema.py"
"$repo/tools/document-schema" --help >/dev/null
"$repo/tools/document-schema" types --json >/dev/null
"$repo/tools/document-schema" check >/dev/null
