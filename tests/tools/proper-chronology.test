#!/bin/sh
# Test for `tools/tpt proper-chronology`: exit 0 = pass (the stable gate).
#
# This tool is the propers' only route to biblical chronology
# (`guidance/scripture-chronology.md` section 14), so the assertions that
# matter most are the ones about what it will NOT do: it converts no psalm
# number, it invents no locus for an unregistered identity, and it refuses a
# record that has drifted from the corpus instead of rewriting the tree to
# agree with the leaf.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="proper-chronology"
collection="liturgy/roman-rite/1962/propers"
fourteenth="$collection/temporal/54-fourteenth-after-pentecost"
traditional="catholic-traditional-v1"
publication="catholic-comprehensive-v1"

run_tool() {
	"$tool" "$tool_id" "$@"
}

fail() {
	echo "$1" >&2
	exit 1
}

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		fail "expected failure: $*"
	fi
}

run_tool --help >/dev/null
run_tool loci --help >/dev/null
run_tool record --help >/dev/null
run_tool annotations --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# Every published leaf both providers hold must resolve. A proper this tool
# cannot address is a proper the contract cannot be enforced on. EVERY leaf
# directory is asked, not only the ones carrying a manifest: skipping on
# `proper-components.toml` dropped ritual/m01-nuptial-mass, the one leaf that
# could not be answered for at all, and a skipped leaf looks exactly like a
# passing one.
leaves=0
ritual=0
for provider in gpt claude; do
	for leaf in "$repo/src/$provider/$collection"/*/*/; do
		[ -d "$leaf" ] || continue
		slug="${leaf#"$repo/src/$provider/"}"
		slug="${slug%/}"
		[ -f "$leaf/main.tex" ] || fail "leaf with no main.tex: src/$provider/$slug"
		run_tool loci --provider "$provider" --document "$slug" >/dev/null ||
			fail "published leaf refused: src/$provider/$slug"
		leaves=$((leaves + 1))
		case "$slug" in
		*/ritual/*) ritual=$((ritual + 1)) ;;
		esac
	done
done
[ "$leaves" -gt 0 ] || fail "found no published leaves: the regression checked nothing"
[ "$ritual" -gt 0 ] || fail "no ritual leaf was reached: the old glob skipped them"

# A ritual identity is answered, not refused: the calendar registers no `M`
# because a nuptial Mass is appointed by a rite and not by a day, and the
# record must be able to say so rather than being impossible to write.
run_tool record --provider gpt \
	--document "$collection/ritual/m01-nuptial-mass" >"$sandbox/ritual.toml"
grep -q '^formulary = "no-calendar-formulary"$' "$sandbox/ritual.toml" ||
	fail "the ritual record does not state why it lists no element"
if grep -q '^\[\[elements\]\]$' "$sandbox/ritual.toml"; then
	fail "the ritual record invented elements the calendar does not appoint"
fi
grep -q '^formulary_reason = ".*ritual Mass' "$sandbox/ritual.toml" ||
	fail "the ritual record does not say why it lists no element"

# The loci are the corpus's own spelling, taken from the canonical book index
# and never from a table written here. Psalm 83 is the Vulgate number the
# missal prints, not the 84 an English psalter would.
run_tool loci --document "$fourteenth" --profile "$traditional" \
	>"$sandbox/loci.txt"
grep -q "^profile: $traditional$" "$sandbox/loci.txt" ||
	fail "plain loci output does not identify its effective profile"
grep -q '^introit .*Ps\.83\.10 ' "$sandbox/loci.txt" ||
	fail "the Introit did not resolve to its Vulgate psalm loci"
grep -q '^gospel .*Matt\.6\.24 ' "$sandbox/loci.txt" ||
	fail "the Gospel did not resolve to Matthew loci"
# An element the missal composes carries no Scripture, and the line says so
# rather than being dropped: an absent row and a forgotten row look alike.
grep -q '^collect  *(no scripture)$' "$sandbox/loci.txt" ||
	fail "a composed element was dropped instead of reported"

# Byte-stable, because a gate reruns it and a record is compared against it.
run_tool loci --document "$fourteenth" --profile "$traditional" \
	>"$sandbox/loci-again.txt"
cmp -s "$sandbox/loci.txt" "$sandbox/loci-again.txt" ||
	fail "loci output is not byte-stable"

# The status is the corpus's, and the two psalms it dates nowhere must come
# back saying so. A tool that quietly returned nothing for them would let a
# consumer read absence as "not looked at".
grep -q '^gradual  *undated-in-tradition ' "$sandbox/loci.txt" ||
	fail "Ps. 117 did not come back undated-in-tradition"
grep -q '^offertory  *dated ' "$sandbox/loci.txt" ||
	fail "Ps. 33 did not come back dated"

# The record carries the stable ids section 14 requires a consumer to carry.
run_tool record --document "$fourteenth" --profile "$traditional" \
	>"$sandbox/record.toml"
for field in relation subject profile label locus; do
	grep -q "^$field = " "$sandbox/record.toml" ||
		fail "the record carries no $field field"
done
grep -q '^\[\[elements\.claims\.reaches\]\]$' "$sandbox/record.toml" ||
	fail "the audit record carries no per-locus reach provenance"
grep -q '^\[\[elements\.publication_claims\]\]$' "$sandbox/record.toml" ||
	fail "the audit record carries no one-cell publication intersection"
grep -q '^subject = "israel.monarchy.david-at-geth"$' "$sandbox/record.toml" ||
	fail "the record does not carry the event id the corpus answered with"
grep -q '^generated_by = ' "$sandbox/record.toml" ||
	fail "the record does not say what generated it"
# ...and a formulary the calendar does appoint says so, so the two states are
# distinguishable in the record itself and not only by counting elements.
grep -q '^formulary = "appointed"$' "$sandbox/record.toml" ||
	fail "the record does not state that the calendar appoints this formulary"

run_tool record --document "$fourteenth" --profile "$traditional" \
	>"$sandbox/record-again.toml"
cmp -s "$sandbox/record.toml" "$sandbox/record-again.toml" ||
	fail "the record is not byte-stable"

# The publication projection is separately deterministic. It groups every
# candidate by relation, carries both source and concise display labels in its
# JSON contract, and never lets a Gospel's event chronology disappear behind
# the book's composition chronology.
run_tool annotations --document "$fourteenth" --profile "$traditional" \
	--format json \
	>"$sandbox/annotations.json"
run_tool annotations --document "$fourteenth" --profile "$traditional" \
	--format json \
	>"$sandbox/annotations-again.json"
cmp -s "$sandbox/annotations.json" "$sandbox/annotations-again.json" ||
	fail "the annotation JSON is not byte-stable"
grep -q '"label":' "$sandbox/annotations.json" ||
	fail "the annotation JSON dropped the raw source label"
grep -q '"display_label":' "$sandbox/annotations.json" ||
	fail "the annotation JSON carries no concise display label"
grep -q '"relation":"narrated-event"' "$sandbox/annotations.json" ||
	fail "the Gospel annotation dropped its narrated-event relation"

# --write and --check, over a copied leaf so the tree is untouched.
copy="$sandbox/root"
mkdir -p "$copy/src/gpt/$collection/temporal"
cp -R "$repo/src/gpt/$fourteenth" "$copy/src/gpt/$collection/temporal/"
ln -s "$repo/src/sources" "$copy/src/sources"
rm -f "$copy/src/gpt/$fourteenth/research/chronology.toml"

reject record --root "$copy" --provider gpt --document "$fourteenth" \
	--profile "$publication" --check
run_tool record --root "$copy" --provider gpt --document "$fourteenth" \
	--profile "$publication" --write \
	>/dev/null || fail "--write refused a leaf it had just been asked to write"
run_tool record --root "$copy" --provider gpt --document "$fourteenth" \
	--profile "$publication" --check \
	>/dev/null || fail "--check refused the record --write had just written"

# A hand-edited record is the failure this whole wiring exists to catch: a
# date that looks exactly like the corpus's and is not.
sed 's/^label = "A. M. 2944, A. C. 1060"$/label = "1055-1015 B.C."/' \
	"$copy/src/gpt/$fourteenth/research/chronology.toml" \
	>"$sandbox/edited.toml"
if cmp -s "$sandbox/edited.toml" \
	"$copy/src/gpt/$fourteenth/research/chronology.toml"; then
	fail "the sed edit changed nothing, so the refusal below proves nothing"
fi
cp "$sandbox/edited.toml" "$copy/src/gpt/$fourteenth/research/chronology.toml"
reject record --root "$copy" --provider gpt --document "$fourteenth" \
	--profile "$publication" --check

# An identity no mass entry registers names no appointed Scripture, and this
# tool says so rather than returning an empty dossier that reads as "no dates".
reject loci --document "$collection/temporal/99-invented-sunday"
# ...and it may not send the reader to `check-proper-identity`, which
# deliberately ACCEPTS an `m` identity on its grammar and says why.
if run_tool loci --document "$collection/temporal/99-invented-sunday" 2>&1 |
	grep -q 'check-proper-identity'; then
	fail "the refusal claims an interlock check-proper-identity does not have"
fi
# A slug with no catalog identity in it names no formulary. The full leaf-id
# grammar is `check-proper-identity`'s, and the scope gate has already run it
# by the time anything here does; this only refuses what it cannot look up.
reject loci --document "$collection/temporal/fourteenth-after-pentecost"
# The provider boundary, which decides where --write may put a file.
reject record --provider ../etc --document "$fourteenth" --check
# Asking nothing is not a pass.
reject loci
reject
# An unknown flag is refused rather than ignored.
reject loci --badflag --document "$fourteenth"

echo ok
