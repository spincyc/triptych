#!/bin/sh
# Test for `tools/tpt citations`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="citations"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

# A multi-owner ledger is exact in both dimensions: one surviving breach must
# not keep a corrected sibling owner alive as a standing exception.
python3 - "$repo/tools/citations" <<'PY'
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

loader = SourceFileLoader("citations_partial_stale", sys.argv[1])
spec = spec_from_loader(loader.name, loader)
module = module_from_spec(spec)
sys.modules[spec.name] = module
loader.exec_module(module)
kept, excepted = module.apply_psalm_exceptions(
    ["mass/Introit/end: Psalm 9:39 exceeds hebrew Psalm 9"],
    {"Psalm 9:39": ("mass/Introit", "mass/Communion")},
)
if len(excepted) != 1 or not any(
    "Psalm 9:39 for mass/Communion" in problem and "no longer breaches" in problem
    for problem in kept
):
    raise SystemExit(f"partial stale exception was not rejected: {kept}, {excepted}")
PY

# Traversal is deliberately narrower than the calendar schema validator, but a
# malformed parent aggregate must still be inert here rather than turning the
# delegated citation pass into a traceback. Repeated names, on the other hand,
# are citation identity: qualify them in source order so an exception can name
# exactly one occurrence.
python3 - "$repo/tools/citations" <<'PY'
import sys
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader

loader = SourceFileLoader("citations_strict_shapes", sys.argv[1])
spec = spec_from_loader(loader.name, loader)
module = module_from_spec(spec)
sys.modules[spec.name] = module
loader.exec_module(module)

malformed = (
    {"sections": 7},
    {"sections": {"seasonal": {"masses": 7}}},
    {"sections": {"seasonal": {"masses": [{"key": "mass", "forms": 7}]}}},
    {
        "sections": {
            "seasonal": {"masses": [{"key": "mass", "propers": 7}]}
        }
    },
)
for document in malformed:
    if list(module.each_proper(document)):
        raise SystemExit(f"malformed aggregates yielded a Proper: {document!r}")

document = {
    "sections": {
        "seasonal": {
            "masses": [
                {
                    "key": "mass",
                    "propers": [
                        {"name": "Responsorial Psalm", "verses": []},
                        {"name": "Responsorial Psalm", "verses": []},
                    ],
                }
            ]
        }
    }
}
labels = [label for label, _ in module.each_proper(document)]
if labels != ["mass/Responsorial Psalm#1", "mass/Responsorial Psalm#2"]:
    raise SystemExit(f"repeated Proper names lack exact occurrences: {labels!r}")
kept, excepted = module.apply_psalm_exceptions(
    [
        "mass/Responsorial Psalm#1/end: Psalm 150:6 exceeds hebrew Psalm 150",
        "mass/Responsorial Psalm#2/end: Psalm 150:6 exceeds hebrew Psalm 150",
    ],
    {"Psalm 150:6": ("mass/Responsorial Psalm#2",)},
)
if (
    len(kept) != 1
    or "#1/end" not in kept[0]
    or len(excepted) != 1
    or "#2/end" not in excepted[0]
):
    raise SystemExit(f"occurrence-qualified exception was not exact: {kept}, {excepted}")

# A parenthetical may be part of the Proper's real name or an audit incipit.
# Resolve it against live owner paths before taking the legacy incipit away.
qualified = {"mass/Entrance Antiphon (alternative)"}
if module.exception_owners(
    "mass/Entrance Antiphon (alternative)", qualified
) != ("mass/Entrance Antiphon (alternative)",):
    raise SystemExit("a real parenthetical Proper qualifier was stripped")
if module.exception_owners(
    "mass/Entrance Antiphon (alternative) (Ecce)", qualified
) != ("mass/Entrance Antiphon (alternative)",):
    raise SystemExit("a legacy display incipit was not stripped")

# Presence, not truthiness, chooses an owner's numbering declaration. Otherwise
# an explicit malformed override quietly inherits a valid enclosing default.
proper = {"psalm_numbering": "", "verses": []}
if module.numbered_verse_lists(proper, "hebrew")[0][3] != "":
    raise SystemExit("a falsey proper numbering override inherited the default")
cycled = {
    "weekday_cycles": {"I": {"psalm_numbering": False, "verses": []}}
}
if module.numbered_verse_lists(cycled, "hebrew")[0][3] is not False:
    raise SystemExit("a falsey cycle numbering override inherited the default")

# Passage, range and exception tables are closed, and YAML booleans are not
# positive integers merely because Python's bool subclasses int.
problems = []
module.check_passage(
    "mass/Introit",
    {
        "book": "Psalms",
        "ranges": [
            {
                "begin": {"chapter": True, "verse": 1},
                "end": {"chapter": 1, "verse": False},
                "surprise": "range",
            }
        ],
        "surprise": "passage",
    },
    problems,
    "hebrew",
)
for wanted in (
    "passage has unknown keys ['surprise']",
    "range has unknown keys ['surprise']",
    "chapter must be a positive integer",
    "verse must be a positive integer",
):
    if not any(wanted in problem for problem in problems):
        raise SystemExit(f"closed passage validation missed {wanted!r}: {problems}")

problems = []
module.check_passage(
    "mass/Introit",
    {
        "book": [],
        "ranges": [
            {"begin": {"chapter": 1, "verse": 1}, "end": {"chapter": 1, "verse": 1}}
        ],
        "ref": "Psalm 1:1",
    },
    problems,
    "hebrew",
)
if not any("book is not a canonical name" in problem for problem in problems):
    raise SystemExit(f"an unhashable malformed book was not controlled: {problems}")

problems = []
module.psalm_exceptions(
    {
        "psalm_numbering_exceptions": [
            {
                "psalm": True,
                "divergence": "test",
                "loci": {"Psalm 1:999": "mass/Introit"},
                "surprise": "exception",
            }
        ]
    },
    problems,
)
if not any("entry has unknown keys ['surprise']" in problem for problem in problems):
    raise SystemExit(f"exception entry schema remained open: {problems}")
if not any("psalm must be the cited psalm's number" in problem for problem in problems):
    raise SystemExit(f"a boolean psalm number passed: {problems}")

try:
    module.parse_citation(7)
except module.CitationError:
    pass
else:
    raise SystemExit("a non-string citation did not raise CitationError")
PY

expect() {
	want="$1"
	shift
	got="$(run_tool parse "$1" --json)"
	case "$got" in
	*"$want"*) ;;
	*) echo "parse $1: expected $want in: $got" >&2; exit 1 ;;
	esac
}

reject() {
	if run_tool parse "$1" --json >/dev/null 2>&1; then
		echo "expected parse to reject: $1" >&2
		exit 1
	fi
}

# A plain verse range.
expect '"book":"Psalms"' "Psalm 24:1-3"
expect '"begin":{"chapter":24,"verse":1},"end":{"chapter":24,"verse":3}' "Psalm 24:1-3"
# The printed string survives as a side field.
expect '"ref":"Psalm 24:1-3"' "Psalm 24:1-3"

# A single verse becomes a one-verse range.
expect '"begin":{"chapter":3,"verse":16},"end":{"chapter":3,"verse":16}' "John 3:16"

# A chant sung entire is cited by chapter alone, and carries no verse.
expect '"begin":{"chapter":46},"end":{"chapter":46}' "Psalm 46"

# A range may cross a chapter boundary.
expect '"begin":{"chapter":18,"verse":1},"end":{"chapter":19,"verse":42}' "John 18:1-19:42"

# A selection within one chapter yields several ranges, chapter inherited.
expect '{"begin":{"chapter":22,"verse":8},"end":{"chapter":22,"verse":9}},{"begin":{"chapter":22,"verse":17},"end":{"chapter":22,"verse":20}}' "Psalm 22:8-9, 17-20"

# A semicolon introduces a new chapter block.
expect '{"begin":{"chapter":14,"verse":24},"end":{"chapter":14,"verse":31}},{"begin":{"chapter":15,"verse":1},"end":{"chapter":15,"verse":1}}' "Exodus 14:24-31; 15:1"

# A comma-separated range may itself cross a chapter.
expect '{"begin":{"chapter":3,"verse":32},"end":{"chapter":4,"verse":4}}' "Baruch 3:9-15, 32-4:4"

# Printed part-verse letters are preserved.
expect '"end":{"chapter":50,"part":"a","verse":9}' "Isaiah 50:4-9a"
expect '"begin":{"chapter":6,"part":"c","verse":63}' "John 6:63c"

# An alias resolves to the canonical name; the ref keeps what was printed.
expect '"book":"Sirach"' "Ecclesiasticus 15:16-21"
expect '"ref":"Ecclesiasticus 15:16-21"' "Ecclesiasticus 15:16-21"
expect '"book":"Revelation"' "Apocalypse 21:23"
expect '"book":"Psalms"' "Ps 24:1"

# A one-chapter book is cited by verse alone and resolves into chapter 1.
expect '"begin":{"chapter":1,"verse":9},"end":{"chapter":1,"verse":10}' "Philemon 9-10, 12-17"
expect '"begin":{"chapter":1,"verse":17},"end":{"chapter":1,"verse":17}' "Jude 17, 20-25"

# 4 Esdras is outside the canon but cited by the Roman books themselves.
expect '"book":"4 Esdras"' "4 Esdras 2:36-37"

# Malformed citations are refused rather than guessed at.
reject "Psalm"
reject "24:1-3"
reject "Nonesuch 1:1"
reject "Psalm 24:3-1"
reject "Psalm 24:1-2-3"
reject " Psalm 24:1"

# encode is idempotent and check accepts what encode produces.
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"
mkdir -p calendars/test

# `verses` is the content aggregate this tool owns. A bad scalar is reported in
# the normal payload; it must not explode while the calendar checker delegates.
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
psalm_numbering: vulgate
sections:
 seasonal:
  masses:
  - key: test-sunday
    propers:
    - name: Introit
      verses: 7
YAML
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to reject a scalar verses aggregate" >&2
	exit 1
fi
case "$out" in
*"verses must be a nonempty list"*) ;;
*) echo "expected a controlled verses-shape problem, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*"Traceback"*) echo "malformed verses must not crash citations: $out" >&2; exit 1 ;;
*) ;;
esac

cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
sections: [
YAML
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to reject malformed YAML" >&2
	exit 1
fi
case "$out" in
*"unreadable"*) ;;
*) echo "expected a controlled YAML parse problem, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*"Traceback"*) echo "malformed YAML must not crash citations: $out" >&2; exit 1 ;;
*) ;;
esac

cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1-3", "Psalm 46"]
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
          B: {verses: ["Philemon 9-10"]}
      - name: Ferial Reading
        source: scripture
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
          'II': {verses: ["Jeremiah 13:1-11"]}
YAML

run_tool encode --root calendars >/dev/null
run_tool check --root calendars >/dev/null

first="$(cat calendars/test/sundays.yaml)"
run_tool encode --root calendars >/dev/null
second="$(cat calendars/test/sundays.yaml)"
if [ "$first" != "$second" ]; then
	echo "encode is not idempotent" >&2
	exit 1
fi

# The encoded form reports no bare strings left, and counts the passages. Six,
# not four: the two courses a proper may read on are both walked, so a weekday
# reading is encoded and counted like any other. A course this tool did not walk
# would leave its citations bare -- and `check` refuses a bare string, which is
# how the second course proves it was reached rather than skipped.
out="$(run_tool check --root calendars --json)"
case "$out" in
*'"status":"ok"'*) ;;
*) echo "expected ok after encode, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*'"passages":6'*) ;;
*) echo "expected 6 passages, got: $out" >&2; exit 1 ;;
esac

# check rejects a bare string that was never encoded.
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1-3"]
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject an unencoded citation string" >&2
	exit 1
fi

# check rejects a non-canonical book name and a descending range.
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
          - book: Psalm
            ranges:
              - begin: {chapter: 24, verse: 1}
                end: {chapter: 24, verse: 3}
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject a non-canonical book name" >&2
	exit 1
fi

cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
          - book: Psalms
            ranges:
              - begin: {chapter: 24, verse: 5}
                end: {chapter: 24, verse: 2}
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject a descending range" >&2
	exit 1
fi

# `ref` is a side field and the ranges are the truth, so nothing made the two
# agree: a page could print one reference and fetch another. `check` now
# re-derives the passage from its own `ref` through `parse_citation`, and what
# it compares is the parsed structure, never the strings.
passage() {
	cat >calendars/test/sundays.yaml <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
$1
YAML
}

# An edition spells a book however it prints it, and the ranges are what must
# match. Every one of these is a legitimate display string for the passage
# beside it, and none of them is a divergence.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Ps 24:1-3"
          - book: Song of Songs
            ranges: [{begin: {chapter: 2, verse: 1}, end: {chapter: 2, verse: 1}}]
            ref: "Cant 2:1"
          - book: Song of Songs
            ranges: [{begin: {chapter: 2, verse: 1}, end: {chapter: 2, verse: 1}}]
            ref: "Canticle of Canticles 2:1"
          - book: Psalms
            ranges: [{begin: {chapter: 46}, end: {chapter: 46}}]
            ref: "Psalm 46"
          - book: Isaiah
            ranges: [{begin: {chapter: 50, verse: 4}, end: {chapter: 50, part: a, verse: 9}}]
            ref: "Isaiah 50:4-9a"
          - book: Exodus
            ranges:
            - {begin: {chapter: 14, verse: 24}, end: {chapter: 14, verse: 31}}
            - {begin: {chapter: 15, verse: 1}, end: {chapter: 15, verse: 1}}
            ref: "Exodus 14:24-31; 15:1"
          - book: Philemon
            ranges: [{begin: {chapter: 1, verse: 9}, end: {chapter: 1, verse: 10}}]
            ref: "Philemon 9-10"'
if ! out="$(run_tool check --root calendars 2>&1)"; then
	echo "a ref spelled differently from its canonical parse must pass: $out" >&2
	exit 1
fi

# Ranges moved to another psalm while the printed reference stays put. This is
# the defect the check exists for, and the complaint names both readings and
# rules on neither: which is right is a question about the missal.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 30, verse: 2}, end: {chapter: 30, verse: 4}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse ranges that disagree with their ref" >&2
	exit 1
fi
case "$out" in
*"derives 24:1-24:3"*"stores 30:2-30:4"*) ;;
*) echo "expected both readings in the complaint, got: $out" >&2; exit 1 ;;
esac

# A dropped selection, and a dropped part-verse letter: neither changes a
# number the eye compares, and both change what is fetched.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 22, verse: 8}, end: {chapter: 22, verse: 9}}]
            ref: "Psalm 22:8-9, 17-20"'
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to refuse a ref carrying a selection the ranges drop" >&2
	exit 1
fi
passage '          - book: Isaiah
            ranges: [{begin: {chapter: 50, verse: 4}, end: {chapter: 50, verse: 9}}]
            ref: "Isaiah 50:4-9a"'
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to refuse a ref whose part letter the ranges drop" >&2
	exit 1
fi

# The book is compared after alias resolution, so this is a real disagreement
# and not a spelling: the ref names one book and the passage stores another.
passage '          - book: Isaiah
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a ref naming a different book" >&2
	exit 1
fi
case "$out" in
*"names book 'Psalms'"*"stores 'Isaiah'"*) ;;
*) echo "expected the diverging book named both ways, got: $out" >&2; exit 1 ;;
esac

# A ref this parser cannot read is its own outcome, reported under its own
# wording: nothing was derived, so there is nothing to disagree with, and
# passing it would reopen the hole the check closes.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Psalm 24 verses one to three"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a ref it cannot re-derive" >&2
	exit 1
fi
case "$out" in
*"cannot be re-derived"*) ;;
*) echo "expected the unparseable ref reported as such, got: $out" >&2; exit 1 ;;
esac

# A malformed range owns its own complaint: re-deriving against it would bury
# the defect under the disagreement it necessarily produces.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 5}, end: {chapter: 24, verse: 2}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a descending range" >&2
	exit 1
fi
case "$out" in
*"derives"*) echo "a malformed range must not also raise a ref disagreement: $out" >&2; exit 1 ;;
*) ;;
esac

# A verse beyond its own system's psalm is a numbering leak: Hebrew Psalm 9
# ends at verse 21 where the Vulgate runs to 39.
mkdir -p leak/heb
{
	sed 's/^psalm_numbering: vulgate$/psalm_numbering: hebrew/' <<'HDR'
schema: triptych-calendar-masses/v1
edition: test
calendar: heb
series: test
ordering: test
registry: test
psalm_numbering: vulgate
citation_convention: test
orthography: test
verification: unverified test fixture
HDR
	cat <<'YAML'
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: t
    name: T
    registry: "t1"
    season: advent
    propers:
    - name: Introit
      source: scripture
      verses:
      - book: Psalms
        ranges:
        - begin: {chapter: 9, verse: 39}
          end: {chapter: 9, verse: 39}
        ref: 'Psalm 9:39'
YAML
} >leak/heb/propers.yaml
if run_tool check --root leak >/dev/null 2>&1; then
	echo "expected a hebrew calendar citing Psalm 9:39 to fail" >&2
	exit 1
fi
if ! run_tool check --root leak 2>&1 | grep -q 'ends at verse 21'; then
	echo "expected the psalm bound to be named" >&2
	exit 1
fi

# The calendar declaration is a default: a proper may identify the numbering
# its own printed citation uses, and the checker must validate under that
# effective system just as the reader does.
python3 - <<'PY'
from pathlib import Path

path = Path("leak/heb/propers.yaml")
text = path.read_text()
text = text.replace(
    "    - name: Introit\n      source: scripture\n",
    "    - name: Introit\n      source: scripture\n      psalm_numbering: vulgate\n",
)
path.write_text(text)
PY
if ! run_tool check --root leak >/dev/null 2>&1; then
	echo "Psalm 9:39 is valid under a proper's vulgate numbering" >&2
	exit 1
fi

# A reading course may refine the proper's numbering once more. This fixture
# proves the validator walks that owner under its own declaration rather than
# applying either enclosing default to it.
mkdir -p cycle-numbering/heb
python3 - <<'PY'
from pathlib import Path
import yaml

source = Path("leak/heb/propers.yaml")
target = Path("cycle-numbering/heb/propers.yaml")
document = yaml.safe_load(source.read_text())
proper = document["sections"]["seasonal"]["masses"][0]["propers"][0]
verses = proper.pop("verses")
proper.pop("psalm_numbering")
proper["weekday_cycles"] = {
    "I": {"psalm_numbering": "vulgate", "verses": verses}
}
target.write_text(yaml.safe_dump(document, sort_keys=False))
PY
if ! run_tool check --root cycle-numbering >/dev/null 2>&1; then
	echo "Psalm 9:39 is valid under a cycle's vulgate numbering" >&2
	exit 1
fi
rm -rf cycle-numbering

# A ledgered bound remains visible in `excepted` but does not make the
# standalone citation check red. The exception is exact: another bad verse in
# the same psalm remains a genuine failure rather than hiding behind it.
python3 - <<'PY'
from pathlib import Path

path = Path("leak/heb/propers.yaml")
text = path.read_text().replace("      psalm_numbering: vulgate\n", "")
text = text.replace(
    "sections:\n",
    "psalm_numbering_exceptions:\n"
    "- psalm: 9\n"
    "  divergence: The fixture deliberately records this one open locus.\n"
    "  loci:\n"
    "    'Psalm 9:39': t/Introit\n"
    "sections:\n",
)
path.write_text(text)
PY
out="$(run_tool check --root leak --json)"
case "$out" in
*'"status":"ok"'*) ;;
*) echo "expected an exact ledgered locus to pass: $out" >&2; exit 1 ;;
esac
case "$out" in
*'"excepted":['*'Psalm 9:39'*) ;;
*) echo "expected an exact ledgered locus to be reported but pass: $out" >&2; exit 1 ;;
esac

# The owner is as exact as the locus. A second Proper citing the same verse is
# not covered by an exception naming only the Introit.
python3 - <<'PY'
from pathlib import Path

path = Path("leak/heb/propers.yaml")
text = path.read_text()
needle = "        ref: 'Psalm 9:39'\n"
addition = """    - name: Communion
      source: scripture
      verses:
      - book: Psalms
        ranges:
        - begin: {chapter: 9, verse: 39}
          end: {chapter: 9, verse: 39}
        ref: 'Psalm 9:39'
"""
text = text.replace(needle, needle + addition, 1)
path.write_text(text)
PY
if out="$(run_tool check --root leak 2>&1)"; then
	echo "an Introit exception must not excuse the Communion's Psalm 9:39" >&2
	exit 1
fi
case "$out" in
*'t/Communion'*'Psalm 9:39'*) ;;
*) echo "expected the unlisted Proper and locus in the failure: $out" >&2; exit 1 ;;
esac

python3 - <<'PY'
from pathlib import Path

path = Path("leak/heb/propers.yaml")
text = path.read_text().replace("verse: 39", "verse: 38").replace(
    "ref: 'Psalm 9:39'", "ref: 'Psalm 9:38'"
)
path.write_text(text)
PY
if run_tool check --root leak >/dev/null 2>&1; then
	echo "an exception for Psalm 9:39 must not excuse Psalm 9:38" >&2
	exit 1
fi

# The standalone citation gate owns this ledger, so it must also reject an
# entry after every named owner has been corrected.  Moving the citation to a
# valid locus leaves Psalm 9:39 wholly stale instead of merely unlisted.
python3 - <<'PY'
from pathlib import Path

path = Path("leak/heb/propers.yaml")
text = path.read_text().replace("verse: 38", "verse: 1").replace(
    "ref: 'Psalm 9:38'", "ref: 'Psalm 9:1'"
)
path.write_text(text)
PY
if out="$(run_tool check --root leak 2>&1)"; then
	echo "a stale psalm-numbering exception must fail citations check" >&2
	exit 1
fi
case "$out" in
*'psalm_numbering_exceptions lists Psalm 9:39'*'no longer breaches'*) ;;
*) echo "expected the stale ledger owner and locus, got: $out" >&2; exit 1 ;;
esac
rm -rf leak

# An empty root is an error, not a silent pass.
mkdir -p empty-root
if run_tool check --root empty-root >/dev/null 2>&1; then
	echo "expected failure for a root with no index" >&2
	exit 1
fi

echo ok
