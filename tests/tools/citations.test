#!/bin/sh
# Test for `tools/tpt citations`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="citations"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

expect() {
	want="$1"
	shift
	got="$(run_tool parse "$1" --json)"
	case "$got" in
	*"$want"*) ;;
	*) echo "parse $1: expected $want in: $got" >&2; exit 1 ;;
	esac
}

reject() {
	if run_tool parse "$1" --json >/dev/null 2>&1; then
		echo "expected parse to reject: $1" >&2
		exit 1
	fi
}

# A plain verse range.
expect '"book":"Psalms"' "Psalm 24:1-3"
expect '"begin":{"chapter":24,"verse":1},"end":{"chapter":24,"verse":3}' "Psalm 24:1-3"
# The printed string survives as a side field.
expect '"ref":"Psalm 24:1-3"' "Psalm 24:1-3"

# A single verse becomes a one-verse range.
expect '"begin":{"chapter":3,"verse":16},"end":{"chapter":3,"verse":16}' "John 3:16"

# A chant sung entire is cited by chapter alone, and carries no verse.
expect '"begin":{"chapter":46},"end":{"chapter":46}' "Psalm 46"

# A range may cross a chapter boundary.
expect '"begin":{"chapter":18,"verse":1},"end":{"chapter":19,"verse":42}' "John 18:1-19:42"

# A selection within one chapter yields several ranges, chapter inherited.
expect '{"begin":{"chapter":22,"verse":8},"end":{"chapter":22,"verse":9}},{"begin":{"chapter":22,"verse":17},"end":{"chapter":22,"verse":20}}' "Psalm 22:8-9, 17-20"

# A semicolon introduces a new chapter block.
expect '{"begin":{"chapter":14,"verse":24},"end":{"chapter":14,"verse":31}},{"begin":{"chapter":15,"verse":1},"end":{"chapter":15,"verse":1}}' "Exodus 14:24-31; 15:1"

# A comma-separated range may itself cross a chapter.
expect '{"begin":{"chapter":3,"verse":32},"end":{"chapter":4,"verse":4}}' "Baruch 3:9-15, 32-4:4"

# Printed part-verse letters are preserved.
expect '"end":{"chapter":50,"part":"a","verse":9}' "Isaiah 50:4-9a"
expect '"begin":{"chapter":6,"part":"c","verse":63}' "John 6:63c"

# An alias resolves to the canonical name; the ref keeps what was printed.
expect '"book":"Sirach"' "Ecclesiasticus 15:16-21"
expect '"ref":"Ecclesiasticus 15:16-21"' "Ecclesiasticus 15:16-21"
expect '"book":"Revelation"' "Apocalypse 21:23"
expect '"book":"Psalms"' "Ps 24:1"

# A one-chapter book is cited by verse alone and resolves into chapter 1.
expect '"begin":{"chapter":1,"verse":9},"end":{"chapter":1,"verse":10}' "Philemon 9-10, 12-17"
expect '"begin":{"chapter":1,"verse":17},"end":{"chapter":1,"verse":17}' "Jude 17, 20-25"

# 4 Esdras is outside the canon but cited by the Roman books themselves.
expect '"book":"4 Esdras"' "4 Esdras 2:36-37"

# Malformed citations are refused rather than guessed at.
reject "Psalm"
reject "24:1-3"
reject "Nonesuch 1:1"
reject "Psalm 24:3-1"
reject "Psalm 24:1-2-3"
reject " Psalm 24:1"

# encode is idempotent and check accepts what encode produces.
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"
mkdir -p calendars/test
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1-3", "Psalm 46"]
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
          B: {verses: ["Philemon 9-10"]}
YAML

run_tool encode --root calendars >/dev/null
run_tool check --root calendars >/dev/null

first="$(cat calendars/test/sundays.yaml)"
run_tool encode --root calendars >/dev/null
second="$(cat calendars/test/sundays.yaml)"
if [ "$first" != "$second" ]; then
	echo "encode is not idempotent" >&2
	exit 1
fi

# The encoded form reports no bare strings left, and counts the passages.
out="$(run_tool check --root calendars --json)"
case "$out" in
*'"status":"ok"'*) ;;
*) echo "expected ok after encode, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*'"passages":4'*) ;;
*) echo "expected 4 passages, got: $out" >&2; exit 1 ;;
esac

# check rejects a bare string that was never encoded.
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1-3"]
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject an unencoded citation string" >&2
	exit 1
fi

# check rejects a non-canonical book name and a descending range.
cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
          - book: Psalm
            ranges:
              - begin: {chapter: 24, verse: 1}
                end: {chapter: 24, verse: 3}
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject a non-canonical book name" >&2
	exit 1
fi

cat >calendars/test/sundays.yaml <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
          - book: Psalms
            ranges:
              - begin: {chapter: 24, verse: 5}
                end: {chapter: 24, verse: 2}
YAML
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to reject a descending range" >&2
	exit 1
fi

# `ref` is a side field and the ranges are the truth, so nothing made the two
# agree: a page could print one reference and fetch another. `check` now
# re-derives the passage from its own `ref` through `parse_citation`, and what
# it compares is the parsed structure, never the strings.
passage() {
	cat >calendars/test/sundays.yaml <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses:
$1
YAML
}

# An edition spells a book however it prints it, and the ranges are what must
# match. Every one of these is a legitimate display string for the passage
# beside it, and none of them is a divergence.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Ps 24:1-3"
          - book: Song of Songs
            ranges: [{begin: {chapter: 2, verse: 1}, end: {chapter: 2, verse: 1}}]
            ref: "Cant 2:1"
          - book: Song of Songs
            ranges: [{begin: {chapter: 2, verse: 1}, end: {chapter: 2, verse: 1}}]
            ref: "Canticle of Canticles 2:1"
          - book: Psalms
            ranges: [{begin: {chapter: 46}, end: {chapter: 46}}]
            ref: "Psalm 46"
          - book: Isaiah
            ranges: [{begin: {chapter: 50, verse: 4}, end: {chapter: 50, part: a, verse: 9}}]
            ref: "Isaiah 50:4-9a"
          - book: Exodus
            ranges:
            - {begin: {chapter: 14, verse: 24}, end: {chapter: 14, verse: 31}}
            - {begin: {chapter: 15, verse: 1}, end: {chapter: 15, verse: 1}}
            ref: "Exodus 14:24-31; 15:1"
          - book: Philemon
            ranges: [{begin: {chapter: 1, verse: 9}, end: {chapter: 1, verse: 10}}]
            ref: "Philemon 9-10"'
if ! out="$(run_tool check --root calendars 2>&1)"; then
	echo "a ref spelled differently from its canonical parse must pass: $out" >&2
	exit 1
fi

# Ranges moved to another psalm while the printed reference stays put. This is
# the defect the check exists for, and the complaint names both readings and
# rules on neither: which is right is a question about the missal.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 30, verse: 2}, end: {chapter: 30, verse: 4}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse ranges that disagree with their ref" >&2
	exit 1
fi
case "$out" in
*"derives 24:1-24:3"*"stores 30:2-30:4"*) ;;
*) echo "expected both readings in the complaint, got: $out" >&2; exit 1 ;;
esac

# A dropped selection, and a dropped part-verse letter: neither changes a
# number the eye compares, and both change what is fetched.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 22, verse: 8}, end: {chapter: 22, verse: 9}}]
            ref: "Psalm 22:8-9, 17-20"'
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to refuse a ref carrying a selection the ranges drop" >&2
	exit 1
fi
passage '          - book: Isaiah
            ranges: [{begin: {chapter: 50, verse: 4}, end: {chapter: 50, verse: 9}}]
            ref: "Isaiah 50:4-9a"'
if run_tool check --root calendars >/dev/null 2>&1; then
	echo "expected check to refuse a ref whose part letter the ranges drop" >&2
	exit 1
fi

# The book is compared after alias resolution, so this is a real disagreement
# and not a spelling: the ref names one book and the passage stores another.
passage '          - book: Isaiah
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a ref naming a different book" >&2
	exit 1
fi
case "$out" in
*"names book 'Psalms'"*"stores 'Isaiah'"*) ;;
*) echo "expected the diverging book named both ways, got: $out" >&2; exit 1 ;;
esac

# A ref this parser cannot read is its own outcome, reported under its own
# wording: nothing was derived, so there is nothing to disagree with, and
# passing it would reopen the hole the check closes.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 1}, end: {chapter: 24, verse: 3}}]
            ref: "Psalm 24 verses one to three"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a ref it cannot re-derive" >&2
	exit 1
fi
case "$out" in
*"cannot be re-derived"*) ;;
*) echo "expected the unparseable ref reported as such, got: $out" >&2; exit 1 ;;
esac

# A malformed range owns its own complaint: re-deriving against it would bury
# the defect under the disagreement it necessarily produces.
passage '          - book: Psalms
            ranges: [{begin: {chapter: 24, verse: 5}, end: {chapter: 24, verse: 2}}]
            ref: "Psalm 24:1-3"'
if out="$(run_tool check --root calendars 2>&1)"; then
	echo "expected check to refuse a descending range" >&2
	exit 1
fi
case "$out" in
*"derives"*) echo "a malformed range must not also raise a ref disagreement: $out" >&2; exit 1 ;;
*) ;;
esac

# A verse beyond its own system's psalm is a numbering leak: Hebrew Psalm 9
# ends at verse 21 where the Vulgate runs to 39.
mkdir -p leak/heb
{
	sed 's/^psalm_numbering: vulgate$/psalm_numbering: hebrew/' <<'HDR'
schema: triptych-calendar-masses/v1
edition: test
calendar: heb
series: test
ordering: test
registry: test
psalm_numbering: vulgate
citation_convention: test
orthography: test
verification: unverified test fixture
HDR
	cat <<'YAML'
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: t
    name: T
    registry: "t1"
    season: advent
    propers:
    - name: Introit
      source: scripture
      verses:
      - book: Psalms
        ranges:
        - begin: {chapter: 9, verse: 39}
          end: {chapter: 9, verse: 39}
        ref: 'Psalm 9:39'
YAML
} >leak/heb/propers.yaml
if run_tool check --root leak >/dev/null 2>&1; then
	echo "expected a hebrew calendar citing Psalm 9:39 to fail" >&2
	exit 1
fi
if ! run_tool check --root leak 2>&1 | grep -q 'ends at verse 21'; then
	echo "expected the psalm bound to be named" >&2
	exit 1
fi
sed -i 's/^psalm_numbering: hebrew$/psalm_numbering: vulgate/' leak/heb/propers.yaml
if ! run_tool check --root leak >/dev/null 2>&1; then
	echo "Psalm 9:39 is valid under vulgate numbering" >&2
	exit 1
fi
rm -rf leak

# An empty root is an error, not a silent pass.
mkdir -p empty-root
if run_tool check --root empty-root >/dev/null 2>&1; then
	echo "expected failure for a root with no index" >&2
	exit 1
fi

echo ok
