#!/bin/sh
# Test for `tools/tpt check-calendar-masses`: exit 0 = pass (the stable gate).
set -eu

# Resolved tool roots: keeps working after a cd into a sandbox.
tools="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)/tools"
tpt="$tools/tpt"
tool="check-calendar-masses"

# Fixtures are written with printed citations, then encoded by the sibling
# tool that owns them, so the checker sees the same shape the indexes hold.
encode() {
	"$tpt" citations encode --root src/sources/calendars >/dev/null 2>&1 || true
}

# --help always works.
"$tpt" "$tool" --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

header() {
	cat <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
YAML
}

mkdir -p src/sources/calendars/test

# Valid index: a scripture proper, a composed proper, and a cycle proper.
{
	header
	cat <<'YAML'
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        incipit: Ad te levavi
        source: scripture
        verses: ["Psalm 24:1-3"]
      - name: Collect
        incipit: Excita
        source: composed
        text: |
          Excita, quaesumus, Domine.
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
          B: {verses: ["Jeremiah 33:14-16"]}
          C: {verses: ["Micah 5:1-4"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode

"$tpt" "$tool" --root src/sources/calendars >/dev/null
"$tpt" "$tool" --root src/sources/calendars --calendar test >/dev/null

# --json reports ok and counts every proper.
out="$("$tpt" "$tool" --root src/sources/calendars --json)"
case "$out" in
*'"status":"ok"'*) ;;
*) echo "expected ok status, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*'"propers":3'*) ;;
*) echo "expected 3 propers, got: $out" >&2; exit 1 ;;
esac

# A cycle-varying proper may declare its source per cycle instead of once.
{
	header
	cat <<'YAML'
  - key: mixed-kind-cycles
    name: Mixed Kind Cycles
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A:
            source: composed
            text: |
              Semen est verbum Dei.
          B: {source: scripture, verses: ["Luke 4:18"]}
          C: {source: scripture, verses: ["Luke 7:16"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# A cycle with neither its own source nor one on the proper is rejected.
{
	header
	cat <<'YAML'
  - key: sourceless-cycle
    name: Sourceless Cycle
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A: {verses: ["Luke 4:18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a cycle with no source" >&2
	exit 1
fi

# A composed cycle without text is rejected.
{
	header
	cat <<'YAML'
  - key: textless-cycle
    name: Textless Cycle
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A: {source: composed, verses: ["Luke 4:18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a composed cycle without text" >&2
	exit 1
fi

# --- the weekday course --------------------------------------------------
# The reformed Lectionary reads Sundays on a three-year course lettered A/B/C
# and the weekdays of Ordinary Time on a two-year course numbered I/II. They are
# two cycles, not one, and `weekday_cycles` is the second key.
#
# The fixture declares `calendar: postconciliar`, which is where a calendar
# states its identity, while staying in the `test` directory: a directory named
# for a real calendar would drag that calendar's spine and sidecar in, and this
# is a test about one key.
weekday() { # $1 = calendar, $2 = the placement line(s); propers on stdin
	rm -rf src/sources/calendars/test
	mkdir -p src/sources/calendars/test
	{
		cat <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: $1
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: ot-17-monday
    name: Monday of the Seventeenth Week in Ordinary Time
    registry: "pc-T-ot-17-monday"
    $2
    propers:
YAML
		cat
	} >src/sources/calendars/test/propers.yaml
	encode
}

# A ferial reading course keyed I/II, on a postconciliar Ordinary Time weekday,
# is accepted -- and `encode` reaches inside it, so the citations are encoded
# rather than left as the bare strings `citations check` refuses.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
          'II': {verses: ["Jeremiah 13:1-11"]}
      - name: Gospel
        source: scripture
        verses: ["Matthew 13:31-35"]
YAML
if ! out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "a weekday-cycle proper of an Ordinary Time weekday should validate: $out" >&2
	exit 1
fi
if grep -q 'weekday_cycles:$' src/sources/calendars/test/propers.yaml &&
	grep -q 'Exodus 32:15-24' src/sources/calendars/test/propers.yaml &&
	! grep -q 'ranges:' src/sources/calendars/test/propers.yaml; then
	echo "encode did not reach the readings inside weekday_cycles" >&2
	exit 1
fi

# The two courses are not one key wearing two names. A letter is not a weekday
# cycle and a numeral is not a Sunday cycle, and each mapping is held to its own
# keys: the whole point of the second key is that neither can pass as the other.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        weekday_cycles:
          A: {verses: ["Exodus 32:15-24"]}
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a Sunday cycle letter under weekday_cycles" >&2
	exit 1
fi
case "$out" in
*"unknown weekday cycle key 'A'"*) ;;
*) echo "expected the letter to be refused by name, got: $out" >&2; exit 1 ;;
esac

weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        cycles:
          'I': {verses: ["Exodus 32:15-24"]}
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a weekday cycle numeral under cycles" >&2
	exit 1
fi
case "$out" in
*"unknown cycle key 'I'"*) ;;
*) echo "expected the numeral to be refused by name, got: $out" >&2; exit 1 ;;
esac

# One proper reads on one course; carrying both says a slot varies by the Sunday
# year AND by the weekday year, which no day of either Missal does.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a proper carrying both reading courses" >&2
	exit 1
fi
case "$out" in
*"one proper reads on one of them"*) ;;
*) echo "expected the two courses to be named in the refusal, got: $out" >&2; exit 1 ;;
esac

# The inner contract is the Sunday course's: a scripture cycle carries verses, a
# composed one carries text, and a cycle declaring no source falls back to the
# proper's or is refused.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a weekday cycle with no source anywhere" >&2
	exit 1
fi

weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        weekday_cycles:
          'I': {text: "not a reading"}
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a scripture weekday cycle with no verses" >&2
	exit 1
fi
case "$out" in
*"scripture weekday cycle has no verses"*) ;;
*) echo "expected the empty scripture cycle to be named, got: $out" >&2; exit 1 ;;
esac

# A course varying in kind between its years may say so per cycle, exactly as
# the Sunday course may.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: Gospel Acclamation
        weekday_cycles:
          'I': {source: composed, text: "Semen est verbum Dei.\n"}
          'II': {source: scripture, verses: ["Luke 4:18"]}
YAML
if ! out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "a weekday course may differ in kind between its years: $out" >&2
	exit 1
fi

# The readings are inside the mapping, so the proper may not also print its own.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        verses: ["Exodus 32:15-24"]
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
          'II': {verses: ["Jeremiah 13:1-11"]}
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for weekday_cycles beside top-level verses" >&2
	exit 1
fi
case "$out" in
*"weekday_cycles excludes top-level verses and text"*) ;;
*) echo "expected the top-level readings to be refused, got: $out" >&2; exit 1 ;;
esac

# A proper that says where its text is printed carries none of its own, and a
# reading course is text: it would be a second copy of a course already written
# somewhere else, free to disagree with it.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        takes_from: {mass: ot-17-monday, proper: Gospel}
        weekday_cycles:
          'I': {source: scripture, verses: ["Exodus 32:15-24"]}
      - name: Gospel
        source: scripture
        verses: ["Matthew 13:31-35"]
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for weekday_cycles beside takes_from" >&2
	exit 1
fi
case "$out" in
*"must not also carry weekday_cycles"*) ;;
*) echo "expected the reference to refuse the course, got: $out" >&2; exit 1 ;;
esac

# Only the reformed Lectionary has a two-year weekday course at all. A cycle
# numeral does not travel between calendars: invariant 4 of
# guidance/propers-for-agents.md forbids an I or II in a 1962 record outright.
for calendar in roman-1962 roman-pre-1955 test; do
	weekday "$calendar" "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
          'II': {verses: ["Jeremiah 13:1-11"]}
YAML
	if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
		echo "expected failure for weekday_cycles in calendar $calendar" >&2
		exit 1
	fi
	case "$out" in
	*"does not keep one"*) ;;
	*) echo "expected the calendar to be named in the refusal, got: $out" >&2; exit 1 ;;
	esac
done

# And within that calendar the course runs on the ferias of Ordinary Time, the
# one kind of day the Missal prints no formulary for. A season that reads its
# own annual course, and a mass placed by date with no season at all, are both
# refused: a I/II numeral there is a category error, not a fact.
for placement in "season: lent" "season: advent" \
	'date: "08-15"
    rank: I
    kind: marian'; do
	weekday postconciliar "$placement" <<'YAML'
      - name: First Reading
        source: scripture
        weekday_cycles:
          'I': {verses: ["Exodus 32:15-24"]}
          'II': {verses: ["Jeremiah 13:1-11"]}
YAML
	if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
		echo "expected failure for weekday_cycles on $placement" >&2
		exit 1
	fi
	case "$out" in
	*"category error"*) ;;
	*) echo "expected the season refusal, got: $out" >&2; exit 1 ;;
	esac
done

# The Sunday course is untouched by all of this: A/B/C still validates in the
# same file, and is still counted as one proper.
weekday postconciliar "season: ordinary-time" <<'YAML'
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
          B: {verses: ["Jeremiah 33:14-16"]}
          C: {verses: ["Micah 5:1-4"]}
YAML
out="$("$tpt" "$tool" --root src/sources/calendars --json)"
case "$out" in
*'"status":"ok"'*'"propers":1'*|*'"propers":1'*'"status":"ok"'*) ;;
*) echo "the Sunday course must still validate and count once, got: $out" >&2; exit 1 ;;
esac

# Back to the ordinary fixture header for what follows.
rm -rf src/sources/calendars/test
mkdir -p src/sources/calendars/test

# A scripture proper carrying text is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: "02"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1"]
        text: |
          should not be here
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for scripture proper carrying text" >&2
	exit 1
fi

# A composed proper without text is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: "02"
    season: test
    propers:
      - {name: Collect, source: composed}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for composed proper without text" >&2
	exit 1
fi

# An unquoted registry number is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: 2
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for unquoted registry value" >&2
	exit 1
fi

# A name that folds a commemoration into another celebration is rejected: the
# commemoration is a second celebration, and inside a name it can be neither
# looked up nor reached as the oration it is.
for folded in \
	"S. Hilarii Episcopi et Confessoris; comm. S. Felicis Presbyteri et Martyris" \
	"In Nativitate Domini, with octave; at the second Mass, comm. S. Anastasiae Martyris"; do
	{
		header
		cat <<YAML
  - key: folded
    name: "$folded"
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
	} >src/sources/calendars/test/propers.yaml
	encode
	if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
		echo "expected failure for a name folding a commemoration in: $folded" >&2
		exit 1
	fi
done

# An entry that *is* the commemoration says so from its first character, and
# a title carrying the unabbreviated word is a title, not a fold. Neither is
# refused, or the shape the fix moves these into would be unwritable.
{
	header
	cat <<'YAML'
  - key: own-commemoration
    name: Comm. S. Felicis Presbyteri et Martyris
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
  - key: commemoratione
    name: In Commemoratione S. Pauli Apostoli
    registry: "02"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 2:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "a standalone commemoration entry must not be refused" >&2
	exit 1
fi

# Duplicate mass keys are rejected.
{
	header
	cat <<'YAML'
  - key: same
    name: One
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
  - key: same
    name: Two
    registry: "02"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 2:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for duplicate mass keys" >&2
	exit 1
fi

# Carrying both propers and forms is rejected.
{
	header
	cat <<'YAML'
  - key: both
    name: Both
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
    forms:
      - name: Vigil Mass
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry carrying both propers and forms" >&2
	exit 1
fi

# A forms entry counts its nested propers.
{
	header
	cat <<'YAML'
  - key: forms-entry
    name: Forms Entry
    registry: "01"
    season: test
    forms:
      - name: Vigil Mass
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
      - name: Mass during the Day
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 2:1"]}
          - {name: Gospel, source: scripture, verses: ["John 1:1-18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
out="$("$tpt" "$tool" --root src/sources/calendars --json)"
case "$out" in
*'"propers":3'*) ;;
*) echo "expected 3 propers across forms, got: $out" >&2; exit 1 ;;
esac

# A sanctoral entry is placed by civil date, with a kind and the printed rank.
{
	header
	cat <<'YAML'
  - key: assumptione-beatae-mariae-virginis
    name: In Assumptione Beatae Mariae Virginis
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Revelation 12:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# Carrying both a season and a date is rejected, as is carrying neither.
{
	header
	cat <<'YAML'
  - key: both-placements
    name: Both Placements
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: marian
    season: advent
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry with both season and date" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: no-placement
    name: No Placement
    registry: "01"
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry with neither season nor date" >&2
	exit 1
fi

# An impossible date is rejected; February 29 is allowed.
{
	header
	cat <<'YAML'
  - key: bad-date
    name: Bad Date
    registry: "1962-02-30"
    date: "02-30"
    rank: III
    kind: sanctoral
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for February 30" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: leap-day
    name: Leap Day
    registry: "1962-02-29"
    date: "02-29"
    rank: III
    kind: sanctoral
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# A non-string date is rejected.
{
	header
	cat <<'YAML'
  - key: unquoted-date
    name: Unquoted Date
    registry: "1962-08-15"
    date: 815
    rank: I
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an unquoted date" >&2
	exit 1
fi

# A dated entry with an unknown kind, or with no rank, is rejected.
{
	header
	cat <<'YAML'
  - key: bad-kind
    name: Bad Kind
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: nonesuch
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an unknown kind" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: no-rank
    name: No Rank
    registry: "1962-08-15"
    date: "08-15"
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a dated entry with no rank" >&2
	exit 1
fi

# A wrong schema value is rejected.
cat >src/sources/calendars/test/propers.yaml <<'YAML'
schema: something-else/v9
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for wrong schema" >&2
	exit 1
fi

# A psalm reference is measured against the psalter its calendar declares, not
# only against the six psalms that divide between the systems. Psalm 118:137 is
# a real Vulgate verse and an impossible Hebrew one, so the same citation must
# be accepted under one declaration and refused under the other.
numbered() {
	rm -rf src/sources/calendars/test
	mkdir -p src/sources/calendars/test
	{
		cat <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: $1
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm $2"]}
YAML
	} >src/sources/calendars/test/propers.yaml
	encode
}

numbered vulgate "118:137"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "Psalm 118:137 is a real Vulgate verse and should be accepted" >&2
	exit 1
fi
numbered hebrew "118:137"
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for Psalm 118:137 in a Hebrew-numbered calendar" >&2
	exit 1
fi

# Hebrew 10 ends at 18: it is the second half of Vulgate 9, which runs to 39.
# Taking the host psalm's ceiling here is the error the derived table removed.
numbered hebrew "10:19"
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for Psalm 10:19 in a Hebrew-numbered calendar" >&2
	exit 1
fi
numbered vulgate "9:39"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "Psalm 9:39 is the last verse of Vulgate 9 and should be accepted" >&2
	exit 1
fi

# A calendar may carry a ledger of the psalm loci that breach its declaration
# while the antiphons holding them wait to be corrected. The ledger is written
# after encoding, because encoding rewrites the file it reads.
ledger() {
	rm -rf src/sources/calendars/test
	mkdir -p src/sources/calendars/test
	{
		cat <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: hebrew
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: [$1]}
YAML
	} >src/sources/calendars/test/propers.yaml
	encode
	cat >>src/sources/calendars/test/propers.yaml
}

# A listed locus is reported and not failed: the defect is owed, not settled.
ledger '"Psalm 118:137"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if ! out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "a listed psalm locus should not fail the gate: $out" >&2
	exit 1
fi
case "$out" in
*"excepted"*"Psalm 118:137"*) ;;
*) echo "an excepted locus must still be reported, got: $out" >&2; exit 1 ;;
esac

# A breach the ledger does not list still fails, so a new leak cannot slip in
# behind the known ones.
ledger '"Psalm 118:137", "Psalm 15:11"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a psalm breach the ledger does not list" >&2
	exit 1
fi

# A listed locus that no longer breaches fails too, so the ledger empties itself
# as the antiphons are corrected instead of rotting into a standing permission.
ledger '"Psalm 1:1"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a ledger entry that no longer breaches" >&2
	exit 1
fi
case "$out" in
*"no longer breaches"*) ;;
*) echo "expected a stale-entry problem, got: $out" >&2; exit 1 ;;
esac

# A malformed ledger is a failure of its own: an entry that names no locus
# excuses nothing and hides what it was for.
ledger '"Psalm 118:137"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a ledger entry carrying no loci" >&2
	exit 1
fi

# The ledger excuses psalm loci and nothing else. A citation whose ranges have
# been moved away from the reference it prints sits in the same file as an
# excused breach and must still fail, or the ledger would have become a place
# for other defects to hide behind.
ledger '"Psalm 118:137", "Psalm 24:1-3"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
sed -i 's/{chapter: 24, verse: 1}/{chapter: 30, verse: 2}/; s/{chapter: 24, verse: 3}/{chapter: 30, verse: 4}/' \
	src/sources/calendars/test/propers.yaml
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "the ledger must not swallow a ref that disagrees with its ranges" >&2
	exit 1
fi
case "$out" in
*"excepted"*"Psalm 118:137"*) ;;
*) echo "the excused breach must still be reported, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*"error"*"derives 24:1-24:3"*"stores 30:2-30:4"*) ;;
*) echo "expected the ref disagreement to fail alongside it, got: $out" >&2; exit 1 ;;
esac

# Spine coverage applies only to calendars the spine has a reference
# publication for. This fixture calendar is named "test", so it is out of the
# spine's scope rather than in breach of it: every check above passed while it
# carried no sanctoral date at all, which would be impossible if an unknown
# calendar were measured against a spine it has no entries in.
numbered vulgate "1:1"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "a calendar the spine does not know must not be failed for coverage" >&2
	exit 1
fi

# A translation carries its own rights basis; a licensed one names its source
# and its required notice; and a witness may not speak twice in one proper.
translated() {
	rm -rf tr-root
	mkdir -p tr-root/tr
	{ header; cat; } >tr-root/tr/propers.yaml
}
base='  - key: t
    name: T
    registry: "t1"
    season: advent
    propers:
    - name: Collect
      source: composed
      text: "Excita, quaesumus, Domine."'
# Two witnesses registered in this repository's source library. A source_id
# must resolve there, so the fixtures name real records rather than plausible
# strings: an id that resolves to nothing reads as provenance and is not.
missal_en='edition.catholic-church.institutio-generalis-missalis-romani.english-us-2011-emended-2021'
cummiskey='edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861'
transcription='artifact.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861.temporal-orations-en'

translated <<YAML
$base
      translations:
      - lang: en
        rights: licensed
        source_id: $missal_en
        notice: "Excerpts (c) 2010 ICEL."
        text: "Stir up thy power."
YAML
if ! "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "a fully specified licensed translation should validate" >&2
	exit 1
fi

# A rightsholder's own standing grant publishes, and publishes on its terms.
# `permission` is ICEL's case: the reproduction of its promulgated texts on a
# non-commercial website is granted in advance to anyone, subject to conditions,
# and the second condition is that the copyright acknowledgment appear with the
# text. So a permitted translation validates WITH its notice and is refused
# without one -- publishing bare would be publishing outside the grant claimed.
translated <<YAML
$base
      translations:
      - lang: en
        rights: permission
        source_id: $missal_en
        notice: "The English translation of The Roman Missal (c) 2010, ICEL."
        text: "Stir up thy power."
YAML
if ! "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "a permitted translation carrying its notice should validate" >&2
	exit 1
fi

for bad in "rights: vibes" "rights: licensed" "rights: permission"; do
	translated <<YAML
$base
      translations:
      - lang: en
        $bad
        text: "Stir up thy power."
YAML
	if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
		echo "expected failure for translation with $bad and no attribution" >&2
		exit 1
	fi
done

# A source_id that names nothing is refused. Provenance that resolves to no
# record is worse than none: it answers a question it cannot answer.
translated <<YAML
$base
      translations:
      - lang: en
        rights: public-domain
        source_id: edition.nobody.no-such-missal.nowhere-1900
        text: "Stir up thy power."
YAML
if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "expected failure for a source_id that resolves to no record" >&2
	exit 1
fi

# THE POINT OF THE DROPDOWN. Two witnesses to the same oration, in the same
# language, must both be expressible: the reason to offer a choice is that
# translations differ, and their disagreement is also the only detector this
# corpus has for a bad transcription -- it found 38 wrong orations at 45 loci.
translated <<YAML
$base
      translations:
      - lang: en
        rights: public-domain
        source_id: $cummiskey
        text: "Exert, we beseech thee, O Lord, thy power."
      - lang: en
        rights: public-domain
        source_id: $transcription
        text: "Stir up thy power, we beseech thee, O Lord."
YAML
if ! "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "two witnesses in one language must be accepted" >&2
	exit 1
fi

# The same witness twice is still a duplicate: that is a copied row, not a
# second reading.
translated <<YAML
$base
      translations:
      - lang: en
        rights: public-domain
        source_id: $cummiskey
        text: "a"
      - lang: en
        rights: public-domain
        source_id: $cummiskey
        text: "b"
YAML
if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "expected failure for one witness quoted twice in a proper" >&2
	exit 1
fi

# A translation naming no source_id has nothing to tell it from another in the
# same language, so the language still stands alone for those.
translated <<YAML
$base
      translations:
      - {lang: en, rights: project-created, text: "a"}
      - {lang: en, rights: project-created, text: "b"}
YAML
if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "expected failure for two sourceless translations in one language" >&2
	exit 1
fi
rm -rf tr-root

# A root with no index is an error, not a silent pass.
mkdir -p empty-root
if "$tpt" "$tool" --root empty-root >/dev/null 2>&1; then
	echo "expected failure for a root with no index" >&2
	exit 1
fi

echo ok
