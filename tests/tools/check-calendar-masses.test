#!/bin/sh
# Test for `tools/tpt check-calendar-masses`: exit 0 = pass (the stable gate).
set -eu

# Resolved tool roots: keeps working after a cd into a sandbox.
tools="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)/tools"
tpt="$tools/tpt"
tool="check-calendar-masses"

# Fixtures are written with printed citations, then encoded by the sibling
# tool that owns them, so the checker sees the same shape the indexes hold.
encode() {
	"$tpt" citations encode --root src/sources/calendars >/dev/null 2>&1 || true
}

# --help always works.
"$tpt" "$tool" --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

header() {
	cat <<'YAML'
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
YAML
}

mkdir -p src/sources/calendars/test

# Valid index: a scripture proper, a composed proper, and a cycle proper.
{
	header
	cat <<'YAML'
  - key: test-sunday
    name: Test Sunday
    registry: "01"
    season: test
    propers:
      - name: Introit
        incipit: Ad te levavi
        source: scripture
        verses: ["Psalm 24:1-3"]
      - name: Collect
        incipit: Excita
        source: composed
        text: |
          Excita, quaesumus, Domine.
      - name: First Reading
        source: scripture
        cycles:
          A: {verses: ["Isaiah 2:1-5"]}
          B: {verses: ["Jeremiah 33:14-16"]}
          C: {verses: ["Micah 5:1-4"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode

"$tpt" "$tool" --root src/sources/calendars >/dev/null
"$tpt" "$tool" --root src/sources/calendars --calendar test >/dev/null

# --json reports ok and counts every proper.
out="$("$tpt" "$tool" --root src/sources/calendars --json)"
case "$out" in
*'"status":"ok"'*) ;;
*) echo "expected ok status, got: $out" >&2; exit 1 ;;
esac
case "$out" in
*'"propers":3'*) ;;
*) echo "expected 3 propers, got: $out" >&2; exit 1 ;;
esac

# A cycle-varying proper may declare its source per cycle instead of once.
{
	header
	cat <<'YAML'
  - key: mixed-kind-cycles
    name: Mixed Kind Cycles
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A:
            source: composed
            text: |
              Semen est verbum Dei.
          B: {source: scripture, verses: ["Luke 4:18"]}
          C: {source: scripture, verses: ["Luke 7:16"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# A cycle with neither its own source nor one on the proper is rejected.
{
	header
	cat <<'YAML'
  - key: sourceless-cycle
    name: Sourceless Cycle
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A: {verses: ["Luke 4:18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a cycle with no source" >&2
	exit 1
fi

# A composed cycle without text is rejected.
{
	header
	cat <<'YAML'
  - key: textless-cycle
    name: Textless Cycle
    registry: "01"
    season: test
    propers:
      - name: Gospel Acclamation
        cycles:
          A: {source: composed, verses: ["Luke 4:18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a composed cycle without text" >&2
	exit 1
fi

# A scripture proper carrying text is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: "02"
    season: test
    propers:
      - name: Introit
        source: scripture
        verses: ["Psalm 24:1"]
        text: |
          should not be here
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for scripture proper carrying text" >&2
	exit 1
fi

# A composed proper without text is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: "02"
    season: test
    propers:
      - {name: Collect, source: composed}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for composed proper without text" >&2
	exit 1
fi

# An unquoted registry number is rejected.
{
	header
	cat <<'YAML'
  - key: bad-sunday
    name: Bad Sunday
    registry: 2
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for unquoted registry value" >&2
	exit 1
fi

# Duplicate mass keys are rejected.
{
	header
	cat <<'YAML'
  - key: same
    name: One
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
  - key: same
    name: Two
    registry: "02"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 2:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for duplicate mass keys" >&2
	exit 1
fi

# Carrying both propers and forms is rejected.
{
	header
	cat <<'YAML'
  - key: both
    name: Both
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
    forms:
      - name: Vigil Mass
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry carrying both propers and forms" >&2
	exit 1
fi

# A forms entry counts its nested propers.
{
	header
	cat <<'YAML'
  - key: forms-entry
    name: Forms Entry
    registry: "01"
    season: test
    forms:
      - name: Vigil Mass
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
      - name: Mass during the Day
        propers:
          - {name: Introit, source: scripture, verses: ["Psalm 2:1"]}
          - {name: Gospel, source: scripture, verses: ["John 1:1-18"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
out="$("$tpt" "$tool" --root src/sources/calendars --json)"
case "$out" in
*'"propers":3'*) ;;
*) echo "expected 3 propers across forms, got: $out" >&2; exit 1 ;;
esac

# A sanctoral entry is placed by civil date, with a kind and the printed rank.
{
	header
	cat <<'YAML'
  - key: assumptione-beatae-mariae-virginis
    name: In Assumptione Beatae Mariae Virginis
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Revelation 12:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# Carrying both a season and a date is rejected, as is carrying neither.
{
	header
	cat <<'YAML'
  - key: both-placements
    name: Both Placements
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: marian
    season: advent
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry with both season and date" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: no-placement
    name: No Placement
    registry: "01"
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an entry with neither season nor date" >&2
	exit 1
fi

# An impossible date is rejected; February 29 is allowed.
{
	header
	cat <<'YAML'
  - key: bad-date
    name: Bad Date
    registry: "1962-02-30"
    date: "02-30"
    rank: III
    kind: saintly
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for February 30" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: leap-day
    name: Leap Day
    registry: "1962-02-29"
    date: "02-29"
    rank: III
    kind: saintly
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
"$tpt" "$tool" --root src/sources/calendars >/dev/null

# A non-string date is rejected.
{
	header
	cat <<'YAML'
  - key: unquoted-date
    name: Unquoted Date
    registry: "1962-08-15"
    date: 815
    rank: I
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an unquoted date" >&2
	exit 1
fi

# A dated entry with an unknown kind, or with no rank, is rejected.
{
	header
	cat <<'YAML'
  - key: bad-kind
    name: Bad Kind
    registry: "1962-08-15"
    date: "08-15"
    rank: I
    kind: nonesuch
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for an unknown kind" >&2
	exit 1
fi

{
	header
	cat <<'YAML'
  - key: no-rank
    name: No Rank
    registry: "1962-08-15"
    date: "08-15"
    kind: marian
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
} >src/sources/calendars/test/propers.yaml
encode
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a dated entry with no rank" >&2
	exit 1
fi

# A wrong schema value is rejected.
cat >src/sources/calendars/test/propers.yaml <<'YAML'
schema: something-else/v9
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: vulgate
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm 1:1"]}
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for wrong schema" >&2
	exit 1
fi

# A psalm reference is measured against the psalter its calendar declares, not
# only against the six psalms that divide between the systems. Psalm 118:137 is
# a real Vulgate verse and an impossible Hebrew one, so the same citation must
# be accepted under one declaration and refused under the other.
numbered() {
	rm -rf src/sources/calendars/test
	mkdir -p src/sources/calendars/test
	{
		cat <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: $1
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: ["Psalm $2"]}
YAML
	} >src/sources/calendars/test/propers.yaml
	encode
}

numbered vulgate "118:137"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "Psalm 118:137 is a real Vulgate verse and should be accepted" >&2
	exit 1
fi
numbered hebrew "118:137"
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for Psalm 118:137 in a Hebrew-numbered calendar" >&2
	exit 1
fi

# Hebrew 10 ends at 18: it is the second half of Vulgate 9, which runs to 39.
# Taking the host psalm's ceiling here is the error the derived table removed.
numbered hebrew "10:19"
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for Psalm 10:19 in a Hebrew-numbered calendar" >&2
	exit 1
fi
numbered vulgate "9:39"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "Psalm 9:39 is the last verse of Vulgate 9 and should be accepted" >&2
	exit 1
fi

# A calendar may carry a ledger of the psalm loci that breach its declaration
# while the antiphons holding them wait to be corrected. The ledger is written
# after encoding, because encoding rewrites the file it reads.
ledger() {
	rm -rf src/sources/calendars/test
	mkdir -p src/sources/calendars/test
	{
		cat <<YAML
schema: triptych-calendar-masses/v1
edition: test edition
calendar: test
series: test series
ordering: test ordering
registry: test registry
psalm_numbering: hebrew
citation_convention: test convention
orthography: test orthography
verification: unverified test fixture
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: only
    name: Only
    registry: "01"
    season: test
    propers:
      - {name: Introit, source: scripture, verses: [$1]}
YAML
	} >src/sources/calendars/test/propers.yaml
	encode
	cat >>src/sources/calendars/test/propers.yaml
}

# A listed locus is reported and not failed: the defect is owed, not settled.
ledger '"Psalm 118:137"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if ! out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "a listed psalm locus should not fail the gate: $out" >&2
	exit 1
fi
case "$out" in
*"excepted"*"Psalm 118:137"*) ;;
*) echo "an excepted locus must still be reported, got: $out" >&2; exit 1 ;;
esac

# A breach the ledger does not list still fails, so a new leak cannot slip in
# behind the known ones.
ledger '"Psalm 118:137", "Psalm 15:11"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a psalm breach the ledger does not list" >&2
	exit 1
fi

# A listed locus that no longer breaches fails too, so the ledger empties itself
# as the antiphons are corrected instead of rotting into a standing permission.
ledger '"Psalm 1:1"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
  loci:
    "Psalm 118:137": only/Introit
YAML
if out="$("$tpt" "$tool" --root src/sources/calendars 2>&1)"; then
	echo "expected failure for a ledger entry that no longer breaches" >&2
	exit 1
fi
case "$out" in
*"no longer breaches"*) ;;
*) echo "expected a stale-entry problem, got: $out" >&2; exit 1 ;;
esac

# A malformed ledger is a failure of its own: an entry that names no locus
# excuses nothing and hides what it was for.
ledger '"Psalm 118:137"' <<'YAML'
psalm_numbering_exceptions:
- psalm: 118
  divergence: Vulgate 118 is Hebrew 119, which runs to 176
YAML
if "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "expected failure for a ledger entry carrying no loci" >&2
	exit 1
fi

# Spine coverage applies only to calendars the spine has a reference
# publication for. This fixture calendar is named "test", so it is out of the
# spine's scope rather than in breach of it: every check above passed while it
# carried no sanctoral date at all, which would be impossible if an unknown
# calendar were measured against a spine it has no entries in.
numbered vulgate "1:1"
if ! "$tpt" "$tool" --root src/sources/calendars >/dev/null 2>&1; then
	echo "a calendar the spine does not know must not be failed for coverage" >&2
	exit 1
fi

# A translation carries its own rights basis; a licensed one names its source
# and its required notice, and languages may not repeat within a proper.
translated() {
	rm -rf tr-root
	mkdir -p tr-root/tr
	{ header; cat; } >tr-root/tr/propers.yaml
}
base='  - key: t
    name: T
    registry: "t1"
    season: advent
    propers:
    - name: Collect
      source: composed
      text: "Excita, quaesumus, Domine."'

translated <<YAML
$base
      translations:
      - lang: en
        rights: licensed
        source_id: work.icel.roman-missal-2011
        notice: "Excerpts (c) 2010 ICEL."
        text: "Stir up thy power."
YAML
if ! "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "a fully specified licensed translation should validate" >&2
	exit 1
fi

for bad in "rights: vibes" "rights: licensed"; do
	translated <<YAML
$base
      translations:
      - lang: en
        $bad
        text: "Stir up thy power."
YAML
	if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
		echo "expected failure for translation with $bad and no attribution" >&2
		exit 1
	fi
done

translated <<YAML
$base
      translations:
      - {lang: en, rights: project-created, text: "a"}
      - {lang: en, rights: project-created, text: "b"}
YAML
if "$tpt" "$tool" --root tr-root >/dev/null 2>&1; then
	echo "expected failure for a duplicated translation language" >&2
	exit 1
fi
rm -rf tr-root

# A root with no index is an error, not a silent pass.
mkdir -p empty-root
if "$tpt" "$tool" --root empty-root >/dev/null 2>&1; then
	echo "expected failure for a root with no index" >&2
	exit 1
fi

echo ok
