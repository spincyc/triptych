#!/bin/sh
# Test for `tools/tpt lectern`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="lectern"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null
run_tool open --help >/dev/null
run_tool snapshot --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM
cd "$sandbox"

# Arguments the reader cannot act on are refused before anything is drawn,
# with the input exit status and nothing on stdout.
expect_refusal() {
	status=0
	run_tool "$@" >refusal.out 2>refusal.err || status=$?
	if [ "$status" -ne 2 ]; then
		echo "expected exit 2 for: $*; got $status" >&2
		cat refusal.err >&2
		exit 1
	fi
	if [ -s refusal.out ]; then
		echo "a refusal wrote to stdout: $*" >&2
		exit 1
	fi
}
expect_refusal snapshot --date 2026-02-30
expect_refusal snapshot --size 40x10
expect_refusal snapshot --surface nowhere
expect_refusal open --surface day </dev/null >/dev/null

# Without Textual the reader says what it needs, under the dependency status,
# rather than failing with a traceback. With it, a snapshot is drawn.
if python3 -c 'import textual' 2>/dev/null; then
	run_tool snapshot --surface day --date 2026-10-22 --size 120x36 >day.txt
	grep -q 'triptych' day.txt
	grep -q '2026' day.txt
	run_tool snapshot --surface catena --ref 'Gen 1' --size 120x36 >catena.txt
	grep -q 'Genesis' catena.txt
	run_tool snapshot --surface day --date 2026-10-22 --size 120x36 >again.txt
	if ! cmp -s day.txt again.txt; then
		echo "a snapshot is not byte-stable across runs" >&2
		exit 1
	fi
else
	status=0
	run_tool snapshot --surface day >missing.out 2>missing.err || status=$?
	if [ "$status" -ne 69 ]; then
		echo "expected the dependency status 69 without Textual, got $status" >&2
		exit 1
	fi
	grep -q 'python-textual' missing.err
	if grep -q 'Traceback' missing.err; then
		echo "a missing dependency produced a traceback" >&2
		exit 1
	fi
fi

echo ok
