#!/bin/sh
# Synthetic served bundles: set checks always; host TeX cases skip without TeX.
set -eu
repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
"$repo/tools/native-print-compile" --help >/dev/null
"$repo/tools/native-print-compile" prepare --help >/dev/null
"$repo/tools/native-print-compile" compile --help >/dev/null
PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s "$repo/tools/tests" -p test_native_print_compile.py
echo ok
