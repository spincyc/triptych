#!/bin/sh
set -eu
tool="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)/tools/bullarium"
"$tool" --help >/dev/null
if "$tool" acquire --volume 0 --json 2>/dev/null; then
    exit 1
fi
"$tool" status --json | python -c 'import json,sys; d=json.load(sys.stdin); assert d["v"]==1 and d["whole_containers_acquired"]==25'
