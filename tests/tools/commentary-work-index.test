#!/bin/sh
# Test for `tools/tpt commentary-work-index`: exit 0 = pass (the stable gate).
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="commentary-work-index"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

# Every invocation of this test runs from a scratch directory. Both verbs
# resolve their default --discovery and --output relative to the working
# directory, and build-corpus writes by default; running outside the repo
# means a missing --output can never touch tracked state.
sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

repo_discovery="$repo/src/sources/commentary/passage-commentary-index.yaml"

contains() {
	# contains WHAT HAYSTACK LABEL
	case "$2" in
	*"$1"*) ;;
	*) echo "$3: expected '$1' in: $2" >&2; exit 1 ;;
	esac
}

lacks() {
	case "$2" in
	*"$1"*) echo "$3: did not expect '$1' in: $2" >&2; exit 1 ;;
	*) ;;
	esac
}

reject() {
	label="$1"
	shift
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $label" >&2
		exit 1
	fi
}

cd "$sandbox"

# ---------------------------------------------------------------------------
# discover loads the sibling `citations` tool by path.
#
# This is the load-bearing case. `commentary-work-index` reaches its sibling
# through Path(__file__).with_name("citations"); a path expressed relative to
# the working directory (the old `tools/tools/citations` form) breaks every
# discover call. Running from a scratch directory that has no `tools/` in it
# at all means only a __file__-relative resolution can succeed.
out="$(run_tool discover --discovery "$repo_discovery" --passage "John 3:16" --json)"
contains '"status":"ok"' "$out" "discover from a foreign cwd"
contains '"passage":"John 3:16"' "$out" "discover from a foreign cwd"
contains '"schema":"triptych-commentary-work-index/v1"' "$out" "discover schema"

# The sibling is what validates books and ranges, so its rejections surface
# here. A stubbed or missing citations module could not produce these.
err="$(run_tool discover --discovery "$repo_discovery" --passage "Nonesuch 1:1" 2>&1 || true)"
contains "unknown book" "$err" "unknown book is reported by the citations sibling"

# ---------------------------------------------------------------------------
# discover ranks and shapes the works it finds.
cat >"$sandbox/discovery.yaml" <<'YAML'
schema: triptych-commentary-work-index/v1
updated: 2026-07-30
numbering: vulgate
passages:
  - passage: "Joel 3"
    numbering: unrecorded
    numbering_basis: only a Lectionary-numbered citation reaches this key
    works:
      - work_id: jerome.in-ioelem
        author: Jerome
        title: Commentarii in Ioelem
        role: church-father
        confidence: 1.0
  - passage: "John 3:16"
    works:
      - work_id: aug.tract-io
        author: Augustine
        title: Tractates on John
        date: c. 407
        role: church-father
        confidence: 0.9
        source_hint: PL 35
      - work_id: chrys.hom-io
        author: John Chrysostom
        title: Homilies on John
        date: c. 390
        role: patristic
        confidence: 0.95
  - passage: "Psalms 24:1-24:3"
    works:
      - work_id: aug.enarr
        author: Augustine
        title: Enarrationes in Psalmos
        role: doctor
        confidence: 0.8
  - passage: "Psalms 24"
    works:
      - work_id: cassiodorus.expositio
        author: Cassiodorus
        title: Expositio Psalmorum
        role: ecclesiastical-writer
        confidence: 0.7
  - passage: "Psalms 22"
    works:
      - work_id: theodoret.in-psalmos
        author: Theodoret of Cyrus
        title: Interpretatio in Psalmos
        role: church-father
        confidence: 0.6
  - passage: "Genesis 1"
    works:
      - work_id: gen1.first
        author: Basil
        title: Hexaemeron
        role: church-father
        confidence: 0.9
      - work_id: gen1.second
        author: Ambrose
        title: Exameron
        role: church-father
        confidence: 0.8
      - work_id: both.chapters
        author: Bede
        title: In Genesim
        role: church-father
        confidence: 0.5
  - passage: "Genesis 2"
    works:
      - work_id: gen2.first
        author: Chrysostom
        title: Homiliae in Genesim
        role: church-father
        confidence: 0.85
      - work_id: both.chapters
        author: Bede
        title: In Genesim
        role: church-father
        confidence: 0.5
YAML

discover() {
	run_tool discover --discovery "$sandbox/discovery.yaml" "$@"
}

out="$(discover --passage "John 3:16" --json)"
# Ranked by confidence descending, so Chrysostom (0.95) precedes Augustine (0.9).
case "$out" in
*'"work_id":"chrys.hom-io"'*'"work_id":"aug.tract-io"'*) ;;
*) echo "expected works ranked by confidence, got: $out" >&2; exit 1 ;;
esac
# `patristic` is an alias that normalizes onto the church-father role.
lacks '"role":"patristic"' "$out" "role alias normalization"
contains '"role":"church-father"' "$out" "role alias normalization"
# Side metadata survives the round trip.
contains '"source_hint":"PL 35"' "$out" "source hint is preserved"

# --max-results truncates the ranked list and is echoed back.
out="$(discover --passage "John 3:16" --max-results 1 --json)"
contains '"max_results":1' "$out" "max-results echo"
contains '"work_id":"chrys.hom-io"' "$out" "max-results keeps the top rank"
lacks '"work_id":"aug.tract-io"' "$out" "max-results drops the tail"

# Several --passage flags produce several discoveries, in the order given.
out="$(discover --passage "John 3:16" --passage "Psalm 24:1-3" --numbering vulgate --json)"
case "$out" in
*'"passage":"John 3:16"'*'"passage":"Psalms 24:1-24:3"'*) ;;
*) echo "expected both passages in order, got: $out" >&2; exit 1 ;;
esac

# ---------------------------------------------------------------------------
# The bridge between the two key spaces.
#
# The propers cite verse ranges and the harvest is run by chapter, so the key
# a lookup builds must be the citations tool's canonical rendering of the
# parsed book and ranges — never the spelling the caller used. The missals
# write "Psalm 24:1-3"; the index is keyed "Psalms 24". Keying on the verbatim
# citation missed 926 of the 2190 references the two calendars carry.
out="$(discover --passage "Psalm 24:1-3" --numbering vulgate --json)"
contains '"passage":"Psalms 24:1-24:3"' "$out" "the key is derived, not the spelling given"
contains '"cited":"Psalm 24:1-3"' "$out" "the citation as written is still reported"
# Both key spaces answer: the verse-range entry the pilot runs left, and the
# chapter entry the full passes recorded. Neither hides the other.
contains '"work_id":"aug.enarr"' "$out" "an exact verse-range key still answers"
contains '"work_id":"cassiodorus.expositio"' "$out" "the chapter key answers too"
# A chapter-level hit says so, and says which chapter; an exact hit does not.
contains '"matched":"chapter"' "$out" "a widened match is labelled"
contains '"matched_loci":["Psalms 24"]' "$out" "a widened match names its locus"

# A psalm reference does not say which numbering it is written in, and guessing
# returns a real, confident, wrong psalm. The tool refuses instead.
reject "psalm lookup without a declared numbering" \
	discover --passage "Psalm 24:1-3"
err="$(discover --passage "Psalm 24:1-3" 2>&1 || true)"
contains "Vulgate 50 is Hebrew 51" "$err" "the refusal says why"

# Declared Hebrew, the same citation resolves to a different psalm: Hebrew 23
# is Vulgate 22, and the conversion runs through the tracked concordance.
out="$(discover --passage "Psalm 23:1-3" --numbering hebrew --json)"
contains '"passage":"Psalms 22:1-22:3"' "$out" "hebrew input renumbers to the vulgate key"
contains '"work_id":"theodoret.in-psalmos"' "$out" "renumbered lookup finds the vulgate locus"
# The same citation read as Vulgate is a different psalm, and must not find it.
out="$(discover --passage "Psalm 23:1-3" --numbering vulgate --json)"
lacks '"work_id":"theodoret.in-psalmos"' "$out" "vulgate input is not renumbered"

# ---------------------------------------------------------------------------
# The index says which numbering its keys are in, and a key that is not in it
# is refused rather than answered.
#
# `Psalms 24` resolves in both systems and means two different psalms, so an
# index with no declaration cannot be read safely at all. Refusing to load is
# the only answer that cannot be a wrong one.
cat >"$sandbox/undeclared.yaml" <<'YAML'
schema: triptych-commentary-work-index/v1
passages:
  - passage: "John 3:16"
    works:
      - work_id: aug.tract-io
        author: Augustine
        title: Tractates on John
        role: church-father
        confidence: 0.9
YAML
reject "an index that declares no numbering" \
	discover --discovery "$sandbox/undeclared.yaml" --passage "John 3:16"
err="$(run_tool discover --discovery "$sandbox/undeclared.yaml" \
	--passage "John 3:16" 2>&1 || true)"
contains "no \`numbering\` declared" "$err" "the refusal names the missing declaration"

# A row that declares another system holds real works about other text. The
# lookup refuses it and carries the reason, rather than counting a hit.
out="$(discover --passage "Joel 3:1-5" --json)"
lacks '"work_id":"jerome.in-ioelem"' "$out" "a foreign key does not answer"
contains '"refused_loci"' "$out" "the refusal is reported"
contains "only a Lectionary-numbered citation reaches this key" "$out" "the refusal carries its reason"

# A range crossing a chapter boundary is a query about every chapter it names.
# Taking each chapter's works in a block let the first fill the result alone:
# Genesis 1:1-2:2 returned twenty works from Genesis 1 and none from Genesis 2.
# Ranks are interleaved instead, so the cut at --max-results cannot starve a
# chapter the citation named.
out="$(discover --passage "Genesis 1:1-2:2" --max-results 2 --json)"
contains '"work_id":"gen1.first"' "$out" "cross-chapter keeps the first chapter's best"
contains '"work_id":"gen2.first"' "$out" "cross-chapter keeps the second chapter's best"
lacks '"work_id":"gen1.second"' "$out" "cross-chapter does not fill from one chapter"
# One work found under both chapters is one work, carrying both loci in the
# order the citation names them.
out="$(discover --passage "Genesis 1:1-2:2" --json)"
contains '"matched_loci":["Genesis 1","Genesis 2"]' "$out" "a work in both chapters carries both"
case "$(printf '%s' "$out" | grep -o '"work_id":"both.chapters"' | wc -l)" in
1) ;;
*) echo "expected one entry for a work found under both chapters, got: $out" >&2; exit 1 ;;
esac

# A passage file may carry a machine-readable passage record rather than a
# printed citation; the tool builds the label from the ranges itself.
cat >"$sandbox/passage.yaml" <<'YAML'
book: Psalms
ranges:
  - begin: {chapter: 24, verse: 1}
    end: {chapter: 24, verse: 3}
YAML
out="$(discover --passage-file "$sandbox/passage.yaml" --numbering vulgate --json)"
contains '"passage":"Psalms 24:1-24:3"' "$out" "machine passage record label"

# ---------------------------------------------------------------------------
# Output selection: --json/--yaml are shorthands for --format.
discover --passage "John 3:16" --json >"$sandbox/short.json"
discover --passage "John 3:16" --format json >"$sandbox/long.json"
if ! cmp -s "$sandbox/short.json" "$sandbox/long.json"; then
	echo "--json and --format json disagree" >&2
	exit 1
fi

discover --passage "John 3:16" --yaml >"$sandbox/short.yaml"
discover --passage "John 3:16" --format yaml >"$sandbox/long.yaml"
if ! cmp -s "$sandbox/short.yaml" "$sandbox/long.yaml"; then
	echo "--yaml and --format yaml disagree" >&2
	exit 1
fi

out="$(discover --passage "John 3:16")"
contains "passage: John 3:16" "$out" "default text rendering"
contains "John Chrysostom" "$out" "default text rendering lists works"

# discover carries no clock or randomness: it is byte-stable.
discover --passage "John 3:16" --passage "Psalm 24:1-3" --numbering vulgate --json >"$sandbox/first"
discover --passage "John 3:16" --passage "Psalm 24:1-3" --numbering vulgate --json >"$sandbox/second"
if ! cmp -s "$sandbox/first" "$sandbox/second"; then
	echo "discover output is not byte-stable across runs" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# build-corpus, confined to the sandbox by --root and --output.
mkdir -p "$sandbox/calendars/testcal"
cat >"$sandbox/calendars/testcal/propers.yaml" <<'YAML'
schema: triptych-calendar-masses/v1
calendar: testcal
psalm_numbering: vulgate
sections:
 seasonal:
  kind: seasonal
  label: Seasonal
  masses:
  - key: test-mass
    name: Test Mass
    kind: temporal
    date: 01-01
    propers:
    - name: Gospel
      source: scripture
      verses: ["John 3:16"]
    - name: Epistle
      source: scripture
      verses: ["Psalm 46"]
    - name: Placeholder
      source: composed
      text: not scripture, and so contributes no passage
YAML

out="$(run_tool build-corpus \
	--discovery "$sandbox/discovery.yaml" \
	--root "$sandbox/calendars" \
	--calendar testcal \
	--output "$sandbox/corpus.yaml" \
	--json 2>/dev/null)"
contains '"status":"ok"' "$out" "build-corpus"
contains '"mass_count":1' "$out" "build-corpus counts masses"
contains '"covered_mass_count":1' "$out" "build-corpus counts covered masses"
# Psalm 46 has no mapped commentary; John 3:16 does.
contains '"unresolved_passage_count":1' "$out" "build-corpus counts unresolved passages"
contains '"has_commentary":true' "$out" "build-corpus marks resolved passages"
contains '"has_commentary":false' "$out" "build-corpus marks unresolved passages"
# The `temporal` mass kind is reported under its `seasonal` category.
contains '"mass_kind":"seasonal"' "$out" "mass kind category"

if [ ! -s "$sandbox/corpus.yaml" ]; then
	echo "build-corpus did not write --output" >&2
	exit 1
fi
out="$(cat "$sandbox/corpus.yaml")"
contains "schema: triptych-missal-commentary-corpus/v1" "$out" "written corpus schema"
contains "mass_key: test-mass" "$out" "written corpus content"

# Nothing was written to the default corpus path relative to the cwd.
if [ -e "$sandbox/src" ]; then
	echo "build-corpus wrote to its default path despite --output" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# coverage reads the repository's own records and writes nothing.
#
# Its sources are the discovery index, the fragment edge and the extent record,
# all resolved from the tool's own location, so like discover above it has to
# work from a scratch directory with no `src/` under it at all. The assertions
# below are about the SHAPE of the answer, not about today's corpus: a count
# asserted here would fail every time a fragment landed, which is the opposite
# of what a smoke test is for.
out="$(run_tool coverage --json)"
contains '"status":"ok"' "$out" "coverage"
contains '"schema":"triptych-commentary-coverage/v1"' "$out" "coverage schema"
contains '"numbering":"vulgate"' "$out" "coverage anchors canonically"
# Every one of the four readings must survive into the payload vocabulary.
contains '"gap"' "$out" "coverage keeps the gap reading"
contains '"unexamined"' "$out" "coverage keeps the unexamined reading"
contains '"not-established"' "$out" "coverage keeps the selective reading"
contains '"complete"' "$out" "coverage keeps the complete reading"

# A gap is a work item, not a failure: the verb exits 0 with gaps present.
run_tool coverage >/dev/null

# --book narrows to one canonical token, and an unknown one is empty rather
# than an error: nothing is held there, which is a true answer.
out="$(run_tool coverage --book Gen --json)"
contains '"token":"Gen"' "$out" "coverage --book narrows"
lacks '"token":"Luke"' "$out" "coverage --book excludes other books"

# coverage carries no clock: it is byte-stable.
run_tool coverage --json >"$sandbox/coverage-first"
run_tool coverage --json >"$sandbox/coverage-second"
if ! cmp -s "$sandbox/coverage-first" "$sandbox/coverage-second"; then
	echo "coverage output is not byte-stable across runs" >&2
	exit 1
fi

# It is read-only. Nothing under the scratch directory grew a src/ tree, and
# the repository's own records are untouched by a report about them.
if [ -e "$sandbox/src" ]; then
	echo "coverage wrote into the working directory" >&2
	exit 1
fi

# ---------------------------------------------------------------------------
# Negative cases: bad input is refused, never guessed at.
reject "unknown verb" bogus
reject "discover with no passage input" discover --discovery "$sandbox/discovery.yaml"
reject "unparseable book" discover --discovery "$sandbox/discovery.yaml" --passage "Nonesuch 1:1"
reject "citation with no book" discover --discovery "$sandbox/discovery.yaml" --passage "24:1-3"
reject "descending range" discover --discovery "$sandbox/discovery.yaml" \
	--passage "Psalm 24:3-1" --numbering vulgate
reject "unknown output format" discover --discovery "$sandbox/discovery.yaml" \
	--passage "John 3:16" --format xml
reject "missing passage file" discover --discovery "$sandbox/discovery.yaml" \
	--passage-file "$sandbox/no-such-file.yaml"
reject "build-corpus with a missing root" build-corpus --root "$sandbox/no-such-root" \
	--output "$sandbox/unwritten.yaml"
reject "build-corpus with an unknown calendar" build-corpus --root "$sandbox/calendars" \
	--calendar no-such-calendar --output "$sandbox/unwritten.yaml"

if [ -e "$sandbox/unwritten.yaml" ]; then
	echo "build-corpus wrote output for a failed run" >&2
	exit 1
fi

echo ok
