#!/bin/sh
# Test for `tools/tpt release-bindings`: exit 0 = pass (the stable gate).
# Only `status` is run against the repository.  refresh, approve,
# add-publication, and migrate-publications rewrite tracked release records, so
# they are exercised no further than argument parsing, which happens before the
# manifest is read and therefore cannot touch a file.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="release-bindings"

run_tool() {
	"$tool" "$tool_id" "$@"
}

usage="$(run_tool --help)"
for verb in refresh status migrate-publications approve add-publication; do
	case "$usage" in
	*"$verb"*) ;;
	*)
		echo "usage does not offer the $verb verb" >&2
		exit 1
		;;
	esac
done

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# Approval counts the active per-publication inventory after migration, while
# older aggregate manifests remain readable.  Exercise the pure counting seam:
# a successful `approve` would write a real dated authorization and must never
# be invoked by this test.
python3 - "$repo" "$sandbox/counts" <<'PY'
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

repo, sandbox = Path(sys.argv[1]), Path(sys.argv[2])
loader = importlib.machinery.SourceFileLoader(
    "release_bindings", str(repo / "tools/release-bindings")
)
module = importlib.util.module_from_spec(
    importlib.util.spec_from_loader(loader.name, loader)
)
loader.exec_module(module)
module.ROOT = sandbox

manifest = {"provider": "gpt", "providers": ["gpt", "claude"]}
for provider, leaf, status in (
    ("gpt", "articles/one", "alpha"),
    ("gpt", "articles/two", "hold"),
    ("claude", "curriculums/three", "alpha"),
):
    path = sandbox / "release/publications" / provider / f"{leaf}.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps({
        "schema_version": 1,
        "id": leaf,
        "catalog": "fixture",
        "status": status,
        "authorization": "fixture" if status == "alpha" else None,
    }) + "\n", encoding="utf-8")

try:
    module.publication_status_counts(manifest)
except module.BindingError as error:
    assert "installed PDF missing" in str(error), error
else:
    raise AssertionError("an alpha record without its installed PDF was counted")
for provider, leaf in (
    ("gpt", "articles/one"),
    ("claude", "curriculums/three"),
):
    pdf = sandbox / "pdf" / provider / f"{leaf}.pdf"
    pdf.parent.mkdir(parents=True, exist_ok=True)
    pdf.write_bytes(f"{provider}:{leaf}".encode())

schema, counts = module.publication_status_counts(manifest)
assert schema == "records", schema
assert counts == {"alpha": 2, "hold": 1}, counts
summary = module.publication_clearance_summary(schema, counts)
assert "all 2 exact installed public-alpha" in summary, summary
assert "records 1 publication(s) on hold" in summary, summary

# Generated structure JSON participates in the same exact-byte comparison as
# every other authorized site input. Exercise change, addition and removal
# without writing an authorization or hard-coding a digest.
relative = "src/web/data/structure/calendar/2026.json"
structure = sandbox / relative
structure.parent.mkdir(parents=True, exist_ok=True)
structure.write_text('{"year": 2026}\n', encoding="utf-8")
authorization = {"site_sources": {relative: module.sha256_file(structure)}}
module.recognized_site_sources = lambda: {relative}
assert module.site_source_divergences(authorization) == []

structure.write_text('{"year": 2027}\n', encoding="utf-8")
divergences = module.site_source_divergences(authorization)
assert len(divergences) == 1 and divergences[0].kind == "stale", divergences

added = "src/web/data/structure/ordinary/demo.json"
added_path = sandbox / added
added_path.parent.mkdir(parents=True, exist_ok=True)
added_path.write_text("{}\n", encoding="utf-8")
structure.write_text('{"year": 2026}\n', encoding="utf-8")
module.recognized_site_sources = lambda: {relative, added}
divergences = module.site_source_divergences(authorization)
assert len(divergences) == 1 and divergences[0].kind == "unrecorded", divergences

module.recognized_site_sources = lambda: set()
divergences = module.site_source_divergences(authorization)
assert len(divergences) == 1 and divergences[0].kind == "unrecognized", divergences

# Scoped adoption changes only its own subtree. It neither adopts an
# unrecorded sibling nor retires a recorded sibling the renderer stopped using.
own = "src/web/data/structure/sources/own.json"
sibling_new = "src/web/data/structure/sources/sibling-new.json"
sibling_old = "src/web/data/structure/sources/sibling-old.json"
for relative_path in (own, sibling_new):
    path = sandbox / relative_path
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(relative_path + "\n", encoding="utf-8")
authorization = {"site_sources": {
    own: "stale-own", sibling_old: "keep-this-recorded-value"
}}
module.recognized_site_sources = lambda: {own, sibling_new}
computed = module.compute_site_hashes(
    authorization, adopt=True, only=[own]
)
assert computed == {
    own: module.sha256_file(sandbox / own),
    sibling_old: "keep-this-recorded-value",
}, computed

legacy = {
    "provider": "gpt",
    "publications": [
        {"id": "one", "status": "release"},
        {"id": "two", "status": "review"},
        {"id": "three", "status": "hold"},
    ],
}
try:
    module.publication_status_counts(legacy)
except module.BindingError as error:
    assert "mixed legacy aggregate" in str(error), error
else:
    raise AssertionError("mixed legacy and local records were silently undercounted")
legacy_root = sandbox / "legacy"
module.ROOT = legacy_root
for leaf in ("one", "two"):
    pdf = legacy_root / "pdf/gpt" / f"{leaf}.pdf"
    pdf.parent.mkdir(parents=True, exist_ok=True)
    pdf.write_bytes(leaf.encode())
schema, counts = module.publication_status_counts(legacy)
assert schema == "legacy", schema
assert counts == {"release": 1, "review": 1, "hold": 1}, counts
summary = module.publication_clearance_summary(schema, counts)
assert "all 1 exact installed release" in summary, summary
assert "all 1 conspicuously labelled public-alpha" in summary, summary
assert "records 1 publication(s) on hold" in summary, summary
PY

# `status` reports and exits together, whatever the tree happens to hold.  This
# used to assert "exact: 0 stale binding(s)" outright, which made the smoke test
# a statement about the checkout rather than about the tool: while `status`
# compared nothing but the rights record it passed on a tree with nineteen
# recorded site-source hashes that did not match their files.  A check whose
# green depends on the data never failing cannot report that the data changed.
status_exit=0
run_tool status >"$sandbox/status.txt" || status_exit=$?
summary_line="$(tail -1 "$sandbox/status.txt")"
divergences="$(grep -c '^\(stale\|missing\|unrecorded\|unrecognized\) ' "$sandbox/status.txt" || true)"
case "$summary_line" in
"exact: 0 stale binding(s)")
	if [ "$status_exit" -ne 0 ]; then
		echo "status reported exact but exited $status_exit" >&2
		exit 1
	fi
	if [ "$divergences" -ne 0 ]; then
		echo "status reported exact beside $divergences divergence line(s)" >&2
		exit 1
	fi
	;;
"stale: "*" stale binding(s)")
	if [ "$status_exit" -eq 0 ]; then
		echo "status reported a stale binding and still exited 0" >&2
		exit 1
	fi
	counted="${summary_line#stale: }"
	counted="${counted% stale binding(s)}"
	if [ "$counted" -ne "$divergences" ]; then
		echo "status counted $counted but named $divergences" >&2
		exit 1
	fi
	;;
*)
	echo "status printed no recognizable summary: $summary_line" >&2
	exit 1
	;;
esac

# An independent oracle, deliberately not sharing the tool's own comparison:
# recount the divergences straight from the manifest and require `status` to
# have found the same number.  The consistency check above would have passed the
# defect this replaced, because a `status` that compares nothing reports nothing
# and exits 0 in perfect self-agreement.  Only a second, separate derivation
# catches a comparison that has stopped happening.
#
# The oracle counts the recognized set against the record in both directions as
# well, because the same self-agreement hid the second half: a check that walks
# the recorded entries alone reports exact while twelve recognized inputs sit
# outside the authorization.  The recognized set can only come from the
# renderer, so the oracle asks it for the set and then does its own arithmetic.
expected="$(python3 - <<'PY'
import hashlib, importlib.machinery, importlib.util, json, pathlib

loader = importlib.machinery.SourceFileLoader("oracle_public_alpha", "tools/public-alpha")
spec = importlib.util.spec_from_loader(loader.name, loader)
renderer = importlib.util.module_from_spec(spec)
spec.loader.exec_module(renderer)
recognized = set(renderer.site_source_paths())

manifest = json.loads(pathlib.Path("release/public-alpha.json").read_text(encoding="utf-8"))
count = 0
for authorization in manifest.get("authorizations", {}).values():
    site_sources = authorization.get("site_sources", {})
    for source, recorded in site_sources.items():
        path = pathlib.Path(source)
        if source not in recognized:
            count += 1
        elif not path.is_file() or hashlib.sha256(path.read_bytes()).hexdigest() != recorded:
            count += 1
    count += len(recognized - set(site_sources))
    record = pathlib.Path(authorization["rights_record"])
    if hashlib.sha256(record.read_bytes()).hexdigest() != authorization["rights_record_sha256"]:
        count += 1
print(count)
PY
)"
if [ "$expected" -ne "$divergences" ]; then
	echo "status named $divergences divergence(s); the manifest holds $expected" >&2
	exit 1
fi

# The report is byte-stable for unchanged release records, stale or exact.
run_tool status >"$sandbox/status-again.txt" || true
if ! cmp -s "$sandbox/status.txt" "$sandbox/status-again.txt"; then
	echo "status output is not byte-stable across runs" >&2
	exit 1
fi

# Each writing verb states its own required arguments without doing any work.
approve_usage="$(run_tool approve --help)"
case "$approve_usage" in
*--note*) ;;
*)
	echo "approve does not document its operator note" >&2
	exit 1
	;;
esac

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $*" >&2
		exit 1
	fi
}

# A verb is required, and only the five named verbs exist.
reject
reject bogus
reject status --bogus
# An approval without the operator's instruction note is refused at parse time,
# before the manifest is opened, so nothing is recorded.
reject approve
reject approve --note ""
# A new publication record needs its provider, id, and catalog named.
reject add-publication
reject add-publication --provider gpt
reject add-publication --provider gpt --id nonesuch-leaf

echo ok
