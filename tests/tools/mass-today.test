#!/bin/sh
# Test for `tools/tpt mass-today`: exit 0 = pass (the stable gate).
# The tool writes nothing at all: it resolves a date with `calendar-rubrics`,
# the propers with `mass-propers` and the Ordinary with `mass-ordinary`, and
# prints. So every invocation here runs against the repository itself and no
# sandbox is needed for anything but the files this test compares.
#
# THE ASSERTIONS THAT MATTER ARE THE ONES ABOUT WHAT IS NOT SAID. This tool's
# characteristic failure is not a crash: it is a Mass that reads correctly and
# is not the one appointed — a displaced formulary printed as the day's, a
# placeholder printed under the heading `Collect`, a proper silently dropped
# because the entry pointed at a Common, or four Christmas formularies poured
# into one Ordinary as though they were one Mass. Nothing looks wrong when any
# of that happens, so each is checked here rather than trusted.
set -eu

repo="$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)"
tool="$repo/tools/tpt"
tool_id="mass-today"

run_tool() {
	"$tool" "$tool_id" "$@"
}

run_tool --help >/dev/null

sandbox="$(mktemp -d)"
trap 'rm -rf "$sandbox"' EXIT INT TERM

# ---- The terse mode -------------------------------------------------------
#
# A settled Sunday: one Mass, its propers named, each scripture proper carrying
# the citation the Missal prints rather than an empty slot.
terse="$(run_tool show --date 2026-11-29 --calendar roman-1962)"
for want in "roman-1962" "First Sunday of Advent" "Introit" "Epistle — Romans 13:11-14"; do
	case "$terse" in
	*"$want"*) ;;
	*)
		echo "terse output is missing: $want" >&2
		exit 1
		;;
	esac
done

# Inspect structural provenance without executing an inherited formulary.
# mass-today must still refuse its foreign, unresolved source applicability.
status=0
run_tool show --date 2026-11-29 --calendar roman-pre-1955 --lang en \
	>"$sandbox/pre1955-refused.txt" 2>"$sandbox/pre1955-refused.err" || status=$?
if [ "$status" -ne 2 ]; then
	echo "foreign pre-1955 applicability should exit 2, got $status" >&2
	exit 1
fi
for want in \
	"unsupported foreign-source Proper applicability from roman-1962 in roman-pre-1955; source condition remains unresolved:" \
	"on Advent ferias using this Sunday Mass only the Gradual remains; omit the Alleluia and its following verse"; do
	if ! grep -qF "$want" "$sandbox/pre1955-refused.err"; then
		echo "pre-1955 refusal lost its source boundary: $want" >&2
		exit 1
	fi
done
# render() prints the date, calendar/formulary heading and recension context
# before calling mass_events(); that late seating refusal must print no Proper
# or Ordinary body. Match only the permitted prelude, allowing its line wraps,
# rather than mistaking those headers for an executed Mass.
python3 - "$sandbox/pre1955-refused.txt" "$repo" <<'PY'
import pathlib, re, sys
import yaml

out = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8")
lines = [line.strip() for line in out.splitlines() if line.strip()]
assert len(lines) >= 3, out
assert lines[0] == "2026-11-29", out
assert re.fullmatch(r"roman-pre-1955 — advent(?:, week 1)?", lines[1]), out
assert re.fullmatch(r"First Sunday of Advent(?: \([^()\n]+\))?", lines[2]), out
source = yaml.safe_load((
    pathlib.Path(sys.argv[2]) / "src/sources/calendars/roman-pre-1955/propers.yaml"
).read_text(encoding="utf-8"))
assert source["text_from"] == "roman-1962", source["text_from"]
assert source["recension_coverage"]["status"] == "partial"
prelude = [
    "Historical boundary — stands before: " + "; ".join(source["stands_before"]),
    "Recension coverage: partial",
    "Proper text source: roman-1962 (inherited, partial)",
    source["advisory"],
]
# Exact apparatus-only equality excludes every Proper heading/body, Bible text,
# Ordinary body and any claimed successful execution after the refusal.
assert " ".join(lines[3:]) == " ".join(" ".join(prelude).split()), out
PY
pre1955="$("$tool" mass-propers show --calendar roman-pre-1955 --mass advent-1 --lang en)"
for want in "Historical boundary" \
	"de-rubricis-simpliciorem-1955; maxima-redemptionis-1955" \
	"Recension coverage: partial" \
	"Proper text source: roman-1962 (inherited, partial)" \
	"not a complete 1920 corpus"; do
	case "$pre1955" in
	*"$want"*) ;;
	*) echo "pre-1955 day view is missing provenance: $want" >&2; exit 1 ;;
	esac
done
"$tool" mass-propers show --calendar roman-pre-1955 --mass advent-1 --lang en \
	--format json >"$sandbox/pre1955-day-provenance.json"
python3 - "$sandbox/pre1955-day-provenance.json" <<'PY'
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
assert document["advisory"].startswith("Partial pre-1955 projection")
assert document["stands_before"] == [
    "de-rubricis-simpliciorem-1955", "maxima-redemptionis-1955"
]
assert document["recension_coverage"]["status"] == "partial"
assert document["recension_coverage"]["inheritance"]["source_calendar"] == "roman-1962"
assert document["recension_coverage"]["inheritance"]["status"] == "partial"
assert document["mass"]["recension"]["calendar"] == "roman-1962"
assert document["mass"]["recension"]["text_from"] == "roman-1962"
assert document["mass"]["recension"]["stated"] is False
PY
palm1955="$("$tool" mass-propers show --calendar roman-pre-1955 --mass palm-sunday --plain)"
case "$palm1955" in
*"Departure act: maxima-redemptionis-1955"*"Additional departure act (reslotted): maxima-redemptionis-1955"*) ;;
*) echo "pre-1955 departure act stations are missing from structural inspection" >&2; exit 1 ;;
esac

# A citation-backed postconciliar antiphon may carry a short Latin incipit as
# identifying apparatus while carrying no English Missal rendering.  The
# compact English view must not print that Latin as though it answered the
# language request or as though an incipit were the complete proper.
postconciliar_terse="$(run_tool show --date 2026-11-29 \
	--calendar postconciliar --lang en --plain)"
case "$postconciliar_terse" in
*"Latin incipit only; no en rendering recorded: Ad te levavi"*) ;;
*)
	echo "postconciliar English output does not label its Latin incipit" >&2
	exit 1
	;;
esac
case "$postconciliar_terse" in
*"      Ad te levavi"*)
	echo "postconciliar English output prints a bare Latin incipit" >&2
	exit 1
	;;
esac

# A date the rubrics settle must NOT be reported as unranked. This sentence was
# printed over Easter Sunday, beside a third-class confessor offered as an
# equal candidate, until the ranking moved to `calendar-rubrics day`.
easter="$(run_tool show --date 2026-04-05 --calendar roman-1962)"
case "$easter" in
*"no precedence is stated"*)
	echo "a settled date was reported as unranked" >&2
	exit 1
	;;
esac
case "$easter" in
*"Easter Sunday"*) ;;
*)
	echo "Easter Sunday is not the Mass of Easter Sunday" >&2
	exit 1
	;;
esac
# ...and the confessor it displaces is still shown, and still says so. A Mass
# dropped because it is not said is a Mass the reader cannot check.
case "$easter" in
*"NOT said today; displaced by the Mass above"*) ;;
*)
	echo "a displaced formulary is not marked as displaced" >&2
	exit 1
	;;
esac

# An implied feria has its appointed Mass on winner.formulary rather than on
# winner.key.  It is still a settled day and must therefore select that Mass
# and assemble its Ordinary instead of reporting a synthetic day-unsettled
# suppression.
run_tool show --date 2026-08-26 --calendar roman-1962 --ordinary --json \
	>"$sandbox/implied-feria.json"
/usr/bin/python3 - "$sandbox/implied-feria.json" <<'PY'
import json, sys

day = json.load(open(sys.argv[1], encoding="utf-8"))["days"][0]
assert day["selected_mass"] == "pentecost-13", day
assert day["branches"][0]["selected_mass"] == "pentecost-13", day
assert "ordinary_suppressed" not in day, day
assert day["ordinary"]["calendar"] == "roman-1962", day["ordinary"]
PY

# Loading the translation ledger for an unrelated settled date must continue
# to succeed when another mass has occurrence-aware publication TSV bindings.
# This JSON is the canonical inherited record: it lists the regular, Tract
# and Paschal alternatives, NOT execution of every alternative on August19.
# The source Common has BOTH James1:12 and Sirach45:9 in its Paschal Alleluia.
run_tool show --date 2026-08-19 --calendar roman-1962 --lang en \
	--bible douay-rheims --json \
	>"$sandbox/unrelated-occurrence-binding.json"
/usr/bin/python3 - "$sandbox/unrelated-occurrence-binding.json" <<'PY'
import json, sys

payload = json.load(open(sys.argv[1], encoding="utf-8"))
assert payload["status"] == "ok", payload
assert payload["date"] == "2026-08-19", payload
mass = payload["days"][0]["branches"][0]["masses"][0]
assert mass["key"] == "s-ioannis-eudes-confessoris", mass
verses = [verse for proper in mass["propers"] for verse in proper.get("verses", [])]
expected = [
    ("Introit", "Psalms 36:30-31"),
    ("Introit", "Psalms 36:1"),
    ("Lesson", "Sirach 31:8-11"),
    ("Gradual", "Psalms 91:13-14"),
    ("Gradual", "Psalms 91:3"),
    ("Alleluia", "James 1:12"),
    ("Tract", "Psalms 111:1-3"),
    ("Alleluia (Tempore paschali)", "James 1:12"),
    ("Alleluia (Tempore paschali)", "Sirach 45:9"),
    ("Gospel", "Luke 12:35-40"),
    ("Offertory", "Psalms 88:25"),
    ("Communion", "Matthew 24:46-47"),
]
assert len(verses) == len(expected) == len(set(expected)) == 12, verses
assert [
    (proper["name"], verse["ref"])
    for proper in mass["propers"] for verse in proper.get("verses", [])
] == expected, mass
assert all(verse.get("text") for verse in verses), verses
assert mass["bible"] == {
    "id": "douay-rheims",
    "edition": "The Holy Bible, Douay-Rheims (Challoner revision), Project Gutenberg eBook 1581",
}, mass["bible"]
PY

# The reviewed ferial-use source now appoints the preceding Sunday on this
# settled implied feria. Preserve that positive appointment and exercise the
# unavailable-formulary suppression independently with a synthetic sibling
# result, so a later source recovery cannot erase the negative control.
run_tool show --date 2027-05-03 --calendar roman-1962 --ordinary --json \
	>"$sandbox/implied-feria-without-formulary.json"
/usr/bin/python3 - "$sandbox/implied-feria-without-formulary.json" "$repo/tools/mass-today" <<'PY'
import importlib.machinery, importlib.util, json, sys
from types import SimpleNamespace
from unittest.mock import patch

day = json.load(open(sys.argv[1], encoding="utf-8"))["days"][0]
assert day["settled"] is True, day
assert day["selected_mass"] == "easter-5", day
assert "ordinary_suppressed" not in day, day
assert day["ordinary"]["calendar"] == "roman-1962", day
winner = day["branches"][0]["winner"]
assert winner["source"] == "implied", winner
assert winner["formulary"]["key"] == "easter-5", winner

loader = importlib.machinery.SourceFileLoader("mass_today_missing_form_fixture", sys.argv[2])
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
args = SimpleNamespace(date="2027-05-03", calendar="roman-1962", ordinary=True,
    expanded=False, bible=None, lang=None, json=True, format="json", form=None,
    ordinary_variant=None, territory=None, mass=None, why=False, rubrics=True)
missing = {"days": [{"calendar": "roman-1962", "options": [{
    "settled": True, "winner": {"source": "implied", "key": None, "formulary": None},
    "readable": [],
}]}]}
with patch.object(module, "invoke", return_value=missing) as sibling:
    absent_day = module.run_show(args)["days"][0]
sibling.assert_called_once_with("calendar-rubrics", ["day", "--date", "2027-05-03", "--calendar", "roman-1962"])
assert absent_day["settled"] is True and absent_day["selected_mass"] is None, absent_day
assert absent_day["ordinary_suppressed"] == {"kind": "ferial-formulary-unavailable"}, absent_day
assert absent_day["masses"] == [] and "ordinary" not in absent_day, absent_day
PY

# ---- The expanded mode ----------------------------------------------------
#
# The whole Mass in one piece: scripture in words, under a named edition, with
# the propers set into the Ordinary at the places the missal appoints.
# The resolved Roman1962 Sunday is the safe appointment, not a permission
# upgrade for the structural-only pre-1955 inheritance inspected above.
run_tool show --date 2026-11-29 --calendar roman-1962 --json \
	>"$sandbox/expanded-appointment.json"
python3 - "$sandbox/expanded-appointment.json" <<'PY'
import json, sys

document = json.load(open(sys.argv[1], encoding="utf-8"))
assert document["status"] == "ok", document
day, = document["days"]
assert day["settled"] is True, day
assert day["selected_mass"] == "advent-1", day
assert day["branches"][0]["selected_mass"] == "advent-1", day
PY
expanded="$(run_tool show --date 2026-11-29 --calendar roman-1962 --expanded)"

# Scripture is resolved, and the edition it was resolved from is printed. An
# unattributed scripture text is the one thing a citation may never resolve to.
case "$expanded" in
*"scripture read from "*) ;;
*)
	echo "expanded does not name the bible it read scripture from" >&2
	exit 1
	;;
esac
case "$expanded" in
*"To thee, O Lord, have I lifted up my soul"*) ;;
*)
	echo "expanded printed a citation with no words behind it" >&2
	exit 1
	;;
esac

# The postconciliar Lectionary cycle belongs to the resolved date. Advent begins
# Year B on 29 November 2026, so the expanded Mass must print Year B's readings
# rather than leave the cycle-bearing slots empty or print all three years.
cycled="$(run_tool show --date 2026-11-29 --calendar postconciliar \
	--bible douay-rheims --expanded --plain)"
for want in \
	"First Reading -- Isaiah 63:16b-17, 19b; 64:2b-7" \
	"Second Reading -- 1 Corinthians 1:3-9" \
	"Gospel -- Mark 13:33-37" \
	"The Nicene Creed (all)" \
	"ordinary applicability unresolved at ritus-initiales/gloria-in-excelsis" \
	"Take ye heed, watch and pray"; do
	case "$cycled" in
	*"$want"*) ;;
	*)
		echo "postconciliar Year B output is missing: $want" >&2
		exit 1
		;;
	esac
done
case "$cycled" in
*"Matthew 24:37-44"*|*"Luke 21:25-28, 34-36"*)
	echo "postconciliar Year B output includes another Sunday's cycle" >&2
	exit 1
	;;
esac

# Ordinary Time weekdays use the independent I/II Lectionary course. The
# source proper retains both variants, while the appointed top-level verses
# must be exactly the variant for the resolved liturgical year. This used to
# inspect only `cycles`, so every `weekday_cycles` slot reached this payload
# with an empty top-level `verses` list.
run_tool show --date 2027-08-26 --calendar postconciliar --why --json \
	>"$sandbox/weekday-i.json"
run_tool show --date 2026-08-26 --calendar postconciliar --why --json \
	>"$sandbox/weekday-ii.json"
run_tool show --date 2026-08-30 --calendar postconciliar --why --json \
	>"$sandbox/sunday-a.json"
/usr/bin/python3 - "$sandbox/weekday-i.json" "$sandbox/weekday-ii.json" \
	"$sandbox/sunday-a.json" <<'PY'
import json
import sys


def load(path):
    with open(path, encoding="utf-8") as source:
        payload = json.load(source)
    day = payload["days"][0]
    propers = {proper["name"]: proper for proper in day["masses"][0]["propers"]}
    return day, propers


def refs(proper):
    return [verse["ref"] for verse in proper.get("verses", [])]


cycle_i, propers_i = load(sys.argv[1])
assert cycle_i["why"]["lectionary"]["weekday"] == "I", cycle_i["why"]
assert refs(propers_i["First Reading"]) == ["1 Thessalonians 3:7-13"], propers_i
assert refs(propers_i["Responsorial Psalm"]) == [
    "Psalm 90:3-4, 12-13, 14, 17"
], propers_i
assert sorted(propers_i["First Reading"]["weekday_cycles"]) == ["I", "II"]
# A slot with no cycle mapping remains on its one annual course.
assert refs(propers_i["Gospel"]) == ["Matthew 24:42-51"], propers_i
assert "cycles" not in propers_i["Gospel"]
assert "weekday_cycles" not in propers_i["Gospel"]

cycle_ii, propers_ii = load(sys.argv[2])
assert cycle_ii["why"]["lectionary"]["weekday"] == "II", cycle_ii["why"]
assert refs(propers_ii["First Reading"]) == [
    "2 Thessalonians 3:6-10, 16-18"
], propers_ii
assert refs(propers_ii["Responsorial Psalm"]) == ["Psalm 128:1-2, 4-5"], propers_ii
assert sorted(propers_ii["First Reading"]["weekday_cycles"]) == ["I", "II"]
assert refs(propers_ii["Gospel"]) == ["Matthew 23:27-32"], propers_ii

sunday_a, propers_a = load(sys.argv[3])
assert sunday_a["why"]["lectionary"]["sunday"] == "A", sunday_a["why"]
assert refs(propers_a["First Reading"]) == ["Jeremiah 20:7-9"], propers_a
assert sorted(propers_a["First Reading"]["cycles"]) == ["A", "B", "C"]
assert "weekday_cycles" not in propers_a["First Reading"]
PY

# The reading view is the surface `tpt` dumps for a person, so hold the same
# boundary there: Cycle II is printed and Cycle I is not quietly appended.
weekday_expanded="$(run_tool show --date 2026-08-26 --calendar postconciliar \
	--bible douay-rheims --expanded --plain)"
for want in \
	"First Reading -- 2 Thessalonians 3:6-10, 16-18" \
	"Responsorial Psalm -- Psalm 128:1-2, 4-5"; do
	case "$weekday_expanded" in
	*"$want"*) ;;
	*)
		echo "postconciliar Cycle II output is missing: $want" >&2
		exit 1
		;;
	esac
done
case "$weekday_expanded" in
*"1 Thessalonians 2:9-13"*|*"Psalm 139:7-8, 9-10, 11-12ab"*)
	echo "postconciliar Cycle II output includes Cycle I" >&2
	exit 1
	;;
esac

# With no Ordinary variant named, the CLI keeps the same default the browser
# reads from the file: Eucharistic Prayer I. Its source-owned internal
# elements must all remain in that branch rather than collapsing back to one
# aggregate label.
for want in \
	"Eucharistic Prayer I -- Te igitur (priest)" \
	"Eucharistic Prayer I -- Per quem haec omnia (priest)"; do
	case "$cycled" in
	*"$want"*) ;;
	*)
		echo "postconciliar default Ordinary lost Eucharistic Prayer I: $want" >&2
		exit 1
		;;
	esac
done

# The browser can select a non-default option from the Ordinary's declared
# variant group. The terminal must select the same one, and only that one.
third="$(run_tool show --date 2026-11-29 --calendar postconciliar \
	--bible douay-rheims --expanded --plain --ordinary-variant ep-iii)"
for want in \
	"Eucharistic Prayer III (priest)" \
	"opens Vere Sanctus es, Domine, et merito te laudat"; do
	case "$third" in
	*"$want"*) ;;
	*)
		echo "postconciliar ep-iii output is missing: $want" >&2
		exit 1
		;;
	esac
done
case "$third" in
*"Eucharistic Prayer I --"*|*"Eucharistic Prayer II (priest)"*|*"Eucharistic Prayer IV (priest)"*)
	echo "postconciliar ep-iii output includes another Eucharistic Prayer" >&2
	exit 1
	;;
esac

# Independent Ordinary choices compose as a map, not as one global option.
# Form III already contains the Kyrie acclamations, so the following Kyrie is
# omitted while the independently selected Eucharistic Prayer remains III.
multi_variant="$(run_tool show --date 2026-11-29 --calendar postconciliar \
	--bible douay-rheims --expanded --plain \
	--ordinary-variant pa-iii --ordinary-variant ep-iii)"
for want in "Penitential Act, form III (all)" "Eucharistic Prayer III (priest)" \
	"The Second Reading" "Second Reading -- 1 Corinthians 1:3-9"; do
	case "$multi_variant" in
	*"$want"*) ;;
	*) echo "independent Ordinary choices lost: $want" >&2; exit 1 ;;
	esac
done
case "$multi_variant" in
*"Penitential Act, form I (all)"*|*"Penitential Act, form II (all)"*|*"Kyrie eleison"*)
	echo "Penitential Act III output includes a mutually exclusive branch" >&2
	exit 1
	;;
esac

# This corpus does not model proper Prefaces, so it cannot positively establish
# when Prayer IV is permitted. An explicit selection remains selected but is
# suppressed with an unresolved applicability result; Prayer I is not used as
# a silent fallback.
ep_four="$(run_tool show --date 2026-11-29 --calendar postconciliar \
	--expanded --plain --ordinary-variant ep-iv)"
case "$ep_four" in
*"ordinary applicability unresolved at prex-eucharistica/prex-eucharistica-iv"*) ;;
*) echo "Prayer IV did not expose its unresolved Preface condition" >&2; exit 1 ;;
esac
case "$ep_four" in
*"Eucharistic Prayer IV (priest)"*|*"Eucharistic Prayer I --"*)
	echo "unresolved Prayer IV printed text or silently fell back to Prayer I" >&2
	exit 1
	;;
esac

if run_tool show --date 2026-11-29 --calendar postconciliar --expanded \
	--ordinary-variant not-an-ordinary-option >/dev/null 2>&1; then
	echo "an unknown Ordinary option was accepted" >&2
	exit 1
fi

# Machine output does not contain a selected/rendered Ordinary. It must refuse
# a selection flag instead of accepting and silently ignoring either a valid
# or invalid option id.
for machine_variant in ep-iii not-an-ordinary-option; do
	if run_tool show --date 2026-11-29 --calendar postconciliar \
		--format json --ordinary-variant "$machine_variant" \
		>/dev/null 2>&1; then
		echo "machine output silently ignored Ordinary option: $machine_variant" >&2
		exit 1
	fi
done

# The Ordinary is INTERLEAVED, not appended: each proper stands where the
# missal's own slot declaration puts it. Checked by order rather than by
# presence, because an appended Ordinary contains all the same words.
python3 - <<'PY'
import subprocess, pathlib

out = subprocess.run(
    ["tools/mass-today", "show", "--date", "2026-11-29",
     "--calendar", "roman-1962", "--expanded"],
    capture_output=True, text=True, cwd=pathlib.Path.cwd(),
)
assert out.returncode == 0, out.stderr
lines = out.stdout.splitlines()


def at(needle):
    """The first line whose whole stripped text starts with `needle`.

    Matched at the head of a line rather than anywhere in it, because the
    Ordinary's rubrics NAME the propers they introduce — "reads the INTROIT",
    "Kyrie eleison ... are alternately sung" — and a substring search finds the
    rubric that mentions a thing before the thing itself.
    """
    for index, line in enumerate(lines):
        if line.strip().startswith(needle):
            return index
    raise AssertionError(f"not printed: {needle}")


# The frame's own elements and the day's propers, in the order the Mass is
# said. If the Ordinary were appended, every proper would precede every
# element instead.
introit = at("Introit —")
kyrie = at("Kyrie eleison (priest)")
collect = at("Collect")
canon = at("The Canon of the Mass")
communion = at("Communion —")
assert introit < kyrie, ("Introit is not before the Kyrie", introit, kyrie)
assert kyrie < collect, ("the Kyrie is not before the Collect", kyrie, collect)
assert collect < canon < communion, (collect, canon, communion)

# A rubric is set apart from a prayer. The two rubrics bracketing the Placeat
# read as its first and last lines until this held.
placeat = at("Placeat tibi sancta Trinitas")
bowing = at("[ Bowing before the Altar")
assert bowing < placeat, (bowing, placeat)
assert not lines[placeat + 1].strip().startswith("["), lines[placeat + 1]
PY

# The priest's actions can be hidden — and hiding them may not move a proper,
# because the slots are anchored to those very rubrics.
hidden="$(run_tool show --date 2026-11-29 --calendar roman-1962 --expanded --no-rubrics)"
case "$hidden" in
*"Bowing before the Altar"*)
	echo "--no-rubrics did not hide the priest's actions" >&2
	exit 1
	;;
esac
for want in "Introit — Psalm 24:1-3" "Collect" "Gospel — Luke 21:25-33"; do
	case "$hidden" in
	*"$want"*) ;;
	*)
		echo "hiding the rubrics unseated a proper: $want" >&2
		exit 1
		;;
	esac
done

# ---- The days that break the frame ----------------------------------------
#
# The Good Friday service has no Mass frame. The Easter Vigil includes a Mass,
# but its Kyrie continues the divided Litany and the source bundles that Mass
# with the preceding Vigil and following Lauds, so the generic frame remains
# unavailable. Assert the typed distinction rather than presentation prose.
run_tool show --date 2026-04-03 --calendar roman-1962 --ordinary --json \
	>"$sandbox/roman-good-friday.json"
run_tool show --date 2026-04-04 --calendar roman-1962 --ordinary --json \
	>"$sandbox/roman-easter-vigil.json"
python3 - "$sandbox/roman-good-friday.json" \
	"$sandbox/roman-easter-vigil.json" <<'PY'
import json
import sys

cases = zip(
    sys.argv[1:],
    ("good-friday", "easter-vigil"),
    ("none", "unavailable"),
)
for path, key, applicability in cases:
    day = json.load(open(path, encoding="utf-8"))["days"][0]
    assert day["selected_mass"] == key, day
    frame = day["ordinary_frame"]
    assert frame["applicability"] == applicability, frame
    assert isinstance(frame["basis"], str) and frame["basis"].strip(), frame
    assert day["ordinary_suppressed"] == {
        "kind": "ordinary-frame",
        "applicability": applicability,
        "basis": frame["basis"],
    }, day
    assert "ordinary" not in day, day
PY

# Ember Saturday has two source-authored forms and no default.  The unselected
# view is a typed choice with no flat Proper sequence or Ordinary; each stable
# selector yields only its own subsequence.
run_tool show --date 2026-12-19 --calendar roman-1962 --json \
	>"$sandbox/ember-unselected.json"
run_tool show --date 2026-12-19 --calendar roman-1962 --form longer --json \
	>"$sandbox/ember-longer.json"
run_tool show --date 2026-12-19 --calendar roman-1962 --form shorter --json \
	>"$sandbox/ember-shorter.json"
/usr/bin/python3 - "$sandbox/ember-unselected.json" "$sandbox/ember-longer.json" \
	"$sandbox/ember-shorter.json" <<'PY'
import json
import sys

unselected, longer, shorter = [json.load(open(path, encoding="utf-8")) for path in sys.argv[1:]]
mass = unselected["days"][0]["masses"][0]
assert mass["key"] == "advent-ember-saturday"
assert mass["form_choice_required"] is True
assert "selected_form" not in mass
assert mass["propers"] == []
assert "ordinary" not in unselected["days"][0]
assert [(form["id"], len(form["propers"])) for form in mass["forms"]] == [
    ("longer", 24), ("shorter", 12),
]
for payload, wanted, count, oratio_count in (
    (longer, "longer", 24, 5), (shorter, "shorter", 12, 1),
):
    selected = payload["days"][0]["masses"][0]
    assert selected["selected_form"] == wanted
    assert selected["form_choice_required"] is False
    assert len(selected["propers"]) == count
    assert {proper["form_id"] for proper in selected["propers"]} == {wanted}
    assert sum(proper["name"] == "Oratio" for proper in selected["propers"]) == oratio_count
PY

# The postconciliar Good Friday service has no Mass frame; the Easter Vigil has
# a Eucharist, but its branch-sensitive composite order cannot be represented
# by the current full-frame contract. Both must suppress rather than borrow the
# normal Ordinary, and the two different absence meanings must survive JSON.
run_tool show --date 2027-03-26 --calendar postconciliar --ordinary --json \
	>"$sandbox/postconciliar-good-friday.json"
run_tool show --date 2027-03-27 --calendar postconciliar --ordinary --json \
	>"$sandbox/postconciliar-easter-vigil.json"
python3 - "$sandbox/postconciliar-good-friday.json" \
	"$sandbox/postconciliar-easter-vigil.json" <<'PY'
import json
import sys

cases = zip(
    sys.argv[1:],
    ("good-friday", "easter-vigil"),
    ("none", "unavailable"),
)
for path, key, applicability in cases:
    day = json.load(open(path, encoding="utf-8"))["days"][0]
    assert day["selected_mass"] == key, day
    frame = day["ordinary_frame"]
    assert frame["applicability"] == applicability, frame
    assert isinstance(frame["basis"], str) and frame["basis"].strip(), frame
    assert day["ordinary_suppressed"] == {
        "kind": "ordinary-frame",
        "applicability": applicability,
        "basis": frame["basis"],
    }, day
    assert "ordinary" not in day, day
PY

# ---- Absence, placeholders and provenance ---------------------------------
#
# These days appoint their own text-free, rights-withheld Collects, not the
# Common's different Collect and not a mass-level unavailable formulary. Check
# the source identity, public absence and both actual expanded language views;
# Secret and Postcommunion must remain the independently inherited Common.
for candidate in 2027-06-17 2027-07-21 2027-10-23; do
    for language in en la; do
        run_tool show --date "$candidate" --calendar roman-1962 --lang "$language" \
            --expanded --plain >"$sandbox/own-collect-$candidate.$language.txt"
        run_tool show --date "$candidate" --calendar roman-1962 --lang "$language" \
            --json >"$sandbox/own-collect-$candidate.$language.json"
    done
done
python3 - "$sandbox" "$repo" <<'PY'
import hashlib
import importlib.machinery
import importlib.util
import json
import pathlib
import re
import sys
from types import SimpleNamespace
import yaml

root, repo = map(pathlib.Path, sys.argv[1:])
source = yaml.safe_load((repo / "src/sources/calendars/roman-1962/propers.yaml").read_text(encoding="utf-8"))
by_key = {mass["key"]: mass for section in source["sections"].values() for mass in section.get("masses", [])}
# Source-derived pins, not hashes captured from the CLI's current output.
own_collect_cases = {
    "2027-06-17": (
        "s-gregorii-barbadici-episcopi-confessoris", "commune-confessoris-pontificis-1",
        "8810ec128f175a58303e5a367b14358d4d357d8033034755aa68d5c8db81f38f",
    ),
    "2027-07-21": (
        "s-laurentii-brundusio-confessoris-ecclesiae-doctoris", "commune-doctorum-non-pontificis",
        "7c1131275d78e601c529474267a92057f464ebdb8b48c90a9cbe75418672c1e7",
    ),
    "2027-10-23": (
        "s-antonii-mariae-claret-episcopi-confessoris", "commune-confessoris-pontificis-2",
        "ae2d6dd52d53fbea12ceccb1dbc6cf470cad5f648119e8d1179f7ebdee79a1fa",
    ),
}
loader = importlib.machinery.SourceFileLoader("today_own_collect_render", str(repo / "tools/mass-today"))
spec = importlib.util.spec_from_loader(loader.name, loader)
today = importlib.util.module_from_spec(spec)
loader.exec_module(today)
plain_style = SimpleNamespace(heading=lambda head: [head], note=lambda note: note)
fold = lambda text: " ".join(text.split())

def source_oration(key, name):
    owner = by_key[key]
    matches = [proper for proper in owner.get("propers", []) if proper["name"] == name]
    if matches:
        proper, = matches
        return proper
    # The non-bishop Doctor Common takes its Collect from the bishop Doctor
    # Common, but prints its own Secret/Postcommunion. Do not flatten that into
    # three newly owned prayers for the dated saint.
    return source_oration(owner["takes_from"]["mass"], name)

def check_own_collect(candidate, language, payload, rendered):
    key, common, excluded_hash = own_collect_cases[candidate]
    declared = by_key[key]
    own, = declared["propers"]
    assert declared["date"] == candidate[5:] and declared["takes_from"]["mass"] == common
    assert own["name"] == "Collect" and own["source"] == "composed"
    assert own["text_status"] == {
        "state": "unavailable", "scope": "proper-body", "body_status": "held-unpublished",
        "reasons": [{
            "kind": "rights-withheld",
            "source_id": "artifact.catholic-church.missale-romanum.vatican-typica-1962.cmaa-facsimile-pdf",
        }],
    }, own
    assert not any(own.get(field) for field in ("text", "translations", "verses")), own
    excluded = source_oration(common, "Collect")["text"]
    assert hashlib.sha256(excluded.encode("utf-8")).hexdigest() == excluded_hash
    assert payload["status"] == "ok" and payload["problems"] == [], payload
    assert payload["date"] == candidate and payload["language"]["requested"] == language
    day, = payload["days"]
    assert day["calendar"] == "roman-1962" and day["selected_mass"] == key, day
    mass, = [mass for mass in day["masses"] if mass["key"] == key]
    assert mass["selected"] is True and mass["selected_form"] == "main", mass
    assert mass["takes_from"] == declared["takes_from"] and mass["text_status"] is None, mass
    assert mass["placeholders"] == 0 and not mass["form_choice_required"], mass
    propers = mass["propers"]
    assert not any(proper["name"] == "Placeholder" for proper in propers), propers
    collect, = [proper for proper in propers if proper["name"].split(" (", 1)[0] == "Collect"]
    assert set(collect) == {
        "name", "source", "notes", "text_status", "latin", "verses",
        "form", "form_id", "taken_from", "language_selection", "unavailable_translations",
    } | ({"incipit"} if "incipit" in own else set()), collect
    assert collect["name"] == "Collect" and collect["source"] == "composed", collect
    assert collect["taken_from"] is None and collect["form"] is None and collect["form_id"] == "main", collect
    assert collect["notes"] == own["notes"] and collect.get("incipit") == own.get("incipit"), collect
    assert collect["text_status"] == {"state": "unavailable", "scope": "proper-body"}, collect
    assert "text" not in collect and "translations" not in collect and collect["verses"] == [], collect
    assert collect["unavailable_translations"] == [], collect
    assert collect["latin"] == {
        "target": "Collect", "state": "unavailable", "held": False, "available": False, "withheld": True,
    }, collect
    reason = (
        {"state": "text-withheld", "lang": "la"} if language == "la" else {
            "state": "ledgered-untranslated",
            "records": [{"state": "ledgered-untranslated", "lang": "en", "unavailableState": "unavailable"}],
        }
    )
    assert collect["language_selection"] == {
        "requested": language, "status": "unavailable" if language == "la" else "absent",
        "held": False, "available": False, "complete": False, "reason": reason,
    }, collect
    for name in ("Secret", "Postcommunion"):
        inherited, = [proper for proper in propers if proper["name"] == name]
        assert inherited["taken_from"] == {
            "mass": common, "form": "", "proper": name, "citation": declared["takes_from"]["citation"],
        }, inherited
        assert inherited["text"] == source_oration(common, name)["text"], inherited
        assert inherited["latin"]["withheld"] is False
        assert inherited["latin"]["publication"]["status"] == "permitted"
    message = "Latin text unavailable" if language == "la" else "No English or Latin body is held here."
    # Check the complete proper fragment against a closed independent
    # expectation. The following Ordinary rubric is not part of the Collect.
    fragment = today.proper_lines(
        collect, plain_style, "", lang=language, witness=None, seat=None, why=False,
    )
    assert [line.strip() for line in fragment if line.strip()] == ["Collect", message], fragment
    assert re.search(r"(?m)^([ \t]*)Collect\n\1  " + re.escape(message) + r"\n(?=\n)", rendered), rendered
    assert fold(excluded) not in fold(rendered), candidate
    for forbidden in (
        "This entry is a placeholder", "placeholder: this Mass's text", "proper collect unavailable:",
    ):
        assert forbidden not in fold(rendered), (candidate, forbidden)

for candidate in own_collect_cases:
    for language in ("en", "la"):
        stem = root / f"own-collect-{candidate}.{language}"
        check_own_collect(
            candidate, language,
            json.loads(stem.with_suffix(stem.suffix + ".json").read_text(encoding="utf-8")),
            stem.with_suffix(stem.suffix + ".txt").read_text(encoding="utf-8"),
        )
    print(f"# own text-free Collect checked in English and Latin: {candidate}")
PY

# ---- The tiers ------------------------------------------------------------
#
# Plain is reachable by flag whatever the terminal is, and contains no byte
# above 0x7F. Detection itself is tested by table in
# tools/tests/test_terminal_tiers.py, from any machine.
run_tool show --date 2026-11-29 --calendar roman-1962 --expanded --plain >"$sandbox/plain.txt"
if LC_ALL=C grep -q '[^ -~	]' "$sandbox/plain.txt"; then
	echo "--plain printed a byte above 0x7F" >&2
	LC_ALL=C grep -n '[^ -~	]' "$sandbox/plain.txt" | head -3 >&2
	exit 1
fi
for want in "V." "--" "First Sunday of Advent"; do
	if ! grep -q -- "$want" "$sandbox/plain.txt"; then
		echo "--plain lost something it should have folded: $want" >&2
		exit 1
	fi
done

# The machine forms are machine forms: identical whatever the terminal says,
# because a capability layer has no business in a contract another tool reads.
run_tool show --date 2026-11-29 --calendar roman-1962 --json >"$sandbox/one.json"
run_tool show --date 2026-11-29 --calendar roman-1962 --json --plain >"$sandbox/two.json"
run_tool show --date 2026-11-29 --calendar roman-1962 --json --style rich >"$sandbox/three.json"
if ! cmp -s "$sandbox/one.json" "$sandbox/two.json" || ! cmp -s "$sandbox/one.json" "$sandbox/three.json"; then
	echo "--json is not byte-identical across tiers" >&2
	exit 1
fi
for want in '"date"' '"days"' '"masses"' '"propers"'; do
	if ! grep -q "$want" "$sandbox/one.json"; then
		echo "payload is missing $want" >&2
		exit 1
	fi
done

# Machine output stays the canonical record until a language is explicitly
# selected. `--lang` then adds a projection beside every proper, so English
# and Latin dumps cannot be byte-identical silent no-ops.
run_tool show --date 2026-11-29 --calendar roman-1962 --lang en --json \
	>"$sandbox/lang-en.json"
run_tool show --date 2026-11-29 --calendar roman-1962 --lang la --json \
	>"$sandbox/lang-la.json"
run_tool show --date 2026-11-29 --calendar postconciliar --lang en --json \
	>"$sandbox/lang-post-en.json"
run_tool show --date 2027-06-13 --calendar postconciliar --lang en --json \
	>"$sandbox/lang-post-ot11-en.json"
/usr/bin/python3 - "$sandbox/one.json" "$sandbox/lang-en.json" \
	"$sandbox/lang-la.json" "$sandbox/lang-post-en.json" "$repo/tools/mass-today" <<'PY'
import copy
import importlib.machinery
import importlib.util
import json
import sys


def load(path):
    with open(path, encoding="utf-8") as source:
        return json.load(source)


canonical, english, latin, post = map(load, sys.argv[1:5])
assert canonical["language"] == {
    **canonical["language"], "mode": "canonical-record", "requested": None,
    "selection": None,
}
assert english["language"]["mode"] == "language-projection"
assert english["language"]["requested"] == "en"
assert latin["language"]["requested"] == "la"
assert english != latin


def propers(payload):
    return [
        proper
        for day in payload["days"]
        for mass in day["masses"]
        for proper in mass["propers"]
    ]


assert all("language_selection" not in proper for proper in propers(canonical))
for payload, requested in ((english, "en"), (latin, "la"), (post, "en")):
    for proper in propers(payload):
        assert proper["language_selection"]["requested"] == requested, proper
    for row in payload["language"]["available"]:
        statuses = row["statuses"]
        assert row["units"] == sum(statuses.values()), row
        # Public capability is inferred only from text this participation
        # surface actually carries. Typed withheld rows are always unheld.
        assert row["held"] == statuses["full-text"], row
        assert row["available"] == statuses["full-text"], row

plain = propers(canonical)
projected = copy.deepcopy(propers(english))
for proper in projected:
    proper.pop("language_selection")
assert projected == plain
post_selection = [proper["language_selection"] for proper in propers(post)]
assert any(one["status"] == "withheld" for one in post_selection), post_selection
assert all("texts" not in one for one in post_selection if one["status"] == "withheld")

# A mixed proper is not wholly delegated merely because it cites scripture;
# Latin fallback and incipit apparatus do not advertise English capability.
loader = importlib.machinery.SourceFileLoader("mass_today_language_test", sys.argv[5])
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
def absence(cycle, state="unavailable"):
    return {
        "target": {
            "mass": "demo", "form_id": "main", "proper": "Collect",
            "cycle": cycle, "occurrence": 1, "extent": "body",
        },
        "lang": "en", "state": state,
    }

fallback = module.language_projection({"source": "composed", "text": "Latin"}, "en", None)
assert fallback["status"] == "fallback-latin" and not fallback["held"]
incipit = module.language_projection({"source": "composed", "incipit": "Initium"}, "en", None)
assert incipit["status"] == "incipit-only" and not incipit["available"]
mixed = module.language_projection(
    {"source": "mixed", "verses": [{"ref": "Psalm 1:1"}]}, "en", None
)
assert mixed["status"] == "absent", mixed
delegated = module.language_projection(
    {"source": "scripture", "verses": [{"ref": "Psalm 1:1"}]}, "en", None
)
assert delegated["status"] == "scripture-delegated", delegated
withheld = module.language_projection(
    {"unavailable_translations": [{"lang": "en", "state": "rights-restricted"}]},
    "en", None,
)
assert withheld["status"] == "withheld" and not withheld["held"]
assert not withheld["available"] and "texts" not in withheld
quarantined = module.language_projection(
    {"unavailable_translations": [{"lang": "en", "state": "unavailable"}]},
    "en", None,
)
assert quarantined["status"] == "withheld" and not quarantined["held"]
assert quarantined["reason"] == [{"state": "unavailable", "lang": "en"}]
scoped = module.untranslated_reason({"untranslated": absence("C")})
assert scoped["records"] == [{
    "state": "ledgered-untranslated", "lang": "en",
    "unavailableState": "unavailable",
}], scoped
proper = {
    "untranslated": [
        absence("A"), absence("C", "rights-restricted"), absence("all"),
    ]
}
module.select_untranslated_records(proper, "C")
assert [row["target"]["cycle"] for row in proper["untranslated"]] == ["C", "all"]
assert module.untranslated_notes(proper) == [
    "en unavailable, cycle C: rights restricted",
    "en unavailable: unavailable",
]
for selected in ("A", "B", "C", "I", "II"):
    proper = {
        "untranslated": [
            absence("all"),
            *[absence(cycle) for cycle in ("A", "B", "C", "I", "II")],
        ]
    }
    module.select_untranslated_records(proper, selected)
    assert [row["target"]["cycle"] for row in proper["untranslated"]] == ["all", selected]
PY
/usr/bin/python3 - "$sandbox/lang-post-ot11-en.json" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as source:
    payload = json.load(source)
mass = next(
    mass
    for day in payload["days"]
    for mass in day["masses"]
    if mass["key"] == "ot-11"
)
rows = {
    proper["name"]: proper["language_selection"]
    for proper in mass["propers"]
}
for name in ("Collect", "Prayer after Communion"):
    selected = rows[name]
    assert selected == {
        "requested": "en",
        "status": "withheld",
        "held": False,
        "available": False,
        "complete": False,
        "reason": [{"state": "rights-restricted", "lang": "en"}],
    }, (name, selected)
PY
latin_unavailable="$(
    run_tool show --date 2027-06-13 --calendar postconciliar --lang la --expanded
)"
case "$latin_unavailable" in
*"Latin text unavailable"*) ;;
*)
    echo "withheld Latin lost its approved public message" >&2
    exit 1
    ;;
esac
case "$latin_unavailable" in
*"Latin body is unavailable for public display"*|*"publication"*|*"source_id"*)
    echo "withheld Latin exposed superseded or audit-facing detail" >&2
    exit 1
    ;;
esac
run_tool show --date 2026-11-29 --calendar roman-1962 --format yaml >"$sandbox/one.yaml"
if ! grep -q '^date:' "$sandbox/one.yaml"; then
	echo "yaml payload is missing date" >&2
	exit 1
fi

# A sibling-tool refusal remains inspectable, but the composed command must not
# return success. Each failure is represented once in the additive root
# problems list and remains beside the affected mass or Ordinary as well.
if run_tool show --date 2026-11-29 --calendar roman-1962 \
	--bible not-held --json >"$sandbox/refused-propers.json"; then
	echo "a mass-propers refusal exited successfully" >&2
	exit 1
fi
# Each copied command needs its real shared seating owner at ROOT's exact
# leaf. The UMD model is self-contained; no other browser files are required.
# Refuse just one sibling per root, without hiding the command's own Node.
refusal_repo() {
	fake="$1"
	refused="$2"
	mkdir -p "$fake/tools" "$fake/src/web/browser/liturgy"
	cp "$repo/tools/mass-today" "$fake/tools/mass-today"
	cp "$repo/src/web/browser/liturgy/ordinary-seating.js" \
		"$fake/src/web/browser/liturgy/ordinary-seating.js"
	ln -s "$repo/scripts" "$fake/scripts"
	for sibling in calendar-days calendar-rubrics mass-propers mass-ordinary; do
		if [ "$sibling" != "$refused" ]; then
			ln -s "$repo/tools/$sibling" "$fake/tools/$sibling"
		fi
	done
}
refusal_repo "$sandbox/ordinary-repo" mass-ordinary
ln -s /dev/null "$sandbox/ordinary-repo/tools/mass-ordinary"
if python3 "$sandbox/ordinary-repo/tools/mass-today" show \
	--date 2026-11-29 --calendar roman-1962 --ordinary --lang en --json \
	>"$sandbox/refused-ordinary.json" 2>"$sandbox/refused-ordinary.err"; then
	echo "a mass-ordinary refusal exited successfully" >&2
	exit 1
fi
refusal_repo "$sandbox/rubrics-repo" calendar-rubrics
cat >"$sandbox/rubrics-repo/tools/calendar-rubrics" <<'PY'
import sys

print("fixture-only calendar-rubrics refusal", file=sys.stderr)
raise SystemExit(23)
PY
if python3 "$sandbox/rubrics-repo/tools/mass-today" show \
	--date 2026-11-29 --calendar roman-1962 --json \
	>"$sandbox/refused-rubrics.json" 2>"$sandbox/refused-rubrics.err"; then
	echo "a calendar-rubrics refusal exited successfully" >&2
	exit 1
fi
if run_tool show --date 2026-11-29 --calendar roman-1962 \
	--bible not-held --plain >"$sandbox/refused-propers.txt"; then
	echo "a text mass-propers refusal exited successfully" >&2
	exit 1
fi
/usr/bin/python3 - "$sandbox/refused-propers.json" \
	"$sandbox/refused-ordinary.json" "$sandbox/refused-rubrics.json" <<'PY'
import json
import sys


def load(path):
    with open(path, encoding="utf-8") as source:
        return json.load(source)


propers = load(sys.argv[1])
assert propers["status"] == "partial", propers
assert propers["problems"], propers
assert {problem["component"] for problem in propers["problems"]} == {
    "mass-propers"
}, propers["problems"]
assert all("refused" in mass for mass in propers["days"][0]["masses"]), propers

ordinary = load(sys.argv[2])
assert ordinary["status"] == "partial", ordinary
assert [problem["component"] for problem in ordinary["problems"]] == [
    "mass-ordinary"
], ordinary["problems"]
assert "refused" in ordinary["days"][0]["ordinary"], ordinary
ordinary_problem = ordinary["problems"][0]
assert set(ordinary_problem) == {"component", "date", "calendar", "error"}, ordinary_problem
assert ordinary_problem["error"].startswith("mass-ordinary did not return JSON: "), ordinary_problem
# A refused Ordinary is not a successful empty/body/permission-bearing object.
assert ordinary["days"][0]["ordinary"] == {"refused": ordinary_problem["error"]}, ordinary
assert ordinary["days"][0]["ranking_refused"] is None, ordinary

rubrics = load(sys.argv[3])
assert rubrics["status"] == "partial", rubrics
assert [problem["component"] for problem in rubrics["problems"]] == [
    "calendar-rubrics"
], rubrics["problems"]
assert rubrics["problems"][0]["fallback"] == "calendar-days", rubrics
# The arithmetic fallback still supplies the inspectable day and Mass.
assert rubrics["days"][0]["ranking_refused"], rubrics
assert rubrics["days"][0]["masses"][0]["name"] == "First Sunday of Advent", rubrics
rubrics_problem = rubrics["problems"][0]
assert set(rubrics_problem) == {"component", "date", "calendar", "error", "fallback"}, rubrics_problem
assert rubrics_problem["error"].startswith("calendar-rubrics "), rubrics_problem
assert rubrics_problem["error"].endswith("exited 23: fixture-only calendar-rubrics refusal"), rubrics_problem
assert rubrics["days"][0]["ranking_refused"] == rubrics_problem["error"], rubrics

for payload, component in ((propers, "mass-propers"),
                           (ordinary, "mass-ordinary"),
                           (rubrics, "calendar-rubrics")):
    assert {problem["component"] for problem in payload["problems"]} == {component}, payload
    assert payload["date"] == "2026-11-29" and len(payload["days"]) == 1, payload
    day = payload["days"][0]
    assert day["calendar"] == "roman-1962" and day["masses"], day
    assert day["masses"][0]["name"] == "First Sunday of Advent", day
    assert len({mass["key"] for mass in day["masses"]}) == len(day["masses"]), day
    for problem in payload["problems"]:
        assert problem["date"] == "2026-11-29" and problem["calendar"] == "roman-1962", problem
    if component == "mass-propers":
        # Ranked commemorations also need their own additive, local refusal.
        assert len(payload["problems"]) == len(day["masses"]), payload
    for mass in day["masses"]:
        if component == "mass-propers":
            matching = [problem for problem in payload["problems"] if problem["mass"] == mass["key"]]
            assert len(matching) == 1, mass
            assert mass["refused"] == matching[0]["error"] and mass["propers"] == [], mass
        else:
            assert "refused" not in mass and mass["propers"], mass
            assert not mass.get("placeholders"), mass
PY
for want in "refused:" "partial result:" "component failures"; do
	if ! grep -q "$want" "$sandbox/refused-propers.txt"; then
		echo "text refusal output is missing: $want" >&2
		exit 1
	fi
done

reject() {
	if run_tool "$@" >/dev/null 2>&1; then
		echo "expected failure: $*" >&2
		exit 1
	fi
}

# A refusal is a first-class answer.
reject show --date not-a-date
reject show --date 2026-11-29 --calendar nonesuch
reject show --date 2026-11-29 --lang xx
reject show --date 2026-11-29 --lang xx --json
reject show --date 2026-11-29 --calendar roman-1962 --form main

echo ok
