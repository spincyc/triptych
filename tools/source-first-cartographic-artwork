#!/usr/bin/env python3
"""Validate source-first cartographic artwork against an audited build receipt."""

from __future__ import annotations

import argparse
import hashlib
import json
import re
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
from _tooling import Example, with_examples  # noqa: E402


EXAMPLES = {
    "": (
        Example(
            "tools/source-first-cartographic-artwork check --recipe "
            "src/gpt/theology/mariology/ark-of-the-covenant/artwork/"
            "build-ark-journey-cartographic-base.mjs --receipt "
            "src/gpt/theology/mariology/ark-of-the-covenant/research/"
            "cartographic-base-v3-receipt.json --output "
            "src/gpt/theology/mariology/ark-of-the-covenant/artwork/"
            "ark-journey-cartographic-graphite-v3.png",
            ("source-first-cartographic-artwork: clean",),
        ),
        Example(
            "tools/source-first-cartographic-artwork check --json --recipe "
            "src/gpt/theology/mariology/ark-of-the-covenant/artwork/"
            "build-ark-journey-cartographic-base.mjs --receipt "
            "src/gpt/theology/mariology/ark-of-the-covenant/research/"
            "cartographic-base-v3-receipt.json --output "
            "src/gpt/theology/mariology/ark-of-the-covenant/artwork/"
            "ark-journey-cartographic-graphite-v3.png",
            (
                '{"problems":[],"result":"clean","schema":'
                '"triptych-cartographic-input-receipt/v1","v":1}',
            ),
            "machine-readable result",
        ),
    ),
}


SCHEMA_PATTERN = re.compile(
    r"^[A-Za-z0-9][A-Za-z0-9._-]*(?:/[A-Za-z0-9][A-Za-z0-9._-]*)*/v[1-9][0-9]*$"
)
HASH_PATTERN = re.compile(r"^[0-9a-fA-F]{64}$")


def digest(path: Path) -> str:
    checksum = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            checksum.update(block)
    return checksum.hexdigest()


def validate(recipe_path: Path, receipt_path: Path, output_path: Path) -> dict[str, object]:
    problems: list[str] = []
    for label, path in (
        ("recipe", recipe_path),
        ("receipt", receipt_path),
        ("output", output_path),
    ):
        if not path.is_file():
            problems.append(f"{label} file does not exist: {path}")

    receipt: object | None = None
    if receipt_path.is_file():
        try:
            receipt = json.loads(receipt_path.read_text(encoding="utf-8"))
        except (OSError, UnicodeError, json.JSONDecodeError) as exc:
            problems.append(f"receipt is not parseable JSON: {receipt_path}: {exc}")

    schema: object | None = None
    declared_output: object | None = None
    declared_recipe: object | None = None
    if receipt is not None:
        if not isinstance(receipt, dict):
            problems.append("receipt root must be a JSON object")
        else:
            schema = receipt.get("schema")
            if not isinstance(schema, str) or not SCHEMA_PATTERN.fullmatch(schema):
                problems.append("receipt.schema must be a nonempty versioned schema marker")

            output_record = receipt.get("output")
            if not isinstance(output_record, dict):
                problems.append("receipt.output must be an object")
            else:
                declared_output = output_record.get("sha256")
                if not isinstance(declared_output, str) or not HASH_PATTERN.fullmatch(
                    declared_output
                ):
                    problems.append(
                        "receipt.output.sha256 must be a 64-digit hexadecimal hash"
                    )

            recipe_record = receipt.get("recipe")
            if isinstance(recipe_record, dict) and "sha256" in recipe_record:
                declared_recipe = recipe_record.get("sha256")
                if not isinstance(declared_recipe, str) or not HASH_PATTERN.fullmatch(
                    declared_recipe
                ):
                    problems.append(
                        "receipt.recipe.sha256 must be a 64-digit hexadecimal hash"
                    )

    if (
        output_path.is_file()
        and isinstance(declared_output, str)
        and HASH_PATTERN.fullmatch(declared_output)
    ):
        actual_output = digest(output_path)
        if actual_output != declared_output.lower():
            problems.append(
                "output SHA-256 mismatch: "
                f"declared {declared_output.lower()}, actual {actual_output}"
            )

    if (
        recipe_path.is_file()
        and isinstance(declared_recipe, str)
        and HASH_PATTERN.fullmatch(declared_recipe)
    ):
        actual_recipe = digest(recipe_path)
        if actual_recipe != declared_recipe.lower():
            problems.append(
                "recipe SHA-256 mismatch: "
                f"declared {declared_recipe.lower()}, actual {actual_recipe}"
            )

    return {
        "problems": problems,
        "result": "clean" if not problems else "findings",
        "schema": schema,
        "v": 1,
    }


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Validate an audited cartographic output against its JSON receipt."
    )
    parser.add_argument("command", choices=("check",))
    parser.add_argument("--recipe", required=True, type=Path)
    parser.add_argument("--receipt", required=True, type=Path)
    parser.add_argument("--output", required=True, type=Path)
    parser.add_argument("--json", action="store_true")
    with_examples(parser, EXAMPLES[""])
    args = parser.parse_args()

    result = validate(args.recipe, args.receipt, args.output)
    problems = result["problems"]
    if args.json:
        print(json.dumps(result, sort_keys=True, separators=(",", ":")))
    elif problems:
        for problem in problems:
            print(f"source-first-cartographic-artwork: {problem}")
    else:
        print("source-first-cartographic-artwork: clean")
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
