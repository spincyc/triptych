def _dossier(arguments: argparse.Namespace) -> _wiring.Dossier:
    root = Path(arguments.root).resolve() if arguments.root else ROOT
    return _wiring.dossier(
        arguments.document,
        root=root,
        profile=arguments.profile,
        corpus_root=_corpus_root(arguments),
    )


def _corpus_root(arguments: argparse.Namespace) -> Path | None:
    root = Path(arguments.root).resolve() if arguments.root else ROOT
    return (root / "src/sources/chronology") if arguments.root else None


def _require_publication_profile(
    arguments: argparse.Namespace, found: _wiring.Dossier
) -> None:
    """Tracked artifacts always represent the corpus's publication default."""
    if not (arguments.write or arguments.check):
        return
    default = _chronology.load(_corpus_root(arguments)).default_profile
    if found.profile != default:
        raise ValueError(
            f"profile {found.profile!r} is inspection-only; --write and --check "
            f"publish the corpus default profile {default!r}. Omit the action "
            f"to inspect this profile on stdout, or use --profile {default}"
        )


def _leaf(arguments: argparse.Namespace) -> Path:
    root = Path(arguments.root).resolve() if arguments.root else ROOT
    provider = arguments.provider
    if not provider or "/" in provider or provider.startswith("."):
        raise ValueError(f"not a provider name: {provider!r}")
    provider_root = (root / "src" / provider).resolve()
    leaf = (provider_root / arguments.document).resolve()
    if leaf != provider_root and provider_root not in leaf.parents:
        raise ValueError(f"document leaves the provider root: {arguments.document!r}")
    if not leaf.is_dir():
        raise ValueError(f"no such leaf: src/{provider}/{arguments.document}")
    return leaf


def loci(arguments: argparse.Namespace) -> dict[str, object]:
    """Which verses the formulary appoints, and what the corpus has at them."""
    found = _dossier(arguments)
    return {
        "status": "ok",
        "document": found.document,
        "mass": found.mass,
        "system": found.system,
        "profile": found.profile,
        # Not `status`: that key is the CLI envelope's. `formulary` is the
        # calendar's answer to whether this identity is appointed one at all.
        "formulary": found.state,
        "formulary_reason": found.reason,
        "elements": [
            {
                "key": element.key,
                "name": element.name,
                "refs": list(element.refs),
                "loci": list(element.loci),
                "status": element.status,
            }
            for element in found.elements
        ],
    }


def record(arguments: argparse.Namespace) -> dict[str, object]:
    """Render the leaf's chronology record, and optionally write or check it."""
    found = _dossier(arguments)
    _require_publication_profile(arguments, found)
    rendered = _wiring.render(found)
    payload: dict[str, object] = {
        "status": "ok",
        "document": found.document,
        "mass": found.mass,
        "profile": found.profile,
        "formulary": found.state,
        "formulary_reason": found.reason,
        "path": _wiring.RECORD,
        "elements": [
            {
                "key": element.key,
                "status": element.status,
                "claims": len(element.claims),
                "subjects": sorted({claim.subject for claim in element.claims}),
                "publication_status": element.publication_status,
                "publication_claims": len(element.publication_claims),
            }
            for element in found.elements
        ],
    }
    if not (arguments.write or arguments.check):
        payload["record"] = rendered
        return payload

    path = _wiring.record_path(_leaf(arguments))
    shown = path.relative_to(Path(arguments.root).resolve() if arguments.root else ROOT)
    if arguments.check:
        if not path.is_file():
            raise ValueError(
                f"{shown} does not exist; write it with "
                f"`tools/tpt proper-chronology record --document "
                f"{found.document} --provider {arguments.provider} --write`"
            )
        if path.read_text(encoding="utf-8") != rendered:
            raise ValueError(
                f"{shown} is not what the corpus now answers; it is generated, "
                f"so rewrite it with --write rather than editing it"
            )
        payload["checked"] = str(shown)
        return payload

    path.parent.mkdir(parents=True, exist_ok=True)
    changed = (
        not path.is_file() or path.read_text(encoding="utf-8") != rendered
    )
    if changed:
        path.write_text(rendered, encoding="utf-8")
    payload["written"] = str(shown)
    payload["changed"] = changed
    return payload


def annotations(arguments: argparse.Namespace) -> dict[str, object]:
    """Project the dossier into compact, grouped publication annotations."""
    dossier = _dossier(arguments)
    _require_publication_profile(arguments, dossier)
    found = _wiring.annotations(dossier)

    requested = arguments.format
    if arguments.json:
        if requested and requested != "json":
            raise ValueError("--json and --format disagree")
        requested = "json"
    if arguments.write or arguments.check:
        if requested and requested != "tex":
            raise ValueError("--write and --check only apply to --format tex")
        requested = "tex"
    output_format = requested or "text"

    payload = _wiring.annotation_payload(found)
    payload["format"] = output_format
    payload["path"] = _wiring.ANNOTATIONS_RECORD
    if not (arguments.write or arguments.check):
        if output_format == "text":
            payload["output"] = _wiring.render_annotations_text(found)
        elif output_format == "tex":
            payload["output"] = _wiring.render_annotations_tex(found)
        return payload

    rendered = _wiring.render_annotations_tex(found)
    path = _wiring.annotations_path(_leaf(arguments))
    root = Path(arguments.root).resolve() if arguments.root else ROOT
    shown = path.relative_to(root)
    if arguments.check:
        if not path.is_file():
            raise ValueError(
                f"{shown} does not exist; write it with "
                f"`tools/tpt proper-chronology annotations --document "
                f"{found.document} --provider {arguments.provider} --write`"
            )
        if path.read_text(encoding="utf-8") != rendered:
            raise ValueError(
                f"{shown} is not the current chronology annotation projection; "
                f"it is generated, so rewrite it with --write rather than editing it"
            )
        payload["checked"] = str(shown)
        return payload

    path.parent.mkdir(parents=True, exist_ok=True)
    changed = not path.is_file() or path.read_text(encoding="utf-8") != rendered
    if changed:
        path.write_text(rendered, encoding="utf-8")
    payload["written"] = str(shown)
    payload["changed"] = changed
    return payload


STATUS_WIDTH = 21


def _render_elements(payload: dict, counts: bool) -> int:
    if not payload["elements"]:
        # An empty list is the one output a reader would misread as "nothing
        # was found", so the reason is printed in its place rather than left
        # to the JSON.
        print(payload.get("formulary_reason")
              or "no element resolved for this formulary")
        return 0
    for element in payload["elements"]:
        status = element["status"] or ("-" if counts else "(no scripture)")
        if counts:
            total = element["claims"]
            tail = f"{total} claim" if total == 1 else f"{total} claims"
        else:
            tail = " ".join(element["loci"])
        line = f"  {element['key']:<15}{status:<{STATUS_WIDTH}}{tail}".rstrip()
        print(line[2:] if line.startswith("  ") else line)
    return 0


def _render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        return 0
    verb = arguments.command
    if verb == "annotations":
        if "checked" in payload:
            print(f"{payload['checked']}: current with the chronology corpus")
            return 0
        if "written" in payload:
            state = "rewritten" if payload["changed"] else "already current"
            print(f"{payload['written']}: {state}")
            return 0
        if payload["format"] == "json":
            print_json(payload)
            return 0
        sys.stdout.write(str(payload["output"]))
        return 0
    if getattr(arguments, "json", False):
        print_json(payload)
        return 0
    if verb == "loci":
        print(f"profile: {payload['profile']}")
        return _render_elements(payload, counts=False)
    if "checked" in payload:
        print(f"{payload['checked']}: current with the chronology corpus")
        return 0
    if "written" in payload:
        state = "rewritten" if payload["changed"] else "already current"
        print(f"{payload['written']}: {state}")
        return 0
    if arguments.summary:
        return _render_elements(payload, counts=True)
    sys.stdout.write(str(payload["record"]))
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--document",
        required=True,
        help=f"the proper leaf id, e.g. {FOURTEENTH}",
    )
    shared.add_argument(
        "--provider",
        default="claude",
        help="provider directory under src/ (default: claude)",
    )
    shared.add_argument(
        "--root",
        help=(
            "a document/corpus fixture root for tests; canon, witnesses, and "
            "concordances still come from this installed checkout (not an "
            "alternate-checkout isolation boundary)"
        ),
    )
    shared.add_argument(
        "--profile",
        help=(
            "answer under one chronology profile; non-default profiles are "
            "inspection-only and cannot be written or checked"
        ),
    )
    shared.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )

    parser = argparse.ArgumentParser(
        prog="proper-chronology",
        description=(
            "Answer a proper's appointed loci from the Scripture chronology "
            "corpus. A proper may not date a locus any other way: "
            "guidance/scripture-chronology.md section 14."
        ),
    )
    examples_live_on_the_verbs(parser, "proper-chronology")
    sub = parser.add_subparsers(dest="command")

    with_examples(
        sub.add_parser(
            "loci",
            help="the verses the formulary appoints, as corpus loci",
            parents=[shared],
        ),
        EXAMPLES["loci"],
    )
    writer = sub.add_parser(
        "record",
        help="render, write or verify the leaf's research/chronology.toml",
        parents=[shared],
    )
    writer.add_argument(
        "--write",
        action="store_true",
        help="write the default-profile record into the leaf instead of printing it",
    )
    writer.add_argument(
        "--check",
        action="store_true",
        help="refuse a leaf whose default-profile record is missing or has drifted",
    )
    writer.add_argument(
        "--summary",
        action="store_true",
        help="print what the record holds instead of the record",
    )
    with_examples(writer, EXAMPLES["record"])

    annotation_writer = sub.add_parser(
        "annotations",
        help=(
            "project every scriptural element into compact grouped date "
            "annotations"
        ),
        parents=[shared],
    )
    annotation_writer.add_argument(
        "--format",
        choices=("text", "json", "tex"),
        help="projection format (default: text; write/check imply tex)",
    )
    annotation_action = annotation_writer.add_mutually_exclusive_group()
    annotation_action.add_argument(
        "--write",
        action="store_true",
        help="write default-profile chronology-annotations.tex into the leaf",
    )
    annotation_action.add_argument(
        "--check",
        action="store_true",
        help="refuse a missing or drifted default-profile annotation file",
    )
    with_examples(annotation_writer, EXAMPLES["annotations"])

    return run_verb_cli(
        parser=parser,
        handlers={"loci": loci, "record": record, "annotations": annotations},
        renderer=_render,
        prefix=PREFIX,
        argv=argv,
        mapped_errors={
            _wiring.ChronologyWiringError: ("wiring", 1),
            _chronology.ChronologyError: ("chronology", 1),
            ValueError: ("refused", 1),
        },
    )


if __name__ == "__main__":
    raise SystemExit(main())
