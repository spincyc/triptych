@dataclasses.dataclass(frozen=True)
class Record:
    """One parsed source manifest."""

    path: Path
    record_type: str
    record_id: str
    data: dict[str, Any]


@dataclasses.dataclass(frozen=True)
class Binding:
    """One publication-local source binding."""

    path: Path
    document: str
    schema: int
    ordinal: int
    source_id: str
    data: dict[str, Any]


@dataclasses.dataclass
class Library:
    """Loaded records, bindings, and deterministic validation errors."""

    root: Path
    source_root: Path
    publication_roots: list[Path]
    records: dict[str, Record] = dataclasses.field(default_factory=dict)
    bindings: list[Binding] = dataclasses.field(default_factory=list)
    payload_paths: set[Path] = dataclasses.field(default_factory=set)
    errors: list[str] = dataclasses.field(default_factory=list)

    def relative(self, path: Path) -> str:
        try:
            return path.relative_to(self.root).as_posix()
        except ValueError:
            return path.as_posix()

    def error(self, path: Path, message: str) -> None:
        self.errors.append(f"{self.relative(path)}: {message}")


class SourceLibraryQueryError(ValueError):
    """A query cannot be answered honestly from the registered graph."""


def _is_schema_version(value: Any, *versions: int) -> bool:
    return (
        isinstance(value, int)
        and not isinstance(value, bool)
        and value in versions
    )


def _is_string(value: Any) -> bool:
    return isinstance(value, str) and bool(value.strip())


def _is_string_list(value: Any, *, allow_empty: bool = True) -> bool:
    return (
        isinstance(value, list)
        and (allow_empty or bool(value))
        and all(_is_string(item) for item in value)
    )


def _is_safe_embedded_reference(value: Any) -> bool:
    if not _is_string(value) or "\\" in value or "%" in value:
        return False
    if any(ord(character) < 32 for character in value):
        return False
    parsed = urlsplit(value)
    if parsed.scheme or parsed.netloc or parsed.query or parsed.fragment:
        return False
    reference = PurePosixPath(value)
    return (
        not reference.is_absolute()
        and reference.parts
        and all(part not in {"", ".", ".."} for part in reference.parts)
        and reference.as_posix() == value
    )


def _read_toml(library: Library, path: Path) -> dict[str, Any] | None:
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, tomllib.TOMLDecodeError, RecursionError) as error:
        library.error(path, f"cannot parse TOML: {error}")
        return None


def _unknown_and_missing_fields(
    library: Library,
    path: Path,
    data: dict[str, Any],
    *,
    allowed: set[str],
    required: set[str],
) -> None:
    unknown = sorted(set(data) - allowed)
    missing = sorted(required - set(data))
    if unknown:
        library.error(path, f"unknown fields: {', '.join(unknown)}")
    if missing:
        library.error(path, f"missing required fields: {', '.join(missing)}")


def _validate_common_record(library: Library, path: Path, data: dict[str, Any]) -> tuple[str, str] | None:
    record_type = data.get("record_type")
    record_id = data.get("id")
    if not _is_string(record_type) or record_type not in RECORD_TYPES:
        library.error(path, f"record_type must be one of: {', '.join(sorted(RECORD_TYPES))}")
        return None
    schema = data.get("schema")
    if not _is_schema_version(schema, 1, 2):
        library.error(path, "schema must be integer 1 or 2")
        effective_schema = 2 if record_type == "segment" else 1
    elif record_type not in SCHEMA_RECORD_TYPES[schema]:
        if record_type in {"work", "edition", "corpus"}:
            library.error(path, "schema must be integer 1")
            effective_schema = 1
        elif record_type == "segment":
            library.error(path, "segment schema must be integer 2")
            effective_schema = 2
        else:
            allowed = ", ".join(sorted(SCHEMA_RECORD_TYPES[schema]))
            library.error(path, f"schema {schema} record_type must be one of: {allowed}")
            effective_schema = schema
    else:
        effective_schema = schema
    allowed_fields = ALLOWED_FIELDS_V1 if effective_schema == 1 else ALLOWED_FIELDS_V2
    required_fields = REQUIRED_FIELDS_V1 if effective_schema == 1 else REQUIRED_FIELDS_V2
    _unknown_and_missing_fields(
        library,
        path,
        data,
        allowed=allowed_fields[record_type],
        required=required_fields[record_type],
    )
    if not _is_string(record_id) or not ID_PATTERN.fullmatch(record_id):
        library.error(path, "id must contain lowercase letters, digits, dots, or hyphens")
        return None
    expected_prefix = f"{record_type}."
    if not record_id.startswith(expected_prefix):
        library.error(path, f"id must begin with {expected_prefix}")
    return record_type, record_id


def _validate_strings(library: Library, record: Record) -> None:
    data = record.data
    path = record.path
    scalar_fields = {
        "title",
        "responsible",
        "work_type",
        "composed",
        "composed_basis",
        "description",
        "locus_pattern",
        "work_id",
        "language",
        "publication",
        "date",
        "authority",
        "jurisdiction",
        "edition_id",
        "artifact_type",
        "media_type",
        "storage",
        "rights_status",
        "rights_basis",
        "rights_jurisdiction",
        "license",
        "source_url",
        "provenance",
        "retrieved",
        "sha256",
        "path",
        "derived_from",
        "transformation",
        "encoding",
        "artifact_id",
        "artifact_sha256",
        "segment_id",
        "segment_type",
        "locus",
        "context",
        "text",
        "verified_on",
        "snapshot",
        "scope",
        "completeness",
        "notes",
    }
    list_fields = {
        "alternate_titles",
        "languages",
        "relations",
        "editors",
        "translators",
        "states",
        "members",
        "projected_from",
    }
    for field in sorted(scalar_fields & set(data)):
        if not _is_string(data[field]):
            library.error(path, f"{field} must be a nonempty string")
    for field in sorted(list_fields & set(data)):
        if not _is_string_list(data[field], allow_empty=False):
            library.error(path, f"{field} must be a nonempty array of nonempty strings")

    if "work_type" in data and _is_string(data["work_type"]) and not KEBAB_PATTERN.fullmatch(data["work_type"]):
        library.error(path, "work_type must be lowercase kebab-case")
    for field in ("artifact_type", "segment_type"):
        if (
            field in data
            and _is_string(data[field])
            and not KEBAB_PATTERN.fullmatch(data[field])
        ):
            library.error(path, f"{field} must be lowercase kebab-case")
    if "page_count" in data and not _is_positive_int(data["page_count"]):
        library.error(path, "page_count must be a positive non-boolean integer")
    if "locus_pattern" in data and _is_string(data["locus_pattern"]):
        if len(data["locus_pattern"]) > 512:
            library.error(path, "locus_pattern must not exceed 512 characters")
            return
        try:
            re.compile(data["locus_pattern"])
        except (re.error, OverflowError, RecursionError) as error:
            library.error(path, f"invalid locus_pattern: {error}")


def _path_contains_symlink(path: Path, root: Path) -> bool:
    current = path
    while current != root and current != current.parent:
        if current.is_symlink():
            return True
        current = current.parent
    return False


def _record_manifest_paths(library: Library) -> list[Path]:
    """Return authoritative source manifests, excluding audit inventories."""

    patterns = (
        "works/*/*/work.toml",
        "works/*/*/editions/*/edition.toml",
        "works/*/*/editions/*/artifacts/*/artifact.toml",
        "works/*/*/editions/*/segments/*.toml",
        "works/*/*/editions/*/passages/*.toml",
        "corpora/*.toml",
    )
    candidates = {
        path
        for pattern in patterns
        for path in library.source_root.glob(pattern)
    }
    paths: set[Path] = set()
    for path in sorted(candidates):
        if _path_contains_symlink(path, library.source_root):
            library.error(path, "source manifest path must not contain symbolic links")
        elif not path.is_file():
            library.error(path, "source manifest must be a regular file")
        else:
            paths.add(path)
    works_root = library.source_root / "works"
    if works_root.is_dir():
        artifact_roots = tuple(
            library.source_root.glob(
                "works/*/*/editions/*/artifacts/*"
            )
        )
        for path in works_root.rglob("*.toml"):
            if path in candidates:
                continue
            if any(path.is_relative_to(root) for root in artifact_roots):
                continue
            library.error(path, "TOML record is not at a canonical manifest path")
    return sorted(paths)


def _validate_record_path(library: Library, record: Record) -> None:
    """Keep every identity at its one canonical schema location."""

    relative = record.path.relative_to(library.source_root)
    parts = relative.parts
    expected_shape = {
        "work": len(parts) == 4
        and parts[0] == "works"
        and parts[-1] == "work.toml",
        "edition": len(parts) == 6
        and parts[0] == "works"
        and parts[3] == "editions"
        and parts[-1] == "edition.toml",
        "artifact": len(parts) == 8
        and parts[0] == "works"
        and parts[3] == "editions"
        and parts[5] == "artifacts"
        and parts[-1] == "artifact.toml",
        "segment": len(parts) == 7
        and parts[0] == "works"
        and parts[3] == "editions"
        and parts[5] == "segments"
        and parts[-1].endswith(".toml"),
        "passage": len(parts) == 7
        and parts[0] == "works"
        and parts[3] == "editions"
        and parts[5] == "passages"
        and parts[-1].endswith(".toml"),
        "corpus": len(parts) == 2
        and parts[0] == "corpora"
        and parts[-1].endswith(".toml"),
    }[record.record_type]
    if not expected_shape:
        library.error(
            record.path,
            f"{record.record_type} manifest is not at its canonical schema path",
        )


def _load_source_records(library: Library) -> None:
    if not library.source_root.exists():
        library.errors.append(f"{library.relative(library.source_root)}: source root does not exist")
        return
    if _path_contains_symlink(library.source_root, library.root):
        library.errors.append(
            f"{library.relative(library.source_root)}: source root path must not contain symbolic links"
        )
        return
    for path in _record_manifest_paths(library):
        data = _read_toml(library, path)
        if data is None:
            continue
        common = _validate_common_record(library, path, data)
        if common is None:
            continue
        record_type, record_id = common
        record = Record(path=path, record_type=record_type, record_id=record_id, data=data)
        _validate_strings(library, record)
        _validate_record_path(library, record)
        if record_id in library.records:
            prior = library.relative(library.records[record_id].path)
            library.error(path, f"duplicate id {record_id}; first declared in {prior}")
            continue
        library.records[record_id] = record


def _validate_binding_table(
    library: Library,
    path: Path,
    schema: int,
    ordinal: int,
    data: Any,
) -> Binding | None:
    label = f"bindings[{ordinal}]"
    if not isinstance(data, dict):
        library.error(path, f"{label} must be a table")
        return None
    unknown = sorted(set(data) - BINDING_FIELDS)
    missing = sorted({"source_id", "role", "states", "context"} - set(data))
    if unknown:
        library.error(path, f"{label} has unknown fields: {', '.join(unknown)}")
    if missing:
        library.error(path, f"{label} is missing: {', '.join(missing)}")
    source_id = data.get("source_id")
    if not _is_string(source_id) or not ID_PATTERN.fullmatch(source_id):
        library.error(path, f"{label}.source_id must be a valid source id")
        return None
    role = data.get("role")
    if not _is_string(role) or role not in BINDING_ROLES:
        library.error(path, f"{label}.role must be one of: {', '.join(sorted(BINDING_ROLES))}")
    states = data.get("states")
    if not _is_string_list(states, allow_empty=False):
        library.error(path, f"{label}.states must be a nonempty string array")
    else:
        invalid_states = sorted(set(states) - EVIDENCE_STATES)
        if invalid_states:
            library.error(path, f"{label}.states has invalid values: {', '.join(invalid_states)}")
        if len(states) != len(set(states)):
            library.error(path, f"{label}.states contains duplicates")
    if not _is_string(data.get("context")):
        library.error(path, f"{label}.context must be a nonempty string")
    for field in ("loci", "claim_keys"):
        if field in data:
            if not _is_string_list(data[field], allow_empty=False):
                library.error(path, f"{label}.{field} must be a nonempty string array")
            elif len(data[field]) != len(set(data[field])):
                library.error(path, f"{label}.{field} contains duplicates")
    for field in (
        "notes",
        "search_scope",
        "searched_on",
        "search_mode",
        "verified_on",
        "query",
        "method",
        "source_fingerprint",
    ):
        if field in data and not _is_string(data[field]):
            library.error(path, f"{label}.{field} must be a nonempty string")
    if "matching_line_count" in data and (
        not isinstance(data["matching_line_count"], int)
        or isinstance(data["matching_line_count"], bool)
        or data["matching_line_count"] < 0
    ):
        library.error(path, f"{label}.matching_line_count must be a nonnegative integer")
    if (
        "search_mode" in data
        and _is_string(data["search_mode"])
        and data["search_mode"] not in SEARCH_MODES
    ):
        library.error(
            path,
            f"{label}.search_mode must be one of: {', '.join(sorted(SEARCH_MODES))}",
        )
    search_fields = {
        "search_scope",
        "searched_on",
        "search_mode",
        "query",
        "method",
        "matching_line_count",
    }
    valid_states = states if _is_string_list(states, allow_empty=False) else []
    if "searched" in valid_states:
        missing_search = sorted(search_fields - set(data))
        if missing_search:
            library.error(path, f"{label} searched state requires: {', '.join(missing_search)}")
    elif search_fields & set(data):
        library.error(path, f"{label} search fields require the searched state")
    if role == "negative-search" and "searched" not in valid_states:
        library.error(path, f"{label}.negative-search role requires the searched state")
    if role == "negative-search" and data.get("matching_line_count") != 0:
        library.error(path, f"{label}.negative-search role requires matching_line_count = 0")
    if "searched_on" in data and not _is_iso_date(data["searched_on"]):
        library.error(path, f"{label}.searched_on must be an ISO date in YYYY-MM-DD form")
    if "verified" in valid_states:
        if not _is_iso_date(data.get("verified_on")):
            library.error(path, f"{label} verified state requires verified_on ISO date")
    elif "verified_on" in data:
        library.error(path, f"{label}.verified_on requires the verified state")
    return Binding(
        path=path,
        document="",
        schema=schema,
        ordinal=ordinal,
        source_id=source_id,
        data=data,
    )


def _existing_publication_roots(library: Library) -> list[Path]:
    """Provider roots that are present; a nonexistent root contributes nothing."""

    return [
        publication_root
        for publication_root in library.publication_roots
        if publication_root.is_symlink() or publication_root.exists()
    ]


def _load_bindings(library: Library) -> None:
    publication_roots = _existing_publication_roots(library)
    if not publication_roots:
        joined = ", ".join(
            library.relative(publication_root)
            for publication_root in library.publication_roots
        )
        library.errors.append(f"{joined}: no publication root exists")
        return
    pattern = "**/research/source-bindings.toml"
    for publication_root in publication_roots:
        if _path_contains_symlink(publication_root, library.root):
            library.errors.append(
                f"{library.relative(publication_root)}: publication root path must not contain symbolic links"
            )
            continue
        _load_bindings_under_root(library, publication_root, pattern)


def _load_bindings_under_root(
    library: Library, publication_root: Path, pattern: str
) -> None:
    for path in sorted(publication_root.glob(pattern)):
        if _path_contains_symlink(path, publication_root):
            library.error(path, "binding manifest path must not contain symbolic links")
            continue
        if not path.is_file():
            library.error(path, "binding manifest must be a regular file")
            continue
        data = _read_toml(library, path)
        if data is None:
            continue
        _unknown_and_missing_fields(
            library,
            path,
            data,
            allowed=BINDINGS_FILE_FIELDS,
            required={"schema", "record_type", "document", "bindings"},
        )
        schema = data.get("schema")
        if not _is_schema_version(schema, 1, 2):
            library.error(path, "schema must be integer 1 or 2")
            continue
        if data.get("record_type") != "bindings":
            library.error(path, 'record_type must be "bindings"')
        document = data.get("document")
        if not _is_string(document):
            library.error(path, "document must be a nonempty string")
            continue
        leaf = path.parent.parent
        try:
            expected_document = leaf.relative_to(publication_root).as_posix()
        except ValueError:
            library.error(path, "binding file is outside the publication root")
            continue
        if document != expected_document:
            library.error(path, f"document must be {expected_document!r} for this path")
        if not (leaf / "main.tex").is_file():
            library.error(path, f"document has no main.tex: {expected_document}")
        tables = data.get("bindings")
        if not isinstance(tables, list) or not tables:
            library.error(path, "bindings must be a nonempty array of tables")
            continue
        seen: set[str] = set()
        for ordinal, table in enumerate(tables, start=1):
            binding = _validate_binding_table(library, path, schema, ordinal, table)
            if binding is None:
                continue
            key = json.dumps(table, ensure_ascii=False, sort_keys=True, default=str)
            if key in seen:
                library.error(path, f"bindings[{ordinal}] exactly duplicates an earlier binding")
            seen.add(key)
            library.bindings.append(dataclasses.replace(binding, document=document))


def _dependency_ids(record: Record) -> list[str]:
    data = record.data
    if record.record_type == "edition":
        return [data["work_id"]] if _is_string(data.get("work_id")) else []
    if record.record_type == "artifact":
        dependencies = [data["edition_id"]] if _is_string(data.get("edition_id")) else []
        if _is_string(data.get("derived_from")):
            dependencies.append(data["derived_from"])
        support_artifacts = data.get("support_artifacts")
        if isinstance(support_artifacts, list):
            dependencies.extend(
                support["artifact_id"]
                for support in support_artifacts
                if isinstance(support, dict)
                and _is_string(support.get("artifact_id"))
            )
        return dependencies
    if record.record_type == "segment":
        dependencies = [data["edition_id"]] if _is_string(data.get("edition_id")) else []
        if _is_string(data.get("artifact_id")):
            dependencies.append(data["artifact_id"])
        return dependencies
    if record.record_type == "passage":
        dependencies = [data["edition_id"]] if _is_string(data.get("edition_id")) else []
        if _is_string(data.get("artifact_id")):
            dependencies.append(data["artifact_id"])
        if _is_string(data.get("segment_id")):
            dependencies.append(data["segment_id"])
        return dependencies
    if record.record_type == "corpus" and isinstance(data.get("members"), list):
        return [member for member in data["members"] if _is_string(member)]
    return []


def _corpus_snapshot(library: Library, members: Sequence[str]) -> str | None:
    lines = []
    for member in sorted(members):
        target = library.records.get(member)
        if target is None or target.record_type != "artifact":
            return None
        digest = target.data.get("sha256")
        if not _is_string(digest) or not SHA256_PATTERN.fullmatch(digest):
            return None
        lines.append(f"{member}\t{digest}\n")
    payload = "".join(lines).encode("utf-8")
    return f"sha256:{hashlib.sha256(payload).hexdigest()}"


def source_fingerprint(
    library: Library,
    source_id: str,
    _cache: dict[str, str] | None = None,
) -> str:
    """Return a canonical digest of a source record and its exact ancestors."""

    if _cache is None:
        _cache = {}
    if source_id in _cache:
        return _cache[source_id]
    if source_id not in library.records:
        raise KeyError(source_id)

    visiting: set[str] = set()
    stack: list[tuple[str, bool]] = [(source_id, False)]
    while stack:
        current, expanded = stack.pop()
        if current in _cache:
            continue
        record = library.records[current]
        dependencies = sorted(
            dependency
            for dependency in _dependency_ids(record)
            if dependency in library.records
        )
        if expanded:
            payload = json.dumps(
                {
                    "record": record.data,
                    "dependencies": [
                        {"id": dependency, "fingerprint": _cache[dependency]}
                        for dependency in dependencies
                    ],
                },
                ensure_ascii=False,
                sort_keys=True,
                separators=(",", ":"),
                default=str,
            ).encode("utf-8")
            _cache[current] = f"sha256:{hashlib.sha256(payload).hexdigest()}"
            visiting.remove(current)
            continue
        if current in visiting:
            raise SourceLibraryQueryError("cannot fingerprint a cyclic source graph")
        visiting.add(current)
        stack.append((current, True))
        for dependency in reversed(dependencies):
            if dependency in visiting:
                raise SourceLibraryQueryError("cannot fingerprint a cyclic source graph")
            if dependency not in _cache:
                stack.append((dependency, False))
    return _cache[source_id]


def _exact_artifacts(library: Library, record: Record) -> list[Record]:
    """Return the exact artifacts directly represented by a reviewable source."""

    if record.record_type == "artifact":
        return [record]
    if record.record_type in {"segment", "passage"}:
        artifact_id = record.data.get("artifact_id")
        if record.record_type == "passage" and _is_string(record.data.get("segment_id")):
            segment = library.records.get(record.data["segment_id"])
            artifact_id = (
                segment.data.get("artifact_id")
                if segment is not None and segment.record_type == "segment"
                else None
            )
        artifact = library.records.get(artifact_id) if _is_string(artifact_id) else None
        return [artifact] if artifact is not None and artifact.record_type == "artifact" else []
    if record.record_type == "corpus":
        members = record.data.get("members")
        if not _is_string_list(members, allow_empty=False):
            return []
        return [
            library.records[member]
            for member in members
            if member in library.records
            and library.records[member].record_type == "artifact"
        ]
    return []


def _validate_relationships(library: Library) -> None:
    records_by_path = {record.path: record for record in library.records.values()}
    for record in sorted(library.records.values(), key=lambda item: item.record_id):
        for dependency in _dependency_ids(record):
            if dependency not in library.records:
                library.error(record.path, f"references unknown source id: {dependency}")
        if record.record_type == "work":
            relations = record.data.get("relations", [])
            for relation in relations if _is_string_list(relations) else []:
                target = library.records.get(relation)
                if target is None:
                    library.error(record.path, f"references unknown related work id: {relation}")
                elif target.record_type != "work":
                    library.error(record.path, "relations must reference work records")
        expected_parent = {
            "edition": "work",
            "artifact": "edition",
            "segment": "edition",
            "passage": "edition",
        }.get(record.record_type)
        if expected_parent:
            field = f"{expected_parent}_id"
            parent_id = record.data.get(field)
            target = library.records.get(parent_id) if _is_string(parent_id) else None
            if target is not None and target.record_type != expected_parent:
                article = "an" if expected_parent[0] in "aeiou" else "a"
                library.error(record.path, f"{field} must reference {article} {expected_parent} record")
            enclosing_path = {
                "edition": record.path.parents[2] / "work.toml",
                "artifact": record.path.parents[2] / "edition.toml",
                "segment": record.path.parents[1] / "edition.toml",
                "passage": record.path.parents[1] / "edition.toml",
            }[record.record_type]
            enclosing = records_by_path.get(enclosing_path)
            if enclosing is None:
                library.error(
                    record.path,
                    f"enclosing {expected_parent} manifest is missing or invalid",
                )
            elif record.data.get(field) != enclosing.record_id:
                library.error(
                    record.path,
                    f"{field} must match enclosing {expected_parent} {enclosing.record_id}",
                )
        # `projected_from` names testimony, not source material, and so is the
        # one artifact edge that crosses an edition on purpose.
        #
        # `derived_from` means these bytes were transformed into those bytes —
        # an OCR of a scan, a normalisation of a transcription — and stays
        # inside one edition because that is what a derivative is. A projection
        # is the opposite shape: the Douay-Rheims carries no paragraph marks of
        # its own, and its projected breaks are inferred from the King James and
        # the World English Bible, which are other editions by construction.
        # Recording those under `derived_from` would have made the record claim
        # the projection was made out of the Douay-Rheims's own bytes, and
        # pointing it at something in-edition that did not produce it would have
        # made the record lie in order to satisfy a check.
        #
        # A projection with no stated witnesses is unfalsifiable, so the field
        # may not be empty, and every entry must be an artifact this library
        # holds.
        for witness in record.data.get("projected_from") or []:
            if record.record_type != "artifact":
                library.error(record.path, "projected_from belongs to an artifact record")
                break
            target = library.records.get(witness)
            if target is None:
                library.error(record.path, f"projected_from names no such record: {witness}")
            elif target.record_type != "artifact":
                library.error(record.path, "projected_from must reference artifact records")
        if record.record_type == "artifact" and "projected_from" in record.data:
            if not record.data.get("projected_from"):
                library.error(
                    record.path,
                    "projected_from must name at least one witness; a projection "
                    "whose witnesses are unstated cannot be checked",
                )
        if record.record_type == "artifact" and _is_string(record.data.get("derived_from")):
            target = library.records.get(record.data["derived_from"])
            if target is not None and target.record_type != "artifact":
                library.error(record.path, "derived_from must reference an artifact record")
            elif target is not None and target.data.get("edition_id") != record.data.get("edition_id"):
                library.error(record.path, "derived_from artifact must belong to the same edition")
            elif target is not None and (
                not _is_string(target.data.get("sha256"))
                or not SHA256_PATTERN.fullmatch(target.data["sha256"])
            ):
                library.error(record.path, "derived_from artifact must have an exact sha256")
        if record.record_type == "artifact" and "support_artifacts" in record.data:
            support_artifacts = record.data["support_artifacts"]
            if not isinstance(support_artifacts, list) or not support_artifacts:
                library.error(record.path, "support_artifacts must be a nonempty array of tables")
            else:
                seen_ids: set[str] = set()
                seen_references: set[str] = set()
                for ordinal, support in enumerate(support_artifacts, start=1):
                    label = f"support_artifacts[{ordinal}]"
                    if not isinstance(support, dict):
                        library.error(record.path, f"{label} must be a table")
                        continue
                    unknown = sorted(set(support) - SUPPORT_ARTIFACT_FIELDS)
                    missing = sorted(SUPPORT_ARTIFACT_FIELDS - set(support))
                    if unknown:
                        library.error(record.path, f"{label} has unknown fields: {', '.join(unknown)}")
                    if missing:
                        library.error(record.path, f"{label} is missing: {', '.join(missing)}")
                    artifact_id = support.get("artifact_id")
                    embedded_reference = support.get("embedded_reference")
                    if not _is_string(artifact_id) or not ID_PATTERN.fullmatch(artifact_id):
                        library.error(record.path, f"{label}.artifact_id must be a valid source id")
                    elif artifact_id in seen_ids:
                        library.error(record.path, f"{label}.artifact_id is duplicated")
                    else:
                        seen_ids.add(artifact_id)
                    if not _is_safe_embedded_reference(embedded_reference):
                        library.error(record.path, f"{label}.embedded_reference must be a safe relative path")
                    elif embedded_reference in seen_references:
                        library.error(record.path, f"{label}.embedded_reference is duplicated")
                    else:
                        seen_references.add(embedded_reference)
                    target = library.records.get(artifact_id) if _is_string(artifact_id) else None
                    if artifact_id == record.record_id:
                        library.error(record.path, f"{label}.artifact_id must not reference itself")
                    elif target is None:
                        if _is_string(artifact_id):
                            library.error(record.path, f"{label} references unknown source id: {artifact_id}")
                    elif target.record_type != "artifact":
                        library.error(record.path, f"{label}.artifact_id must reference an artifact record")
                    elif target.data.get("edition_id") != record.data.get("edition_id"):
                        library.error(record.path, f"{label}.artifact_id must belong to the same edition")
                    elif (
                        target.data.get("storage") != "tracked"
                        or not _is_string(target.data.get("sha256"))
                        or not SHA256_PATTERN.fullmatch(target.data["sha256"])
                    ):
                        library.error(record.path, f"{label}.artifact_id must reference an exact tracked artifact")
        if record.record_type == "segment":
            artifact_id = record.data.get("artifact_id")
            target = library.records.get(artifact_id) if _is_string(artifact_id) else None
            if target is not None and target.record_type != "artifact":
                library.error(record.path, "artifact_id must reference an artifact record")
            artifact_sha256 = record.data.get("artifact_sha256")
            if not _is_string(artifact_sha256) or not SHA256_PATTERN.fullmatch(artifact_sha256):
                library.error(record.path, "segment requires artifact_sha256")
            elif target is not None and target.data.get("sha256") != artifact_sha256:
                library.error(record.path, "artifact_sha256 does not match the controlling artifact")
        if record.record_type == "passage":
            schema = record.data.get("schema")
            artifact_id = record.data.get("artifact_id")
            segment_id = record.data.get("segment_id")
            if schema == 2 and (
                _is_string(artifact_id) == _is_string(segment_id)
            ):
                library.error(
                    record.path,
                    "schema 2 passage requires exactly one of artifact_id or segment_id",
                )
            direct_artifact = (
                library.records.get(artifact_id)
                if _is_string(artifact_id)
                else None
            )
            segment = (
                library.records.get(segment_id)
                if _is_string(segment_id)
                else None
            )
            if direct_artifact is not None and direct_artifact.record_type != "artifact":
                library.error(record.path, "artifact_id must reference an artifact record")
            elif (
                direct_artifact is not None
                and direct_artifact.data.get("edition_id") != record.data.get("edition_id")
            ):
                library.error(record.path, "artifact_id must belong to the passage edition")
            if segment is not None and segment.record_type != "segment":
                library.error(record.path, "segment_id must reference a segment record")
            elif (
                segment is not None
                and segment.data.get("edition_id") != record.data.get("edition_id")
            ):
                library.error(record.path, "segment_id must belong to the passage edition")
            target = direct_artifact
            if segment is not None and segment.record_type == "segment":
                controller = segment.data.get("artifact_id")
                target = (
                    library.records.get(controller)
                    if _is_string(controller)
                    else None
                )
            states = record.data.get("states", [])
            reviewed = (
                _is_string_list(states, allow_empty=False)
                and bool(FINGERPRINTED_STATES & set(states))
            )
            if reviewed or schema == 2:
                if target is None or target.record_type != "artifact":
                    library.error(record.path, "passage requires an exact controlling artifact")
                artifact_sha256 = record.data.get("artifact_sha256")
                if not _is_string(artifact_sha256) or not SHA256_PATTERN.fullmatch(artifact_sha256):
                    library.error(record.path, "passage requires artifact_sha256")
                elif target is not None and target.data.get("sha256") != artifact_sha256:
                    library.error(record.path, "artifact_sha256 does not match the controlling artifact")
        if record.record_type == "corpus":
            members = record.data.get("members")
            if _is_string_list(members, allow_empty=False):
                if len(members) != len(set(members)):
                    library.error(record.path, "members contains duplicates")
                for member in members:
                    target = library.records.get(member)
                    if target is not None and target.record_type != "artifact":
                        library.error(record.path, "members must reference exact artifact records")
                    elif target is not None and not SHA256_PATTERN.fullmatch(str(target.data.get("sha256", ""))):
                        library.error(record.path, f"member artifact has no exact sha256: {member}")
                expected_snapshot = _corpus_snapshot(library, members)
                if expected_snapshot is not None and record.data.get("snapshot") != expected_snapshot:
                    library.error(
                        record.path,
                        f"snapshot must be {expected_snapshot!r} for the declared artifacts",
                    )

    for binding in library.bindings:
        target = library.records.get(binding.source_id)
        if target is None:
            library.error(binding.path, f"bindings[{binding.ordinal}] references unknown source id: {binding.source_id}")
            continue
        if target.data.get("schema") == 2 and binding.schema != 2:
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}] must use schema 2 when naming a schema 2 source",
            )
        states = binding.data.get("states", [])
        valid_states = states if _is_string_list(states, allow_empty=False) else []
        exact_artifacts = _exact_artifacts(library, target)
        exact_required = {"acquired", "inspected", "verified"} & set(valid_states)
        if exact_required and (
            not exact_artifacts
            or any(
                not _is_string(artifact.data.get("sha256"))
                or not SHA256_PATTERN.fullmatch(artifact.data["sha256"])
                for artifact in exact_artifacts
            )
        ):
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}] {', '.join(sorted(exact_required))} state requires exact hashed artifacts",
            )
        if {"inspected", "verified"} & set(valid_states) and target.record_type in {"work", "edition"}:
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}] inspection or verification requires an artifact, segment, passage, or corpus witness",
            )
        if "searched" in valid_states:
            if target.record_type not in {"artifact", "segment", "passage", "corpus"}:
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] searched source must be an exact artifact, ranged passage, or corpus; schema 2 also permits ranged segments",
                )
            if target.record_type in {"segment", "passage"} and not _physical_line_ranges(target):
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] searched ranged source requires physical_line_ranges",
                )
            if not exact_artifacts or any(
                not _is_search_eligible_artifact(artifact)
                for artifact in exact_artifacts
            ):
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] searched boundary must contain only indexable tracked artifacts",
                )
        if (
            _is_string(binding.data.get("role"))
            and binding.data["role"]
            in {"direct-witness", "textual-control", "translation-control"}
            and target.record_type != "passage"
            and not _is_string_list(binding.data.get("loci"), allow_empty=False)
        ):
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}] direct textual use requires loci or a passage source",
            )
        if target.record_type == "passage" and _is_string_list(binding.data.get("loci"), allow_empty=False):
            if target.data.get("locus") not in binding.data["loci"]:
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] loci do not include the bound passage locus",
                )


def _safe_source_path(library: Library, manifest: Path, value: str) -> Path | None:
    if any(ord(character) < 32 for character in value):
        library.error(manifest, "artifact path must not contain control characters")
        return None
    try:
        candidate = Path(value)
    except (OSError, ValueError) as error:
        library.error(manifest, f"invalid artifact path: {error}")
        return None
    if candidate.is_absolute() or ".." in candidate.parts:
        library.error(manifest, "artifact path must be repository-relative without '..'")
        return None
    lexical = library.root / candidate
    if lexical.is_symlink():
        library.error(manifest, "artifact path must not be a symbolic link")
        return None
    try:
        resolved = lexical.resolve()
    except (OSError, ValueError) as error:
        library.error(manifest, f"invalid artifact path: {error}")
        return None
    source_resolved = library.source_root.resolve()
    try:
        resolved.relative_to(source_resolved)
    except ValueError:
        library.error(manifest, "artifact path must resolve beneath src/sources")
        return None
    try:
        resolved.relative_to(manifest.parent.resolve())
    except ValueError:
        library.error(manifest, "artifact path must resolve beneath its artifact manifest directory")
        return None
    if resolved == manifest.resolve():
        library.error(manifest, "artifact path must not name artifact.toml")
        return None
    return resolved


def _is_iso_date(value: Any) -> bool:
    if not _is_string(value):
        return False
    try:
        return dt.date.fromisoformat(value).isoformat() == value
    except ValueError:
        return False


def _is_safe_public_url(value: Any) -> bool:
    if not _is_string(value):
        return False
    if any(character.isspace() or ord(character) < 32 for character in value):
        return False
    try:
        parsed = urlsplit(value)
        host = parsed.hostname
        if (
            parsed.scheme not in {"http", "https"}
            or not host
            or parsed.username is not None
            or parsed.password is not None
        ):
            return False
        parsed.port
        normalized = host.rstrip(".").lower()
        if normalized == "localhost" or normalized.endswith(
            (
                ".example",
                ".home",
                ".internal",
                ".invalid",
                ".lan",
                ".local",
                ".localdomain",
                ".localhost",
                ".test",
            )
        ):
            return False
        try:
            address = ipaddress.ip_address(normalized)
        except ValueError:
            if "." not in normalized:
                return False
            labels = normalized.split(".")
            if all(
                re.fullmatch(r"(?:0[xX][0-9a-fA-F]+|0[0-7]+|[0-9]+)", label)
                for label in labels
            ):
                return False
            return all(
                label
                and label[0].isalnum()
                and label[-1].isalnum()
                and all(character.isalnum() or character == "-" for character in label)
                for label in labels
            )
        return not (
            address.is_private
            or address.is_loopback
            or address.is_link_local
            or address.is_reserved
            or address.is_unspecified
        )
    except ValueError:
        return False


def _is_searchable_media(value: Any) -> bool:
    if not _is_string(value):
        return False
    media_type = value.lower().split(";", 1)[0].strip()
    return (
        media_type.startswith("text/")
        or media_type in {"application/json", "application/xml"}
        or media_type.endswith("+json")
        or media_type.endswith("+xml")
    )


def _is_search_eligible_artifact(record: Record) -> bool:
    return (
        record.record_type == "artifact"
        and record.data.get("storage") == "tracked"
        and record.data.get("indexable") is True
        and record.data.get("encoding") == "utf-8"
        and _is_searchable_media(record.data.get("media_type"))
    )


def _hash_and_size(path: Path) -> tuple[str, int]:
    digest = hashlib.sha256()
    size = 0
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
            size += len(chunk)
    return digest.hexdigest(), size


def _validate_utf8(library: Library, manifest: Path, path: Path) -> None:
    try:
        with path.open("r", encoding="utf-8") as source:
            for _chunk in iter(lambda: source.read(1024 * 1024), ""):
                pass
    except (OSError, UnicodeError) as error:
        library.error(manifest, f"indexable artifact is not readable UTF-8: {error}")


def _validate_artifacts(library: Library) -> None:
    declared_paths: dict[Path, Record] = {}
    declared_hashes: dict[str, Record] = {}
    for record in sorted(library.records.values(), key=lambda item: item.record_id):
        if record.record_type != "artifact":
            continue
        data = record.data
        storage = data.get("storage")
        rights = data.get("rights_status")
        if not _is_string(storage) or storage not in STORAGE_DISPOSITIONS:
            library.error(record.path, f"storage must be one of: {', '.join(sorted(STORAGE_DISPOSITIONS))}")
        if not _is_string(rights) or rights not in RIGHTS_STATUSES:
            library.error(record.path, f"rights_status must be one of: {', '.join(sorted(RIGHTS_STATUSES))}")
        if "indexable" in data and not isinstance(data["indexable"], bool):
            library.error(record.path, "indexable must be boolean")
        if "byte_size" in data and (not isinstance(data["byte_size"], int) or isinstance(data["byte_size"], bool) or data["byte_size"] < 0):
            library.error(record.path, "byte_size must be a nonnegative integer")
        sha256 = data.get("sha256")
        if sha256 is not None and (not _is_string(sha256) or not SHA256_PATTERN.fullmatch(sha256)):
            library.error(record.path, "sha256 must be 64 lowercase hexadecimal characters")
        if "retrieved" in data and not _is_iso_date(data["retrieved"]):
            library.error(record.path, "retrieved must be an ISO date in YYYY-MM-DD form")
        if "source_url" in data and not _is_safe_public_url(data["source_url"]):
            library.error(record.path, "source_url must be a public http(s) URL without credentials")
        if _is_string(rights) and rights in {"public-domain", "legal-exception"} and not _is_string(data.get("rights_jurisdiction")):
            library.error(record.path, f"{rights} artifact requires rights_jurisdiction")
        if _is_string(data.get("derived_from")) and not _is_string(data.get("transformation")):
            library.error(record.path, "derived artifact requires transformation provenance")
        # A projection is made by a stated rule over its witnesses, so it
        # carries a transformation for the same reason a derivative does.
        if "transformation" in data and not (
            _is_string(data.get("derived_from")) or data.get("projected_from")
        ):
            library.error(record.path, "transformation requires derived_from or projected_from")
        if data.get("indexable") is True:
            if storage != "tracked" or not _is_searchable_media(data.get("media_type")):
                library.error(record.path, "indexable artifact must be tracked searchable text")
            if data.get("encoding") != "utf-8":
                library.error(record.path, 'indexable artifact encoding must be "utf-8"')

        artifact_path = data.get("path")
        if storage == "tracked":
            for field in ("path", "sha256", "byte_size"):
                if field not in data:
                    library.error(record.path, f"tracked artifact requires {field}")
            if not _is_string(rights) or rights not in TRACKABLE_RIGHTS:
                library.error(record.path, "tracked artifact requires an affirmative distribution rights_status")
            if not any(
                _is_string(data.get(field))
                for field in ("source_url", "provenance", "derived_from")
            ) and not data.get("projected_from"):
                library.error(
                    record.path,
                    "tracked artifact requires source_url, provenance, derived_from "
                    "or projected_from",
                )
            if not _is_iso_date(data.get("retrieved")):
                library.error(record.path, "tracked artifact requires retrieved ISO date")
            if _is_string(artifact_path):
                resolved = _safe_source_path(library, record.path, artifact_path)
                if resolved is not None:
                    prior_path = declared_paths.get(resolved)
                    if prior_path is not None:
                        library.error(
                            record.path,
                            f"artifact path is already owned by {prior_path.record_id}",
                        )
                    else:
                        declared_paths[resolved] = record
                        library.payload_paths.add(resolved)
                    if not resolved.is_file():
                        library.error(record.path, f"tracked artifact file does not exist: {artifact_path}")
                    else:
                        try:
                            actual_hash, actual_size = _hash_and_size(resolved)
                        except OSError as error:
                            library.error(record.path, f"cannot read tracked artifact: {error}")
                        else:
                            if _is_string(sha256) and SHA256_PATTERN.fullmatch(sha256) and actual_hash != sha256:
                                library.error(record.path, f"sha256 mismatch for {artifact_path}: {actual_hash}")
                            if isinstance(data.get("byte_size"), int) and not isinstance(data.get("byte_size"), bool) and actual_size != data["byte_size"]:
                                library.error(record.path, f"byte_size mismatch for {artifact_path}: {actual_size}")
                            if data.get("indexable") is True:
                                _validate_utf8(library, record.path, resolved)
                if _is_string(sha256) and SHA256_PATTERN.fullmatch(sha256):
                    prior_hash = declared_hashes.get(sha256)
                    if prior_hash is not None:
                        library.error(
                            record.path,
                            f"tracked sha256 is already owned by {prior_hash.record_id}",
                        )
                    else:
                        declared_hashes[sha256] = record
        elif artifact_path is not None:
            library.error(record.path, f"{storage or 'non-tracked'} artifact must not declare a tracked path")
        if storage == "remote" and not _is_string(data.get("source_url")):
            library.error(record.path, "remote artifact requires source_url")
        if ("sha256" in data or "byte_size" in data) and not _is_iso_date(data.get("retrieved")):
            library.error(record.path, "hashed artifact requires retrieved ISO date")

    for artifact_directory in sorted(
        library.source_root.glob("works/*/*/editions/*/artifacts/*")
    ):
        if artifact_directory.is_symlink():
            library.error(artifact_directory, "artifact directory must not be a symbolic link")
            continue
        if not artifact_directory.is_dir():
            continue
        for entry in sorted(artifact_directory.rglob("*")):
            if entry.is_symlink():
                library.error(entry, "artifact directory must not contain symbolic links")
                continue
            if not entry.is_file() or entry == artifact_directory / "artifact.toml":
                continue
            if entry.resolve() not in declared_paths:
                library.error(entry, "artifact payload is not declared by its local artifact manifest")


def _validate_support_artifact_references(library: Library) -> None:
    """Prove that first-class companion mappings occur in exact parent bytes."""

    for record in sorted(library.records.values(), key=lambda item: item.record_id):
        support_artifacts = record.data.get("support_artifacts")
        if record.record_type != "artifact" or not isinstance(support_artifacts, list):
            continue
        if record.data.get("storage") != "tracked":
            library.error(record.path, "support_artifacts requires a tracked parent artifact")
            continue
        path_value = record.data.get("path")
        if not _is_string(path_value):
            continue
        payload_path = _safe_source_path(library, record.path, path_value)
        if payload_path is None or not payload_path.is_file():
            continue
        try:
            payload = payload_path.read_bytes()
        except OSError as error:
            library.error(record.path, f"cannot inspect support_artifacts references: {error}")
            continue
        for ordinal, support in enumerate(support_artifacts, start=1):
            if not isinstance(support, dict):
                continue
            embedded_reference = support.get("embedded_reference")
            if (
                _is_safe_embedded_reference(embedded_reference)
                and embedded_reference.encode("utf-8") not in payload
            ):
                library.error(
                    record.path,
                    f"support_artifacts[{ordinal}].embedded_reference does not occur in the exact parent artifact",
                )


def _is_positive_int(value: Any) -> bool:
    return isinstance(value, int) and not isinstance(value, bool) and value > 0


def _normalized_space(value: str) -> str:
    return " ".join(value.split())


def _iter_physical_lines(source: Iterable[bytes]) -> Iterable[bytes]:
    """Yield LF-delimited byte lines using binary file-iteration semantics."""

    yield from source


@functools.lru_cache(maxsize=16)
def _decoded_physical_lines(path: Path, mtime_ns: int, size: int) -> tuple[str, ...]:
    """Every physical line of one artifact, decoded, kept for the next record.

    `_validate_passage_locators` walks records, not artifacts, and many records
    cite the same artifact: one `mass-propers show --bible` opened 934 files
    4,227 times and decoded 1,623 MB to inspect 138 MB, because each record
    re-read and re-decoded the whole payload to learn its line count. The
    records arrive sorted by id, which groups an edition's passages together,
    so the repeats are overwhelmingly consecutive --- a cache of one entry
    already answers two thirds of the opens, and sixteen answers three
    quarters, which is why this is bounded rather than a plain dict. Sixteen
    also bounds what it holds: these payloads are a quarter-megabyte typically
    and 2.5 MB at the largest.

    `mtime_ns` and `size` are the cache key, not decoration: a caller that
    rewrote a payload between two records must not be answered from the copy
    read before the write. The tuple is returned rather than a list because it
    is shared with every later caller and must not be edited by one of them.
    """
    with path.open("rb") as source:
        return tuple(
            line.decode("utf-8").rstrip("\r\n") for line in _iter_physical_lines(source)
        )


def _physical_line_ranges(record: Record) -> list[tuple[int, int]]:
    return _declared_ranges(record, "physical_line_ranges")


def _artifact_page_ranges(record: Record) -> list[tuple[int, int]]:
    return _declared_ranges(record, "artifact_page_ranges")


def _declared_ranges(record: Record, field: str) -> list[tuple[int, int]]:
    value = record.data.get(field)
    if not isinstance(value, list):
        return []
    ranges: list[tuple[int, int]] = []
    for item in value:
        if (
            isinstance(item, list)
            and len(item) == 2
            and _is_positive_int(item[0])
            and _is_positive_int(item[1])
            and item[0] <= item[1]
        ):
            ranges.append((item[0], item[1]))
    return ranges


def _controlling_artifact(library: Library, record: Record) -> Record | None:
    if record.record_type == "artifact":
        return record
    artifact_id = record.data.get("artifact_id")
    if record.record_type == "passage" and _is_string(record.data.get("segment_id")):
        segment = library.records.get(record.data["segment_id"])
        artifact_id = (
            segment.data.get("artifact_id")
            if segment is not None and segment.record_type == "segment"
            else None
        )
    artifact = library.records.get(artifact_id) if _is_string(artifact_id) else None
    return artifact if artifact is not None and artifact.record_type == "artifact" else None


def _validate_range_field(
    library: Library,
    record: Record,
    field: str,
) -> list[tuple[int, int]]:
    raw_ranges = record.data.get(field)
    if raw_ranges is None:
        return []
    if not isinstance(raw_ranges, list) or not raw_ranges:
        library.error(
            record.path,
            f"{field} must be a nonempty array of [start, end] pairs",
        )
        return []
    valid_ranges: list[tuple[int, int]] = []
    previous_end = 0
    for ordinal, item in enumerate(raw_ranges, start=1):
        label = f"{field}[{ordinal}]"
        if not isinstance(item, list) or len(item) != 2:
            library.error(
                record.path,
                f"{label} must be a two-integer [start, end] pair",
            )
            continue
        start, end = item
        if not _is_positive_int(start) or not _is_positive_int(end):
            library.error(
                record.path,
                f"{label} values must be positive non-boolean integers",
            )
            continue
        if start > end:
            library.error(record.path, f"{label} start must not exceed end")
            continue
        if start <= previous_end:
            library.error(record.path, f"{label} must be sorted and non-overlapping")
        previous_end = max(previous_end, end)
        valid_ranges.append((start, end))
    return valid_ranges


def _ranges_are_contained(
    children: Sequence[tuple[int, int]],
    parents: Sequence[tuple[int, int]],
) -> bool:
    return all(
        any(parent_start <= start and end <= parent_end for parent_start, parent_end in parents)
        for start, end in children
    )


def _validate_passage_locators(library: Library) -> None:
    """Validate ranged segments, passages, and checked transcription segments."""

    for record in sorted(library.records.values(), key=lambda item: item.record_id):
        if record.record_type not in {"segment", "passage"}:
            continue
        data = record.data
        states = data.get("states")
        reviewed = (
            _is_string_list(states, allow_empty=False)
            and bool({"inspected", "verified"} & set(states))
        )
        artifact = _controlling_artifact(library, record)
        indexable_artifact = (
            artifact is not None
            and _is_search_eligible_artifact(artifact)
        )
        raw_line_ranges = data.get("physical_line_ranges")
        raw_page_ranges = data.get("artifact_page_ranges")
        if record.record_type == "segment" and raw_line_ranges is None and raw_page_ranges is None:
            library.error(
                record.path,
                "segment requires physical_line_ranges or artifact_page_ranges",
            )
        if reviewed and indexable_artifact and raw_line_ranges is None:
            label = "passage" if record.record_type == "passage" else "segment"
            library.error(
                record.path,
                f"inspected or verified text {label} requires physical_line_ranges",
            )
        valid_line_ranges = _validate_range_field(
            library, record, "physical_line_ranges"
        )
        valid_page_ranges = _validate_range_field(
            library, record, "artifact_page_ranges"
        )
        if raw_line_ranges is not None and not indexable_artifact:
            library.error(
                record.path,
                "physical_line_ranges requires an indexable tracked UTF-8 artifact",
            )
        if raw_page_ranges is not None:
            page_count = artifact.data.get("page_count") if artifact is not None else None
            if not _is_positive_int(page_count):
                library.error(
                    record.path,
                    "artifact_page_ranges requires a controlling artifact with page_count",
                )
            else:
                for ordinal, (_start, end) in enumerate(
                    valid_page_ranges, start=1
                ):
                    if end > page_count:
                        library.error(
                            record.path,
                            f"artifact_page_ranges[{ordinal}] ends after artifact page {page_count}",
                        )

        segment = None
        if record.record_type == "passage" and _is_string(data.get("segment_id")):
            candidate = library.records.get(data["segment_id"])
            if candidate is not None and candidate.record_type == "segment":
                segment = candidate
        if segment is not None:
            if valid_line_ranges and not _ranges_are_contained(
                valid_line_ranges, _physical_line_ranges(segment)
            ):
                library.error(
                    record.path,
                    "physical_line_ranges must be contained by the controlling segment",
                )
            if valid_page_ranges and not _ranges_are_contained(
                valid_page_ranges, _artifact_page_ranges(segment)
            ):
                library.error(
                    record.path,
                    "artifact_page_ranges must be contained by the controlling segment",
                )

        text = data.get("text")
        raw_segments = data.get("transcription_segments")
        if record.record_type == "segment" and (
            text is not None or raw_segments is not None
        ):
            library.error(record.path, "segment records cannot contain passage text")
        if text is not None and not reviewed:
            library.error(record.path, "text requires the inspected or verified state")
        if text is not None and raw_segments is None:
            library.error(record.path, "text requires transcription_segments")
        if raw_segments is not None and text is None:
            library.error(record.path, "transcription_segments requires text")
        if (text is not None or raw_segments is not None) and not indexable_artifact:
            library.error(
                record.path,
                "text and transcription_segments require an indexable tracked UTF-8 artifact",
            )

        if record.record_type != "passage":
            raw_segments = None
        if not indexable_artifact or not valid_line_ranges:
            continue
        path_value = artifact.data.get("path")
        if not _is_string(path_value):
            continue
        payload_path = _safe_source_path(library, artifact.path, path_value)
        if payload_path is None or not payload_path.is_file():
            continue
        try:
            payload_stat = payload_path.stat()
            decoded_lines = _decoded_physical_lines(
                payload_path, payload_stat.st_mtime_ns, payload_stat.st_size
            )
        except (OSError, UnicodeError) as error:
            library.error(record.path, f"cannot inspect passage physical lines: {error}")
            continue
        line_count = len(decoded_lines)
        for ordinal, (_start, end) in enumerate(valid_line_ranges, start=1):
            if end > line_count:
                library.error(
                    record.path,
                    f"physical_line_ranges[{ordinal}] ends after artifact line {line_count}",
                )

        if raw_segments is None:
            continue
        if not isinstance(raw_segments, list) or not raw_segments:
            library.error(record.path, "transcription_segments must be a nonempty array of tables")
            continue
        segment_texts: list[str] = []
        previous_line = 0
        previous_offset = 0
        for ordinal, segment in enumerate(raw_segments, start=1):
            label = f"transcription_segments[{ordinal}]"
            if not isinstance(segment, dict):
                library.error(record.path, f"{label} must be a table")
                continue
            unknown = sorted(set(segment) - PASSAGE_SEGMENT_FIELDS)
            missing = sorted(PASSAGE_SEGMENT_FIELDS - set(segment))
            if unknown:
                library.error(record.path, f"{label} has unknown fields: {', '.join(unknown)}")
            if missing:
                library.error(record.path, f"{label} is missing: {', '.join(missing)}")
            line_number = segment.get("line")
            segment_text = segment.get("text")
            if not _is_positive_int(line_number):
                library.error(record.path, f"{label}.line must be a positive non-boolean integer")
                continue
            if not _is_string(segment_text):
                library.error(record.path, f"{label}.text must be a nonempty string")
                continue
            if line_number < previous_line:
                library.error(record.path, f"{label} must be ordered by line and occurrence")
            if not any(start <= line_number <= end for start, end in valid_line_ranges):
                library.error(record.path, f"{label}.line is outside physical_line_ranges")
            if line_number > line_count:
                library.error(record.path, f"{label}.line is after artifact line {line_count}")
                continue
            line = decoded_lines[line_number - 1]
            offset = previous_offset if line_number == previous_line else 0
            occurrence = line.find(segment_text, offset)
            if occurrence < 0:
                library.error(record.path, f"{label}.text is not an exact ordered substring of its raw line")
            else:
                previous_offset = occurrence + len(segment_text)
            previous_line = line_number
            segment_texts.append(segment_text)
        if _is_string(text) and _normalized_space(" ".join(segment_texts)) != _normalized_space(text):
            library.error(record.path, "transcription_segments do not reproduce text exactly after whitespace joining")


def _validate_source_tree(library: Library) -> None:
    """Reject files that evade a manifest, schema, or inventory owner."""

    manifest_patterns = (
        "works/*/*/work.toml",
        "works/*/*/editions/*/edition.toml",
        "works/*/*/editions/*/artifacts/*/artifact.toml",
        "works/*/*/editions/*/segments/*.toml",
        "works/*/*/editions/*/passages/*.toml",
        "corpora/*.toml",
    )
    manifest_paths = {
        path
        for pattern in manifest_patterns
        for path in library.source_root.glob(pattern)
    }
    for entry in sorted(library.source_root.rglob("*")):
        if entry.is_symlink():
            library.error(entry, "source-library tree must not contain symbolic links")
            continue
        if not entry.is_file():
            continue
        relative = entry.relative_to(library.source_root)
        if relative == Path("README.md") or entry in manifest_paths:
            continue
        if relative.parts[0] == "schema" and entry.suffix in {".json", ".md", ".toml"}:
            continue
        if relative.parts[0] == "inventories" and entry.suffix in {".md", ".toml"}:
            continue
        # Bible, calendar and commentary records are tracked sources with their
        # own validators (index-bible, check-calendar-masses, citations); the
        # bibliographic schema owns neither their contents nor their formats.
        # The chapter fragments index-bible derives are .json and are checked
        # for staleness and for orphans by the tool that writes them.
        # The suffixes are here to keep an opaque unowned file — a pdf, an
        # archive — from sitting in a tree this schema does not read, not to
        # choose these trees' formats; the sentence above says as much.
        # `src/sources/bibles/<edition>/projection.tsv` is the third thing
        # index-bible writes into this tree and gates: `projection` refuses on a
        # stale row, a missing file or an orphan exactly as `check` does for
        # the index and the fragments, and the tabular form is the shape of the
        # alias tables it is derived from. Admitted under `bibles` and
        # `chronology`, the two of these trees whose own validator writes a
        # table; the next tree that needs it can say so here.
        #
        # `chronology` is the Scripture chronology corpus. Its authored records
        # are .yaml and its one derived table, `coverage.tsv`, is gated for
        # staleness by its own tool exactly as `projection.tsv` is here. It adds
        # no field to any record this schema owns and moves no
        # `source_fingerprint`: it names source ids and is read beside the
        # library, never inside it. guidance/scripture-chronology.md owns it.
        if relative.parts[0] in {
            "bibles",
            "calendars",
            "chronology",
            "commentary",
            "reading-plans",
        } and (
            entry.suffix in {".json", ".md", ".yaml"}
            or (relative.parts[0] in {"bibles", "chronology"} and entry.suffix == ".tsv")
        ):
            continue
        if entry.resolve() in library.payload_paths:
            continue
        if relative.parts[0] == "works" and entry.suffix == ".toml":
            # Canonical discovery or the local artifact scan already diagnoses it.
            continue
        library.error(entry, "file is outside the source-library schema and has no artifact owner")


def _ancestors(library: Library, source_id: str) -> set[str]:
    found: set[str] = set()
    pending = [source_id]
    while pending:
        current = pending.pop()
        if current in found:
            continue
        found.add(current)
        record = library.records.get(current)
        if record is not None:
            pending.extend(_dependency_ids(record))
    return found


def _ownership_dependency_ids(record: Record) -> list[str]:
    data = record.data
    if record.record_type == "edition":
        return [data["work_id"]] if _is_string(data.get("work_id")) else []
    if record.record_type in {"artifact", "segment", "passage"}:
        return [data["edition_id"]] if _is_string(data.get("edition_id")) else []
    if record.record_type == "corpus" and isinstance(data.get("members"), list):
        return [member for member in data["members"] if _is_string(member)]
    return []


def _ownership_ancestors(library: Library, source_id: str) -> set[str]:
    found: set[str] = set()
    pending = [source_id]
    while pending:
        current = pending.pop()
        if current in found:
            continue
        found.add(current)
        record = library.records.get(current)
        if record is not None:
            pending.extend(_ownership_dependency_ids(record))
    return found


def _work_for_source(library: Library, source_id: str) -> Record | None:
    works = [
        library.records[item]
        for item in _ownership_ancestors(library, source_id)
        if item in library.records and library.records[item].record_type == "work"
    ]
    return works[0] if len(works) == 1 else None


def _validate_loci(library: Library) -> None:
    for record in sorted(library.records.values(), key=lambda item: item.record_id):
        if record.record_type not in {"segment", "passage"}:
            continue
        if record.record_type == "passage":
            work = _work_for_source(library, record.record_id)
            pattern = work.data.get("locus_pattern") if work else None
            if _is_string(pattern) and _is_string(record.data.get("locus")):
                try:
                    if re.fullmatch(pattern, record.data["locus"]) is None:
                        library.error(record.path, f"locus does not match {work.record_id} locus_pattern: {record.data['locus']}")
                except (re.error, OverflowError, RecursionError):
                    pass
        states = record.data.get("states")
        if _is_string_list(states, allow_empty=False):
            invalid = sorted(set(states) - PASSAGE_STATES)
            if invalid:
                library.error(record.path, f"states has invalid values: {', '.join(invalid)}")
            if len(states) != len(set(states)):
                library.error(record.path, "states contains duplicates")
            if "verified" in states:
                if _controlling_artifact(library, record) is None:
                    library.error(
                        record.path,
                        f"verified {record.record_type} requires a controlling artifact",
                    )
                if not _is_iso_date(record.data.get("verified_on")):
                    library.error(
                        record.path,
                        f"verified {record.record_type} requires verified_on ISO date",
                    )
            elif "verified_on" in record.data:
                library.error(record.path, "verified_on requires the verified state")

    for binding in library.bindings:
        loci = binding.data.get("loci", [])
        if not isinstance(loci, list):
            continue
        work = _work_for_source(library, binding.source_id)
        pattern = work.data.get("locus_pattern") if work else None
        if not _is_string(pattern):
            continue
        for locus in loci:
            if _is_string(locus):
                try:
                    if re.fullmatch(pattern, locus) is None:
                        library.error(binding.path, f"bindings[{binding.ordinal}] locus does not match {work.record_id}: {locus}")
                except (re.error, OverflowError, RecursionError):
                    break


def _validate_artifact_licenses(library: Library) -> None:
    """A licence identifier belongs only on bytes a licence actually governs.

    `rights_status` says which kind of claim is being made and `license` says
    which licence, and the second only makes sense under the first. Public-domain
    bytes have no licence, and putting one on them would let a filter republish
    something on a permission nobody granted.
    """
    for record in library.records.values():
        if record.record_type != "artifact":
            continue
        identifier = record.data.get("license")
        if identifier is None:
            continue
        status = record.data.get("rights_status")
        if status not in {"licensed", "permission"}:
            library.error(
                record.path,
                f"license requires rights_status licensed or permission, not {status!r}",
            )


def _validate_work_dates(library: Library) -> None:
    """A work's composition date must carry the ground it rests on.

    `guidance/sources.md` settles which date belongs to which object: a work is
    composed once and dated by that, an edition is printed or translated and
    dated by that, and a composition date is never inferred from a printing
    date. The inference is silent when it happens — the wrong century is a
    well-formed integer — so the countermeasure is that stating one obliges you
    to say where it came from.
    """
    for record in library.records.values():
        if record.record_type != "work":
            continue
        composed = record.data.get("composed")
        basis = record.data.get("composed_basis")
        if basis is not None and composed is None:
            library.error(record.path, "composed_basis requires composed")
        if composed is not None and basis is None:
            library.error(
                record.path,
                "composed requires composed_basis: say what dates the writing, "
                "and never the printing (guidance/sources.md)",
            )


def _validate_cycles(library: Library) -> None:
    state: dict[str, int] = {}
    reported: set[frozenset[str]] = set()
    for start in sorted(library.records):
        if state.get(start, 0) != 0:
            continue
        state[start] = 1
        path = [start]
        positions = {start: 0}
        stack: list[tuple[str, Iterable[str]]] = [
            (
                start,
                iter(
                    sorted(
                        dependency
                        for dependency in _dependency_ids(library.records[start])
                        if dependency in library.records
                    )
                ),
            )
        ]
        while stack:
            current, dependencies = stack[-1]
            try:
                dependency = next(dependencies)
            except StopIteration:
                stack.pop()
                state[current] = 2
                positions.pop(current, None)
                path.pop()
                continue
            dependency_state = state.get(dependency, 0)
            if dependency_state == 0:
                state[dependency] = 1
                positions[dependency] = len(path)
                path.append(dependency)
                stack.append(
                    (
                        dependency,
                        iter(
                            sorted(
                                child
                                for child in _dependency_ids(library.records[dependency])
                                if child in library.records
                            )
                        ),
                    )
                )
            elif dependency_state == 1:
                cycle = path[positions[dependency] :]
                cycle_key = frozenset(cycle)
                if cycle_key not in reported:
                    reported.add(cycle_key)
                    record = library.records[dependency]
                    library.error(
                        record.path,
                        f"source dependency cycle: {' -> '.join(cycle)}",
                    )


def _validate_binding_fingerprints(library: Library) -> None:
    cache: dict[str, str] = {}
    for binding in library.bindings:
        states = binding.data.get("states", [])
        reviewed = (
            _is_string_list(states, allow_empty=False)
            and bool(FINGERPRINTED_STATES & set(states))
        )
        supplied = binding.data.get("source_fingerprint")
        if reviewed:
            if not _is_string(supplied) or not FINGERPRINT_PATTERN.fullmatch(supplied):
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] reviewed state requires canonical source_fingerprint",
                )
                continue
            try:
                expected = source_fingerprint(library, binding.source_id, _cache=cache)
            except (KeyError, SourceLibraryQueryError):
                continue
            if supplied != expected:
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}].source_fingerprint must be {expected!r}",
                )
        elif supplied is not None:
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}].source_fingerprint requires a reviewed state",
            )


def _validate_search_receipts(library: Library) -> None:
    """Re-run registered searches and prove their recorded result counts."""

    cache: dict[tuple[str, str, str], int] = {}
    for binding in library.bindings:
        states = binding.data.get("states")
        if not _is_string_list(states, allow_empty=False) or "searched" not in states:
            continue
        target = library.records.get(binding.source_id)
        mode = binding.data.get("search_mode")
        query = binding.data.get("query")
        matching_line_count = binding.data.get("matching_line_count")
        if (
            target is None
            or target.record_type not in {"artifact", "segment", "passage", "corpus"}
            or not _is_string(mode)
            or mode not in SEARCH_MODES
            or not _is_string(query)
            or not isinstance(matching_line_count, int)
            or isinstance(matching_line_count, bool)
            or matching_line_count < 0
        ):
            continue
        artifacts = _exact_artifacts(library, target)
        if binding.data.get("role") == "negative-search" and any(
            not _is_string(artifact.data.get("media_type"))
            or artifact.data["media_type"].split(";", 1)[0].strip().lower()
            != "text/plain"
            for artifact in artifacts
        ):
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}] negative-search requires text/plain search representations",
            )
        key = (binding.source_id, mode, query)
        if key not in cache:
            try:
                cache[key] = len(
                    search_rows(
                        library,
                        binding.source_id,
                        query,
                        case_sensitive=SEARCH_MODES[mode],
                    )
                )
            except (KeyError, SourceLibraryQueryError) as error:
                library.error(
                    binding.path,
                    f"bindings[{binding.ordinal}] cannot verify search receipt: {error}",
                )
                continue
        if matching_line_count != cache[key]:
            library.error(
                binding.path,
                f"bindings[{binding.ordinal}].matching_line_count must be {cache[key]} for the exact search",
            )


def _preflight_tree(library: Library, root: Path, label: str) -> bool:
    """Prove a tree is local and symlink-free before recursive discovery."""

    if _path_contains_symlink(root, library.root):
        library.errors.append(
            f"{library.relative(root)}: {label} root path must not contain symbolic links"
        )
        return False
    if not root.is_dir():
        library.errors.append(f"{library.relative(root)}: {label} root is not a directory")
        return False
    safe = True
    for current, directories, filenames in os.walk(root, followlinks=False):
        current_path = Path(current)
        retained_directories = []
        for name in directories:
            path = current_path / name
            if path.is_symlink():
                library.error(path, f"{label} tree must not contain symbolic links")
                safe = False
            else:
                retained_directories.append(name)
        directories[:] = retained_directories
        for name in filenames:
            path = current_path / name
            if path.is_symlink():
                library.error(path, f"{label} tree must not contain symbolic links")
    return safe


LIBRARY_CACHE_DIR = ROOT / "build" / "source-library"
LIBRARY_CACHE_VERSION = "1"
# A sandbox library is a handful of manifests; the real one is over 22,000
# files. Below this the load is already cheap and the entry would never be read
# twice, so the suite's throwaway trees leave nothing behind.
LIBRARY_CACHE_FLOOR = 1000


def _library_cache_entry(root: Path, check_binding_fingerprints: bool) -> Path | None:
    """Where this tree's loaded library is kept, or None where it is not cached."""
    if os.environ.get("TRIPTYCH_LIBRARY_CACHE") == "0":
        return None
    roots = [root / "src/sources", root / "src/gpt", root / "src/claude"]
    if not (root / "src/sources").is_dir():
        return None
    fingerprint, counted = tree_fingerprint([r for r in roots if r.is_dir()])
    if counted < LIBRARY_CACHE_FLOOR:
        return None
    # The flag changes which validations run, so it changes the errors and must
    # be part of the identity rather than an unrecorded assumption.
    suffix = "fp" if check_binding_fingerprints else "nofp"
    return LIBRARY_CACHE_DIR / f"{LIBRARY_CACHE_VERSION}-{fingerprint}-{suffix}.json"


def _library_as_json(library: Library) -> dict[str, Any]:
    """The library as plain data: every Path a string, every set a sorted list."""
    return {
        "root": str(library.root),
        "source_root": str(library.source_root),
        "publication_roots": [str(path) for path in library.publication_roots],
        "records": {
            record_id: {
                "path": str(record.path),
                "record_type": record.record_type,
                "record_id": record.record_id,
                "data": record.data,
            }
            for record_id, record in library.records.items()
        },
        "bindings": [
            {
                "path": str(binding.path),
                "document": binding.document,
                "schema": binding.schema,
                "ordinal": binding.ordinal,
                "source_id": binding.source_id,
                "data": binding.data,
            }
            for binding in library.bindings
        ],
        "payload_paths": sorted(str(path) for path in library.payload_paths),
        "errors": list(library.errors),
    }


def _library_from_json(held: dict[str, Any]) -> Library:
    """Rebuild the library the projection came from."""
    return Library(
        root=Path(held["root"]),
        source_root=Path(held["source_root"]),
        publication_roots=[Path(path) for path in held["publication_roots"]],
        records={
            record_id: Record(
                path=Path(row["path"]),
                record_type=row["record_type"],
                record_id=row["record_id"],
                data=row["data"],
            )
            for record_id, row in held["records"].items()
        },
        bindings=[
            Binding(
                path=Path(row["path"]),
                document=row["document"],
                schema=row["schema"],
                ordinal=row["ordinal"],
                source_id=row["source_id"],
                data=row["data"],
            )
            for row in held["bindings"]
        ],
        payload_paths={Path(path) for path in held["payload_paths"]},
        errors=list(held["errors"]),
    )


def load_library(
    root: Path = ROOT,
    *,
    check_binding_fingerprints: bool = True,
) -> Library:
    """Load and validate the source graph rooted at *root*.

    The result is cached on disk under ignored `build/`, keyed by a stat
    fingerprint of the trees it reads. Loading parses 8,632 TOML manifests and
    validates the graph over them: three seconds, and every tool that answers
    any question about a source pays it in a fresh process. One workflow gate
    runs `check-content-preflight` nine times, of which `bindings-valid` alone
    was 3.16s of the 3.6s; the shell suite runs hundreds of such tools. The
    fingerprint costs 60ms and the cached load about 50ms.

    A cached library is written only when it survives its own round trip ---
    `_library_from_json(_library_as_json(library)) == library`, compared with
    the dataclass equality of `Library`, `Record` and `Binding` --- so a
    projection that lost a `Path`, a set, or an integer key to JSON is never
    stored and the load happens as it always did. Serving a library that
    differs from the one the loader would have built is precisely the
    reference that resolves successfully and wrongly.

    `TRIPTYCH_LIBRARY_CACHE=0` disables it.
    """

    root = root.resolve()
    entry = _library_cache_entry(root, check_binding_fingerprints)
    if entry is not None:
        try:
            return _library_from_json(
                json.loads(entry.read_text(encoding="utf-8"))
            )
        except (OSError, ValueError, KeyError, TypeError):
            pass

    library = Library(
        root=root,
        source_root=root / "src/sources",
        publication_roots=[root / "src/gpt", root / "src/claude"],
    )
    sources_safe = _preflight_tree(library, library.source_root, "source-library")
    publications_safe = all(
        [
            _preflight_tree(library, publication_root, "publication")
            for publication_root in _existing_publication_roots(library)
        ]
    )
    if not sources_safe or not publications_safe:
        library.errors.sort()
        return library
    _load_source_records(library)
    _load_bindings(library)
    _validate_relationships(library)
    _validate_artifacts(library)
    _validate_support_artifact_references(library)
    _validate_passage_locators(library)
    _validate_search_receipts(library)
    _validate_source_tree(library)
    _validate_loci(library)
    _validate_work_dates(library)
    _validate_artifact_licenses(library)
    _validate_cycles(library)
    if check_binding_fingerprints:
        _validate_binding_fingerprints(library)
    library.errors.sort()

    if entry is not None:
        try:
            held = _library_as_json(library)
            if _library_from_json(held) == library:
                entry.parent.mkdir(parents=True, exist_ok=True)
                # Written aside and renamed: these run in parallel, and a
                # half-written entry read by a sibling is a wrong answer.
                aside = entry.with_suffix(f".{os.getpid()}.tmp")
                aside.write_text(json.dumps(held), encoding="utf-8")
                os.replace(aside, entry)
                _prune_cache(entry.parent, keep=4)
        except (OSError, TypeError, ValueError, RecursionError):
            pass

    return library


def binding_rows(library: Library, source_id: str, locus: str | None = None) -> list[dict[str, Any]]:
    """Return consumer bindings whose source depends on *source_id*."""

    if source_id not in library.records:
        raise KeyError(source_id)
    rows: list[dict[str, Any]] = []
    for binding in library.bindings:
        if source_id not in _ancestors(library, binding.source_id):
            continue
        loci = binding.data.get("loci", [])
        bound_source = library.records.get(binding.source_id)
        if (
            not loci
            and bound_source is not None
            and bound_source.record_type == "passage"
            and _is_string(bound_source.data.get("locus"))
        ):
            loci = [bound_source.data["locus"]]
        if locus is not None and locus not in loci:
            continue
        rows.append(
            {
                "document": binding.document,
                "source_id": binding.source_id,
                "loci": list(loci) if isinstance(loci, list) else [],
                "role": binding.data.get("role", ""),
                "states": list(binding.data.get("states", [])),
                "path": library.relative(binding.path),
            }
        )
    return sorted(rows, key=lambda row: (row["document"], row["source_id"], row["loci"], row["role"]))


def impact_rows(library: Library, source_id: str, locus: str | None = None) -> list[dict[str, Any]]:
    """Return dependent source records and publication bindings."""

    if source_id not in library.records:
        raise KeyError(source_id)
    rows: list[dict[str, Any]] = []
    for record in library.records.values():
        if record.record_id != source_id and source_id in _ancestors(library, record.record_id):
            rows.append(
                {
                    "kind": "source",
                    "id": record.record_id,
                    "type": record.record_type,
                    "path": library.relative(record.path),
                }
            )
    for binding in binding_rows(library, source_id, locus):
        rows.append(
            {
                "kind": "document",
                "id": binding["document"],
                "type": binding["role"],
                "source_id": binding["source_id"],
                "loci": binding["loci"],
                "states": binding["states"],
                "path": binding["path"],
            }
        )
    return sorted(
        rows,
        key=lambda row: (
            row["kind"],
            row["id"],
            row["type"],
            row.get("source_id", ""),
            tuple(row.get("loci", [])),
            tuple(row.get("states", [])),
            row["path"],
        ),
    )


def _artifact_ids_for_search(library: Library, source_id: str) -> list[str]:
    record = library.records[source_id]
    if record.record_type == "artifact":
        return [source_id]
    if record.record_type == "segment":
        artifact_id = record.data.get("artifact_id")
        return [artifact_id] if _is_string(artifact_id) and artifact_id in library.records else []
    if record.record_type == "passage":
        artifact_id = record.data.get("artifact_id")
        if _is_string(record.data.get("segment_id")):
            segment = library.records.get(record.data["segment_id"])
            artifact_id = (
                segment.data.get("artifact_id")
                if segment is not None and segment.record_type == "segment"
                else None
            )
        return [artifact_id] if _is_string(artifact_id) and artifact_id in library.records else []
    if record.record_type == "corpus":
        members = record.data.get("members")
        if not isinstance(members, list):
            return []
        return sorted(
            member
            for member in members
            if _is_string(member)
            and member in library.records
            and library.records[member].record_type == "artifact"
        )
    if record.record_type in {"work", "edition"}:
        found = []
        for candidate in library.records.values():
            if (
                candidate.record_type == "artifact"
                and source_id in _ownership_ancestors(library, candidate.record_id)
            ):
                found.append(candidate.record_id)
        return sorted(found)
    return []


def search_rows(library: Library, source_id: str, query: str, *, case_sensitive: bool = False) -> list[dict[str, Any]]:
    """Run a literal query against each physical UTF-8 line in the boundary."""

    if source_id not in library.records:
        raise KeyError(source_id)
    if not _is_string(query):
        raise SourceLibraryQueryError("search query must contain non-whitespace text")
    if "\n" in query or "\r" in query:
        raise SourceLibraryQueryError(
            "raw-line search query must not contain a line break"
        )
    needle = query if case_sensitive else query.casefold()
    rows: list[dict[str, Any]] = []
    source_record = library.records[source_id]
    ranged_source_ranges = (
        _physical_line_ranges(source_record)
        if source_record.record_type in {"segment", "passage"}
        else []
    )
    if source_record.record_type in {"segment", "passage"} and not ranged_source_ranges:
        raise SourceLibraryQueryError(
            f"{source_record.record_type} search requires validated physical_line_ranges"
        )
    selected = _artifact_ids_for_search(library, source_id)
    eligible = [
        artifact_id
        for artifact_id in selected
        if _is_search_eligible_artifact(library.records[artifact_id])
    ]
    if source_record.record_type in {"artifact", "segment", "passage", "corpus"} and eligible != selected:
        raise SourceLibraryQueryError(
            "exact artifact, ranged segment, ranged passage, or corpus search boundary contains a non-indexable artifact"
        )
    if not eligible:
        raise SourceLibraryQueryError("search boundary contains no indexable tracked artifacts")
    for artifact_id in eligible:
        artifact = library.records[artifact_id]
        data = artifact.data
        path_value = data.get("path")
        if not _is_string(path_value):
            raise SourceLibraryQueryError(f"indexable artifact has no path: {artifact_id}")
        path = _safe_source_path(library, artifact.path, path_value)
        if path is None or not path.is_file():
            raise SourceLibraryQueryError(f"indexable artifact is unavailable: {artifact_id}")
        try:
            digest = hashlib.sha256()
            byte_size = 0
            artifact_rows: list[dict[str, Any]] = []
            with path.open("rb") as source:
                for line_number, raw_line in enumerate(
                    _iter_physical_lines(source), start=1
                ):
                    digest.update(raw_line)
                    byte_size += len(raw_line)
                    line = raw_line.decode("utf-8").rstrip("\r\n")
                    if ranged_source_ranges and not any(
                        start <= line_number <= end
                        for start, end in ranged_source_ranges
                    ):
                        continue
                    haystack = line if case_sensitive else line.casefold()
                    if needle in haystack:
                        artifact_rows.append(
                            {
                                "artifact_id": artifact_id,
                                "line": line_number,
                                "text": line,
                                "path": library.relative(path),
                            }
                        )
            if (
                digest.hexdigest() != data.get("sha256")
                or byte_size != data.get("byte_size")
            ):
                raise SourceLibraryQueryError(
                    f"indexable artifact changed from its manifest: {artifact_id}"
                )
            rows.extend(artifact_rows)
        except SourceLibraryQueryError:
            raise
        except (OSError, UnicodeError) as error:
            raise SourceLibraryQueryError(
                f"cannot search indexable artifact {artifact_id}: {error}"
            ) from error
    return rows


def _print_errors(library: Library) -> int:
    for error in library.errors:
        print(f"source-library error: {error}", file=sys.stderr)
    return 1


def _print_rows(rows: Sequence[dict[str, Any]], output_format: str, fields: Sequence[str]) -> None:
    if output_format == "json":
        print(json.dumps(rows, ensure_ascii=False, indent=2, sort_keys=True))
        return
    for row in rows:
        values = []
        for field in fields:
            value = row.get(field, "")
            if isinstance(value, list):
                value = ",".join(str(item) for item in value)
            values.append(str(value))
        print("\t".join(values))


def _validated_library(args: argparse.Namespace) -> Library | None:
    library = load_library(Path(args.root))
    if library.errors:
        _print_errors(library)
        return None
    return library


def command_validate(args: argparse.Namespace) -> int:
    library = load_library(Path(args.root))
    if library.errors:
        return _print_errors(library)
    counts = defaultdict(int)
    for record in library.records.values():
        counts[record.record_type] += 1
    summary = " ".join(f"{kind}={counts[kind]}" for kind in sorted(RECORD_TYPES))
    print(f"source-library valid: {summary} bindings={len(library.bindings)}")
    return 0


def command_uses(args: argparse.Namespace) -> int:
    library = _validated_library(args)
    if library is None:
        return 1
    try:
        rows = binding_rows(library, args.source_id, args.locus)
    except KeyError:
        print(f"source-library error: unknown source id: {args.source_id}", file=sys.stderr)
        return 1
    _print_rows(rows, args.format, ("document", "source_id", "loci", "role", "states", "path"))
    return 0


def command_fingerprint(args: argparse.Namespace) -> int:
    library = load_library(
        Path(args.root),
        check_binding_fingerprints=False,
    )
    if library.errors:
        _print_errors(library)
        return 1
    try:
        print(source_fingerprint(library, args.source_id))
    except KeyError:
        print(f"source-library error: unknown source id: {args.source_id}", file=sys.stderr)
        return 1
    except SourceLibraryQueryError as error:
        print(f"source-library error: {error}", file=sys.stderr)
        return 1
    return 0


def command_impact(args: argparse.Namespace) -> int:
    library = _validated_library(args)
    if library is None:
        return 1
    try:
        rows = impact_rows(library, args.source_id, args.locus)
    except KeyError:
        print(f"source-library error: unknown source id: {args.source_id}", file=sys.stderr)
        return 1
    _print_rows(
        rows,
        args.format,
        ("kind", "id", "type", "source_id", "loci", "states", "path"),
    )
    return 0


def command_search(args: argparse.Namespace) -> int:
    library = _validated_library(args)
    if library is None:
        return 1
    try:
        rows = search_rows(library, args.source_id, args.query, case_sensitive=args.case_sensitive)
    except KeyError:
        print(f"source-library error: unknown source id: {args.source_id}", file=sys.stderr)
        return 1
    except SourceLibraryQueryError as error:
        print(f"source-library error: {error}", file=sys.stderr)
        return 1
    if args.count:
        print(len(rows))
        return 0
    _print_rows(rows, args.format, ("artifact_id", "line", "text", "path"))
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", default=str(ROOT), help=argparse.SUPPRESS)
    examples_live_on_the_verbs(parser, "source-library")
    subparsers = parser.add_subparsers(dest="command", required=True)

    validate = with_examples(
        subparsers.add_parser("validate", help="validate registered source records and bindings"),
        EXAMPLES["validate"],
    )
    validate.set_defaults(function=command_validate)

    fingerprint = with_examples(
        subparsers.add_parser(
            "fingerprint", help="print the canonical review fingerprint for a source"
        ),
        EXAMPLES["fingerprint"],
    )
    fingerprint.add_argument("source_id")
    fingerprint.set_defaults(function=command_fingerprint)

    uses = with_examples(
        subparsers.add_parser("uses", help="list publications bound to a source or its descendants"),
        EXAMPLES["uses"],
    )
    uses.add_argument("source_id")
    uses.add_argument("--locus")
    uses.add_argument("--format", choices=("tsv", "json"), default="tsv")
    uses.set_defaults(function=command_uses)

    impact = with_examples(
        subparsers.add_parser("impact", help="list source records and publications affected by a source"),
        EXAMPLES["impact"],
    )
    impact.add_argument("source_id")
    impact.add_argument("--locus")
    impact.add_argument("--format", choices=("tsv", "json"), default="tsv")
    impact.set_defaults(function=command_impact)

    search = with_examples(
        subparsers.add_parser(
            "search",
            help="search physical lines in registered tracked UTF-8 artifacts",
        ),
        EXAMPLES["search"],
    )
    search.add_argument("source_id")
    search.add_argument("query")
    search.add_argument("--case-sensitive", action="store_true")
    search.add_argument("--count", action="store_true", help="print only the matching-line count")
    search.add_argument("--format", choices=("tsv", "json"), default="tsv")
    search.set_defaults(function=command_search)
    return parser


def main(argv: Sequence[str] | None = None) -> int:
    args = build_parser().parse_args(argv)
    return int(args.function(args))


if __name__ == "__main__":
    raise SystemExit(main())
