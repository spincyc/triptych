#!/usr/bin/env python3
"""Encode and validate scripture citations in the calendar mass indexes.

Usage: citations {parse,encode,check} [--root DIR]

A citation's machine encoding is primary. Each element of a proper's `verses`
list is a passage:

    - book: Psalms
      ranges:
        - begin: {chapter: 24, verse: 1}
          end: {chapter: 24, verse: 3}
      ref: "Psalm 24:1-3"

`book` is the canonical Catholic-canon name. `ranges` holds one or more
contiguous extents; a range may cross a chapter boundary, and a range with no
verse denotes a whole chapter. `part` records a printed part-verse letter
(8b, 3ac). `ref` is the edition's own display string, kept as a side field.

Requires PyYAML (requirements-tools.txt).
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from _tooling import print_json, run_verb_cli

