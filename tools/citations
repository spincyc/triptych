# Books of one chapter, cited by verse alone: "Philemon 9-10", not "Philemon 1:9".
SINGLE_CHAPTER = frozenset(
    {"Obadiah", "Philemon", "2 John", "3 John", "Jude"}
)

CANONICAL = {name for name, _ in CANON}
ALIASES = {
    alias.lower().rstrip("."): name
    for name, aliases in CANON
    for alias in (name, *aliases)
}
ORDER = {name: index for index, (name, _) in enumerate(CANON)}

BOOK_RE = re.compile(r"^((?:[1-4]\s+)?[A-Za-z][A-Za-z' ]*?)\s+(\d.*)$")
POINT_RE = re.compile(r"^(?:(\d+):)?(\d+)([a-z]*)$")
CHAPTER_ONLY_RE = re.compile(r"^\d+$")


class CitationError(ValueError):
    """A citation string that cannot be encoded without guessing."""


def canonical_book(name: str) -> str:
    resolved = ALIASES.get(name.strip().lower().rstrip("."))
    if resolved is None:
        raise CitationError(f"unknown book: {name!r}")
    return resolved


def point(chapter: int, verse: int | None, part: str) -> dict[str, object]:
    marker: dict[str, object] = {"chapter": chapter}
    if verse is not None:
        marker["verse"] = verse
    if part:
        marker["part"] = part
    return marker


def parse_endpoint(token: str, chapter: int | None) -> tuple[int, int, str]:
    """Resolve one endpoint against the running chapter context."""
    match = POINT_RE.match(token)
    if not match:
        raise CitationError(f"unreadable locus: {token!r}")
    explicit, verse, part = match.groups()
    if explicit is not None:
        return int(explicit), int(verse), part
    if chapter is None:
        raise CitationError(f"verse {token!r} with no chapter in scope")
    return chapter, int(verse), part


def parse_citation(text: str) -> dict[str, object]:
    """Encode one printed citation string.

    Handles a bare chapter ("Psalm 46"), a verse ("John 3:16"), a range
    ("Psalm 24:1-3"), a cross-chapter range ("John 18:1-19:42"), a selection
    within a chapter ("Psalm 22:8-9, 17-20"), several chapter blocks
    ("Exodus 14:24-31; 15:1"), and printed part-verse letters ("Isaiah 50:4-9a").
    """
    stripped = text.strip()
    if stripped != text:
        raise CitationError(f"citation has stray whitespace: {text!r}")
    match = BOOK_RE.match(stripped)
    if not match:
        raise CitationError(f"no book and locus in {text!r}")
    book = canonical_book(match.group(1))
    locus = match.group(2)
    single = book in SINGLE_CHAPTER
    ranges: list[dict[str, object]] = []
    chapter: int | None = 1 if single else None
    for block in locus.split(";"):
        block = block.strip()
        if not block:
            raise CitationError(f"empty chapter block in {text!r}")
        # A block introduces its own chapter; selections inside it inherit it.
        for selection in block.split(","):
            selection = selection.strip()
            if not selection:
                raise CitationError(f"empty selection in {text!r}")
            if CHAPTER_ONLY_RE.match(selection) and ":" not in block and not single:
                # A whole chapter, cited without verses.
                chapter = int(selection)
                ranges.append(
                    {"begin": point(chapter, None, ""), "end": point(chapter, None, "")}
                )
                continue
            halves = selection.split("-")
            if len(halves) > 2:
                raise CitationError(f"more than one dash in {selection!r}")
            start_chapter, start_verse, start_part = parse_endpoint(halves[0], chapter)
            chapter = start_chapter
            if len(halves) == 1:
                end_chapter, end_verse, end_part = start_chapter, start_verse, start_part
            else:
                end_chapter, end_verse, end_part = parse_endpoint(halves[1], chapter)
                chapter = end_chapter
            if (end_chapter, end_verse) < (start_chapter, start_verse):
                raise CitationError(f"descending range in {selection!r}")
            ranges.append(
                {
                    "begin": point(start_chapter, start_verse, start_part),
                    "end": point(end_chapter, end_verse, end_part),
                }
            )
    if not ranges:
        raise CitationError(f"no ranges in {text!r}")
    return {"book": book, "ranges": ranges, "ref": stripped}


def locus(marker: object) -> tuple[object, object, str]:
    """One endpoint reduced to what a citation actually names.

    A whole-chapter edge carries no verse and no printed part letter, and the
    absent key and an empty one mean the same thing, so both normalize to the
    same tuple. Comparing these rather than the mappings keeps the cross-check
    blind to key order and to a written-out `part: ''`.
    """
    if not isinstance(marker, dict):
        return (None, None, "")
    return (marker.get("chapter"), marker.get("verse"), marker.get("part") or "")


def extents(passage: dict) -> list[tuple[tuple, tuple]]:
    """A passage's ranges as ordered begin/end loci."""
    return [
        (locus(extent.get("begin")), locus(extent.get("end")))
        for extent in passage.get("ranges") or []
        if isinstance(extent, dict)
    ]


def spell(bounds: list[tuple[tuple, tuple]]) -> str:
    """Render loci for a complaint, naming no book.

    The book is stated separately, and leaving it out here also keeps these
    messages clear of the calendar checker's psalm-exception ledger, which
    matches a `Psalm N:V` locus followed by a refusal verb. A ledger is for the
    defect it records, and a disagreement between a reference and its ranges
    must not be able to hide behind one.
    """

    def edge(point: tuple[object, object, str]) -> str:
        chapter, verse, part = point
        return f"{chapter}" if verse is None else f"{chapter}:{verse}{part}"

    return ", ".join(f"{edge(begin)}-{edge(end)}" for begin, end in bounds) or "nothing"


def check_ref_agrees(where: str, passage: dict, problems: list[str]) -> None:
    """Re-derive the passage from its own `ref` and refuse a disagreement.

    The structured form is the source of truth and `ref` is the edition's
    display string, but nothing made the two agree: a page could print one
    reference and fetch another, without limit and without failing anything.

    What is compared is the **parsed structure**, never the strings. `ref` is
    run back through this tool's own `parse_citation` — the one that encoded it
    in the first place, so no second implementation can drift from it — and the
    result is compared field by field:

    - `book`, after alias resolution, so "Psalm" and "Psalms", "Cant" and
      "Canticle of Canticles" agree; an edition may spell a book however it
      prints it.
    - `ranges`, as ordered begin/end loci of chapter, verse and part letter.
      Whitespace, punctuation and the choice of `;` or `,` never reach the
      comparison, because they do not survive parsing.

    The complaint names which field diverged and gives both readings. It never
    says which is right: that is a question about the missal, answerable only
    against the missal, and harmonising a citation to itself would destroy the
    evidence that they disagreed.

    A `ref` this parser cannot read is a third outcome, reported under its own
    wording rather than folded into a disagreement, because nothing was
    derived to disagree with. The tracked calendars carry none today.
    """
    ref = passage.get("ref")
    if not isinstance(ref, str) or not ref.strip():
        return
    try:
        derived = parse_citation(ref)
    except CitationError as error:
        problems.append(
            f"{where}: ref {ref!r} cannot be re-derived, so nothing checks it "
            f"against the ranges beside it: {error}"
        )
        return
    # A book the passage spells wrongly is already reported above; saying it
    # again here would count one defect twice.
    if passage.get("book") in CANONICAL and derived["book"] != passage["book"]:
        problems.append(
            f"{where}: ref {ref!r} names book {derived['book']!r}, "
            f"but the passage stores {passage['book']!r}"
        )
    stored, wanted = extents(passage), extents(derived)
    if stored != wanted:
        problems.append(
            f"{where}: ref {ref!r} derives {spell(wanted)}, "
            f"but the passage stores {spell(stored)}"
        )


def check_passage(
    where: str, passage: object, problems: list[str], numbering: str | None = None
) -> None:
    if isinstance(passage, str):
        problems.append(f"{where}: citation is still a bare string: {passage!r}")
        return
    if not isinstance(passage, dict):
        problems.append(f"{where}: passage is not a mapping")
        return
    book = passage.get("book")
    if book not in CANONICAL:
        problems.append(f"{where}: book is not a canonical name: {book!r}")
    ranges = passage.get("ranges")
    if not isinstance(ranges, list) or not ranges:
        problems.append(f"{where}: ranges must be a nonempty list")
        return
    if book == PSALMS and numbering is not None and numbering not in PSALM_NUMBERING:
        problems.append(
            f"{where}: psalm numbering must be one of {sorted(PSALM_NUMBERING)}, "
            f"got {numbering!r}"
        )
    elif book == PSALMS and numbering:
        for entry in ranges:
            if not isinstance(entry, dict):
                continue
            for edge in ("begin", "end"):
                point = entry.get(edge)
                if not isinstance(point, dict):
                    continue
                trouble = validate_psalm(point.get("chapter"), point.get("verse"), numbering)
                if trouble:
                    problems.append(f"{where}/{edge}: {trouble}")
    structural = len(problems)
    for index, extent in enumerate(ranges):
        scope = f"{where}/range[{index}]"
        if not isinstance(extent, dict):
            problems.append(f"{scope}: range is not a mapping")
            continue
        bounds = []
        for edge in ("begin", "end"):
            marker = extent.get(edge)
            if not isinstance(marker, dict):
                problems.append(f"{scope}: {edge} is not a mapping")
                bounds.append(None)
                continue
            unknown = set(marker) - {"chapter", "verse", "part"}
            if unknown:
                problems.append(f"{scope}/{edge}: unknown keys {sorted(unknown)}")
            chapter = marker.get("chapter")
            if not isinstance(chapter, int) or chapter < 1:
                problems.append(f"{scope}/{edge}: chapter must be a positive integer")
                bounds.append(None)
                continue
            verse = marker.get("verse")
            if verse is not None and (not isinstance(verse, int) or verse < 1):
                problems.append(f"{scope}/{edge}: verse must be a positive integer")
                bounds.append(None)
                continue
            part = marker.get("part")
            if part is not None and (
                not isinstance(part, str) or not part.isalpha() or not part.islower()
            ):
                problems.append(f"{scope}/{edge}: part must be lowercase letters")
            bounds.append((chapter, verse if verse is not None else 0))
        if len(bounds) == 2 and all(bounds) and bounds[1] < bounds[0]:
            problems.append(f"{scope}: end precedes begin")
        begin_verse = extent.get("begin", {}).get("verse") if isinstance(extent.get("begin"), dict) else None
        end_verse = extent.get("end", {}).get("verse") if isinstance(extent.get("end"), dict) else None
        if (begin_verse is None) != (end_verse is None):
            problems.append(f"{scope}: a whole-chapter range needs no verse on either edge")
    ref = passage.get("ref")
    if ref is not None and (not isinstance(ref, str) or not ref.strip()):
        problems.append(f"{where}: ref must be a nonempty string when present")
        return
    # A malformed range has nothing to compare against, and reporting the
    # disagreement it necessarily produces would bury the defect that caused
    # it. The psalm-numbering complaints above are not structural: a locus the
    # calendar's own numbering refuses is still a locus, and its ref is still
    # owed the cross-check.
    if len(problems) == structural:
        check_ref_agrees(where, passage, problems)


def iter_masses(document: dict) -> list:
    """Yield every mass from the calendar's one canonical container.

    `sections` is the single source; the mass list is not duplicated elsewhere,
    and the calendar-mass checker rejects a file that reintroduces one.
    """
    out = []
    for _, body in sorted((document.get("sections") or {}).items()):
        if isinstance(body, dict):
            out.extend(m for m in (body.get("masses") or []) if isinstance(m, dict))
    return out


def each_proper(document: object):
    """Yield (label, proper) for every proper in a loaded index."""
    if not isinstance(document, dict):
        return
    for entry in iter_masses(document):
        key = entry.get("key", "?")
        groups = [(key, entry.get("propers"))]
        for form in entry.get("forms") or []:
            if isinstance(form, dict):
                groups.append((f"{key}/{form.get('name', '?')}", form.get("propers")))
        for label, propers in groups:
            for proper in propers or []:
                if isinstance(proper, dict):
                    yield f"{label}/{proper.get('name', '?')}", proper


# The two reading courses a proper may vary on: Sundays on the three-year
# course lettered A/B/C, the weekdays of Ordinary Time on the two-year course
# numbered I/II. Both are walked, because a citation validated on one course and
# not the other would be a whole year of readings nothing ever read.
CYCLE_KEYS = ("cycles", "weekday_cycles")


def verse_lists(proper: dict) -> list[tuple[str, dict, str]]:
    """Every (label-suffix, owner, key) holding a verses list on one proper."""
    owners = [("", proper, "verses")]
    for cycles in CYCLE_KEYS:
        branches = proper.get(cycles)
        if not isinstance(branches, dict):
            # Shape belongs to check-calendar-masses.  A malformed branch must
            # not crash this delegated content check before that tool can
            # report the actionable schema problem it already found.
            continue
        for cycle, value in branches.items():
            if isinstance(value, dict):
                owners.append((f"/{cycle}", value, "verses"))
    return [(suffix, owner, key) for suffix, owner, key in owners if key in owner]


def numbered_verse_lists(
    proper: dict, default: str | None
) -> list[tuple[str, dict, str, str | None]]:
    """Every verses owner paired with the psalm numbering it inherits.

    The calendar-level declaration is only a default.  A proper may override
    it, and either reading course may override the proper in turn.  This is the
    same inheritance used when the Proper reader resolves a citation;
    validating every owner under the file default made the validator disagree
    with the reader about eleven postconciliar antiphons.
    """
    inherited = proper.get("psalm_numbering") or default
    return [
        (suffix, owner, key, owner.get("psalm_numbering") or inherited)
        for suffix, owner, key in verse_lists(proper)
    ]


def exception_owners(cited: str) -> tuple[str, ...]:
    """Canonical owner paths named by one ledger value.

    The ledger predates the machine path and preserves its readable spelling:
    multiple owners are separated by semicolons, a course is written as
    ``, cycle II``, and an antiphon's incipit may follow in parentheses.  Those
    are presentation only; the resulting paths are the labels emitted by
    :func:`each_proper` and :func:`verse_lists`.
    """
    owners: list[str] = []
    for item in cited.split(";"):
        owner = re.sub(r"\s+\([^()]*(?:\([^()]*\)[^()]*)*\)$", "", item.strip())
        owner = re.sub(r",\s*cycle\s+([^,]+)$", r"/\1", owner, flags=re.IGNORECASE)
        if owner:
            owners.append(owner)
    return tuple(owners)


def psalm_exceptions(
    document: object, problems: list[str]
) -> dict[str, tuple[str, ...]]:
    """Validate and return one calendar's exact-locus exception ledger.

    Bounds are still derived by :func:`check_passage`.  This reader merely
    identifies which of those derived findings the calendar has explicitly
    recorded, one locus at a time; it cannot excuse a whole psalm or an
    unrelated validation error.
    """
    if not isinstance(document, dict):
        return {}
    payload = document.get(EXCEPTIONS)
    if payload is None:
        return {}
    if not isinstance(payload, list) or not payload:
        problems.append(f"{EXCEPTIONS} must be a nonempty list, or absent")
        return {}
    listed: dict[str, tuple[str, ...]] = {}
    for index, entry in enumerate(payload):
        where = f"{EXCEPTIONS}[{index}]"
        if not isinstance(entry, dict):
            problems.append(f"{where}: entry is not a mapping")
            continue
        psalm = entry.get("psalm")
        if not isinstance(psalm, int):
            problems.append(f"{where}: psalm must be the cited psalm's number")
            psalm = None
        divergence = entry.get("divergence")
        if not isinstance(divergence, str) or not divergence.strip():
            problems.append(f"{where}: divergence must say how the systems differ here")
        loci = entry.get("loci")
        if not isinstance(loci, dict) or not loci:
            problems.append(f"{where}: loci must be a nonempty mapping")
            continue
        for locus_name, cited in loci.items():
            found = PSALM_LOCUS.fullmatch(locus_name) if isinstance(locus_name, str) else None
            if found is None:
                problems.append(
                    f"{where}: {locus_name!r} is not a Psalm chapter:verse locus"
                )
                continue
            if psalm is not None and int(found.group(1)) != psalm:
                problems.append(f"{where}: {locus_name} does not belong to Psalm {psalm}")
                continue
            if not isinstance(cited, str) or not cited.strip():
                problems.append(f"{where}: {locus_name} must name the proper that cites it")
                continue
            owners = exception_owners(cited)
            if not owners:
                problems.append(f"{where}: {locus_name} must name at least one proper")
                continue
            if locus_name in listed:
                problems.append(f"{EXCEPTIONS} lists {locus_name} twice")
            listed[locus_name] = owners
    return listed


def apply_psalm_exceptions(
    problems: list[str], listed: dict[str, tuple[str, ...]]
) -> tuple[list[str], list[str]]:
    """Partition exact exceptions and reject ledger claims that went stale.

    Owner is as load-bearing as locus.  A ledger value may name more than one
    owning Proper, so each named owner must still produce the exact breach it
    claims.  Otherwise a corrected owner would leave behind a standing
    permission hidden behind another Proper that still cites the same locus.
    """
    kept: list[str] = []
    excepted: list[str] = []
    met: set[tuple[str, str]] = set()
    for problem in problems:
        found = PSALM_TROUBLE.search(problem)
        if (
            found is not None
            and found.group("owner") in listed.get(found.group("locus"), ())
        ):
            excepted.append(problem)
            met.add((found.group("locus"), found.group("owner")))
        else:
            kept.append(problem)
    for locus, owners in listed.items():
        for owner in owners:
            if (locus, owner) not in met:
                kept.append(
                    f"{EXCEPTIONS} lists {locus} for {owner}, which no longer "
                    "breaches this calendar's numbering; update or delete the entry"
                )
    return kept, excepted


def indexes(root: Path) -> list[Path]:
    """Only the mass indexes, chosen by their declared schema.

    A calendar directory may hold a source another tool owns. Selecting by
    extension read those as mass indexes and complained that they had no
    citations; the shared partition rejects a file no tool claims instead.
    """
    paths, _, problems = partition(root)
    if problems:
        raise ValueError("; ".join(problems))
    if not paths:
        raise ValueError(f"no calendar index found under {root}")
    return paths


MARKER_KEYS = frozenset({"chapter", "verse", "part"})


class Inline(dict):
    """A mapping written on one line, so a verse marker stays readable."""


def represent_text(dumper, data):
    style = "|" if "\n" in data else None
    return dumper.represent_scalar("tag:yaml.org,2002:str", data, style=style)


def inline_markers(value: object) -> object:
    """Wrap chapter/verse markers so they dump as {chapter: 24, verse: 1}."""
    if isinstance(value, dict):
        if value and set(value) <= MARKER_KEYS:
            return Inline(
                (key, value[key]) for key in ("chapter", "verse", "part") if key in value
            )
        return {key: inline_markers(item) for key, item in value.items()}
    if isinstance(value, list):
        return [inline_markers(item) for item in value]
    return value


def dump(document: object, path: Path) -> None:
    import yaml

    class Dumper(yaml.SafeDumper):
        def ignore_aliases(self, data):  # every passage is written out in full
            return True

    Dumper.add_representer(str, represent_text)
    Dumper.add_representer(
        Inline,
        lambda dumper, data: dumper.represent_mapping(
            "tag:yaml.org,2002:map", data, flow_style=True
        ),
    )
    text = yaml.dump(
        inline_markers(document),
        Dumper=Dumper,
        sort_keys=False,
        default_flow_style=False,
        allow_unicode=True,
        width=88,
    )
    path.write_text(text, encoding="utf-8")


def encode(root: Path) -> dict[str, object]:
    import yaml

    files: dict[str, object] = {}
    problems: list[str] = []
    for path in indexes(root):
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
        encoded = 0
        already = 0
        for label, proper in each_proper(document):
            for suffix, owner, key in verse_lists(proper):
                passages = []
                for citation in owner[key]:
                    if isinstance(citation, dict):
                        already += 1
                        passages.append(citation)
                        continue
                    try:
                        passages.append(parse_citation(citation))
                        encoded += 1
                    except CitationError as error:
                        problems.append(f"{path}: {label}{suffix}: {error}")
                        passages.append(citation)
                owner[key] = passages
        if not problems:
            dump(document, path)
        files[path.as_posix()] = {"encoded": encoded, "already_encoded": already}
    return {
        "files": files,
        "problems": problems,
        "status": "error" if problems else "ok",
    }


def check(root: Path) -> dict[str, object]:
    import yaml

    files: dict[str, object] = {}
    problems: list[str] = []
    excepted: list[str] = []
    for path in indexes(root):
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
        passages = 0
        file_problems: list[str] = []
        books: set[str] = set()
        numbering = document.get("psalm_numbering") if isinstance(document, dict) else None
        listed = psalm_exceptions(document, file_problems)
        for label, proper in each_proper(document):
            for suffix, owner, key, effective in numbered_verse_lists(proper, numbering):
                for passage in owner[key]:
                    check_passage(f"{label}{suffix}", passage, file_problems, effective)
                    passages += 1
                    if isinstance(passage, dict) and passage.get("book") in CANONICAL:
                        books.add(passage["book"])
        file_problems, file_excepted = apply_psalm_exceptions(file_problems, listed)
        files[path.as_posix()] = {"passages": passages, "books": len(books)}
        problems.extend(f"{path}: {problem}" for problem in file_problems)
        excepted.extend(f"{path}: {problem}" for problem in file_excepted)
    return {
        "excepted": excepted,
        "files": files,
        "problems": problems,
        "status": "error" if problems else "ok",
    }


def emit(payload: dict[str, object], as_json: bool) -> int:
    problems = payload.get("problems") or []
    if as_json:
        print_json(payload)
        return 1 if problems else 0
    for problem in payload.get("excepted") or []:
        print(f"citation excepted: {problem}", file=sys.stderr)
    for problem in problems:
        print(f"citation error: {problem}", file=sys.stderr)
    for path, counts in (payload.get("files") or {}).items():
        detail = "\t".join(f"{value} {name}" for name, value in sorted(counts.items()))
        print(f"{path}\t{detail}")
    return 1 if problems else 0


def main(argv: list[str] | None = None) -> int:
    json_flags = argparse.ArgumentParser(add_help=False)
    json_flags.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )
    parser = argparse.ArgumentParser(
        prog="citations",
        description="Encode and validate scripture citations in the calendar mass indexes.",
        parents=[json_flags],
    )
    examples_live_on_the_verbs(parser, "citations")
    sub = parser.add_subparsers(dest="command", required=True)
    parse_command = with_examples(
        sub.add_parser(
            "parse",
            help="encode one citation string",
            parents=[json_flags],
        ),
        EXAMPLES["parse"],
    )
    parse_command.add_argument("citation")
    for name, help_text in (
        ("encode", "rewrite bare citation strings as passages, in place"),
        ("check", "validate every encoded passage"),
    ):
        action = with_examples(
            sub.add_parser(name, help=help_text, parents=[json_flags]),
            EXAMPLES[name],
        )
        action.add_argument("--root", type=Path, default=DEFAULT_ROOT)

    def dispatch(arguments: argparse.Namespace):
        if arguments.command == "parse":
            return {"passage": parse_citation(arguments.citation), "status": "ok"}
        if arguments.command == "encode":
            return encode(arguments.root)
        return check(arguments.root)

    def render(payload: object, arguments: argparse.Namespace) -> int:
        if arguments.command == "parse":
            passage = payload["passage"] if isinstance(payload, dict) else None
            if arguments.json:
                print_json(payload if isinstance(payload, dict) else {})
                return 0
            if not isinstance(passage, dict):
                print("invalid parse payload", file=sys.stderr)
                return 70
            print(f"book\t{passage['book']}")
            for extent in passage["ranges"]:
                print(f"range\t{extent['begin']}\t{extent['end']}")
            print(f"ref\t{passage['ref']}")
            return 0
        return emit(payload, arguments.json)

    return run_verb_cli(
        parser=parser,
        handlers={"parse": dispatch, "encode": dispatch, "check": dispatch},
        renderer=render,
        prefix="citations",
        argv=argv,
        dependency_message="install requirements-tools.txt",
        mapped_errors={CitationError: ("citation", 65)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
