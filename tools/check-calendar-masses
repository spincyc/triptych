def field_names(values: set[object]) -> list[str]:
    """Deterministic printable names for even malformed mapping keys."""

    return sorted((str(value) for value in values))


def check_reference(
    where: str, reference: object, problems: list[str], *, on_proper: bool
) -> None:
    """Shape only; `resolve_propers` owns whether the reference actually lands."""
    if not isinstance(reference, dict):
        problems.append(f"{where}: {TAKES_FROM} must be a mapping")
        return
    unknown = field_names(set(reference) - set(REFERENCE_FIELDS))
    if unknown:
        problems.append(
            f"{where}: {TAKES_FROM} carries unknown field(s) {', '.join(unknown)}; "
            f"it takes {', '.join(REFERENCE_FIELDS)}"
        )
    target = reference.get("mass")
    if not isinstance(target, str) or not target:
        problems.append(f"{where}: {TAKES_FROM} needs the key of the mass it takes from")
    if not on_proper and "proper" in reference:
        problems.append(
            f"{where}: {TAKES_FROM} on a mass takes the whole formulary; name a "
            "single proper on the proper that takes it"
        )
    if COMMON_SETS in reference:
        check_common_set_selection(
            f"{where}: {TAKES_FROM}.{COMMON_SETS}",
            reference[COMMON_SETS],
            problems,
        )
        if on_proper:
            problems.append(
                f"{where}: {TAKES_FROM}.{COMMON_SETS} selects a whole Common "
                "formulary and is forbidden on a single-proper reference"
            )


def check_common_set_selection(
    where: str, value: object, problems: list[str]
) -> None:
    """Validate the closed selected/unresolved union on a Common reference."""

    if not isinstance(value, dict) or not value:
        problems.append(f"{where} must be a nonempty mapping")
        return
    for group_id, disposition in value.items():
        group_where = f"{where}.{group_id}"
        if not isinstance(group_id, str) or not FORM_ID_RE.fullmatch(group_id):
            problems.append(f"{where} group ids must be lowercase kebab-case")
        if not isinstance(disposition, dict):
            problems.append(f"{group_where} must be a mapping")
            continue
        unknown = field_names(set(disposition) - COMMON_SET_SELECTION_FIELDS)
        if unknown:
            problems.append(
                f"{group_where} carries unknown field(s) {', '.join(unknown)}"
            )
        state = disposition.get("state")
        if state not in COMMON_SET_SELECTION_STATES:
            problems.append(
                f"{group_where}.state must be one of "
                f"{sorted(COMMON_SET_SELECTION_STATES)}, got {state!r}"
            )
            continue
        if state == "selected":
            option = disposition.get("option")
            if not isinstance(option, str) or not FORM_ID_RE.fullmatch(option):
                problems.append(
                    f"{group_where}.option must be a lowercase kebab-case string"
                )
            if "candidates" in disposition:
                problems.append(
                    f"{group_where} selected state must omit candidates"
                )
        else:
            candidates = disposition.get("candidates")
            if (
                not isinstance(candidates, list)
                or len(candidates) < 2
                or any(
                    not isinstance(candidate, str)
                    or not FORM_ID_RE.fullmatch(candidate)
                    for candidate in candidates
                )
            ):
                problems.append(
                    f"{group_where}.candidates must contain at least two "
                    "lowercase kebab-case option ids"
                )
            elif len(set(candidates)) != len(candidates):
                problems.append(f"{group_where}.candidates must not repeat")
            if "option" in disposition:
                problems.append(f"{group_where} unresolved state must omit option")


def check_common_set_definitions(
    where: str,
    value: object,
    propers: object,
    problems: list[str],
) -> None:
    """Validate the exact Proper members printed as Common alternatives."""

    if not isinstance(value, dict) or not value:
        problems.append(f"{where}: {COMMON_SETS} must be a nonempty mapping")
        return
    proper_names = (
        [
            str(proper.get("name") or "")
            for proper in propers
            if isinstance(proper, dict)
        ]
        if isinstance(propers, list)
        else []
    )
    all_families: set[str] = set()
    all_members: set[str] = set()
    for group_id, group in value.items():
        group_where = f"{where}: {COMMON_SETS}.{group_id}"
        if not isinstance(group_id, str) or not FORM_ID_RE.fullmatch(group_id):
            problems.append(
                f"{where}: {COMMON_SETS} group ids must be lowercase kebab-case"
            )
        if not isinstance(group, dict):
            problems.append(f"{group_where} must be a mapping")
            continue
        unknown = field_names(set(group) - COMMON_SET_GROUP_FIELDS)
        if unknown:
            problems.append(
                f"{group_where} carries unknown field(s) {', '.join(unknown)}"
            )
        families = group.get("families")
        if (
            not isinstance(families, list)
            or not families
            or any(not isinstance(family, str) or not family for family in families)
        ):
            problems.append(f"{group_where}.families must be nonempty strings")
            families = []
        elif len(set(families)) != len(families):
            problems.append(f"{group_where}.families must not repeat")
        overlap = sorted(set(families) & all_families)
        if overlap:
            problems.append(
                f"{group_where}.families overlap another group: "
                + ", ".join(overlap)
            )
        all_families.update(families)
        options = group.get("options")
        if not isinstance(options, dict) or not options:
            problems.append(f"{group_where}.options must be a nonempty mapping")
            continue
        group_members: set[str] = set()
        for option_id, members in options.items():
            option_where = f"{group_where}.options.{option_id}"
            if not isinstance(option_id, str) or not FORM_ID_RE.fullmatch(option_id):
                problems.append(
                    f"{group_where} option ids must be lowercase kebab-case"
                )
            if (
                not isinstance(members, list)
                or len(members) != len(families)
                or any(not isinstance(member, str) or not member for member in members)
            ):
                problems.append(
                    f"{option_where} must name exactly one member of each family"
                )
                continue
            if len(set(members)) != len(members):
                problems.append(f"{option_where} members must not repeat")
            missing = [member for member in members if member not in proper_names]
            if missing:
                problems.append(
                    f"{option_where} names unknown proper(s) "
                    + ", ".join(repr(member) for member in missing)
                )
            member_families = [proper_family(member) for member in members]
            if set(member_families) != set(families) or len(member_families) != len(
                set(member_families)
            ):
                problems.append(
                    f"{option_where} must name exactly one member of each declared family"
                )
            group_members.update(members)
        overlap = sorted(group_members & all_members)
        if overlap:
            problems.append(
                f"{group_where} members overlap another group: "
                + ", ".join(repr(member) for member in overlap)
            )
        all_members.update(group_members)
        ungrouped = [
            name
            for name in proper_names
            if proper_family(name) in set(families) and name not in group_members
        ]
        if ungrouped:
            problems.append(
                f"{group_where} leaves declared-family proper(s) outside every option: "
                + ", ".join(repr(member) for member in ungrouped)
            )


def check_registered_source(where: str, source_id: object, problems: list[str]) -> None:
    """A structural claim names a source-library record, never a prose label."""
    if not isinstance(source_id, str) or not source_id.strip():
        problems.append(f"{where}: source_id must be a nonempty string")
        return
    registered = source_ids()[0]
    if registered is not None and source_id not in registered:
        problems.append(
            f"{where}: source_id {source_id!r} is registered nowhere in the "
            "source library"
        )


def check_common_from(where: str, value: object, problems: list[str]) -> None:
    """Validate a non-resolving, witnessed direction to one or more Commons."""
    if not isinstance(value, dict):
        problems.append(f"{where}: {COMMON_FROM} must be a mapping")
        return
    unknown = field_names(set(value) - COMMON_FROM_FIELDS)
    if unknown:
        problems.append(
            f"{where}: {COMMON_FROM} carries unknown field(s) {', '.join(unknown)}; "
            f"it takes {', '.join(sorted(COMMON_FROM_FIELDS))}"
        )
    scope = value.get("scope")
    if scope not in COMMON_FROM_SCOPES:
        problems.append(
            f"{where}: {COMMON_FROM}.scope must be one of "
            f"{sorted(COMMON_FROM_SCOPES)}, got {scope!r}"
        )
    check_registered_source(
        f"{where}: {COMMON_FROM}", value.get("source_id"), problems
    )
    locus = value.get("locus")
    if not isinstance(locus, str) or not locus.strip():
        problems.append(f"{where}: {COMMON_FROM}.locus must be a nonempty string")
    options = value.get("options")
    if not isinstance(options, list) or not options:
        problems.append(f"{where}: {COMMON_FROM}.options must be a nonempty list")
        return
    seen: set[tuple[str, str]] = set()
    for index, option in enumerate(options):
        label = f"{where}: {COMMON_FROM}.options[{index}]"
        if not isinstance(option, dict):
            problems.append(f"{label} must be a mapping")
            continue
        strange = field_names(set(option) - COMMON_FROM_OPTION_FIELDS)
        if strange:
            problems.append(
                f"{label} carries unknown field(s) {', '.join(strange)}; it takes "
                f"{', '.join(sorted(COMMON_FROM_OPTION_FIELDS))}"
            )
        mass = option.get("mass")
        if not isinstance(mass, str) or not mass.strip():
            problems.append(f"{label}.mass must be a nonempty Common mass key")
            continue
        selection = option.get("selection", "")
        if "selection" in option and (
            not isinstance(selection, str) or not selection.strip()
        ):
            problems.append(f"{label}.selection must be a nonempty string when present")
            continue
        identity = (mass, str(selection))
        if identity in seen:
            problems.append(f"{label} duplicates Common option {identity!r}")
        seen.add(identity)


def check_text_status(
    where: str,
    value: object,
    problems: list[str],
    *,
    allowed_states: frozenset[str] = TEXT_STATUS_STATES,
    allowed_scopes: frozenset[str] = MASS_TEXT_STATUS_SCOPES,
) -> None:
    """Validate text absence separately from a structural appointment."""
    if not isinstance(value, dict):
        problems.append(f"{where}: {TEXT_STATUS} must be a mapping")
        return
    unknown = field_names(set(value) - TEXT_STATUS_FIELDS)
    if unknown:
        problems.append(
            f"{where}: {TEXT_STATUS} carries unknown field(s) {', '.join(unknown)}; "
            f"it takes {', '.join(sorted(TEXT_STATUS_FIELDS))}"
        )
    state = value.get("state")
    if state not in allowed_states:
        problems.append(
            f"{where}: {TEXT_STATUS}.state must be one of "
            f"{sorted(allowed_states)}, got {state!r}"
        )
    scope = value.get("scope")
    if scope not in allowed_scopes:
        problems.append(
            f"{where}: {TEXT_STATUS}.scope must be one of "
            f"{sorted(allowed_scopes)}, got {scope!r}"
        )
    reasons = value.get("reasons")
    if not isinstance(reasons, list) or not reasons:
        problems.append(f"{where}: {TEXT_STATUS}.reasons must be a nonempty list")
        return
    seen: set[tuple[str, str]] = set()
    for index, reason in enumerate(reasons):
        label = f"{where}: {TEXT_STATUS}.reasons[{index}]"
        if not isinstance(reason, dict):
            problems.append(f"{label} must be a mapping")
            continue
        strange = field_names(set(reason) - TEXT_STATUS_REASON_FIELDS)
        if strange:
            problems.append(
                f"{label} carries unknown field(s) {', '.join(strange)}; it takes "
                f"{', '.join(sorted(TEXT_STATUS_REASON_FIELDS))}"
            )
        kind = reason.get("kind")
        if kind not in TEXT_STATUS_REASON_KINDS:
            problems.append(
                f"{label}.kind must be one of {sorted(TEXT_STATUS_REASON_KINDS)}, "
                f"got {kind!r}"
            )
        source_id = reason.get("source_id")
        if kind == "no-exemplar":
            if source_id is not None:
                problems.append(
                    f"{label}: no-exemplar names an unreachable exact copy, so "
                    "it must omit source_id"
                )
        else:
            check_registered_source(label, source_id, problems)
        identity = (str(kind), str(source_id))
        if identity in seen:
            problems.append(f"{label} duplicates text-status reason {identity!r}")
        seen.add(identity)


def check_ordinary_frame(where: str, value: object, problems: list[str]) -> None:
    """Validate an exceptional rite's applicability to the normal Ordinary."""
    if not isinstance(value, dict):
        problems.append(f"{where}: {ORDINARY_FRAME} must be a mapping")
        return
    unknown = field_names(set(value) - ORDINARY_FRAME_FIELDS)
    missing = sorted(ORDINARY_FRAME_FIELDS - set(value))
    if unknown:
        problems.append(
            f"{where}: {ORDINARY_FRAME} carries unknown field(s) "
            f"{', '.join(unknown)}"
        )
    if missing:
        problems.append(
            f"{where}: {ORDINARY_FRAME} is missing field(s) {', '.join(missing)}"
        )
    applicability = value.get("applicability")
    if applicability not in ORDINARY_FRAME_APPLICABILITY:
        problems.append(
            f"{where}: {ORDINARY_FRAME}.applicability must be one of "
            f"{sorted(ORDINARY_FRAME_APPLICABILITY)}, got {applicability!r}"
        )
    basis = value.get("basis")
    if not isinstance(basis, str) or not basis.strip():
        problems.append(f"{where}: {ORDINARY_FRAME}.basis must be a nonempty string")


def check_cycle_mapping(
    where: str,
    key: str,
    cycles: object,
    allowed: tuple[str, ...],
    source: object,
    problems: list[str],
) -> None:
    """One cycle-keyed mapping of readings, whichever course it belongs to.

    The Sunday course and the weekday course differ in which keys they admit and
    in nothing else, so the walk is written once. A second copy of it would be
    free to drift from the first, which is how one of these files comes to hold
    two rules for one shape.

    A cycle-varying proper may differ in kind between cycles -- an acclamation
    composed in one year and scriptural in another -- so each cycle may carry
    its own source instead of one at the top.
    """
    noun = "cycle" if key == CYCLES_KEY else "weekday cycle"
    if not isinstance(cycles, dict) or not cycles:
        problems.append(f"{where}: {key} must be a nonempty mapping")
        return
    for cycle, value in cycles.items():
        if cycle not in allowed:
            problems.append(
                f"{where}: unknown {noun} key {cycle!r}; {key} is keyed "
                f"{', '.join(repr(one) for one in allowed)}"
            )
            continue
        if not isinstance(value, dict):
            problems.append(f"{where}/{cycle}: {noun} must be a mapping")
            continue
        unknown = field_names(set(value) - CYCLE_OWNER_FIELDS)
        if unknown:
            problems.append(
                f"{where}/{cycle}: {noun} carries unknown field(s) "
                f"{', '.join(repr(field) for field in unknown)}"
            )
        for field in ("incipit", "notes", "text"):
            if field in value and (
                not isinstance(value[field], str) or not value[field].strip()
            ):
                problems.append(
                    f"{where}/{cycle}: {field} must be a nonempty string"
                )
        effective = value.get("source", source)
        if effective not in SOURCES:
            problems.append(f"{where}/{cycle}: no source, and the proper declares none")
            continue
        branch_where = f"{where}/{cycle}"
        has_body_status = TEXT_STATUS in value
        if has_body_status:
            check_text_status(
                branch_where,
                value[TEXT_STATUS],
                problems,
                allowed_states=UNAVAILABLE_TEXT_STATUS_STATES,
                allowed_scopes=PROPER_TEXT_STATUS_SCOPES,
            )
            # A text-free Proper may be either a quarantined former body or a
            # source-established slot whose wording was never held.  The
            # typed reason keeps those states distinct: ``rights-withheld`` is
            # joined to the Latin quarantine ledger, while ``witness-gap`` and
            # ``no-exemplar`` remain body-less source gaps.
            if "text" in value:
                problems.append(
                    f"{branch_where}: a proper-body {TEXT_STATUS} records "
                    "unavailable wording and must not coexist with text"
                )
        numbering = value.get("psalm_numbering")
        if "psalm_numbering" in value and numbering not in PSALM_NUMBERING:
            problems.append(
                f"{branch_where}: psalm_numbering must be one of "
                f"{sorted(PSALM_NUMBERING)}, got {numbering!r}"
            )
        if effective == "scripture":
            if "verses" not in value:
                problems.append(f"{branch_where}: scripture {noun} has no verses")
            if "text" in value:
                problems.append(f"{branch_where}: scripture {noun} must not carry text")
            if has_body_status:
                problems.append(
                    f"{branch_where}: scripture {noun} cannot carry a composed "
                    f"proper-body {TEXT_STATUS}"
                )
        elif effective == "composed":
            if "text" not in value and not has_body_status:
                problems.append(f"{branch_where}: composed {noun} has no text")
            if "verses" in value:
                problems.append(f"{branch_where}: composed {noun} must not carry verses")
        elif not ("verses" in value and ("text" in value or has_body_status)):
            problems.append(f"{branch_where}: mixed {noun} needs verses and text")
        check_verses(branch_where, value.get("verses"), problems)
        check_translations(branch_where, value, problems)


def weekday_cycle_placement(where: str, calendar: str, season: object) -> list[str]:
    """Refuse a two-year ferial course anywhere it cannot be kept.

    Two refusals, both of them the same rule read from two directions: only the
    reformed Lectionary has a weekday course at all, and within it the course
    runs on the ferias of Ordinary Time, the one kind of day the Missal prints
    no formulary for. A mass placed by date, or in a Common, has no season and
    is refused with the rest -- the numeral would be standing on a day the
    course does not reach.
    """
    problems = []
    if calendar != WEEKDAY_CYCLES_CALENDAR:
        problems.append(
            f"{where}: {WEEKDAY_CYCLES_KEY} is the reformed Lectionary's two-year "
            f"ferial course, and calendar {calendar!r} does not keep one. A cycle "
            "numeral does not travel between calendars."
        )
    if season != WEEKDAY_CYCLES_SEASON:
        problems.append(
            f"{where}: {WEEKDAY_CYCLES_KEY} belongs to the ferial course of "
            f"{WEEKDAY_CYCLES_SEASON!r}, and this mass's season is {season!r}. "
            "A weekday-cycle numeral outside that course is a category error, "
            "not a fact."
        )
    return problems


def check_proper(
    where: str,
    proper: object,
    problems: list[str],
    *,
    calendar: str = "",
    season: object = None,
) -> None:
    if not isinstance(proper, dict):
        problems.append(f"{where}: proper is not a mapping")
        return
    name = proper.get("name")
    if not isinstance(name, str) or not name.strip():
        problems.append(f"{where}: proper has no name")
        return
    where = f"{where}/{name}"
    if name == "Placeholder":
        problems.append(
            f"{where}: Placeholder is not a source-owned Proper slot; replace the "
            "placeholder-only formulary with a typed mass-level text_status that "
            "records why its text is unavailable"
        )
        return
    unknown = field_names(set(proper) - PROPER_FIELDS)
    if unknown:
        problems.append(
            f"{where}: unrecognised field(s) {', '.join(repr(k) for k in unknown)}; "
            "an unquoted scalar carrying a colon becomes a key of its own"
        )
    if ORDINARY_DISPOSITION in proper:
        try:
            validate_ordinary_disposition(proper[ORDINARY_DISPOSITION])
        except ValueError as error:
            problems.append(f"{where}: {error}")
    for field in ("incipit", "notes", "text"):
        if field in proper and (
            not isinstance(proper[field], str) or not proper[field].strip()
        ):
            problems.append(f"{where}: {field} must be a nonempty string")
    has_body_status = TEXT_STATUS in proper
    numbering = proper.get("psalm_numbering")
    if "psalm_numbering" in proper and numbering not in PSALM_NUMBERING:
        problems.append(
            f"{where}: psalm_numbering must be one of {sorted(PSALM_NUMBERING)}, "
            f"got {numbering!r}"
        )
    if has_body_status:
        check_text_status(
            where,
            proper[TEXT_STATUS],
            problems,
            allowed_states=UNAVAILABLE_TEXT_STATUS_STATES,
            allowed_scopes=PROPER_TEXT_STATUS_SCOPES,
        )
        if "text" in proper:
            problems.append(
                f"{where}: a proper-body {TEXT_STATUS} records unavailable wording "
                "and must not coexist with text"
            )
        if any(field in proper for field in (TAKES_FROM, CYCLES_KEY, WEEKDAY_CYCLES_KEY)):
            problems.append(
                f"{where}: a proper-body {TEXT_STATUS} belongs only to a direct, "
                "non-cyclic proper"
            )
    if TAKES_FROM in proper:
        # A proper that names where its text is printed holds none of its own.
        # Its incipit and translations come from the resolved proper too, so a
        # second copy of either here is the restatement the key exists to stop.
        carried = [field for field in PROPER_REFERENCE_EXCLUDES if field in proper]
        if carried:
            problems.append(
                f"{where}: a proper taking its text from elsewhere must not also "
                f"carry {', '.join(carried)}"
            )
        check_reference(where, proper[TAKES_FROM], problems, on_proper=True)
        return
    source = proper.get("source")
    # One proper reads on one course. Carrying both keys would say that a slot
    # varies by the Sunday year AND by the weekday year, which no day of either
    # Missal does, and nothing downstream could say which of the two the reader
    # is owed -- so it is refused here rather than resolved by preference.
    keyed = [key for key in (CYCLES_KEY, WEEKDAY_CYCLES_KEY) if key in proper]
    if len(keyed) > 1:
        problems.append(
            f"{where}: carries both {CYCLES_KEY} and {WEEKDAY_CYCLES_KEY}. The "
            "Sunday course is lettered A/B/C and the weekday course numbered "
            "I/II; one proper reads on one of them."
        )
        return
    if keyed:
        key = keyed[0]
        if key == WEEKDAY_CYCLES_KEY:
            problems.extend(weekday_cycle_placement(where, calendar, season))
        if source is not None and source not in SOURCES:
            problems.append(f"{where}: source must be one of {SOURCES}, got {source!r}")
        check_cycle_mapping(
            where,
            key,
            proper[key],
            CYCLES if key == CYCLES_KEY else WEEKDAY_CYCLES,
            source,
            problems,
        )
        if "verses" in proper or "text" in proper:
            problems.append(f"{where}: {key} excludes top-level verses and text")
        if "translations" in proper:
            problems.append(
                f"{where}: {key} translations belong to the exact cycle owner, "
                "not the course-wide proper"
            )
        return
    if source not in SOURCES:
        problems.append(f"{where}: source must be one of {SOURCES}, got {source!r}")
        return
    if source == "scripture":
        if "verses" not in proper:
            problems.append(f"{where}: scripture proper has no verses")
        if "text" in proper:
            problems.append(f"{where}: scripture proper must not carry text")
    elif source == "composed":
        if "text" not in proper and not has_body_status:
            problems.append(f"{where}: composed proper has no text")
        if "verses" in proper:
            problems.append(f"{where}: composed proper must not carry verses")
    elif "verses" not in proper or ("text" not in proper and not has_body_status):
        problems.append(f"{where}: mixed proper needs both verses and text")
    check_verses(where, proper.get("verses"), problems)
    check_translations(where, proper, problems)


def check_translations(where: str, proper: dict, problems: list[str]) -> None:
    """A proper's translations, and the Latin they answer."""
    payload = proper.get("translations")
    if payload is None:
        return
    status = proper.get(TEXT_STATUS)
    removed_body = (
        isinstance(status, dict)
        and status.get("state") == "unavailable"
        and status.get("scope") == "proper-body"
    )
    if "text" not in proper and not removed_body:
        problems.append(f"{where}: translations require a text to translate")
    check_translation_list(where, payload, problems, proper.get("name"))


def check_translation_list(
    where: str,
    payload: object,
    problems: list[str],
    proper_name: object = None,
) -> None:
    """A translation is someone's expression; it carries its own rights basis.

    Liturgical translations are not relicensed by inclusion, so each one names
    the edition it came from and the basis on which it is carried.

    Two English translations of one oration are the feature and not the fault.
    Offering a choice is only worth a control because translations differ, and
    the difference is also the detector: the two independent transcriptions of
    the 1861 Cummiskey missal in this repository disagreed at 45 of the 153
    orations they share, and every one of the 38 errors the site was serving sat
    inside those 45 — where they agreed, they were right 54 times out of 54. So
    what must not repeat is the *witness*, not the language, and uniqueness is
    keyed `(lang, source_id)`.

    A translation carrying no `source_id` is the one case where the language
    still stands alone, because nothing else tells two of them apart. Only a
    `project-created` translation may omit it, so the effect is that the project
    speaks once per language and every quoted witness speaks under its own name.
    """
    if not isinstance(payload, list) or not payload:
        problems.append(f"{where}: translations must be a nonempty list")
        return
    # A library that cannot be read is reported once by `run`, not once per
    # proper: the same defect repeated 1,475 times is a defect nobody reads.
    registered = source_ids()[0]
    seen: set[tuple[str, str | None]] = set()
    for index, entry in enumerate(payload):
        label = f"{where}.translations[{index}]"
        if not isinstance(entry, dict):
            problems.append(f"{label}: must be a mapping")
            continue
        unknown = field_names(set(entry) - TRANSLATION_FIELDS)
        if unknown:
            problems.append(
                f"{label}: unknown field(s) {', '.join(unknown)}; translations "
                f"take {', '.join(sorted(TRANSLATION_FIELDS))}"
            )
        for field in ("lang", "text", "rights"):
            value = entry.get(field)
            if not isinstance(value, str) or not value.strip():
                problems.append(f"{label}: {field} must be a nonempty string")
        rights = entry.get("rights")
        if isinstance(rights, str) and rights not in TRANSLATION_RIGHTS:
            problems.append(
                f"{label}: rights must be one of {sorted(TRANSLATION_RIGHTS)}, got {rights!r}"
            )
        source_id = entry.get("source_id")
        if rights in {"licensed", "public-domain", "permission"} and not source_id:
            problems.append(f"{label}: {rights} translation must name its source_id")
        if rights in RIGHTS_NEEDING_NOTICE and not entry.get("notice"):
            problems.append(
                f"{label}: {rights} translation must carry its required notice; "
                "the grant it publishes under is conditioned on one"
            )
        if "notice" in entry and (
            not isinstance(entry["notice"], str) or not entry["notice"].strip()
        ):
            problems.append(f"{label}: notice must be a nonempty string when present")
        if source_id is not None and not isinstance(source_id, str):
            problems.append(f"{label}: source_id must be a string, got {source_id!r}")
            source_id = None
        # An id that names nothing is worse than no id at all: it reads as
        # provenance and answers no question, and it is now load-bearing, since
        # it is what tells two translations of one prayer apart.
        if isinstance(source_id, str) and registered is not None:
            if source_id not in registered:
                problems.append(
                    f"{label}: source_id {source_id!r} is registered nowhere in "
                    "the source library"
                )
        if (
            proper_name in LECTIONARY_ACCLAMATIONS
            and isinstance(source_id, str)
            and ICEL_ROMAN_MISSAL_MUSIC_SOURCE in source_id
        ):
            problems.append(
                f"{label}: {proper_name} is a Lectionary slot and cannot use "
                "an ICEL Music for the Roman Missal source as its translation "
                "witness; establish the exact Lectionary edition, exemplar, and "
                "publication basis instead"
            )
        lang = entry.get("lang")
        if isinstance(lang, str):
            key = (lang, source_id if isinstance(source_id, str) else None)
            if key in seen:
                problems.append(
                    f"{label}: duplicate translation {lang!r} from "
                    f"{source_id!r}; one witness speaks once per proper"
                    if key[1]
                    else f"{label}: a second {lang!r} translation names no "
                    "source_id, so nothing tells it from the first"
                )
            seen.add(key)


# Resolved once per process and cached, because loading the source graph costs
# well over a second and a calendar makes thousands of translation entries.
_SOURCE_RECORDS: tuple[dict | None, str | None] | None = None


def source_records() -> tuple[dict | None, str | None]:
    """The source-library records, loaded by their owning implementation."""

    global _SOURCE_RECORDS
    if _SOURCE_RECORDS is None:
        try:
            module = sibling("source-library")
            library = module.load_library(
                Path(__file__).resolve().parents[1],
                check_binding_fingerprints=False,
            )
            _SOURCE_RECORDS = (library.records, None)
        except Exception as error:  # the tool is a sibling script, not an API
            _SOURCE_RECORDS = (
                None,
                "cannot read the source library to resolve translation "
                f"sources: {error}",
            )
    return _SOURCE_RECORDS


def source_ids() -> tuple[set[str] | None, str | None]:
    """Every id the source library registers, and why it could not be read.

    Taken from the tool that owns the source graph rather than re-globbed here,
    so that this check and `source-library validate` cannot come to disagree
    about what is registered. Loaded lazily: a calendar carrying no translations
    never pays for it.

    Only the record ids are used, not the library's own verdict. Whether the
    graph is internally sound is `check-sources`' question, and answering it
    twice would report one defect under two names.
    """
    records, trouble = source_records()
    return (set(records) if records is not None else None, trouble)


def untranslated_witness_problems(where: str, row: dict) -> list[str]:
    """Validate an unavailable row's exact, text-free passage witness.

    A body can be known exactly and still unavailable for publication.  The
    artifact/passage pair records that distinction without retaining the
    wording, while the typed reason independently states why it is withheld.
    """

    fields = ("witness_artifact_id", "witness_passage_id")
    if "witness_passage_id" not in row:
        return []
    problems = [
        f"{where}: exact unavailable witness also requires {field}"
        for field in fields
        if field not in row
    ]
    artifact_id = row.get("witness_artifact_id")
    passage_id = row.get("witness_passage_id")
    for field, value in zip(fields, (artifact_id, passage_id)):
        if not isinstance(value, str) or not value.strip():
            problems.append(f"{where}: {field} must be a nonempty source-library id")

    page = row.get("verified_artifact_page")
    if isinstance(page, bool) or not isinstance(page, int) or page < 1:
        problems.append(
            f"{where}: exact unavailable witness requires a positive "
            "verified_artifact_page"
        )
    verified_on = row.get("verified_on_page")
    if not isinstance(verified_on, str) or re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}", verified_on
    ) is None:
        problems.append(
            f"{where}: exact unavailable witness requires dated verified_on_page"
        )

    records, _trouble = source_records()
    if records is None:
        return problems
    artifact = records.get(artifact_id) if isinstance(artifact_id, str) else None
    passage = records.get(passage_id) if isinstance(passage_id, str) else None
    if artifact is None or artifact.record_type != "artifact":
        problems.append(f"{where}: witness_artifact_id does not name an artifact record")
    if passage is None or passage.record_type != "passage":
        problems.append(f"{where}: witness_passage_id does not name a passage record")
    if artifact is None or passage is None:
        return problems
    if passage.data.get("artifact_id") != artifact_id:
        problems.append(
            f"{where}: witness_passage_id is controlled by "
            f"{passage.data.get('artifact_id')!r}, not {artifact_id!r}"
        )
    states = set(passage.data.get("states") or [])
    if not {"inspected", "verified"}.issubset(states):
        problems.append(
            f"{where}: witness_passage_id must be an inspected verified passage"
        )
    if isinstance(page, int) and not isinstance(page, bool):
        ranges = passage.data.get("artifact_page_ranges") or []
        if not any(
            isinstance(bounds, list)
            and len(bounds) == 2
            and all(isinstance(bound, int) for bound in bounds)
            and bounds[0] <= page <= bounds[1]
            for bounds in ranges
        ):
            problems.append(
                f"{where}: verified_artifact_page {page} is outside the passage "
                f"artifact_page_ranges {ranges!r}"
            )
    if verified_on != passage.data.get("verified_on"):
        problems.append(
            f"{where}: verified_on_page {verified_on!r} does not match the "
            f"passage's verified_on {passage.data.get('verified_on')!r}"
        )
    if passage.data.get("artifact_sha256") != artifact.data.get("sha256"):
        problems.append(
            f"{where}: witness passage does not pin the named artifact hash"
        )
    return problems


def overlay_entry_source_problems(
    where: str,
    entry: dict,
    witnesses: dict[str, dict],
) -> list[str]:
    """Validate an exact page-image collation without turning it into rights.

    The entry-level artifact and passage prove what was read and where.  The
    witness row's artifact independently proves why the resulting historical
    translation may be published.  Conflating the two would either claim a
    right over unresolved whole-book bytes or leave an impressive-looking
    passage id that no consumer ever resolves.
    """

    fields = (OVERLAY_ARTIFACT, OVERLAY_PASSAGE, OVERLAY_IA_LEAF_RANGE)
    if not any(field in entry for field in fields):
        if entry.get("collated"):
            return [
                f"{where}: collated page-image claim also requires {field}"
                for field in fields
            ]
        return []
    problems = [
        f"{where}: exact page-image collation also requires {field}"
        for field in fields
        if field not in entry
    ]
    artifact_id = entry.get(OVERLAY_ARTIFACT)
    passage_id = entry.get(OVERLAY_PASSAGE)
    for field, value in (
        (OVERLAY_ARTIFACT, artifact_id),
        (OVERLAY_PASSAGE, passage_id),
    ):
        if not isinstance(value, str) or not value.strip():
            problems.append(f"{where}: {field} must be a nonempty source-library id")

    leaf_range = entry.get(OVERLAY_IA_LEAF_RANGE)
    valid_range = (
        isinstance(leaf_range, list)
        and len(leaf_range) == 2
        and all(
            isinstance(number, int) and not isinstance(number, bool) and number >= 0
            for number in leaf_range
        )
        and leaf_range[0] <= leaf_range[1]
    )
    if not valid_range:
        problems.append(
            f"{where}: {OVERLAY_IA_LEAF_RANGE} must be an ordered inclusive "
            "[first, last] pair of zero-based IA leaves"
        )
    elif entry.get("ia_leaf") != leaf_range[0]:
        problems.append(
            f"{where}: ia_leaf must equal the first leaf in "
            f"{OVERLAY_IA_LEAF_RANGE}; got {entry.get('ia_leaf')!r} and {leaf_range!r}"
        )

    printed = entry.get("printed_page")
    printed_match = (
        re.fullmatch(r"([0-9]+)(?:-([0-9]+))?", printed)
        if isinstance(printed, str)
        else None
    )
    if printed_match is None:
        problems.append(
            f"{where}: a bound page-image collation requires printed_page as "
            "a page or inclusive page range"
        )

    records, trouble = source_records()
    if records is None:
        # The one library-read problem is reported by run(); repeating it for
        # every bound entry would hide the actionable defect in noise.
        return problems
    artifact = records.get(artifact_id) if isinstance(artifact_id, str) else None
    passage = records.get(passage_id) if isinstance(passage_id, str) else None
    if artifact is None or artifact.record_type != "artifact":
        problems.append(f"{where}: {OVERLAY_ARTIFACT} does not name an artifact record")
    if passage is None or passage.record_type != "passage":
        problems.append(f"{where}: {OVERLAY_PASSAGE} does not name a passage record")
    if artifact is not None and passage is not None:
        if passage.data.get("artifact_id") != artifact_id:
            problems.append(
                f"{where}: {OVERLAY_PASSAGE} is controlled by "
                f"{passage.data.get('artifact_id')!r}, not {artifact_id!r}"
            )
        states = passage.data.get("states") or []
        if (
            not {"inspected", "verified"}.issubset(set(states))
            or re.fullmatch(
                r"[0-9]{4}-[0-9]{2}-[0-9]{2}",
                str(passage.data.get("verified_on") or ""),
            )
            is None
        ):
            problems.append(
                f"{where}: {OVERLAY_PASSAGE} must be an inspected and dated "
                "verified passage"
            )
        if valid_range:
            wanted_pages = [[leaf_range[0] + 1, leaf_range[1] + 1]]
            if passage.data.get("artifact_page_ranges") != wanted_pages:
                problems.append(
                    f"{where}: {OVERLAY_IA_LEAF_RANGE} {leaf_range!r} requires "
                    f"passage artifact_page_ranges {wanted_pages!r}; got "
                    f"{passage.data.get('artifact_page_ranges')!r}"
                )
        if passage.data.get("artifact_sha256") != artifact.data.get("sha256"):
            problems.append(
                f"{where}: passage artifact_sha256 does not pin the named artifact"
            )
        if printed_match is not None:
            first = printed_match.group(1)
            last = printed_match.group(2)
            printed_locus = (
                f"printed pp. {first}-{last}" if last else f"printed p. {first}"
            )
            printed_context = " ".join(
                str(passage.data.get(field) or "") for field in ("context", "notes")
            )
            if printed_locus not in printed_context:
                problems.append(
                    f"{where}: passage context does not record {printed_locus!r}"
                )

    witness = str(entry.get("witness") or "")
    witness_row = witnesses.get(witness)
    if witness_row is None:
        problems.append(
            f"{where}: exact collation names witness {witness!r}, which has no "
            "[[sources]] rights row"
        )
        return problems
    if (
        any(field in entry for field in OVERLAY_PUBLICATION_FIELDS)
        and not str(witness_row.get("caution") or "").strip()
    ):
        problems.append(
            f"{where}: publication-bound witness {witness!r} must retain its caution"
        )
    rights_artifact_id = witness_row.get("artifact_id")
    rights_artifact = (
        records.get(rights_artifact_id)
        if isinstance(rights_artifact_id, str)
        else None
    )
    if rights_artifact is None or rights_artifact.record_type != "artifact":
        problems.append(
            f"{where}: witness {witness!r} must name its independent rights artifact"
        )
    elif (
        not any(field in entry for field in OVERLAY_PUBLICATION_FIELDS)
        and witness_row.get("rights") == "public-domain"
        and (
        rights_artifact.data.get("rights_status") != "public-domain"
        or rights_artifact.data.get("storage") != "tracked"
        )
    ):
        problems.append(
            f"{where}: witness {witness!r} claims public-domain publication but "
            "its rights artifact is not a tracked public-domain artifact"
        )
    for index, translation in enumerate(entry.get("translations") or []):
        if not isinstance(translation, dict):
            continue
        if translation.get("source_id") != witness_row.get("source_id"):
            problems.append(
                f"{where}.translations[{index}]: source_id does not match "
                f"witness {witness!r}"
            )
        if translation.get("rights") != witness_row.get("rights"):
            problems.append(
                f"{where}.translations[{index}]: rights does not match witness "
                f"{witness!r}"
            )
    return problems


def overlay_entry_publication_problems(where: str, entry: dict) -> list[str]:
    """Validate the independently publishable body behind an exact collation.

    The page-image artifact proves what was inspected, even when those exact
    scan bytes are remote and unresolved for redistribution.  The publication
    triple points separately at one tracked public-domain transcription and at
    the one-body passage whose text is actually carried.  Requiring both edges
    prevents either an unverifiable transcription or an impressive page proof
    with no lawful publication artifact from standing in for the other.
    """

    translations = entry.get("translations")
    positive_public_domain_antecedent = (
        entry.get("witness_relation") == "antecedent"
        and isinstance(translations, list)
        and any(
            isinstance(translation, dict)
            and translation.get("rights") == "public-domain"
            and isinstance(translation.get("text"), str)
            and bool(translation["text"].strip())
            for translation in translations
        )
    )
    if not any(field in entry for field in OVERLAY_PUBLICATION_FIELDS):
        if positive_public_domain_antecedent:
            return [
                f"{where}: positive public-domain antecedent body requires an "
                "exact publication binding"
            ]
        return []
    problems = [
        f"{where}: publication binding also requires {field}"
        for field in OVERLAY_PUBLICATION_FIELDS
        if field not in entry
    ]
    for field in (OVERLAY_ARTIFACT, OVERLAY_PASSAGE, OVERLAY_IA_LEAF_RANGE):
        if field not in entry:
            problems.append(
                f"{where}: publication binding supplements the exact page proof "
                f"and therefore also requires {field}"
            )

    artifact_id = entry.get(OVERLAY_PUBLICATION_ARTIFACT)
    passage_id = entry.get(OVERLAY_PUBLICATION_PASSAGE)
    recorded_sha256 = entry.get(OVERLAY_PUBLICATION_ARTIFACT_SHA256)
    for field, value in (
        (OVERLAY_PUBLICATION_ARTIFACT, artifact_id),
        (OVERLAY_PUBLICATION_PASSAGE, passage_id),
    ):
        if not isinstance(value, str) or not value.strip():
            problems.append(f"{where}: {field} must be a nonempty source-library id")
    if not isinstance(recorded_sha256, str) or re.fullmatch(
        r"[0-9a-f]{64}", recorded_sha256
    ) is None:
        problems.append(
            f"{where}: {OVERLAY_PUBLICATION_ARTIFACT_SHA256} must be 64 lowercase "
            "hexadecimal characters"
        )

    records, _trouble = source_records()
    if records is None:
        return problems
    artifact = records.get(artifact_id) if isinstance(artifact_id, str) else None
    passage = records.get(passage_id) if isinstance(passage_id, str) else None
    if artifact is None or artifact.record_type != "artifact":
        problems.append(
            f"{where}: {OVERLAY_PUBLICATION_ARTIFACT} does not name an artifact record"
        )
    if passage is None or passage.record_type != "passage":
        problems.append(
            f"{where}: {OVERLAY_PUBLICATION_PASSAGE} does not name a passage record"
        )
    if artifact is None or artifact.record_type != "artifact":
        return problems

    artifact_data = artifact.data
    artifact_sha256 = artifact_data.get("sha256")
    if recorded_sha256 != artifact_sha256:
        problems.append(
            f"{where}: {OVERLAY_PUBLICATION_ARTIFACT_SHA256} does not match the "
            "named publication artifact"
        )
    if artifact_data.get("storage") != "tracked":
        problems.append(f"{where}: publication artifact must be tracked")
    if artifact_data.get("indexable") is not True:
        problems.append(f"{where}: publication artifact must be indexable")
    if artifact_data.get("encoding") != "utf-8":
        problems.append(f"{where}: publication artifact must be UTF-8")
    media_type = str(artifact_data.get("media_type") or "")
    if not (
        media_type.startswith("text/")
        and "charset=utf-8" in media_type.lower()
    ):
        problems.append(
            f"{where}: publication artifact must have a searchable UTF-8 text media type"
        )
    if artifact_data.get("rights_status") != "public-domain":
        problems.append(
            f"{where}: publication artifact must carry public-domain rights_status"
        )
    if artifact_data.get("rights_jurisdiction") != "United States":
        problems.append(
            f"{where}: publication artifact must carry United States rights jurisdiction"
        )

    edition_id = artifact_data.get("edition_id")
    edition = records.get(edition_id) if isinstance(edition_id, str) else None
    edition_date = edition.data.get("date") if edition is not None else None
    if (
        edition is None
        or edition.record_type != "edition"
        or not isinstance(edition_date, str)
        or re.fullmatch(r"[0-9]{4}", edition_date) is None
        or int(edition_date) >= 1931
    ):
        problems.append(
            f"{where}: publication artifact must resolve to a pre-1931 edition; "
            "that publication date is the public-domain basis"
        )

    # The scan proof and the distributable transcription witness the same
    # edition.  A translation silently joined across editions is not a dual
    # binding; it is two unrelated citations.
    for field in (OVERLAY_ARTIFACT, OVERLAY_PASSAGE):
        record_id = entry.get(field)
        record = records.get(record_id) if isinstance(record_id, str) else None
        if record is not None and record.record_type in {"artifact", "passage"}:
            if record.data.get("edition_id") != edition_id:
                problems.append(
                    f"{where}: {field} and the publication artifact must belong "
                    "to the same edition"
                )
    if entry.get(OVERLAY_ARTIFACT) == artifact_id:
        problems.append(
            f"{where}: publication artifact must be independent of the page-image proof"
        )

    if passage is None or passage.record_type != "passage":
        return problems
    passage_data = passage.data
    if passage_data.get("edition_id") != edition_id:
        problems.append(
            f"{where}: publication passage and artifact must belong to the same edition"
        )
    if passage_data.get("artifact_id") != artifact_id:
        problems.append(
            f"{where}: publication passage is not controlled by the named artifact"
        )
    if passage_data.get("artifact_sha256") != recorded_sha256:
        problems.append(
            f"{where}: publication passage does not pin the recorded artifact hash"
        )
    states = passage_data.get("states") or []
    if not {"inspected", "verified"}.issubset(set(states)) or not re.fullmatch(
        r"[0-9]{4}-[0-9]{2}-[0-9]{2}",
        str(passage_data.get("verified_on") or ""),
    ):
        problems.append(
            f"{where}: publication passage must be inspected and dated verified"
        )

    if (
        not isinstance(translations, list)
        or len(translations) != 1
        or not isinstance(translations[0], dict)
    ):
        problems.append(
            f"{where}: a publication passage must bind exactly one translation body"
        )
        return problems
    translation = translations[0]
    if translation.get("lang") != "en":
        problems.append(f"{where}: publication binding must carry one English body")
    if translation.get("rights") != "public-domain":
        problems.append(
            f"{where}: publication binding must carry public-domain translation rights"
        )
    if translation.get("source_id") != edition_id:
        problems.append(
            f"{where}: publication translation source_id must name the artifact's edition"
        )

    ranges = passage_data.get("physical_line_ranges")
    line_number = None
    if (
        isinstance(ranges, list)
        and len(ranges) == 1
        and isinstance(ranges[0], list)
        and len(ranges[0]) == 2
        and all(
            isinstance(value, int) and not isinstance(value, bool)
            for value in ranges[0]
        )
        and ranges[0][0] == ranges[0][1]
        and ranges[0][0] > 1
    ):
        line_number = ranges[0][0]
    else:
        problems.append(
            f"{where}: publication passage must select exactly one TSV data line"
        )

    publication_text = None
    artifact_path = artifact_data.get("path")
    if line_number is not None and isinstance(artifact_path, str):
        payload_path = Path(__file__).resolve().parents[1] / artifact_path
        try:
            payload_bytes = payload_path.read_bytes()
            if hashlib.sha256(payload_bytes).hexdigest() != recorded_sha256:
                problems.append(
                    f"{where}: publication artifact payload does not match its recorded hash"
                )
            lines = payload_bytes.decode("utf-8").splitlines()
            header = next(csv.reader([lines[0]], dialect="excel-tab"))
            row = next(csv.reader([lines[line_number - 1]], dialect="excel-tab"))
            text_columns = [
                field
                for field in ("english", "english_json")
                if header.count(field) == 1
            ]
            if len(row) != len(header) or len(text_columns) != 1:
                raise ValueError(
                    "expected one rectangular TSV row with exactly one of "
                    "english or english_json"
                )
            publication_text = row[header.index(text_columns[0])]
            if text_columns[0] == "english_json":
                publication_text = json.loads(publication_text)
                if not isinstance(publication_text, str):
                    raise ValueError("english_json must decode to a string")
        except (OSError, IndexError, StopIteration, UnicodeError, csv.Error, ValueError) as error:
            problems.append(
                f"{where}: cannot resolve the publication passage's exact TSV row: {error}"
            )
    elif line_number is not None:
        problems.append(f"{where}: publication artifact must name its tracked payload path")

    translation_text = translation.get("text")
    # TOML's multiline delimiter can contribute one terminal LF to a body.
    # Remove exactly that structural byte and no other whitespace; the TSV
    # cell remains the byte-for-byte publication authority.
    if isinstance(translation_text, str) and translation_text.endswith("\n"):
        translation_text = translation_text[:-1]
    if publication_text is not None and translation_text != publication_text:
        problems.append(
            f"{where}: publication TSV English body does not exactly equal the translation"
        )
    return problems


def check_verses(where: str, verses: object, problems: list[str]) -> None:
    """`verses` holds encoded passages; citations owns their contents."""
    if verses is None:
        return
    if not isinstance(verses, list) or not verses:
        problems.append(f"{where}: verses must be a nonempty list")


def check_date(where: str, value: object, problems: list[str]) -> None:
    """A sanctoral date is a quoted MM-DD; February allows the 29th."""
    if not isinstance(value, str):
        problems.append(f"{where}: date must be a quoted MM-DD string, got {value!r}")
        return
    found = DATE_RE.match(value)
    if not found:
        problems.append(f"{where}: date must read MM-DD, got {value!r}")
        return
    month, day = int(found.group(1)), int(found.group(2))
    if not 1 <= month <= 12:
        problems.append(f"{where}: month out of range in {value!r}")
    elif not 1 <= day <= DAYS_IN_MONTH[month - 1]:
        problems.append(f"{where}: day out of range in {value!r}")


def check_name(where: str, name: object, problems: list[str]) -> None:
    """Refuse a name that folds a commemoration into another celebration."""
    if not isinstance(name, str):
        return
    for found in FOLDED_COMMEMORATION.finditer(name):
        if found.start() == 0:
            continue
        problems.append(
            f"{where}: the name folds a commemoration in at "
            f"{name[found.start():]!r}; record it as its own dated entry with "
            "rank 'Comm.' instead"
        )
        return


def normalized_proper_body(text: str) -> str:
    """A composed Proper body reduced only by non-reading presentation.

    This identity is deliberately narrower than the corpus-search Latin fold:
    ``ae/oe``, ``v/u``, ``y/i``, and diacritics can distinguish real readings
    and therefore remain.  NFC joins canonically equivalent Unicode, case and
    Latin ``i/j`` are orthographic presentation here, and whitespace plus
    Unicode punctuation cannot create a second occurrence of the same body.
    """
    folded = unicodedata.normalize("NFC", text).casefold().replace("j", "i")
    return "".join(
        character
        for character in folded
        if not character.isspace()
        and not unicodedata.category(character).startswith("P")
    )


def check_duplicate_proper_bodies(
    where: str, entry: dict, problems: list[str]
) -> None:
    """One mass/form/exact slot cannot mint occurrences from presentation."""
    groups: list[tuple[str, object]] = [(TRANSLATION_MAIN_FORM_ID, entry.get("propers"))]
    forms = entry.get("forms")
    if isinstance(forms, list):
        groups.extend(
            (str(form.get("id") or "<invalid-form>"), form.get("propers"))
            for form in forms
            if isinstance(form, dict)
        )
    for form_id, propers in groups:
        if not isinstance(propers, list):
            continue
        seen: dict[tuple[str, str], int] = {}
        for index, proper in enumerate(propers):
            if not isinstance(proper, dict):
                continue
            name = proper.get("name")
            text = proper.get("text")
            if not isinstance(name, str) or not isinstance(text, str):
                continue
            identity = (name, normalized_proper_body(text))
            if not identity[1]:
                continue
            first = seen.get(identity)
            if first is not None:
                problems.append(
                    f"{where}/{form_id}/{name}: duplicate normalized Proper body "
                    f"at source positions {first + 1} and {index + 1}; one body "
                    "may occur once within the same mass, form, and exact Proper name"
                )
            else:
                seen[identity] = index


def iter_masses(document: dict) -> list[tuple[str, dict]]:
    """Yield every mass from the calendar's one canonical container.

    `sections` is the single source; the mass list is not duplicated elsewhere,
    and `check-calendar-masses` fails a file that reintroduces a top-level one.
    """
    out = []
    sections = document.get("sections")
    if not isinstance(sections, dict):
        return out
    for _, body in sorted(sections.items(), key=lambda item: str(item[0])):
        if isinstance(body, dict):
            kind = str(body.get("kind") or "")
            masses = body.get("masses")
            if not isinstance(masses, list):
                continue
            out.extend(
                (kind, m) for m in masses if isinstance(m, dict)
            )
    return out


def check_entry(
    entry: object,
    index: int,
    problems: list[str],
    section_kind: str = "",
    calendar: str = "",
) -> str | None:
    where = f"mass[{index}]"
    if not isinstance(entry, dict):
        problems.append(f"{where}: entry is not a mapping")
        return None
    unknown = field_names(set(entry) - MASS_FIELDS)
    if unknown:
        problems.append(
            f"{where}: mass carries unknown field(s) {', '.join(unknown)}"
        )
    for field in ENTRY_REQUIRED:
        if field not in entry:
            problems.append(f"{where}: missing {field}")
    key = entry.get("key")
    if isinstance(key, str) and key.strip():
        where = f"mass[{index}] {key}"
        if not FORM_ID_RE.fullmatch(key):
            problems.append(f"{where}: key must be lowercase kebab-case")
    else:
        if "key" in entry:
            problems.append(f"{where}: key must be a nonempty string")
        key = None
    name = entry.get("name")
    if not isinstance(name, str) or not name.strip():
        if "name" in entry:
            problems.append(f"{where}: name must be a nonempty string")
    else:
        check_name(where, name, problems)
    registry = entry.get("registry")
    if registry is not None and (
        not isinstance(registry, str) or not registry.strip()
    ):
        problems.append(
            f"{where}: registry must be a nonempty quoted string, got {registry!r}"
        )
    for field in ("notes", "basis", "departure", "act"):
        if field in entry and (
            not isinstance(entry[field], str) or not entry[field].strip()
        ):
            problems.append(f"{where}: {field} must be a nonempty string")
    if "also" in entry:
        also = entry["also"]
        if not isinstance(also, list) or not also:
            problems.append(f"{where}: also must be a nonempty list of departures")
        else:
            for also_index, value in enumerate(also):
                also_where = f"{where}: also[{also_index}]"
                if not isinstance(value, dict):
                    problems.append(f"{also_where} must be a mapping")
                    continue
                unknown_also = field_names(set(value) - {"departure", "basis", "act"})
                if unknown_also:
                    problems.append(
                        f"{also_where} carries unknown field(s) "
                        f"{', '.join(unknown_also)}"
                    )
                for field in ("departure", "basis"):
                    if not isinstance(value.get(field), str) or not value[field].strip():
                        problems.append(
                            f"{also_where}.{field} must be a nonempty string"
                        )
                if "act" in value and (
                    not isinstance(value["act"], str) or not value["act"].strip()
                ):
                    problems.append(f"{also_where}.act must be a nonempty string")
    # A seasonal entry is placed by season, and a dated entry is sanctoral.
    has_season = "season" in entry
    has_date = "date" in entry
    if section_kind == COMMON_KIND:
        # A Common is a formulary, not a day. It is placed by use.
        if has_season or has_date:
            problems.append(
                f"{where}: a mass of the Commune Sanctorum carries neither a "
                "season nor a date; it is placed by the masses that take it"
            )
    elif has_season == has_date:
        problems.append(f"{where}: exactly one of season or date is required")
    if has_season and (
        not isinstance(entry["season"], str) or not entry["season"].strip()
    ):
        problems.append(f"{where}: season must be a nonempty string")
    if has_date:
        check_date(where, entry["date"], problems)
        kind = entry.get("kind")
        if kind not in KINDS:
            problems.append(f"{where}: kind must be one of {KINDS}, got {kind!r}")
        if not isinstance(entry.get("rank"), str) or not entry["rank"].strip():
            problems.append(f"{where}: a dated entry needs the edition's printed rank")
    has_propers = "propers" in entry
    has_forms = "forms" in entry
    takes_from = TAKES_FROM in entry
    has_common_from = COMMON_FROM in entry
    has_common_sets = COMMON_SETS in entry
    has_text_status = TEXT_STATUS in entry
    has_ordinary_frame = ORDINARY_FRAME in entry
    if has_common_from:
        check_common_from(where, entry[COMMON_FROM], problems)
    if has_common_sets:
        check_common_set_definitions(
            where, entry[COMMON_SETS], entry.get("propers"), problems
        )
        if section_kind != COMMON_KIND:
            problems.append(
                f"{where}: {COMMON_SETS} definitions belong only to a mass of "
                "the Commune Sanctorum"
            )
        if not has_propers or has_forms:
            problems.append(
                f"{where}: {COMMON_SETS} definitions require one flat propers list"
            )
    if has_text_status:
        status = entry[TEXT_STATUS]
        allowed_states = (
            UNAVAILABLE_TEXT_STATUS_STATES
            if section_kind == COMMON_KIND
            else TEXT_STATUS_STATES
        )
        check_text_status(
            where,
            status,
            problems,
            allowed_states=allowed_states,
        )
        state = status.get("state") if isinstance(status, dict) else None
        scope = status.get("scope") if isinstance(status, dict) else None
        if section_kind == COMMON_KIND and scope != "missal-formulary":
            problems.append(
                f"{where}: a Common's {TEXT_STATUS}.scope must be "
                "'missal-formulary'; Lectionary options are not a Missal formulary"
            )
        if state == "partial":
            if scope != "missal-formulary":
                problems.append(
                    f"{where}: partial {TEXT_STATUS} is only for scope "
                    "'missal-formulary'"
                )
            if section_kind == COMMON_KIND or has_season == has_date:
                problems.append(
                    f"{where}: partial {TEXT_STATUS} belongs only to a non-Common "
                    "dated or seasonal mass"
                )
            if has_propers == has_forms:
                problems.append(
                    f"{where}: partial {TEXT_STATUS} must coexist with exactly one "
                    "of propers or forms"
                )
            if takes_from:
                problems.append(
                    f"{where}: partial {TEXT_STATUS} records a local incomplete "
                    f"formulary and cannot coexist with {TAKES_FROM}"
                )
        if scope == "proper-collect":
            if not takes_from or has_common_from:
                problems.append(
                    f"{where}: {TEXT_STATUS}.scope 'proper-collect' must accompany "
                    f"{TAKES_FROM}, when only the borrowed Common's Collect is "
                    f"excluded; {COMMON_FROM} records antiphons only and establishes "
                    "nothing about the Collect"
                )
            local = entry.get("propers") if isinstance(entry.get("propers"), list) else []
            if any(
                isinstance(proper, dict)
                and str(proper.get("name") or "").split(" (", 1)[0] == "Collect"
                for proper in local
            ):
                problems.append(
                    f"{where}: {TEXT_STATUS} says the proper Collect is unavailable "
                    "but the mass also carries a Collect"
                )
    if has_ordinary_frame:
        check_ordinary_frame(where, entry[ORDINARY_FRAME], problems)
        if section_kind == COMMON_KIND:
            problems.append(
                f"{where}: a Common cannot carry {ORDINARY_FRAME}; applicability "
                "belongs to the rite that appoints a formulary"
            )
    if section_kind == COMMON_KIND and has_common_from:
        problems.append(
            f"{where}: a Common cannot carry {COMMON_FROM}; it is the destination"
        )
    if takes_from:
        # A mass that takes another formulary may still print propers of its
        # own: that is what a third-class saint is - the Mass of the Common
        # with a Collect of the saint - and it is the whole point of the key.
        # Forms are the one thing it cannot also carry, because a mass printed
        # in forms is a mass with more than one formulary and the reference
        # would not say which of them the borrowing applies to.
        check_reference(where, entry[TAKES_FROM], problems, on_proper=False)
        if has_forms:
            problems.append(
                f"{where}: a mass taking another formulary must not also carry forms"
            )
        if has_common_from:
            problems.append(
                f"{where}: {TAKES_FROM} cannot coexist with {COMMON_FROM}; one "
                "resolves a formulary and the other records an unresolved choice"
            )
        if has_text_status and (
            not isinstance(entry[TEXT_STATUS], dict)
            or entry[TEXT_STATUS].get("scope") != "proper-collect"
        ):
            problems.append(
                f"{where}: {TAKES_FROM} may coexist with {TEXT_STATUS} only for "
                "scope 'proper-collect', which excludes that one borrowed slot"
            )
    elif has_common_from:
        # A Common direction is a witnessed appointment for the slots named by
        # its scope, not itself a formulary and not evidence about any other
        # slots.  The independent status accounts for the actual text gap.
        if not has_text_status:
            problems.append(
                f"{where}: {COMMON_FROM} requires {TEXT_STATUS} for the proper "
                "text it does not resolve"
            )
        if has_forms:
            problems.append(
                f"{where}: {COMMON_FROM} cannot govern a mass printed in forms"
            )
        status = entry.get(TEXT_STATUS)
        admits_local = (
            isinstance(status, dict)
            and status.get("state") == "partial"
            and status.get("scope") == "missal-formulary"
        )
        if has_propers and not admits_local:
            problems.append(
                f"{where}: {COMMON_FROM} resolves no text; local propers require "
                f"partial {TEXT_STATUS} scope 'missal-formulary' to account for "
                "the remaining formulary"
            )
    elif entry.get("departure") == "absent":
        # A recension absence is never served and therefore owns no formulary
        # body to type as unavailable. Its mandatory `basis` is the evidence
        # for removal; adding a text-status gap would imply an appointed but
        # unheld formulary instead of an absent celebration.
        pass
    elif has_text_status:
        status = entry[TEXT_STATUS]
        state = status.get("state") if isinstance(status, dict) else None
        if state == "unavailable" and (has_propers or has_forms):
            problems.append(
                f"{where}: a standalone {TEXT_STATUS} for an unavailable formulary "
                "must not also carry propers or forms"
            )
    elif has_propers == has_forms:
        problems.append(
            f"{where}: exactly one of propers, forms, {TAKES_FROM}, or a typed "
            f"{COMMON_FROM}/{TEXT_STATUS} absence is required"
        )
    # Which day the propers stand on, read once and carried into every proper:
    # a reading course is admitted by the calendar that keeps it and the season
    # it runs in, and a proper cannot see either from where it sits.
    season = entry.get("season")
    if has_propers:
        propers = entry["propers"]
        if not isinstance(propers, list) or not propers:
            problems.append(f"{where}: propers must be a nonempty list")
        else:
            for proper in propers:
                check_proper(
                    where, proper, problems, calendar=calendar, season=season
                )
    if has_forms:
        forms = entry["forms"]
        if not isinstance(forms, list) or not forms:
            problems.append(f"{where}: forms must be a nonempty list")
        else:
            form_ids: set[str] = set()
            form_names: set[str] = set()
            for form in forms:
                if not isinstance(form, dict):
                    problems.append(f"{where}: form must be a mapping")
                    continue
                form_id = form.get("id")
                if not isinstance(form_id, str) or not FORM_ID_RE.fullmatch(form_id):
                    problems.append(
                        f"{where}: form id must be a nonempty lowercase kebab-case "
                        f"string, got {form_id!r}"
                    )
                else:
                    if form_id in form_ids:
                        problems.append(
                            f"{where}: duplicate form id {form_id!r} within one mass"
                        )
                    form_ids.add(form_id)
                    if form_id == TRANSLATION_MAIN_FORM_ID:
                        problems.append(
                            f"{where}: form id 'main' is reserved for a mass with "
                            "no forms and cannot identify a named form"
                        )
                unknown = field_names(
                    set(form) - {"id", "name", "propers", ORDINARY_FRAME}
                )
                if unknown:
                    problems.append(
                        f"{where}: form carries unknown field(s) {', '.join(unknown)}; "
                        "it takes id, name, propers, ordinary_frame"
                    )
                if ORDINARY_FRAME in form:
                    check_ordinary_frame(
                        f"{where}/form {form_id!r}",
                        form[ORDINARY_FRAME],
                        problems,
                    )
                form_name = form.get("name")
                if not isinstance(form_name, str) or not form_name.strip():
                    problems.append(f"{where}: form name must be a nonempty string")
                    continue
                if form_name in form_names:
                    problems.append(
                        f"{where}: duplicate form name {form_name!r} within "
                        "one mass; legacy form-label lookup would be ambiguous"
                    )
                form_names.add(form_name)
                inner = form.get("propers")
                if not isinstance(inner, list) or not inner:
                    problems.append(
                        f"{where}/{form_name}: propers must be a nonempty list"
                    )
                    continue
                for proper in inner:
                    check_proper(
                        f"{where}/{form_name}",
                        proper,
                        problems,
                        calendar=calendar,
                        season=season,
                    )
    check_duplicate_proper_bodies(where, entry, problems)
    return key


def common_reference_problems(masses: list[tuple[str, dict]]) -> list[str]:
    """Join every structural Common appointment to an actual Common mass."""
    targets: dict[str, tuple[str, dict]] = {}
    for kind, mass in masses:
        key = mass.get("key")
        if isinstance(key, str) and key:
            targets.setdefault(key, (kind, mass))
    problems: list[str] = []
    # A Common's source entry inventories every printed alternative.  A mass
    # taking it whole must select one exact bundle or carry a typed unresolved
    # disposition; absence is never permission to emit every branch.
    for _, mass in masses:
        reference = mass.get(TAKES_FROM)
        if not isinstance(reference, dict):
            continue
        target_key = reference.get("mass")
        if not isinstance(target_key, str) or not target_key:
            continue
        target = targets.get(target_key)
        if target is None:
            continue  # The shared resolver owns the missing-target diagnostic.
        target_kind, target_mass = target
        definitions = target_mass.get(COMMON_SETS)
        selections = reference.get(COMMON_SETS)
        if definitions is None and selections is None:
            continue
        origin = str(mass.get("key") or "<unnamed>")
        if target_kind != COMMON_KIND:
            problems.append(
                f"mass {origin}: {TAKES_FROM}.{COMMON_SETS} names {target_key!r} "
                f"in section kind {target_kind!r}, not the Commune Sanctorum"
            )
            continue
        if not isinstance(definitions, dict) or not definitions:
            problems.append(
                f"mass {origin}: {TAKES_FROM}.{COMMON_SETS} selects {target_key!r}, "
                f"which defines no {COMMON_SETS}"
            )
            continue
        if not isinstance(selections, dict):
            problems.append(
                f"mass {origin}: {TAKES_FROM} must disposition every "
                f"{target_key!r} {COMMON_SETS} group"
            )
            continue
        missing = sorted(set(definitions) - set(selections), key=repr)
        extra = sorted(set(selections) - set(definitions), key=repr)
        if missing:
            problems.append(
                f"mass {origin}: {TAKES_FROM}.{COMMON_SETS} omits target group(s) "
                + ", ".join(repr(group) for group in missing)
            )
        if extra:
            problems.append(
                f"mass {origin}: {TAKES_FROM}.{COMMON_SETS} carries unknown group(s) "
                + ", ".join(repr(group) for group in extra)
            )
        governed_families: set[str] = set()
        for group_id, group in definitions.items():
            if not isinstance(group, dict):
                continue
            families = group.get("families")
            if isinstance(families, list):
                governed_families.update(
                    family
                    for family in families
                    if isinstance(family, str) and family
                )
            options = group.get("options")
            disposition = selections.get(group_id)
            if not isinstance(options, dict) or not isinstance(disposition, dict):
                continue
            if disposition.get("state") == "selected":
                option = disposition.get("option")
                if option not in options:
                    problems.append(
                        f"mass {origin}: {TAKES_FROM}.{COMMON_SETS}.{group_id} "
                        f"names unknown option {option!r} on {target_key!r}"
                    )
            elif disposition.get("state") == "unresolved":
                candidates = disposition.get("candidates")
                if isinstance(candidates, list):
                    unknown = [candidate for candidate in candidates if candidate not in options]
                    if unknown:
                        problems.append(
                            f"mass {origin}: {TAKES_FROM}.{COMMON_SETS}.{group_id} "
                            "names unknown candidate(s) "
                            + ", ".join(repr(candidate) for candidate in unknown)
                        )
        local_propers = mass.get("propers")
        local_families = (
            [
                proper_family(str(proper.get("name") or ""))
                for proper in local_propers
                if isinstance(proper, dict)
                and proper_family(str(proper.get("name") or ""))
                in governed_families
            ]
            if isinstance(local_propers, list)
            else []
        )
        repeated = sorted(
            family for family in set(local_families) if local_families.count(family) > 1
        )
        if repeated:
            problems.append(
                f"mass {origin}: local propers repeat {COMMON_SETS}-governed "
                "family/families " + ", ".join(repr(family) for family in repeated)
            )
    for _, mass in masses:
        value = mass.get(COMMON_FROM)
        if not isinstance(value, dict) or not isinstance(value.get("options"), list):
            continue
        origin = str(mass.get("key") or "<unnamed>")
        for index, option in enumerate(value["options"]):
            if not isinstance(option, dict):
                continue
            target_key = option.get("mass")
            if not isinstance(target_key, str) or not target_key:
                continue
            target = targets.get(target_key)
            if target is None:
                problems.append(
                    f"mass {origin}: {COMMON_FROM}.options[{index}] names "
                    f"{target_key!r}, which this calendar has no entry for"
                )
                continue
            target_kind, target_mass = target
            if target_kind != COMMON_KIND:
                problems.append(
                    f"mass {origin}: {COMMON_FROM}.options[{index}] names "
                    f"{target_key!r} in section kind {target_kind!r}, not the "
                    "Commune Sanctorum"
                )
                continue
            status = target_mass.get(TEXT_STATUS)
            if not (
                isinstance(status, dict)
                and status.get("state") == "unavailable"
                and status.get("scope") == "missal-formulary"
            ):
                problems.append(
                    f"mass {origin}: {COMMON_FROM}.options[{index}] targets "
                    f"{target_key!r}, which is not explicitly unavailable with "
                    f"{TEXT_STATUS}.scope 'missal-formulary'"
                )
            carried = [
                field
                for field in ("propers", "forms", TAKES_FROM, COMMON_FROM)
                if field in target_mass
            ]
            if carried:
                problems.append(
                    f"mass {origin}: {COMMON_FROM}.options[{index}] targets "
                    f"{target_key!r}, which carries {', '.join(carried)} rather "
                    "than remaining an explicitly text-free Common"
                )
    # A different typed absence appoints a KNOWN Common while withholding only
    # the dated Mass's proper Collect.  That is a resolving ``takes_from`` edge,
    # unlike ``common_from`` above, but it is still meaningful only when the
    # borrowed formulary is a Common and really contributes the Collect that the
    # status excludes.  Resolve a copy without the exclusion: resolving the
    # original would remove the very slot this check needs to prove existed.
    document = {
        "sections": {
            "all": {"masses": [mass for _, mass in masses]},
        }
    }
    for _, mass in masses:
        status = mass.get(TEXT_STATUS)
        reference = mass.get(TAKES_FROM)
        if not (
            isinstance(status, dict)
            and status.get("state") == "unavailable"
            and status.get("scope") == "proper-collect"
            and isinstance(reference, dict)
        ):
            continue
        origin = str(mass.get("key") or "<unnamed>")
        target_key = reference.get("mass")
        if not isinstance(target_key, str) or not target_key:
            continue  # ``check_reference`` owns the malformed edge diagnostic.
        target = targets.get(target_key)
        if target is None:
            # ``resolve_propers`` reports the missing key below too, but this
            # diagnostic states the stronger typed-Common contract explicitly.
            problems.append(
                f"mass {origin}: {TAKES_FROM} for an unavailable proper Collect "
                f"names {target_key!r}, which this calendar has no entry for"
            )
            continue
        target_kind, _ = target
        if target_kind != COMMON_KIND:
            problems.append(
                f"mass {origin}: {TAKES_FROM} for an unavailable proper Collect "
                f"names {target_key!r} in section kind {target_kind!r}, not the "
                "Commune Sanctorum"
            )
            continue
        probe = dict(mass)
        probe.pop(TEXT_STATUS, None)
        inherited, trouble = resolve_propers(document, probe)
        if trouble:
            problems.append(
                f"mass {origin}: {TAKES_FROM} for an unavailable proper Collect "
                f"does not resolve {target_key!r} cleanly: {'; '.join(trouble)}"
            )
            continue
        if not any(
            str(proper.get("name") or "") == "Collect"
            for _, proper, _ in inherited
        ):
            problems.append(
                f"mass {origin}: {TAKES_FROM} for an unavailable proper Collect "
                f"targets {target_key!r}, whose selected formulary appoints no "
                "unqualified Collect"
            )
    return problems


def count_propers(entry: object) -> int:
    if not isinstance(entry, dict):
        return 0
    total = 0
    if isinstance(entry.get("propers"), list):
        total += len(entry["propers"])
    forms = entry.get("forms")
    if isinstance(forms, list):
        for form in forms:
            if isinstance(form, dict) and isinstance(form.get("propers"), list):
                total += len(form["propers"])
    return total


def check_file(path: Path, problems: list[str]) -> dict[str, int]:
    import yaml

    try:
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as error:
        problems.append(f"{path}: unreadable: {error}")
        return {"masses": 0, "propers": 0}
    if not isinstance(document, dict):
        problems.append(f"{path}: top level must be a mapping")
        return {"masses": 0, "propers": 0}
    for field in REQUIRED_HEADER:
        if field not in document:
            problems.append(f"{path}: missing header field {field}")
    numbering = document.get("psalm_numbering")
    if numbering not in PSALM_NUMBERING:
        problems.append(
            f"{path}: psalm_numbering must be one of {sorted(PSALM_NUMBERING)}, "
            f"got {numbering!r}"
        )
    if document.get("schema") != SCHEMA:
        problems.append(
            f"{path}: schema must be {SCHEMA!r}, got {document.get('schema')!r}"
        )
    if "masses" in document:
        problems.append(
            f"{path}: the mass list is canonical under sections; a top-level "
            "masses key duplicates it"
        )
    sections = document.get("sections")
    if not isinstance(sections, dict) or not sections:
        problems.append(f"{path}: sections must be a nonempty mapping")
        return {"masses": 0, "propers": 0}
    for section_name, section in sections.items():
        where = f"{path}: section {section_name!r}"
        if not isinstance(section_name, str) or not section_name.strip():
            problems.append(f"{where}: section key must be a nonempty string")
        if not isinstance(section, dict):
            problems.append(f"{where} must be a mapping")
            continue
        unknown = field_names(set(section) - {"kind", "label", "masses"})
        if unknown:
            problems.append(
                f"{where} carries unknown field(s) {', '.join(unknown)}"
            )
        kind = section.get("kind")
        if kind not in (*KINDS, COMMON_KIND):
            problems.append(
                f"{where}.kind must be one of {(*KINDS, COMMON_KIND)}, got {kind!r}"
            )
        elif isinstance(section_name, str) and section_name != kind:
            problems.append(
                f"{where}.kind {kind!r} must match its section key"
            )
        label = section.get("label")
        # A recension section is an overlay on its base and may inherit the
        # base section's display label.  Full calendar sources own their label
        # directly; an explicitly supplied label is never allowed to be empty.
        if label is not None:
            if not isinstance(label, str) or not label.strip():
                problems.append(f"{where}.label must be a nonempty string")
        elif not (
            isinstance(document.get("text_from"), str)
            and document["text_from"].strip()
        ):
            problems.append(f"{where}.label must be a nonempty string")
        section_masses = section.get("masses")
        if not isinstance(section_masses, list) or not section_masses:
            problems.append(f"{where}.masses must be a nonempty list")
            continue
        for index, mass in enumerate(section_masses):
            if not isinstance(mass, dict):
                problems.append(f"{where}.masses[{index}] must be a mapping")
    masses = iter_masses(document)
    if not masses:
        problems.append(f"{path}: sections must contain at least one mass")
        return {"masses": 0, "propers": 0}
    keys: list[str] = []
    registries: list[str] = []
    # The file's own name for itself, not the directory's: the index owns its
    # identity and `restated_identity` holds every companion to it, so a rule
    # keyed on which calendar this is reads the same string every other rule does.
    calendar = str(document.get("calendar") or "")
    for index, (section_kind, entry) in enumerate(masses):
        scoped: list[str] = []
        key = check_entry(entry, index, scoped, section_kind, calendar)
        problems.extend(f"{path}: {problem}" for problem in scoped)
        if key:
            keys.append(key)
        registry = entry.get("registry")
        if isinstance(registry, str):
            registries.append(registry)
    duplicates = sorted({key for key in keys if keys.count(key) > 1})
    if duplicates:
        problems.append(f"{path}: duplicate mass keys: {', '.join(duplicates)}")
    duplicate_registries = sorted(
        {registry for registry in registries if registries.count(registry) > 1}
    )
    if duplicate_registries:
        problems.append(
            f"{path}: duplicate registry IDs: {', '.join(duplicate_registries)}"
        )
    problems.extend(
        f"{path}: {problem}" for problem in common_reference_problems(masses)
    )
    # Shape is not landing. `check_entry` proves a reference is well formed;
    # only resolving it proves the mass, form and proper it names exist and
    # that the chain terminates. Both this check and the browser's structure
    # read that from `resolve_propers`, so neither can drift from the other.
    for _, entry in masses:
        try:
            _, trouble = resolve_propers(document, entry)
        except (AttributeError, KeyError, TypeError, ValueError) as error:
            problems.append(
                f"{path}: mass {entry.get('key', '<unnamed>')}: cannot resolve "
                f"malformed formulary: {error}"
            )
            continue
        problems.extend(f"{path}: {problem}" for problem in dict.fromkeys(trouble))
    return {
        "masses": len(masses),
        "propers": sum(count_propers(entry) for _, entry in masses),
    }


def run(root: Path, calendar: str | None) -> dict[str, object]:
    # Discovery is by declared schema, not by extension: a calendar directory
    # may hold a source another tool owns, and reading it as a mass index is how
    # this check first went red for a file that was never its business. The
    # partition is shared with `citations` so the two cannot disagree about what
    # a calendar directory contains.
    paths, companions, problems = partition(root, calendar)
    repository = Path(__file__).resolve().parents[1]
    problems.extend(
        catalog_problems(
            root,
            repository=repository,
            required=root.resolve() == (repository / DEFAULT_ROOT).resolve(),
        )
    )
    if not paths:
        scope = f" for calendar {calendar!r}" if calendar else ""
        raise ValueError(f"no calendar index found under {root}{scope}")
    files = {
        path.as_posix(): check_file(path, problems)
        for path in paths
    }
    # A recension states departures, not a book. Its rows are checked against the
    # base they depart from: guidance/recensions.md section 6 item 2 asks for a
    # check that fails when a recension's base does not exist and when a
    # departure names a mass the base does not hold. That second case is worse
    # than a broken link, because a departure resolving to nothing REMOVES a Mass
    # from the served calendar instead of adding a dangling pointer to it.
    for path in paths:
        problems.extend(recension_problems(root, path.parent.name))
    citation_errors, excepted = citation_problems(root, calendar)
    problems.extend(citation_errors)
    problems.extend(spine_problems(paths))
    # A rubric appointing one text across a range of days is stated in the
    # calendar's rubrics and carried by its masses, and nothing joined the two.
    # Both halves failed silently: eleven of the twelve days inside the Easter
    # and Pentecost octaves showed no Sequence, and the only statement that one
    # was appointed there was an English sentence in a `notes` string.
    problems.extend(span_problems(paths))
    # The order the edition prints a formulary in was stated in the schema
    # README and enforced nowhere, so a wave that appended propers instead of
    # interleaving them landed green and took 243 masses out of the browser's
    # Missal mode.
    problems.extend(order_problems(paths))
    overlay, witnessed = overlay_problems(paths)
    problems.extend(overlay)
    # The calendar index says what was transcribed; it is not a permission
    # record.  Each direct Latin text is hash-bound in a separate ledger whose
    # provenance and surface-specific publication decisions cannot collapse
    # into one blanket assertion about a missal or a Vatican edition.
    production_root = (
        root.resolve()
        == (Path(__file__).resolve().parents[1] / DEFAULT_ROOT).resolve()
    )
    problems.extend(
        latin_sidecar_problems(
            paths,
            inventory_root=root.parent / "inventories",
            required=production_root,
            # A synthetic fixture with no ledger has no source id to resolve.
            # Loading the 2,000-record source graph on every one of the shell
            # gate's fixture invocations would turn a shape check into minutes.
            registered_source_ids=source_ids()[0] if production_root else None,
        )
    )
    # The index names the book; a companion beside it must not name it again.
    # `edition` was hand-typed in both files of both calendar directories, four
    # copies of two strings, and nothing here compared them.
    problems.extend(restated_identity(root, calendar))
    # Reported here and once: the cache is populated only if some translation
    # actually asked for it, so a calendar with none never raises it at all.
    unreadable = (_SOURCE_RECORDS or (None, None))[1]
    if unreadable:
        problems.append(unreadable)
    return {
        "excepted": excepted,
        "files": files,
        # Named rather than counted, so a reader can see which files this check
        # did not look at and which tool is supposed to.
        "held_by_other_tools": companions,
        "problems": problems,
        "status": "error" if problems else "ok",
        # The detector's own reading, reported whether or not it found a fault.
        # An agreement raises no problem and is the strongest evidence this
        # corpus holds -- 54 of 54 agreeing loci were right -- so a channel that
        # only carried faults would throw it away.
        "witnesses": witnessed,
    }


def sibling(name: str):
    """Load a sibling tool as a module rather than restating what it decides.

    The module is registered in `sys.modules` before it is executed. A tool that
    declares a dataclass cannot be executed otherwise: `dataclasses` resolves a
    field's annotation through whatever `sys.modules` holds for the class's
    `__module__`, and finds nothing there for a module loaded without one.
    """
    path = Path(__file__).resolve().parent / name
    loader = SourceFileLoader(f"_{name.replace('-', '_')}", str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:  # pragma: no cover - a broken checkout, not a code path
        raise ValueError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def act_history() -> tuple[dict, dict, set, str]:
    """The acts and witnesses the act history carries, and the kinds it uses.

    Read through `act-history`'s own loader, which resolves `extends` so the
    wider slice is read on top of the narrower one instead of beside it. Parsing
    the two files here would be the second copy that file's own header refuses.

    Returns the acts by id, the witnesses by id, the `attests_kind` values its
    witnesses actually use, and an empty string, or four empty values and the
    reason the history could not be read.
    """
    path = Path(__file__).resolve().parents[1] / ACTS_SOURCE
    if not path.is_file():
        return {}, {}, set(), f"{path} is missing; no source can be held to it"
    try:
        history = sibling("act-history").load(path)
    except Exception as error:  # the loader raises its own Problem type
        return {}, {}, set(), f"{path}: cannot read the act history: {error}"
    acts = {
        str(row.get("id") or ""): row
        for row in history.get("acts") or []
        if isinstance(row, dict)
    }
    witnesses = {
        str(row.get("id") or ""): row
        for row in history.get("witnesses") or []
        if isinstance(row, dict)
    }
    kinds = {
        str(row.get(OVERLAY_ATTESTS_KIND))
        for row in witnesses.values()
        if row.get(OVERLAY_ATTESTS_KIND)
    }
    return acts, witnesses, kinds, ""


def source_attestation_problems(where: str, row: dict, history: tuple) -> list[str]:
    """Every way a sidecar's witness fails to say which rite it witnesses.

    A `[[sources]]` row is a BOOK, and the one thing a reader needs to know about
    a book quoted into a calendar is which state of the rite it prints. Both
    books in the 1962 sidecar are pre-1955 hand missals and said so only in
    `caution` prose; a page serving their English under a 1962 heading had
    nothing machine-readable to say otherwise, and 176 collations were run
    against one of them under that heading.

    The project's own composed English is exempt and named as such. A row with no
    `source_id` is the project as its own witness -- the case `mass-propers`
    already admits by presence rather than truth -- and it witnesses no printing,
    so an act edge for it would be an invention rather than a record.
    """
    acts, witnesses, kinds, trouble = history
    if "source_id" in row and not str(row.get("source_id") or "").strip():
        return []
    problems = [
        f"{where}: states no {field}. A witness quoted into a calendar says which "
        "state of the rite it prints, in the act history's vocabulary, or the "
        "claim lives in prose nothing reads."
        for field in OVERLAY_ATTESTS_FIELDS
        if not str(row.get(field) or "").strip()
    ]
    if problems:
        return problems
    if trouble:
        return [f"{where}: {trouble}"]
    attests = str(row[OVERLAY_ATTESTS]).strip()
    kind = str(row[OVERLAY_ATTESTS_KIND]).strip()
    if attests != ACTS_UNESTABLISHED and attests not in acts:
        problems.append(
            f"{where}: {OVERLAY_ATTESTS} names {attests!r}, which the act history "
            f"does not carry. An edge to an act nobody recorded resolves to nothing; "
            f"say {ACTS_UNESTABLISHED!r} where the state cannot be established."
        )
    if kind not in kinds:
        problems.append(
            f"{where}: {OVERLAY_ATTESTS_KIND} is {kind!r}, which no witness in the "
            f"act history uses. It is one of: {', '.join(sorted(kinds))}."
        )
    # The same book in two files is a prediction that the two will differ. Held
    # to agree, it is a checked restatement instead.
    held = witnesses.get(str(row.get("id") or ""))
    if held:
        for field in (OVERLAY_ATTESTS, OVERLAY_ATTESTS_KIND):
            theirs = str(held.get(field) or "").strip()
            if theirs and theirs != str(row.get(field) or "").strip():
                problems.append(
                    f"{where}: {field} is {str(row.get(field))!r} and the act "
                    f"history records {theirs!r} for the same witness; one book "
                    "does not attest two states."
                )
    return problems


def calendar_spine():
    """The tool that owns the spine, rather than a second parse of it.

    The spine is derived from the calendar-reference publications, which is a
    different source from the mass indexes; restating that derivation here is
    how the two would come to disagree about what a calendar contains.
    """
    return sibling("calendar-spine")


def _spine_identity(record: dict, *, title_field: str) -> dict[str, str]:
    """The identity fields the spine and the mass index actually share.

    A spine registry identifies a fixed calendar row (for example
    ``1962-01-06``), while a mass may retain its temporal-series registry (for
    example ``10``).  Equating those two namespaces made five fully filed 1962
    formularies look absent after the temporal registry was renumbered.

    Both sources do share the stable key, date, printed rank, and principal
    title.  A calendar-reference title may append commemorations after a
    semicolon; the mass index files those as their own entries, so the
    principal identity ends at that delimiter on both sides.
    """
    title = " ".join(
        unicodedata.normalize("NFC", str(record.get(title_field) or "")).split()
    ).split(";", 1)[0].strip()
    return {
        "key": str(record.get("key") or ""),
        "date": str(record.get("date") or ""),
        "rank": str(record.get("rank") or ""),
        "title": title,
    }


def _spine_identity_problems(entry: dict, mass: dict, section_kind: str) -> list[str]:
    """Compare one spine row with the mass filed under its stable key."""
    expected = _spine_identity(entry, title_field="title")
    actual = _spine_identity(mass, title_field="name")
    registry = str(entry.get("registry") or "")
    title = str(entry.get("title") or "")
    problems = [
        f"{registry} ({title}) identifies {field} {wanted!r}, but mass "
        f"{actual['key']!r} carries {got!r}"
        for field, wanted in expected.items()
        if (got := actual[field]) != wanted
    ]
    mass_registry = str(mass.get("registry") or "")
    if mass_registry != registry and (
        expected["key"], registry, mass_registry
    ) not in SPINE_REGISTRY_CROSSWALK:
        problems.append(
            f"{registry} ({title}) identifies registry {registry!r}, but mass "
            f"{actual['key']!r} carries {mass_registry!r}; this is not one of the "
            "five recorded fixed-row/temporal-catalog crosswalks"
        )
    if section_kind != entry.get("kind"):
        problems.append(
            f"{registry} ({title}) is filed {section_kind} but the spine "
            f"classifies it {entry.get('kind')}"
        )
    return problems


def spine_problems(paths: list[Path]) -> list[str]:
    """Every celebration the spine carries must have a mass, filed as it says.

    The spine is the identity and ordering source for the sanctoral, so a date
    it lists and the propers do not is a hole, and a date the two file
    differently is a disagreement about what kind of celebration it is. Nothing
    compared them before, which is how three days of the Christmas octave came
    to sit in the spine and in no section at all.

    Only calendars the spine knows are checked; a calendar it has no reference
    publication for is out of its scope, not in breach of it.
    """
    import yaml

    try:
        tool = calendar_spine()
    except (OSError, ValueError) as error:
        return [f"cannot load the calendar spine: {error}"]
    problems: list[str] = []
    for path in paths:
        name = path.parent.name
        if name not in tool.SOURCES:
            continue
        try:
            entries = tool.spine(name)
        except (OSError, ValueError) as error:
            problems.append(f"{path}: cannot derive the spine: {error}")
            continue
        try:
            document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError):
            continue  # already reported by check_file
        if not isinstance(document, dict):
            continue
        filed: dict[str, tuple[str, dict]] = {}
        sections = document.get("sections")
        if not isinstance(sections, dict):
            continue
        for section in sections.values():
            if not isinstance(section, dict):
                continue
            kind = str(section.get("kind") or "")
            section_masses = section.get("masses")
            if not isinstance(section_masses, list):
                continue
            for mass in section_masses:
                if isinstance(mass, dict) and mass.get("key") is not None:
                    # Duplicate keys are already a check_file failure. Keeping
                    # the first here makes this comparison deterministic while
                    # that owning diagnostic reports the duplicate itself.
                    filed.setdefault(str(mass["key"]), (kind, mass))
        for entry in entries:
            registry = str(entry["registry"])
            key = str(entry["key"])
            if key not in filed:
                problems.append(
                    f"{path}: the spine carries {registry} ({entry['title']}) "
                    f"as key {key!r}, and no section has a mass with that key"
                )
                continue
            section_kind, mass = filed[key]
            problems.extend(
                f"{path}: {problem}"
                for problem in _spine_identity_problems(entry, mass, section_kind)
            )
    return problems


def _span_shape(where: str, span: dict, problems: list[str]) -> bool:
    """The row itself, before anything is looked up. True if it is worth joining."""
    unknown = field_names(set(span) - SPAN_FIELDS)
    if unknown:
        problems.append(
            f"{where}: unrecognised field(s) {', '.join(repr(k) for k in unknown)}; "
            f"a span carries {', '.join(sorted(SPAN_FIELDS))}"
        )
    # `before` is the only one of the three the join cannot proceed without; a
    # row missing its label or its note is still a row that can be checked.
    sound = True
    for field in ("label", "before", "note"):
        if not str(span.get(field) or "").strip():
            problems.append(f"{where}: a span states its {field}")
            if field == "before":
                sound = False
    prints = span.get(SPAN_PRINTS)
    if not isinstance(prints, dict):
        problems.append(f"{where}: {SPAN_PRINTS} names the mass and proper the text is written at")
        sound = False
    else:
        strange = field_names(set(prints) - SPAN_PRINTS_FIELDS)
        if strange:
            problems.append(
                f"{where}: {SPAN_PRINTS} carries unknown field(s) {', '.join(strange)}; "
                f"it takes {', '.join(sorted(SPAN_PRINTS_FIELDS))}"
            )
        for field in sorted(SPAN_PRINTS_FIELDS):
            if not isinstance(prints.get(field), str) or not prints[field]:
                problems.append(f"{where}: {SPAN_PRINTS} needs a {field}")
                sound = False
    keys = span.get("keys")
    if not isinstance(keys, list) or not keys or not all(
        isinstance(key, str) and key for key in keys
    ):
        problems.append(f"{where}: keys is the nonempty list of masses the text is appointed on")
        sound = False
    elif len(set(keys)) != len(keys):
        problems.append(f"{where}: keys names a mass twice; a mass is appointed the text once")
    # A span's authority and its evidence are checked together, because the one
    # failure this file cannot tolerate is a citation nobody read. `stated` says
    # the rubric was read; `locus` says where. Neither may stand without the
    # other, and the rubric's own words may not be quoted from nowhere.
    stated = span.get(SPAN_STATED)
    locus = span.get(SPAN_LOCUS)
    if not isinstance(stated, bool):
        problems.append(f"{where}: {SPAN_STATED} is true or false; a span says whether the rubric was read")
    elif stated and not str(locus or "").strip():
        problems.append(
            f"{where}: {SPAN_STATED} is true and {SPAN_LOCUS} is empty; a rubric read "
            "from a witness says where it was read"
        )
    elif not stated:
        if locus is not None:
            problems.append(
                f"{where}: {SPAN_STATED} is false and {SPAN_LOCUS} is {locus!r}; a span "
                f"nobody has read carries {SPAN_LOCUS}: null and says so in its note"
            )
        if "latin" in span:
            problems.append(
                f"{where}: {SPAN_STATED} is false and the row quotes the rubric's own "
                "words; a quotation with no locus is a quotation from nowhere"
            )
    if "latin" in span and not str(span.get("latin") or "").strip():
        problems.append(f"{where}: latin is the rubric's own words, or is absent")
    return sound


def _by_form(entries: list[tuple[str, dict, dict | None]]) -> dict[str, list[tuple[dict, dict | None]]]:
    """Resolved propers grouped by the form they stand in, in printed order.

    A Mass printed in two forms says the day twice, so a text appointed on the
    day is appointed in each of them. Grouping is what lets the join say that:
    the Ember Saturday of the Pentecost octave prints a longer and a shorter
    Mass, and a Sequence supplied to only one of them is missing from the Mass
    that is actually said whenever the other is chosen.
    """
    grouped: dict[str, list[tuple[dict, dict | None]]] = {}
    for label, proper, provenance in entries:
        grouped.setdefault(label, []).append((proper, provenance))
    return grouped


def _span_join(
    where: str,
    span: dict,
    document: dict,
    index: dict[str, dict],
    problems: list[str],
) -> None:
    prints = span[SPAN_PRINTS]
    home, wanted, before = prints["mass"], prints["proper"], str(span["before"])
    label = str(span.get("label") or span.get("id") or "")
    keys = [str(key) for key in span["keys"]]
    if home in keys:
        problems.append(
            f"{where}: keys names {home!r}, which is where the text is written; "
            "keys lists the masses that take it"
        )
    for key in (home, *keys):
        mass = index.get(key)
        if mass is None:
            problems.append(f"{where}: names mass {key!r}, which this calendar has no entry for")
            continue
        # Trouble from the reference itself is `check_file`'s to report; this
        # join reads the same resolution and says only what the span asks of it.
        entries, _ = resolve_propers(document, mass)
        for form, resolved in sorted(_by_form(entries).items()):
            at = f"{where}: {key}" + (f"/{form}" if form else "")
            names = [str(proper.get("name")) for proper, _ in resolved]
            found = [n for n, name in enumerate(names) if name == wanted]
            if not found:
                problems.append(
                    f"{at}: appoints no {wanted!r}, and {label} appoints it there. "
                    f"Take it by {TAKES_FROM} from {home!r}; do not write the text again."
                )
                continue
            for position in found:
                # An empty provenance is a proper the mass prints itself, which
                # is right at `home` and is the forbidden copy anywhere else.
                taken = str((resolved[position][1] or {}).get("mass") or "")
                if key != home and not taken:
                    problems.append(
                        f"{at}: prints its own {wanted!r}, and {label} appoints the one "
                        f"{home!r} prints. One text appointed across a span is written "
                        f"once and taken by {TAKES_FROM}; a second copy is a second "
                        "reading waiting to disagree."
                    )
                elif key != home and taken != home:
                    problems.append(
                        f"{at}: takes its {wanted!r} from {taken!r}, and {label} appoints "
                        f"the one {home!r} prints"
                    )
                if before not in names:
                    problems.append(
                        f"{at}: appoints no {before!r} for {wanted!r} to stand before"
                    )
                elif names.index(before) != position + 1:
                    problems.append(
                        f"{at}: prints {wanted!r} at position {position + 1} of "
                        f"{len(names)}, and {label} stands immediately before {before!r}"
                    )


def span_problems(paths: list[Path]) -> list[str]:
    """Every way a text appointed across a span of days fails to reach one.

    A rubric that appoints one text on a range of days is stated in the
    calendar's `rubrics.yaml` and carried by the masses through `takes_from`.
    Nothing joined the two, so both halves could fail silently and both did: the
    Easter span existed only as an English sentence in a `notes` string, which
    no tool reads and no check tests, and eleven of the twelve days inside the
    two octaves showed no Sequence at all while claiming to show the Mass.

    Two failures this reports have never been reportable here. A mass the span
    names that appoints no proper of that name is the hole. A mass that PRINTS
    the text instead of referencing it is the copy the rule forbids, and it was
    undetectable: `check_entry` enumerates no unknown fields on a mass, so a key
    invented to say this would have been ignored by every tool in the
    repository, and a retyped Sequence would simply have looked like a mass with
    one more proper.

    Only calendars that state spans are checked. A calendar with no
    `rubrics.yaml`, or one whose rubrics state none, is outside this rule rather
    than in breach of it.
    """
    import yaml

    problems: list[str] = []
    for path in paths:
        source = path.parent / SPANS_SOURCE
        if not source.is_file():
            continue
        try:
            rubrics = yaml.safe_load(source.read_text(encoding="utf-8"))
            document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError) as error:
            problems.append(f"{source}: unreadable: {error}")
            continue
        if not isinstance(rubrics, dict) or not isinstance(document, dict):
            continue
        index = mass_index(document)
        seen: set[str] = set()
        for position, span in enumerate(spans_of(rubrics)):
            identifier = str(span.get("id") or "")
            where = f"{source}: {APPOINTED_ACROSS}[{identifier or position}]"
            if not identifier:
                problems.append(f"{where}: a span states its id")
            elif identifier in seen:
                problems.append(f"{where}: stated twice; a span has one row")
            seen.add(identifier)
            if _span_shape(where, span, problems):
                _span_join(where, span, document, index, problems)
    return problems


def slot_ordinals(calendar: str) -> dict[str, int]:
    """Proper name to its place in the Ordinary, from the Ordo Missae inventory.

    Read rather than transcribed, for the reason the attestation vocabulary is:
    the inventory states each slot's position on the authority of a named
    paragraph of the Ritus servandus, and a second copy of that order here would
    be free to disagree with the book.
    """
    import tomllib

    source = Path(__file__).resolve().parents[1] / OVERLAY_DIR / f"{calendar}{ORDO_SUFFIX}"
    if not source.is_file():
        return {}
    try:
        document = tomllib.loads(source.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError):
        return {}
    slots = document.get("slots")
    if not isinstance(slots, list):
        return {}
    return {
        str(name): position
        for position, slot in enumerate(slots)
        if isinstance(slot, dict)
        for name in (
            slot.get("propers") if isinstance(slot.get("propers"), list) else []
        )
    }


def order_problems(paths: list[Path]) -> list[str]:
    """Refuse a mass whose propers do not stand in the order the book prints.

    `src/sources/calendars/README.md` has always said propers stand in the order
    the edition appoints them, and nothing enforced it. A 2026-08-08 wave
    appended newly transcribed scripture above the pre-existing orations in 49
    formularies; every gate stayed green, the census counted correctly, and 243
    of 491 masses stopped rendering in the browser's Missal mode, because the
    seating walks the propers in file order and by contract never reorders.

    A qualified name is judged by its family, so `Collect (in plurali)` is a
    Collect: the alternate stands where the oration it alternates with stands.
    A name no slot claims is skipped rather than guessed at, and each `forms`
    block is judged on its own.

    Some rites genuinely leave the frame -- Good Friday, the paschal Vigil, an
    Ember Saturday's several Lessons -- so a calendar may carry a ledger of
    them. It is self-cleaning in both directions, like the psalm ledger: an
    unlisted breach fails, and a listed entry that has stopped breaching fails
    until it is deleted, so an exception cannot outlive the departure it names.
    """
    import yaml

    problems: list[str] = []
    for path in paths:
        order = slot_ordinals(path.parent.name)
        if not order:
            continue
        try:
            document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError):
            continue
        if not isinstance(document, dict):
            continue
        allowed = {
            (str(row.get("mass") or ""), str(row.get("form") or ""))
            for row in document.get(ORDER_EXCEPTIONS) or []
            if isinstance(row, dict)
        }
        breached: set[tuple[str, str]] = set()
        for _, mass in iter_masses(document):
            key = str(mass.get("key") or "")
            groups = [("", mass.get("propers"))]
            forms = mass.get("forms")
            for form in forms if isinstance(forms, list) else []:
                if isinstance(form, dict):
                    groups.append((str(form.get("name") or ""), form.get("propers")))
            for label, propers in groups:
                if not isinstance(propers, list):
                    continue
                seen: list[tuple[str, int]] = []
                for proper in propers:
                    if not isinstance(proper, dict):
                        continue
                    name = str(proper.get("name") or "")
                    place = order.get(name.split(SLOT_QUALIFIER)[0])
                    if place is not None:
                        seen.append((name, place))
                out_of_place = [
                    seen[i][0]
                    for i in range(1, len(seen))
                    if seen[i][1] < seen[i - 1][1]
                ]
                if not out_of_place:
                    continue
                breached.add((key, label))
                if (key, label) in allowed:
                    continue
                where = f"{key}/{label}" if label else key
                problems.append(
                    f"{path}: {where}: propers do not stand in the order the "
                    f"edition prints them; {', '.join(out_of_place)} stands "
                    "behind a proper the Ordinary seats later. Restore the "
                    f"printed order, or record the departure in {ORDER_EXCEPTIONS}."
                )
        for key, label in sorted(allowed - breached):
            where = f"{key}/{label}" if label else key
            problems.append(
                f"{path}: {ORDER_EXCEPTIONS}: {where} no longer departs from the "
                "printed order; delete the entry."
            )
    return problems


def collated_form(text: str) -> str:
    """One witness's wording, with the differences that are not readings gone."""
    return " ".join(unicodedata.normalize("NFC", text).translate(NOT_A_READING).split())


def witness_verdict(payload: object) -> bool | None:
    """Whether a proper's witnesses differ, or `None` where it has only one.

    Keyed the way `check_translation_list` keys uniqueness: two translations in
    one language from two `source_id`s are two witnesses to one prayer, and that
    pair is the whole detector. A language heard once is not compared, and a
    proper heard once in every language it carries returns `None` rather than
    `False`, so "nobody read it twice" cannot be counted as agreement.
    """
    if not isinstance(payload, list):
        return None
    heard: dict[str, dict[str, str]] = {}
    for entry in payload:
        if not isinstance(entry, dict):
            continue
        lang, text = entry.get("lang"), entry.get("text")
        if not isinstance(lang, str) or not isinstance(text, str):
            continue
        heard.setdefault(lang, {})[str(entry.get("source_id") or "")] = collated_form(text)
    read_twice = [forms for forms in heard.values() if len(forms) > 1]
    if not read_twice:
        return None
    return any(len(set(forms.values())) > 1 for forms in read_twice)


def witness_problems(where: str, entry: dict, payload: object) -> tuple[list[str], bool | None]:
    """Hold a twice-read proper to its own record of what the two readings do.

    Self-cleaning in both directions, which is what keeps it from rotting into a
    permission nobody remembers granting: a divergence nobody has answered fails
    until someone does, and an answer left behind by a correction fails until it
    is deleted. Neither failure is "the witnesses disagree" — that is the
    finding, and the finding is reported whether or not anything is wrong.
    """
    problems: list[str] = []
    verdict = witness_verdict(payload)
    recorded = str(entry.get(OVERLAY_DISAGREEMENT) or "").strip()
    claims = str(entry.get(OVERLAY_DETECTOR) or "").strip() == SIBLING_AGREES
    if verdict is None:
        if recorded:
            problems.append(
                f"{where}: records a {OVERLAY_DISAGREEMENT} and carries one witness. "
                "Nothing disagrees with it; delete the note or attach the second "
                "reading it answers."
            )
        if claims:
            problems.append(
                f"{where}: claims {OVERLAY_DETECTOR} = {SIBLING_AGREES!r} and carries "
                "one witness. An agreement nothing can be compared against is an "
                "assertion, which is what attaching the sibling was for."
            )
        return problems, verdict
    if verdict:
        if not recorded:
            problems.append(
                f"{where}: its witnesses read this prayer differently and no "
                f"{OVERLAY_DISAGREEMENT} says which reading was settled or how. Every "
                "error this corpus has found sat at a locus like this one; answer it "
                "on the page and write the answer here."
            )
        if claims:
            problems.append(
                f"{where}: claims {OVERLAY_DETECTOR} = {SIBLING_AGREES!r} and its "
                "witnesses differ."
            )
    elif recorded:
        problems.append(
            f"{where}: records a {OVERLAY_DISAGREEMENT} its witnesses no longer have. "
            "The reading was corrected; delete the note."
        )
    return problems, verdict


def overlay_problems(paths: list[Path]) -> tuple[list[str], list[dict]]:
    """Hold the translation sidecars to the same rules as an inline translation.

    A calendar's `translations` belong inside each proper and are recorded in
    `src/sources/inventories/<calendar>-proper-translations-v1.toml` only until
    the file that owns them can take them. That sidecar is what `mass-propers`
    reads and therefore what the site serves, so leaving it unvalidated made
    every rule above ceremonial: no calendar index carries an inline
    translation, and all 160 real ones sat in a file nothing checked.

    Keyed off the calendar directories actually being checked, so a temporary
    root with no sidecar beside it validates nothing rather than reaching into
    the repository behind the caller's back.

    `[[sources]]` was checked by nothing at all until the attestation gate below,
    which is the sharper form of the same defect the docstring above describes:
    the rules applied to the translations and left the record of WHICH BOOK they
    came out of entirely unread.

    Returns the problems and one report row per sidecar that holds a prayer read
    by two witnesses, because the agreement half of the detector is a finding and
    not a fault: it has no problem to raise and is worth printing anyway.
    """
    import tomllib

    root = Path(__file__).resolve().parents[1] / OVERLAY_DIR
    problems: list[str] = []
    witnessed: list[dict] = []
    history: tuple | None = None
    for path in paths:
        sidecar = root / f"{path.parent.name}{OVERLAY_SUFFIX}"
        if not sidecar.is_file():
            continue
        try:
            document = tomllib.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as error:
            problems.append(f"{sidecar}: unreadable: {error}")
            continue
        # Loaded once, and only where a sidecar was actually found.
        if history is None:
            history = act_history()
        source_rows: dict[str, dict] = {}
        source_alias_rows: dict[str, dict] = {}
        source_payload = document.get("sources") or []
        if not isinstance(source_payload, list):
            problems.append(f"{sidecar}: sources must be an array of tables")
            source_payload = []
        for index, row in enumerate(source_payload):
            if not isinstance(row, dict):
                problems.append(f"{sidecar}: sources[{index}] is not a table")
                continue
            raw_id = row.get("id")
            named = (
                raw_id.strip()
                if isinstance(raw_id, str) and raw_id.strip()
                else f"sources[{index}]"
            )
            if named.startswith("sources["):
                problems.append(
                    f"{sidecar}: sources[{index}].id must be a nonempty string"
                )
            if named in source_rows:
                problems.append(f"{sidecar}: duplicate sources.id {named!r}")
            source_rows[named] = row
            for field in ("source_id", "artifact_id"):
                if field not in row:
                    continue
                alias = row.get(field)
                if not isinstance(alias, str) or (
                    field == "artifact_id" and not alias.strip()
                ):
                    problems.append(
                        f"{sidecar}: {named}.{field} must be "
                        f"{'a string' if field == 'source_id' else 'a nonempty string'}"
                    )
                    continue
                other = source_alias_rows.get(alias)
                if other is not None and other is not row:
                    problems.append(
                        f"{sidecar}: duplicate translation source alias {alias!r}"
                    )
                else:
                    source_alias_rows[alias] = row
            for field in ("label", "rights"):
                value = row.get(field)
                if not isinstance(value, str) or not value.strip():
                    problems.append(
                        f"{sidecar}: {named}.{field} must be a nonempty string"
                    )
            if isinstance(row.get("rights"), str) and row["rights"] not in TRANSLATION_RIGHTS:
                problems.append(
                    f"{sidecar}: {named}.rights must be one of "
                    f"{sorted(TRANSLATION_RIGHTS)}, got {row['rights']!r}"
                )
            problems.extend(
                source_attestation_problems(f"{sidecar}: {named}", row, history)
            )
        agree: list[str] = []
        disagree: list[str] = []
        active_targets: set[tuple[object, ...]] = set()
        active_entries: list[tuple[str, dict]] = []
        entry_payload = document.get("entries") or []
        if not isinstance(entry_payload, list):
            problems.append(f"{sidecar}: entries must be an array of tables")
            entry_payload = []
        for index, entry in enumerate(entry_payload):
            where = f"{sidecar}: entries[{index}]"
            if not isinstance(entry, dict):
                problems.append(f"{where}: entry is not a table")
                continue
            named = " ".join(
                str(entry.get(field) or "")
                for field in ("mass", "form", "proper")
                if entry.get(field)
            )
            named = named or f"entries[{index}]"
            where = f"{sidecar}: {named}"
            if "incipit" in entry and (
                not isinstance(entry["incipit"], str) or not entry["incipit"].strip()
            ):
                problems.append(f"{where}: incipit must be a nonempty string")
            target = (
                entry.get("mass"),
                (
                    entry.get("form_id")
                    if entry.get("form_id") is not None
                    else entry.get("form") or ""
                ),
                entry.get("proper"),
                entry.get("cycle") or "all",
                entry.get("occurrence") or 1,
            )
            if target in active_targets:
                problems.append(
                    f"{sidecar}: duplicate exact translation entry target {target!r}"
                )
            active_targets.add(target)
            active_entries.append((where, entry))
            payload = entry.get("translations")
            if payload is None:
                problems.append(f"{where}: entry records no translations")
                continue
            check_translation_list(where, payload, problems, entry.get("proper"))
            for translation_index, translation in enumerate(payload if isinstance(payload, list) else []):
                if not isinstance(translation, dict):
                    continue
                source_id = translation.get("source_id")
                alias = source_id if isinstance(source_id, str) else ""
                source_row = source_alias_rows.get(alias)
                rights = translation.get("rights")
                if rights != "project-created" and source_row is None:
                    problems.append(
                        f"{where}.translations[{translation_index}]: source_id "
                        f"{alias!r} has no [[sources]] rights row"
                    )
                elif source_row is not None and rights != source_row.get("rights"):
                    problems.append(
                        f"{where}.translations[{translation_index}]: rights "
                        f"{rights!r} do not match source {alias!r} rights "
                        f"{source_row.get('rights')!r}"
                    )
            problems.extend(overlay_entry_source_problems(where, entry, source_rows))
            problems.extend(overlay_entry_publication_problems(where, entry))
            found, verdict = witness_problems(where, entry, payload)
            problems.extend(found)
            if verdict is not None:
                (disagree if verdict else agree).append(named)
        # A typed absence names the exact source-owned slot it answers. Human
        # form labels and incipits are display/content, not identity: forms have
        # source-authored ids, a mass with no forms uses the reserved `main`,
        # and repeated proper names are distinguished by their positive
        # one-based occurrence in source order. Cycle is explicit even when the
        # record covers every course. This is the same identity the consumer
        # needs to keep a year-C absence off years A and B.
        try:
            import yaml

            calendar_document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError) as error:
            problems.append(f"{path}: cannot validate untranslated targets: {error}")
            calendar_document = {}
        exact_targets: dict[tuple[str, str, str, str, int], dict[str, object]] = {}
        target_counts: dict[tuple[str, str, str, str], int] = {}
        legacy_form_ids: dict[tuple[str, str], str] = {}
        if isinstance(calendar_document, dict):
            for _, mass in iter_masses(calendar_document):
                mass_key = str(mass.get("key") or "")
                legacy_form_ids[(mass_key, "")] = TRANSLATION_MAIN_FORM_ID
                groups: list[tuple[str, object]] = [
                    (TRANSLATION_MAIN_FORM_ID, mass.get("propers"))
                ]
                forms = mass.get("forms")
                for form in forms if isinstance(forms, list) else []:
                    if not isinstance(form, dict):
                        continue
                    form_id = form.get("id")
                    # The owning form validator reports a missing/non-string
                    # id. Do not invent one from the human label here.
                    if not isinstance(form_id, str) or not form_id.strip():
                        continue
                    form_name = form.get("name")
                    if isinstance(form_name, str) and form_name.strip():
                        legacy_form_ids[(mass_key, form_name)] = form_id
                    groups.append((form_id, form.get("propers")))
                for form_id, propers in groups:
                    if not isinstance(propers, list):
                        continue
                    # Occurrence is the top-level source ordinal among owners
                    # with the same printed name.  Count it before asking
                    # whether the owner is Scripture, a placeholder, or
                    # cycle-varying, then reuse that ordinal for every cycle.
                    # Otherwise the exact identity changes when a consumer
                    # filters out a body it cannot translate.
                    proper_occurrences: dict[str, int] = {}
                    for proper in propers:
                        if not isinstance(proper, dict):
                            continue
                        if proper.get(TAKES_FROM):
                            # A reference appoints another owner's body. It has
                            # no positive translation identity of its own and
                            # therefore cannot move a later local owner's
                            # source-order occurrence.
                            continue
                        proper_name = str(proper.get("name") or "")
                        occurrence = proper_occurrences.get(proper_name, 0) + 1
                        proper_occurrences[proper_name] = occurrence
                        top_incipit = str(proper.get("incipit") or "")
                        owners: list[tuple[str, dict]] = []
                        for field, admitted in (
                            ("cycles", {"A", "B", "C"}),
                            (WEEKDAY_CYCLES_KEY, set(WEEKDAY_CYCLES)),
                        ):
                            branches = proper.get(field)
                            if not isinstance(branches, dict):
                                # The owning schema walk has already reported
                                # the malformed recurrence.  Preserve that
                                # actionable problem instead of replacing it
                                # with an AttributeError in this join.
                                continue
                            for cycle, owner in branches.items():
                                if cycle in admitted and isinstance(owner, dict):
                                    owners.append((str(cycle), owner))
                        if not owners:
                            owners.append(("all", proper))
                        for cycle, owner in owners:
                            base = (mass_key, form_id, proper_name, cycle)
                            target_counts[base] = max(
                                target_counts.get(base, 0), occurrence
                            )
                            status = owner.get(TEXT_STATUS)
                            if not isinstance(status, dict):
                                status = proper.get(TEXT_STATUS)
                            exact_targets[(*base, occurrence)] = {
                                "text": isinstance(owner.get("text"), str),
                                "body": isinstance(owner.get("text"), str)
                                or (
                                    isinstance(status, dict)
                                    and status.get("state") == "unavailable"
                                    and status.get("scope") == "proper-body"
                                ),
                                "incipit": str(owner.get("incipit") or top_incipit),
                                "placeholder": proper_name == "Placeholder",
                            }

        positive_claims: set[tuple[str, str, str, str, int, str, str]] = set()
        positive_targets: set[tuple[str, str, str, str, int]] = set()

        def record_positive_target(
            where: str,
            entry: dict,
            target: tuple[str, str, str, str, int],
            *,
            exact_incipit: bool,
        ) -> None:
            live = exact_targets.get(target)
            if live is None:
                problems.append(f"{where}: translation target {target!r} does not exist")
                return
            if target in positive_targets:
                problems.append(
                    f"{where}: duplicate canonical translation target {target!r}"
                )
            positive_targets.add(target)
            if live.get("placeholder"):
                problems.append(
                    f"{where}: Placeholder is not a translatable source-owned Proper"
                )
            if not live.get("body"):
                problems.append(
                    f"{where}: translation target {target!r} owns no composed body "
                    "or typed removed-body state"
                )
            incipit = str(entry.get("incipit") or "")
            target_incipit = str(live.get("incipit") or "")
            # Legacy witnesses may preserve an incipit beside a target whose
            # index has not yet transcribed it; absence there is not a
            # contradiction.  An exact row deliberately opts into the stable
            # identity contract, so its recorded incipit remains strict.
            if (
                incipit
                and incipit != target_incipit
                and (exact_incipit or bool(target_incipit))
            ):
                problems.append(
                    f"{where}: incipit {incipit!r} does not match exact target "
                    f"{target_incipit!r}"
                )
            for translation in entry.get("translations") or []:
                if isinstance(translation, dict) and isinstance(
                    translation.get("lang"), str
                ):
                    positive_claims.add((*target, "body", translation["lang"]))

        for where, entry in active_entries:
            explicit = any(
                field in entry for field in ("form_id", "cycle", "occurrence")
            )
            if not explicit:
                mass = entry.get("mass")
                proper_name = entry.get("proper")
                if not isinstance(mass, str) or not mass.strip():
                    problems.append(f"{where}: mass must be a nonempty string")
                    continue
                if not isinstance(proper_name, str) or not proper_name.strip():
                    problems.append(f"{where}: proper must be a nonempty string")
                    continue
                raw_legacy_form = entry.get("form", "")
                if not isinstance(raw_legacy_form, str):
                    problems.append(f"{where}: legacy form must be a string")
                    continue
                legacy_form = raw_legacy_form
                form_id = legacy_form_ids.get(
                    (mass, legacy_form)
                )
                if form_id is None:
                    problems.append(
                        f"{where}: legacy translation form {legacy_form!r} does not "
                        f"exist on source mass {mass!r}"
                    )
                    continue
                base = (mass, form_id, proper_name, "all")
                if target_counts.get(base, 0) > 1:
                    problems.append(
                        f"{where}: legacy translation target {base!r} is ambiguous; "
                        "record form_id, cycle, and occurrence"
                    )
                    continue
                target = (*base, 1)
                record_positive_target(where, entry, target, exact_incipit=False)
                continue
            if not all(field in entry for field in ("form_id", "cycle", "occurrence")):
                problems.append(
                    f"{where}: stable translation identity requires form_id, cycle, "
                    "and occurrence together"
                )
                continue
            malformed = False
            for field in ("mass", "form_id", "proper", "cycle"):
                value = entry.get(field)
                if not isinstance(value, str) or not value.strip():
                    problems.append(f"{where}: {field} must be a nonempty string")
                    malformed = True
            cycle = entry.get("cycle")
            if isinstance(cycle, str) and cycle not in TRANSLATION_ABSENCE_CYCLES:
                problems.append(
                    f"{where}: cycle must be one of "
                    f"{sorted(TRANSLATION_ABSENCE_CYCLES)}, got {cycle!r}"
                )
                malformed = True
            occurrence = entry.get("occurrence")
            if (
                isinstance(occurrence, bool)
                or not isinstance(occurrence, int)
                or occurrence < 1
            ):
                problems.append(
                    f"{where}: occurrence must be a positive one-based integer, "
                    f"got {occurrence!r}"
                )
                malformed = True
            if malformed:
                continue
            if "form" in entry:
                display_form = entry.get("form")
                if not isinstance(display_form, str):
                    problems.append(
                        f"{where}: legacy form, when retained, must be a string"
                    )
                    continue
                resolved_form_id = legacy_form_ids.get(
                    (entry["mass"], display_form)
                )
                if (
                    (entry["mass"], "") in legacy_form_ids
                    and resolved_form_id != entry["form_id"]
                ):
                    problems.append(
                        f"{where}: retained form label {display_form!r} resolves to "
                        f"{resolved_form_id!r}, not form_id {entry['form_id']!r}"
                    )
                    continue
            target = (
                entry["mass"],
                entry["form_id"],
                entry["proper"],
                entry["cycle"],
                occurrence,
            )
            record_positive_target(where, entry, target, exact_incipit=True)

        unavailable = document.get("untranslated") or []
        if not isinstance(unavailable, list):
            problems.append(f"{sidecar}: untranslated must be an array of tables")
            unavailable = []
        unavailable_claims: set[tuple[str, str, str, str, int, str, str]] = set()
        duplicate_unavailable_claims: set[
            tuple[str, str, str, str, int, str, str]
        ] = set()
        required_unavailable_fields = {
            "mass",
            "proper",
            "form_id",
            "cycle",
            "occurrence",
            "extent",
            "lang",
            "availability",
            "reason",
            "note",
        }
        for index, row in enumerate(unavailable):
            where = f"{sidecar}: untranslated[{index}]"
            if not isinstance(row, dict):
                problems.append(f"{where}: entry is not a table")
                continue
            unknown_row = field_names(set(row) - TRANSLATION_UNAVAILABLE_FIELDS)
            if unknown_row:
                problems.append(
                    f"{where}: untranslated row has unknown fields: "
                    f"{', '.join(unknown_row)}"
                )
            missing = sorted(required_unavailable_fields - set(row))
            if missing:
                problems.append(
                    f"{where}: exact untranslated record is missing field(s) "
                    f"{', '.join(missing)}; legacy defaults are not accepted"
                )
            for field in ("mass", "proper"):
                value = row.get(field)
                if not isinstance(value, str) or not value.strip():
                    problems.append(f"{where}: {field} must be a nonempty string")
            availability = row.get("availability")
            if availability not in TRANSLATION_AVAILABILITY:
                problems.append(
                    f"{where}: availability must be one of "
                    f"{sorted(TRANSLATION_AVAILABILITY)}, got {availability!r}"
                )
            for field in ("form_id", "cycle", "extent", "lang"):
                value = row.get(field)
                if not isinstance(value, str) or not value.strip():
                    problems.append(f"{where}: {field} must be a nonempty string")
            form_id = row.get("form_id")
            cycle = row.get("cycle")
            extent = row.get("extent")
            occurrence = row.get("occurrence")
            if cycle not in TRANSLATION_ABSENCE_CYCLES:
                problems.append(
                    f"{where}: cycle must be one of "
                    f"{sorted(TRANSLATION_ABSENCE_CYCLES)}, got {cycle!r}"
                )
            if extent not in TRANSLATION_ABSENCE_EXTENTS:
                problems.append(
                    f"{where}: extent must be one of "
                    f"{sorted(TRANSLATION_ABSENCE_EXTENTS)}, got {extent!r}"
                )
            if (
                isinstance(occurrence, bool)
                or not isinstance(occurrence, int)
                or occurrence < 1
            ):
                problems.append(
                    f"{where}: occurrence must be a positive one-based integer, "
                    f"got {occurrence!r}"
                )
            if "text" in row:
                problems.append(f"{where}: an unavailable record must not carry text")
            antecedent_fields = set(row) & TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS
            if antecedent_fields and (
                antecedent_fields != TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS
            ):
                missing_antecedent = field_names(
                    TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS - antecedent_fields
                )
                problems.append(
                    f"{where}: antecedent metadata is an all-or-none bundle; missing "
                    f"{', '.join(missing_antecedent)}"
                )
            elif antecedent_fields:
                for field in (
                    "antecedent_calendar",
                    "antecedent_mass",
                    "antecedent_proper",
                ):
                    value = row.get(field)
                    if not isinstance(value, str) or not value.strip():
                        problems.append(f"{where}: {field} must be a nonempty string")
                if row.get("relation") != "revised":
                    problems.append(
                        f"{where}: an unavailable antecedent relation must be "
                        f"'revised', got {row.get('relation')!r}"
                    )
            if "form" in row:
                problems.append(
                    f"{where}: legacy form labels are forbidden; use source-authored form_id"
                )
            note = row.get("note")
            if not isinstance(note, str) or not note.strip():
                problems.append(f"{where}: note must be a nonempty audit explanation")
            if extent == "body" and "incipit" in row:
                problems.append(
                    f"{where}: extent 'body' must not carry incipit; incipit is "
                    "content and belongs only to extent 'incipit'"
                )
            if extent == "incipit":
                incipit = row.get("incipit")
                if not isinstance(incipit, str) or not incipit.strip():
                    problems.append(
                        f"{where}: extent 'incipit' requires a nonempty incipit"
                    )
            if row.get("lang") != "en":
                problems.append(
                    f"{where}: this English translation ledger requires lang = 'en', "
                    f"got {row.get('lang')!r}"
                )
            reason = row.get("reason")
            if not isinstance(reason, dict):
                problems.append(
                    f"{where}: reason must be a table with a typed kind, not prose"
                )
                reason = {}
            extras = field_names(set(reason) - TRANSLATION_ABSENCE_REASON_FIELDS)
            if extras:
                problems.append(
                    f"{where}: reason has unknown fields: {', '.join(extras)}"
                )
            kind = reason.get("kind")
            if kind not in TRANSLATION_ABSENCE_KINDS:
                problems.append(
                    f"{where}: reason.kind must be one of "
                    f"{sorted(TRANSLATION_ABSENCE_KINDS)}, got {kind!r}"
                )
            source_id = reason.get("source_id")
            if kind in {"rights-withheld", "witness-gap"}:
                if not isinstance(source_id, str) or not source_id.strip():
                    problems.append(
                        f"{where}: reason.kind {kind!r} requires source_id"
                    )
                else:
                    registered = source_ids()[0]
                    if registered is not None and source_id not in registered:
                        problems.append(
                            f"{where}: reason.source_id {source_id!r} is registered "
                            "nowhere in the source library"
                        )
            elif source_id is not None:
                problems.append(
                    f"{where}: reason.kind 'no-exemplar' cannot name source_id; "
                    "a source id would assert the exemplar the reason says is absent"
                )
            surfaces = reason.get("surfaces")
            if kind == "rights-withheld":
                if (
                    not isinstance(surfaces, list)
                    or not surfaces
                    or any(not isinstance(surface, str) for surface in surfaces)
                ):
                    problems.append(
                        f"{where}: reason.kind 'rights-withheld' requires a nonempty "
                        "surfaces list"
                    )
                else:
                    unknown = sorted(set(surfaces) - TRANSLATION_ABSENCE_SURFACES)
                    if unknown:
                        problems.append(
                            f"{where}: reason.surfaces has unknown values: "
                            f"{', '.join(unknown)}"
                        )
                    if len(surfaces) != len(set(surfaces)):
                        problems.append(f"{where}: reason.surfaces repeats a value")
            elif surfaces is not None:
                problems.append(
                    f"{where}: reason.surfaces applies only to rights-withheld"
                )
            problems.extend(untranslated_witness_problems(where, row))

            base_target = (
                str(row.get("mass") or ""),
                str(form_id or ""),
                str(row.get("proper") or ""),
                str(cycle or ""),
            )
            if isinstance(occurrence, int) and not isinstance(occurrence, bool):
                target = (*base_target, occurrence)
                live_target = exact_targets.get(target)
                if live_target is None:
                    available = target_counts.get(base_target, 0)
                    if available:
                        problems.append(
                            f"{where}: occurrence {occurrence} is out of range for "
                            f"target {base_target!r}; source order has "
                            f"{available} occurrence(s)"
                        )
                    else:
                        problems.append(
                            f"{where}: no source-owned proper has target "
                            f"{base_target!r}"
                        )
                else:
                    if live_target.get("placeholder"):
                        problems.append(
                            f"{where}: Placeholder is not a translatable source-owned "
                            "Proper and cannot be an untranslated target"
                        )
                    if extent == "body" and not live_target.get("body"):
                        problems.append(
                            f"{where}: target owns no body or proper-body unavailable state"
                        )
                    if extent == "incipit":
                        live_incipit = str(live_target.get("incipit") or "")
                        if not live_incipit:
                            problems.append(f"{where}: target owns no incipit")
                        elif row.get("incipit") != live_incipit:
                            problems.append(
                                f"{where}: incipit {row.get('incipit')!r} does not match "
                                f"the target's source incipit {live_incipit!r}"
                            )
                claim = (*target, str(extent or ""), str(row.get("lang") or ""))
                if claim in unavailable_claims:
                    duplicate_unavailable_claims.add(claim)
                unavailable_claims.add(claim)
        if duplicate_unavailable_claims:
            problems.append(
                f"{sidecar}: duplicate exact untranslated claims: "
                + ", ".join(
                    repr(target) for target in sorted(duplicate_unavailable_claims)
                )
            )
        positive_unavailable_collisions = positive_claims & unavailable_claims
        if positive_unavailable_collisions:
            problems.append(
                f"{sidecar}: exact targets cannot be both translated and unavailable: "
                + ", ".join(
                    repr(target)
                    for target in sorted(positive_unavailable_collisions)
                )
            )
        if agree or disagree:
            witnessed.append(
                {
                    # Named and not only counted: the count says the detector ran
                    # and the names say where to look, and `--json` is where a
                    # reader who wants the list rather than the figure goes.
                    "agree": len(agree),
                    "disagree": len(disagree),
                    "loci": sorted(disagree),
                    "read_twice": len(agree) + len(disagree),
                    # Repository-relative, as `files` is: the absolute form the
                    # problem messages carry would make this report differ
                    # between two checkouts of the same tree.
                    "source": (OVERLAY_DIR / sidecar.name).as_posix(),
                }
            )
    return problems, sorted(witnessed, key=lambda row: row["source"])


def citation_problems(
    root: Path, calendar: str | None
) -> tuple[list[str], list[str]]:
    """Delegate citation contents and its exact exceptions to their owner."""
    tool = Path(__file__).resolve().parent / "citations"
    if not tool.exists():
        return [f"{tool} is missing; cannot validate citation contents"], []
    scope = root / calendar if calendar else root
    result = subprocess.run(
        [sys.executable, str(tool), "check", "--root", str(scope), "--json"],
        capture_output=True,
        text=True,
    )
    stream = result.stdout.strip() or result.stderr.strip()
    if not stream:
        return [f"{tool} produced no output (exit {result.returncode})"], []
    try:
        payload = json.loads(stream)
    except json.JSONDecodeError:
        return [f"{tool} emitted unreadable output: {stream[:200]}"], []
    if payload.get("code"):
        return [f"{tool}: {payload.get('error')}"], []
    return (
        list(payload.get("problems") or []),
        list(payload.get("excepted") or []),
    )


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", type=Path, default=DEFAULT_ROOT)
    shared.add_argument("--calendar", help="limit to one calendar directory name")
    shared.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )
    parser = argparse.ArgumentParser(
        prog="check-calendar-masses",
        description=(
            "Validate the normalized YAML mass-proper indexes under "
            "src/sources/calendars."
        ),
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "check-calendar-masses")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="validate all calendars and propers", parents=[shared]),
        EXAMPLES["check"],
    )

    def dispatch(arguments):
        return run(arguments.root, arguments.calendar)

    def render(payload: object, arguments: argparse.Namespace) -> int:
        as_json = bool(getattr(arguments, "json", False))
        problems = payload.get("problems") if isinstance(payload, dict) else None
        if as_json:
            print_json(payload if isinstance(payload, dict) else {})
            return 1 if problems else 0
        if problems is None:
            print("calendar-mass error: invalid checker payload", file=sys.stderr)
            return 70
        # An excepted problem is still reported: it is a defect that is owed,
        # not one that has been settled.
        for excepted in payload.get("excepted") or []:
            print(f"calendar-mass excepted: {excepted}", file=sys.stderr)
        for problem in problems:
            print(f"calendar-mass error: {problem}", file=sys.stderr)
        for path, counts in payload.get("files", {}).items():
            print(f"{path}\t{counts['masses']} masses\t{counts['propers']} propers")
        for row in payload.get("witnesses") or []:
            print(
                f"{row['source']}\t{row['read_twice']} read twice"
                f"\t{row['agree']} agree\t{row['disagree']} disagree"
            )
        return 1 if problems else 0

    return run_verb_cli(
        parser=parser,
        handlers={"check": dispatch},
        renderer=render,
        prefix="check-calendar-masses",
        argv=argv,
        default_verb="check",
        dependency_message="install requirements-tools.txt",
    )


if __name__ == "__main__":
    raise SystemExit(main())
