# no key it did not already want. Four defects of that class landed in one day.
PROPER_FIELDS = frozenset(
    {"name", "source", "verses", "incipit", "text", "notes", "cycles",
     "takes_from", "psalm_numbering"}
)

SOURCES = ("scripture", "composed", "mixed")
CYCLES = ("A", "B", "C")
KINDS = ("christological", "marian", "sanctoral", "seasonal")
# The Commune Sanctorum is a section of formularies that no day owns. A Common
# is placed by use, not by the year: it has neither a season nor a date, and
# every other section's masses have exactly one of the two. Its masses are
# reached only by `takes_from`, which is why the section could not exist before
# the reference did.
COMMON_KIND = "common"
KEY_CHARS = set("abcdefghijklmnopqrstuvwxyz0123456789-")
DAYS_IN_MONTH = (31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31)
DATE_RE = re.compile(r"^(\d{2})-(\d{2})$")
# A commemoration written into another celebration's name - "Feast; comm. Saint"
# - is a second celebration with nowhere to live: it cannot be looked up, it
# cannot be commemorated on its own, and no page can show it as the second or
# third oration it is. An entry that *is* the commemoration names itself so from
# its first character, which is why only a later occurrence is refused. The
# abbreviation carries its printed period, so a name reading "In Commemoratione"
# is a title and not a fold.
FOLDED_COMMEMORATION = re.compile(r"\bcomm\.", re.IGNORECASE)


def check_reference(
    where: str, reference: object, problems: list[str], *, on_proper: bool
) -> None:
    """Shape only; `resolve_propers` owns whether the reference actually lands."""
    if not isinstance(reference, dict):
        problems.append(f"{where}: {TAKES_FROM} must be a mapping")
        return
    unknown = sorted(set(reference) - set(REFERENCE_FIELDS))
    if unknown:
        problems.append(
            f"{where}: {TAKES_FROM} carries unknown field(s) {', '.join(unknown)}; "
            f"it takes {', '.join(REFERENCE_FIELDS)}"
        )
    target = reference.get("mass")
    if not isinstance(target, str) or not target:
        problems.append(f"{where}: {TAKES_FROM} needs the key of the mass it takes from")
    if not on_proper and "proper" in reference:
        problems.append(
            f"{where}: {TAKES_FROM} on a mass takes the whole formulary; name a "
            "single proper on the proper that takes it"
        )


def check_proper(where: str, proper: object, problems: list[str]) -> None:
    if not isinstance(proper, dict):
        problems.append(f"{where}: proper is not a mapping")
        return
    name = proper.get("name")
    if not isinstance(name, str) or not name:
        problems.append(f"{where}: proper has no name")
        return
    where = f"{where}/{name}"
    unknown = sorted(set(proper) - PROPER_FIELDS)
    if unknown:
        problems.append(
            f"{where}: unrecognised field(s) {', '.join(repr(k) for k in unknown)}; "
            "an unquoted scalar carrying a colon becomes a key of its own"
        )
    if TAKES_FROM in proper:
        # A proper that names where its text is printed holds none of its own.
        # Its incipit and translations come from the resolved proper too, so a
        # second copy of either here is the restatement the key exists to stop.
        carried = [field for field in REFERENCE_EXCLUDES if field in proper]
        if carried:
            problems.append(
                f"{where}: a proper taking its text from elsewhere must not also "
                f"carry {', '.join(carried)}"
            )
        check_reference(where, proper[TAKES_FROM], problems, on_proper=True)
        return
    source = proper.get("source")
    cycles = proper.get("cycles")
    # A cycle-varying proper may differ in kind between cycles — an acclamation
    # composed in one year and scriptural in another — so each cycle may carry
    # its own source instead of one at the top.
    if cycles is not None:
        if source is not None and source not in SOURCES:
            problems.append(f"{where}: source must be one of {SOURCES}, got {source!r}")
        if not isinstance(cycles, dict) or not cycles:
            problems.append(f"{where}: cycles must be a nonempty mapping")
            return
        for cycle, value in cycles.items():
            if cycle not in CYCLES:
                problems.append(f"{where}: unknown cycle key {cycle!r}")
                continue
            if not isinstance(value, dict):
                problems.append(f"{where}/{cycle}: cycle must be a mapping")
                continue
            effective = value.get("source", source)
            if effective not in SOURCES:
                problems.append(
                    f"{where}/{cycle}: no source, and the proper declares none"
                )
                continue
            if effective == "scripture" and "verses" not in value:
                problems.append(f"{where}/{cycle}: scripture cycle has no verses")
            elif effective == "composed" and "text" not in value:
                problems.append(f"{where}/{cycle}: composed cycle has no text")
            elif effective == "mixed" and not ("verses" in value and "text" in value):
                problems.append(f"{where}/{cycle}: mixed cycle needs verses and text")
        if "verses" in proper or "text" in proper:
            problems.append(f"{where}: cycles excludes top-level verses and text")
        return
    if source not in SOURCES:
        problems.append(f"{where}: source must be one of {SOURCES}, got {source!r}")
        return
    if source == "scripture":
        if "verses" not in proper:
            problems.append(f"{where}: scripture proper has no verses")
        if "text" in proper:
            problems.append(f"{where}: scripture proper must not carry text")
    elif source == "composed":
        if "text" not in proper:
            problems.append(f"{where}: composed proper has no text")
        if "verses" in proper:
            problems.append(f"{where}: composed proper must not carry verses")
    elif "verses" not in proper or "text" not in proper:
        problems.append(f"{where}: mixed proper needs both verses and text")
    check_verses(where, proper.get("verses"), problems)
    check_translations(where, proper, problems)


def check_translations(where: str, proper: dict, problems: list[str]) -> None:
    """A proper's translations, and the Latin they answer."""
    payload = proper.get("translations")
    if payload is None:
        return
    if "text" not in proper:
        problems.append(f"{where}: translations require a text to translate")
    check_translation_list(where, payload, problems)


def check_translation_list(where: str, payload: object, problems: list[str]) -> None:
    """A translation is someone's expression; it carries its own rights basis.

    Liturgical translations are not relicensed by inclusion, so each one names
    the edition it came from and the basis on which it is carried.

    Two English translations of one oration are the feature and not the fault.
    Offering a choice is only worth a control because translations differ, and
    the difference is also the detector: the two independent transcriptions of
    the 1861 Cummiskey missal in this repository disagreed at 45 of the 153
    orations they share, and every one of the 38 errors the site was serving sat
    inside those 45 — where they agreed, they were right 54 times out of 54. So
    what must not repeat is the *witness*, not the language, and uniqueness is
    keyed `(lang, source_id)`.

    A translation carrying no `source_id` is the one case where the language
    still stands alone, because nothing else tells two of them apart. Only a
    `project-created` translation may omit it, so the effect is that the project
    speaks once per language and every quoted witness speaks under its own name.
    """
    if not isinstance(payload, list) or not payload:
        problems.append(f"{where}: translations must be a nonempty list")
        return
    # A library that cannot be read is reported once by `run`, not once per
    # proper: the same defect repeated 1,475 times is a defect nobody reads.
    registered = source_ids()[0]
    seen: set[tuple[str, str | None]] = set()
    for index, entry in enumerate(payload):
        label = f"{where}.translations[{index}]"
        if not isinstance(entry, dict):
            problems.append(f"{label}: must be a mapping")
            continue
        for field in ("lang", "text", "rights"):
            value = entry.get(field)
            if not isinstance(value, str) or not value.strip():
                problems.append(f"{label}: {field} must be a nonempty string")
        rights = entry.get("rights")
        if isinstance(rights, str) and rights not in TRANSLATION_RIGHTS:
            problems.append(
                f"{label}: rights must be one of {sorted(TRANSLATION_RIGHTS)}, got {rights!r}"
            )
        source_id = entry.get("source_id")
        if rights in {"licensed", "public-domain"} and not source_id:
            problems.append(f"{label}: {rights} translation must name its source_id")
        if rights == "licensed" and not entry.get("notice"):
            problems.append(f"{label}: licensed translation must carry its required notice")
        if source_id is not None and not isinstance(source_id, str):
            problems.append(f"{label}: source_id must be a string, got {source_id!r}")
            source_id = None
        # An id that names nothing is worse than no id at all: it reads as
        # provenance and answers no question, and it is now load-bearing, since
        # it is what tells two translations of one prayer apart.
        if isinstance(source_id, str) and registered is not None:
            if source_id not in registered:
                problems.append(
                    f"{label}: source_id {source_id!r} is registered nowhere in "
                    "the source library"
                )
        lang = entry.get("lang")
        if isinstance(lang, str):
            key = (lang, source_id if isinstance(source_id, str) else None)
            if key in seen:
                problems.append(
                    f"{label}: duplicate translation {lang!r} from "
                    f"{source_id!r}; one witness speaks once per proper"
                    if key[1]
                    else f"{label}: a second {lang!r} translation names no "
                    "source_id, so nothing tells it from the first"
                )
            seen.add(key)


# Resolved once per process and cached, because loading the source graph costs
# well over a second and a calendar makes thousands of translation entries.
_SOURCE_IDS: tuple[set[str] | None, str | None] | None = None


def source_ids() -> tuple[set[str] | None, str | None]:
    """Every id the source library registers, and why it could not be read.

    Taken from the tool that owns the source graph rather than re-globbed here,
    so that this check and `source-library validate` cannot come to disagree
    about what is registered. Loaded lazily: a calendar carrying no translations
    never pays for it.

    Only the record ids are used, not the library's own verdict. Whether the
    graph is internally sound is `check-sources`' question, and answering it
    twice would report one defect under two names.
    """
    global _SOURCE_IDS
    if _SOURCE_IDS is None:
        try:
            module = sibling("source-library")
            library = module.load_library(
                Path(__file__).resolve().parents[1], check_binding_fingerprints=False
            )
            _SOURCE_IDS = (set(library.records), None)
        except Exception as error:  # the tool is a sibling script, not an API
            _SOURCE_IDS = (
                None,
                f"cannot read the source library to resolve translation "
                f"source ids: {error}",
            )
    return _SOURCE_IDS


def check_verses(where: str, verses: object, problems: list[str]) -> None:
    """`verses` holds encoded passages; citations owns their contents."""
    if verses is None:
        return
    if not isinstance(verses, list) or not verses:
        problems.append(f"{where}: verses must be a nonempty list")


def check_date(where: str, value: object, problems: list[str]) -> None:
    """A sanctoral date is a quoted MM-DD; February allows the 29th."""
    if not isinstance(value, str):
        problems.append(f"{where}: date must be a quoted MM-DD string, got {value!r}")
        return
    found = DATE_RE.match(value)
    if not found:
        problems.append(f"{where}: date must read MM-DD, got {value!r}")
        return
    month, day = int(found.group(1)), int(found.group(2))
    if not 1 <= month <= 12:
        problems.append(f"{where}: month out of range in {value!r}")
    elif not 1 <= day <= DAYS_IN_MONTH[month - 1]:
        problems.append(f"{where}: day out of range in {value!r}")


def check_name(where: str, name: object, problems: list[str]) -> None:
    """Refuse a name that folds a commemoration into another celebration."""
    if not isinstance(name, str):
        return
    for found in FOLDED_COMMEMORATION.finditer(name):
        if found.start() == 0:
            continue
        problems.append(
            f"{where}: the name folds a commemoration in at "
            f"{name[found.start():]!r}; record it as its own dated entry with "
            "rank 'Comm.' instead"
        )
        return


def iter_masses(document: dict) -> list[tuple[str, dict]]:
    """Yield every mass from the calendar's one canonical container.

    `sections` is the single source; the mass list is not duplicated elsewhere,
    and `check-calendar-masses` fails a file that reintroduces a top-level one.
    """
    out = []
    for _, body in sorted((document.get("sections") or {}).items()):
        if isinstance(body, dict):
            kind = str(body.get("kind") or "")
            out.extend(
                (kind, m) for m in (body.get("masses") or []) if isinstance(m, dict)
            )
    return out


def check_entry(
    entry: object, index: int, problems: list[str], section_kind: str = ""
) -> str | None:
    where = f"mass[{index}]"
    if not isinstance(entry, dict):
        problems.append(f"{where}: entry is not a mapping")
        return None
    for field in ENTRY_REQUIRED:
        if field not in entry:
            problems.append(f"{where}: missing {field}")
    key = entry.get("key")
    if isinstance(key, str) and key:
        where = f"mass[{index}] {key}"
        if set(key) - KEY_CHARS:
            problems.append(f"{where}: key must be lowercase kebab-case")
    else:
        key = None
    check_name(where, entry.get("name"), problems)
    registry = entry.get("registry")
    if registry is not None and not isinstance(registry, str):
        problems.append(f"{where}: registry must be a quoted string, got {registry!r}")
    # A seasonal entry is placed by season, and a dated entry is sanctoral.
    has_season = "season" in entry
    has_date = "date" in entry
    if section_kind == COMMON_KIND:
        # A Common is a formulary, not a day. It is placed by use.
        if has_season or has_date:
            problems.append(
                f"{where}: a mass of the Commune Sanctorum carries neither a "
                "season nor a date; it is placed by the masses that take it"
            )
    elif has_season == has_date:
        problems.append(f"{where}: exactly one of season or date is required")
    if has_date:
        check_date(where, entry["date"], problems)
        kind = entry.get("kind")
        if kind not in KINDS:
            problems.append(f"{where}: kind must be one of {KINDS}, got {kind!r}")
        if not entry.get("rank"):
            problems.append(f"{where}: a dated entry needs the edition's printed rank")
    has_propers = "propers" in entry
    has_forms = "forms" in entry
    takes_from = TAKES_FROM in entry
    if takes_from:
        # A mass that takes another formulary may still print propers of its
        # own: that is what a third-class saint is - the Mass of the Common
        # with a Collect of the saint - and it is the whole point of the key.
        # Forms are the one thing it cannot also carry, because a mass printed
        # in forms is a mass with more than one formulary and the reference
        # would not say which of them the borrowing applies to.
        check_reference(where, entry[TAKES_FROM], problems, on_proper=False)
        if has_forms:
            problems.append(
                f"{where}: a mass taking another formulary must not also carry forms"
            )
    elif has_propers == has_forms:
        problems.append(
            f"{where}: exactly one of propers, forms or {TAKES_FROM} is required"
        )
    if has_propers:
        propers = entry["propers"]
        if not isinstance(propers, list) or not propers:
            problems.append(f"{where}: propers must be a nonempty list")
        else:
            for proper in propers:
                check_proper(where, proper, problems)
    if has_forms:
        forms = entry["forms"]
        if not isinstance(forms, list) or not forms:
            problems.append(f"{where}: forms must be a nonempty list")
        else:
            for form in forms:
                if not isinstance(form, dict) or not form.get("name"):
                    problems.append(f"{where}: form has no name")
                    continue
                inner = form.get("propers")
                if not isinstance(inner, list) or not inner:
                    problems.append(
                        f"{where}/{form['name']}: propers must be a nonempty list"
                    )
                    continue
                for proper in inner:
                    check_proper(f"{where}/{form['name']}", proper, problems)
    return key


def count_propers(entry: object) -> int:
    if not isinstance(entry, dict):
        return 0
    total = 0
    if isinstance(entry.get("propers"), list):
        total += len(entry["propers"])
    for form in entry.get("forms") or []:
        if isinstance(form, dict) and isinstance(form.get("propers"), list):
            total += len(form["propers"])
    return total


def check_file(path: Path, problems: list[str]) -> dict[str, int]:
    import yaml

    try:
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError) as error:
        problems.append(f"{path}: unreadable: {error}")
        return {"masses": 0, "propers": 0}
    if not isinstance(document, dict):
        problems.append(f"{path}: top level must be a mapping")
        return {"masses": 0, "propers": 0}
    for field in REQUIRED_HEADER:
        if field not in document:
            problems.append(f"{path}: missing header field {field}")
    numbering = document.get("psalm_numbering")
    if numbering not in PSALM_NUMBERING:
        problems.append(
            f"{path}: psalm_numbering must be one of {sorted(PSALM_NUMBERING)}, "
            f"got {numbering!r}"
        )
    if document.get("schema") != SCHEMA:
        problems.append(
            f"{path}: schema must be {SCHEMA!r}, got {document.get('schema')!r}"
        )
    if "masses" in document:
        problems.append(
            f"{path}: the mass list is canonical under sections; a top-level "
            "masses key duplicates it"
        )
    masses = iter_masses(document)
    if not masses:
        problems.append(f"{path}: sections must contain at least one mass")
        return {"masses": 0, "propers": 0}
    keys: list[str] = []
    for index, (section_kind, entry) in enumerate(masses):
        scoped: list[str] = []
        key = check_entry(entry, index, scoped, section_kind)
        problems.extend(f"{path}: {problem}" for problem in scoped)
        if key:
            keys.append(key)
    duplicates = sorted({key for key in keys if keys.count(key) > 1})
    if duplicates:
        problems.append(f"{path}: duplicate mass keys: {', '.join(duplicates)}")
    # Shape is not landing. `check_entry` proves a reference is well formed;
    # only resolving it proves the mass, form and proper it names exist and
    # that the chain terminates. Both this check and the browser's structure
    # read that from `resolve_propers`, so neither can drift from the other.
    for _, entry in masses:
        _, trouble = resolve_propers(document, entry)
        problems.extend(f"{path}: {problem}" for problem in dict.fromkeys(trouble))
    return {
        "masses": len(masses),
        "propers": sum(count_propers(entry) for _, entry in masses),
    }


def run(root: Path, calendar: str | None) -> dict[str, object]:
    # Discovery is by declared schema, not by extension: a calendar directory
    # may hold a source another tool owns, and reading it as a mass index is how
    # this check first went red for a file that was never its business. The
    # partition is shared with `citations` so the two cannot disagree about what
    # a calendar directory contains.
    paths, companions, problems = partition(root, calendar)
    if not paths:
        scope = f" for calendar {calendar!r}" if calendar else ""
        raise ValueError(f"no calendar index found under {root}{scope}")
    files = {
        path.as_posix(): check_file(path, problems)
        for path in paths
    }
    # A recension states departures, not a book. Its rows are checked against the
    # base they depart from: guidance/recensions.md section 6 item 2 asks for a
    # check that fails when a recension's base does not exist and when a
    # departure names a mass the base does not hold. That second case is worse
    # than a broken link, because a departure resolving to nothing REMOVES a Mass
    # from the served calendar instead of adding a dangling pointer to it.
    for path in paths:
        problems.extend(recension_problems(root, path.parent.name))
    problems.extend(citation_problems(root, calendar))
    problems.extend(spine_problems(paths))
    # A rubric appointing one text across a range of days is stated in the
    # calendar's rubrics and carried by its masses, and nothing joined the two.
    # Both halves failed silently: eleven of the twelve days inside the Easter
    # and Pentecost octaves showed no Sequence, and the only statement that one
    # was appointed there was an English sentence in a `notes` string.
    problems.extend(span_problems(paths))
    problems.extend(overlay_problems(paths))
    # The index names the book; a companion beside it must not name it again.
    # `edition` was hand-typed in both files of both calendar directories, four
    # copies of two strings, and nothing here compared them.
    problems.extend(restated_identity(root, calendar))
    # Reported here and once: the cache is populated only if some translation
    # actually asked for it, so a calendar with none never raises it at all.
    unreadable = (_SOURCE_IDS or (None, None))[1]
    if unreadable:
        problems.append(unreadable)
    problems, excepted = apply_psalm_exceptions(paths, problems)
    return {
        "excepted": excepted,
        "files": files,
        # Named rather than counted, so a reader can see which files this check
        # did not look at and which tool is supposed to.
        "held_by_other_tools": companions,
        "problems": problems,
        "status": "error" if problems else "ok",
    }


def sibling(name: str):
    """Load a sibling tool as a module rather than restating what it decides.

    The module is registered in `sys.modules` before it is executed. A tool that
    declares a dataclass cannot be executed otherwise: `dataclasses` resolves a
    field's annotation through whatever `sys.modules` holds for the class's
    `__module__`, and finds nothing there for a module loaded without one.
    """
    path = Path(__file__).resolve().parent / name
    loader = SourceFileLoader(f"_{name.replace('-', '_')}", str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:  # pragma: no cover - a broken checkout, not a code path
        raise ValueError(f"cannot load {path}")
    module = module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module


def act_history() -> tuple[dict, dict, set, str]:
    """The acts and witnesses the act history carries, and the kinds it uses.

    Read through `act-history`'s own loader, which resolves `extends` so the
    wider slice is read on top of the narrower one instead of beside it. Parsing
    the two files here would be the second copy that file's own header refuses.

    Returns the acts by id, the witnesses by id, the `attests_kind` values its
    witnesses actually use, and an empty string, or four empty values and the
    reason the history could not be read.
    """
    path = Path(__file__).resolve().parents[1] / ACTS_SOURCE
    if not path.is_file():
        return {}, {}, set(), f"{path} is missing; no source can be held to it"
    try:
        history = sibling("act-history").load(path)
    except Exception as error:  # the loader raises its own Problem type
        return {}, {}, set(), f"{path}: cannot read the act history: {error}"
    acts = {
        str(row.get("id") or ""): row
        for row in history.get("acts") or []
        if isinstance(row, dict)
    }
    witnesses = {
        str(row.get("id") or ""): row
        for row in history.get("witnesses") or []
        if isinstance(row, dict)
    }
    kinds = {
        str(row.get(OVERLAY_ATTESTS_KIND))
        for row in witnesses.values()
        if row.get(OVERLAY_ATTESTS_KIND)
    }
    return acts, witnesses, kinds, ""


def source_attestation_problems(where: str, row: dict, history: tuple) -> list[str]:
    """Every way a sidecar's witness fails to say which rite it witnesses.

    A `[[sources]]` row is a BOOK, and the one thing a reader needs to know about
    a book quoted into a calendar is which state of the rite it prints. Both
    books in the 1962 sidecar are pre-1955 hand missals and said so only in
    `caution` prose; a page serving their English under a 1962 heading had
    nothing machine-readable to say otherwise, and 176 collations were run
    against one of them under that heading.

    The project's own composed English is exempt and named as such. A row with no
    `source_id` is the project as its own witness -- the case `mass-propers`
    already admits by presence rather than truth -- and it witnesses no printing,
    so an act edge for it would be an invention rather than a record.
    """
    acts, witnesses, kinds, trouble = history
    if "source_id" in row and not str(row.get("source_id") or "").strip():
        return []
    problems = [
        f"{where}: states no {field}. A witness quoted into a calendar says which "
        "state of the rite it prints, in the act history's vocabulary, or the "
        "claim lives in prose nothing reads."
        for field in OVERLAY_ATTESTS_FIELDS
        if not str(row.get(field) or "").strip()
    ]
    if problems:
        return problems
    if trouble:
        return [f"{where}: {trouble}"]
    attests = str(row[OVERLAY_ATTESTS]).strip()
    kind = str(row[OVERLAY_ATTESTS_KIND]).strip()
    if attests != ACTS_UNESTABLISHED and attests not in acts:
        problems.append(
            f"{where}: {OVERLAY_ATTESTS} names {attests!r}, which the act history "
            f"does not carry. An edge to an act nobody recorded resolves to nothing; "
            f"say {ACTS_UNESTABLISHED!r} where the state cannot be established."
        )
    if kind not in kinds:
        problems.append(
            f"{where}: {OVERLAY_ATTESTS_KIND} is {kind!r}, which no witness in the "
            f"act history uses. It is one of: {', '.join(sorted(kinds))}."
        )
    # The same book in two files is a prediction that the two will differ. Held
    # to agree, it is a checked restatement instead.
    held = witnesses.get(str(row.get("id") or ""))
    if held:
        for field in (OVERLAY_ATTESTS, OVERLAY_ATTESTS_KIND):
            theirs = str(held.get(field) or "").strip()
            if theirs and theirs != str(row.get(field) or "").strip():
                problems.append(
                    f"{where}: {field} is {str(row.get(field))!r} and the act "
                    f"history records {theirs!r} for the same witness; one book "
                    "does not attest two states."
                )
    return problems


def calendar_spine():
    """The tool that owns the spine, rather than a second parse of it.

    The spine is derived from the calendar-reference publications, which is a
    different source from the mass indexes; restating that derivation here is
    how the two would come to disagree about what a calendar contains.
    """
    return sibling("calendar-spine")


def spine_problems(paths: list[Path]) -> list[str]:
    """Every celebration the spine carries must have a mass, filed as it says.

    The spine is the identity and ordering source for the sanctoral, so a date
    it lists and the propers do not is a hole, and a date the two file
    differently is a disagreement about what kind of celebration it is. Nothing
    compared them before, which is how three days of the Christmas octave came
    to sit in the spine and in no section at all.

    Only calendars the spine knows are checked; a calendar it has no reference
    publication for is out of its scope, not in breach of it.
    """
    import yaml

    try:
        tool = calendar_spine()
    except (OSError, ValueError) as error:
        return [f"cannot load the calendar spine: {error}"]
    problems: list[str] = []
    for path in paths:
        name = path.parent.name
        if name not in tool.SOURCES:
            continue
        try:
            entries = tool.spine(name)
        except (OSError, ValueError) as error:
            problems.append(f"{path}: cannot derive the spine: {error}")
            continue
        try:
            document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError):
            continue  # already reported by check_file
        if not isinstance(document, dict):
            continue
        filed: dict[str, str] = {}
        for section in (document.get("sections") or {}).values():
            if not isinstance(section, dict):
                continue
            kind = section.get("kind")
            for mass in section.get("masses") or []:
                if isinstance(mass, dict) and mass.get("registry") is not None:
                    filed[str(mass["registry"])] = str(kind)
        for entry in entries:
            registry = str(entry["registry"])
            if registry not in filed:
                problems.append(
                    f"{path}: the spine carries {registry} ({entry['title']}) "
                    "and no section has a mass for it"
                )
            elif filed[registry] != entry["kind"]:
                problems.append(
                    f"{path}: {registry} ({entry['title']}) is filed "
                    f"{filed[registry]} but the spine classifies it {entry['kind']}"
                )
    return problems


def _span_shape(where: str, span: dict, problems: list[str]) -> bool:
    """The row itself, before anything is looked up. True if it is worth joining."""
    unknown = sorted(set(span) - SPAN_FIELDS)
    if unknown:
        problems.append(
            f"{where}: unrecognised field(s) {', '.join(repr(k) for k in unknown)}; "
            f"a span carries {', '.join(sorted(SPAN_FIELDS))}"
        )
    # `before` is the only one of the three the join cannot proceed without; a
    # row missing its label or its note is still a row that can be checked.
    sound = True
    for field in ("label", "before", "note"):
        if not str(span.get(field) or "").strip():
            problems.append(f"{where}: a span states its {field}")
            if field == "before":
                sound = False
    prints = span.get(SPAN_PRINTS)
    if not isinstance(prints, dict):
        problems.append(f"{where}: {SPAN_PRINTS} names the mass and proper the text is written at")
        sound = False
    else:
        strange = sorted(set(prints) - SPAN_PRINTS_FIELDS)
        if strange:
            problems.append(
                f"{where}: {SPAN_PRINTS} carries unknown field(s) {', '.join(strange)}; "
                f"it takes {', '.join(sorted(SPAN_PRINTS_FIELDS))}"
            )
        for field in sorted(SPAN_PRINTS_FIELDS):
            if not isinstance(prints.get(field), str) or not prints[field]:
                problems.append(f"{where}: {SPAN_PRINTS} needs a {field}")
                sound = False
    keys = span.get("keys")
    if not isinstance(keys, list) or not keys or not all(
        isinstance(key, str) and key for key in keys
    ):
        problems.append(f"{where}: keys is the nonempty list of masses the text is appointed on")
        sound = False
    elif len(set(keys)) != len(keys):
        problems.append(f"{where}: keys names a mass twice; a mass is appointed the text once")
    # A span's authority and its evidence are checked together, because the one
    # failure this file cannot tolerate is a citation nobody read. `stated` says
    # the rubric was read; `locus` says where. Neither may stand without the
    # other, and the rubric's own words may not be quoted from nowhere.
    stated = span.get(SPAN_STATED)
    locus = span.get(SPAN_LOCUS)
    if not isinstance(stated, bool):
        problems.append(f"{where}: {SPAN_STATED} is true or false; a span says whether the rubric was read")
    elif stated and not str(locus or "").strip():
        problems.append(
            f"{where}: {SPAN_STATED} is true and {SPAN_LOCUS} is empty; a rubric read "
            "from a witness says where it was read"
        )
    elif not stated:
        if locus is not None:
            problems.append(
                f"{where}: {SPAN_STATED} is false and {SPAN_LOCUS} is {locus!r}; a span "
                f"nobody has read carries {SPAN_LOCUS}: null and says so in its note"
            )
        if "latin" in span:
            problems.append(
                f"{where}: {SPAN_STATED} is false and the row quotes the rubric's own "
                "words; a quotation with no locus is a quotation from nowhere"
            )
    if "latin" in span and not str(span.get("latin") or "").strip():
        problems.append(f"{where}: latin is the rubric's own words, or is absent")
    return sound


def _by_form(entries: list[tuple[str, dict, dict | None]]) -> dict[str, list[tuple[dict, dict | None]]]:
    """Resolved propers grouped by the form they stand in, in printed order.

    A Mass printed in two forms says the day twice, so a text appointed on the
    day is appointed in each of them. Grouping is what lets the join say that:
    the Ember Saturday of the Pentecost octave prints a longer and a shorter
    Mass, and a Sequence supplied to only one of them is missing from the Mass
    that is actually said whenever the other is chosen.
    """
    grouped: dict[str, list[tuple[dict, dict | None]]] = {}
    for label, proper, provenance in entries:
        grouped.setdefault(label, []).append((proper, provenance))
    return grouped


def _span_join(
    where: str,
    span: dict,
    document: dict,
    index: dict[str, dict],
    problems: list[str],
) -> None:
    prints = span[SPAN_PRINTS]
    home, wanted, before = prints["mass"], prints["proper"], str(span["before"])
    label = str(span.get("label") or span.get("id") or "")
    keys = [str(key) for key in span["keys"]]
    if home in keys:
        problems.append(
            f"{where}: keys names {home!r}, which is where the text is written; "
            "keys lists the masses that take it"
        )
    for key in (home, *keys):
        mass = index.get(key)
        if mass is None:
            problems.append(f"{where}: names mass {key!r}, which this calendar has no entry for")
            continue
        # Trouble from the reference itself is `check_file`'s to report; this
        # join reads the same resolution and says only what the span asks of it.
        entries, _ = resolve_propers(document, mass)
        for form, resolved in sorted(_by_form(entries).items()):
            at = f"{where}: {key}" + (f"/{form}" if form else "")
            names = [str(proper.get("name")) for proper, _ in resolved]
            found = [n for n, name in enumerate(names) if name == wanted]
            if not found:
                problems.append(
                    f"{at}: appoints no {wanted!r}, and {label} appoints it there. "
                    f"Take it by {TAKES_FROM} from {home!r}; do not write the text again."
                )
                continue
            for position in found:
                # An empty provenance is a proper the mass prints itself, which
                # is right at `home` and is the forbidden copy anywhere else.
                taken = str((resolved[position][1] or {}).get("mass") or "")
                if key != home and not taken:
                    problems.append(
                        f"{at}: prints its own {wanted!r}, and {label} appoints the one "
                        f"{home!r} prints. One text appointed across a span is written "
                        f"once and taken by {TAKES_FROM}; a second copy is a second "
                        "reading waiting to disagree."
                    )
                elif key != home and taken != home:
                    problems.append(
                        f"{at}: takes its {wanted!r} from {taken!r}, and {label} appoints "
                        f"the one {home!r} prints"
                    )
                if before not in names:
                    problems.append(
                        f"{at}: appoints no {before!r} for {wanted!r} to stand before"
                    )
                elif names.index(before) != position + 1:
                    problems.append(
                        f"{at}: prints {wanted!r} at position {position + 1} of "
                        f"{len(names)}, and {label} stands immediately before {before!r}"
                    )


def span_problems(paths: list[Path]) -> list[str]:
    """Every way a text appointed across a span of days fails to reach one.

    A rubric that appoints one text on a range of days is stated in the
    calendar's `rubrics.yaml` and carried by the masses through `takes_from`.
    Nothing joined the two, so both halves could fail silently and both did: the
    Easter span existed only as an English sentence in a `notes` string, which
    no tool reads and no check tests, and eleven of the twelve days inside the
    two octaves showed no Sequence at all while claiming to show the Mass.

    Two failures this reports have never been reportable here. A mass the span
    names that appoints no proper of that name is the hole. A mass that PRINTS
    the text instead of referencing it is the copy the rule forbids, and it was
    undetectable: `check_entry` enumerates no unknown fields on a mass, so a key
    invented to say this would have been ignored by every tool in the
    repository, and a retyped Sequence would simply have looked like a mass with
    one more proper.

    Only calendars that state spans are checked. A calendar with no
    `rubrics.yaml`, or one whose rubrics state none, is outside this rule rather
    than in breach of it.
    """
    import yaml

    problems: list[str] = []
    for path in paths:
        source = path.parent / SPANS_SOURCE
        if not source.is_file():
            continue
        try:
            rubrics = yaml.safe_load(source.read_text(encoding="utf-8"))
            document = yaml.safe_load(path.read_text(encoding="utf-8"))
        except (OSError, yaml.YAMLError) as error:
            problems.append(f"{source}: unreadable: {error}")
            continue
        if not isinstance(rubrics, dict) or not isinstance(document, dict):
            continue
        index = mass_index(document)
        seen: set[str] = set()
        for position, span in enumerate(spans_of(rubrics)):
            identifier = str(span.get("id") or "")
            where = f"{source}: {APPOINTED_ACROSS}[{identifier or position}]"
            if not identifier:
                problems.append(f"{where}: a span states its id")
            elif identifier in seen:
                problems.append(f"{where}: stated twice; a span has one row")
            seen.add(identifier)
            if _span_shape(where, span, problems):
                _span_join(where, span, document, index, problems)
    return problems


def overlay_problems(paths: list[Path]) -> list[str]:
    """Hold the translation sidecars to the same rules as an inline translation.

    A calendar's `translations` belong inside each proper and are recorded in
    `src/sources/inventories/<calendar>-proper-translations-v1.toml` only until
    the file that owns them can take them. That sidecar is what `mass-propers`
    reads and therefore what the site serves, so leaving it unvalidated made
    every rule above ceremonial: no calendar index carries an inline
    translation, and all 160 real ones sat in a file nothing checked.

    Keyed off the calendar directories actually being checked, so a temporary
    root with no sidecar beside it validates nothing rather than reaching into
    the repository behind the caller's back.

    `[[sources]]` was checked by nothing at all until the attestation gate below,
    which is the sharper form of the same defect the docstring above describes:
    the rules applied to the translations and left the record of WHICH BOOK they
    came out of entirely unread.
    """
    import tomllib

    root = Path(__file__).resolve().parents[1] / OVERLAY_DIR
    problems: list[str] = []
    history: tuple | None = None
    for path in paths:
        sidecar = root / f"{path.parent.name}{OVERLAY_SUFFIX}"
        if not sidecar.is_file():
            continue
        try:
            document = tomllib.loads(sidecar.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as error:
            problems.append(f"{sidecar}: unreadable: {error}")
            continue
        # Loaded once, and only where a sidecar was actually found.
        if history is None:
            history = act_history()
        for index, row in enumerate(document.get("sources") or []):
            if not isinstance(row, dict):
                problems.append(f"{sidecar}: sources[{index}] is not a table")
                continue
            named = str(row.get("id") or "") or f"sources[{index}]"
            problems.extend(
                source_attestation_problems(f"{sidecar}: {named}", row, history)
            )
        for index, entry in enumerate(document.get("entries") or []):
            where = f"{sidecar}: entries[{index}]"
            if not isinstance(entry, dict):
                problems.append(f"{where}: entry is not a table")
                continue
            named = " ".join(
                str(entry.get(field) or "")
                for field in ("mass", "form", "proper")
                if entry.get(field)
            )
            where = f"{sidecar}: {named or f'entries[{index}]'}"
            payload = entry.get("translations")
            if payload is None:
                problems.append(f"{where}: entry records no translations")
                continue
            check_translation_list(where, payload, problems)
    return problems


def citation_problems(root: Path, calendar: str | None) -> list[str]:
    """Delegate citation contents to the sibling tool that owns the canon."""
    tool = Path(__file__).resolve().parent / "citations"
    if not tool.exists():
        return [f"{tool} is missing; cannot validate citation contents"]
    scope = root / calendar if calendar else root
    result = subprocess.run(
        [sys.executable, str(tool), "check", "--root", str(scope), "--json"],
        capture_output=True,
        text=True,
    )
    stream = result.stdout.strip() or result.stderr.strip()
    if not stream:
        return [f"{tool} produced no output (exit {result.returncode})"]
    try:
        payload = json.loads(stream)
    except json.JSONDecodeError:
        return [f"{tool} emitted unreadable output: {stream[:200]}"]
    if payload.get("code"):
        return [f"{tool}: {payload.get('error')}"]
    return list(payload.get("problems") or [])


def psalm_exceptions(path: Path, problems: list[str]) -> dict[str, str]:
    """Read one calendar's ledger of psalm loci excused from its numbering.

    The ledger names each locus and where it is cited, so a reader can see what
    is owed without running anything. It is deliberately spelled out one verse
    at a time: a rule of the form "allow anything in Psalm 118" would absorb the
    next mistyped reference in that psalm along with the known ones.
    """
    import yaml

    try:
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
    except (OSError, yaml.YAMLError):
        return {}  # already reported by check_file
    if not isinstance(document, dict):
        return {}
    payload = document.get(EXCEPTIONS)
    if payload is None:
        return {}
    if not isinstance(payload, list) or not payload:
        problems.append(f"{path}: {EXCEPTIONS} must be a nonempty list, or absent")
        return {}
    listed: dict[str, str] = {}
    for index, entry in enumerate(payload):
        where = f"{path}: {EXCEPTIONS}[{index}]"
        if not isinstance(entry, dict):
            problems.append(f"{where}: entry is not a mapping")
            continue
        psalm = entry.get("psalm")
        if not isinstance(psalm, int):
            problems.append(f"{where}: psalm must be the cited psalm's number")
            psalm = None
        divergence = entry.get("divergence")
        if not isinstance(divergence, str) or not divergence.strip():
            problems.append(f"{where}: divergence must say how the systems differ here")
        loci = entry.get("loci")
        if not isinstance(loci, dict) or not loci:
            problems.append(f"{where}: loci must be a nonempty mapping")
            continue
        for locus, cited in loci.items():
            found = PSALM_LOCUS.fullmatch(locus) if isinstance(locus, str) else None
            if found is None:
                problems.append(f"{where}: {locus!r} is not a Psalm chapter:verse locus")
                continue
            if psalm is not None and int(found.group(1)) != psalm:
                problems.append(f"{where}: {locus} does not belong to Psalm {psalm}")
                continue
            if not isinstance(cited, str) or not cited.strip():
                problems.append(f"{where}: {locus} must name the proper that cites it")
                continue
            if locus in listed:
                problems.append(f"{path}: {EXCEPTIONS} lists {locus} twice")
            listed[locus] = cited
    return listed


def apply_psalm_exceptions(
    paths: list[Path], problems: list[str]
) -> tuple[list[str], list[str]]:
    """Set aside the psalm-bound problems a calendar's ledger already owns.

    The ledger keeps the gate shut while the data defect it records is still
    open, and it is self-cleaning in both directions: a psalm-bound problem at
    an unlisted locus still fails, so a new leak cannot slip in behind the known
    ones, and a listed locus that no longer produces a problem fails too, so the
    ledger empties itself as the antiphons are corrected rather than rotting
    into a permission nobody remembers granting.
    """
    kept: list[str] = []
    listed = {str(path): psalm_exceptions(path, kept) for path in paths}
    listed = {name: entries for name, entries in listed.items() if entries}
    excepted: list[str] = []
    met: dict[str, set[str]] = {}
    for problem in problems:
        found = PSALM_TROUBLE.search(problem)
        owner = None
        if found:
            owner = next(
                (name for name in listed if problem.startswith(f"{name}: ")), None
            )
        if owner is None or found.group(1) not in listed[owner]:
            kept.append(problem)
            continue
        met.setdefault(owner, set()).add(found.group(1))
        excepted.append(problem)
    for name, entries in listed.items():
        for locus in entries:
            if locus not in met.get(name, ()):
                kept.append(
                    f"{name}: {EXCEPTIONS} lists {locus}, which no longer breaches "
                    "this calendar's numbering; delete the entry"
                )
    return kept, excepted


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", type=Path, default=DEFAULT_ROOT)
    shared.add_argument("--calendar", help="limit to one calendar directory name")
    shared.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )
    parser = argparse.ArgumentParser(
        prog="check-calendar-masses",
        description=(
            "Validate the normalized YAML mass-proper indexes under "
            "src/sources/calendars."
        ),
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "check-calendar-masses")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="validate all calendars and propers", parents=[shared]),
        EXAMPLES["check"],
    )

    def dispatch(arguments):
        return run(arguments.root, arguments.calendar)

    def render(payload: object, arguments: argparse.Namespace) -> int:
        as_json = bool(getattr(arguments, "json", False))
        problems = payload.get("problems") if isinstance(payload, dict) else None
        if as_json:
            print_json(payload if isinstance(payload, dict) else {})
            return 1 if problems else 0
        if problems is None:
            print("calendar-mass error: invalid checker payload", file=sys.stderr)
            return 70
        # An excepted problem is still reported: it is a defect that is owed,
        # not one that has been settled.
        for excepted in payload.get("excepted") or []:
            print(f"calendar-mass excepted: {excepted}", file=sys.stderr)
        for problem in problems:
            print(f"calendar-mass error: {problem}", file=sys.stderr)
        for path, counts in payload.get("files", {}).items():
            print(f"{path}\t{counts['masses']} masses\t{counts['propers']} propers")
        return 1 if problems else 0

    return run_verb_cli(
        parser=parser,
        handlers={"check": dispatch},
        renderer=render,
        prefix="check-calendar-masses",
        argv=argv,
        default_verb="check",
        dependency_message="install requirements-tools.txt",
    )


if __name__ == "__main__":
    raise SystemExit(main())
