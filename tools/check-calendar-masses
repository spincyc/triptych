    "citation_convention",
    "edition",
    "ordering",
    "orthography",
    "registry",
    "schema",
    "series",
    "verification",
)
ENTRY_REQUIRED = ("key", "name", "registry")
# Every field a proper may carry. Enumerated because the schema's silence about
# unrecognised keys is itself a defect: YAML reads an unquoted scalar carrying
# `: ` as a second mapping key, so `incipit: Manete in me, et ego in vobis`
# became `incipit: Manete in me` beside `et ego in vobis: null`, and the site
# served the truncation. Nothing here reported it, because `check_reference`
