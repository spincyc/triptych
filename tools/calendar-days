        if sunday_cycle(ending) != sunday or weekday_cycle(ending) != weekday:
            problems.append(
                f"{ending}: worked cycle {sunday}/{weekday} but computed "
                f"{sunday_cycle(ending)}/{weekday_cycle(ending)}"
