def check_computus() -> list[str]:
    problems: list[str] = []
    for civil_year, row in sorted(WORKED_ANCHORS.items()):
        a = Anchors(civil_year)
        got = (
            a.easter.isoformat(),
            a.ash_wednesday.isoformat(),
            a.septuagesima.isoformat(),
            a.pentecost.isoformat(),
            a.trinity.isoformat(),
            first_sunday_of_advent(civil_year).isoformat(),
            a.sunday_before_advent.isoformat(),
        )
        if got != row:
            problems.append(f"{civil_year}: worked anchors {row} but computed {got}")
    for name, (want, produce) in sorted(SPOT_CHECKS.items()):
        got = produce().isoformat()
        if got != want:
            problems.append(f"spot check {name}: want {want}, computed {got}")
    # The guidance says the two Advent formulations agree across 1900-2100.
    for civil_year in range(GUIDANCE_SPAN[0], GUIDANCE_SPAN[1] + 1):
        fourth = first_sunday_of_advent(civil_year)
        nearest = sunday_nearest_november_30(civil_year)
        if fourth != nearest:
            problems.append(
                f"{civil_year}: the fourth Sunday before 25 December is {fourth} "
                f"but the Sunday nearest 30 November is {nearest}"
            )
        if not date(civil_year, 11, 27) <= fourth <= date(civil_year, 12, 3):
            problems.append(
                f"{civil_year}: First Sunday of Advent {fourth} is outside 27 Nov - 3 Dec"
            )
    return problems


