def check_ordinary_time(known: set[str]) -> list[str]:
    problems: list[str] = []
    for ending, row in sorted(WORKED_ORDINARY.items()):
        baptism, last_before, resumed, weeks, omitted, first_sunday, first_week = row
        year = build_postconciliar(ending, known)
        facts = year.facts
        if facts["baptism_of_the_lord"] != baptism:
            problems.append(
                f"{ending}: worked Baptism {baptism}, computed {facts['baptism_of_the_lord']}"
            )
        for label, want, got in (
            ("L", last_before, facts["last_week_before_lent"]),
            ("R", resumed, facts["resumed_week"]),
            ("weeks", weeks, facts["ordinary_time_weeks"]),
            ("omitted", omitted, facts["omitted_week"]),
        ):
            if want != got:
                problems.append(f"{ending}: worked {label} {want}, computed {got}")
        # The table's last column is the United States form, where the Body and
        # Blood of Christ is transferred to the Sunday, so the candidate tagged
        # for the Thursday form is the one that does not hold there.
        when = date.fromisoformat(first_sunday)
        held = [
            entry["key"]
            for entry in year.placements.get(when, [])
            if entry.get("territorial") != TERRITORIAL_OPTIONS["corpus-christi"][0]
        ]
        if f"ot-{first_week}" not in held:
            problems.append(
                f"{ending}: worked first numbered Sunday after Pentecost is "
                f"{first_sunday} week {first_week}, computed {held}"
            )
    return problems


def check_1962(known: set[str]) -> list[str]:
    problems: list[str] = []
    for ending, (count, after, unused, slots) in sorted(WORKED_1962.items()):
        facts = build_1962(ending, known).facts
        got = (
            facts["sundays_after_epiphany"],
            facts["sundays_after_pentecost"],
            facts["unused_after_epiphany"],
            facts["resumption_slots"],
        )
        if got != (count, after, unused, slots):
            problems.append(
                f"{ending}: worked 1962 row {(count, after, unused, slots)}, computed {got}"
            )
    slots_2008 = build_1962(2008, known).placements
    for stamp, key in sorted(WORKED_SLOTS_2008.items()):
        held = [entry["key"] for entry in slots_2008.get(date.fromisoformat(stamp), [])]
        if key not in held:
            problems.append(
                f"2008: the guidance's nominal slot map puts {key} on {stamp}, computed {held}"
            )
    # The Ember, Litany and Sacred Heart windows, over the span this tool emits.
    seen: dict[str, list[date]] = {}
    litanies: dict[int, list[date]] = {}
    for ending in range(FIRST_YEAR, LAST_YEAR + 1):
        for when, entries in build_1962(ending, known).placements.items():
            for entry in entries:
                if entry["key"] in WORKED_WINDOWS:
                    seen.setdefault(entry["key"], []).append(when)
                elif entry["key"] == "rogation-mass":
                    litanies.setdefault(ending, []).append(when)
    for key, (low, high) in sorted(WORKED_WINDOWS.items()):
        days = seen.get(key) or []
        if not days:
            problems.append(f"{key}: the guidance states a window and nothing was placed")
            continue
        got = (min((d.month, d.day) for d in days), max((d.month, d.day) for d in days))
        if got != (low, high):
            problems.append(f"{key}: guidance window {(low, high)}, computed {got}")
        off = sorted({d.weekday() for d in days} - {WORKED_WEEKDAYS[key]})
        if off:
            problems.append(f"{key}: falls on weekday {off}, not {WORKED_WEEKDAYS[key]}")
    # Four Litany days a year: 25 April or its stated replacement, and the three
    # days before the Ascension. The guidance says the transfer lands on Easter +2.
    for ending, days in sorted(litanies.items()):
        easter = gregorian_easter(ending)
        want = {easter + timedelta(days=n) for n in (36, 37, 38)}
        april = date(ending, 4, 25)
        want.add(easter + timedelta(days=2) if april in (easter, easter + timedelta(days=1)) else april)
        if set(days) != want:
            problems.append(
                f"{ending}: the Litany days are {sorted(d.isoformat() for d in want)}, "
                f"computed {sorted(d.isoformat() for d in days)}"
            )

    # The guidance's stated invariants over its own field of validity.
    for ending in range(GUIDANCE_SPAN[0], GUIDANCE_SPAN[1] + 1):
        facts = build_1962(ending, known).facts
        if not 1 <= facts["sundays_after_epiphany"] <= 6:
            problems.append(f"{ending}: E is {facts['sundays_after_epiphany']}, outside 1-6")
        if not 23 <= facts["sundays_after_pentecost"] <= 28:
            problems.append(f"{ending}: P is {facts['sundays_after_pentecost']}, outside 23-28")
        if facts["surplus"] not in (0, 1):
            problems.append(f"{ending}: surplus is {facts['surplus']}, not 0 or 1")
    problems.extend(check_ferial(known))
    return problems


# What RGMR 299 excludes, stated the other way round so the check is about the
# rubric and not about the tool's own season list: a feria of these seasons has
# a Mass of its own, and a ferial formulary standing on one of their dates would
# mean the rule had reached past the rubric.
FERIAL_EXCLUDED_SEASONS = ("lent", "passiontide", "triduum")


def check_ferial(known: set[str]) -> list[str]:
    """The ferial-formulary rule against what RGMR 299 says it may reach.

    Four claims, over every year the tool emits. A rule this quiet -- it puts
    no mass on a date, it points a date at a mass -- would otherwise drift
    without moving a single number anyone reads.
    """
    problems: list[str] = []
    for ending in range(FIRST_YEAR, LAST_YEAR + 1):
        year = build_1962(ending, known)
        easter = year.anchors.easter
        window = {easter + timedelta(days=n) for n in range(40, 48)}
        seen_window = set()
        for when, entries in sorted(year.ferial.items()):
            if when.weekday() == 6:
                problems.append(f"{ending}: a ferial formulary stands on Sunday {when}")
            season = year.season_of(when)
            if season in FERIAL_EXCLUDED_SEASONS:
                problems.append(
                    f"{ending}: {when} is in {season}, whose ferias RGMR 299 gives a "
                    "Mass of their own, and it carries a ferial formulary"
                )
            if any(e["origin"] == "temporal" for e in year.placements.get(when, [])):
                problems.append(
                    f"{ending}: {when} carries a temporal mass of its own and a "
                    "ferial formulary as well"
                )
            for entry in entries:
                if entry["key"] not in known:
                    problems.append(f"{ending}: {when} borrows {entry['key']}, not in the index")
                if entry["key"] == "ascension":
                    seen_window.add(when)
                    if entry.get("territorial") != TERRITORIAL_OPTIONS["ascension"][0]:
                        problems.append(
                            f"{ending}: {when} takes the Ascension's Mass untagged; the "
                            "Missal states that rubric from the Ascension's own day"
                        )
        # Every day of the stated window that is not a Sunday and has no Mass
        # of its own must be in it, and nothing outside it may be.
        expected = {
            when
            for when in window
            if when.weekday() != 6
            and not any(e["origin"] == "temporal" for e in year.placements.get(when, []))
        }
        if seen_window != expected:
            problems.append(
                f"{ending}: the Ascension's ferial window is "
                f"{sorted(d.isoformat() for d in expected)}, computed "
                f"{sorted(d.isoformat() for d in seen_window)}"
            )
    return problems


def check_guidance(indexes: dict[str, dict]) -> list[str]:
    """The worked tables run against each calendar's own key set where one is
    loaded, and against an unrestricted set otherwise, so the arithmetic is
    checked even when a calendar is filtered out with --calendar."""

    class Everything(set):
        def __contains__(self, item: object) -> bool:
            return True

    postconciliar = indexes.get("postconciliar", {}).get("keys") or Everything()
    roman = indexes.get("roman-1962", {}).get("keys") or Everything()
    return (
        check_computus()
        + check_cycles()
        + check_ordinary_time(postconciliar)
        + check_1962(roman)
    )


def run_check(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    first, last = arguments.first, arguments.last
    indexes = {name: load_calendar(root, name) for name in calendars(root, arguments.calendar)}
    problems = check_guidance(indexes)
    seen: dict[str, dict] = {}
    for name, index in indexes.items():
        placements = 0
        missing: list[dict] = []
        for ending in range(first, last + 2):
            year = BUILDERS[index["builder"]](ending, index["keys"])
            placements += sum(len(v) for v in year.placements.values())
            missing.extend(year.missing)
        # Every emitted key is in the calendar by construction; this reports the
        # rules whose key the calendar does not carry, which is a coverage gap
        # rather than a wrong emission.
        seen[name] = {
            "placements": placements,
            "rules_without_a_mass": sorted({row["key"] for row in missing}),
        }
        for key, mass in index["masses"].items():
            if not mass.get("date"):
                continue
            month, day = (int(part) for part in str(mass["date"]).split("-"))
            if not 1 <= month <= 12 or not 1 <= day <= 31:
                problems.append(f"{name}: {key} carries an impossible date {mass['date']!r}")
    if problems:
        head = "; ".join(problems[:4])
        raise ValueError(head + (f" (and {len(problems) - 4} more)" if len(problems) > 4 else ""))
    return {
        "calendars": seen,
        "checked": {
            "advent_agreement_span": list(GUIDANCE_SPAN),
            "worked_1962_rows": len(WORKED_1962) + len(WORKED_SLOTS_2008) + len(WORKED_WINDOWS),
            "worked_anchor_rows": len(WORKED_ANCHORS) + len(SPOT_CHECKS),
            "worked_cycle_rows": len(WORKED_INTERVALS) + len(WORKED_PAIRS) + len(WORKED_SERIES),
            "worked_ordinary_time_rows": len(WORKED_ORDINARY),
        },
        "span": {"first": first, "last": last},
        "status": "ok",
    }


def run_structure(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    first, last = arguments.first, arguments.last
    if last < first:
        raise ValueError(f"--last {last} precedes --first {first}")
    indexes = {name: load_calendar(root, name) for name in calendars(root, arguments.calendar)}
    problems = check_guidance(indexes)
    if problems:
        raise ValueError(
            "the computation does not agree with " + GUIDANCE + "; run `calendar-days check`"
        )
    out = Path(arguments.out)
    written: list[str] = []
    manifest = []
    for name, index in indexes.items():
        built = build_years(index, list(range(first, last + 2)))
        with_fixed(index, list(range(first, last + 1)))
        target = out / "structure" / "calendar" / name
        target.mkdir(parents=True, exist_ok=True)
        for civil_year in range(first, last + 1):
            document = year_document(
                index,
                civil_year,
                {civil_year: built[civil_year], civil_year + 1: built[civil_year + 1]},
            )
            path = target / f"{civil_year}.json"
            path.write_text(
                json.dumps(document, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
                + "\n",
                encoding="utf-8",
            )
            written.append(str(path))
        manifest.append(
            {
                "calendar": index["calendar"],
                "edition": index["edition"],
                "lectionary_cycles": CYCLED[index["builder"]],
                "path": f"structure/calendar/{name}/{{civil_year}}.json",
                "territorial": territorial_block(index["builder"]),
            }
        )
    index_path = out / "structure" / "calendar" / "index.json"
    index_path.parent.mkdir(parents=True, exist_ok=True)
    index_path.write_text(
        json.dumps(
            {
                "advisory": ADVISORY,
                "calendars": manifest,
                "guidance": GUIDANCE,
                "precedence": {"note": PRECEDENCE_NOTE, "stated": False},
                "schema": SCHEMA,
                "span": {"first": first, "last": last},
            },
            ensure_ascii=False,
            sort_keys=True,
            indent=1,
        )
        + "\n",
        encoding="utf-8",
    )
    written.append(str(index_path))
    return {
        "files": len(written),
        "span": {"first": first, "last": last},
        "status": "ok",
        "written": written if arguments.verbose else written[-1:],
    }


def run_coverage(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    report = [
        coverage_of(load_calendar(root, name), arguments.first, arguments.last)
        for name in calendars(root, arguments.calendar)
    ]
    return {"coverage": report, "status": "ok"}


def run_day(arguments: argparse.Namespace) -> dict:
    """One date, computed. A reading verb, and it must stay a cheap one.

    It took 2.1 seconds, and all but a tenth of that was `yaml.safe_load`
    scanning a megabyte of `propers.yaml` character by character in pure
    Python. The obvious fix — answer from the emitted
    `structure/calendar/<cal>/<year>.json`, as `calendar-rubrics day` does —
    was examined and NOT taken, because that file deliberately carries a
    candidate's key and nothing else about it: its own note says the title
    lives in the propers structure, and a candidate here carries its name, its
    section and its RANK, which is what tells a commemoration from a mass. To
    answer from the year file, those three would have to be written into it,
    and a rank restated beside the one in `propers.yaml` is exactly the second
    copy guidance/the-shape.md section 2 is about — the copy that agrees today.

    So the arithmetic still runs and the index is still read; what changed is
    that `_calendars.read_yaml` hands the bytes to libyaml where it is
    installed. Same parse, same document — checked, not assumed — and about a
    sixth of the time.
    """
    if not arguments.date:
        raise ValueError("day needs --date YYYY-MM-DD")
    try:
        when = date.fromisoformat(arguments.date)
    except ValueError as error:
        raise ValueError(f"--date {arguments.date!r} is not a civil date: {error}") from error
    root = Path(arguments.root)
    found = []
    for name in calendars(root, arguments.calendar):
        index = load_calendar(root, name)
        built = build_years(index, [when.year, when.year + 1])
        with_fixed(index, [when.year])
        owner, candidates = candidates_for(index, built, when.year, when)
        summary = year_summary(owner, index["builder"])
        found.append(
            {
                "calendar": index["calendar"],
                "candidates": candidates,
                "ferial_formulary": [
                    decorate(entry, index["masses"][entry["key"]])
                    for entry in owner.ferial.get(when) or []
                ],
                "lectionary": summary["lectionary"],
                "appointed": appointed_of(candidates),
                "commemorations": [
                    entry["key"] for entry in candidates if is_commemoration(entry)
                ],
                "ranked": len(candidates) <= 1,
                "season": owner.season_of(when),
                "unresolved": owner.unresolved,
                "week": owner.weeks.get(when),
                "year": owner.ending,
            }
        )
    return {"advisory": ADVISORY, "date": when.isoformat(), "days": found, "status": "ok"}


def is_commemoration(entry: dict) -> bool:
    return str(entry.get("rank") or "").strip().lower() in COMMEMORATION_RANKS


def appointed_of(candidates: list[dict]) -> str | None:
    """The mass that occurs, where the calendar's own records settle it.

    This is not a precedence computation and must never become one. A
    commemoration is not a candidate for the day's mass: it is a collect,
    secret and postcommunion added to whatever mass is said. Excluding them
    therefore reads the index rather than ranking it, and where two masses
    still stand this returns None and the caller shows both.
    """
    masses = [entry for entry in candidates if not is_commemoration(entry)]
    return str(masses[0]["key"]) if len(masses) == 1 else None


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("calendar-days error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    if "coverage" in payload:
        for row in payload["coverage"]:
            print(f"{row['calendar']}: {row['span']['first']}-{row['span']['last']}")
            print(
                f"  dates {row['dates']}: {row['dates_resolved']} resolve to a mass, "
                f"{row['dates_unresolved']} to nothing, "
                f"{row['dates_with_unranked_candidates']} carry unranked candidates"
            )
            print(
                f"  ferial formulary on {row['dates_with_a_ferial_formulary']} dates; "
                f"{row['dates_reaching_no_mass_at_all']} dates reach no mass at all"
            )
            print(
                f"  masses {row['masses']}: {row['masses_placed']} reachable, "
                f"{len(row['masses_never_placed'])} never placed"
            )
            for season, count in row["dates_unresolved_by_season"].items():
                print(f"    no mass, {season}: {count}")
            for mass in row["masses_never_placed"]:
                print(f"    never placed: {mass['key']} ({mass['section']}) - {mass['why']}")
        return 0
    if isinstance(payload.get("days"), list):
        print(payload["date"])
        for row in payload["days"]:
            week = f" week {row['week']}" if row.get("week") else ""
            print(f"  {row['calendar']}: {row['season']}{week}, liturgical year {row['year']}")
            if row.get("lectionary"):
                print(f"    Lectionary {row['lectionary']['sunday']} / {row['lectionary']['weekday']}")
            for entry in row["candidates"]:
                tag = f"  [{entry['territorial']}]" if entry.get("territorial") else ""
                print(f"    {entry['key']}: {entry['name']}{tag}")
            for entry in row.get("ferial_formulary") or []:
                tag = f"  [{entry['territorial']}]" if entry.get("territorial") else ""
                print(f"    a feria here takes {entry['key']}: {entry['name']}{tag}")
            if not row["candidates"] and not row.get("ferial_formulary"):
                print("    no mass is written for this day")
            if not row["ranked"]:
                print("    unranked: more than one candidate, and no precedence is stated")
            for refusal in row["unresolved"]:
                print(f"    unresolved this year: {refusal['what']} - {refusal['why']}")
        print(f"  {ADVISORY}")
        return 0
    if "files" in payload:
        print(f"wrote {payload['files']} files for {payload['span']['first']}-{payload['span']['last']}")
        for path in payload["written"]:
            print(f"  -> {path}")
        return 0
    for name, row in payload["calendars"].items():
        print(f"{name}: {row['placements']} placements")
        for key in row["rules_without_a_mass"]:
            print(f"    a rule names {key}, which this calendar does not carry")
    print(f"checked against the worked tables in {GUIDANCE}")
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_ROOT), help="calendar directory")
    shared.add_argument("--out", default="src/web/data", help="where `structure` writes")
    shared.add_argument("--calendar", default=None, help="limit to one calendar")
    shared.add_argument("--first", type=int, default=FIRST_YEAR, help="first civil year")
    shared.add_argument("--last", type=int, default=LAST_YEAR, help="last civil year")
    shared.add_argument("--date", default=None, help="the date `day` resolves")
    shared.add_argument("--format", choices=("text", "json"), default="text")
    shared.add_argument("--verbose", action="store_true", help="list every file written")
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="calendar-days",
        description="Resolve civil dates to each calendar's masses as a computed finding aid.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "calendar-days")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="verify the computation against the guidance", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("structure", help="write the browser's date-to-mass files", parents=[shared]),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser("coverage", help="report what each calendar can reach", parents=[shared]),
        EXAMPLES["coverage"],
    )
    with_examples(
        sub.add_parser("day", help="resolve one civil date", parents=[shared]),
        EXAMPLES["day"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={
            "check": run_check,
            "structure": run_structure,
            "coverage": run_coverage,
            "day": run_day,
        },
        renderer=render,
        prefix="calendar-days",
        argv=argv,
        default_verb="check",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
