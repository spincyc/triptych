# ---------------------------------------------------------------- computus


def gregorian_easter(year: int) -> date:
    """Easter by the Gregorian computus: the Sunday after the first
    ecclesiastical full moon falling on or after March 21."""
    a = year % 19
    b, c = divmod(year, 100)
    d, e = divmod(b, 4)
    f = (b + 8) // 25
    g = (b - f + 1) // 3
    h = (19 * a + b - d - g + 15) % 30
    i, k = divmod(c, 4)
    lunar = (32 + 2 * e + 2 * i - h - k) % 7
    m = (a + 11 * h + 22 * lunar) // 451
    month = (h + lunar - 7 * m + 114) // 31
    day = ((h + lunar - 7 * m + 114) % 31) + 1
    return date(year, month, day)


def sunday_on_or_before(when: date) -> date:
    return when - timedelta(days=(when.weekday() + 1) % 7)


def sunday_after(when: date) -> date:
    """The first Sunday strictly after `when`."""
    return when + timedelta(days=7 - (when.weekday() + 1) % 7)


def nth_sunday_of_month(civil_year: int, month: int, nth: int) -> date:
    """General rubric 19 as the guidance states it: the first Sunday of a month
    is the one occurring first in it, that is falling from the first to the
    seventh day, and the rest are counted from there."""
    first = date(civil_year, month, 1)
    return first + timedelta(days=(6 - first.weekday()) % 7 + 7 * (nth - 1))


def last_sunday_of_month(civil_year: int, month: int) -> date:
    """The last Sunday falling inside the month, counted back from its end."""
    last = date(civil_year, month, calendar.monthrange(civil_year, month)[1])
    return last - timedelta(days=(last.weekday() + 1) % 7)


def first_sunday_of_advent(civil_year: int) -> date:
    """The fourth Sunday before 25 December of `civil_year`."""
    return sunday_on_or_before(date(civil_year, 12, 24)) - timedelta(days=21)


def sunday_nearest_november_30(civil_year: int) -> date:
    """Universal Norms 40's formulation, kept for the agreement check."""
    pivot = date(civil_year, 11, 30)
    earlier = sunday_on_or_before(pivot)
    later = earlier + timedelta(days=7)
    return earlier if (pivot - earlier) <= (later - pivot) else later


def sunday_cycle(ending: int) -> str:
    """General Introduction to the Lectionary 66.2, on the civil year in which
    the liturgical year ends."""
    return {1: "A", 2: "B", 0: "C"}[ending % 3]


def weekday_cycle(ending: int) -> str:
    """General Introduction to the Lectionary 69.4, resolved independently."""
    return "I" if ending % 2 else "II"


class Anchors:
    """Every movable anchor of the liturgical year ending in `ending`."""

    def __init__(self, ending: int) -> None:
        self.ending = ending
        self.easter = gregorian_easter(ending)
        self.septuagesima = self.easter - timedelta(days=63)
        self.sexagesima = self.easter - timedelta(days=56)
        self.quinquagesima = self.easter - timedelta(days=49)
        self.ash_wednesday = self.easter - timedelta(days=46)
        self.ascension_thursday = self.easter + timedelta(days=39)
        self.ascension_sunday = self.easter + timedelta(days=42)
        self.pentecost = self.easter + timedelta(days=49)
        self.trinity = self.easter + timedelta(days=56)
        self.corpus_christi_thursday = self.easter + timedelta(days=60)
        self.corpus_christi_sunday = self.easter + timedelta(days=63)
        self.begins = first_sunday_of_advent(ending - 1)
        self.next_advent = first_sunday_of_advent(ending)
        self.last_day = self.next_advent - timedelta(days=1)
        self.sunday_before_advent = self.next_advent - timedelta(days=7)
        self.christmas = date(ending - 1, 12, 25)

    def as_json(self) -> dict:
        return {
            "ascension_thursday_form": self.ascension_thursday.isoformat(),
            "ascension_transferred_sunday_form": self.ascension_sunday.isoformat(),
            "ash_wednesday": self.ash_wednesday.isoformat(),
            "body_and_blood_thursday_form": self.corpus_christi_thursday.isoformat(),
            "body_and_blood_transferred_sunday_form": self.corpus_christi_sunday.isoformat(),
            "easter": self.easter.isoformat(),
            "first_sunday_of_advent": self.begins.isoformat(),
            "next_first_sunday_of_advent": self.next_advent.isoformat(),
            "pentecost": self.pentecost.isoformat(),
            "septuagesima": self.septuagesima.isoformat(),
            "sunday_before_advent": self.sunday_before_advent.isoformat(),
            "trinity": self.trinity.isoformat(),
        }


# ------------------------------------------------------------ temporal cycles


class Year:
    """One liturgical year's placements, seasons and computed facts.

    `known` is the calendar's own key set, so a placement can never name a mass
    the calendar does not carry. A rule that names an absent key records the
    miss in `missing` unless it was offered as an alternative spelling, which is
    how the Lenten ferias are placed: the 1962 index calls three of them Ember
    Days and the rest by their weekday, and both namings sit on the same day.
    """

    def __init__(self, calendar: str, ending: int, known: set[str]) -> None:
        self.calendar = calendar
        self.ending = ending
        self.known = known
        self.anchors = Anchors(ending)
        self.placements: dict[date, list[dict]] = {}
        self.seasons: list[tuple[date, date, str]] = []
        self.weeks: dict[date, int] = {}
        self.unresolved: list[dict] = []
        self.missing: list[dict] = []
        self.facts: dict[str, object] = {}
        # The Mass a feria takes where it has none of its own. `governors` is
        # keyed by the Sunday whose Mass governs the ferias that follow it, and
        # `borrowed` holds the dates a rubric provides for otherwise, keyed by
        # the date itself. Both hold mass keys and never mass text.
        self.governors: dict[date, dict] = {}
        self.contested: set[date] = set()
        self.borrowed: dict[date, list[dict]] = {}
        self.otherwise: dict[date, str | None] = {}
        self.ferial: dict[date, list[dict]] = {}

    def put(
        self,
        when: date,
        key: str,
        rule: str,
        territorial: str | None = None,
        alternative: bool = False,
    ) -> None:
        if key not in self.known:
            if not alternative:
                self.missing.append({"date": when.isoformat(), "key": key, "rule": rule})
            return
        entry = {"key": key, "origin": "temporal", "rule": rule}
        if territorial:
            entry["territorial"] = territorial
        held = self.placements.setdefault(when, [])
        if entry not in held:
            held.append(entry)

    def governs(self, sunday: date, key: str, rule: str) -> None:
        """Record the Mass that the ferias following `sunday` take.

        A second governor for the same Sunday is refused rather than resolved.
        The one year that produces one is a year of twenty-three Sundays after
        Pentecost, where the numbered Sunday and the last Sunday share a slot
        and the guidance already declines to choose between them; borrowing
        from a Sunday whose own Mass is undecided would decide it by the back
        door.
        """
        if key not in self.known:
            return
        held = self.governors.get(sunday)
        if held is not None and held["key"] != key:
            self.contested.add(sunday)
            return
        self.governors[sunday] = {"key": key, "rule": rule}

    def borrows(
        self,
        when: date,
        key: str,
        rule: str,
        territorial: str | None = None,
        under_the_other_option: str | None = None,
    ) -> None:
        """A date whose ferial Mass a rubric provides otherwise for.

        `under_the_other_option` names the option under which this rubric does
        not reach the date, so that the preceding Sunday's Mass may still be
        emitted there and say which option it holds under. Where it is None the
        preceding Sunday is not reached at all and nothing else is emitted.
        """
        if key not in self.known:
            return
        entry = {"key": key, "rule": rule}
        if territorial:
            entry["territorial"] = territorial
        self.borrowed.setdefault(when, []).append(entry)
        self.otherwise[when] = under_the_other_option

    def season_of(self, when: date) -> str | None:
        for start, end, name in self.seasons:
            if start <= when <= end:
                return name
        return None

    def refuse(self, what: str, why: str) -> None:
        self.unresolved.append({"what": what, "why": why})

    def resolve_ferial(self, windows: tuple) -> None:
        """Fill `ferial` for every date whose feria has no Mass of its own.

        A date is skipped where it already carries a temporal candidate, since
        that candidate is the day's own Mass and RGMR 299 reaches only the
        remaining ferias. Sundays are skipped because a Sunday is not a feria.
        Everything else in a covered window takes the Mass its immediately
        preceding Sunday governs -- the *immediately* preceding one, so that a
        Sunday occupied by a feast, which this index gives no Mass of the
        Sunday, stops the search rather than being stepped over.
        """
        covered = {name: (start, end) for name, start, end in windows}
        when = self.anchors.begins
        while when <= self.anchors.last_day:
            entries = self._ferial_on(when, covered)
            if entries:
                self.ferial[when] = entries
            when += timedelta(days=1)

    def _ferial_on(self, when: date, covered: dict) -> list[dict]:
        if when.weekday() == 6:
            return []
        if any(e["origin"] == "temporal" for e in self.placements.get(when, [])):
            return []
        window = covered.get(self.season_of(when) or "")
        if window is None:
            return []
        start, end = window
        if start and (when.month, when.day) < start:
            return []
        if end and (when.month, when.day) > end:
            return []

        held = list(self.borrowed.get(when, []))
        sunday = when - timedelta(days=(when.weekday() + 1) % 7 or 7)
        governor = None if sunday in self.contested else self.governors.get(sunday)
        if not governor:
            return held
        entry = dict(governor)
        # Where a rubric has already provided otherwise under one territorial
        # option, the preceding Sunday's Mass is what the day takes under the
        # other, and each entry says which it holds under.
        if held:
            option = self.otherwise[when]
            if option is None:
                return held
            entry["territorial"] = option
        held.append(entry)
        return held


def build_1962(ending: int, known: set[str]) -> Year:
    year = Year("roman-1962", ending, known)
    a = year.anchors
    easter = a.easter

    year.put(a.begins, "advent-1", "the fourth Sunday before 25 December")
    year.governs(a.begins, "advent-1", FERIAL_RULE + "the First Sunday of Advent")
    for n in (2, 3, 4):
        year.put(
            a.begins + timedelta(days=7 * (n - 1)),
            f"advent-{n}",
            f"First Sunday of Advent +{7 * (n - 1)}",
        )
        year.governs(
            a.begins + timedelta(days=7 * (n - 1)),
            f"advent-{n}",
            FERIAL_RULE + f"Sunday {n} of Advent",
        )

    # The Ember Days of Advent follow the Third Sunday of Advent, which hangs
    # from the Advent boundary and not from Easter, so there is no offset from
    # Easter to write and the guidance states none.
    advent_3 = a.begins + timedelta(days=14)
    for offset, name in EMBER_DAYS:
        year.put(
            advent_3 + timedelta(days=offset),
            f"advent-ember-{name}",
            f"Third Sunday of Advent +{offset}",
        )

    # The Sunday within the octave of the Nativity. When 25 December is itself a
    # Sunday there is none, and the guidance states no fallback.
    within = sunday_after(a.christmas)
    if within <= date(ending - 1, 12, 31):
        year.put(within, "sunday-within-octave-of-nativity", "the Sunday falling 26-31 December")
        year.governs(
            within,
            "sunday-within-octave-of-nativity",
            FERIAL_RULE + "the Sunday within the octave of the Nativity",
        )
    else:
        year.refuse(
            "sunday-within-octave-of-nativity",
            "25 December is a Sunday, so no Sunday falls within the octave, and "
            + GUIDANCE
            + " states no fallback date",
        )

    # Sundays after the Epiphany, counted from January 6 and bounded by
    # Septuagesima. The first always occurs and carries the Holy Family.
    epiphany = date(ending, 1, 6)
    first_after = sunday_after(epiphany)
    count = (a.septuagesima - first_after).days // 7
    year.put(first_after, "holy-family", "the first Sunday after 6 January")
    year.put(
        first_after,
        "mass-of-the-first-sunday-after-epiphany",
        "the first Sunday after 6 January; the Missal's own formulary for that "
        "Sunday, whose slot the Holy Family occupies, printed for the ferias "
        "of the week that follows it",
    )
    # The Missal provides otherwise for the ferias before that Sunday, and its
    # rubric at printed p. 39 states both halves in one sentence: "Diebus
    # ferialibus a 7 ad 12 ianuarii ante dominicam I post Epiphaniam
    # occurrentibus, dicitur Missa de festo Epiphaniae; post eandem dominicam
    # vero Missa de ea." The formulary printed for those later ferias is the
    # one the Holy Family displaced, at printed p. 40.
    when = date(ending, 1, 7)
    while when < first_after:
        year.borrows(
            when,
            "epiphania-domini",
            "RGMR 299 provided otherwise: the Missal's rubric at printed p. 39 "
            "gives the Mass of the Epiphany to the ferias falling from 7 to 12 "
            "January before the first Sunday after the Epiphany",
        )
        when += timedelta(days=1)
    year.governs(
        first_after,
        "mass-of-the-first-sunday-after-epiphany",
        FERIAL_RULE
        + "the first Sunday after 6 January, whose own formulary the Missal "
        "prints at printed p. 40 for the ferias of the week that follows it, "
        "the Holy Family having taken the Sunday",
    )
    for n in range(2, count + 1):
        year.put(
            first_after + timedelta(days=7 * (n - 1)),
            f"epiphany-{n}",
            f"Sunday {n} after 6 January",
        )
        year.governs(
            first_after + timedelta(days=7 * (n - 1)),
            f"epiphany-{n}",
            FERIAL_RULE + f"Sunday {n} after 6 January",
        )

    # Septuagesima is stated as Easter -63 and Ash Wednesday as Easter -46, so
    # the two Sundays between them are forced, not chosen.
    year.put(a.septuagesima, "septuagesima", "Easter -63")
    year.put(a.sexagesima, "sexagesima", "Easter -56")
    year.put(a.quinquagesima, "quinquagesima", "Easter -49")
    for sunday, key in (
        (a.septuagesima, "septuagesima"),
        (a.sexagesima, "sexagesima"),
        (a.quinquagesima, "quinquagesima"),
    ):
        year.governs(sunday, key, FERIAL_RULE + f"{key.capitalize()} Sunday")

    year.put(a.ash_wednesday, "ash-wednesday", "Easter -46")
    for offset, name in ((1, "thursday"), (2, "friday"), (3, "saturday")):
        year.put(
            a.ash_wednesday + timedelta(days=offset),
            f"{name}-after-ash-wednesday",
            f"Ash Wednesday +{offset}",
        )

    for week in (1, 2, 3, 4):
        sunday = easter - timedelta(days=42 - 7 * (week - 1))
        year.put(sunday, f"lent-{week}", f"Easter -{(easter - sunday).days}")
        for step, name in enumerate(WEEKDAYS, start=1):
            when = sunday + timedelta(days=step)
            rule = f"{name} of week {week} of Lent"
            # The book names three days of week I as Ember Days and the rest by
            # their weekday. Either spelling sits on the day Lent's own
            # structure fixes, unlike the Advent and September Ember Days.
            year.put(when, f"lent-{week}-{name}", rule, alternative=True)
            year.put(when, f"lent-{week}-ember-{name}", rule, alternative=True)

    passion = easter - timedelta(days=14)
    year.put(passion, "passion-sunday", "Easter -14")
    for step, name in enumerate(WEEKDAYS, start=1):
        year.put(passion + timedelta(days=step), f"passion-{name}", f"Passion Sunday +{step}")

    palm = easter - timedelta(days=7)
    year.put(palm, "palm-sunday", "Easter -7")
    for step, name in ((1, "monday"), (2, "tuesday"), (3, "wednesday")):
        year.put(palm + timedelta(days=step), f"holy-{name}", f"Palm Sunday +{step}")

    year.put(easter - timedelta(days=3), "chrism-mass", "Easter -3")
    year.put(easter - timedelta(days=3), "mass-of-the-lords-supper", "Easter -3")
    year.put(easter - timedelta(days=2), "good-friday", "Easter -2")
    year.put(easter - timedelta(days=1), "easter-vigil", "Easter -1")

    year.put(easter, "easter-sunday", "Easter")
    for step, name in enumerate(WEEKDAYS, start=1):
        year.put(easter + timedelta(days=step), f"easter-{name}", f"Easter +{step}")
    year.put(easter + timedelta(days=7), "low-sunday", "Easter +7")
    year.governs(easter + timedelta(days=7), "low-sunday", FERIAL_RULE + "Low Sunday")
    for n in (2, 3, 4, 5):
        year.put(
            easter + timedelta(days=7 + 7 * (n - 1)),
            f"easter-{n}",
            f"Easter +{7 + 7 * (n - 1)}",
        )
        year.governs(
            easter + timedelta(days=7 + 7 * (n - 1)),
            f"easter-{n}",
            FERIAL_RULE + f"Sunday {n} after Easter",
        )

    # The two Litanies share one formulary, `in Litaniis maioribus et minoribus`,
    # so the same mass is placed on all four days. The greater Litanies keep a
    # civil date; general rubric 80 states its own transfer condition and its own
    # replacement day, which is why this transfer is computed where a territorial
    # one never is. The lesser Litanies are the three days before the Ascension;
    # rubric 87's faculty to move them is a local decision and is not computed.
    litania_maior = date(ending, 4, 25)
    if litania_maior in (easter, easter + timedelta(days=1)):
        year.put(
            easter + timedelta(days=2),
            "rogation-mass",
            "the greater Litanies: 25 April falls on Easter Sunday or Easter "
            "Monday, so they keep the following Tuesday, which is Easter +2",
        )
    else:
        year.put(litania_maior, "rogation-mass", "the greater Litanies: 25 April")
    for offset, name in ((36, "Monday"), (37, "Tuesday"), (38, "Wednesday")):
        year.put(
            easter + timedelta(days=offset),
            "rogation-mass",
            f"the lesser Litanies: {name} before the Ascension, Easter +{offset}; "
            "a transfer by the local Ordinary is not computed",
        )

    thursday_form, sunday_form = TERRITORIAL_OPTIONS["ascension"]
    year.put(easter + timedelta(days=38), "vigil-of-the-ascension", "Easter +38", thursday_form)
    year.put(a.ascension_thursday, "ascension", "Easter +39", thursday_form)
    year.put(a.ascension_sunday, "sunday-after-ascension", "Easter +42", thursday_form)
    year.put(a.ascension_sunday, "ascension", "Easter +42", sunday_form)

    # The Missal provides otherwise at In Ascensione Domini, printed p. 352:
    # "Diebus a feria VI post Ascensionem usque ad feriam VI ante vigiliam
    # Pentecostes inclusive, dicitur Missa de festo Ascensionis." The rubric is
    # stated from the Ascension's own day, so it holds only where the Ascension
    # is kept on the Thursday; where the competent authority has moved it to
    # the Sunday, these ferias are still governed by the preceding Sunday, and
    # after that Sunday this repository states nothing at all.
    for offset in range(40, 48):
        when = easter + timedelta(days=offset)
        year.borrows(
            when,
            "ascension",
            "RGMR 299 provided otherwise: the Missal's rubric at printed p. 352 "
            "gives the Mass of the Ascension to the days from the Friday after "
            "it to the Friday before the vigil of Pentecost inclusive",
            territorial=thursday_form,
            under_the_other_option=sunday_form if offset < 42 else None,
        )

    year.put(easter + timedelta(days=48), "vigil-of-pentecost", "Easter +48")
    year.put(a.pentecost, "pentecost", "Easter +49")
    for step, key in (
        (1, "pentecost-monday"),
        (2, "pentecost-tuesday"),
        (3, "pentecost-ember-wednesday"),
        (4, "pentecost-thursday"),
        (5, "pentecost-ember-friday"),
        (6, "pentecost-ember-saturday"),
    ):
        year.put(a.pentecost + timedelta(days=step), key, f"Pentecost +{step}")

    # Sundays after Pentecost: Trinity is the first, the Sunday before Advent
    # the last, and the twenty-fourth formulary always keeps the last place.
    after = (a.sunday_before_advent - a.pentecost).days // 7
    year.put(a.trinity, "trinity", "Easter +56")
    year.put(
        a.trinity,
        "mass-of-the-first-sunday-after-pentecost",
        "Easter +56; the Missal's own formulary for the first Sunday after "
        "Pentecost, whose slot Trinity Sunday occupies",
    )
    year.governs(
        a.trinity,
        "mass-of-the-first-sunday-after-pentecost",
        FERIAL_RULE
        + "the first Sunday after Pentecost, whose own formulary the Missal "
        "prints for the ferias of the week that follows it, Trinity Sunday "
        "having taken the Sunday",
    )
    corpus_thursday, corpus_sunday = TERRITORIAL_OPTIONS["corpus-christi"]
    year.put(a.corpus_christi_thursday, "corpus-christi", "Easter +60", corpus_thursday)
    year.put(a.corpus_christi_sunday, "corpus-christi", "Easter +63", corpus_sunday)
    year.put(
        easter + timedelta(days=68),
        "sacred-heart",
        "Easter +68, the Friday after the second Sunday after Pentecost",
    )

    # General rubric 17 assigns these two to a Sunday outright, and neither has
    # an ordinal position in the temporal cycle to be reached by. The Holy Name
    # is the one rule here whose result is not always a Sunday: where no Sunday
    # falls between 2 and 5 January the feast keeps 2 January, whatever day that
    # is, in 43 of the 101 years this browser serves.
    year.put(
        last_sunday_of_month(ending, 10),
        "christ-the-king",
        "general rubric 17 d: the last Sunday of October",
    )
    holy_name = next(
        (day for day in (date(ending, 1, n) for n in range(2, 6)) if day.weekday() == 6),
        date(ending, 1, 2),
    )
    year.put(
        holy_name,
        "most-holy-name-of-jesus",
        "general rubric 17 a: the Sunday falling 2-5 January, else 2 January"
        if holy_name.weekday() == 6
        else "general rubric 17 a: no Sunday falls 2-5 January this year, so 2 January",
    )
    # Where that Sunday is reached, it is the last Sunday before the Epiphany,
    # and a feria after it has no preceding Sunday whose Mass this index
    # carries: the Holy Name has taken the day, and the Mass of the dominica it
    # displaced is not printed. `resolve_ferial` therefore emits nothing for
    # those ferias, and the refusal is declared here rather than left as a
    # silent hole in `ferial_formulary`.
    if holy_name.weekday() == 6 and holy_name < date(ending, 1, 5):
        year.refuse(
            "the ferial Mass from "
            + (holy_name + timedelta(days=1)).isoformat()
            + " to "
            + date(ending, 1, 5).isoformat(),
            "the Most Holy Name of Jesus occupies the Sunday those ferias "
            "follow, and RGMR 299 gives them the Mass of the preceding "
            "Sunday, which this calendar index does not carry; borrowing the "
            "feast's own Mass instead would decide by preference what no "
            "rubric read here decides",
        )

    # The Ember Days of September follow the third Sunday of September, reckoned
    # by general rubric 19. This is a Sunday of the civil month, not an offset
    # from Easter, so it is computed on its own anchor.
    september_3 = nth_sunday_of_month(ending, 9, 3)
    for offset, name in EMBER_DAYS:
        year.put(
            september_3 + timedelta(days=offset),
            f"september-ember-{name}",
            f"third Sunday of September +{offset}",
        )

    resumed = max(after - 24, 0)
    for slot in range(2, min(23, after - 1) + 1):
        when = a.pentecost + timedelta(days=7 * slot)
        # Slot 2 is the Sunday a transferred Body and Blood of Christ occupies.
        mark = corpus_thursday if slot == 2 else None
        year.put(when, f"pentecost-{slot}", f"slot {slot} of {after} Sundays after Pentecost", mark)
        year.governs(when, f"pentecost-{slot}", FERIAL_RULE + f"Sunday {slot} after Pentecost")
    for index, ordinal in enumerate(range(7 - resumed, 7)):
        slot = 24 + index
        year.put(
            a.pentecost + timedelta(days=7 * slot),
            f"resumed-epiphany-{ordinal}",
            f"resumption slot {slot} of {after} Sundays after Pentecost",
        )
        year.governs(
            a.pentecost + timedelta(days=7 * slot),
            f"resumed-epiphany-{ordinal}",
            FERIAL_RULE
            + f"slot {slot} after Pentecost, which resumes Sunday {ordinal} "
            "after the Epiphany",
        )
    year.put(
        a.sunday_before_advent,
        "last-sunday-after-pentecost",
        "the Sunday before the First Sunday of Advent; the twenty-fourth "
        "formulary always keeps the last place",
    )
    year.governs(
        a.sunday_before_advent,
        "last-sunday-after-pentecost",
        FERIAL_RULE + "the last Sunday after Pentecost",
    )
    if after == 23:
        year.put(a.sunday_before_advent, "pentecost-23", "slot 23 of 23 Sundays after Pentecost")
        year.governs(
            a.sunday_before_advent,
            "pentecost-23",
            FERIAL_RULE + "Sunday 23 after Pentecost",
        )
        year.refuse(
            "the last Sunday after Pentecost",
            "23 Sundays after Pentecost. "
            + GUIDANCE
            + " records that neither identified normative locus provides for the "
            "shortfall, so both the twenty-third and the twenty-fourth-and-last "
            "formulary are listed and neither is chosen",
        )

    year.facts = {
        "resumption_slots": resumed,
        "sundays_after_epiphany": count,
        "sundays_after_pentecost": after,
        "surplus": (6 - count) - resumed,
        "unused_after_epiphany": 6 - count,
    }

    year.seasons = [
        (a.begins, date(ending - 1, 12, 24), "advent"),
        (date(ending - 1, 12, 25), date(ending, 1, 5), "christmastide"),
        (date(ending, 1, 6), a.septuagesima - timedelta(days=1), "epiphanytide"),
        (a.septuagesima, a.ash_wednesday - timedelta(days=1), "septuagesima"),
        (a.ash_wednesday, passion - timedelta(days=1), "lent"),
        (passion, easter - timedelta(days=4), "passiontide"),
        (easter - timedelta(days=3), easter - timedelta(days=1), "triduum"),
        (easter, a.pentecost + timedelta(days=6), "paschaltide"),
        (a.trinity, a.last_day, "after-pentecost"),
    ]
    # Last, because it reads both the placements and the seasons above.
    year.resolve_ferial(FERIAL_SEASONS_1962)
    return year


def build_postconciliar(ending: int, known: set[str]) -> Year:
    year = Year("postconciliar", ending, known)
    a = year.anchors
    easter = a.easter

    year.put(a.begins, "advent-1", "the fourth Sunday before 25 December")
    for n in (2, 3, 4):
        year.put(
            a.begins + timedelta(days=7 * (n - 1)),
            f"advent-{n}",
            f"First Sunday of Advent +{7 * (n - 1)}",
        )
    year.put(a.christmas, "nativity", "25 December")

    within = sunday_after(a.christmas)
    if within <= date(ending - 1, 12, 31):
        year.put(
            within,
            "holy-family",
            "Universal Norms 6: the Sunday within the octave of the Nativity",
        )
    else:
        year.refuse(
            "holy-family",
            "25 December is a Sunday, so no Sunday falls within the octave, and "
            + GUIDANCE
            + " states no fallback date",
        )
    year.put(date(ending, 1, 1), "mary-mother-of-god", "1 January")

    fixed_option, moved_option = TERRITORIAL_OPTIONS["epiphany"]
    epiphany = date(ending, 1, 6)
    epiphany_sunday = sunday_on_or_before(date(ending, 1, 8))
    year.put(epiphany, "epiphany", "6 January", fixed_option)
    year.put(epiphany_sunday, "epiphany", "the Sunday falling 2-8 January", moved_option)
    # The Second Sunday after the Nativity occurs only where the Epiphany keeps
    # 6 January; where it is transferred it takes that Sunday.
    second = sunday_on_or_before(date(ending, 1, 5))
    if second >= date(ending, 1, 2):
        year.put(
            second,
            "second-sunday-after-nativity",
            "the Sunday falling 2-5 January",
            fixed_option,
        )

    # Universal Norms 6 and General Introduction to the Lectionary 104.1: the
    # Baptism is the Sunday after 6 January, or the Monday after a Sunday
    # Epiphany that falls on 7 or 8 January.
    baptism_fixed = sunday_after(epiphany)
    baptism_moved = (
        epiphany_sunday + timedelta(days=1)
        if epiphany_sunday >= date(ending, 1, 7)
        else baptism_fixed
    )
    if baptism_fixed == baptism_moved:
        year.put(baptism_fixed, "baptism-of-the-lord", "the Sunday after 6 January")
    else:
        year.put(baptism_fixed, "baptism-of-the-lord", "the Sunday after 6 January", fixed_option)
        year.put(
            baptism_moved,
            "baptism-of-the-lord",
            "the Monday after a Sunday Epiphany falling on 7 or 8 January",
            moved_option,
        )

    # Ordinary Time, anchored at both ends. The Sunday numbering is the same
    # under either Epiphany option, because both put the Second Sunday seven
    # days after the Sunday following 6 January.
    second_sunday = baptism_fixed + timedelta(days=7)
    sunday_before_lent = a.ash_wednesday - timedelta(days=3)
    last_before_lent = 2 + (sunday_before_lent - second_sunday).days // 7
    resumed = 34 - (a.sunday_before_advent - a.pentecost).days // 7
    for n in range(2, last_before_lent + 1):
        year.put(
            second_sunday + timedelta(days=7 * (n - 2)),
            f"ot-{n}",
            f"the Sunday of Ordinary Time week {n}, counted from the Baptism",
        )

    for week in (1, 2, 3, 4, 5):
        sunday = easter - timedelta(days=42 - 7 * (week - 1))
        year.put(sunday, f"lent-{week}", f"Easter -{(easter - sunday).days}")
    year.put(easter - timedelta(days=7), "palm-sunday", "Easter -7")
    year.put(easter - timedelta(days=3), "mass-of-the-lords-supper", "Easter -3")
    year.put(easter - timedelta(days=2), "good-friday", "Easter -2")
    year.put(easter - timedelta(days=1), "easter-vigil", "Easter -1")
    year.put(easter, "easter-sunday", "Easter")
    for n in (2, 3, 4, 5, 6):
        year.put(easter + timedelta(days=7 * (n - 1)), f"easter-{n}", f"Easter +{7 * (n - 1)}")

    ascension_thursday, ascension_sunday = TERRITORIAL_OPTIONS["ascension"]
    year.put(a.ascension_thursday, "ascension", "Easter +39", ascension_thursday)
    year.put(a.ascension_sunday, "easter-7", "Easter +42", ascension_thursday)
    year.put(a.ascension_sunday, "ascension", "Easter +42", ascension_sunday)
    year.put(a.pentecost, "pentecost", "Easter +49")
    year.put(a.trinity, "most-holy-trinity", "Universal Norms 6: the Sunday after Pentecost")

    corpus_thursday, corpus_sunday = TERRITORIAL_OPTIONS["corpus-christi"]
    year.put(a.corpus_christi_thursday, "corpus-christi", "Easter +60", corpus_thursday)
    year.put(a.corpus_christi_sunday, "corpus-christi", "Easter +63", corpus_sunday)

    for n in range(resumed + 2, 34):
        when = a.pentecost + timedelta(days=7 * (n - resumed))
        mark = corpus_thursday if n == resumed + 2 else None
        year.put(when, f"ot-{n}", f"the Sunday of Ordinary Time week {n}", mark)
    year.put(
        a.sunday_before_advent,
        "christ-the-king",
        "Universal Norms 6: the last Sunday in Ordinary Time, which is week 34",
    )

    # Three movables the Universal Norms do not date; the Missal's own temporal
    # cycle assigns them. The Sacred Heart falls at the same Easter offset in
    # both calendars, and the two placements are written separately on purpose:
    # they are different books assigning the same day, and one shared line would
    # make correcting either silently move both.
    year.put(
        a.easter + timedelta(days=50),
        "blessed-virgin-mary-mother-church",
        "the Monday after Pentecost, Easter +50",
    )
    year.put(
        a.easter + timedelta(days=68),
        "most-sacred-heart-jesus",
        "Easter +68, feria VI post dominicam secundam post Pentecosten",
    )
    year.put(
        a.easter + timedelta(days=69),
        "immaculate-heart-blessed-virgin-mary",
        "Easter +69, sabbato post dominicam secundam post Pentecosten",
    )

    weeks = 34 if resumed == last_before_lent + 1 else 33
    omitted = None if resumed == last_before_lent + 1 else last_before_lent + 1
    if resumed not in (last_before_lent + 1, last_before_lent + 2):
        year.refuse(
            "the Ordinary Time week count",
            f"the resumed week {resumed} is neither L+1 nor L+2 for L={last_before_lent}, "
            "which " + GUIDANCE + " does not provide for",
        )
    year.facts = {
        "baptism_of_the_lord": baptism_moved.isoformat(),
        "baptism_of_the_lord_january_6_form": baptism_fixed.isoformat(),
        "last_week_before_lent": last_before_lent,
        "omitted_week": omitted,
        "ordinary_time_weeks": weeks,
        "resumed_week": resumed,
    }

    # Ordinary Time week numbers, on the 6 January basis; the transferred form
    # moves only the first week's opening day, never a Sunday number.
    when = baptism_fixed + timedelta(days=1)
    while when < a.ash_wednesday:
        year.weeks[when] = 1 if when < second_sunday else 2 + (when - second_sunday).days // 7
        when += timedelta(days=1)
    when = a.pentecost + timedelta(days=1)
    while when <= a.last_day:
        year.weeks[when] = resumed + (when - a.pentecost).days // 7
        when += timedelta(days=1)

    year.seasons = [
        (a.begins, date(ending - 1, 12, 24), "advent"),
        (date(ending - 1, 12, 25), baptism_fixed, "christmas"),
        (baptism_fixed + timedelta(days=1), a.ash_wednesday - timedelta(days=1), "ordinary-time"),
        (a.ash_wednesday, easter - timedelta(days=8), "lent"),
        (easter - timedelta(days=7), easter - timedelta(days=4), "holy-week"),
        (easter - timedelta(days=3), easter - timedelta(days=1), "triduum"),
        (easter, a.pentecost, "easter"),
        (a.pentecost + timedelta(days=1), a.last_day, "ordinary-time"),
    ]
    return year


BUILDERS = {"roman-1962": build_1962, "postconciliar": build_postconciliar}
CYCLED = {"roman-1962": False, "postconciliar": True}


# --------------------------------------------------------------- calendar I/O


def temporal_base(root: Path, name: str) -> str:
    """The calendar whose temporal cycle computes this one's placements.

    guidance/recensions.md section 6 item 3 asks for `calendar-days` to compute
    placements per recension, or to say plainly that it cannot and that the
    placements are the base's. This is the second answer, made explicit: a
    recension has no year builder of its own and inherits the one belonging to
    the calendar it takes its text from.

    That is right for most of the year and WRONG for the days this recension
    exists to record. The pre-1955 Easter Vigil is a Saturday MORNING service and
    the base places it at night; `calendar-days` computes the date, not the hour,
    so the date it returns is correct and the hour is not its business — but a
    recension whose departures ever move a liturgy to another DATE would be
    placed wrongly here, silently. No such departure exists today, and the
    departure check is where one would have to be caught.
    """
    seen = [name]
    while name not in BUILDERS:
        found = _calendars.base_of(root, name)
        if not found or found in seen:
            break
        seen.append(found)
        name = found
    return name


def load_calendar(root: Path, name: str) -> dict:
    document = _calendars.load_document(root, name, effective=True)
    path = root / name / "propers.yaml"
    masses: dict[str, dict] = {}
    for section, body in sorted((document.get("sections") or {}).items()):
        for mass in (body or {}).get("masses") or []:
            if not isinstance(mass, dict) or not mass.get("key"):
                continue
            masses[str(mass["key"])] = {
                "key": str(mass["key"]),
                "name": mass.get("name"),
                "section": section,
                "rank": mass.get("rank"),
                "date": mass.get("date"),
            }
    if not masses:
        raise ValueError(f"{path}: carries no masses")
    builder = temporal_base(root, name)
    if builder not in BUILDERS:
        raise ValueError(f"{name}: no temporal cycle is implemented for this calendar")
    return {
        "calendar": document.get("calendar") or name,
        "directory": name,
        # The calendar whose year builder places these masses. It differs from
        # `directory` only for a recension, and it is recorded rather than
        # recomputed so that a caller can say whose arithmetic it is looking at.
        "builder": builder,
        "edition": document.get("edition"),
        "masses": masses,
        "keys": set(masses),
    }


def calendars(root: Path, only: str | None) -> list[str]:
    if not root.is_dir():
        raise ValueError(f"no calendar directory at {root}")
    found = sorted(p.name for p in root.iterdir() if (p / "propers.yaml").is_file())
    if only:
        if only not in found:
            raise ValueError(f"no calendar {only!r} under {root}; have {found}")
        return [only]
    if not found:
        raise ValueError(f"no calendar with a propers.yaml under {root}")
    return found


def fixed_dates(index: dict, civil_year: int) -> dict[date, list[dict]]:
    """Every mass the calendar pins to a civil date, placed in `civil_year`."""
    out: dict[date, list[dict]] = {}
    for mass in index["masses"].values():
        stamp = mass.get("date")
        if not stamp:
            continue
        try:
            month, day = (int(part) for part in str(stamp).split("-"))
            when = date(civil_year, month, day)
        except ValueError:
            # 29 February in a common year: the day does not exist, so nothing
            # is placed and nothing is invented.
            continue
        # One rule for the whole fixed-date layer, because the rule is the date
        # the entry is filed under and repeating it per mass would put the
        # calendar's whole sanctoral into every year's rule table.
        entry = {"key": mass["key"], "origin": "fixed-date", "rule": FIXED_DATE_RULE}
        option = FIXED_TERRITORIAL.get((index["builder"], mass["key"]))
        if option:
            entry["territorial"] = option
        out.setdefault(when, []).append(entry)
    return out


# ------------------------------------------------------------------- assembly


def build_years(index: dict, endings: list[int]) -> dict[int, Year]:
    builder = BUILDERS[index["builder"]]
    return {ending: builder(ending, index["keys"]) for ending in endings}


def owner_of(built: dict[int, Year], civil_year: int, when: date) -> Year:
    ending = built[civil_year]
    return ending if when <= ending.anchors.last_day else built[civil_year + 1]


def decorate(entry: dict, mass: dict) -> dict:
    out = dict(entry)
    out["name"] = mass["name"]
    out["section"] = mass["section"]
    if mass.get("rank"):
        out["rank"] = mass["rank"]
    return out


def candidates_for(index: dict, built: dict[int, Year], civil_year: int, when: date) -> tuple[Year, list[dict]]:
    owner = owner_of(built, civil_year, when)
    masses = index["masses"]
    found = [decorate(e, masses[e["key"]]) for e in owner.placements.get(when, [])]
    found += [
        decorate(e, masses[e["key"]])
        for e in index["fixed"].get(civil_year, {}).get(when, [])
    ]
    return owner, found


DAYS_NOTE = (
    "A civil date absent from `days` carries no mass in this calendar's index: "
    "the day is computed, and no formulary for it has been written. A date "
    "present carries one entry per candidate, in the order temporal-then-fixed-"
    "date; more than one entry means the day is unranked, in the sense of "
    "`precedence` above. `rule` indexes `rules`, which says how the date was "
    "derived; `territorial`, when present, names the option the candidate holds "
    "under and is absent when it holds under both. A candidate's `key` is a mass "
    "in this calendar's own propers structure, where its title and text live; the "
    "season and, in Ordinary Time, the week of any date are read from the spans "
    "in `liturgical_years`."
)


def year_document(index: dict, civil_year: int, built: dict[int, Year]) -> dict:
    rules: list[dict] = []
    seen: dict[tuple[str, str], int] = {}

    def rule_id(entry: dict) -> int:
        where = (entry["origin"], entry["rule"])
        if where not in seen:
            seen[where] = len(rules)
            rules.append({"origin": entry["origin"], "rule": entry["rule"]})
        return seen[where]

    days: dict[str, list[dict]] = {}
    ferial: dict[str, list[dict]] = {}
    appointed: dict[str, str] = {}
    when = date(civil_year, 1, 1)
    stop = date(civil_year, 12, 31)
    while when <= stop:
        owner, found = candidates_for(index, built, civil_year, when)
        if found:
            days[when.isoformat()] = [
                {"key": entry["key"], "rule": rule_id(entry)}
                | ({"territorial": entry["territorial"]} if entry.get("territorial") else {})
                for entry in found
            ]
            # Only where the day carries more than one entry is there anything
            # to settle, and only the commemorations settle it. A date absent
            # from this map has either one mass or two the calendar does not
            # choose between.
            if len(found) > 1:
                settled = appointed_of(found)
                if settled:
                    appointed[when.isoformat()] = settled
        borrowed = owner.ferial.get(when)
        if borrowed:
            ferial[when.isoformat()] = [
                {"key": entry["key"], "rule": rule_id({"origin": "ferial", "rule": entry["rule"]})}
                | ({"territorial": entry["territorial"]} if entry.get("territorial") else {})
                for entry in borrowed
            ]
        when += timedelta(days=1)

    name = index["directory"]
    document = {
        "advisory": ADVISORY,
        "appointed": appointed,
        "calendar": index["calendar"],
        "civil_year": civil_year,
        "days": days,
        "days_note": DAYS_NOTE,
        "edition": index["edition"],
        "guidance": GUIDANCE,
        "liturgical_years": [year_summary(built[e], index["builder"]) for e in sorted(built)],
        "precedence": {"note": PRECEDENCE_NOTE, "stated": False},
        "rules": rules,
        "schema": SCHEMA,
        "territorial": territorial_block(name),
    }
    # Carried only by a calendar whose own rubrics appoint one. The reformed
    # books give a weekday its own formulary and, in Ordinary Time, a choice
    # among several; nothing there points a weekday at the preceding Sunday, so
    # that calendar carries no such block rather than an empty one asserting
    # that it looked and found none.
    if ferial:
        document["ferial_formulary"] = ferial
        document["ferial_formulary_note"] = FERIAL_NOTE
    return document


def spans(runs: list[tuple[date, date, str]]) -> list[dict]:
    return [
        {"from": start.isoformat(), "season": name, "to": end.isoformat()}
        for start, end, name in runs
    ]


def week_spans(weeks: dict[date, int]) -> list[dict]:
    """The Ordinary Time weeks as contiguous runs, so no day carries its own."""
    out: list[dict] = []
    for when in sorted(weeks):
        number = weeks[when]
        if out and out[-1]["week"] == number and date.fromisoformat(out[-1]["to"]) == when - timedelta(days=1):
            out[-1]["to"] = when.isoformat()
            continue
        out.append({"from": when.isoformat(), "to": when.isoformat(), "week": number})
    return out


def year_summary(year: Year, calendar: str) -> dict:
    summary: dict[str, object] = {
        "anchors": year.anchors.as_json(),
        "begins": year.anchors.begins.isoformat(),
        "ends": year.anchors.last_day.isoformat(),
        "facts": year.facts,
        "label": f"Advent {year.anchors.begins.year} - November {year.ending}",
        "lectionary": None,
        "ordinary_time_weeks": week_spans(year.weeks),
        "seasons": spans(year.seasons),
        "unresolved": year.unresolved,
        "year": year.ending,
    }
    if CYCLED[calendar]:
        summary["lectionary"] = {
            "note": (
                "The cycle turns at the First Sunday of Advent and nowhere else. "
                "The weekday numeral is resolved independently of the Sunday "
                "letter and governs the Ordinary Time ferial course alone."
            ),
            "sunday": sunday_cycle(year.ending),
            "weekday": weekday_cycle(year.ending),
        }
    else:
        summary["lectionary_note"] = (
            "The 1962 system has no Lectionary cycle: formulary and readings are "
            "appointed together and repeat annually."
        )
    return summary


def territorial_block(calendar: str) -> dict:
    block: dict[str, object] = {"note": TERRITORIAL_NOTE}
    if calendar == "roman-1962":
        block["epiphany"] = {"computed": "6 January", "transferred_sunday_form": NO_TRANSFER_RULE}
    else:
        block["epiphany"] = {"options": list(TERRITORIAL_OPTIONS["epiphany"])}
    block["ascension"] = {"options": list(TERRITORIAL_OPTIONS["ascension"])}
    block["body_and_blood_of_christ"] = {"options": list(TERRITORIAL_OPTIONS["corpus-christi"])}
    return block


def with_fixed(index: dict, years: list[int]) -> dict:
    index["fixed"] = {y: fixed_dates(index, y) for y in years}
    return index


# ------------------------------------------------------------------- coverage


def coverage_of(index: dict, first: int, last: int) -> dict:
    name = index["directory"]
    built = build_years(index, list(range(first, last + 2)))
    with_fixed(index, list(range(first, last + 1)))
    masses = index["masses"]
    placed: dict[str, int] = {}
    total = resolved = empty = unranked = ferial = still_empty = 0
    empty_by_season: dict[str, int] = {}
    for civil_year in range(first, last + 1):
        when = date(civil_year, 1, 1)
        stop = date(civil_year, 12, 31)
        while when <= stop:
            owner, found = candidates_for(index, built, civil_year, when)
            borrowed = owner.ferial.get(when) or []
            total += 1
            # Counted apart from `placed` on purpose. `masses_never_placed`
            # answers "does a rule fix a date for this mass", and a ferial
            # formulary fixes no date for the mass it points at; folding the
            # two together would let a mass that nothing ever places stop being
            # reported because some feria borrows it.
            if borrowed:
                ferial += 1
            if found:
                resolved += 1
                for entry in found:
                    placed[entry["key"]] = placed.get(entry["key"], 0) + 1
            else:
                empty += 1
                if not borrowed:
                    still_empty += 1
                    season = owner.season_of(when) or "unassigned"
                    empty_by_season[season] = empty_by_season.get(season, 0) + 1
            if len(found) > 1:
                unranked += 1
            when += timedelta(days=1)

    never = [
        {
            "key": key,
            "name": mass["name"],
            "section": mass["section"],
            "why": UNPLACEABLE.get(
                (name, key), "no rule in " + GUIDANCE + " fixes a date for this mass"
            ),
        }
        for key, mass in sorted(masses.items())
        if key not in placed
    ]
    return {
        "calendar": index["calendar"],
        "dates": total,
        "dates_resolved": resolved,
        # `dates_unresolved` counts a date with no mass of its own, which is
        # what a mass index's coverage means. `dates_reaching_no_mass_at_all`
        # is the number a reader feels: a date with neither a mass of its own
        # nor a ferial formulary to take.
        "dates_unresolved": empty,
        "dates_unresolved_by_season": dict(sorted(empty_by_season.items())),
        "dates_reaching_no_mass_at_all": still_empty,
        "dates_with_a_ferial_formulary": ferial,
        "dates_with_unranked_candidates": unranked,
        "masses": len(masses),
        "masses_never_placed": never,
        "masses_placed": len(placed),
        "span": {"first": first, "last": last},
    }


