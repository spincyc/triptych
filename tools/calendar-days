    problems: list[str] = []
    for ending, (begins, ends, sunday, weekday) in sorted(WORKED_INTERVALS.items()):
        a = Anchors(ending)
        if a.begins.isoformat() != begins or a.last_day.isoformat() != ends:
            problems.append(
                f"{ending}: worked interval {begins}..{ends} but computed "
                f"{a.begins}..{a.last_day}"
