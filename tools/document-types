                "  main       -> main.tex       regions: body, apparatus?, preamble?  options: closing, front  slots: scriptural-date-location/section",
                "  synthesis  -> synthesis.tex  regions: body, opening, preamble?  options: closing  slots: scriptural-date-location/page",
                "  homily     -> homily.tex     regions: homily, apparatus?, opening?, preamble?  options: closing, title-block",
            ),
