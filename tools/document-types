#!/usr/bin/env python3
"""Instantiate document-type templates into leaf entrypoints and generated pages.

Usage: document-types {types,render,refresh} [options]

A document type is a directory under `src/common/document-types/`: a
`type.toml` and one TeX template per edition. A leaf opts in with a
`[document]` table in its `publication.toml`; its edition entrypoints and
every deterministic page its templates slot are then generated, never
authored. `refresh` writes them; `refresh --check` refuses any that differs
from its regeneration. `guidance/document-schemas.md` § Document types is the
convention.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

import _document_types as types  # noqa: E402
from _tooling import (  # noqa: E402
