    examples_live_on_the_verbs,
    print_json,
    run_verb_cli,
    with_examples,
)

ROOT = Path(__file__).resolve().parents[1]
PREFIX = "document-types error"

# Captured transcripts, never composed; see scripts/_tooling.py.
