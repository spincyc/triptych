#!/usr/bin/env python3
"""Serve selected native TeX PDFs from an isolated compiler deployment."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
from _native_print_service import main
from _tooling import Example

EXAMPLES = {
    "serve": (
        Example('tools/native-print-service serve --toolchain-id "$TRIPTYCH_PRINT_TOOLCHAIN"', (),
                "Starts a persistent loopback service; requires the deployed immutable renderer digest."),
        Example('tools/native-print-service serve --port 8081 --origin http://localhost:8000 --toolchain-id "$TRIPTYCH_PRINT_TOOLCHAIN"', (),
                "Starts a local preview service for the explicitly allowed browser origin."),
    ),
}

if __name__ == "__main__":
    raise SystemExit(main(examples=EXAMPLES))
