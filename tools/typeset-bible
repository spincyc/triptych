  \noindent\hspace{1.2em}{\small\itshape #3}\par\addvspace{0.15em}}
"""


def prose(text: str, where: str) -> list[str]:
    """A block of the plan's own prose as TeX paragraphs.

    The plan writes its long fields as YAML block scalars, where a blank line
    opens a paragraph and a leading indent marks a nested list. Both are kept:
    the omissions account in particular is an argument with structure, and
    flattening it would make the plan's statement of its own cost read as one
    undifferentiated wall.
    """
    lines: list[str] = []
    for block in text.strip().split("\n\n"):
        if not block.strip():
            continue
        indented = block.startswith((" ", "\t"))
        body = " ".join(part.strip() for part in block.splitlines() if part.strip())
        rendered = tex(body, where)
        if indented:
            lines.append(r"\par\noindent\hspace{1.2em}\begin{minipage}{\dimexpr\linewidth-1.2em}")
            lines.append(rendered)
            lines.append(r"\end{minipage}\par\addvspace{0.35em}")
        else:
            lines.append(r"\par %s\par\addvspace{0.35em}" % rendered)
    return lines


def render_plan_tex(volume: Volume, generator: str) -> tuple[str, dict[str, object]]:
    """The complete two-column TeX source for one plan volume, and its counts."""
    plan, edition = volume.plan, volume.edition
    substitutions = Substitutions()
    where = volume.id
    label = plan.label(volume.tier)
    lines: list[str] = [PREAMBLE, PLAN_PREAMBLE]
    heading = f"{plan.name}: the {label} track"
    lines.append(
        "\\pdfinfo{/Title (\\pdfescapestring{%s})"
        " /Subject (\\pdfescapestring{%s})"
        " /Creator (\\pdfescapestring{%s})}"
        % (
            pdf_string(f"{heading} ({edition.label})"),
            pdf_string(f"{plan.title}, {label} track, in {edition.label}"),
            pdf_string(generator),
        )
    )
    lines.append(r"\begin{document}")

    counts = volume.counts()
    lines.append(r"\onecolumn")
    lines.append(r"\thispagestyle{empty}")
    lines.append(r"\begin{center}")
    lines.append(r"{\LARGE\bfseries %s\par}" % tex(plan.name, where))
    if plan.subtitle:
        lines.append(r"\vspace{0.6em}")
        lines.append(r"{\large %s\par}" % tex(plan.subtitle, where))
    lines.append(r"\vspace{0.8em}")
    lines.append(r"{\Large %s\par}" % tex(f"The {label} track", where))
    lines.append(r"\vspace{0.4em}")
    lines.append(r"{\large %s\par}" % tex(edition.label, where))
    lines.append(r"\end{center}")
    lines.append(r"\vspace{1.2em}")

    lines.append(r"\subsection*{This track}")
    lines.extend(prose(plan.description(volume.tier), f"{where} tier"))
    lines.append(
        r"\noindent\textbf{Extent.} %d readings, %d chapters and %d verses of this "
        r"edition.\par\vspace{0.35em}"
        % (counts["readings"], counts["chapters"], counts["verses"])
    )

    lines.append(r"\subsection*{This edition}")
    for name, value in (
        ("Registered as", edition.id),
        ("Source record", edition.source_id),
        ("Publication", str(edition.record.get("publication", ""))),
        ("Date", str(edition.record.get("date", ""))),
        ("Language", edition.language),
        ("Chapter and verse numbering", edition.numbering),
        ("Psalter", edition.psalter),
        ("Psalm inscriptions", edition.psalm_titles),
    ):
        if not value:
            continue
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (tex(name, "field name"), tex(str(value), f"{where} {name}"))
        )

    lines.append(r"\subsection*{Rights}")
    for name in ("status", "jurisdiction", "basis"):
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (name.title(), tex(edition.rights[name], f"{where} rights {name}"))
        )
    lines.append(
        r"\noindent\small This notice states the rights of this edition alone, quoted "
        r"from the tracked artifact records of the very verse files set here. It does "
        r"not extend to any other edition. The plan itself, its periods, its titles "
        r"and its notes are project-created content; see the colophon."
        r"\par\vspace{0.35em}\normalsize"
    )

    lines.append(r"\subsection*{How this was made}")
    lines.append(
        r"\noindent The sequence is %s, read at its %s tier. The tiers nest: every "
        r"reading carries the tier at which it first appears and appears at no other, "
        r"so a tier is read by taking every reading at that tier or above, in order. "
        r"The text is the tracked per-book verse files of this edition under %s. "
        r"Nothing was retrieved, corrected or supplied while typesetting."
        r"\par\vspace{0.35em}"
        % (
            tex_path(plan_location(plan), "plan path"),
            tex(volume.tier, "tier"),
            tex_path(edition.location(), "artifact path"),
        )
    )
    lines.append(
        r"\noindent\textbf{Numbering.} The plan cites in %s numbering and this edition "
        r"prints %s. Where the two differ a reading is converted through the tracked "
        r"verse-level psalm concordance, and the reference this edition carries is "
        r"printed beside the one the plan cites. Where no correspondence is recorded "
        r"the reading is refused and says so, because a psalm reference that resolves "
        r"to a real verse of the wrong psalm cannot be told from a correct one."
        r"\par\vspace{0.35em}"
        % (
            tex(plan.numbering, "plan numbering"),
            tex(edition.numbering, "edition numbering"),
        )
    )

    refused = volume.refused
    lines.append(r"\subsection*{What this edition cannot carry}")
    if not refused:
        lines.append(
            r"\noindent Every reading of this track resolves in this edition."
            r"\par\vspace{0.35em}"
        )
    else:
        lines.append(
            r"\noindent %d of the %d readings of this track are refused here, and each "
            r"is refused in view at the place it would have stood. A refusal is a "
            r"result: it names a passage this edition divides or numbers differently, "
            r"and no text is offered in its place.\par\vspace{0.5em}"
            % (len(refused), counts["readings"])
        )
        for row in refused:
            lines.append(
                r"\noindent\small\textbf{%d. %s} (%s) --- %s\par\vspace{0.3em}\normalsize"
                % (
                    row["order"],
                    tex(str(row["title"]), where),
                    tex(str(row["cited"]), where),
                    tex(str(row["refused"]), where),
                )
            )

    # The body is built before the front matter closes, because the extent and
    # the substitution note can only be stated once the verses have been set.
    body: list[str] = []
    contents: list[str] = []
    for period, rows in volume.periods:
        period_label = str(period.get("label") or period.get("key") or "")
        body.append(r"\periodstart{%s}" % tex(period_label, f"{where} period"))
        for line in prose(str(period.get("summary") or ""), f"{where} period summary"):
            body.append(line)
        contents.append(
            r"\vspace{0.5em}\noindent\textsc{%s}\par\vspace{0.25em}"
            % tex(period_label, f"{where} period")
        )
        for row in rows:
            anchor = "rd:%d" % row["order"]
            body.append(
                r"\readingstart{%d}{%s}"
                % (row["order"], tex(str(row["title"]), where))
            )
            body.append(r"\label{%s}" % anchor)
            cited = str(row["cited"])
            here = str(row["here"])
            body.append(
                r"\citeline{%s}"
                % tex(cited if not here else f"{cited} \u2014 here {here}", where)
            )
            if row["note"]:
                for line in prose(str(row["note"]), f"{where} note"):
                    body.append(line)
            if row["refused"]:
                body.append(r"\refusalpara{%s}" % tex(str(row["refused"]), where))
            else:
                opened = None
                for token, number, verse, text in row["verses"]:
                    rendered = tex(text, f"{where} {token} {number}:{verse}", substitutions)
                    if (token, number) != opened:
                        opened = (token, number)
                        body.append("")
                        body.append(
                            r"\chapterstart{%s}{%s}"
                            % (number, tex(str(row["title"]), where))
                        )
                    body.append(r"\vn{%s}%s" % (verse, rendered))
            body.append("")
            contents.append(
                r"\readingline{%d}{%s}{%s}{%s}"
                % (
                    row["order"],
                    tex(str(row["title"]), where),
                    tex(cited, where),
                    anchor,
                )
            )

    substituted = substitutions.rows()
    if substituted:
        lines.append(r"\subsection*{Typesetting note}")
        lines.append(
            r"\noindent This track prints characters these fonts cannot set. They are "
            r"replaced, not dropped, and every replacement is listed here:"
            r"\par\vspace{0.35em}"
        )
        for row in substituted:
            lines.append(
                r"\noindent %s, replaced by \texttt{%s}: %d occurrence%s."
                r"\par\vspace{0.2em}"
                % (
                    row["codepoint"],
                    tex(str(row["replacement"]), "replacement"),
                    row["count"],
                    "" if row["count"] == 1 else "s",
                )
            )

    lines.append(
        r"\noindent\small Digest of the verse rows set, in the order set (SHA-256): "
        r"\texttt{%s}\par\normalsize" % volume.digest()
    )

    if plan.omissions:
        lines.append(r"\clearpage")
        lines.append(r"\subsection*{What this plan does not read}")
        lines.append(
            r"\noindent This account belongs at the front and not in a footnote. An "
            r"abridgement is defined by what it drops.\par\vspace{0.5em}"
        )
        lines.extend(prose(plan.omissions, f"{where} omissions"))

    lines.append(r"\clearpage")
    lines.append(r"\twocolumn")
    lines.append(r"\section*{The readings of this track}")
    lines.extend(contents)
    lines.append(r"\clearpage")
    lines.extend(body)

    lines.append(r"\par\addvspace{1.2\baselineskip}")
    lines.append(
        r"\noindent\small\textbf{Colophon.} Generated by %s from the tracked sources "
        r"of the Triptych repository. Project-created content, the plan among it, is "
        r"licensed CC BY 4.0 and the reusable infrastructure MIT; see \texttt{LICENSE} "
        r"and \texttt{THIRD\_PARTY.md}. The scripture text set here is not "
        r"project-owned expression: its rights are stated on the title page."
        r"\par\normalsize"
        % tex(generator, "generator")
    )
    lines.append(r"\end{document}")
    counts["substitutions"] = substituted
    return "\n".join(lines) + "\n", counts


def plan_location(plan: Plan) -> str:
    """The plan file as the PDF should name it, repository-relative where it is."""
    path = plan.path.resolve()
    return str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path)


def render_tex(edition: Edition, generator: str) -> tuple[str, dict[str, object]]:
    """The complete two-column TeX source for one edition, and its counts."""
    substitutions = Substitutions()
    label = tex(edition.label, f"{edition.id} label")
    title = tex(edition.edition, f"{edition.id} edition")
    lines: list[str] = [PREAMBLE]
    lines.append(
        "\\pdfinfo{/Title (\\pdfescapestring{%s})"
        " /Subject (\\pdfescapestring{%s})"
        " /Creator (\\pdfescapestring{%s})}"
        % (
            pdf_string(edition.edition),
            pdf_string(f"Complete text of {edition.label}"),
            pdf_string(generator),
        )
    )
    lines.append(r"\begin{document}")

    # Title page: what this is, where the text came from, and the rights that
    # govern this edition and no other.
    record = edition.record
    lines.append(r"\onecolumn")
    lines.append(r"\thispagestyle{empty}")
    lines.append(r"\begin{center}")
    lines.append(r"{\LARGE\bfseries %s\par}" % label)
    lines.append(r"\vspace{0.8em}")
    lines.append(r"{\large %s\par}" % title)
    lines.append(r"\vspace{0.4em}")
    lines.append(r"{\itshape The complete text of this edition\par}")
    lines.append(r"\end{center}")
    lines.append(r"\vspace{1.5em}")
    lines.append(r"\subsection*{This edition}")
    for name, value in (
        ("Registered as", edition.id),
        ("Source record", edition.source_id),
        ("Publication", str(record.get("publication", ""))),
        ("Date", str(record.get("date", ""))),
        ("Language", edition.language),
        ("Chapter and verse numbering", edition.numbering),
        ("Psalter", edition.psalter),
    ):
        if not value:
            continue
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (tex(name, "field name"), tex(value, f"{edition.id} {name}"))
        )

    lines.append(r"\subsection*{Rights}")
    lines.append(
        r"\noindent\textbf{Status.} %s\par\vspace{0.35em}"
        % tex(edition.rights["status"], f"{edition.id} rights status")
    )
    lines.append(
        r"\noindent\textbf{Jurisdiction.} %s\par\vspace{0.35em}"
        % tex(edition.rights["jurisdiction"], f"{edition.id} rights jurisdiction")
    )
    lines.append(
        r"\noindent\textbf{Basis.} %s\par\vspace{0.35em}"
        % tex(edition.rights["basis"], f"{edition.id} rights basis")
    )
    lines.append(
        r"\noindent\small This notice states the rights of this edition alone, quoted "
        r"from the tracked artifact records of the very verse files set here. It does "
        r"not extend to any other edition.\par\vspace{0.35em}\normalsize"
    )
    lines.append(r"\subsection*{How this was made}")
    lines.append(
        r"\noindent The text is the tracked per-book verse files of this edition under "
        r"%s. Each book is identified by that edition's own "
        r"\texttt{book-index.tsv}, and every row of a verse file must carry the book "
        r"token the index registers for it. Nothing was retrieved, corrected or "
        r"supplied while typesetting; the chapter and verse numbers are the edition's "
        r"own.\par\vspace{0.35em}"
        % tex_path(edition.location(), "artifact path")
    )
    counts: dict[str, object] = {
        "books": len(edition.books),
        "chapters": sum(
            len({chapter for chapter, _, _ in book.verses}) for book in edition.books
        ),
        "verses": sum(len(book.verses) for book in edition.books),
    }

    # The body is built before the front matter is finished, because the
    # typesetting note can only name substitutions once they have been counted.
    body: list[str] = []
    contents: list[str] = []
    division = None
    for book in edition.books:
        if book.testament != division:
            division = book.testament
            heading = TESTAMENTS.get(division, division.replace("-", " ").title())
            body.append(r"\divisionstart{%s}" % tex(heading, "division"))
            contents.append(
                r"\vspace{0.5em}\noindent\textsc{%s}\par\vspace{0.25em}"
                % tex(heading, "division")
            )
        anchor = f"bk:{book.ordinal}"
        body.append(
            r"\bookstart{%s}{%s}"
            % (
                tex(book.title, f"{book.token} title"),
                tex(book.name, f"{book.token} name"),
            )
        )
        body.append(r"\label{%s}" % anchor)
        contents.append(
            r"\bookline{%s}{%s}{%s}"
            % (
                tex(book.token, f"{book.token} token"),
                tex(book.title, f"{book.token} title"),
                anchor,
            )
        )
        chapter = None
        for number, verse, text in book.verses:
            rendered = tex(text, f"{book.token} {number}:{verse}", substitutions)
            if number != chapter:
                chapter = number
                body.append("")
                body.append(
                    r"\chapterstart{%s}{%s %s}"
                    % (number, tex(book.name, f"{book.token} name"), number)
                )
            body.append(r"\vn{%s}%s" % (verse, rendered))
        body.append("")

    substituted = substitutions.rows()
    if substituted:
        lines.append(r"\subsection*{Typesetting note}")
        lines.append(
            r"\noindent This edition prints characters these fonts cannot set. They "
            r"are replaced, not dropped, and every replacement is listed here:"
            r"\par\vspace{0.35em}"
        )
        for row in substituted:
            lines.append(
                r"\noindent %s, replaced by \texttt{%s}: %d occurrence%s."
                r"\par\vspace{0.2em}"
                % (
                    row["codepoint"],
                    tex(str(row["replacement"]), "replacement"),
                    row["count"],
                    "" if row["count"] == 1 else "s",
                )
            )

    lines.append(r"\subsection*{Extent}")
    lines.append(
        r"\noindent %d books, %d chapters and %d verses.\par\vspace{0.35em}"
        % (counts["books"], counts["chapters"], counts["verses"])
    )
    lines.append(
        r"\noindent\small Digest of the verse rows set, in the order set (SHA-256): "
        r"\texttt{%s}\par\normalsize" % edition.digest()
    )
    lines.append(r"\clearpage")
    lines.append(r"\twocolumn")
    lines.append(r"\section*{The books of this edition}")
    lines.extend(contents)
    lines.append(r"\clearpage")
    lines.extend(body)

    # Colophon: the repository's own boundary, which the rights notice on the
    # title page qualifies for this text and never replaces.
    lines.append(r"\par\addvspace{1.2\baselineskip}")
    lines.append(
        r"\noindent\small\textbf{Colophon.} Generated by %s from the tracked sources "
        r"of the Triptych repository. Project-created content is licensed CC BY 4.0 "
        r"and the reusable infrastructure MIT; see \texttt{LICENSE} and "
        r"\texttt{THIRD\_PARTY.md}. The scripture text set here is not project-owned "
        r"expression: its rights are stated on the title page.\par\normalsize"
        % tex(generator, "generator")
    )
    lines.append(r"\end{document}")
    counts["substitutions"] = substituted
    return "\n".join(lines) + "\n", counts


def destination(out: Path) -> Path:
    """Refuse an output directory that would put a build artifact in a source tree."""
    resolved = out.resolve()
    if resolved.is_relative_to(ROOT) and not resolved.is_relative_to(WRITABLE_ROOT):
        raise ValueError(
            f"{resolved} is inside this repository but not under {WRITABLE_ROOT}; "
            "a rendered bible is a build artifact"
        )
    return resolved


def write(path: Path, content: str) -> bool:
    """Write only when the bytes change, so an unchanged edition rebuilds nothing."""
    encoded = content.encode("utf-8")
    if path.exists() and path.read_bytes() == encoded:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp")
    temporary.write_bytes(encoded)
    temporary.replace(path)
    return True


def selected(arguments: argparse.Namespace) -> list[str]:
    registered = registry()
    if arguments.bible:
        entry(registered, arguments.bible)
        return [arguments.bible]
    return publishable(registered)


def load(name: str, source_root: Path) -> Edition:
    edition = Edition(name, entry(registry(), name), source_root)
    edition.load()
    return edition


def chosen(arguments: argparse.Namespace) -> list[tuple[Plan, str, str]]:
    """Which plan volumes this invocation names, or none for edition mode.

    A volume is named by one id — plan, tier and edition run together — because
    that id is also its file name, and a Make rule that has the file name has to
    be able to ask for exactly that volume without taking the id apart. Taking
    it apart is not safe anyway: every part of it may carry a hyphen. It is
    matched against the volumes the plans actually declare instead.
    """
    if not (arguments.plan or arguments.volume):
        return []
    available = [
        (plan, tier, bible)
        for plan in plans(Path(arguments.plan_root))
        for tier, bible in volumes(plan)
    ]
    if arguments.volume:
        found = [row for row in available if volume_id(*row) == arguments.volume]
        if not found:
            raise KeyError(
                f"no plan volume {arguments.volume!r}; known: "
                + ", ".join(sorted(volume_id(*row) for row in available))
            )
        return found
    wanted = [row for row in available if row[0].id == arguments.plan]
    if not wanted:
        raise KeyError(
            f"no abridged plan {arguments.plan!r}; known: "
            + ", ".join(sorted({plan.id for plan, _, _ in available}))
        )
    if arguments.bible:
        entry(registry(), arguments.bible)
        wanted = [row for row in wanted if row[2] == arguments.bible]
    return wanted


def volume_row(
    plan: Plan, tier: str, name: str, source_root: Path
) -> tuple[Volume, dict[str, object]]:
    volume = Volume(plan, tier, name, source_root)
    _, counts = render_plan_tex(volume, GENERATOR)
    return volume, counts


def summarise(volume: Volume, counts: dict[str, object], arguments) -> dict[str, object]:
    return {
        "id": volume.id,
        "bible": volume.edition.id,
        "chapters": counts["chapters"],
        "digest": volume.digest(),
        "plan": volume.plan.id,
        "readings": counts["readings"],
        "refused": (
            [
                {
                    "order": row["order"],
                    "reason": row["refused"],
                    "reference": row["cited"],
                    "title": row["title"],
                }
                for row in volume.refused
            ]
            if arguments.verbose
            else counts["refused"]
        ),
        "rights_jurisdiction": volume.edition.rights["jurisdiction"],
        "rights_status": volume.edition.rights["status"],
        "substitutions": counts["substitutions"],
        "tier": volume.tier,
        "verses": counts["verses"],
    }


GENERATOR = "tools/typeset-bible"


def run_list(arguments: argparse.Namespace) -> dict[str, object]:
    registered = registry()
    if arguments.plan or arguments.volume:
        return {
            "volumes": [
                {
                    "id": volume_id(plan, tier, name),
                    "bible": name,
                    "label": str(registered[name]["label"]),
                    "plan": plan.id,
                    "readings": len(plan.at(tier)),
                    "tier": tier,
                    "track": plan.label(tier),
                }
                for plan, tier, name in chosen(arguments)
            ],
            "refused": sorted(set(registered) - set(publishable(registered))),
            "status": "ok",
        }
    names = publishable(registered)
    return {
        "editions": [
            {
                "id": name,
                "label": str(registered[name]["label"]),
                "rights": str(registered[name]["rights"]),
            }
            for name in names
        ],
        "refused": sorted(set(registered) - set(names)),
        "status": "ok",
    }


def run_check(arguments: argparse.Namespace) -> dict[str, object]:
    """Prove every selected volume can be set, without writing anything."""
    registered = registry()
    source_root = Path(arguments.source_root)
    wanted = chosen(arguments)
    if wanted:
        return {
            "volumes": [
                summarise(*volume_row(plan, tier, name, source_root), arguments)
                for plan, tier, name in wanted
            ],
            "refused": sorted(set(registered) - set(publishable(registered))),
            "status": "ok",
        }
    editions: list[dict[str, object]] = []
    for name in selected(arguments):
        edition = load(name, source_root)
        _, counts = render_tex(edition, GENERATOR)
        editions.append(
            {
                "id": name,
                "books": counts["books"],
                "chapters": counts["chapters"],
                "digest": edition.digest(),
                "rights_jurisdiction": edition.rights["jurisdiction"],
                "rights_status": edition.rights["status"],
                "substitutions": counts["substitutions"],
                "verses": counts["verses"],
            }
        )
    return {
        "editions": editions,
        "refused": sorted(set(registered) - set(publishable(registered))),
        "status": "ok",
    }


def run_render(arguments: argparse.Namespace) -> dict[str, object]:
    source_root = Path(arguments.source_root)
    # The output directory is resolved before an edition is loaded, and the
    # edition is refused before the directory is created, so a refused edition
    # leaves nothing behind at all.
    out = destination(Path(arguments.out))
    written: list[dict[str, object]] = []
    wanted = chosen(arguments)
    if wanted:
        for plan, tier, name in wanted:
            volume = Volume(plan, tier, name, source_root)
            content, counts = render_plan_tex(volume, GENERATOR)
            target = out / f"{volume.id}.tex"
            written.append(
                {
                    **summarise(volume, counts, arguments),
                    "changed": write(target, content),
                    "path": str(target),
                }
            )
        return {"rendered": written, "status": "ok"}
    for name in selected(arguments):
        edition = load(name, source_root)
        content, counts = render_tex(edition, GENERATOR)
        target = out / f"{name}.tex"
        changed = write(target, content)
        written.append(
            {
                "id": name,
                "books": counts["books"],
                "changed": changed,
                "chapters": counts["chapters"],
                "path": str(target),
                "substitutions": counts["substitutions"],
                "verses": counts["verses"],
            }
        )
    return {"rendered": written, "status": "ok"}


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("typeset-bible error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    rows = (
        list(payload.get("editions") or [])
        + list(payload.get("volumes") or [])
        + list(payload.get("rendered") or [])
    )
    if arguments.format == "ids":
        for row in rows:
            print(row["id"])
        return 0
    for row in payload.get("volumes") or []:
        print_volume(row)
    for row in payload.get("editions") or []:
        if "verses" in row:
            print(
                f"{row['id']}: {row['books']} books, {row['chapters']} chapters, "
                f"{row['verses']} verses "
                f"({row['rights_status']}, {row['rights_jurisdiction']})"
            )
        else:
            print(f"{row['id']}: {row['label']} ({row['rights']})")
        for substitution in row.get("substitutions") or []:
            print(
                f"  substituted {substitution['codepoint']} "
                f"-> {substitution['replacement']} x{substitution['count']}"
            )
    for row in payload.get("rendered") or []:
        state = "written" if row["changed"] else "unchanged"
        if "readings" in row:
            print(f"{row['id']}: {state} {row['path']}")
            print_volume(row, indent="  ")
            continue
        print(
            f"{row['id']}: {state} {row['path']} "
            f"({row['books']} books, {row['verses']} verses)"
        )
        for substitution in row.get("substitutions") or []:
            print(
                f"  substituted {substitution['codepoint']} "
                f"-> {substitution['replacement']} x{substitution['count']}"
            )
    for name in payload.get("refused") or []:
        print(f"refused (not publishable): {name}")
    return 0


def print_volume(row: dict, indent: str = "") -> None:
    """One plan volume, with its refusals named rather than only counted.

    The count leads because a track that refuses nothing should say so in one
    line. Where there are refusals they are the part worth reading: each names a
    passage this edition divides or numbers differently, and the whole point of
    printing them is that nobody should have to notice a missing reading.
    """
    refused = row.get("refused")
    tally = len(refused) if isinstance(refused, list) else refused
    if "label" in row and "readings" in row and "verses" not in row:
        print(
            f"{indent}{row['id']}: {row['track']} track of {row['plan']}, "
            f"{row['readings']} readings ({row['label']})"
        )
        return
    print(
        f"{indent}{row['id']}: {row['readings']} readings, {row['chapters']} chapters, "
        f"{row['verses']} verses, {tally} refused "
        f"({row['rights_status']}, {row['rights_jurisdiction']})"
    )
    if isinstance(refused, list):
        for entry_row in refused:
            print(
                f"{indent}  refused {entry_row['order']} "
                f"{entry_row['title']} ({entry_row['reference']}): {entry_row['reason']}"
            )
    for substitution in row.get("substitutions") or []:
        print(
            f"{indent}  substituted {substitution['codepoint']} "
            f"-> {substitution['replacement']} x{substitution['count']}"
        )


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--bible", default=None, help="one edition id; the default is every publishable one"
    )
    shared.add_argument(
        "--plan", default=None, help="one abridged plan id; sets its volumes instead of a bible"
    )
    shared.add_argument(
        "--volume", default=None, help="one plan volume id, as `list --plan ID --format ids` prints"
    )
    shared.add_argument(
        "--plan-root", default=str(PLAN_ROOT), help="directory of tracked abridged plans"
    )
    shared.add_argument(
        "--source-root", default=str(SOURCE_ROOT), help="source library works root"
    )
    shared.add_argument("--out", default=str(DEFAULT_OUT), help="where `render` writes TeX")
    shared.add_argument(
        "--verbose", action="store_true", help="name every refused reading instead of counting"
    )
    shared.add_argument(
        "--format", choices=("text", "json", "ids"), default="text", help="output form"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="typeset-bible",
        description="Typeset a publishable bible edition's complete text as two-column TeX.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "typeset-bible")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("list", help="the editions that may be typeset", parents=[shared]),
        EXAMPLES["list"],
    )
    with_examples(
        sub.add_parser("check", help="prove an edition can be set, writing nothing", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("render", help="write the two-column TeX source", parents=[shared]),
        EXAMPLES["render"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={"list": run_list, "check": run_check, "render": run_render},
        renderer=render,
        prefix="typeset-bible",
        argv=argv,
        # The read-only verb is the default: a bare invocation reports what may
        # be typeset rather than writing a thousand pages of TeX.
        default_verb="list",
        dependency_message="install PyYAML (requirements-tools.txt) to set a plan volume",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
