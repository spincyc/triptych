def prose(text: str, where: str) -> list[str]:
    """A block of the plan's own prose as TeX paragraphs.

    The plan writes its long fields as YAML block scalars, where a blank line
    opens a paragraph and a leading indent marks a nested list. Both are kept:
    the omissions account in particular is an argument with structure, and
    flattening it would make the plan's statement of its own cost read as one
    undifferentiated wall.
    """
    lines: list[str] = []
    for block in text.strip().split("\n\n"):
        if not block.strip():
            continue
        indented = block.startswith((" ", "\t"))
        body = " ".join(part.strip() for part in block.splitlines() if part.strip())
        rendered = tex(body, where)
        if indented:
            lines.append(r"\par\noindent\hspace{1.2em}\begin{minipage}{\dimexpr\linewidth-1.2em}")
            lines.append(rendered)
            lines.append(r"\end{minipage}\par\addvspace{0.35em}")
        else:
            lines.append(r"\par %s\par\addvspace{0.35em}" % rendered)
    return lines


def render_plan_tex(volume: Volume, generator: str) -> tuple[str, dict[str, object]]:
    """The complete two-column TeX source for one plan volume, and its counts."""
    plan, edition = volume.plan, volume.edition
    substitutions = Substitutions()
    paragraphs = volume.paragraphs
    # Counted as they are set rather than taken from the table. The table
    # describes the whole edition; this volume prints part of it, and a note
    # claiming the edition's total would be a true number about the wrong thing.
    used: dict[tuple[str, int, int], str] = {}
    where = volume.id
    label = plan.label(volume.tier)
    lines: list[str] = [PREAMBLE, PLAN_PREAMBLE]
    track = plan.track(volume.tier)
    heading = f"{plan.name}: {track[0].lower()}{track[1:]}"
    lines.append(
        "\\pdfinfo{/Title (\\pdfescapestring{%s})"
        " /Subject (\\pdfescapestring{%s})"
        " /Creator (\\pdfescapestring{%s})}"
        % (
            pdf_string(f"{heading} ({edition.label})"),
            pdf_string(f"{plan.title}, {track}, in {edition.label}"),
            pdf_string(generator),
        )
    )
    lines.append(r"\begin{document}")

    counts = volume.counts()

    # The half-title, and nothing else on it. What the book is, which track of
    # it this is, and which edition carries the text: five lines. Everything
    # that used to stand here — the edition record, the rights notice, the
    # account of the making, the index of refusals and the colophon — is now an
    # appendix, in that order, at the back.
    lines.append(r"\onecolumn")
    lines.append(r"\thispagestyle{empty}")
    lines.append(r"\vspace*{0.22\textheight}")
    lines.append(r"\begin{center}")
    lines.append(r"{\fontsize{30}{34}\selectfont\scshape %s\par}" % tex(plan.name, where))
    if plan.subtitle:
        lines.append(r"\vspace{1.1em}")
        lines.append(
            r"{\large\itshape %s\par}" % tex(plan.subtitle, where)
        )
    lines.append(r"\vspace{2.0em}")
    lines.append(r"\titlerule\par")
    lines.append(r"\vspace{2.0em}")
    lines.append(r"{\Large %s\par}" % tex(track, where))
    lines.append(r"\vspace{0.9em}")
    lines.append(
        r"{\large\itshape %s\par}"
        % tex("%d readings" % counts["readings"], where)
    )
    lines.append(r"\vspace{3.2em}")
    lines.append(r"{\large %s\par}" % tex(edition.label, where))
    lines.append(r"\end{center}")
    lines.append(r"\vfill")
    lines.append(r"\clearpage")

    # One page of orientation before the readings: what this track is, and what
    # the plan does not read. Both belong at the front — the first because a
    # reader opening the book needs it, the second because an abridgement is
    # defined by what it drops and burying that at the back would be a way of
    # not saying it.
    lines.append(r"\thispagestyle{empty}")
    lines.append(r"\section*{This track}")
    lines.extend(prose(plan.description(volume.tier), f"{where} tier"))
    lines.append(
        r"\noindent\textbf{Extent.} %d readings, %d chapters and %d verses of this "
        r"edition.\par\vspace{0.35em}"
        % (counts["readings"], counts["chapters"], counts["verses"])
    )
    if volume.refused:
        lines.append(
            r"\noindent\textbf{Refused here.} %d of these readings this edition cannot "
            r"carry. Each is refused in view, at the place it would have stood, and "
            r"Appendix D indexes them.\par\vspace{0.35em}"
            % len(volume.refused)
        )

    if plan.omissions:
        lines.append(r"\section*{What this plan does not read}")
        lines.append(
            r"\noindent This account belongs at the front and not in a footnote. An "
            r"abridgement is defined by what it drops.\par\vspace{0.5em}"
        )
        lines.extend(prose(plan.omissions, f"{where} omissions"))

    # The body is built before the appendices close, because the extent and
    # the substitution note can only be stated once the verses have been set.
    body: list[str] = []
    contents: list[str] = []
    for period, rows in volume.periods:
        period_label = str(period.get("label") or period.get("key") or "")
        body.append(r"\periodstart{%s}" % tex(period_label, f"{where} period"))
        for line in prose(str(period.get("summary") or ""), f"{where} period summary"):
            body.append(line)
        contents.append(
            r"\vspace{0.5em}\noindent\textsc{%s}\par\vspace{0.25em}"
            % tex(period_label, f"{where} period")
        )
        for row in rows:
            anchor = "rd:%d" % row["order"]
            body.append(
                r"\readingstart{%d}{%s}"
                % (row["order"], tex(str(row["title"]), where))
            )
            body.append(r"\label{%s}" % anchor)
            cited = str(row["cited"])
            here = str(row["here"])
            body.append(
                r"\citeline{%s}"
                % tex(cited if not here else f"{cited} \u2014 here {here}", where)
            )
            if row["note"]:
                for line in prose(str(row["note"]), f"{where} note"):
                    body.append(line)
            if row["refused"]:
                body.append(r"\refusalpara{%s}" % tex(str(row["refused"]), where))
            else:
                opened = None
                for token, number, verse, text in row["verses"]:
                    rendered = tex(text, f"{where} {token} {number}:{verse}", substitutions)
                    if (token, number) != opened:
                        opened = (token, number)
                        body.append("")
                        body.append(
                            r"\chapterstart{%s}{%s}"
                            % (number, tex(str(row["title"]), where))
                        )
                    elif (token, number, verse) in paragraphs:
                        # A break the edition prints or the witnesses concur on.
                        # Never one composed here: `paragraphs` is empty unless
                        # the tracked tables supplied it.
                        used[(token, number, verse)] = paragraphs[(token, number, verse)]
                        body.append(r"\parbreak")
                    body.append(
                        r"\vn{%s}%s%s"
                        % (verse, printed_mark(used.get((token, number, verse))), rendered)
                    )
            body.append("")
            contents.append(
                r"\readingline{%d}{%s}{%s}{%s}"
                % (
                    row["order"],
                    tex(str(row["title"]), where),
                    tex(cited, where),
                    anchor,
                )
            )

    lines.append(r"\clearpage")
    lines.append(r"\twocolumn")
    lines.append(r"\section*{The readings of this track}")
    lines.extend(contents)
    lines.append(r"\clearpage")
    lines.extend(body)

    # ---- Appendices -------------------------------------------------------
    #
    # Everything that used to stand between the title and the first verse. It
    # moved because a reader opening a reading plan wants the readings, not a
    # data sheet; it did not shrink, and two parts of it must be checked
    # against that claim. The rights notice is quoted whole and still says what
    # it always said, that it covers this edition alone. And Appendix D is an
    # index of refusals, not a replacement for them: every refused reading is
    # still set in full at the place it would have stood, and the appendix says
    # so at its head, because a refusal printed only at the back would leave the
    # body indistinguishable from a plan that never appointed the reading.
    substituted = substitutions.rows()
    lines.append(r"\clearpage")
    lines.append(r"\onecolumn")
    # The running head is the reading, and there are no readings back here. Left
    # standing it would title the rights notice with whatever reading happened to
    # end the body.
    lines.append(r"\markright{Appendices}")
    lines.append(r"\section*{Appendices}")
    lines.append(
        r"\noindent The apparatus of this volume. It stands at the back so that the "
        r"readings can stand at the front; nothing has been shortened to put it here."
        r"\par\vspace{1.0em}"
    )

    lines.append(r"\subsection*{A. This edition}")
    for name, value in (
        ("Registered as", edition.id),
        ("Source record", edition.source_id),
        ("Publication", str(edition.record.get("publication", ""))),
        ("Date", str(edition.record.get("date", ""))),
        ("Language", edition.language),
        ("Chapter and verse numbering", edition.numbering),
        ("Psalter", edition.psalter),
        ("Psalm inscriptions", edition.psalm_titles),
    ):
        if not value:
            continue
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (tex(name, "field name"), tex(str(value), f"{where} {name}"))
        )

    lines.append(r"\subsection*{B. Rights}")
    for name in ("status", "jurisdiction", "basis"):
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (name.title(), tex(edition.rights[name], f"{where} rights {name}"))
        )
    lines.append(
        r"\noindent\small This notice states the rights of this edition alone, quoted "
        r"from the tracked artifact records of the very verse files set here. It does "
        r"not extend to any other edition. The plan itself, its periods, its titles "
        r"and its notes are project-created content; see the colophon."
        r"\par\vspace{0.35em}\normalsize"
    )

    lines.append(r"\subsection*{C. How this was made}")
    lines.append(
        r"\noindent The sequence is %s, read at its %s tier. The tiers nest: every "
        r"reading carries the tier at which it first appears and appears at no other, "
        r"so a tier is read by taking every reading at that tier or above, in order. "
        r"The text is the tracked per-book verse files of this edition under %s. "
        r"Nothing was retrieved, corrected or supplied while typesetting."
        r"\par\vspace{0.35em}"
        % (
            tex_path(plan_location(plan), "plan path"),
            tex(volume.tier, "tier"),
            tex_path(edition.location(), "artifact path"),
        )
    )
    lines.append(
        r"\noindent\textbf{Numbering.} The plan cites in %s numbering and this edition "
        r"prints %s. Where the two differ a reading is converted through the tracked "
        r"verse-level psalm concordance, and the reference this edition carries is "
        r"printed beside the one the plan cites. Where no correspondence is recorded "
        r"the reading is refused and says so, because a psalm reference that resolves "
        r"to a real verse of the wrong psalm cannot be told from a correct one."
        r"\par\vspace{0.35em}"
        % (
            tex(plan.numbering, "plan numbering"),
            tex(edition.numbering, "edition numbering"),
        )
    )
    lines.extend(paragraph_note(used))
    if substituted:
        lines.append(
            r"\noindent\textbf{Characters these fonts cannot set.} They are replaced, "
            r"not dropped, and every replacement is listed here."
            r"\par\vspace{0.25em}"
        )
        for row in substituted:
            lines.append(
                r"\noindent\hspace{1.2em}%s, replaced by \texttt{%s}: %d occurrence%s."
                r"\par\vspace{0.2em}"
                % (
                    row["codepoint"],
                    tex(str(row["replacement"]), "replacement"),
                    row["count"],
                    "" if row["count"] == 1 else "s",
                )
            )
    lines.append(
        r"\noindent\textbf{Digest.} Of the verse rows set, in the order set "
        r"(SHA-256): %s\par\vspace{0.35em}" % tex_digest(volume.digest())
    )

    refused = volume.refused
    lines.append(r"\subsection*{D. What this edition cannot carry}")
    if not refused:
        lines.append(
            r"\noindent Every reading of this track resolves in this edition."
            r"\par\vspace{0.35em}"
        )
    else:
        lines.append(
            r"\noindent %d of the %d readings of this track %s refused here. This is "
            r"an index and not the record: each one is refused \emph{in view}, in the "
            r"body of the volume, at the place it would have stood, and none of them "
            r"is printed only here. A refusal is a result. It names a passage this "
            r"edition divides or numbers differently, and no text is offered in its "
            r"place, because a reading printed nowhere cannot be told from a reading "
            r"the plan never appointed.\par\vspace{0.5em}"
            % (len(refused), counts["readings"], "is" if len(refused) == 1 else "are")
        )
        for row in refused:
            lines.append(
                r"\noindent\textbf{%d. %s} (%s), page \pageref{rd:%d} --- %s"
                r"\par\vspace{0.3em}"
                % (
                    row["order"],
                    tex(str(row["title"]), where),
                    tex(str(row["cited"]), where),
                    row["order"],
                    tex(str(row["refused"]), where),
                )
            )

    lines.append(r"\subsection*{E. Colophon}")
    lines.append(
        r"\noindent Generated by %s from the tracked sources of the Triptych "
        r"repository. Project-created content, the plan among it, is licensed CC BY "
        r"4.0 and the reusable infrastructure MIT; see \texttt{LICENSE} and "
        r"\texttt{THIRD\_PARTY.md}. The scripture text set here is not project-owned "
        r"expression: its rights are stated in Appendix B.\par"
        % tex(generator, "generator")
    )
    lines.append(r"\end{document}")
    counts["substitutions"] = substituted
    counts["paragraphs"] = paragraph_counts(used)
    return "\n".join(lines) + "\n", counts


def printed_mark(source: str | None) -> str:
    """The pilcrow, where this break is one the edition itself prints.

    The verse number comes first and the mark after it, which is where the
    standardized King James text sets it: `6 \u00b6 And God said`. A projected
    break returns nothing, so the two kinds are distinguishable at a glance
    rather than only in the appendix's totals.
    """
    return r"\printedmark{}" if source == paragraphs_module().PRINTED else ""


def paragraph_note(found: dict) -> list[str]:
    """What the volume says about its own paragraph breaks.

    It says it whether or not there are any, and the empty case is the one that
    matters: a volume set without paragraphs should state that its chapters run
    on, so that a reader does not take a wall of text for the edition's own
    setting. The wall *is* the edition's own setting, which is exactly the fact
    worth printing.
    """
    tally = paragraph_counts(found)
    if not tally["breaks"]:
        return [
            r"\noindent\textbf{Paragraphs.} None. This edition's tracked verse files "
            r"carry no paragraph structure, and this volume was set with the paragraph "
            r"projection off, so each chapter runs on as a single paragraph exactly as "
            r"the stored text does.\par\vspace{0.35em}"
        ]
    lines = [
        r"\noindent\textbf{Paragraphs.} %d paragraph breaks are set in this volume, "
        r"and not one of them was chosen while typesetting. The tracked verse files of "
        r"every edition in this library are one verse per row and carry no paragraph "
        r"structure at all; the markers their sources carried were dropped when the "
        r"text was derived. Where a break is printed here it comes from one of two "
        r"places, and both are tracked tables that can be read, counted and "
        r"regenerated.\par\vspace{0.35em}"
        % tally["breaks"]
    ]
    if tally["printed"]:
        lines.append(
            r"\noindent\hspace{1.2em}\textbf{%d printed}, and each is set with the "
            r"pilcrow \textparagraph{} that this edition's own text prints at that "
            r"point. These are the 2,970 pilcrows of the standardized King James "
            r"text, which run from Genesis 1:6 to Acts 20:36 and then stop, the "
            r"printers having abandoned them partway through Acts; the twenty-two "
            r"books after it carry none. Nothing is added by setting them: the "
            r"pilcrow is the edition's own character, dropped when the verse files "
            r"were derived and put back here.\par\vspace{0.35em}"
            % tally["printed"]
        )
    if tally["projected"]:
        module = paragraphs_module()
        concurring, positions = module.disagreement()
        lines.append(
            r"\noindent\hspace{1.2em}\textbf{%d projected.} No paragraph mark survives "
            r"for this edition there, so the break is projected from witnesses that "
            r"have one, under a rule rather than by hand: it is set only where every "
            r"witness able to carry that verse opens a paragraph at it, and at least "
            r"two do. The witnesses are %s. Where they disagree nothing is printed "
            r"--- and they disagree often, concurring at %d of the %d places where "
            r"any of them breaks, which is %.1f\%%. That refusal is deliberate. A "
            r"break resting on one witness alone would read as this edition's own "
            r"paragraphing, and it would not be.\par\vspace{0.35em}"
            % (
                tally["projected"],
                tex(" and ".join(module.witnesses()), "witnesses"),
                concurring,
                positions,
                100.0 * concurring / positions,
            )
        )
    if tally["printed"] and tally["projected"]:
        lines.append(
            r"\noindent\hspace{1.2em}So the two are told apart on the page and not "
            r"only in these totals. A paragraph opening with \textparagraph{} is this "
            r"edition's own; a paragraph opening with a plain indent is this "
            r"project's inference from the witnesses named above. The distinction is "
            r"the point of recording them apart, because a reader who cannot see it "
            r"has been handed the second as though it were the first."
            r"\par\vspace{0.35em}"
        )
    lines.append(
        r"\noindent\hspace{1.2em}Set \texttt{-{}-no-paragraphs} to remove every break "
        r"and set the text exactly as the stored verse files hold it, each chapter "
        r"running on as one paragraph. A mechanical review of this edition should use "
        r"it: with the projection on, what is under review is partly this projection. "
        r"It removes the paragraphing and nothing else: the verses set, their order "
        r"and their wording are identical either way. The pilcrows go with the "
        r"breaks, being paragraph marks themselves.\par\vspace{0.35em}"
    )
    return lines


def paragraph_counts(found: dict) -> dict[str, int]:
    module = paragraphs_module()
    return module.counts(found)


def plan_location(plan: Plan) -> str:
    """The plan file as the PDF should name it, repository-relative where it is."""
    path = plan.path.resolve()
    return str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path)


def render_tex(
    edition: Edition, generator: str, paragraphs: dict | None = None
) -> tuple[str, dict[str, object]]:
    """The complete two-column TeX source for one edition, and its counts."""
    substitutions = Substitutions()
    paragraphs = paragraphs or {}
    used: dict[tuple[str, int, int], str] = {}
    label = tex(edition.label, f"{edition.id} label")
    title = tex(edition.edition, f"{edition.id} edition")
    lines: list[str] = [PREAMBLE]
    lines.append(
        "\\pdfinfo{/Title (\\pdfescapestring{%s})"
        " /Subject (\\pdfescapestring{%s})"
        " /Creator (\\pdfescapestring{%s})}"
        % (
            pdf_string(edition.edition),
            pdf_string(f"Complete text of {edition.label}"),
            pdf_string(generator),
        )
    )
    lines.append(r"\begin{document}")

    # Half-title. Everything that used to follow it here is now an appendix at
    # the back, for the reason it is in a plan volume: a reader opening a bible
    # wants Genesis, and nothing on this page is a fact about Genesis.
    record = edition.record
    lines.append(r"\onecolumn")
    lines.append(r"\thispagestyle{empty}")
    lines.append(r"\vspace*{0.18\textheight}")
    lines.append(r"\begin{center}")
    lines.append(r"{\fontsize{30}{34}\selectfont\scshape %s\par}" % label)
    lines.append(r"\vspace{2.0em}")
    lines.append(r"\noindent\rule{0.34\textwidth}{0.4pt}\par")
    lines.append(r"\vspace{2.0em}")
    lines.append(r"{\large\itshape %s\par}" % title)
    lines.append(r"\vspace{0.9em}")
    lines.append(r"{\large The complete text of this edition\par}")
    lines.append(r"\end{center}")
    lines.append(r"\vfill")
    lines.append(r"\clearpage")
    counts: dict[str, object] = {
        "books": len(edition.books),
        "chapters": sum(
            len({chapter for chapter, _, _ in book.verses}) for book in edition.books
        ),
        "verses": sum(len(book.verses) for book in edition.books),
    }

    # The body is built before the front matter is finished, because the
    # typesetting note can only name substitutions once they have been counted.
    body: list[str] = []
    contents: list[str] = []
    division = None
    for book in edition.books:
        if book.testament != division:
            division = book.testament
            heading = TESTAMENTS.get(division, division.replace("-", " ").title())
            body.append(r"\divisionstart{%s}" % tex(heading, "division"))
            contents.append(
                r"\vspace{0.5em}\noindent\textsc{%s}\par\vspace{0.25em}"
                % tex(heading, "division")
            )
        anchor = f"bk:{book.ordinal}"
        body.append(
            r"\bookstart{%s}{%s}"
            % (
                tex(book.title, f"{book.token} title"),
                tex(book.name, f"{book.token} name"),
            )
        )
        body.append(r"\label{%s}" % anchor)
        contents.append(
            r"\bookline{%s}{%s}{%s}"
            % (
                tex(book.token, f"{book.token} token"),
                tex(book.title, f"{book.token} title"),
                anchor,
            )
        )
        chapter = None
        for number, verse, text in book.verses:
            rendered = tex(text, f"{book.token} {number}:{verse}", substitutions)
            if number != chapter:
                chapter = number
                body.append("")
                body.append(
                    r"\chapterstart{%s}{%s %s}"
                    % (number, tex(book.name, f"{book.token} name"), number)
                )
            elif (book.token, number, verse) in paragraphs:
                used[(book.token, number, verse)] = paragraphs[(book.token, number, verse)]
                body.append(r"\parbreak")
            body.append(
                r"\vn{%s}%s%s"
                % (verse, printed_mark(used.get((book.token, number, verse))), rendered)
            )
        body.append("")

    substituted = substitutions.rows()
    lines.append(r"\twocolumn")
    lines.append(r"\section*{The books of this edition}")
    lines.extend(contents)
    lines.append(r"\clearpage")
    lines.extend(body)

    lines.append(r"\clearpage")
    lines.append(r"\onecolumn")
    # The running head is the reading, and there are no readings back here. Left
    # standing it would title the rights notice with whatever reading happened to
    # end the body.
    lines.append(r"\markright{Appendices}")
    lines.append(r"\section*{Appendices}")
    lines.append(
        r"\noindent The apparatus of this volume. It stands at the back so that the "
        r"text can stand at the front; nothing has been shortened to put it here."
        r"\par\vspace{1.0em}"
    )
    lines.append(r"\subsection*{A. This edition}")
    for name, value in (
        ("Registered as", edition.id),
        ("Source record", edition.source_id),
        ("Publication", str(record.get("publication", ""))),
        ("Date", str(record.get("date", ""))),
        ("Language", edition.language),
        ("Chapter and verse numbering", edition.numbering),
        ("Psalter", edition.psalter),
        ("Extent", "%d books, %d chapters and %d verses"
         % (counts["books"], counts["chapters"], counts["verses"])),
    ):
        if not value:
            continue
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (tex(name, "field name"), tex(value, f"{edition.id} {name}"))
        )

    lines.append(r"\subsection*{B. Rights}")
    for name in ("status", "jurisdiction", "basis"):
        lines.append(
            r"\noindent\textbf{%s.} %s\par\vspace{0.35em}"
            % (name.title(), tex(edition.rights[name], f"{edition.id} rights {name}"))
        )
    lines.append(
        r"\noindent\small This notice states the rights of this edition alone, quoted "
        r"from the tracked artifact records of the very verse files set here. It does "
        r"not extend to any other edition.\par\vspace{0.35em}\normalsize"
    )

    lines.append(r"\subsection*{C. How this was made}")
    lines.append(
        r"\noindent The text is the tracked per-book verse files of this edition under "
        r"%s. Each book is identified by that edition's own "
        r"\texttt{book-index.tsv}, and every row of a verse file must carry the book "
        r"token the index registers for it. Nothing was retrieved, corrected or "
        r"supplied while typesetting; the chapter and verse numbers are the edition's "
        r"own.\par\vspace{0.35em}"
        % tex_path(edition.location(), "artifact path")
    )
    lines.extend(paragraph_note(used))
    if substituted:
        lines.append(
            r"\noindent\textbf{Characters these fonts cannot set.} They are replaced, "
            r"not dropped, and every replacement is listed here.\par\vspace{0.25em}"
        )
        for row in substituted:
            lines.append(
                r"\noindent\hspace{1.2em}%s, replaced by \texttt{%s}: %d occurrence%s."
                r"\par\vspace{0.2em}"
                % (
                    row["codepoint"],
                    tex(str(row["replacement"]), "replacement"),
                    row["count"],
                    "" if row["count"] == 1 else "s",
                )
            )
    lines.append(
        r"\noindent\textbf{Digest.} Of the verse rows set, in the order set "
        r"(SHA-256): %s\par\vspace{0.35em}" % tex_digest(edition.digest())
    )

    lines.append(r"\subsection*{D. Colophon}")
    lines.append(
        r"\noindent Generated by %s from the tracked sources of the Triptych "
        r"repository. Project-created content is licensed CC BY 4.0 and the reusable "
        r"infrastructure MIT; see \texttt{LICENSE} and \texttt{THIRD\_PARTY.md}. The "
        r"scripture text set here is not project-owned expression: its rights are "
        r"stated in Appendix B.\par"
        % tex(generator, "generator")
    )
    lines.append(r"\end{document}")
    counts["substitutions"] = substituted
    counts["paragraphs"] = paragraph_counts(used)
    return "\n".join(lines) + "\n", counts


def destination(out: Path) -> Path:
    """Refuse an output directory that would put a build artifact in a source tree."""
    resolved = out.resolve()
    if resolved.is_relative_to(ROOT) and not resolved.is_relative_to(WRITABLE_ROOT):
        raise ValueError(
            f"{resolved} is inside this repository but not under {WRITABLE_ROOT}; "
            "a rendered bible is a build artifact"
        )
    return resolved


def write(path: Path, content: str) -> bool:
    """Write only when the bytes change, so an unchanged edition rebuilds nothing."""
    encoded = content.encode("utf-8")
    if path.exists() and path.read_bytes() == encoded:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f"{path.name}.tmp")
    temporary.write_bytes(encoded)
    temporary.replace(path)
    return True


def selected(arguments: argparse.Namespace) -> list[str]:
    registered = registry()
    if arguments.bible:
        entry(registered, arguments.bible)
        return [arguments.bible]
    return publishable(registered)


def load(name: str, source_root: Path) -> Edition:
    edition = Edition(name, entry(registry(), name), source_root)
    edition.load()
    return edition


def chosen(arguments: argparse.Namespace) -> list[tuple[Plan, str, str]]:
    """Which plan volumes this invocation names, or none for edition mode.

    A volume is named by one id — plan, tier and edition run together — because
    that id is also its file name, and a Make rule that has the file name has to
    be able to ask for exactly that volume without taking the id apart. Taking
    it apart is not safe anyway: every part of it may carry a hyphen. It is
    matched against the volumes the plans actually declare instead.
    """
    if not (arguments.plan or arguments.volume):
        return []
    available = [
        (plan, tier, bible)
        for plan in plans(Path(arguments.plan_root))
        for tier, bible in volumes(plan)
    ]
    if arguments.volume:
        found = [row for row in available if volume_id(*row) == arguments.volume]
        if not found:
            raise KeyError(
                f"no plan volume {arguments.volume!r}; known: "
                + ", ".join(sorted(volume_id(*row) for row in available))
            )
        return found
    wanted = [row for row in available if row[0].id == arguments.plan]
    if not wanted:
        raise KeyError(
            f"no abridged plan {arguments.plan!r}; known: "
            + ", ".join(sorted({plan.id for plan, _, _ in available}))
        )
    if arguments.bible:
        entry(registry(), arguments.bible)
        wanted = [row for row in wanted if row[2] == arguments.bible]
    return wanted


def volume_row(
    plan: Plan, tier: str, name: str, source_root: Path, paragraphs: bool = True
) -> tuple[Volume, dict[str, object]]:
    volume = Volume(plan, tier, name, source_root, paragraphs)
    _, counts = render_plan_tex(volume, GENERATOR)
    return volume, counts


def summarise(volume: Volume, counts: dict[str, object], arguments) -> dict[str, object]:
    return {
        "id": volume.id,
        "bible": volume.edition.id,
        "chapters": counts["chapters"],
        "digest": volume.digest(),
        "plan": volume.plan.id,
        "readings": counts["readings"],
        "refused": (
            [
                {
                    "order": row["order"],
                    "reason": row["refused"],
                    "reference": row["cited"],
                    "title": row["title"],
                }
                for row in volume.refused
            ]
            if arguments.verbose
            else counts["refused"]
        ),
        "rights_jurisdiction": volume.edition.rights["jurisdiction"],
        "rights_status": volume.edition.rights["status"],
        "paragraphs": counts["paragraphs"],
        "substitutions": counts["substitutions"],
        "tier": volume.tier,
        "verses": counts["verses"],
    }


GENERATOR = "tools/typeset-bible"


def edition_paragraphs(edition: Edition, arguments: argparse.Namespace) -> dict:
    """Where a whole-bible volume opens a paragraph, or nowhere if refused.

    A whole bible is the artifact a mechanical review reads, so the flag is
    worth more here than anywhere: `--no-paragraphs` gives back the stored text
    with nothing of this project's reading of it in the way.
    """
    if not arguments.paragraphs:
        return {}
    bible = indexer().Bible(edition.artifacts)
    return paragraphs_module().breaks(edition.artifacts, bible)


def run_list(arguments: argparse.Namespace) -> dict[str, object]:
    registered = registry()
    if arguments.plan or arguments.volume:
        return {
            "volumes": [
                {
                    "id": volume_id(plan, tier, name),
                    "bible": name,
                    "label": str(registered[name]["label"]),
                    "plan": plan.id,
                    "readings": len(plan.at(tier)),
                    "tier": tier,
                    "track": plan.label(tier),
                }
                for plan, tier, name in chosen(arguments)
            ],
            "refused": sorted(set(registered) - set(publishable(registered))),
            "status": "ok",
        }
    names = publishable(registered)
    return {
        "editions": [
            {
                "id": name,
                "label": str(registered[name]["label"]),
                "rights": str(registered[name]["rights"]),
            }
            for name in names
        ],
        "refused": sorted(set(registered) - set(names)),
        "status": "ok",
    }


def run_check(arguments: argparse.Namespace) -> dict[str, object]:
    """Prove every selected volume can be set, without writing anything."""
    registered = registry()
    source_root = Path(arguments.source_root)
    wanted = chosen(arguments)
    if wanted:
        return {
            "volumes": [
                summarise(
                    *volume_row(plan, tier, name, source_root, arguments.paragraphs),
                    arguments,
                )
                for plan, tier, name in wanted
            ],
            "refused": sorted(set(registered) - set(publishable(registered))),
            "status": "ok",
        }
    editions: list[dict[str, object]] = []
    for name in selected(arguments):
        edition = load(name, source_root)
        _, counts = render_tex(edition, GENERATOR, edition_paragraphs(edition, arguments))
        editions.append(
            {
                "id": name,
                "books": counts["books"],
                "chapters": counts["chapters"],
                "digest": edition.digest(),
                "rights_jurisdiction": edition.rights["jurisdiction"],
                "rights_status": edition.rights["status"],
                "substitutions": counts["substitutions"],
                "verses": counts["verses"],
            }
        )
    return {
        "editions": editions,
        "refused": sorted(set(registered) - set(publishable(registered))),
        "status": "ok",
    }


def run_render(arguments: argparse.Namespace) -> dict[str, object]:
    source_root = Path(arguments.source_root)
    # The output directory is resolved before an edition is loaded, and the
    # edition is refused before the directory is created, so a refused edition
    # leaves nothing behind at all.
    out = destination(Path(arguments.out))
    written: list[dict[str, object]] = []
    wanted = chosen(arguments)
    if wanted:
        for plan, tier, name in wanted:
            volume = Volume(plan, tier, name, source_root, arguments.paragraphs)
            content, counts = render_plan_tex(volume, GENERATOR)
            target = out / f"{volume.id}.tex"
            written.append(
                {
                    **summarise(volume, counts, arguments),
                    "changed": write(target, content),
                    "path": str(target),
                }
            )
        return {"rendered": written, "status": "ok"}
    for name in selected(arguments):
        edition = load(name, source_root)
        content, counts = render_tex(
            edition, GENERATOR, edition_paragraphs(edition, arguments)
        )
        target = out / f"{name}.tex"
        changed = write(target, content)
        written.append(
            {
                "id": name,
                "books": counts["books"],
                "changed": changed,
                "chapters": counts["chapters"],
                "path": str(target),
                "substitutions": counts["substitutions"],
                "verses": counts["verses"],
            }
        )
    return {"rendered": written, "status": "ok"}


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("typeset-bible error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    rows = (
        list(payload.get("editions") or [])
        + list(payload.get("volumes") or [])
        + list(payload.get("rendered") or [])
    )
    if arguments.format == "ids":
        for row in rows:
            print(row["id"])
        return 0
    for row in payload.get("volumes") or []:
        print_volume(row)
    for row in payload.get("editions") or []:
        if "verses" in row:
            print(
                f"{row['id']}: {row['books']} books, {row['chapters']} chapters, "
                f"{row['verses']} verses "
                f"({row['rights_status']}, {row['rights_jurisdiction']})"
            )
        else:
            print(f"{row['id']}: {row['label']} ({row['rights']})")
        for substitution in row.get("substitutions") or []:
            print(
                f"  substituted {substitution['codepoint']} "
                f"-> {substitution['replacement']} x{substitution['count']}"
            )
    for row in payload.get("rendered") or []:
        state = "written" if row["changed"] else "unchanged"
        if "readings" in row:
            print(f"{row['id']}: {state} {row['path']}")
            print_volume(row, indent="  ")
            continue
        print(
            f"{row['id']}: {state} {row['path']} "
            f"({row['books']} books, {row['verses']} verses)"
        )
        for substitution in row.get("substitutions") or []:
            print(
                f"  substituted {substitution['codepoint']} "
                f"-> {substitution['replacement']} x{substitution['count']}"
            )
    for name in payload.get("refused") or []:
        print(f"refused (not publishable): {name}")
    return 0


def print_volume(row: dict, indent: str = "") -> None:
    """One plan volume, with its refusals named rather than only counted.

    The count leads because a track that refuses nothing should say so in one
    line. Where there are refusals they are the part worth reading: each names a
    passage this edition divides or numbers differently, and the whole point of
    printing them is that nobody should have to notice a missing reading.
    """
    refused = row.get("refused")
    tally = len(refused) if isinstance(refused, list) else refused
    if "label" in row and "readings" in row and "verses" not in row:
        print(
            f"{indent}{row['id']}: {row['track']} track of {row['plan']}, "
            f"{row['readings']} readings ({row['label']})"
        )
        return
    print(
        f"{indent}{row['id']}: {row['readings']} readings, {row['chapters']} chapters, "
        f"{row['verses']} verses, {tally} refused "
        f"({row['rights_status']}, {row['rights_jurisdiction']})"
    )
    if isinstance(refused, list):
        for entry_row in refused:
            print(
                f"{indent}  refused {entry_row['order']} "
                f"{entry_row['title']} ({entry_row['reference']}): {entry_row['reason']}"
            )
    for substitution in row.get("substitutions") or []:
        print(
            f"{indent}  substituted {substitution['codepoint']} "
            f"-> {substitution['replacement']} x{substitution['count']}"
        )


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--bible", default=None, help="one edition id; the default is every publishable one"
    )
    shared.add_argument(
        "--plan", default=None, help="one abridged plan id; sets its volumes instead of a bible"
    )
    shared.add_argument(
        "--volume", default=None, help="one plan volume id, as `list --plan ID --format ids` prints"
    )
    shared.add_argument(
        "--plan-root", default=str(PLAN_ROOT), help="directory of tracked abridged plans"
    )
    shared.add_argument(
        "--source-root", default=str(SOURCE_ROOT), help="source library works root"
    )
    shared.add_argument("--out", default=str(DEFAULT_OUT), help="where `render` writes TeX")
    shared.add_argument(
        "--verbose", action="store_true", help="name every refused reading instead of counting"
    )
    # Both directions are spelled out because the default is a judgement and a
    # reader should be able to see it named. On is the default because these
    # volumes are for reading and no edition here carries paragraph structure of
    # its own, so the alternative default is a wall. Off is what a mechanical
    # review of an edition wants: with the projection on, part of what is under
    # review is the projection.
    shared.add_argument(
        "--paragraphs",
        dest="paragraphs",
        action="store_true",
        default=True,
        help="set paragraph breaks from the tracked marks and projection (the default)",
    )
    shared.add_argument(
        "--no-paragraphs",
        dest="paragraphs",
        action="store_false",
        help="set each chapter as one paragraph, exactly as the stored verse files hold it",
    )
    shared.add_argument(
        "--format", choices=("text", "json", "ids"), default="text", help="output form"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="typeset-bible",
        description="Typeset a publishable bible edition's complete text as two-column TeX.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "typeset-bible")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("list", help="the editions that may be typeset", parents=[shared]),
        EXAMPLES["list"],
    )
    with_examples(
        sub.add_parser("check", help="prove an edition can be set, writing nothing", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("render", help="write the two-column TeX source", parents=[shared]),
        EXAMPLES["render"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={"list": run_list, "check": run_check, "render": run_render},
        renderer=render,
        prefix="typeset-bible",
        argv=argv,
        # The read-only verb is the default: a bare invocation reports what may
        # be typeset rather than writing a thousand pages of TeX.
        default_verb="list",
        dependency_message="install PyYAML (requirements-tools.txt) to set a plan volume",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
