def sibling(name: str):
    """Load a sibling tool as a module rather than restating what it decides.

    `index-bible` owns the registry of editions and, with it, the single
    `publishable` flag that keeps a licensed text out of a public artifact. A
    second copy of that table here is exactly how a tool comes to typeset a
    bible the repository may not republish.
    """
    path = ROOT / "tools" / name
    loader = SourceFileLoader(f"_{name.replace('-', '_')}", str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:  # pragma: no cover - a broken checkout, not a code path
        raise ValueError(f"cannot load {path}")
    module = module_from_spec(spec)
    loader.exec_module(module)
    return module


@lru_cache(maxsize=1)
def indexer():
    """`index-bible` as a module: the edition registry and the resolver both.

    A plan volume needs more than the registry. It needs `Bible`, which reads a
    cited locus through the edition's own verse-alias table and refuses instead
    of returning whatever the edition happens to print at those numbers, and
    `unnumber_titles`, which moves a Hebrew-numbered psalm range onto an edition
    that gives the inscription no verse number of its own. Both already decide
    this for the site; a second implementation here would be a second answer.
    """
    return sibling("index-bible")


