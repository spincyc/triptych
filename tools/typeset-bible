#!/usr/bin/env python3
"""Typeset a publishable bible edition's complete text as two-column TeX.

The indexed bible `index-bible` builds is a citation index: its key space is
the references the calendars actually make. This tool answers the other
question — the whole book, in reading order — by walking one edition's tracked
per-book verse files and emitting a two-column TeX source for `pdflatex`.

Three facts are never guessed here.

*Which editions may be typeset* comes from `index-bible`'s `EDITIONS` table and
nothing else. A directory listing under `src/sources/works/` also shows
editions this repository may not republish, and an edition whose entry says
`publishable: false` is refused by name before any output path is created.

*Which book a file holds* comes from the edition's own `book-index.tsv`: the
`file` column names the verse file and the `token` column names the book, and
every row of that file must carry that token. Mapping books by the position of
their artifact directory is the defect that once filed Ezekiel's text under
Sirach, and the token check makes that unrepresentable rather than unlikely.

*What the text may be redistributed under* comes from the artifact records of
the very files being set, so each edition's PDF states its own basis and its
own jurisdiction. Two of these editions are public domain in the United States
and everywhere outside the United Kingdom only, and one blanket "public domain"
across all of them would be false for those two.

The rendered TeX is deterministic and is written only when its bytes change, so
an unchanged edition does not force a rebuild of a thousand-page PDF.
"""
from __future__ import annotations

import argparse
import csv
import hashlib
import sys
import tomllib
from functools import lru_cache
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

from _tooling import print_json, run_verb_cli  # noqa: E402

SOURCE_ROOT = ROOT / "src" / "sources" / "works"
DEFAULT_OUT = ROOT / "build" / "bibles"

# Where a rendered edition may be written. `build/` is the only tree in this
# repository that holds reproducible artifacts; `doc/`, `web/` and `src/` hold
# reviewed or authoritative ones, and a whole-bible render is neither.
WRITABLE_ROOT = ROOT / "build"

# Headings for the divisions a book index declares. The value is the edition's
# own word for the division, so an edition that prints an Apocrypha says so and
# is not silently folded into the Old Testament.
TESTAMENTS = {
    "old": "The Old Testament",
    "new": "The New Testament",
    "apocrypha": "The Apocrypha",
    "septuagint": "The Septuagint Books",
}

# TeX's own metacharacters. The text is scripture and carries no markup, so
# every one of these is a literal character that must survive as printed.
TEX_SPECIALS = {
    "\\": r"\textbackslash{}",
    "&": r"\&",
    "%": r"\%",
    "$": r"\$",
    "#": r"\#",
    "_": r"\_",
    "{": r"\{",
    "}": r"\}",
    "~": r"\textasciitilde{}",
    "^": r"\textasciicircum{}",
}

# Punctuation the sources write as Unicode and TeX sets from its own ligatures.
# Passing these through as bytes would also work under inputenc; converting them
# keeps the quotation marks and dashes correctly shaped in the T1 fonts.
TEX_PUNCTUATION = {
    "\u2018": "`",
    "\u2019": "'",
    "\u201c": "``",
    "\u201d": "''",
    "\u2013": "--",
    "\u2014": "---",
    "\u2026": r"\ldots{}",
}

