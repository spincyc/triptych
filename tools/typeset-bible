"""

# Macros a plan volume needs and a whole bible does not. Kept apart so that an
# edition volume's preamble still declares only what it uses.
PLAN_PREAMBLE = r"""
% One of the plan's periods: the span of the story a group of readings covers.
\newcommand{\periodstart}[1]{%
  \par\addvspace{1.4\baselineskip}%
  \Needspace*{8\baselineskip}%
  {\centering\scshape\large #1\par}%
  \addvspace{0.4\baselineskip}%
  \par}

% One reading: its place in the sequence and the plan's own title for it.
\newcommand{\readingstart}[2]{%
  \par\addvspace{1.0\baselineskip}%
  \Needspace*{5\baselineskip}%
  \markright{#1. #2}%
  \noindent{\bfseries #1.\hspace{0.4em}#2}\par
  \addvspace{0.15\baselineskip}%
  \par}

% The reference, as the plan cites it and as this edition carries it.
\newcommand{\citeline}[1]{%
  \noindent{\small\itshape #1}\par\addvspace{0.25\baselineskip}}

% The plan's own note on a reading, and the plan's prose generally.
\newcommand{\notepara}[1]{%
  \par{\small #1\par}\addvspace{0.25\baselineskip}}

% A reading this edition cannot address. It is set in view, where the reading
% would have been, because a passage silently missing from a volume is
% indistinguishable from a passage the plan never appointed.
\newcommand{\refusalpara}[1]{%
  \par\noindent{\small\bfseries This edition does not carry this reading.}\par
  \noindent{\small #1\par}\addvspace{0.25\baselineskip}}

\newcommand{\readingline}[4]{%
