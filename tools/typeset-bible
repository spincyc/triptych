def registry() -> dict[str, dict[str, object]]:
    return indexer().EDITIONS


def publishable(registered: dict[str, dict[str, object]]) -> list[str]:
    """Every edition this repository may republish, in the registry's order."""
    return [
        name
        for name in sorted(registered, key=lambda key: (int(registered[key]["rank"]), key))
        if registered[name].get("publishable") is True
    ]


def entry(registered: dict[str, dict[str, object]], name: str) -> dict[str, object]:
    """One edition's registry entry, refusing an unknown or a licensed one."""
    if name not in registered:
        raise KeyError(f"no registered bible edition {name!r}")
    found = registered[name]
    if found.get("publishable") is not True:
        raise ValueError(
            f"{name} is registered {found.get('rights')} and publishable is not true; "
            "it must not be typeset or written anywhere"
        )
    return found


def read_tsv(path: Path) -> list[dict[str, str]]:
    with path.open(encoding="utf-8", newline="") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


class Book:
    """One book of one edition, identified by the edition's own book index."""

    def __init__(self, row: dict[str, str], path: Path) -> None:
        self.ordinal = int(row["ordinal"])
        self.token = row["token"]
        self.testament = row["testament"]
        self.path = path
        # The edition's own printed title where it records one, and the
        # Douay-Rheims title otherwise. Neither is invented: both are columns of
        # the tracked book index.
        self.title = (
            row.get("edition_title")
            or row.get("kjv_title")
            or row.get("douay_title")
            or row.get("modern_name")
            or self.token
        )
        self.name = row.get("modern_name") or self.title
        self.declared_chapters = int(row["chapters"]) if row.get("chapters") else None
        self.declared_verses = int(row["verses"]) if row.get("verses") else None
        self.verses: list[tuple[int, int, str]] = []

    def load(self) -> None:
        """Read the verse file, refusing text that is not this book's text."""
        for number, row in enumerate(read_tsv(self.path), start=2):
            token = row["book"]
            if token != self.token:
                raise ValueError(
                    f"{self.path.name} line {number} carries book {token!r}, but the "
                    f"book index registers this file as {self.token!r}"
                )
            self.verses.append((int(row["chapter"]), int(row["verse"]), row["text"]))
        if not self.verses:
            raise ValueError(f"{self.path.name} holds no verses")
        chapters = len({chapter for chapter, _, _ in self.verses})
        if self.declared_chapters is not None and chapters != self.declared_chapters:
            raise ValueError(
                f"{self.token}: the book index declares {self.declared_chapters} "
                f"chapters and the verse file holds {chapters}"
            )
        if self.declared_verses is not None and len(self.verses) != self.declared_verses:
            raise ValueError(
                f"{self.token}: the book index declares {self.declared_verses} "
                f"verses and the verse file holds {len(self.verses)}"
            )


class Edition:
    """One publishable edition: its books, its rights, and its own record."""

    def __init__(self, name: str, registered: dict[str, object], source_root: Path) -> None:
        self.id = name
        self.label = str(registered["label"])
        self.edition = str(registered["edition"])
        self.source_id = str(registered["source_id"])
        self.language = str(registered["language"])
        self.numbering = str(registered["numbering"])
        self.psalter = str(registered["psalter"])
        # Whether this edition gives a psalm's inscription a verse number of its
        # own. Not a second numbering system, and the reason a plan volume in
        # this edition may still have to move a range that already converted.
        self.psalm_titles = str(registered["psalm_titles"])
        self.artifacts = source_root / str(registered["artifacts"])
        if not self.artifacts.is_dir():
            raise ValueError(f"{name}: no artifact directory at {self.artifacts}")
        self.record = self._edition_record()
        self.books = self._books()
        self.rights = self._rights()

    def _edition_record(self) -> dict[str, object]:
        path = self.artifacts.parent / "edition.toml"
        if not path.is_file():
            raise ValueError(f"{self.id}: no edition record at {path}")
        return tomllib.loads(path.read_text(encoding="utf-8"))

    def _books(self) -> list[Book]:
        index = sorted(self.artifacts.glob("book-index-*/book-index.tsv"))
        if len(index) != 1:
            raise ValueError(
                f"{self.id}: expected exactly one book index under {self.artifacts}, "
                f"found {len(index)}"
            )
        books: list[Book] = []
        for row in read_tsv(index[0]):
            # Identity by the declared file name, never by the position of an
            # artifact directory in a listing.
            found = sorted(self.artifacts.glob(f"verse-text-*/{row['file']}"))
            if len(found) != 1:
                raise ValueError(
                    f"{self.id}: the book index registers {row['file']} for "
                    f"{row['token']}, and {len(found)} such files exist"
                )
            books.append(Book(row, found[0]))
        if not books:
            raise ValueError(f"{self.id}: the book index registers no books")
        ordinals = [book.ordinal for book in books]
        if ordinals != sorted(ordinals) or len(set(ordinals)) != len(ordinals):
            raise ValueError(f"{self.id}: the book index ordinals are not a strict order")
        return books

    def _rights(self) -> dict[str, str]:
        """The rights the edition's own verse artifacts record, or a refusal.

        Every verse artifact of one edition must state the same status, basis
        and jurisdiction. A disagreement is not something to average out: it
        means the artifacts no longer describe one redistributable text, and the
        notice this PDF would print could not be true of all of it.
        """
        found: dict[tuple[str, str, str], list[str]] = {}
        for book in self.books:
            record = book.path.parent / "artifact.toml"
            if not record.is_file():
                raise ValueError(f"{self.id}: no artifact record at {record}")
            data = tomllib.loads(record.read_text(encoding="utf-8"))
            missing = [
                field
                for field in ("rights_status", "rights_basis", "rights_jurisdiction")
                if not data.get(field)
            ]
            if missing:
                raise ValueError(
                    f"{self.id}: {record.parent.name} records no {', '.join(missing)}"
                )
            key = (
                str(data["rights_status"]),
                str(data["rights_jurisdiction"]),
                str(data["rights_basis"]),
            )
            found.setdefault(key, []).append(book.token)
        if len(found) != 1:
            raise ValueError(
                f"{self.id}: its verse artifacts record {len(found)} different rights "
                "statements; one edition cannot carry one notice until they agree"
            )
        status, jurisdiction, basis = next(iter(found))
        return {"status": status, "jurisdiction": jurisdiction, "basis": basis}

    def name_of(self, token: str) -> str:
        """This edition's modern name for a book, by its own token.

        The modern name and not the printed title, because the reference it
        writes stands beside the plan's own citation and the two are meant to be
        compared: `Psalms 22:1-6` against `Psalms 23:1-6` shows the numbering
        moving, where `The Book of Psalms` would put a difference of wording in
        the way of a difference of number. Where the book itself changes — a
        Vulgate Daniel 14 carried as Bel — the modern name says so plainly.
        """
        for book in self.books:
            if book.token == token:
                return book.name
        return token

    def location(self) -> str:
        """The artifact directory as the PDF should name it.

        Repository-relative where the text came from this checkout, and the
        given path otherwise, so a render from a source root elsewhere does not
        claim to have come from the tracked one.
        """
        artifacts = self.artifacts.resolve()
        if artifacts.is_relative_to(ROOT):
            return str(artifacts.relative_to(ROOT))
        return str(artifacts)

    def load(self) -> None:
        for book in self.books:
            book.load()

    def digest(self) -> str:
        """A digest over the verse rows actually set, in the order set."""
        running = hashlib.sha256()
        for book in self.books:
            for chapter, verse, text in book.verses:
                running.update(f"{book.token}\t{chapter}\t{verse}\t{text}\n".encode())
        return running.hexdigest()


class Plan:
    """One tracked abridged plan: its prose, its nesting tiers, and its readings.

    The tiers are read in the order the file declares them, deepest last, and
    each one's `readings` count is the *cumulative* number a reader of that tier
    sees. That is asserted here rather than assumed, because the failure it
    guards is silent: a volume that printed only the readings tagged exactly
    `landmarks` while calling itself the Landmarks tier would look entirely
    correct and would be a third of the readings short.
    """

    def __init__(self, path: Path) -> None:
        import yaml

        self.id = path.stem
        self.path = path
        document = yaml.safe_load(path.read_text(encoding="utf-8"))
        if not isinstance(document, dict):
            raise ValueError(f"{path}: top level must be a mapping")
        self.document = document
        self.title = str(document.get("title") or self.id)
        self.canon = str(document.get("canon") or "")
        self.numbering = str(document.get("numbering") or "")
        self.omissions = str(document.get("omissions") or "")
        tiers = document.get("tiers")
        if not isinstance(tiers, dict) or not tiers:
            raise ValueError(f"{path}: declares no tiers")
        self.tiers = tiers
        self.order = list(tiers)
        self.periods = [
            period for period in (document.get("periods") or []) if isinstance(period, dict)
        ]
        self.readings = [
            (period, reading)
            for period in self.periods
            for reading in (period.get("readings") or [])
            if isinstance(reading, dict)
        ]
        self._check()

    @property
    def name(self) -> str:
        """The plan's own short name: what a title page and a spine carry."""
        return self.title.split(":", 1)[0].strip()

    @property
    def subtitle(self) -> str:
        _, _, rest = self.title.partition(":")
        return rest.strip()

    def _check(self) -> None:
        if not self.readings:
            raise ValueError(f"{self.path}: carries no readings")
        numbers = [reading.get("order") for _, reading in self.readings]
        if numbers != list(range(1, len(numbers) + 1)):
            raise ValueError(
                f"{self.path}: reading order must run 1..{len(numbers)} "
                "without gaps or repeats"
            )
        for _, reading in self.readings:
            tier = reading.get("tier")
            if tier not in self.tiers:
                raise ValueError(
                    f"{self.path}: reading {reading.get('order')} claims "
                    f"undeclared tier {tier!r}"
                )
        for tier in self.order:
            declared = (self.tiers[tier] or {}).get("readings")
            found = len(self.at(tier))
            if declared is not None and int(declared) != found:
                raise ValueError(
                    f"{self.path}: tier {tier!r} declares {declared} readings and "
                    f"nests {found}; the tiers no longer agree with the readings"
                )

    def depth(self, tier: str) -> int:
        if tier not in self.tiers:
            raise KeyError(f"{self.id} declares no tier {tier!r}; known: {self.order}")
        return self.order.index(tier)

    def at(self, tier: str) -> list[tuple[dict, dict]]:
        """Every reading of this tier, which is every reading at it or above."""
        limit = self.depth(tier)
        return [
            pair
            for pair in self.readings
            if self.depth(str(pair[1].get("tier"))) <= limit
        ]

    def label(self, tier: str) -> str:
        return str((self.tiers[tier] or {}).get("label") or tier.title())

    def track(self, tier: str) -> str:
        """The tier named as a track reads: `The Landmarks track`, `The Story track`.

        The plan's own labels are not uniform about the article — `Landmarks`
        carries none and `The Story` and `The Full Account` do — and a volume
        that prepended one unconditionally set `The The Story track` on its own
        title page and in its own PDF metadata. Deciding it once here is the fix;
        editing the labels to match would have been a data change made for a
        typesetting reason, and the keys, not the labels, are what this plan
        promises to keep stable.
        """
        label = self.label(tier)
        article = "" if label.split(" ", 1)[0].casefold() == "the" else "The "
        return f"{article}{label} track"

    def description(self, tier: str) -> str:
        return str((self.tiers[tier] or {}).get("description") or "")


def plans(root: Path) -> list[Plan]:
    found = sorted(Path(root).glob("*.yaml"))
    if not found:
        raise ValueError(f"no abridged plan under {root}")
    return [Plan(path) for path in found]


def volume_id(plan: Plan, tier: str, bible: str) -> str:
    return f"{plan.id}-{tier}-{bible}"


def volumes(plan: Plan) -> list[tuple[str, str]]:
    """Every (tier, edition) this plan is issued in, in reading-depth order."""
    return [(tier, bible) for tier in plan.order for bible in PLAN_EDITIONS]


def reference(book: str, ranges: list) -> str:
    """One passage as a citation reads: `Genesis 1:1-2:2`, `Exodus 14:15-15:1`."""
    parts: list[str] = []
    for span in ranges:
        begin = (span or {}).get("begin") or {}
        end = (span or {}).get("end") or begin
        first, opening = begin.get("chapter"), begin.get("verse")
        last, closing = end.get("chapter", first), end.get("verse")
        if first == last:
            if opening == closing:
                parts.append(f"{first}:{opening}")
            else:
                parts.append(f"{first}:{opening}-{closing}")
        else:
            parts.append(f"{first}:{opening}-{last}:{closing}")
    return f"{book} {'; '.join(parts)}"


def numbered_span(bible, token: str, span: dict) -> tuple[list[tuple[str, int, int, str]], str]:
    """The verses one range names, each at the locus this edition prints it under.

    `Bible.span` asks exactly this question and answers it in words alone,
    because an index stores passages and a passage has no verse numbers in it.
    A printed volume does. So the walk is repeated here to keep the numbers —
    and, because a second walk is how two answers start to differ, every range
    is checked against `Bible.span`'s own answer in `resolve` before it is set.

    The locus kept is the *carrier*: where this edition actually holds the
    words, which is not always where the citation looked for them. A Vulgate
    citation of Daniel 14:1 is carried by the King James at Bel 1:2, and
    printing a 1 beside it under a heading reading Daniel would be this
    edition's text under another tradition's numbers — the same silent
    mislabelling the psalter apparatus exists to refuse, one book along.
    """
    begin = span.get("begin") or {}
    end = span.get("end") or begin
    first = begin.get("chapter")
    if first is None:
        return [], "range has no chapter"
    last = end.get("chapter", first)
    found: list[tuple[str, int, int, str]] = []
    carried: tuple = ()
    for chapter in range(int(first), int(last) + 1):
        bounds = bible.chapters.get((token, chapter))
        if bounds is None:
            # The edition prints no chapter of that number, which its alias
            # table may still account for: this is how a Vulgate citation of
            # Daniel 13 or Esther 15 reaches the books a Greek-numbered edition
            # prints them as. `Bible.span` resolves it the same way.
            recorded = sorted(
                verse
                for (held, held_chapter, verse) in bible.aliases
                if held == token and held_chapter == chapter
            )
            if not recorded:
                return [], f"{token} has no chapter {chapter}"
            bounds = (recorded[0], recorded[-1])
        base, bound = bounds
        low = begin.get("verse") if chapter == int(first) else None
        high = end.get("verse") if chapter == int(last) else None
        low = base if low is None else int(low)
        high = bound if high is None else int(high)
        for verse in range(low, high + 1):
            here = bible.carrier(token, chapter, verse)
            if here is None:
                return [], bible.refusal(token, chapter, verse, bounds)
            if here == carried:
                # A range naming both a merged verse and the verse it was
                # merged into reaches the same words twice; print them once.
                continue
            carried = here
            found.append((here[0], int(here[1]), int(here[2]), bible.verses[here]))
    return found, ""


def resolve(plan: Plan, reading: dict, edition: Edition, bible) -> dict[str, object]:
    """Where this reading's passage stands in this edition, or why it does not.

    Two moves and no third, both taken from `index-bible` so that a volume and
    the site cannot disagree about a verse. The psalm concordance renumbers the
    citation into the edition's system; then an edition that leaves a psalm's
    inscription unnumbered shifts the range again. Each refuses rather than
    guessing, and a refusal is carried out of here as data.
    """
    module = indexer()
    book = str(reading.get("book") or "")
    ranges = [span for span in (reading.get("ranges") or []) if isinstance(span, dict)]
    resolved = {
        "order": int(reading.get("order")),
        "tier": str(reading.get("tier")),
        "title": str(reading.get("title") or ""),
        "book": book,
        "note": str(reading.get("note") or "").strip(),
        "cited": reference(book, ranges),
        "here": "",
        "verses": [],
        "refused": "",
    }
    token = bible.token(book)
    if token is None:
        resolved["refused"] = f"no book named {book!r} in this edition"
        return resolved
    if not ranges:
        resolved["refused"] = "the reading names no range"
        return resolved
    if book == PSALMS and plan.numbering != edition.numbering:
        moved: list[dict] = []
        try:
            for span in ranges:
                pieces, _ = convert_range(
                    book, span.get("begin") or {}, span.get("end"),
                    plan.numbering, edition.numbering,
                )
                moved.extend(pieces)
        except NumberingError as error:
            resolved["refused"] = str(error)
            return resolved
        ranges = moved
    if book == PSALMS and edition.psalm_titles == module.UNNUMBERED_TITLES:
        try:
            ranges, problem = module.unnumber_titles(ranges)
        except NumberingError as error:
            resolved["refused"] = str(error)
            return resolved
        if problem:
            resolved["refused"] = problem
            return resolved
    verses: list[tuple[str, int, int, str]] = []
    for span in ranges:
        found, problem = numbered_span(bible, token, span)
        if problem:
            resolved["refused"] = problem
            return resolved
        # The two walks must agree. If they ever stop agreeing, the numbers
        # printed beside the words would be the ones that were wrong.
        words, trouble, _, _ = bible.span(token, span)
        if trouble or [text for _, _, _, text in found] != words:
            raise ValueError(
                f"{resolved['cited']}: this tool and index-bible disagree about "
                f"which verses that range names ({trouble or 'differing text'})"
            )
        verses.extend(found)
    resolved["verses"] = verses
    resolved["token"] = token
    here = carried_reference(edition, verses)
    resolved["here"] = "" if here == resolved["cited"] else here
    return resolved


def carried_reference(edition: Edition, verses: list) -> str:
    """Where this edition holds the passage, in its own books and its own numbers.

    Written as runs rather than as one span, because a citation can reach into
    more than one of this edition's books: a Vulgate Daniel 13-14 is Susanna and
    then Bel, and a single opening and closing locus would name a range that
    runs through a book the passage never touches.
    """
    runs: list[tuple[str, int, int, int, int]] = []
    for token, chapter, verse, _ in verses:
        if runs and runs[-1][0] == token:
            first_token, first_chapter, first_verse, _, _ = runs[-1]
            runs[-1] = (first_token, first_chapter, first_verse, chapter, verse)
        else:
            runs.append((token, chapter, verse, chapter, verse))
    return "; ".join(
        reference(
            edition.name_of(token),
            [
                {
                    "begin": {"chapter": first_chapter, "verse": first_verse},
                    "end": {"chapter": last_chapter, "verse": last_verse},
                }
            ],
        )
        for token, first_chapter, first_verse, last_chapter, last_verse in runs
    )


class Volume:
    """One tier of one plan in one edition: what a single PDF holds."""

    def __init__(
        self, plan: Plan, tier: str, name: str, source_root: Path, paragraphs: bool = True
    ) -> None:
        self.plan = plan
        self.tier = tier
        self.id = volume_id(plan, tier, name)
        self.edition = Edition(name, entry(registry(), name), source_root)
        self.bible = indexer().Bible(self.edition.artifacts)
        # Resolved once, here, so that the count the volume prints about itself
        # and the breaks it sets come from one lookup and cannot disagree.
        self.paragraphs = (
            paragraphs_module().breaks(self.edition.artifacts, self.bible)
            if paragraphs
            else {}
        )
        self.periods: list[tuple[dict, list[dict]]] = []
        held = plan.at(tier)
        for period in plan.periods:
            wanted = [
                resolve(plan, reading, self.edition, self.bible)
                for holder, reading in held
                if holder is period
            ]
            if wanted:
                self.periods.append((period, wanted))
        self.readings = [row for _, rows in self.periods for row in rows]
        if len(self.readings) != len(held):
            raise ValueError(f"{self.id}: readings were lost between the plan and the volume")

    @property
    def refused(self) -> list[dict[str, object]]:
        return [row for row in self.readings if row["refused"]]

    def counts(self) -> dict[str, object]:
        verses = sum(len(row["verses"]) for row in self.readings)
        chapters = {
            (token, chapter)
            for row in self.readings
            for token, chapter, _, _ in row["verses"]
        }
        return {
            "readings": len(self.readings),
            "refused": len(self.refused),
            "chapters": len(chapters),
            "verses": verses,
        }

    def digest(self) -> str:
        """A digest over the verse rows actually set, in the order set."""
        running = hashlib.sha256()
        for row in self.readings:
            running.update(f"{row['order']}\t{row['cited']}\t{row['refused']}\n".encode())
            for token, chapter, verse, text in row["verses"]:
                running.update(f"{token}\t{chapter}\t{verse}\t{text}\n".encode())
        return running.hexdigest()


class Substitutions:
    """Characters this toolchain cannot set, counted so they can be disclosed."""

    def __init__(self) -> None:
        self.counts: dict[str, int] = {}

    def record(self, character: str) -> None:
        self.counts[character] = self.counts.get(character, 0) + 1

    def rows(self) -> list[dict[str, object]]:
        return [
            {
                "character": character,
                "codepoint": f"U+{ord(character):04X}",
                "count": count,
                "replacement": f"[Hebrew {HEBREW_LETTERS[character]}]",
            }
            for character, count in sorted(self.counts.items())
        ]


# The characters `tex` below passes through or rewrites without needing to
# decide anything: printable ASCII, the accented letters the fonts carry, and
# the seventeen it maps. Anything else --- a Hebrew letter to substitute, or a
# codepoint with no rule --- still goes through the loop, which is where the
# recording and the refusals live.
_TEX_TRANSLATION = str.maketrans({**TEX_PUNCTUATION, **TEX_SPECIALS})
_TEX_HANDLED = (
    frozenset(chr(code) for code in range(0x20, 0x7F))
    | frozenset(TEX_LETTERS)
    | frozenset(TEX_SPECIALS)
    | frozenset(TEX_PUNCTUATION)
)


def tex(text: str, where: str, substitutions: Substitutions | None = None) -> str:
    """One string of source text as TeX, refusing anything it cannot set.

    Nearly every string is ordinary text, and for those the answer is one
    C-level `str.translate`: the character loop below decided three dictionary
    memberships per character and appended each one to a list, which over seven
    bible editions was 33 million appends and 32 million `ord()` calls for a
    `check` that writes nothing.

    The fast path is taken only when every character is one the loop would have
    passed through or rewritten unconditionally, so it produces the same string
    the loop produces. A text holding anything else --- Hebrew to record, or a
    codepoint with no rule --- takes the loop, and the recording and the
    refusal happen exactly where they did.
    """
    if _TEX_HANDLED.issuperset(text):
        rendered = text.translate(_TEX_TRANSLATION)
        return "{[}" + rendered[1:] if rendered.startswith("[") else rendered

    out: list[str] = []
    for character in text:
        if character in TEX_SPECIALS:
            out.append(TEX_SPECIALS[character])
        elif character in TEX_PUNCTUATION:
            out.append(TEX_PUNCTUATION[character])
        elif 0x20 <= ord(character) <= 0x7E or character in TEX_LETTERS:
            out.append(character)
        elif character in HEBREW_LETTERS:
            if substitutions is None:
                raise ValueError(
                    f"{where}: U+{ord(character):04X} cannot be set in this context"
                )
            substitutions.record(character)
            out.append(f"[Hebrew {HEBREW_LETTERS[character]}]")
        else:
            raise ValueError(
                f"{where}: U+{ord(character):04X} has no typesetting rule; refusing "
                "rather than dropping a character of the text"
            )
    rendered = "".join(out)
    # Text opening with a bracket would be read as an optional argument to
    # whatever macro precedes it.
    return "{[}" + rendered[1:] if rendered.startswith("[") else rendered


def tex_digest(digest: str) -> str:
    """A 64-character hash set so it can break, in a column it does not fit.

    TeX will not break a typewriter word, and an unbroken SHA-256 runs 45 points
    past the measure. The break points are given explicitly rather than letting
    the line overflow, because a digest printed half outside the page is a
    digest nobody can read back.
    """
    parts = [digest[index:index + 16] for index in range(0, len(digest), 16)]
    return r"\texttt{%s}" % r"\allowbreak{}".join(parts)


def tex_path(path: str, where: str) -> str:
    """A path set in a typewriter face, breakable where a path may break.

    TeX does not hyphenate a typewriter word, and a source path is longer than
    a column, so the break points have to be given explicitly or the line runs
    into the margin.
    """
    rendered = tex(path, where)
    for separator in ("/", "-"):
        rendered = rendered.replace(separator, separator + r"\allowbreak{}")
    return r"\texttt{%s}" % rendered


def pdf_string(text: str) -> str:
    """A document-information string for `\\pdfescapestring`.

    pdfTeX escapes the PDF string itself, so the parentheses in an edition's
    title survive; what must go are the characters TeX would read as markup
    before pdfTeX ever sees them.
    """
    plain = "".join(character if 0x20 <= ord(character) <= 0x7E else " " for character in text)
    for character in "\\{}#$&%^_~":
        plain = plain.replace(character, " ")
    return " ".join(plain.split())


