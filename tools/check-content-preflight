# --- Reading the leaf ------------------------------------------------------

def leaf_dir(root: Path, provider: str, document: str) -> Path:
    """The leaf's source directory, refusing anything outside the provider."""
    if not provider or "/" in provider or provider.startswith("."):
        raise ValueError(f"not a provider name: {provider!r}")
    provider_root = (root / "src" / provider).resolve()
    if not provider_root.is_dir():
        raise ValueError(f"no source root for provider {provider!r}")
    leaf = (provider_root / document).resolve()
    if leaf != provider_root and provider_root not in leaf.parents:
        raise ValueError(f"document leaves the provider root: {document!r}")
    if not leaf.is_dir():
        raise ValueError(f"no such leaf: src/{provider}/{document}")
    return leaf


# --- Which edition a check reads -------------------------------------------
#
# One leaf builds two documents. `main.tex` is the canonical full edition and
# `synthesis.tex` the companion, and which prose reaches which reader is
# settled two ways: by section files only one of them inputs, and by
# `\ifdefined\TriptychSynthesisEdition` branches inside the files they share.
#
# Every check reads `leaf` unless it is told otherwise, and `leaf` is the union
# of both editions: every .tex file under the leaf, every branch of every
# guard, nothing resolved. That is the right scope for a sweep over records --
# a source bound for either edition is bound, and a sweep that read one
# document alone would report the other's citations missing -- and it is what
# every hand invocation and every `content-preflight` command has always done.
# So it stays the default and stays byte-for-byte what it was.
#
# `canonical` and `synthesis` narrow a check to one document, and they exist
# because a gate's refusal has to reach a reviser permitted to repair it.
# `content-preflight` runs before the companion is written and routes to
# `content-revision`, which may write the canonical edition alone;
# `synthesis-preflight` runs after `derive-synthesis` and routes to
# `synthesis-revision`, which may write the companion alone. A check that
# named a canonical-only file in that gate would name a file its reviser is
# forbidden to touch, and a gate keeps the finding-id comparison whatever a
# reviser reports, so three such refusals would block the run outright.
LEAF_EDITION = "leaf"
CANONICAL_EDITION = "canonical"
RESEARCH_EDITION = "research"
SYNTHESIS_EDITION = "synthesis"
HOMILY_EDITION = "homily"
EDITION_CHOICES = (CANONICAL_EDITION, LEAF_EDITION, RESEARCH_EDITION,
                   SYNTHESIS_EDITION, HOMILY_EDITION)
SYNTHESIS_FLAG = "TriptychSynthesisEdition"
MAIN_TEX = "main.tex"
SYNTHESIS_TEX = "synthesis.tex"
HOMILY_TEX = "homily.tex"
# Where an edition's `\input` graph starts. Schema 1 keeps its two-document
# union; schema 2 adds the homily through entry_files below.
ENTRY_FILES = {
    CANONICAL_EDITION: (MAIN_TEX,),
    RESEARCH_EDITION: (MAIN_TEX,),
    SYNTHESIS_EDITION: (SYNTHESIS_TEX,),
    HOMILY_EDITION: (HOMILY_TEX,),
    LEAF_EDITION: (MAIN_TEX, SYNTHESIS_TEX),
}


def three_document_study(leaf: Path) -> bool:
    """Only schema 2 adopts the new publication contract; schema 1 stays legacy."""
    manifest = leaf / "proper-components.toml"
    return manifest.is_file() and tomllib.loads(
        manifest.read_text(encoding="utf-8")).get("schema") == 2


def entry_files(leaf: Path, edition: str) -> tuple[str, ...]:
    if edition == LEAF_EDITION and three_document_study(leaf):
        return (MAIN_TEX, SYNTHESIS_TEX, HOMILY_TEX)
    return ENTRY_FILES[edition]


# Two shapes of `synthesis.tex` are current in this corpus, and in neither is
# the flag a property of the edition's name. Most companions define
# `\TriptychSynthesisEdition` and input `main.tex`, which branches on it; three
# carry a standalone preamble that defines nothing and inputs a section list of
# its own, so a guard in a file such a companion shares with `main.tex` takes
# the *canonical* branch there. The definedness is therefore read off the entry
# file, the way `scripts/_corpus.title_of` walks a preamble from whichever file
# the build actually starts at, and never assumed from the edition asked for.
DEFINES_FLAG = re.compile(
    r"\\(?:def|gdef|edef|xdef|let)[ \t]*\\" + SYNTHESIS_FLAG
    + r"(?![A-Za-z@])"
    r"|\\(?:new|renew|provide)command[ \t]*\*?[ \t]*\{?[ \t]*\\"
    + SYNTHESIS_FLAG + r"(?![A-Za-z@])")

# A comment is not TeX: a `\fi` after a `%` closes nothing, and a walk that
# counted one would resolve the wrong branch. The mask is exactly as long as
# what it replaces, so every offset and line number below is still the file's.
TEX_COMMENT = re.compile(r"(?<!\\)((?:\\\\)*)%[^\n]*")

# The tokens a TeX conditional is made of. `\fi` carries a lookahead so that
# `\finishfulltextelement`, which one leaf's `format.tex` defines, is not read
# as the end of a branch.
CONDITIONAL = re.compile(r"\\(if[A-Za-z@]*|else|fi|or)(?![A-Za-z@])")
# `\ifthenelse` is a LaTeX macro over its arguments and opens no conditional.
# Counting it would leave the walk one `\fi` short and resolve two guards'
# branches into each other.
NOT_CONDITIONAL = frozenset({"ifthenelse"})
GUARD = re.compile(
    r"\\ifdefined[ \t]*\\" + SYNTHESIS_FLAG + r"(?![A-Za-z@])")


def uncommented(text: str) -> str:
    """Every TeX comment blanked, the escaping counted rather than guessed."""
    return TEX_COMMENT.sub(
        lambda hit: hit.group(1) + " " * (len(hit.group(0))
                                         - len(hit.group(1))),
        text)


@functools.lru_cache(maxsize=None)
def flag_defined(leaf: Path, edition: str) -> bool | None:
    """Whether `\\TriptychSynthesisEdition` is defined as this edition builds.

    `None` for `leaf`, which resolves nothing at all: it is the union of both
    editions and reads both branches of every guard.
    """
    if edition == LEAF_EDITION:
        return None
    if edition in (CANONICAL_EDITION, RESEARCH_EDITION):
        return False
    entry = leaf / entry_files(leaf, edition)[0]
    if not entry.is_file():
        return False
    return bool(DEFINES_FLAG.search(
        uncommented(entry.read_text(encoding="utf-8"))))


def _guard_parts(masked: str,
                 opening: re.Match) -> tuple[int | None, int | None, int, int]:
    """One guard's `\\else` and `\\fi`, found by depth and not by proximity.

    Depth-counted so that a conditional nested inside a branch keeps its own
    `\\else` and `\\fi`, and so that the other flag this corpus uses,
    `\\ifdefined\\TriptychPrintEdition`, is stepped over whole rather than having
    its `\\fi` taken for the guard's. Every guard in every propers leaf is flat
    today; the depth is what keeps that a measured fact rather than a
    dependency.
    """
    depth = 1
    else_at = else_end = None
    at = opening.end()
    while True:
        token = CONDITIONAL.search(masked, at)
        if token is None:
            raise ValueError(
                f"\\ifdefined\\{SYNTHESIS_FLAG} at offset "
                f"{opening.start()} is never closed by \\fi")
        name, at = token.group(1), token.end()
        if name.startswith("if"):
            if name not in NOT_CONDITIONAL:
                depth += 1
        elif name == "fi":
            depth -= 1
            if depth == 0:
                return else_at, else_end, token.start(), token.end()
        elif name == "else" and depth == 1:
            if else_at is not None:
                raise ValueError(
                    f"\\ifdefined\\{SYNTHESIS_FLAG} at offset "
                    f"{opening.start()} carries two \\else")
            else_at, else_end = token.start(), token.end()


def resolve_edition(text: str, defined: bool | None) -> str:
    """`\\ifdefined\\TriptychSynthesisEdition` resolved for one edition.

    The branch this edition does not take is replaced by spaces, its newlines
    kept, and so are the guard's own tokens. Two properties follow, and both
    are why it is spaces rather than a deletion or a marker character. Every
    offset and every line number is still the file's own, so a refusal names
    the line an editor shows and a worker can open it; and in the edition being
    read the surviving text either side of a dropped branch really is
    contiguous, so a sentence a guard splits is read as the one sentence the
    reader is given rather than as two fragments.
    """
    if defined is None:
        return text
    masked = uncommented(text)
    chars = list(text)

    def blank(start: int, stop: int) -> None:
        for index in range(start, stop):
            if chars[index] != "\n":
                chars[index] = " "

    at = 0
    while True:
        opening = GUARD.search(masked, at)
        if opening is None:
            return "".join(chars)
        else_at, else_end, fi_at, fi_end = _guard_parts(masked, opening)
        blank(opening.start(), opening.end())
        blank(fi_at, fi_end)
        if else_at is None:
            # A guard with no `\else` prints its one branch in the synthesis
            # edition and nothing at all in the canonical one.
            if not defined:
                blank(opening.end(), fi_at)
        elif defined:
            blank(else_at, fi_at)
        else:
            blank(opening.end(), else_end)
        at = opening.end()


def edition_text(leaf: Path, path: Path,
                 edition: str = LEAF_EDITION) -> str:
    """One file's bytes as the named edition typesets them."""
    return resolve_edition(path.read_text(encoding="utf-8"),
                           flag_defined(leaf, edition))


def leaf_tex(leaf: Path, edition: str = LEAF_EDITION) -> list[Path]:
    """Every .tex file the named edition publishes, in a stable order.

    `format.tex` defines macros and `generation-metadata.tex` is stamped by
    the build; neither carries prose, and reading them would let a macro
    definition stand in for a citation.

    Under `leaf`, every .tex file under the leaf. Under a named edition, that
    same list narrowed to the files the edition actually typesets, which is
    what `reader_facing` settles by following the `\\input` graph: a section
    file only the other edition inputs is not this edition's to repair.
    """
    paths = [path for path in sorted(leaf.rglob("*.tex"))
             if path.name not in ("format.tex", "generation-metadata.tex",
                                  "chronology-annotations.tex")]
    if edition == LEAF_EDITION:
        return paths
    typeset = set(reader_facing(leaf, edition))
    return [path for path in paths if path in typeset]


URL_ARG = re.compile(r"\\(?:url|nolinkurl|href)\{[^{}]*\}")
SOURCEURL = re.compile(r"\\sourceurl\{[^{}]*\}")
TEXTTT = re.compile(r"\\texttt\{[^{}]*\}")
COMMAND = re.compile(r"\\[A-Za-z@]+\s*")


def prose(text: str) -> str:
    """LaTeX reduced to the words a reader sees.

    A URL is dropped whole: it is a locator, not a citation, and leaving it
    in would let a shared hostname count as a mention of the work. The
    *label* of a `\\sourceurl{url}{label}` is kept, because that is the part
    the reader reads.
    """
    text = URL_ARG.sub(" ", text)
    text = SOURCEURL.sub(" ", text)
    text = TEXTTT.sub(" ", text)
    text = COMMAND.sub(" ", text)
    return text.replace("{", " ").replace("}", " ")


def fold(text: str) -> str:
    """Case- and accent-insensitive form, so Guéranger matches Gueranger."""
    return "".join(ch for ch in unicodedata.normalize("NFD", text)
                   if unicodedata.category(ch) != "Mn").lower()


# A References heading is starred or numbered, and the corpus prints both:
# `\section*{References}` almost everywhere, and `\section{References}` in
# `claude/48-eighth-after-pentecost`, whose every section is numbered. A
# pattern for the starred form alone read that leaf as printing no References
# at all, and refused it for a section it plainly carries. No leaf uses a
# short-title or aliased form. The section ends at the next `\section`,
# starred or not, for the same reason.
REFERENCES = re.compile(r"\\section\*?\{References\}")
SECTION = re.compile(r"\\section\*?\{")


def split_leaf(leaf: Path,
               edition: str = LEAF_EDITION) -> tuple[str, str]:
    """The leaf's References section and everything else, as two strings."""
    references, body = "", []
    for path in leaf_tex(leaf, edition):
        text = edition_text(leaf, path, edition)
        start = REFERENCES.search(text)
        if not start:
            body.append(text)
            continue
        after = SECTION.search(text, start.end())
        end = after.start() if after else len(text)
        references += text[start.start():end]
        body.append(text[:start.start()] + text[end:])
    return references, "\n".join(body)


ITEM = re.compile(r"(?m)^\\item\s")
END_ITEMIZE = re.compile(r"(?m)^\\end\{itemize\}")


def reference_items(references: str) -> list[str]:
    """One string per `\\item` of the References section, in printed order."""
    return [END_ITEMIZE.split(part)[0]
            for part in ITEM.split(references)[1:]]


