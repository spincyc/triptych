saint sant santo santa work works item
""".split())

NAME = re.compile(r"[A-Z\u00c0-\u00dd][A-Za-z\u00c0-\u00ff'\u2019-]{3,}")


# Words a proper guide prints in its own prose whatever it cites: the names
# of the Mass's parts, of its calendar, and of a title's shape. A References
# entry that shares only these with the body has not been cited by them.
# Kept apart from COMMON, which the rights check also reads, because this
# list is about what a guide's prose always says, not about source ids. It
# was found by review on 2026-09-24: the synthesis editions of GPT 50 and 51
# passed two Gelasian and Gregorian sacramentary entries and a thesis on the
# Postcommunion collects as used, on "Book", "Historical", "Postcommunion",
# "Sunday" and "Pentecost" alone, while naming none of those works; and GPT
# 43 passed an Internet Archive and Corpus Orationum entry on "Witness",
# which is these guides' own word for any source.
GENERIC = frozenset("""
introit collect collects epistle gradual alleluia tract sequence gospel
offertory secret secrets preface communion postcommunion antiphon antiphons
sunday sundays pentecost advent lent easter week ordinary feast solemnity
book historical history exact great church mass witness witnesses
""".split())

POSSESSIVE = re.compile(r"['\u2019]s$")


def anchors(item: str) -> set[str]:
    """The capitalised words that identify a References entry.

    An entry is named in the body by its author's surname or by a short form
    of its title, never by the whole entry and never by any key: the leaves
    carry no citation macro, and a printed source identifier appears in the
    References and nowhere else. So identity here is the set of distinctive
    proper words the entry uses, and an entry counts as cited when the body
    uses any one of them.

    Words in COMMON or GENERIC do not identify an entry while it has a
    distinctive word. An entry that has none is still an entry, and is
    identified by the capitalised words it does have: until 2026-09-24 such
    an entry was skipped, and "Internet Archive, 1962 missal item and OCR
    finding aid" passed in GPT 44, 45 and 46, whose bodies never name it.
    """
    found, weak = set(), set()
    for word in NAME.findall(prose(item)):
        folded = fold(word)
        if len(folded) < 4:
            continue
        if (folded in COMMON or folded in GENERIC
                or POSSESSIVE.sub("", folded) in GENERIC):
            weak.add(folded)
        else:
            found.add(folded)
    return found or weak


# --- The checks ------------------------------------------------------------

def check_references_used(leaf: Path, root: Path,
                         edition: str = LEAF_EDITION
                         ) -> tuple[list[str], str]:
    """Every References entry is cited somewhere in the body.

    The profile is explicit: References carries only sources actually used,
    and no unused lead or source used only by deleted material. That is a
    rule about the whole document, so reading either half alone cannot
    settle it, and a five-lane evaluation has twice spent its judgment
    discovering entries the body never touches.
    """
    references, body = split_leaf(leaf, edition)
    if not references:
        return (["the leaf prints no References section"], "")
    used = fold(prose(body))
    unused = []
    items = reference_items(references)
    for item in items:
        names = anchors(item)
        if not names:
            continue
        if not any(re.search(r"\b" + re.escape(name), used)
                   for name in names):
            unused.append("References entry is cited nowhere in the body: "
                          + " ".join(prose(item).split())[:120])
    return unused, (f"{len(items)} entries, every one used in the body")


IDENTIFIER = re.compile(
    r"^(?:work|edition|artifact|segment|passage|corpus)"
    r"\.[a-z0-9][a-z0-9.-]*[a-z0-9]$")
PRINTED_ID = re.compile(r"\\(?:texttt|nolinkurl)\{([^{}]*)\}", re.S)
ALLOWBREAK = re.compile(r"\\allowbreak")
RECORD_ID = re.compile(r'^id = "([^"]+)"$')


def printed_identifiers(leaf: Path,
                        edition: str = LEAF_EDITION) -> list[str]:
    """Every source-library identifier the leaf prints, sorted and unique.

    A long identifier is broken for the typesetter with `\\allowbreak` and a
    line end, so the id has to be reassembled before it is anything at all: a
    line-at-a-time reader sees `edition.eugene-cummiskey` and calls it
    unregistered.
    """
    found = set()
    for path in leaf_tex(leaf, edition):
        text = edition_text(leaf, path, edition)
        for match in PRINTED_ID.finditer(text):
            value = "".join(ALLOWBREAK.sub("", match.group(1)).split())
            if IDENTIFIER.match(value):
                found.add(value)
    return sorted(found)


def registered_ids(root: Path) -> set[str]:
    """Every id the source library registers.

    Read from the records rather than from their paths: 185 of the 5977 ids
    do not match the directory their record lives in, so a path-derived
    answer would call one registered source in thirty unregistered. The
    inventories under `src/sources/inventories/` are deliberately not read —
    they carry `id =` lines that are audit rows, not registrations.
    """
    ids = set()
    for directory in ("works", "corpora"):
        library = root / "src" / "sources" / directory
        for path in sorted(library.rglob("*.toml")):
            for line in path.read_text(encoding="utf-8").splitlines():
                match = RECORD_ID.match(line)
                if match:
                    ids.add(match.group(1))
    return ids


def check_identifiers_resolve(leaf: Path, root: Path,
                             edition: str = LEAF_EDITION
                             ) -> tuple[list[str], str]:
    """Every source identifier the leaf prints resolves in the library.

    An identifier that resolves to nothing is a citation with no source
    behind it, and it reads exactly like one that does.
    """
    printed = printed_identifiers(leaf, edition)
    if not printed:
        return [], "the leaf prints no source identifier"
    known = registered_ids(root)
    missing = [f"printed source identifier is registered nowhere in "
               f"src/sources: {value}" for value in printed
               if value not in known]
    return missing, f"{len(printed)} source identifiers, every one registered"


# A relation's evidence names the kind of unit that carries it. Two of the
# evidence classes name a component kind; the other two are observations made
# inside whatever unit uses them and name no single owner.
EVIDENCE_UNIT = {
    "source-grounded-synthesis": "source-grounded-synthesis",
    "exploratory-proposal": "exploratory-synthesis",
}

MANIFEST = "proper-components.toml"

# The component manifest binds from the FIRST version of every production
# workflow: `proper` and `proper-finish` gate on `check-proper-components` from
# their v1, and `proper-study` on `component-contract` from its v1. A leaf that
# states none of them and carries no manifest was authored before the component
# architecture, and both proper profiles say what that makes it:
# `guidance/liturgy/roman-1962-propers.md` has new and substantially revised
# guides "authored once in a canonical leaf with `proper-components.toml`",
# and "legacy leaves authored before the component architecture ... remain
# valid until their next substantive revision";
# `guidance/liturgy/postconciliar-propers.md` says the same of its own. Such a
# leaf has no relations to cover, so it is reported out of scope, as the
# chronology and structural contracts report the leaves that predate them.
#
# Keyed on the stated production and not on the manifest's absence alone, so
# that a run which forgot to write one is still refused: its leaf states the
# run's workflow and version, and `provenance-matches-run` holds that statement
# against the run in the same gate.
COMPONENTS_FROM_VERSION = {
    "proper": 1,
    "proper-finish": 1,
    "proper-study": 1,
}


def _components_scope(leaf: Path) -> tuple[bool, str]:
    """`(manifest required, why)` for a leaf that carries no manifest."""
    production = _stated_production(leaf)
    workflow, version = production if production is not None else (None, None)
    threshold = COMPONENTS_FROM_VERSION.get(workflow) if workflow else None
    if threshold is not None and version is not None and version >= threshold:
        return True, (f"the leaf states {workflow} v{version}, and every "
                      f"production of that workflow writes a component "
                      f"manifest")
    thresholds = " or ".join(f"{name} v{minimum}" for name, minimum
                             in COMPONENTS_FROM_VERSION.items())
    if production is None:
        stated = "no recognized provenance record"
        because = "so it predates the component manifest, which binds"
    else:
        stated = f"{workflow} v{version}"
        because = ("which is not a production this contract binds; the "
                   "component manifest binds")
    return False, (f"the leaf states {stated} and carries no {MANIFEST}, "
                   f"{because} from {thresholds}")


def check_relation_coverage(leaf: Path, root: Path,
                           edition: str = LEAF_EDITION
                           ) -> tuple[list[str], str]:
    """A relation's element keys are claimed by the unit carrying its evidence.

    `[[relations]]` says which appointed elements a claim joins, and
    `[[components]]` says which elements each unit draws on. When a relation
    rests on the source-grounded synthesis, that component has to claim every
    element the relation joins, or the manifest asserts a join in a unit that
    does not admit to reading one of its parts. The drift is invisible in
    either table alone.

    A leaf that predates the component manifest is out of scope and says so;
    `_components_scope` gives the rule and the profile text behind it. A leaf
    whose production writes a manifest and which carries none is refused.
    """
    manifest = leaf / MANIFEST
    if not manifest.is_file():
        required, why = _components_scope(leaf)
        if not required:
            return [], f"not in scope: {why}"
        return ([f"{why}, but the leaf carries no {MANIFEST}"], "")
    data = tomllib.loads(manifest.read_text(encoding="utf-8"))
    if data.get("schema") == 2:
        from _proper_components import audit_v2

        provider_root = root / "src" / leaf.relative_to(root / "src").parts[0]
        # The schema owns lane coverage. Scope validation checks those record
        # relations without demanding companions a later author will write.
        audit_v2(data, manifest, provider_root, phase="scope")
        return [], (f"{len(data['lanes'])} interpretive lanes, each declaring "
                    "all four senses and whole-proper component coverage")
    claimed: dict[str, set[str]] = {}
    for component in data.get("components", []):
        claimed.setdefault(component.get("kind", ""), set()).update(
            component.get("element_keys", []))
    problems = []
    relations = data.get("relations", [])
    for relation in relations:
        joins = set(relation.get("element_keys", []))
        for evidence in relation.get("evidence", []):
            kind = EVIDENCE_UNIT.get(evidence)
            if kind is None:
                continue
            unit = claimed.get(kind)
            if unit is None:
                problems.append(
                    f"relation {relation.get('key')!r} rests on {evidence} "
                    f"but the manifest declares no {kind} component")
            elif not joins <= unit:
                problems.append(
                    f"relation {relation.get('key')!r} joins "
                    f"{sorted(joins - unit)} which the {kind} component does "
                    f"not claim")
    return problems, (f"{len(relations)} relations, every element key "
                      f"claimed by the unit that carries its evidence")


# The forms the leaves actually use to say a source is not quoted. There is
# no field and no macro for it: the fact lives in the References entry's own
# prose, so the check reads the prose the profile asks an author to write.
DECLARES_UNQUOTED = re.compile(
    r"(is not quoted|are not quoted|was not quoted|were not quoted"
    r"|never quoted|not quoted here|summarised only|summarized only"
    r"|summarised rather than quoted|summarized rather than quoted"
    r"|was not used|were not used|supplies no English"
    r"|protected text is not reproduced)", re.I)

TITLED = re.compile(r"\\(?:work|emph|textit|sourceurl)\{")


def attributed_author(item: str) -> str | None:
    """The surname a References entry is attributed to, if it names one.

    Only the words before the entry's first title carry the author, and only
    the last of them is the surname. Nothing else in an entry is safe to
    match a quotation's attribution against: an entry about the 2002 typical
    edition is headed by the work, and matching its title would credit it
    with every passage printed from the 1962 one; an entry naming a homily
    on Luke would claim every Lucan pericope in the guide. An entry with no
    author is not checked, because there is nothing in it that identifies
    the source and only the source.
    """
    head = prose(TITLED.split(item, maxsplit=1)[0])
    names = [fold(word) for word in NAME.findall(head)]
    names = [name for name in names if name not in COMMON]
    return names[-1] if names else None


# `namedtranslation` and the `sourcecard` it is built on are the two
# environments whose argument names the witness a printed passage was taken
# from. A quotation elsewhere in the prose is not attributable mechanically:
# the same paragraph routinely quotes an original whose only translation is
# the one being declared unquoted, and testing for it refuses four published
# leaves that are correct.
BASE_ATTRIBUTED = ("namedtranslation", "sourcecard")

# ...but a leaf may rename them. `format.tex` is per-leaf, and six of the
# twenty published propers wrap the base environment in one of their own —
# `\fulltextenglish`, `\witnesscard` — passing the attribution straight
# through as `#1`. A check that matched only the base names saw *zero*
# attributed passages in those six, `49-ninth-after-pentecost` among them,
# which is the leaf both production runs were producing. It was not passing
# them; it was not reading them.
WRAPPER = re.compile(
    r"\\newenvironment\{([A-Za-z]+)\}(?:\[\d+\])?"
    r"\{[^\n]*?\\begin\{(?:" + "|".join(BASE_ATTRIBUTED) + r")\}")


def attributed_blocks(leaf: Path,
                      edition: str = LEAF_EDITION) -> list[str]:
    """The attribution argument of every printed passage the leaf sets.

    Reads `format.tex` for the leaf's own aliases of the base environments
    before scanning the body, so a renamed environment is still a printed
    passage. `format.tex` is read here and nowhere else: it defines the
    aliases and carries no prose of its own. It is read for the named edition
    too, because four leaves branch inside it and an alias defined in one
    branch alone is an alias in one edition alone.
    """
    names = set(BASE_ATTRIBUTED)
    format_tex = leaf / "format.tex"
    if format_tex.is_file():
        names.update(WRAPPER.findall(
            edition_text(leaf, format_tex, edition)))
    pattern = re.compile(
        r"\\begin\{(?:" + "|".join(sorted(names)) + r")\}"
        r"\{((?:[^{}]|\{[^{}]*\})*)\}")
    found = []
    for path in leaf_tex(leaf, edition):
        found.extend(pattern.findall(edition_text(leaf, path, edition)))
    return found


def check_unquoted_not_quoted(leaf: Path, root: Path,
                             edition: str = LEAF_EDITION
                             ) -> tuple[list[str], str]:
    """No source the leaf says it does not quote is credited with a quotation.

    A guide that states four times that it quotes a witness only at second
    hand, and then prints that witness's words as quoted text, contradicts
    itself in a way neither statement shows on its own.
    """
    references, _ = split_leaf(leaf, edition)
    if not references:
        return (["the leaf prints no References section"], "")
    declared = []
    for item in reference_items(references):
        # The fragments are hard-wrapped, so the declaration routinely spans
        # two lines and a line-shaped search would never see it whole.
        flat = " ".join(prose(item).split())
        if not DECLARES_UNQUOTED.search(flat):
            continue
        author = attributed_author(item)
        if author:
            declared.append((author, flat[:80]))
    problems = []
    for attribution in attributed_blocks(leaf, edition):
        credited = fold(prose(attribution))
        for author, entry in declared:
            if re.search(r"\b" + re.escape(author), credited):
                problems.append(
                    f"a quotation is credited to {author}, which the "
                    f"References declare unquoted: {entry}")
    return sorted(set(problems)), (
        f"{len(declared)} sources declared unquoted, none attributed a "
        f"quotation")


# --- Rights ----------------------------------------------------------------

# The source library is 5,977 TOML files. Every field this needs is a scalar
# on its own line, so the records are read by line rather than parsed: a full
# TOML parse of the library costs seconds on every gate run and answers no
# question this one does not.
RECORD_FIELD = re.compile(
    r'^(id|record_type|artifact_id|segment_id|edition_id|work_id|storage'
    r'|rights_status) = "([^"]*)"$')

RESTRICTED = "restricted"


def source_records(root: Path) -> dict[str, dict[str, str]]:
    """Every source record the library registers, keyed by its own id.

    Keyed by the recorded `id` and not by path, for the same reason
    `registered_ids` is: 185 of the ids do not match the directory their
    record lives in. `inventories/` is left out, as there: its `id =` lines
    are audit rows and register nothing.
    """
    records: dict[str, dict[str, str]] = {}
    for directory in ("works", "corpora"):
        library = root / "src" / "sources" / directory
        for path in sorted(library.rglob("*.toml")):
            fields: dict[str, str] = {}
            for line in path.read_text(encoding="utf-8").splitlines():
                match = RECORD_FIELD.match(line)
                if match:
                    fields.setdefault(match.group(1), match.group(2))
            if "id" in fields:
                records[fields["id"]] = fields
    return records


def artifact_is_restricted(records: dict[str, dict[str, str]],
                           artifact_id: str) -> bool:
    """Whether an artifact's own record forbids republishing its bytes.

    Either field is enough. `storage` says where the bytes may live and
    `rights_status` says what may be done with them, and a record that says
    `restricted` in one and something laxer in the other is not a licence
    found in the other field; it is a record to be read at its strictest.
    """
    record = records.get(artifact_id) or {}
    return RESTRICTED in (record.get("storage"), record.get("rights_status"))


def controlling_artifacts(records: dict[str, dict[str, str]],
                          source_id: str) -> list[str]:
    """The artifacts whose bytes a bound source id would be reproduced from.

    Rights are recorded per artifact, never per abstract work, so every other
    kind of record has to be walked down to the artifacts under it. A passage
    reaches its artifact directly or, under schema 2, through the segment that
    bounds it; an edition or a work reaches all of theirs.
    """
    record = records.get(source_id)
    if record is None:
        return []
    kind = record.get("record_type")
    if kind == "artifact":
        return [source_id]
    if kind in ("passage", "segment"):
        if record.get("artifact_id"):
            return [record["artifact_id"]]
        segment = records.get(record.get("segment_id", "")) or {}
        return [segment["artifact_id"]] if segment.get("artifact_id") else []
    if kind in ("edition", "work"):
        editions = (
            [source_id] if kind == "edition"
            else [rid for rid, other in records.items()
                  if other.get("record_type") == "edition"
                  and other.get("work_id") == source_id]
        )
        return sorted(
            rid for rid, other in records.items()
            if other.get("record_type") == "artifact"
            and other.get("edition_id") in set(editions)
        )
    if kind == "corpus":
        # A corpus record lists its members in an array this line reader does
        # not see. Its members are artifacts, and each is bound in its own
        # right where it is reproduced from, so nothing is decided here.
        return []
    return []


def source_is_restricted(records: dict[str, dict[str, str]],
                         source_id: str) -> bool | None:
    """Whether reproducing this source means reproducing restricted bytes.

    `None` where the library cannot say: an id it does not register, or a
    record with no artifact under it. Unknown is not innocent and it is not
    guilty either — `identifiers-resolve` is the check that an id resolves at
    all, and this one does not duplicate its refusal in a rights message.

    An edition or a work counts as restricted only when every artifact under
    it is, because one unrestricted artifact is a lawful thing to have
    reproduced from and this check cannot tell which was used.
    """
    artifacts = controlling_artifacts(records, source_id)
    if not artifacts:
        return None
    return all(artifact_is_restricted(records, a) for a in artifacts)


BINDINGS = "research/source-bindings.toml"

# The one role that says, of the source it is given to, that the published
# English *is* that source's words. The propers profile leaves no other
# reading: "English is never composed, translated, adapted, or paraphrased by
# the guide. It is quoted from a registered public-domain witness." So a
# translation control that resolves to restricted bytes is a contradiction
# between two files, and neither shows it alone.
#
# Deliberately just the one. `textual-control`, `official-control` and
# `direct-witness` say a source governs or attests a claim, not that its words
# were set in type: twenty-nine bindings in the fifteen documents this gate
# runs on carry one of those roles against a restricted artifact, and every one
# of them is a published leaf that is right. A check that refused them would be
# refusing correctness.
REPRODUCING_ROLE = "translation-control"


def bound_sources(leaf: Path) -> list[tuple[str, str]]:
    """Every `(source_id, role)` the leaf's research bound, in file order."""
    path = leaf / BINDINGS
    if not path.is_file():
        return []
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    return [(b.get("source_id", ""), b.get("role", ""))
            for b in data.get("bindings", [])
            if b.get("source_id")]


def source_anchors(records: dict[str, dict[str, str]],
                   source_id: str) -> set[str]:
    """The distinctive words by which a printed attribution could name a source.

    A leaf attributes a printed passage in prose — "Douay--Rheims/Challoner",
    "New American Bible, Revised Edition" — and never by id. So identity here
    is the same kind of thing `anchors` builds for a References entry: the
    distinctive words of the work, taken from the id's own work and edition
    slugs. Nothing is read from the artifact record, because the words a reader
    is given name the work, not the file it was fetched as.
    """
    parts = source_id.split(".")
    words = " ".join(parts[1:4]).replace("-", " ")
    return {token for token in re.findall(r"[a-z0-9]+", fold(words))
            if len(token) >= 5 and token not in COMMON}


def check_restricted_not_reproduced(
    leaf: Path, root: Path, edition: str = LEAF_EDITION
) -> tuple[list[str], str]:
    """Nothing the leaf prints is reproduced from an artifact it may not copy.

    Until now no check in this file read `src/sources/` for rights at all.
    `unquoted-not-quoted` compares the leaf against itself, so a guide could be
    perfectly self-consistent about a text it had no right to publish, and one
    was: an earlier production of this collection reproduced a
    `storage = "restricted"` NABRE verbatim at ten loci and passed every gate,
    because no gate connected an artifact's rights record to the leaf's text.

    Two independent ways the connection can be made mechanically, and a defect
    only has to show in one:

    - the leaf *declares* the reproduction, by binding a restricted source as
      its `translation-control` — the role that means the published English is
      this witness's words; or
    - the leaf *prints* it, attributing a set passage to a bound source whose
      bytes are restricted.

    The second reads only attributions that discriminate: a word shared by two
    of the leaf's own bound sources cannot say which was meant, so it is not
    used. That leaves nothing to say about a source the leaf never bound, which
    is a real hole and the honest one to leave — the rights of an artifact
    nobody recorded cannot be read from a record that does not exist.
    """
    bound = bound_sources(leaf)
    if not bound:
        return (["the leaf records no research/source-bindings.toml"], "")
    records = source_records(root)

    problems = []
    restricted = []
    for source_id, role in bound:
        if source_is_restricted(records, source_id) is not True:
            continue
        restricted.append(source_id)
        if role == REPRODUCING_ROLE:
            problems.append(
                f"{source_id} is bound as {REPRODUCING_ROLE}, so the guide's "
                f"published English is its words, but its artifact is "
                f"registered {RESTRICTED}: those bytes may not be reproduced "
                f"here at all")

    anchors_by_source = {sid: source_anchors(records, sid)
                         for sid, _ in bound}
    times_used: dict[str, int] = {}
    for words in anchors_by_source.values():
        for token in words:
            times_used[token] = times_used.get(token, 0) + 1

    for attribution in attributed_blocks(leaf, edition):
        credited = fold(prose(attribution))
        for source_id in restricted:
            naming = sorted(
                token for token in anchors_by_source[source_id]
                if times_used[token] == 1
                and re.search(r"\b" + re.escape(token), credited)
            )
            if naming:
                problems.append(
                    f"a set passage is attributed to {source_id}, whose "
                    f"artifact is registered {RESTRICTED} and may not be "
                    f"reproduced: "
                    f"{' '.join(prose(attribution).split())[:90]}")

    return sorted(set(problems)), (
        f"{len(bound)} bound sources, {len(restricted)} of them restricted, "
        f"none reproduced")


# --- The leaf against the run producing it ---------------------------------

# The record's fields this check holds against the run, in the order
# `\AIGenerationProvenance` writes them, each with the option that supplies
# what the run says it should be. `install_commit` is deliberately absent: it
# states the commit the produced artifact entered the tree on, and while a
# document is being written that commit does not exist.
RUN_FIELDS = (
    ("workflow_id", "--run-workflow"),
    ("workflow_version", "--run-workflow-version"),
    ("workflow_digest", "--run-workflow-digest"),
    ("run_id", "--run-id"),
    ("seed_commit", "--run-seed-commit"),
)

RUN_CHECK = "provenance-matches-run"


def check_bindings_valid(leaf: Path, root: Path,
                        edition: str = LEAF_EDITION
                        ) -> tuple[list[str], str]:
    """The leaf's own binding record, held to the library's own schema.

    `author-proper` writes this file, and until this check the only thing in a
    run that read it was `restricted-not-reproduced`, which reads two of its
    fields. Everything else the record asserts — that an id names a source the
    library registers, that a role and a state are words the schema knows,
    that a fingerprint is the one the bound record actually computes to — was
    checked only by `tools/source-library validate`, which no stage of any
    workflow runs. A published leaf carried a stale binding fingerprint for a
    month under that gap, unnoticed by every gate the workflow has; this check
    named it on its first run, and re-reading what the leaf rested on the
    moved record for is what closed it.

    The validator is the whole library or nothing, so this reports only the
    lines naming this leaf's file. Another publication's error is that
    publication's to review, and failing a production over one would stop it
    for a defect it did not write and may not repair. Their number is still
    reported, because a clean line here means nothing if the library never
    got as far as this file.

    A changed fingerprint is not a value to paste back. It says the bound
    record moved, so what the leaf rests on it for is re-read first; the
    library states that obligation and this check only makes it arrive.
    """
    path = leaf / BINDINGS
    if not path.is_file():
        return ([f"the leaf records no {BINDINGS}"], "")
    # The tool lives beside this one in the repository, and `root` is the tree
    # being judged, which is not always the same place: a synthetic tree has no
    # `tools/` at all. Resolving the validator against `root` ran a script that
    # was not there and reported its exit 2 as though the library had refused
    # the leaf, so every `--root` invocation failed for a reason that had
    # nothing to do with the bindings.
    proc = subprocess.run(
        [sys.executable, str(Path(__file__).resolve().parent
                             / "source-library"),
         "--root", str(root), "validate"],
        capture_output=True, text=True)
    prefix = f"{path.relative_to(root).as_posix()}: "
    problems, elsewhere = [], 0
    for line in (proc.stdout + proc.stderr).splitlines():
        message = line.split("source-library error: ", 1)[-1]
        if message.startswith(prefix):
            problems.append(message[len(prefix):])
        elif message != line:
            elsewhere += 1
    if proc.returncode not in (0, 1):
        problems.append(
            f"tools/source-library validate did not run: exit "
            f"{proc.returncode}")
    others = ""
    if elsewhere:
        plural = "" if elsewhere == 1 else "s"
        others = (f", and {elsewhere} error{plural} in other publications' "
                  f"files, left to them")
    return sorted(set(problems)), (
        f"{len(bound_sources(leaf))} bindings, every id registered and every "
        f"reviewed state fingerprinted as the library computes it{others}")


def check_provenance_matches_run(
    leaf: Path, root: Path, run: dict[str, str],
    edition: str = LEAF_EDITION
) -> tuple[list[str], str]:
    """The leaf states the run producing it, and not some earlier one.

    `check-generation-metadata` requires every leaf to carry exactly one
    `\\AIGenerationProvenance` record, and the authoring fragment tells the
    stage to copy the workflow, version, digest, run id and seed commit off its
    own packet header. Nothing read the result. So the record could state any
    run at all and still satisfy every gate, which is not a hypothetical: a
    `v10` written into the prose of an `\\AIModelContribution` survived a v11
    pass and became a structured fact, exactly the copying the fragment
    forbids and exactly what no check was in a position to see.

    Only the run can settle this. A leaf compared against itself is consistent
    with whatever it says, and the tree holds no other statement of which run
    is driving the stage — which is why this check takes the run's identity as
    arguments and the `content-preflight` gate hands it the engine's own
    values. It is refused rather than skipped when they are absent: a check
    that passed for want of an answer would be worth less than no check.

    THAT IT RUNS AT ALL IS A PROPERTY OF `workflows/pipelines/proper.json`,
    NOT OF THIS TOOL. It sits in `RUN_CHECKS` and is deliberately left out of
    the default sweep, because a bare invocation has no run to compare
    against; so `check-content-preflight --document X` with no `--check`
    passes a leaf that understates its workflow version, and says nothing
    about it. The pipeline is what names this check in the
    `content-preflight` gate and substitutes the engine's `{run.*}` facts
    into its command line, and the pipeline is therefore what any other
    contract resting on this one — the chronology contract binding from v17,
    for instance — actually rests on. Read the gate's `checks` list, never
    this file, to learn whether it is enforced for a given workflow.
    """
    missing = [option for field, option in RUN_FIELDS if not run.get(field)]
    if missing:
        raise ValueError(
            f"this check holds the leaf's provenance record against the run "
            f"producing it, so it needs the run's own identity: "
            f"{', '.join(missing)}. The `content-preflight` gate supplies "
            f"them from the engine; by hand, read them off a packet header."
        )

    metadata = leaf / "generation-metadata.tex"
    if not metadata.is_file():
        return ([
            "the leaf has no generation-metadata.tex, so it states nothing "
            "about what produced it"
        ], "")

    found = PRODUCTION_RE.findall(active_tex(
        metadata.read_text(encoding="utf-8")))
    if not found:
        return ([
            "generation-metadata.tex carries no \\AIGenerationProvenance "
            "record; the record states which workflow, at which version and "
            "digest, under which run and from which seed commit produced this "
            "leaf, and every leaf is required to carry one"
        ], "")
    if len(found) > 1:
        return ([
            f"generation-metadata.tex carries {len(found)} "
            f"\\AIGenerationProvenance records; exactly one run produced "
            f"this leaf, so exactly one record may state which"
        ], "")

    recorded = dict(zip(PRODUCTION_FIELDS,
                        (value.strip() for value in found[0])))
    problems = []
    for field, option in RUN_FIELDS:
        stated, expected = recorded[field], run[field]
        if stated == expected:
            continue
        problems.append(
            f"the record states {field} {stated!r}; the run producing this "
            f"leaf has {field} {expected!r}. Read it off this packet's own "
            f"header, never off the leaf's existing record or the prose of an "
            f"earlier contribution."
        )
    return problems, (
        f"the record states run {run['run_id']} of {run['workflow_id']} "
        f"v{run['workflow_version']}, digest {run['workflow_digest'][:12]}, "
        f"seed commit {run['seed_commit'][:12]}"
    )


# --- The leaf against the Scripture chronology corpus -----------------------
#
# `guidance/scripture-chronology.md` §14: a proper that needs a biblical date
# MUST read `src/sources/chronology/`, and MUST NOT independently infer,
# research, harmonize or assign a replacement. Where the corpus returns an
# unresolved state the proper preserves that state or omits the date.
#
# Three checks, because the contract's surfaces are invisible to one another.
# `chronology-record-current` holds the leaf's audit ids against what the
# corpus answers now. `chronology-annotations-current` holds the generated
# reader-facing projection against that answer. `chronology-claims-supported`
# holds the Date cells against the same answer or checked projection, and
# refuses a date printed outside either route at all — the half that catches a
# recalled figure, since a well-formed year reads exactly like a right one. A
# dossier row's per-passage date (`PER_PASSAGE_DATE`) is the one other route,
# held to the answer at the passage its label names.
#
# THE CONTRACT BINDS FROM `proper` VERSION 17 and from the first
# `proper-finish` workflow, and the leaf itself says which workflow version
# produced it. Every leaf published before this wiring existed states `proper`
# v11 or `unknown` in the `\AIGenerationProvenance` record that
# `provenance-matches-run` holds against the run, so the two checks interlock:
# a stage cannot dodge the chronology contract by understating its version
# without failing the check that compares that version with the run driving
# it. A leaf that carries a chronology record is fully held to it whatever
# workflow or version it states: carrying the generated answer adopts both its
# currentness and its one-cell-per-appointed-Scripture discipline.
#
# THAT INTERLOCK IS THE PIPELINE'S, NOT THIS TOOL'S.
# `provenance-matches-run` is excluded from the default sweep because a bare
# invocation has no run to compare against, so a hand-run
# `check-content-preflight --document X` reads a leaf's own version claim and
# does not test it. What makes the version claim binding is that
# `workflows/pipelines/proper.json` names that check in the same
# `content-preflight` gate as these two and feeds it the engine's `{run.*}`
# facts. Both halves have to be in that gate for either to mean anything, and
# nothing in this file can keep them there.
# Which productions the chronology contracts bind, and from which version of
# each. `proper-finish` begins at `author-proper` and runs the same preflight as
# `proper`, but records its own workflow id; both tables therefore have to be
# keyed by the workflow the leaf actually names.
CHRONOLOGY_FROM_VERSION = {
    "proper": 17,
    "proper-finish": 1,
}
ANNOTATIONS_FROM_VERSION = {
    "proper": 24,
    "proper-finish": 2,
}

# How a leaf prints a biblical date, and how it prints the cell one belongs in.
#
#   \chronology{subject}{relation}{label}   one assertion the corpus makes
#   \chronodate{element-keys}{content}      one dossier row's date cell
#
# The macros are the leaf's own — `author-proper.md` states what they must
# render — and they exist so that a date has a machine-readable claim behind
# it. `workflows/fragments/propers/author-proper.md` is where an author is
# told to use them; this is what makes the instruction more than an
# instruction.
CHRONOLOGY_CLAIM = "chronology"
CHRONOLOGY_CELL = "chronodate"
CHRONOLOGY_ANNOTATION = "chronologyannotation"
SEALED_ANNOTATION_MACROS = (
    "chronologyannotation",
    "chronologyannotationgroup",
    "chronologyannotationclaim",
    "chronologyannotationcomparisongroup",
    "chronologyannotationcomparisonclaim",
    "chronologyannotationreach",
)
SEALED_ANNOTATION_NAMES = "|".join(SEALED_ANNOTATION_MACROS)
LATEX_COMMAND_DEFINITION = re.compile(
    r"\\(?P<kind>newcommand|renewcommand|providecommand|DeclareRobustCommand|"
    r"NewDocumentCommand|RenewDocumentCommand|ProvideDocumentCommand|"
    r"DeclareDocumentCommand)\*?\s*(?:\{\s*)?\\"
    rf"(?P<name>{SEALED_ANNOTATION_NAMES})\b(?:\s*\}})?"
)
TEX_PRIMITIVE_DEFINITION = re.compile(
    r"(?:\\(?:global|long|outer|protected)\s*)*"
    r"\\(?P<kind>def|gdef|edef|xdef|let|futurelet)\s*\\"
    rf"(?P<name>{SEALED_ANNOTATION_NAMES})\b"
)
CSNAME_PRIMITIVE_DEFINITION = re.compile(
    r"(?:\\expandafter\s*)*(?:\\(?:global|long|outer|protected)\s*)*"
    r"\\(?P<kind>def|gdef|edef|xdef|let|futurelet)\s*"
    r"\\csname\s*(?P<name>"
    rf"{SEALED_ANNOTATION_NAMES})\s*\\endcsname"
)
ETOOLBOX_COMMAND_DEFINITION = re.compile(
    r"\\(?P<kind>csdef|csgdef|csedef|csxdef)\s*\{\s*"
    rf"(?P<name>{SEALED_ANNOTATION_NAMES})\s*\}}"
)
EXPL3_COMMAND_DEFINITION = re.compile(
    r"\\(?P<kind>cs_(?:g)?(?:set|new)(?:_eq)?):[A-Za-z]+\s*\\"
    rf"(?P<name>{SEALED_ANNOTATION_NAMES})\b"
)
DATE_CELL_LATEX_DEFINITION = re.compile(
    r"\\(?P<kind>newcommand|renewcommand|providecommand|DeclareRobustCommand|"
    r"NewDocumentCommand|RenewDocumentCommand|ProvideDocumentCommand|"
    r"DeclareDocumentCommand)\*?\s*(?:\{\s*)?\\"
    rf"(?P<name>{CHRONOLOGY_CELL})\b(?:\s*\}})?"
)
DATE_CELL_TEX_DEFINITION = re.compile(
    r"(?:\\(?:global|long|outer|protected)\s*)*"
    r"\\(?P<kind>def|gdef|edef|xdef|let|futurelet)\s*\\"
    rf"(?P<name>{CHRONOLOGY_CELL})\b"
)
DATE_CELL_CSNAME_DEFINITION = re.compile(
    r"(?:\\expandafter\s*)*(?:\\(?:global|long|outer|protected)\s*)*"
    r"\\(?P<kind>def|gdef|edef|xdef|let|futurelet)\s*"
    rf"\\csname\s*(?P<name>{CHRONOLOGY_CELL})\s*\\endcsname"
)
DATE_CELL_ETOOLBOX_DEFINITION = re.compile(
    r"\\(?P<kind>csdef|csgdef|csedef|csxdef)\s*\{\s*"
    rf"(?P<name>{CHRONOLOGY_CELL})\s*\}}"
)
DATE_CELL_EXPL3_DEFINITION = re.compile(
    r"\\(?P<kind>cs_(?:g)?(?:set|new)(?:_eq)?):[A-Za-z]+\s*\\"
    rf"(?P<name>{CHRONOLOGY_CELL})\b"
)
CANONICAL_DATE_CELL_WRAPPER = re.compile(
    r"\\newcommand\s*\{\s*\\chronodate\s*\}\s*"
    r"\[\s*2\s*\]\s*\{\s*#2\s*\}"
)
DIGIT = re.compile(r"[0-9]")
TIE = re.compile(r"~|\\,|\\;|\\:|\\ |\\quad|\\qquad|\\thinspace")
DASH = re.compile(r"-{2,}|–|—")


def _normalized_label(text: str) -> str:
    """A printed label reduced to what it says, so typesetting is not a diff.

    A guide sets `A.~M.~2944` and the corpus holds `A. M. 2944`; an en-dash is
    `--` on the page and `-` in the source it was read from. Neither is a
    different date, and a check that called them different would be teaching
    authors to fight it rather than to quote. Nothing else is folded: a digit,
    a word and a letter case all stay exactly as printed.
    """
    text = TIE.sub(" ", text)
    text = DASH.sub("-", text)
    return " ".join(text.split())


# Era-qualified dates are chronology prose even when they sit outside the
# Date-cell API.  Both orders occur in the corpus and in TeX: ``A.D.~70`` and
# ``570--536~B.C.``.  The optional leading word covers open boundaries such as
# the NABRE's quoted ``post-A.D. 70 date``.  A narrow era requirement avoids
# treating verse numbers, source volume numbers, and civil retrieval dates as
# biblical chronology claims.
ERA = r"(?:A\.\s*D\.|B\.\s*C\.|A\.\s*M\.)"
YEAR_OR_SPAN = r"[0-9]+(?:\s*(?:-{1,2}|–|—|to|or)\s*[0-9]+)?"
MANUAL_CHRONOLOGY_DATE = re.compile(
    rf"(?ix)(?:\b(?:post-|pre-|after\s+|before\s+|about\s+|c\.\s*~?\s*)?"
    rf"{ERA}\s*~?\s*{YEAR_OR_SPAN}(?:\s+date)?\b|"
    rf"\b(?:about\s+|c\.\s*)?{YEAR_OR_SPAN}\s*~?\s*{ERA})"
)
ERA_IN_DATE = re.compile(ERA, re.I)

# A manual date that omits its era is still a chronology claim. Keep this
# deliberately narrower than arbitrary numbers: it reaches qualified dates,
# two- or three-digit spans that are not verse ranges, and explicit
# ``between N and N`` intervals. Chapter spans are screened at the match
# site. Authors can always avoid ambiguity by leaving the date in the
# generated annotation and referring to "the displayed range" in prose.
QUALIFIED_ERALESS_DATE = re.compile(
    rf"(?ix)\b(?:post-|pre-|after\s+|before\s+|about\s+|c\.\s*~?\s*)"
    rf"(?!{ERA}\b){YEAR_OR_SPAN}\b"
)
BARE_ERALESS_SPAN = re.compile(
    r"(?ix)(?<![:\d])\b[0-9]{2,3}\s*(?:-{1,2}|–|—|to|or)\s*"
    r"[0-9]{2,3}\b"
)
BETWEEN_ERALESS_SPAN = re.compile(
    r"(?ix)\bbetween\s+[0-9]{2,3}\s+and\s+[0-9]{2,3}\b"
)


def _date_signature(value: str) -> tuple[str, str, tuple[int, ...]] | None:
    """The era, temporal relation and years in one TeX-neutral date.

    Direction and precision are meaning, not typography: a post-A.D. 70
    boundary must never authorize pre-70, exact-70 or merely approximate-70
    prose.
    """
    normalized = _normalized_label(value)
    era = ERA_IN_DATE.search(normalized)
    if era is None:
        return None
    era_key = re.sub(r"[^A-Za-z]", "", era.group(0)).upper()
    years = tuple(int(item) for item in re.findall(r"[0-9]+", normalized))
    lowered = normalized.lower()
    if re.search(r"(?:\bpost-|\bafter\s+)", lowered):
        relation = "after"
    elif re.search(r"(?:\bpre-|\bbefore\s+)", lowered):
        relation = "before"
    elif re.search(r"(?:\babout\s+|(?:^|\s)c\.\s*)", lowered):
        relation = "approximate"
    else:
        relation = "exact"
    return (era_key, relation, years) if years else None


# A PER-PASSAGE DATE, the one form in which a dossier's explanatory row may
# date one of its passages rather than the whole element (maintainer decision,
# 2026-09-23, escalation STU-005). The Date cell prints only what holds at
# every locus the element appoints, so an Introit joining Ecclus 36:18 to
# Ps 121:1 has no element-wide date at all; its row may instead say
#
#     Ecclus~36:18: 190--170~B.C. or c.~280~B.C.; Ps~121:1: before c.~165~B.C.
#
# A citation, a colon, and the date straight after it; further answers for the
# same passage follow as `or <date>`. The label is a claim about a locus, so it
# is held to that locus and nowhere else: the date must be one the generated
# record gives at every verse the label names, the label must name the row's
# own verses, and a label no citation grammar reads is refused rather than
# ignored. The date carries its whole relation — `before c. 165 B.C.` is a
# boundary here, where the edition-wide scan reads only `c. 165 B.C.`.
PASSAGE_BOOK = r"(?:[1-4]\s*)?[A-Z][A-Za-z]*\.?"
PASSAGE_POINT = r"[0-9]+(?::[0-9]+)?[a-z]?"
PASSAGE_EXTENT = rf"{PASSAGE_POINT}(?:\s*(?:-{{1,2}}|–|—)\s*{PASSAGE_POINT})?"
PASSAGE_VERSES = (
    rf"[0-9]+:[0-9]+[a-z]?(?:\s*(?:-{{1,2}}|–|—)\s*{PASSAGE_POINT})?"
    rf"(?:\s*,\s*{PASSAGE_EXTENT})*"
)
PASSAGE_DATE = (
    rf"(?i:(?:(?:before|after|about)\s+|post-|pre-)?(?:c\.\s*)?"
    rf"(?:{ERA}\s*{YEAR_OR_SPAN}|{YEAR_OR_SPAN}\s*{ERA}))"
)
PER_PASSAGE_DATE = re.compile(
    rf"(?<![A-Za-z0-9])(?P<citation>{PASSAGE_BOOK}\s+{PASSAGE_VERSES})"
    rf"\s*:\s*(?P<dates>{PASSAGE_DATE}(?:\s*,?\s+or\s+{PASSAGE_DATE})*)"
)
ONE_PASSAGE_DATE = re.compile(PASSAGE_DATE)
DOSSIER_PROSE = "dossierprose"


def _untied(text: str) -> str:
    """TeX spacing commands as spaces of the same length, so offsets hold."""
    return TIE.sub(lambda match: " " * len(match.group(0)), text)


def _blank(text: str, start: int, stop: int) -> str:
    """`text` with `[start, stop)` replaced by spaces, line breaks kept."""
    return text[:start] + re.sub(r"[^\n]", " ", text[start:stop]) + text[stop:]


def _passage_loci(citation: str) -> tuple[str, ...]:
    """The corpus loci a per-passage label names, or ValueError saying why.

    The verses are read by `tools/citations`, the grammar every appointment
    is encoded with, and become loci through the same wiring that built the
    record, so a label and the record cannot spell one verse two ways. The
    book may be spelled as that grammar knows it (`Mt`, `1 Cor`, `Sir`) or as
    the corpus's own token (`Ecclus`, `Matt`, `1Cor`); where both read the
    same spelling as different books (`1 Kings`), it names neither.
    """
    import _proper_chronology_inputs  # noqa: PLC0415

    wiring = _wiring()
    grammar = _proper_chronology_inputs._citations()
    text = " ".join(DASH.sub("-", citation).split())
    text = re.sub(r"\s*-\s*", "-", re.sub(r"\s*,\s*", ", ", text))
    split = re.match(r"((?:[1-4]\s*)?[A-Za-z]+)\.?\s+(.+)", text)
    if split is None:
        raise ValueError("no book and verse")
    book, verses = split.groups()
    by_token = {token: name for name, token in wiring._tokens().items()}
    readings = set()
    try:
        readings.add(wiring._tokens()[grammar.canonical_book(book)])
    except (KeyError, grammar.CitationError):
        pass
    if re.sub(r"\s+", "", book) in by_token:
        readings.add(re.sub(r"\s+", "", book))
    if not readings:
        raise ValueError(f"no book is spelled {book!r}")
    if len(readings) > 1:
        raise ValueError(
            f"{book!r} is {' and '.join(sorted(readings))} at once; spell the "
            f"book so that only one of them reads it")
    token = readings.pop()
    try:
        passage = grammar.parse_citation(f"{by_token[token]} {verses}")
    except grammar.CitationError as exc:
        raise ValueError(str(exc)) from None
    return tuple(dict.fromkeys(wiring._loci_of(passage, citation)))


def _claim_signatures(claim) -> set[tuple[str, str, tuple[int, ...]]]:
    """Every era signature the record authorizes for one claim."""
    return {
        signature
        for value in (claim.label, _wiring().concise_display_label(claim))
        if (signature := _date_signature(value)) is not None
    }


def _per_passage_dates(
    text: str,
    cells: list[tuple[list[str], int, int]],
    found,
    comparisons: dict[str, list],
    name: Path,
) -> tuple[list[str], str, int]:
    """Hold each dossier row's per-passage dates to the passage they name.

    A row is the `\\dossierprose` explanation after an element's
    `\\chronodate` cell, and it answers for the elements that cell names.
    Returns the refusals, `text` with every date judged here blanked so the
    edition-wide scan does not judge it a second time against the whole
    formulary, and how many labelled dates passed.
    """
    problems: list[str] = []
    passed = 0
    starts = [
        (at, [key.strip() for key in args[0].split(",") if key.strip()])
        for args, at, _stop in cells
    ]
    for _args, at, stop in _macro_calls(text, DOSSIER_PROSE, 1):
        owners = [keys for cell_at, keys in starts if cell_at < at]
        if not owners:
            continue
        keys = owners[-1]
        elements = [e for e in map(found.element, keys) if e is not None]
        row_loci = tuple(dict.fromkeys(
            locus for element in elements for locus in element.loci))
        if not row_loci:
            continue
        held = [
            (claim, frozenset(reach.locus for reach in claim.reaches))
            for element in elements
            for claim in (*element.claims, *comparisons.get(element.key, ()))
        ]
        row_wide = {
            signature for claim, reach in held if reach >= set(row_loci)
            for signature in _claim_signatures(claim)
        }
        open_brace = text.index("{", at + len(DOSSIER_PROSE) + 1)
        base = open_brace + 1
        content = _untied(text[base:stop - 1])
        row = ", ".join(keys)
        judged: list[tuple[int, int]] = []

        def line_of(offset: int) -> int:
            return text.count("\n", 0, base + offset) + 1

        for match in PER_PASSAGE_DATE.finditer(content):
            judged.append((match.start(), match.end()))
            citation = " ".join(match.group("citation").split())
            where = f"{name}:{line_of(match.start())}"
            try:
                loci = _passage_loci(citation)
            except ValueError as exc:
                problems.append(
                    f"{where}: per-passage date label {citation!r} names no "
                    f"passage ({exc}). A row dates one of its passages as "
                    "`<citation>: <date>`, the book spelled as tools/citations "
                    "or the chronology corpus spells it: "
                    "guidance/scripture-chronology.md section 14.1.")
                continue
            outside = [locus for locus in loci if locus not in row_loci]
            if outside:
                problems.append(
                    f"{where}: per-passage date label {citation!r} names "
                    f"{', '.join(outside)}, which the {row} row does not "
                    f"appoint (it appoints {', '.join(row_loci)}); a row "
                    "dates only its own passages.")
                continue
            answer = [claim for claim, reach in held if reach >= set(loci)]
            allowed = {
                signature for claim in answer
                for signature in _claim_signatures(claim)
            }
            for date in ONE_PASSAGE_DATE.finditer(match.group("dates")):
                printed = _normalized_label(date.group(0))
                signature = _date_signature(printed)
                if signature in allowed:
                    passed += 1
                    continue
                elsewhere = sorted({
                    locus for claim, reach in held
                    if signature in _claim_signatures(claim)
                    for locus in reach
                } - set(loci))
                holds = sorted({
                    _wiring().concise_display_label(claim) for claim in answer
                })
                because = (
                    f"the record gives it at {', '.join(elsewhere)}, not at "
                    f"{', '.join(loci)}" if elsewhere else
                    f"at {', '.join(loci)} the record gives "
                    f"{holds or 'no date'}")
                problems.append(
                    f"{where}: per-passage date {citation}: {printed!r} is not "
                    f"the generated record's answer for that passage; "
                    f"{because}. A per-passage date is the one the record "
                    "holds for the passage its label names: "
                    "guidance/scripture-chronology.md section 14.1.")
        for match in MANUAL_CHRONOLOGY_DATE.finditer(content):
            if any(match.start() < stop_ and match.end() > start_
                   for start_, stop_ in judged):
                continue
            signature = _date_signature(match.group(0))
            if signature is None or signature in row_wide:
                continue
            partial = sorted({
                locus for claim, reach in held
                if signature in _claim_signatures(claim) for locus in reach
            })
            if not partial:
                continue
            judged.append((match.start(), match.end()))
            printed = _normalized_label(match.group(0))
            problems.append(
                f"{name}:{line_of(match.start())}: {printed!r} in the {row} "
                f"row is the generated record's answer only at "
                f"{', '.join(partial)}, not at every passage the row appoints "
                f"({', '.join(row_loci)}), and carries no locus label. Write "
                f"it as `<citation>: {printed}` naming that passage, or refer "
                "to the displayed date: guidance/scripture-chronology.md "
                "section 14.1.")
        for start_, stop_ in judged:
            text = _blank(text, base + start_, base + stop_)
    return problems, text, passed


def _annotation_macro_definitions(leaf: Path, generated: Path) -> list[str]:
    """Definitions of the generated annotation API outside its own artifact.

    A byte-current generated file proves nothing about what reaches the reader
    if a leaf can redefine its public macros afterwards. Calls are expected in
    Date cells; definitions belong only to the generated file. Scan every TeX
    file, including `format.tex`, which `leaf_tex()` rightly excludes from prose
    checks but which is exactly where a shadow definition would otherwise hide.
    """
    patterns = (
        LATEX_COMMAND_DEFINITION,
        TEX_PRIMITIVE_DEFINITION,
        CSNAME_PRIMITIVE_DEFINITION,
        ETOOLBOX_COMMAND_DEFINITION,
        EXPL3_COMMAND_DEFINITION,
    )
    problems: list[str] = []
    paths = sorted({
        path
        for pattern in ("*.tex", "*.sty", "*.cls")
        for path in leaf.rglob(pattern)
    })
    for path in paths:
        if path == generated:
            continue
        text = active_tex(path.read_text(encoding="utf-8"))
        matches = sorted(
            (match.start(), match.group("kind"), match.group("name"))
            for pattern in patterns for match in pattern.finditer(text)
        )
        for at, kind, name in matches:
            line = text.count("\n", 0, at) + 1
            problems.append(
                f"{path.relative_to(leaf)}:{line}: \\{kind} defines sealed "
                f"\\{name} outside {generated.relative_to(leaf)}; the "
                "generated annotation API may be called but not replaced, or "
                "a current projection can render different words"
            )
    return problems


def _date_cell_wrapper_integrity(
    leaf: Path, root: Path, edition: str = LEAF_EDITION
) -> list[str]:
    """The checked annotation remains the content TeX typesets for a cell.

    Historical leaves own the wrapper in `format.tex`; migrated leaves use the
    explicitly imported shared proper template. Either owner must pass argument
    two through unchanged, and a leaf may not shadow the shared definition.
    """
    patterns = (
        DATE_CELL_LATEX_DEFINITION,
        DATE_CELL_TEX_DEFINITION,
        DATE_CELL_CSNAME_DEFINITION,
        DATE_CELL_ETOOLBOX_DEFINITION,
        DATE_CELL_EXPL3_DEFINITION,
    )
    problems: list[str] = []
    canonical = 0
    owner = leaf / "format.tex"
    manifest = leaf / "proper-components.toml"
    if manifest.is_file():
        from _proper_components import format_contract

        data = tomllib.loads(manifest.read_text(encoding="utf-8"))
        if format_contract(data):
            owner = root / "src/common/propers-format.tex"
            template_import = re.compile(
                r"\\input\s*\{common/propers-format(?:\.tex)?\}")
            for entry in entry_files(leaf, edition):
                path = leaf / entry
                if not path.is_file():
                    problems.append(f"{entry}: missing shared-template entrypoint")
                    continue
                text = active_tex(path.read_text(encoding="utf-8"))
                preamble = text.split(r"\begin{document}", 1)[0]
                if (len(template_import.findall(preamble)) != 1 or
                        len(template_import.findall(text)) != 1):
                    problems.append(
                        f"{entry}: requires exactly one literal "
                        r"\input{common/propers-format} in its preamble")
    owner_name = owner.relative_to(root).as_posix()
    if not owner.is_file():
        problems.append(f"{owner_name}: missing date-cell wrapper owner")
    paths = {
        path
        for pattern in ("*.tex", "*.sty", "*.cls")
        for path in leaf.rglob(pattern)
    }
    if owner.is_file():
        paths.add(owner)
    for path in sorted(paths):
        text = active_tex(path.read_text(encoding="utf-8"))
        matches = sorted(
            (match.start(), match.group("kind"), match.group("name"))
            for pattern in patterns for match in pattern.finditer(text)
        )
        for at, kind, name in matches:
            if (path == owner and kind == "newcommand" and
                    CANONICAL_DATE_CELL_WRAPPER.match(text, at)):
                canonical += 1
                continue
            line = text.count("\n", 0, at) + 1
            problems.append(
                f"{path.relative_to(root)}:{line}: \\{kind} redefines "
                f"\\{name}; under the generated annotation contract the "
                "only definition is exactly "
                r"\newcommand{\chronodate}[2]{#2} in "
                f"{owner_name}, so the "
                "checked annotation reaches the reader unchanged"
            )
    if canonical != 1:
        problems.append(
            f"{owner_name} must define exactly one "
            r"\newcommand{\chronodate}[2]{#2}; found "
            f"{canonical} canonical definitions. The Date-cell wrapper is "
            "the checked annotation's carrier and may neither discard nor "
            "replace it."
        )
    return problems


def _braced(text: str, index: int) -> tuple[str, int]:
    """Read the braced argument starting at `text[index]`, nesting included."""
    if index >= len(text) or text[index] != "{":
        raise ValueError("expected a braced argument")
    depth, start = 0, index
    while index < len(text):
        char = text[index]
        if char == "{" and (index == start or text[index - 1] != "\\"):
            depth += 1
        elif char == "}" and text[index - 1] != "\\":
            depth -= 1
            if depth == 0:
                return text[start + 1:index], index + 1
        index += 1
    raise ValueError("unclosed braced argument")


def _macro_calls(text: str, name: str, arity: int) -> list[tuple[list[str], int, int]]:
    """Every `\\name{..}...` in `text`, with its arguments and its extent."""
    found = []
    marker = "\\" + name
    at = text.find(marker)
    while at != -1:
        after = at + len(marker)
        if after < len(text) and (text[after].isalpha() or text[after] == "@"):
            at = text.find(marker, after)
            continue
        index, args = after, []
        try:
            while len(args) < arity:
                while index < len(text) and text[index] in " \t\r\n":
                    index += 1
                arg, index = _braced(text, index)
                args.append(arg)
        except ValueError as exc:
            raise ValueError(
                f"\\{name} at character {at} takes {arity} braced arguments "
                f"and this one does not have them: {exc}"
            ) from None
        found.append((args, at, index))
        at = text.find(marker, index)
    return found


def _arguments_after(
    text: str, index: int, arity: int, description: str
) -> tuple[list[str], int]:
    """Read `arity` braced arguments after a structural command."""
    args = []
    try:
        while len(args) < arity:
            while index < len(text) and text[index] in " \t\r\n":
                index += 1
            arg, index = _braced(text, index)
            args.append(arg)
    except ValueError as exc:
        raise ValueError(
            f"{description} takes {arity} braced argument"
            f"{'s' if arity != 1 else ''} and this one does not have them: "
            f"{exc}"
        ) from None
    return args, index


def _wiring():
    """`scripts/_proper_chronology`, imported only when a check needs it.

    It pulls in the chronology corpus's reader, which wants PyYAML. The other
    other checks read nothing but the tree and must keep working in a checkout
    that has not installed the tool requirements.
    """
    import _proper_chronology  # noqa: PLC0415

    return _proper_chronology


def _leaf_document(leaf: Path, root: Path) -> str:
    """The leaf id, recovered from where the leaf sits under its provider."""
    parts = leaf.relative_to(root / "src").parts
    return "/".join(parts[1:])


def _record_remedy(leaf: Path, root: Path) -> str:
    """The command that writes this leaf's record, for the leaf's own provider.

    `proper-chronology` defaults `--provider` to `claude`, so a remedy that
    omitted it sent every `gpt` leaf's repair at the wrong tree. A remedy a
    reader cannot paste is a refusal with no way out of it.
    """
    parts = leaf.relative_to(root / "src").parts
    return (f"tools/tpt proper-chronology record --provider {parts[0]} "
            f"--document {'/'.join(parts[1:])} --write")


def _annotations_remedy(leaf: Path, root: Path) -> str:
    """The command that writes this leaf's generated date annotations."""
    parts = leaf.relative_to(root / "src").parts
    return (f"tools/tpt proper-chronology annotations --provider {parts[0]} "
            f"--document {'/'.join(parts[1:])} --write")


def _stated_production(leaf: Path) -> tuple[str, int] | None:
    """The workflow and integer version the leaf's provenance states.

    General on purpose: two version-bound contracts read it now, and each
    decides for itself which productions it binds. Filtering here made the
    accessor answer one caller's question and silently gave the other the
    wrong answer for a leaf produced by a workflow it did not name.
    """
    metadata = leaf / "generation-metadata.tex"
    if not metadata.is_file():
        return None
    found = PRODUCTION_RE.findall(active_tex(
        metadata.read_text(encoding="utf-8")))
    if len(found) != 1:
        return None
    recorded = dict(zip(PRODUCTION_FIELDS, (v.strip() for v in found[0])))
    try:
        return recorded["workflow_id"], int(recorded["workflow_version"])
    except ValueError:
        return None


def _chronology_scope(leaf: Path, edition: str = LEAF_EDITION) -> tuple[bool, bool, str]:
    """`(record required, macro discipline required, why)` for this leaf."""
    production = _stated_production(leaf)
    wiring = _wiring()
    carried = (leaf / wiring.RECORD).is_file()
    if three_document_study(leaf):
        from _proper_components import presentation_contract
        data = tomllib.loads((leaf / "proper-components.toml").read_text())
        if presentation_contract(data):
            return True, edition in {LEAF_EDITION, SYNTHESIS_EDITION}, (
                "the concise physical-page contract requires the complete canonical chronology")
        # A carried record remains checked, but adopting the corpus's facts
        # no longer commits a publication to a date table or to printing dates.
        marks = ("\\" + CHRONOLOGY_CLAIM, "\\" + CHRONOLOGY_CELL,
                 "\\" + CHRONOLOGY_ANNOTATION)
        printed = any(mark in active_tex(path.read_text(encoding="utf-8"))
                      for path in reader_facing(leaf)
                      if path.name != "chronology-annotations.tex"
                      for mark in marks)
        return carried or printed, False, (
            "schema 2 permits dates to be omitted; any stated chronology "
            "claim must still be supported by the corpus and carry its record"
        )
    workflow, version = production if production is not None else (None, None)
    threshold = CHRONOLOGY_FROM_VERSION.get(workflow) if workflow else None
    bound = threshold is not None and version is not None and version >= threshold
    if bound:
        why = (f"the leaf states {workflow} v{version}, at or past the version "
               f"the chronology contract binds from")
    elif carried:
        why = f"the leaf carries {wiring.RECORD}"
    else:
        if production is None:
            stated = "no recognized provenance record"
            because = "so it predates the chronology contract, which binds"
        elif workflow not in CHRONOLOGY_FROM_VERSION:
            stated = f"{workflow} v{version}"
            because = ("which is not a production this contract binds; the "
                       "chronology contract binds")
        else:
            stated = f"{workflow} v{version}"
            because = "so it predates the chronology contract, which binds"
        thresholds = " or ".join(
            f"{name} v{minimum}"
            for name, minimum in CHRONOLOGY_FROM_VERSION.items()
        )
        why = (f"the leaf states {stated} and carries no {wiring.RECORD}, "
               f"{because} from {thresholds}")
    required = bound or carried
    return required, required, why


def _annotations_scope(leaf: Path) -> tuple[bool, str]:
    """Whether this leaf must carry and use the generated annotation file."""
    production = _stated_production(leaf)
    wiring = _wiring()
    path = wiring.annotations_path(leaf)
    carried = path.is_file()
    if three_document_study(leaf):
        from _proper_components import presentation_contract
        if presentation_contract(tomllib.loads((leaf / "proper-components.toml").read_text())):
            return True, "the concise physical-page contract requires canonical generated annotations"
        return carried, (
            f"schema 2 requires a current projection only when carried "
            f"in {path.relative_to(leaf)}"
        )
    workflow, version = production if production is not None else (None, None)
    threshold = ANNOTATIONS_FROM_VERSION.get(workflow) if workflow else None
    bound = threshold is not None and version is not None and version >= threshold
    if bound:
        return True, (
            f"the leaf states {workflow} v{version}, at or past the version "
            "the generated annotation contract binds from"
        )
    if carried:
        return True, f"the leaf carries {path.relative_to(leaf)}"
    thresholds = " or ".join(
        f"{name} v{minimum}"
        for name, minimum in ANNOTATIONS_FROM_VERSION.items()
    )
    stated = "no recognized provenance record" if production is None else \
        f"{workflow} v{version}"
    return False, (
        f"the leaf states {stated} and carries no {path.relative_to(leaf)}, "
        f"so it predates the generated annotation contract, which binds from "
        f"{thresholds}"
    )


def _corpus_answer(leaf: Path, root: Path):
    """What the chronology corpus answers about this proper, right now."""
    wiring = _wiring()
    return wiring.dossier(
        _leaf_document(leaf, root),
        root=root,
        corpus_root=root / "src" / "sources" / "chronology",
        provider=leaf.relative_to(root / "src").parts[0],
    )


def check_chronology_record_current(leaf: Path, root: Path,
                                   edition: str = LEAF_EDITION
                                   ) -> tuple[list[str], str]:
    """The carried chronology ids are the corpus's, and are the corpus's now.

    §14 asks a consumer to carry the stable ids — event id, unit id, profile,
    relation — "so prose can be regenerated without re-researching the fact".
    A carried id is only worth carrying if it still names what the corpus
    holds, and a copy of a fact is a prediction that the two will differ, so
    this regenerates the record from the corpus and compares. There is no
    tolerance and no merge: the record is generated, and a leaf whose copy has
    drifted is told to rewrite it rather than to reconcile it.
    """
    wiring = _wiring()
    required, _macros, why = _chronology_scope(leaf)
    path = leaf / wiring.RECORD
    if not required:
        return [], f"not in scope: {why}"
    if not path.is_file():
        return ([
            f"{why}, so the leaf must carry {wiring.RECORD}; write it with "
            f"`{_record_remedy(leaf, root)}`"
        ], "")
    found = _corpus_answer(leaf, root)
    rendered = wiring.render(found)
    if path.read_text(encoding="utf-8") != rendered:
        return ([
            f"{wiring.RECORD} is not what the chronology corpus answers now. "
            f"It is generated, not authored: rewrite it with "
            f"`{_record_remedy(leaf, root)}` and re-read the prose "
            f"that rests on it. Editing it to agree with the guide is the one "
            f"repair this check exists to refuse."
        ], "")
    if found.state != wiring.APPOINTED:
        return [], (
            f"{wiring.RECORD} is current with the corpus and lists no "
            f"element: {found.reason}"
        )
    claims = sum(len(element.claims) for element in found.elements)
    scriptural = [e for e in found.elements if e.loci]
    return [], (
        f"{len(scriptural)} scriptural elements, {claims} corpus assertions "
        f"carried, current with the corpus"
    )


def check_chronology_annotations_current(
    leaf: Path, root: Path, edition: str = LEAF_EDITION
) -> tuple[list[str], str]:
    """The generated reader-facing chronology is complete and current.

    The chronology record is an audit payload, not presentation. The proper
    chronology tool projects that answer into one annotation per appointed
    Scripture, preserving every candidate within its relation and supplying
    the Gospel's distinct composition and narrated-event groups. This check
    compares the generated TeX byte for byte with that live projection. A
    hand-edited or partial annotation file is therefore neither current nor
    complete, and no second implementation of the projection lives here.
    """
    wiring = _wiring()
    required, why = _annotations_scope(leaf)
    path = wiring.annotations_path(leaf)
    problems = _annotation_macro_definitions(leaf, path)
    if not required:
        return problems, f"not in scope: {why}"
    if not three_document_study(leaf) or any(
        "\\" + CHRONOLOGY_CELL in active_tex(edition_text(leaf, prose_path, edition))
        for prose_path in leaf_tex(leaf, edition)
    ):
        problems.extend(_date_cell_wrapper_integrity(leaf, root, edition))
    if not path.is_file():
        problems.append(
            f"{why}, so the leaf must carry {path.relative_to(leaf)}; write "
            f"it with `{_annotations_remedy(leaf, root)}`"
        )
        return problems, ""

    found = _corpus_answer(leaf, root)
    projection = wiring.annotations(found)
    rendered = wiring.render_annotations_tex(projection)
    if path.read_text(encoding="utf-8") != rendered:
        problems.append(
            f"{path.relative_to(leaf)} is not the complete annotation "
            f"projection the chronology corpus produces now. It is generated, "
            f"not authored: rewrite it with "
            f"`{_annotations_remedy(leaf, root)}` rather than editing or "
            f"reconciling it toward the page."
        )
        return problems, ""

    scriptural = [element for element in found.elements if element.loci]
    claims = sum(
        len(group.claims)
        for element in projection.elements
        for group in element.groups
    )
    return problems, (
        f"{path.relative_to(leaf)} carries the complete live projection for "
        f"{len(scriptural)} scriptural elements and {claims} corpus assertions"
    )


def check_chronology_claims_supported(leaf: Path, root: Path,
                                     edition: str = LEAF_EDITION
                                     ) -> tuple[list[str], str]:
    """Every date the guide prints is one the corpus asserts, and it says which.

    Two failures, and only the second needs the macro discipline.

    A `\\chronology{subject}{relation}{label}` naming an assertion the corpus
    does not make is refused wherever it stands, in any leaf, at any version:
    that is a claim about the corpus's contents, and it is either true of them
    or it is the invention §14 forbids.

    A date printed with no claim behind it is refused in any leaf that prints
    a date cell at all, and that is the half which catches recall. A guide
    that quietly writes a year it remembers produces a page indistinguishable
    from a right one, so a `\\chronodate` cell may hold no digit except inside
    a claim. Where the corpus returns `undated-in-tradition` or
    `research-pending` there is no claim to make, so the cell states the
    absence and carries no figure at all — which is exactly what §14 requires
    a consumer to preserve. Writing a cell is how a leaf adopts the
    machinery, so it is what binds this rule; the VERSION binds the separate
    requirement that every appointed Scripture have a cell, because that one
    changes how the whole page is composed.

    A cell that names several elements is held against the INTERSECTION of
    their answers and covers each of them once. Both halves matter and are
    exercised by `BoundLeafTests`: against the union, naming an extra element
    widened what the cell could print AND satisfied the coverage rule, so one
    cell naming the whole formulary carried one year for every appointed text
    — the Gradual's undated psalm included — with nothing left to complain
    about.

    Era-qualified prose is checked separately. Forms such as ``A.D.~70``,
    ``post-A.D. 70`` and quoted date labels outside a Date cell must have the
    same era and explicit years as a claim in the generated default answer or
    a declared profile comparison. This narrow scan does not treat every prose
    number as chronology; verse, volume and page numbers remain outside it.

    A dossier row's explanation may instead date one of its own passages as
    `<citation>: <date>` (`PER_PASSAGE_DATE`). That date is held to the
    record's answer at the verses the label names, never to the formulary at
    large, and in a row whose passages answer differently a date true of only
    some of them is refused unless it carries that label.
    """
    required, macros, why = _chronology_scope(leaf, edition)
    if edition == LEAF_EDITION and three_document_study(leaf) and macros:
        # The v3 page-two inventory belongs to the concise edition. Counting
        # the whole leaf together both rejects a separate research appendix
        # as duplicate cells and lets that appendix hide a missing concise row.
        problems, details = [], []
        for mode in (RESEARCH_EDITION, SYNTHESIS_EDITION, HOMILY_EDITION):
            found, detail = check_chronology_claims_supported(leaf, root, mode)
            problems.extend(f"{mode}: {problem}" for problem in found)
            details.append(f"{mode}: {detail}")
        return problems, "; ".join(details)
    annotation_required, annotation_why = _annotations_scope(leaf)
    printed = {
        path: active_tex(edition_text(leaf, path, edition))
        for path in leaf_tex(leaf, edition)
    }
    # THE CORPUS IS NOT CONSULTED WHEN THERE IS NOTHING TO HOLD AGAINST IT. A
    # leaf that prints no chronology claim and is not yet bound by the macro
    # discipline has nothing for this check to judge, and resolving the
    # formulary's loci to say so would make every synthetic fixture in the
    # tree need a registered calendar identity.
    marks = ("\\" + CHRONOLOGY_CLAIM, "\\" + CHRONOLOGY_CELL,
             "\\" + CHRONOLOGY_ANNOTATION)
    if not required and not macros and not any(
        mark in text for text in printed.values() for mark in marks
    ):
        return [], f"no chronology claim printed ({why})"
    found = _corpus_answer(leaf, root)
    # `claims` is the complete per-locus audit union. Only
    # `publication_claims` is the exact assertion-identity intersection across
    # every locus an element appoints, and therefore safe to print once as the
    # date of that whole element.
    comparisons: dict[str, list] = {}
    for comparison in getattr(found, "profile_comparisons", ()):
        comparisons.setdefault(comparison.element_key, []).extend(
            comparison.claims
        )
    supported: dict[str, set[tuple[str, str, str]]] = {
        element.key: {
            (claim.subject, claim.relation, _normalized_label(claim.label))
            for claim in (*element.publication_claims,
                          *comparisons.get(element.key, ()))
        }
        for element in found.elements
    }
    everywhere = set().union(*supported.values()) if supported else set()
    supported_date_signatures = {
        signature
        for element in found.elements
        for claim in (*element.publication_claims,
                      *comparisons.get(element.key, ()))
        # ``claim.date`` stores sortable endpoints and can look exact even
        # when the source labels the claim approximate. Publication prose is
        # authorized only by the source label or deterministic display, both
        # of which preserve that relation.
        for value in (claim.label, _wiring().concise_display_label(claim))
        if (signature := _date_signature(value)) is not None
    }
    problems: list[str] = []
    cells_for: dict[str, int] = {}
    cells_seen = 0
    claims_seen = 0
    annotations_seen = 0
    passages_seen = 0
    production = _stated_production(leaf)
    manual_prose_bound = bool(getattr(found, "comparison_dependencies", ())) or (
        production is not None
        and production[0] == "proper-study"
        and production[1] >= 6
    )

    def hold(
        args: list[str],
        where: str,
        allowed: set[tuple[str, str, str]],
        reachable: set[tuple[str, str, str]] | None = None,
    ) -> None:
        nonlocal claims_seen
        claims_seen += 1
        subject, relation, label = (arg.strip() for arg in args)
        key = (subject, relation, _normalized_label(label))
        if key in allowed:
            return
        near = sorted(lbl for sub, rel, lbl in allowed if sub == subject
                      and rel == relation)
        if reachable is not None and key in reachable:
            # The laundering shape: the assertion is real and the corpus makes
            # it of SOME of the elements this cell names. One cell prints one
            # date for every element it names, so naming an extra element
            # cannot be what makes the date sayable.
            found_here = (
                "; the corpus asserts that of some but not all of the "
                "elements this cell names, and a cell prints one date for "
                "every element it names. Give the element its own cell, or "
                "name only the elements the assertion is true of")
        elif near:
            found_here = f"; what it holds there is {near}"
        elif key in everywhere:
            # The one near miss worth naming separately: the assertion is
            # real, and it is about another element's verses. Printing it here
            # would make the corpus say something about a passage it says
            # nothing about, which is the harder error to see on the page.
            found_here = (
                "; it asserts that of another element of this formulary, and "
                "not at the verses this element appoints")
        else:
            found_here = "; it holds no such assertion at this proper's loci"
        problems.append(
            f"{where}: the corpus asserts no {relation!r} of {subject!r} "
            f"reading {_normalized_label(label)!r}{found_here}. A date the "
            f"corpus does not assert may not be printed, researched into "
            f"place, or recalled: guidance/scripture-chronology.md section 14."
        )

    for path, text in printed.items():
        name = path.relative_to(leaf)
        try:
            cells = _macro_calls(text, CHRONOLOGY_CELL, 2)
            # Parsed here only so that a malformed claim anywhere in the file
            # is a refusal rather than a claim silently not found: a
            # `\\chronology` missing its third argument would otherwise be
            # invisible to both sweeps below.
            _macro_calls(text, CHRONOLOGY_CLAIM, 3)
            _macro_calls(text, CHRONOLOGY_ANNOTATION, 1)
        except ValueError as exc:
            problems.append(f"{name}: {exc}")
            continue
        for (keys, content), _start, _end in cells:
            cells_seen += 1
            named = [key.strip() for key in keys.split(",") if key.strip()]
            where = f"{name}: date cell for {', '.join(named) or '(no element)'}"
            if not named:
                problems.append(
                    f"{name}: a \\{CHRONOLOGY_CELL} names no element key, so "
                    f"nothing says which appointed text its date belongs to")
            # THE INTERSECTION, NEVER THE UNION. One cell prints one date and
            # a row shared between elements says that date of each of them, so
            # a claim in it must be one the corpus makes at every element the
            # cell names. Held against the union instead, a cell could name an
            # extra element and print THAT element's date beside a passage the
            # corpus says nothing about — and the extra name would satisfy the
            # coverage requirement below at the same time, so one cell naming
            # the whole formulary would carry a single date for all of it and
            # leave nothing uncovered to complain about.
            allowed: set[tuple[str, str, str]] | None = None
            reachable: set[tuple[str, str, str]] = set()
            for key in named:
                element = found.element(key)
                if element is None:
                    problems.append(
                        f"{where}: the formulary appoints no element {key!r}; "
                        f"its elements are "
                        f"{[e.key for e in found.elements]}")
                    continue
                cells_for[key] = cells_for.get(key, 0) + 1
                reachable |= supported[key]
                allowed = (supported[key] if allowed is None
                           else allowed & supported[key])
            if allowed is None:
                allowed = set()
            spans = _macro_calls(content, CHRONOLOGY_CLAIM, 3)
            for args, _at, _stop in spans:
                hold(args, where, allowed, reachable)
            annotations = _macro_calls(content, CHRONOLOGY_ANNOTATION, 1)
            annotations_seen += len(annotations)
            referenced = [args[0].strip() for args, _at, _stop in annotations]
            for key in referenced:
                if key not in supported:
                    problems.append(
                        f"{where}: \\{CHRONOLOGY_ANNOTATION} names {key!r}, "
                        f"which is not an appointed Scripture element; its "
                        f"elements are {sorted(supported)}")
            if annotation_required and sorted(referenced) != sorted(named):
                problems.append(
                    f"{where}: {annotation_why}, so the cell must use exactly "
                    f"one generated \\{CHRONOLOGY_ANNOTATION} for each element "
                    f"it names; cell keys are {named}, annotation keys are "
                    f"{referenced}")
            if annotation_required and spans:
                problems.append(
                    f"{where}: {annotation_why}, so its corpus claims come "
                    f"through \\{CHRONOLOGY_ANNOTATION}, not separately authored "
                    f"\\{CHRONOLOGY_CLAIM} calls")
            if annotations and not annotation_required:
                problems.append(
                    f"{where}: uses \\{CHRONOLOGY_ANNOTATION} but no generated "
                    f"annotation file or binding workflow version supplies it")
            bare = content
            hidden = sorted(
                [*spans, *annotations], key=lambda item: item[1], reverse=True)
            for _args, at, stop in hidden:
                bare = bare[:at] + " " + bare[stop:]
            if annotation_required and bare.strip():
                problems.append(
                    f"{where}: adds authored content around its generated "
                    f"annotation: {' '.join(bare.split())[:80]!r}; the Date "
                    f"cell is the matching \\{CHRONOLOGY_ANNOTATION} call, so "
                    f"the checked projection is what reaches the reader")
            # THE RAW CELL, not `prose(bare)`. `prose()` answers "what works
            # does this text cite", and for that it drops `\texttt`, `\url`
            # and `\href` whole, because a locator is not a citation. It is
            # the wrong lens for "does this cell print a number": `\texttt` is
            # typeset, so `\texttt{1055--1015 BC}` reaches the page as a date
            # and reached this scan as nothing. Only the claim spans are cut,
            # and the scan over-approximates deliberately — a digit anywhere
            # in a Date cell's markup is worth one refusal and one rewrite,
            # and a figure the reader sees is worth much more than that.
            if DIGIT.search(bare):
                problems.append(
                    f"{where}: prints a figure outside a "
                    f"\\{CHRONOLOGY_CLAIM} claim: "
                    f"{' '.join(bare.split())[:80]!r}. A date reaches "
                    f"this cell from the chronology corpus or it does not "
                    f"reach it; a figure with no claim behind it is "
                    f"indistinguishable on the page from one with.")
        # Per-passage dates are judged against the passage their label names
        # and then blanked, so the edition-wide scan below cannot pass a
        # mislabelled one merely because some other element holds its figure.
        if manual_prose_bound:
            passage_problems, text, passed = _per_passage_dates(
                text, cells, found, comparisons, name)
            problems.extend(passage_problems)
            passages_seen += passed
        # A claim standing outside a date cell is still a claim about the
        # corpus's contents, so it is held to the same rule against the whole
        # formulary. The cells are cut out first rather than compared by
        # offset: a claim judged twice would be counted twice and, worse,
        # judged the second time against every element instead of its own.
        loose = text
        for _args, at, stop in reversed(cells):
            loose = loose[:at] + " " + loose[stop:]
        for args, _at, _stop in _macro_calls(loose, CHRONOLOGY_CLAIM, 3):
            hold(args, f"{name}: \\{CHRONOLOGY_CLAIM} outside a date cell",
                 everywhere)
        loose_claims = _macro_calls(loose, CHRONOLOGY_CLAIM, 3)
        loose_annotations = _macro_calls(
            loose, CHRONOLOGY_ANNOTATION, 1
        )
        for args, _at, _stop in loose_annotations:
            problems.append(
                f"{name}: \\{CHRONOLOGY_ANNOTATION} for {args[0].strip()!r} "
                f"stands outside a \\{CHRONOLOGY_CELL}; nothing says which "
                f"appointed text its generated dates belong to")
        prose_only = loose
        for _args, at, stop in sorted(
            [*loose_claims, *loose_annotations],
            key=lambda item: item[1], reverse=True,
        ):
            prose_only = prose_only[:at] + " " + prose_only[stop:]
        for match in (MANUAL_CHRONOLOGY_DATE.finditer(prose_only)
                      if manual_prose_bound else ()):
            printed_date = match.group(0)
            signature = _date_signature(printed_date)
            if signature in supported_date_signatures:
                continue
            line = prose_only.count("\n", 0, match.start()) + 1
            problems.append(
                f"{name}:{line}: manual chronology date "
                f"{_normalized_label(printed_date)!r} is absent from this "
                "proper's generated chronology record. Era-qualified date "
                "prose, including quoted labels and TeX-tied forms, must come "
                "from the default answer or a declared "
                f"{_wiring().COMPARISONS_INPUT} profile comparison."
            )
        # Era-less scanning is meaningful only in explanatory dossier prose.
        # Elsewhere the same shapes are routinely verse, page, and patristic
        # section ranges. The broader era-qualified scan above remains active
        # throughout the edition.
        dossier_prose = "\n".join(
            args[0] for args, _at, _stop in _macro_calls(text, "dossierprose", 1)
        )
        if manual_prose_bound and dossier_prose:
            era_qualified_spans = tuple(
                (match.start(), match.end())
                for match in MANUAL_CHRONOLOGY_DATE.finditer(dossier_prose)
            )
            era_less = []
            for pattern in (QUALIFIED_ERALESS_DATE, BARE_ERALESS_SPAN,
                            BETWEEN_ERALESS_SPAN):
                era_less.extend(pattern.finditer(dossier_prose))
            last_end = -1
            for match in sorted(
                era_less, key=lambda item: (item.start(), -(item.end() - item.start()))
            ):
                if match.start() < last_end:
                    continue
                last_end = match.end()
                # Do not reclassify an era-qualified date or an explicitly
                # named chapter span as an unbound date. Verse ranges are
                # excluded by BARE_ERALESS_SPAN's colon lookbehind.
                before = dossier_prose[max(0, match.start() - 40):match.start()]
                if any(
                    match.start() < stop and match.end() > at
                    for at, stop in era_qualified_spans
                ) or re.search(
                    r"(?i)chapters?\s*~?\s*$", before
                ):
                    continue
                line = dossier_prose.count("\n", 0, match.start()) + 1
                problems.append(
                    f"{name}:{line}: manual chronology date "
                    f"{_normalized_label(match.group(0))!r} omits its era. "
                    "Every manually repeated biblical date must state A.D., "
                    "B.C., or A.M. so it can be matched to the generated "
                    "chronology record; otherwise refer to the generated "
                    "displayed date without repeating its number."
                )

    if macros:
        wanted = [e.key for e in found.elements if e.loci]
        missing = [key for key in wanted if key not in cells_for]
        if missing:
            problems.append(
                f"the scriptural dossier declares no date cell for "
                f"{missing}; every appointed Scripture gets a "
                f"\\{CHRONOLOGY_CELL} stating what the corpus holds for it, "
                f"including the elements it holds nothing for — an element "
                f"with no cell is indistinguishable from one whose date was "
                f"forgotten")
    # EXACTLY ONE CELL EACH, which is the other half of the coverage rule.
    # Two cells for one element are two dates for one passage with nothing
    # saying which is the guide's, and a second cell is also how an element
    # already covered by a shared row gets a date of its own smuggled in.
    doubled = sorted(key for key, count in cells_for.items() if count > 1)
    if doubled and (not three_document_study(leaf) or macros):
        problems.append(
            f"more than one \\{CHRONOLOGY_CELL} names {doubled}; one "
            f"appointed text has one date cell, or the page states two dates "
            f"for it and nothing says which one the guide holds")

    if macros:
        scope = "the macro discipline binds"
    else:
        scope = f"not yet bound by version: {why}"
    if found.state != _wiring().APPOINTED and not (claims_seen or cells_seen):
        # A formulary the calendar does not appoint. Said outright, because
        # "0 claims, every one asserted by the corpus" over an empty dossier
        # is a pass on nothing and reads exactly like a pass on everything.
        return problems, (
            f"no chronology claim or date cell, and none could be supported "
            f"here ({scope}): {found.reason}"
        )
    if not cells_seen:
        # SAY WHAT PASSED. With no cell there is no figure to hold, so this
        # line is about the claims and says only that.
        return problems, (
            f"{claims_seen} chronology claims and no date cell, every claim "
            f"asserted by the corpus ({scope})"
        )
    passages = (
        f"; {passages_seen} per-passage dates, each the record's answer for "
        f"the passage it names" if passages_seen else "")
    return problems, (
        f"{cells_seen} date cells, {annotations_seen} generated annotations, "
        f"and {claims_seen} direct chronology claims, every "
        f"claim asserted by the corpus at the element it is printed for, no "
        f"figure printed outside one ({scope}){passages}"
    )


# --- The two checks over reader-facing prose -------------------------------

# `leaf_tex` reads every .tex file under the leaf, which is right for a
# citation sweep and wrong here: a section the editions do not typeset is not
# reader-facing, and holding it to the house voice would refuse a leaf for
# words no reader can reach. So the two checks below start at the editions
# themselves and follow `\input` from there.
TEX_INPUT = re.compile(r"\\input\{([^{}]*)\}")
NOT_PROSE = ("format.tex", "generation-metadata.tex")


def reader_facing(leaf: Path, edition: str = LEAF_EDITION) -> list[Path]:
    """Every .tex file the named edition typesets, in the order reached.

    Under `leaf`, both editions deliberately: `synthesis.tex` sets a flag and
    inputs `main.tex`, whose `\\ifdefined` branches decide which components
    each edition prints, and a defect in a component only the research edition
    carries is still a defect. Following the graph also settles the case the
    filenames cannot: one published leaf inputs a further section from inside
    its commentary rather than from `main.tex`.

    Under `canonical` or `synthesis`, one entry file and the guards resolved,
    so a branch the other edition takes is followed no further than a reader
    follows it: the `\\input` inside a dropped branch is dropped with it.
    """
    if three_document_study(leaf):
        from _proper_components import include_graph

        provider_root = next(parent for parent in leaf.parents
                             if parent.parent.name == "src")
        paths = set()
        for name in entry_files(leaf, edition):
            entry = leaf / name
            if edition == LEAF_EDITION and not entry.is_file():
                # An early phase may legitimately precede either companion.
                continue
            paths.update(include_graph(entry, leaf, provider_root))
        # The component checker's semantic graph deliberately retains shared
        # engine/template inputs for sealing, recorder reconciliation, and web
        # conversion. Content preflight reads this leaf's reader-facing prose;
        # shared graph members are neither prose owned here nor paths that its
        # diagnostics can express relative to the leaf.
        owner = leaf.resolve()
        return sorted(path for path in paths
                      if path.is_relative_to(owner) and path.name not in NOT_PROSE)
    seen: set[Path] = set()
    order: list[Path] = []
    root = leaf.resolve()
    queue = [leaf / name for name in entry_files(leaf, edition)]
    while queue:
        path = queue.pop(0)
        # A tracked `\input` argument is repository-relative and shared
        # preambles resolve outside the leaf; those are common to every
        # publication and are not this leaf's prose. Anything that leaves the
        # leaf is dropped rather than followed.
        if root not in path.resolve().parents:
            continue
        if path in seen or not path.is_file():
            continue
        seen.add(path)
        if path.name not in NOT_PROSE:
            order.append(path)
        text = edition_text(leaf, path, edition)
        for hit in TEX_INPUT.finditer(text):
            argument = hit.group(1)
            tail = (argument.split(f"{leaf.name}/", 1)[-1]
                    if f"{leaf.name}/" in argument else argument)
            queue.append(leaf / f"{tail}.tex")
    return order


def check_house_voice(leaf: Path, root: Path,
                     edition: str = LEAF_EDITION
                     ) -> tuple[list[str], str]:
    """No reader-facing sentence takes the guide or its apparatus as subject.

    `guidance/editorial.md` gives the test -- a qualifying sentence is
    legitimate when its subject is a source, a text, a witness or a fact, and
    is the defect when its subject is the guide, the reading or an evidence
    class -- and the profile carries it into every reader-facing word of a
    proper guide. One production run's five-lane evaluation spent its whole
    budget on this one habit over three iterations, each pass repairing what
    it had named and the next finding a fresh subset of the same forms.

    The screen is deliberately narrow. `scripts/_house_voice.py` says what it
    does not look at and why; the short version is that a refused leaf costs a
    rewrite and a wrongly refused sentence costs evidence.

    The refusal names the sentence and says what the repair is, and it says
    nothing else. It used to send the work-wide part of a qualification to
    `Appendix: Scope and Qualifications`, "which already carries it": the
    screen never opens the appendix and cannot know that, and it cannot tell a
    claim-local bound from a work-wide one either -- while
    `guidance/editorial.md` keeps "claim-local caveats beside their claims"
    and forbids the appendix absorbing a qualification that changes the truth
    of a particular claim. Advice a screen cannot ground is advice a worker
    acts on anyway.

    What the screen could not read it reports rather than passes over. Six of
    the twelve leaves that carry a manifest write their interpretive section
    with no `\\pfield`, and nothing else marks where the protected exploratory
    notice ends; that section is cut whole, so a leaf can be accepted with
    half its discovery prose unread, and dropping the markup would otherwise
    silence this check and `proposal-fields` together in silence.
    """
    files = reader_facing(leaf, edition)
    if not files:
        return ([f"the {edition} scope typesets no reader-facing .tex file: "
                 f"no entry file of "
                 f"{', '.join(entry_files(leaf, edition))} is there to say what it "
                 f"prints"], "")
    problems = []
    unread = []
    for path in files:
        where = path.relative_to(leaf).as_posix()
        text = edition_text(leaf, path, edition)
        for line, saw, quotation in house_voice(text):
            # Not `!r`: the quotation is the file's own bytes, backslashes and
            # all, so that a worker can search for it. `repr` would double
            # every backslash and hand back a string that is not in the file,
            # which is the defect the quotation was rebuilt to fix. No
            # reader-facing .tex in the corpus contains a `"`.
            problems.append(
                f'{where}:{line}: {saw}: "{quotation}". Rewrite the sentence '
                f"so its subject is a source, a text, a witness or a fact, "
                f"and delete nothing it was about: every difference, "
                f"negative result, bound, denominator, rights basis and "
                f"attribution stands after the repair")
        for line, section in unscreened(text):
            unread.append(f"{where}:{line} marks no \\pfield in "
                          f"{section!r}, so the protected exploratory notice "
                          f"cannot be told from the proposals and no rule "
                          f"ran over that section")
    if not unread:
        return problems, (f"{len(files)} reader-facing files, no sentence "
                          f"taking the guide, its apparatus or the repository "
                          f"as its subject")
    # The summary is printed on a pass and the problems on a refusal, so a
    # scope statement carried only by the summary is invisible on exactly the
    # leaves a reviser is reading. Said in both places, and never on its own:
    # this is a statement of what was not read, not a defect, so it is added
    # to a refusal that already exists and never makes one.
    if problems:
        problems.append(f"not screened: {'; '.join(unread)}. Nothing in "
                        f"that section was read by this check; it still has "
                        f"to be read by hand")
    return problems, (f"{len(files)} reader-facing files, no sentence taking "
                      f"the guide, its apparatus or the repository as its "
                      f"subject; not screened: {'; '.join(unread)}")


INTERPRETIVE = "The Propers: Interpretive Possibilities"
# Starred or numbered, as `REFERENCES` is: `claude/48-eighth-after-pentecost`
# numbers this heading too, and a starred-only pattern reported its six marked
# proposals out of scope as though the leaf declared none.
INTERPRETIVE_SECTION = re.compile(
    r"\\section\*?\{" + re.escape(INTERPRETIVE) + r"\}")
PROPOSAL_OPEN = re.compile(r"\\begin\{proposal\}[ \t\n]*")
PROPOSAL_CLOSE = "\\end{proposal}"
PROPOSAL_FIELD = re.compile(r"\\pfield\{([^{}]*)\}")
LINE_COMMENT = re.compile(r"(?<!\\)%[^\n]*")
# The five checkable parts `guidance/liturgy/roman-1962-propers.md` requires of
# every proposal: its anchors and four further fields. Each is written under a
# heading. The headings are matched by
# role and not by string: the published leaves head the fourth field `What the
# ordinary reading misses`, `What the ordinary element-by-element reading
# misses` and `What the element-by-element reading misses`, and the fifth
# `Strongest limit`, `Controlling limit` and `Limit`. All of those are the
# field; a heading of the author's own devising is not, which is exactly how
# one proposal came to carry no fourth field at all through four sweeps that
# each read the section.
#
# The first three are matched as words rather than as whole strings, because
# `Anchors in the appointed elements` and `The connecting mechanism` are the
# field under a fuller name and refusing them would be enforcing a string. The
# fifth carries the profile's own alternatives -- "the strongest material
# limit, alternative, or disconfirming condition" -- so that a proposal
# heading its field `Disconfirming condition` states the field the profile
# fixes; `scripts/_house_voice.LIMIT_FIELD` reads the same three words, or the
# house-voice screen would refuse the very field this one requires.
PROPOSAL_FIELDS = (
    ("the appointed elements it joins", re.compile(r"\banchors?\b", re.I)),
    ("the connecting mechanism", re.compile(r"\bmechanisms?\b", re.I)),
    ("the fruit", re.compile(r"\bfruits?\b", re.I)),
    ("what the ordinary element-by-element reading misses",
     re.compile(r"\bmisses\b", re.I)),
    ("the strongest material limit, alternative or disconfirming condition",
     re.compile(r"\b(?:limits?|alternatives?|disconfirming)\b", re.I)),
)


def _proposals(text: str) -> tuple[list[tuple[str, str]], list[int]]:
    """Every `proposal` block, with the ones that could not be read named.

    The title is read as a balanced brace group rather than as `[^{}]*`. Five
    of the published proposals title themselves with a macro -- `The Gospel's
    last clause and the Secret's \\latin{quóties} share one grammar` -- and a
    pattern that cannot match a brace inside the title did not see the
    proposal at all: one leaf carrying five proposals was reported as "4
    exploratory proposals, every one stating the five required parts", which is the
    thing this function's own docstring forbids, said by the check that
    forbids it.
    """
    blocks: list[tuple[str, str]] = []
    unreadable: list[int] = []
    opens = [hit.start() for hit in PROPOSAL_OPEN.finditer(text)]
    for index, hit in enumerate(PROPOSAL_OPEN.finditer(text)):
        try:
            title, after = _braced(text, hit.end())
        except ValueError:
            unreadable.append(hit.start())
            continue
        end = text.find(PROPOSAL_CLOSE, after)
        # Bounded by the next `\begin{proposal}`, so that one block missing
        # its `\end` swallows the block after it rather than reporting that
        # block's fields under this block's title.
        following = opens[index + 1] if index + 1 < len(opens) else len(text)
        if end == -1 or end > following:
            unreadable.append(hit.start())
            continue
        blocks.append((" ".join(title.split()), text[after:end]))
    return blocks, unreadable


def check_proposal_fields(leaf: Path, root: Path,
                         edition: str = LEAF_EDITION
                         ) -> tuple[list[str], str]:
    """Every exploratory proposal carries its anchors and four required fields.

    The profile: each proposal "must join at least two precisely named
    appointed elements; state the connecting mechanism and the theological,
    intellectual, spiritual, or pastoral fruit; identify what the ordinary
    element-by-element reading misses; and end with the strongest material
    limit, alternative, or disconfirming condition."

    A missing field is invisible to a reader of one proposal and to an
    evaluation lane reading for argument: a substituted heading looks like a
    field, and the section still reads as complete. In the run this check was
    written for, one proposal of six replaced the fourth field with a heading
    of the author's own, four separate AI sweeps read the section, and none of
    them reported it -- it fell between two lanes' criteria and no lane owned
    it.
    """
    if three_document_study(leaf):
        return [], ("not in scope: schema 2 uses whole-proper interpretive "
                    "lanes, not the legacy exploratory-proposal template")
    section = None
    for path in reader_facing(leaf, edition):
        text = LINE_COMMENT.sub(
            "", edition_text(leaf, path, edition))
        found = INTERPRETIVE_SECTION.search(text)
        if found:
            # The comment stripper deletes a comment's characters and not its
            # newline, so a line number here is still the line the editor
            # shows; the section's own offset keeps it a line in the FILE and
            # not a line in the section.
            section = (path, text, found.end())
            break
    if section is None:
        return [], (f"not in scope: the leaf typesets no "
                    f"\\section{{{INTERPRETIVE}}}, starred or numbered, so it "
                    f"declares no exploratory proposal to hold fields against")
    path, whole, offset = section
    text = whole[offset:]
    where = path.relative_to(leaf).as_posix()
    proposals, unreadable = _proposals(text)
    if unreadable:
        # An error, and not a skip. A proposal the parser walks past is a
        # proposal reported as read: the count in the summary line below is
        # the number it managed to parse, and it says of every one of them
        # that it states the five required parts.
        return ([f"{where}:{whole.count(chr(10), 0, offset + at) + 1}: this "
                 f"\\begin{{proposal}} cannot be read: its title is not a "
                 f"closed brace group, or no \\end{{proposal}} closes it "
                 f"before the next one opens. What a check cannot read it "
                 f"must not report as read, and the summary line would have "
                 f"counted this proposal as stating all five required parts"
                 for at in unreadable], "")
    if not proposals:
        # Said outright rather than passed in silence. Four published leaves
        # write their proposals as running prose with no field markup at all,
        # and the profile does not require the markup; what a check cannot
        # read it must not report as read.
        return [], (f"not in scope: {where} marks no proposal with "
                    f"\\begin{{proposal}}, so no proposal's fields can be "
                    f"read from the source")
    problems = []
    for title, body in proposals:
        headings = [" ".join(name.split())
                    for name in PROPOSAL_FIELD.findall(body)]
        for role, heading in PROPOSAL_FIELDS:
            if any(heading.search(one) for one in headings):
                continue
            problems.append(
                f"{where}: the proposal {title!r} states no field for {role}; "
                f"it carries {headings}. The profile fixes five things every "
                f"proposal states, and a heading of the author's own devising "
                f"is not one of them: a substituted field reads on the page "
                f"exactly like the field it replaced")
    return problems, (f"{len(proposals)} exploratory proposals, every one "
                      f"stating its anchors and the four fields the profile fixes")
# --- Reader-facing structural meta-labels ---------------------------------
#
# A thesis is substantive and may open a section directly. The editorial
# standard separately forbids a small class of labels that tell the reader
# how the argument has been packaged instead of giving the argument. That is
# a categorical structural rule: one label is enough. It is not the broader,
# judgment-dependent question whether process narration has become a
# recurring prose habit, and this check does not pretend to answer that one.
#
# The contract is version-bound for the same reason the chronology contract
# is. Published leaves completed before the rule existed remain valid until a
# substantive revision binds them to the new workflow. In a live gate,
# `provenance-matches-run` holds this version claim against the run itself, so
# understating it cannot turn the rule off. Both production entry points are
# named because `proper-finish` begins at the same author and retains the same
# preflight gate.
STRUCTURAL_FROM_VERSION = {
    "proper": 24,
    "proper-finish": 2,
    "proper-study": 1,
}
FORBIDDEN_STRUCTURAL_LABELS = frozenset({
    "argument map",
    "governing thesis",
    "key takeaway",
    "reading order",
    "thesis",
})
HEADING = re.compile(
    r"\\(?P<name>chapter|section|subsection|subsubsection|paragraph|"
    r"subparagraph)\*?(?![A-Za-z@])"
)
BASE_TITLED_BOXES = frozenset({
    "massbox",
    "namedtranslation",
    "sourcecard",
    "studybox",
})
STANDARD_TABLES = frozenset({"longtable", "tabular", "tabularx", "tabulary"})
STANDARD_TABLE_ARITY = {
    "longtable": 1,
    "tabular": 1,
    "tabular*": 2,
    "tabularx": 2,
    "tabulary": 2,
}
CUSTOM_TABLE_ARITY = {"fourstable": 4, "threestable": 3}
RUN_IN_STYLE = ("emph", "textbf", "textit", "textsc")
RUN_IN_LEAD = re.compile(
    r"[ \t]*(?:\\(?:noindent|item|small|footnotesize|scriptsize)"
    r"(?:\[[^\]]*\])?[ \t]*)*\Z"
)
PLAIN_RUN_IN = re.compile(
    r"(?im)^(?:[ \t]*\\(?:noindent|item)(?:\[[^\]]*\])?[ \t]*)*"
    r"(?P<label>governing[ ~\t]+thesis|thesis|key[ ~\t]+takeaway|"
    r"argument[ ~\t]+map|reading[ ~\t]+order)[ \t]*"
    r"(?P<separator>:|\.|--|[\u2013\u2014])(?=[ \t]+\S)"
)
TABLE_BLOCK = re.compile(
    r"\\begin\{(?P<environment>longtable|tabularx|tabulary|tabular\*?)\}"
    r"(?P<body>.*?)"
    r"\\end\{(?P=environment)\}",
    re.S,
)
ROW_END = re.compile(r"(?<!\\)\\\\(?!\\)")


def _structural_label(text: str) -> str | None:
    """Return the canonical forbidden label, but only for an exact label."""
    visible = COMMAND.sub(" ", text).replace("{", " ").replace("}", " ")
    visible = " ".join(visible.replace("~", " ").split())
    visible = visible.strip(" \t\r\n:.;\u2013\u2014-")
    normalized = fold(visible)
    return normalized if normalized in FORBIDDEN_STRUCTURAL_LABELS else None


def _heading_calls(text: str) -> list[tuple[str, str, int]]:
    """Every sectioning argument, accepting starred and short-title forms."""
    found = []
    for match in HEADING.finditer(text):
        index = match.end()
        while index < len(text) and text[index] in " \t\r\n":
            index += 1
        # An optional short title is structural too. Its bracket grammar is
        # intentionally narrow and fail-closed: nested optional-title brackets
        # are not a form the proper sources use.
        if index < len(text) and text[index] == "[":
            stop = text.find("]", index + 1)
            if stop == -1:
                raise ValueError(
                    f"\\{match.group('name')} at character {match.start()} "
                    "has an unclosed optional title"
                )
            short = text[index + 1:stop]
            found.append(("heading short title", short, match.start()))
            index = stop + 1
        (title,), _stop = _arguments_after(
            text, index, 1,
            f"\\{match.group('name')} at character {match.start()}",
        )
        found.append(("heading", title, match.start()))
    return found


def _titled_box_names(leaf: Path,
                      edition: str = LEAF_EDITION) -> set[str]:
    """Known title-bearing boxes plus direct leaf-local wrappers around them."""
    names = set(BASE_TITLED_BOXES)
    format_tex = leaf / "format.tex"
    if not format_tex.is_file():
        return names
    source = active_tex(edition_text(leaf, format_tex, edition))
    # Resolve one wrapper layer at a time so an alias of an alias remains a
    # title-bearing box. Requiring the forwarding `#1` keeps this from treating
    # an arbitrary environment argument as a displayed title.
    while True:
        bases = "|".join(re.escape(name) for name in sorted(names))
        wrapper = re.compile(
            r"\\newenvironment\{([A-Za-z@]+)\}(?:\[\d+\])?"
            r"\{[^\n]*?\\begin\{(?:" + bases + r")\}\{#1\}"
        )
        added = set(wrapper.findall(source)) - names
        if not added:
            return names
        names.update(added)


def _begin_calls(text: str) -> list[tuple[str, int, int]]:
    """Every environment opening, failing rather than skipping malformed TeX."""
    return [(args[0].strip(), start, stop)
            for args, start, stop in _macro_calls(text, "begin", 1)]


def _box_and_custom_table_calls(
    text: str, titled_boxes: set[str]
) -> list[tuple[str, str, int]]:
    """Title arguments of known boxes and heading arguments of house tables."""
    found = []
    for environment, start, stop in _begin_calls(text):
        if environment in titled_boxes:
            (title,), _end = _arguments_after(
                text, stop, 1,
                f"{environment} box at character {start}",
            )
            found.append((f"{environment} box title", title, start))
        if environment in CUSTOM_TABLE_ARITY:
            headings, _end = _arguments_after(
                text, stop, CUSTOM_TABLE_ARITY[environment],
                f"{environment} table at character {start}",
            )
            found.extend(
                (f"{environment} table heading", heading, start)
                for heading in headings
            )
    return found


def _table_blocks(text: str) -> list[tuple[str, str, int, int, int]]:
    """Standard table bodies and their source extents, refusing open tables."""
    found = [
        (match.group("environment"), match.group("body"), match.start(),
         match.start("body"), match.end())
        for match in TABLE_BLOCK.finditer(text)
    ]
    starts = [
        (environment, start)
        for environment, start, _stop in _begin_calls(text)
        if environment.rstrip("*") in STANDARD_TABLES
    ]
    if len(starts) != len(found):
        covered = [(start, stop)
                   for _env, _body, start, _body_start, stop in found]
        unclosed = [
            (environment, start) for environment, start in starts
            if not any(begin <= start < end for begin, end in covered)
        ]
        if unclosed:
            environment, start = unclosed[0]
            raise ValueError(
                f"{environment} table at character {start} has no matching "
                "\\end"
            )
    return found


def _table_heading_calls(
    text: str,
) -> tuple[list[tuple[str, str, int]], list[tuple[int, int]]]:
    """Cells in the header region of ordinary TeX tables, never body prose."""
    found = []
    ranges = []
    for environment, body, start, body_start, stop in _table_blocks(text):
        ranges.append((start, stop))
        index = 0
        while index < len(body) and body[index] in " \t\r\n":
            index += 1
        if index < len(body) and body[index] == "[":
            option_end = body.find("]", index + 1)
            if option_end == -1:
                raise ValueError(
                    f"{environment} table at character {start} has an "
                    "unclosed position option"
                )
            index = option_end + 1
        _args, content_at = _arguments_after(
            body, index, STANDARD_TABLE_ARITY[environment],
            f"{environment} table at character {start}",
        )
        content = body[content_at:]
        if "\\toprule" in content:
            header_at = content_at + content.index("\\toprule") \
                + len("\\toprule")
            header = body[header_at:]
            if "\\midrule" in header:
                header = header[:header.index("\\midrule")]
        else:
            # A table without booktabs still has a first row. Restrict the
            # scan to that row rather than searching the whole table.
            header_at = content_at
            row_end = ROW_END.search(content)
            header = content[:row_end.start()] if row_end else content
        for cell in re.split(r"(?<!\\)&", header):
            candidates = [cell]
            for args, _at, _end in _macro_calls(cell, "multicolumn", 3):
                candidates.append(args[2])
            for args, _at, _end in _macro_calls(cell, "multirow", 3):
                candidates.append(args[2])
            for candidate in candidates:
                found.append((f"{environment} table heading", candidate,
                              body_start + header_at))
    return found, ranges


def _run_in_calls(
    text: str, table_ranges: list[tuple[int, int]]
) -> list[tuple[str, str, int]]:
    """Styled or punctuated labels at a source-line opening, not word hits."""
    found = []
    for style in RUN_IN_STYLE:
        for (argument,), start, _stop in _macro_calls(text, style, 1):
            if any(begin <= start < end for begin, end in table_ranges):
                continue
            line_start = text.rfind("\n", 0, start) + 1
            if RUN_IN_LEAD.fullmatch(text[line_start:start]):
                found.append(("run-in label", argument, start))
    for match in PLAIN_RUN_IN.finditer(text):
        if any(begin <= match.start() < end for begin, end in table_ranges):
            continue
        found.append(("run-in label", match.group("label"), match.start()))
    return found


def _structural_scope(leaf: Path) -> tuple[bool, str]:
    """Whether this leaf states a production contract carrying the rule."""
    if three_document_study(leaf):
        return True, "the leaf adopts schema 2"
    production = _stated_production(leaf)
    if production is None:
        return False, (
            "the leaf does not state proper v24 or later or proper-finish v2 "
            "or later"
        )
    workflow, version = production
    required = STRUCTURAL_FROM_VERSION.get(workflow)
    if required is None or version < required:
        return False, (
            "the leaf does not state proper v24 or later or proper-finish v2 "
            "or later"
        )
    return True, f"the leaf states {workflow} v{version}"


def check_structural_meta_labels(
    leaf: Path, root: Path, edition: str = LEAF_EDITION
) -> tuple[list[str], str]:
    """No rhetorical wrapper occupies a reader-facing structural surface.

    This is deliberately not a word search. The same words may occur in
    ordinary prose, a citation, or a discussion of somebody else's thesis.
    Only sectioning arguments, known box titles, paragraph-opening run-ins,
    and table header cells are inspected, and only an exact normalized label
    is mechanically refused. Equivalents remain part of the author and
    profile evaluator's semantic audit.
    """
    bound, why = _structural_scope(leaf)
    if not bound:
        return [], f"not in scope: {why}"

    problems = []
    surfaces = 0
    titled_boxes = _titled_box_names(leaf, edition)
    for path in leaf_tex(leaf, edition):
        text = active_tex(edition_text(leaf, path, edition))
        relative = path.relative_to(leaf)
        try:
            table_calls, table_ranges = _table_heading_calls(text)
            calls = (
                _heading_calls(text)
                + _box_and_custom_table_calls(text, titled_boxes)
                + table_calls
                + _run_in_calls(text, table_ranges)
            )
        except ValueError as exc:
            problems.append(
                f"{relative}: could not parse a structural surface: {exc}"
            )
            continue
        surfaces += len(calls)
        seen = set()
        for kind, value, start in calls:
            label = _structural_label(value)
            if label is None:
                continue
            line = text.count("\n", 0, start) + 1
            key = (kind, line, label)
            if key in seen:
                continue
            seen.add(key)
            problems.append(
                f"{relative}:{line}: forbidden reader-facing structural "
                f"meta-label {label!r} in {kind}; open with the thesis, "
                "argument, or sequence itself, without an editorial wrapper"
            )
    return problems, (
        f"{surfaces} headings, box titles, run-in labels, and table headings "
        f"inspected, with no forbidden structural meta-label ({why})"
    )


# Every check takes `(leaf, root, edition)` whether or not the edition changes
# what it reads, so that `main` dispatches one way and a check cannot be added
# that quietly ignores the flag it was handed. Six of the twelve do narrow --
# they read the leaf's prose through `leaf_tex` or `reader_facing` -- and the
# rest read one record for the whole leaf, where an edition is not a thing a
# TOML file has. `synthesis-preflight` runs only the narrowing ones, for the
# reason its own required_result lines give.
CHECKS = {
    "bindings-valid": check_bindings_valid,
    "chronology-annotations-current": check_chronology_annotations_current,
    "chronology-claims-supported": check_chronology_claims_supported,
    "chronology-record-current": check_chronology_record_current,
    "house-voice": check_house_voice,
    "identifiers-resolve": check_identifiers_resolve,
    "proposal-fields": check_proposal_fields,
    "references-used": check_references_used,
    "relation-coverage": check_relation_coverage,
    "restricted-not-reproduced": check_restricted_not_reproduced,
    "structural-meta-labels": check_structural_meta_labels,
    "unquoted-not-quoted": check_unquoted_not_quoted,
}

# A check the tree cannot answer on its own. Everything in CHECKS reads only
# the repository, so the whole preflight can be run over a published leaf years
# later; this one asks what run is driving the stage right now, which nothing
# in the tree knows. It is named by `--check` and never swept up by a run over
# all of them, because there is no run to compare a bare invocation against.
RUN_CHECKS = {
    RUN_CHECK: check_provenance_matches_run,
}

ALL_CHECKS = sorted({**CHECKS, **RUN_CHECKS})


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="check-content-preflight",
        description=__doc__,
    )
    parser.add_argument("--root", default=str(DEFAULT_ROOT),
                        help="repository root (default: this checkout)")
    parser.add_argument("--provider", default="gpt",
                        help="provider directory under src/ (default: gpt)")
    parser.add_argument("--document",
                        help="leaf id under the provider root")
    parser.add_argument("--edition", choices=EDITION_CHOICES,
                        default=LEAF_EDITION,
                        help="which edition's bytes to read: `leaf` (the "
                             "default) reads every file under the leaf with "
                             "no branch resolved, which is what a sweep over "
                             "records wants and what every gate command has "
                             "always run; `research` (or legacy `canonical`), "
                             "`synthesis`, and `homily` read "
                             "one document, following that edition's own "
                             "entry file and resolving "
                             "\\ifdefined\\TriptychSynthesisEdition for it")
    parser.add_argument("--check", choices=ALL_CHECKS,
                        help=f"run one check instead of all of them; "
                             f"{RUN_CHECK} is only ever run this way, so a "
                             f"sweep with no --check does not run it and "
                             f"passes a leaf that understates its workflow "
                             f"version")
    parser.add_argument("--list", action="store_true",
                        help="print every check id, one a line")
    parser.add_argument("--run-workflow",
                        help=f"[{RUN_CHECK}] the workflow id of the run "
                             f"producing this leaf")
    parser.add_argument("--run-workflow-version",
                        help=f"[{RUN_CHECK}] its workflow version")
    parser.add_argument("--run-workflow-digest",
                        help=f"[{RUN_CHECK}] its bound workflow source digest")
    parser.add_argument("--run-id",
                        help=f"[{RUN_CHECK}] its run id")
    parser.add_argument("--run-seed-commit",
                        help=f"[{RUN_CHECK}] the commit it was seeded at")
    with_examples(parser, EXAMPLES[""])
    args = parser.parse_args()

    if args.list:
        for name in ALL_CHECKS:
            print(name)
        return 0
    if not args.document:
        print(f"{ERROR}give --document ID, or --list", file=sys.stderr)
        return 1

    root = Path(args.root).resolve()
    try:
        leaf = leaf_dir(root, args.provider, args.document)
    except ValueError as exc:
        print(f"{ERROR}{exc}", file=sys.stderr)
        return 1

    run = {
        "workflow_id": args.run_workflow,
        "workflow_version": args.run_workflow_version,
        "workflow_digest": args.run_workflow_digest,
        "run_id": args.run_id,
        "seed_commit": args.run_seed_commit,
    }

    selected = [args.check] if args.check else sorted(CHECKS)
    failed = False
    for name in selected:
        # The edition is named in the output because a log of a gate run has to
        # say which document was refused: the same check id over the canonical
        # edition and over the companion are two different measurements, and a
        # line that read the same for both would make the run's own record
        # ambiguous about which reviser owes the repair.
        label = (name if args.edition == LEAF_EDITION
                 else f"{name} ({args.edition} edition)")
        try:
            problems, summary = (
                RUN_CHECKS[name](leaf, root, run, args.edition)
                if name in RUN_CHECKS
                else CHECKS[name](leaf, root, args.edition)
            )
        # ImportError belongs here: the two chronology checks import the
        # corpus reader, which wants PyYAML, and a checkout that has not
        # installed the tool requirements should be told which check could not
        # run rather than handed a traceback.
        except (ImportError, OSError, ValueError,
                tomllib.TOMLDecodeError) as exc:
            print(f"{ERROR}{label}: {exc}", file=sys.stderr)
            failed = True
            continue
        if problems:
            failed = True
            for problem in problems:
                print(f"{ERROR}{label}: {problem}", file=sys.stderr)
        else:
            print(f"{label}: {summary}")
    return 1 if failed else 0


if __name__ == "__main__":
    raise SystemExit(main())
