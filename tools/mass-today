def untranslated_reason(proper: dict) -> object:
    """Project only public, text-free absence semantics from a ledger row."""
    recorded = proper.get("untranslated")
    if not recorded:
        return "no-requested-language-text"
    rows = [recorded] if isinstance(recorded, dict) else recorded
    if isinstance(rows, list):
        safe = []
        for one in rows:
            if not isinstance(one, dict):
                continue
            state = str(one.get("state") or "unavailable")
            row = {
                "state": "ledgered-untranslated",
                "lang": one.get("lang"),
                "unavailableState": state,
            }
            safe.append(row)
        return {"state": "ledgered-untranslated", "records": safe}
    return "ledgered-untranslated"


def untranslated_notes(proper: dict) -> list[str]:
    """Concise absence notes; never stringify the retained typed records."""
    recorded = proper.get("untranslated")
    if not recorded:
        return []
    if not isinstance(recorded, list):
        return [f"untranslated: {recorded}" if recorded is not True else "untranslated"]
    notes = []
    for row in recorded:
        if not isinstance(row, dict):
            continue
        lang = str(row.get("lang") or "requested language")
        target = row.get("target") if isinstance(row.get("target"), dict) else row
        cycle_value = target.get("cycle")
        cycle = (
            f", cycle {cycle_value}"
            if cycle_value not in (None, "", "all")
            else ""
        )
        kind = str(row.get("state") or "unavailable")
        kind = kind.replace("-", " ")
        notes.append(f"{lang} unavailable{cycle}: {kind}")
    return notes


def availability_reason_has_state(value: object, state: str) -> bool:
    """Whether a public language-selection reason contains ``state``."""
    if isinstance(value, dict):
        if value.get("state") == state or value.get("unavailableState") == state:
            return True
        return any(availability_reason_has_state(one, state) for one in value.values())
    if isinstance(value, list):
        return any(availability_reason_has_state(one, state) for one in value)
    return False


def latin_availability_note(proper: dict, lang: str) -> str | None:
    """The complete public message when no selectable body can be shown."""
    latin = proper.get("latin")
    status = proper.get("text_status")
    body_unavailable = (
        isinstance(status, dict)
        and status.get("state") == "unavailable"
        and status.get("scope") == "proper-body"
    )
    latin_unavailable = (
        isinstance(latin, dict) and bool(latin.get("withheld"))
    ) or body_unavailable
    if lang == "la" and latin_unavailable:
        return "Latin text unavailable"
    selection = proper.get("language_selection")
    if (
        lang != "la"
        and latin_unavailable
        and isinstance(selection, dict)
        and not selection.get("held")
    ):
        language = {"en": "English"}.get(lang, lang)
        if availability_reason_has_state(
            selection.get("reason"), "rights-restricted"
        ):
            return (
                f"{language} translation unavailable: rights restricted; "
                "Latin text unavailable"
            )
        return f"No {language} or Latin body is held here."
    return None


def select_untranslated_records(proper: dict, cycle: str | None) -> None:
    """Keep only whole-slot or actually selected-cycle absence records."""
    records = proper.get("untranslated")
    if not isinstance(records, list):
        return
    selected = [
        dict(row)
        for row in records
        if isinstance(row, dict)
        and (
            (
                row.get("target", {}).get("cycle")
                if isinstance(row.get("target"), dict)
                else row.get("cycle")
            ) in (None, "", "all")
            or (
                cycle is not None
                and (
                    row.get("target", {}).get("cycle")
                    if isinstance(row.get("target"), dict)
                    else row.get("cycle")
                ) == cycle
            )
        )
    ]
    if selected:
        proper["untranslated"] = selected
    else:
        proper.pop("untranslated", None)


