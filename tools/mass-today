class Refused(RuntimeError):
    """A sibling tool exited non-zero, or returned something unreadable."""


class _SourceMass(dict):
    """Keep the original Day tuple privately while projecting a public Mass."""


class _ProperAppointmentContext(dict):
    """Keep Bible projection inputs out of the shared admission payload."""


def invoke(tool: str, argv: list[str]) -> dict:
    """Run a sibling tool and read its JSON back.

    The tools are composed as commands rather than imported so that anything
    this prints can be reproduced by running the same commands by hand.
    """
    command = [sys.executable, str(TOOLS / tool), *argv, "--json"]
    done = subprocess.run(command, capture_output=True, text=True)
    if done.returncode != 0:
        detail = (done.stderr or done.stdout or "").strip().splitlines()
        raise Refused(
            f"{tool} {' '.join(argv)} exited {done.returncode}: "
            f"{detail[-1] if detail else ''}"
        )
    try:
        return json.loads(done.stdout)
    except json.JSONDecodeError as error:
        raise Refused(f"{tool} did not return JSON: {error}") from error


def invoke_propers(
    calendar: str, keys: list[str], arguments: argparse.Namespace
) -> dict[str, dict]:
    """Resolve several formularies under one complete source validation.

    The repeated ``--mass`` form is an optimization only.  If the batch cannot
    be trusted, callers fall back to the existing per-mass invocation so one
    bad formulary retains its local refusal instead of hiding the others.
    """
    unique = list(dict.fromkeys(keys))
    if len(unique) < 2:
        return {}
    argv = ["show", "--calendar", calendar]
    for key in unique:
        argv += ["--mass", key]
    for flag in ("bible", "lang", "witness"):
        value = getattr(arguments, flag, None)
        if value:
            argv += [f"--{flag}", str(value)]
    try:
        batched = invoke("mass-propers", argv)
    except Refused:
        return {}
    payloads = batched.get("masses")
    if (
        not isinstance(payloads, list)
        or len(payloads) != len(unique)
        or any(not isinstance(payload, dict) for payload in payloads)
    ):
        return {}
    return dict(zip(unique, payloads))


def is_placeholder(proper: dict) -> bool:
    # Historical exceptional-rite records predate the standard placeholder
    # sentence, but identify themselves with the exact structural name.  They
    # are repository status records, not liturgical words, and must never be
    # poured into the Ordinary merely because their explanatory prose differs
    # from the newer stock sentence.
    return (
        str(proper.get("text") or "").lstrip().startswith(PLACEHOLDER)
        or str(proper.get("name") or "").strip().casefold() == "placeholder"
    )


def indexed_bibles() -> list[dict]:
    """What the Bible index builder has actually indexed, from its manifest."""
    if not BIBLES.is_file():
        return []
    try:
        return [
            one
            for one in (json.loads(BIBLES.read_text(encoding="utf-8")).get("bibles") or [])
            if isinstance(one, dict)
        ]
    except json.JSONDecodeError:
        return []


def default_bible(lang: str) -> dict | None:
    """The bible the expanded mode reads scripture from when none was named.

    Expanded means the words, so a reader must not have to remember a `--bible`
    to see them. The default is not written down here: it is the first indexed
    bible of the language asked for, in the order the manifest lists them, and
    whichever one that turns out to be is PRINTED with the Mass. A defaulted
    edition nobody is told about is an unattributed text, which is the one
    thing a scripture citation may never be.
    """
    for one in indexed_bibles():
        if str(one.get("language")) == lang:
            return one
    return None


def indexed_bible(identifier: str | None) -> dict | None:
    """The manifest row for a named Bible, without guessing from its id."""
    if not identifier:
        return None
    for one in indexed_bibles():
        if str(one.get("id")) == identifier:
            return one
    return None


