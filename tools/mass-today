WIDTH = 88

# The text every placeholder entry carries; matched on its opening rather than
# in full so that a reworded placeholder is still recognised as one.
PLACEHOLDER = "This entry is a placeholder"

PRECEDENCE = (
    "no precedence is stated: this calendar lists every candidate for the "
    "date and does not choose among them"
)

# What each formulary's standing is called in a terminal. The words matter as
# much here as on the page: a reader must not be able to read a displaced Mass
# as the day's, and in a terminal there is no colour or grouping to help — only
# this line. `said` is deliberately unmarked, because the thing that is said is
# the thing a reader asked for.
STANDING_WORDS = {
    "said": "",
    "option": "the rubrics permit this or the Mass above",
    "additional": "also said today, at another hour; it competes for the day with nothing",
    "commemorated": "NOT said today; its collect is said within the Mass above",
    "displaced": "NOT said today; displaced by the Mass above",
    "unresolved": "a candidate; this date is not settled here",
}

