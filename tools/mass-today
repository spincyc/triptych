def validated_text_status(value: object) -> dict | None:
    """The closed text-free availability shape exposed by mass-propers."""
    if value is None:
        return None
    if not isinstance(value, dict):
        raise Refused("mass-propers returned non-mapping text_status")
    status = dict(value)
    if status.get("state") == "unavailable":
        scope = status.get("scope")
        if scope not in TEXT_STATUS_SCOPES:
            held = ", ".join(TEXT_STATUS_SCOPES)
            raise Refused(
                f"mass-propers returned unsupported text_status.scope {scope!r}; "
                f"expected one of {held}"
            )
    return status


def public_common_from(value: object) -> dict | None:
    """Keep a Common direction while dropping its source-study locator."""
    if value is None:
        return None
    if not isinstance(value, dict):
        raise Refused("mass-propers returned non-mapping common_from")
    if value.get("scope") != "missal-antiphons":
        raise Refused(
            "mass-propers returned common_from whose scope is not "
            "'missal-antiphons'"
        )
    return {
        "scope": value.get("scope"),
        "options": [
            {
                key: option.get(key)
                for key in ("mass", "selection")
                if option.get(key) is not None
            }
            for option in value.get("options") or []
            if isinstance(option, dict)
        ],
    }


def validated_ordinary_frame(value: object = _ABSENT_ORDINARY_FRAME) -> dict:
    """Normalize an absent frame to full and reject ambiguous exceptions."""
    if value is _ABSENT_ORDINARY_FRAME:
        return {"applicability": "full"}
    if not isinstance(value, dict):
        raise Refused("mass-propers returned non-mapping ordinary_frame")
    unknown = sorted(str(key) for key in value if key not in {"applicability", "basis"})
    if unknown:
        raise Refused(
            "mass-propers returned ordinary_frame with unknown field(s) "
            + ", ".join(unknown)
        )
    applicability = value.get("applicability")
    if applicability not in ORDINARY_FRAME_APPLICABILITY:
        raise Refused(
            "mass-propers returned unsupported ordinary_frame.applicability "
            f"{applicability!r}"
        )
    basis = value.get("basis")
    if applicability != "full" and (
        not isinstance(basis, str) or not basis.strip()
    ):
        raise Refused(
            f"mass-propers returned ordinary_frame {applicability!r} without a basis"
        )
    if "basis" in value and (not isinstance(basis, str) or not basis.strip()):
        raise Refused("mass-propers returned ordinary_frame with an invalid basis")
    frame = {"applicability": applicability}
    if "basis" in value:
        frame["basis"] = basis
    return frame


def language_projection(proper: dict, lang: str, bible: dict | None) -> dict:
    """Describe one requested-language selection without changing its record.

    The canonical proper remains beside this projection. These states answer a
    narrower question: what can this invocation actually select in `lang`? A
    text in another language is a fallback, not availability; a Bible is a
    delegated source, not a Proper transcription; and a rights-withheld row is
    retained as a reason without exposing the withheld text.
    """
    latin = proper.get("latin") or {}
    if lang == "la" and latin.get("withheld"):
        if (
            proper.get("text")
            or any(
                isinstance(one, dict)
                and one.get("lang") == "la"
                and one.get("text")
                for one in (proper.get("translations") or [])
            )
            or latin.get("held") is not False
            or latin.get("available") is not False
            or latin.get("state") not in {"rights-restricted", "unavailable"}
        ):
            raise Refused(
                "mass-propers withheld Latin must use the exact public unavailable shape"
            )
        return {
            "requested": lang,
            "status": "unavailable",
            "held": False,
            "available": False,
            "complete": False,
            "reason": {"state": "text-withheld", "lang": "la"},
        }
    text_status = proper.get("text_status")
    body_unavailable = (
        isinstance(text_status, dict)
        and text_status.get("state") == "unavailable"
        and text_status.get("scope") == "proper-body"
    )
    if lang == "la" and body_unavailable:
        return {
            "requested": lang,
            "status": "unavailable",
            "held": False,
            "available": False,
            "complete": False,
            "reason": {"state": "text-unavailable", "lang": "la"},
        }
    translations = [
        dict(one)
        for one in (proper.get("translations") or [])
        if isinstance(one, dict)
        and one.get("lang") == lang
        and one.get("text")
    ]
    if translations:
        return {
            "requested": lang,
            "status": "full-text",
            "held": True,
            "available": True,
            "complete": True,
            "texts": translations,
        }

    if lang == "la" and proper.get("text"):
        return {
            "requested": lang,
            "status": "full-text",
            "held": True,
            "available": True,
            "complete": True,
            "texts": [{"lang": "la", "text": proper["text"]}],
        }

    unavailable = [
        dict(one)
        for one in (proper.get("unavailable_translations") or [])
        if isinstance(one, dict) and one.get("lang") == lang
    ]
    if unavailable:
        return {
            "requested": lang,
            "status": "withheld",
            "held": False,
            "available": False,
            "complete": False,
            "reason": [
                {
                    "state": str(one.get("state") or "unavailable"),
                    "lang": one.get("lang"),
                }
                for one in unavailable
            ],
        }


    untranslated = [
        row
        for row in (proper.get("untranslated") or [])
        if isinstance(row, dict) and row.get("lang") == lang
    ]
    rights_withheld = any(
        row.get("state") == "rights-restricted" for row in untranslated
    )
    if rights_withheld:
        return {
            "requested": lang,
            "status": "withheld",
            "held": False,
            "available": False,
            "complete": False,
            "reason": untranslated_reason(proper),
        }

    # A canonical Latin text is carried as an explicit fallback only. It may
    # render in the human view, but it does not make English held or available.
    if lang != "la" and proper.get("text"):
        return {
            "requested": lang,
            "status": "fallback-latin",
            "held": False,
            "available": False,
            "complete": False,
            "fallback": {"lang": "la", "text": proper["text"]},
            "reason": untranslated_reason(proper),
        }

    references = [
        str(one.get("ref"))
        for one in (proper.get("verses") or [])
        if isinstance(one, dict) and one.get("ref")
    ]
    if proper.get("source") == "scripture" and references:
        matching_bible = bool(bible and str(bible.get("language")) == lang)
        resolved = sum(
            1
            for one in (proper.get("verses") or [])
            if isinstance(one, dict) and one.get("ref") and one.get("text")
        )
        complete = matching_bible and resolved == len(references)
        return {
            "requested": lang,
            "status": "scripture-delegated",
            "held": False,
            # The words may be completely resolved by another component, but
            # they are not a full requested-language Proper held here.
            "available": False,
            "complete": False,
            "delegated_to": {
                "component": "bible",
                "id": (bible or {}).get("id"),
                "language": (bible or {}).get("language"),
                "references": references,
                "resolved": resolved,
                "complete": complete,
            },
        }

    if lang != "la" and (body_unavailable or latin.get("withheld")):
        # A Latin fragment is diagnostic when the whole body is unavailable;
        # it does not change the absence of a requested-language body.
        return {
            "requested": lang,
            "status": "absent",
            "held": False,
            "available": False,
            "complete": False,
            "reason": (
                untranslated_reason(proper) if proper.get("untranslated") else "not-recorded"
            ),
        }

    if proper.get("incipit"):
        # Propers currently record their incipits in Latin. Do not let the
        # presence of that fragment advertise English capability.
        return {
            "requested": lang,
            "status": "incipit-only",
            "held": False,
            "available": False,
            "complete": False,
            "incipit": {"lang": "la", "text": proper["incipit"]},
        }

    return {
        "requested": lang,
        "status": "absent",
        "held": False,
        "available": False,
        "complete": False,
        "reason": (
            untranslated_reason(proper) if proper.get("untranslated") else "not-recorded"
        ),
    }


def language_account(
    days: list[dict], requested: str | None, bible: dict | None,
    source_path_rows: dict[int, list[dict]] | None = None,
) -> dict:
    """Add explicit selection metadata and summarize actual day-level support."""
    counts = {
        lang: {
            "lang": lang,
            "units": 0,
            "held": 0,
            "available": 0,
            "complete": 0,
            "statuses": {status: 0 for status in LANGUAGE_STATUSES},
        }
        for lang in SUPPORTED_LANGUAGES
    }
    for day in days:
        # A selected branch is also retained under `branches`; prefer the flat
        # selected projection when present so it is not counted twice.  With
        # no territory selection, account the inspectable branch alternatives
        # instead of reporting a false zero-unit capability.
        masses = day.get("masses") or [
            mass
            for branch in day.get("branches") or []
            if isinstance(branch, dict)
            for mass in branch.get("masses") or []
            if isinstance(mass, dict)
        ]
        for mass in masses:
            admitted = (source_path_rows or {}).get(id(mass))
            # A form manifest is the canonical partition.  The flat `propers`
            # member is only the selected compatibility projection and may be
            # empty, so traverse the nested forms exactly once when present.
            propers = (
                [
                    proper
                    for form in mass.get("forms") or []
                    if isinstance(form, dict)
                    for proper in form.get("propers") or []
                    if isinstance(proper, dict)
                ]
                if mass.get("forms")
                else mass.get("propers") or []
            )
            if admitted is not None:
                propers = [row["proper"] for row in admitted]
            for proper in propers:
                selected = None
                for lang in SUPPORTED_LANGUAGES:
                    projection = language_projection(proper, lang, bible)
                    row = counts[lang]
                    row["units"] += 1
                    row["held"] += int(projection["held"])
                    row["available"] += int(projection["available"])
                    row["complete"] += int(projection["complete"])
                    row["statuses"][projection["status"]] += 1
                    if lang == requested:
                        selected = projection
                if selected is not None:
                    proper["language_selection"] = selected
                # `untranslated` is a source/checker audit ledger.  Its safe
                # semantic result is the language selection above; repeating
                # form/cycle/occurrence/reason internals into a public daily
                # payload would turn a consumer projection back into an audit
                # export.
                proper.pop("untranslated", None)
            if admitted is not None:
                # These rows were admitted by the shared runtime before any
                # material/language selection. Raw source rows stay intact;
                # only their selected-language account is published by index.
                raw_by_index = dict(zip(
                    mass.get("_proper_source_indices") or [],
                    mass.get("propers") or [],
                ))
                for row in admitted:
                    raw = raw_by_index.get(row["sourceIndex"])
                    if raw is not None and "language_selection" in row["proper"]:
                        raw["language_selection"] = row["proper"]["language_selection"]
                for raw in mass.get("propers") or []:
                    raw.pop("untranslated", None)

    available = [counts[lang] for lang in SUPPORTED_LANGUAGES]
    return {
        "mode": "language-projection" if requested else "canonical-record",
        "requested": requested,
        "available": available,
        "selection": counts.get(requested) if requested else None,
    }


def propers_of(
    calendar: str,
    key: str,
    arguments: argparse.Namespace,
    lectionary: dict | None = None,
    *,
    payload: dict | None = None,
) -> dict:
    """One Mass's propers as APPOINTED, with placeholders separated out.

    `mass.propers` is what the entry carries; `appointed` is what the day says.
    They differ wherever the Missal prints a pointer instead of a formulary — a
    saint taking the Mass of a Common, a feria taking the preceding Sunday —
    and wherever a mass is printed in forms rather than as one list, which is
    Christmas. Reading the first was why this tool printed the Nativity as a
    Mass with no propers at all: an absence with no reason, in the one place
    this repository refuses to leave one.
    """
    if payload is None:
        argv = ["show", "--calendar", calendar, "--mass", key]
        for flag in ("bible", "lang", "witness"):
            value = getattr(arguments, flag, None)
            if value:
                argv += [f"--{flag}", str(value)]
        try:
            payload = invoke("mass-propers", argv)
        except Refused as error:
            return {"refused": str(error), "propers": [], "placeholders": 0}
    mass = payload.get("mass") or {}
    passages = ((payload.get("bible") or {}).get("passages")) or {}

    # Form identity is authored by the source, never derived from a display
    # label.  The exact-name lookup is a temporary compatibility bridge while
    # older mass-propers payloads omit appointed[].form_id: it still consumes
    # the source-authored mass.forms[].id and refuses an incomplete mapping.
    source_forms = mass.get("forms") or []
    forms: list[dict] = []
    form_name_to_id: dict[str, str] = {}
    for ordinal, source_form in enumerate(source_forms, start=1):
        if not isinstance(source_form, dict):
            return {
                "refused": "mass-propers returned a non-mapping form",
                "propers": [],
                "forms": [],
                "selected_form": None,
                "form_choice_required": False,
                "placeholders": 0,
            }
        form_id = str(source_form.get("id") or "").strip()
        name = str(source_form.get("name") or "").strip()
        if not form_id or form_id == "main" or not name:
            return {
                "refused": "mass-propers returned a form without a valid source-authored id/name",
                "propers": [],
                "forms": [],
                "selected_form": None,
                "form_choice_required": False,
                "placeholders": 0,
            }
        if form_id in {one["id"] for one in forms} or name in form_name_to_id:
            return {
                "refused": f"mass-propers returned duplicate form identity {form_id!r}",
                "propers": [],
                "forms": [],
                "selected_form": None,
                "form_choice_required": False,
                "placeholders": 0,
            }
        form_name_to_id[name] = form_id
        forms.append({
            "id": form_id,
            "name": name,
            "ordinal": ordinal,
            "propers": [],
            "placeholders": 0,
            **(
                {"ordinary_frame": source_form["ordinary_frame"]}
                if "ordinary_frame" in source_form
                else {}
            ),
            **{
                field: source_form[field]
                for field in ("ordinary_appointments", "celebrated")
                if field in source_form
            },
        })
    forms_by_id = {one["id"]: one for one in forms}

    entries = []
    source_indices: dict[int, int] = {}
    for source_index, row in enumerate(payload.get("appointed") or []):
        if not isinstance(row, dict) or not isinstance(row.get("proper"), dict):
            continue
        proper = copy.deepcopy(row["proper"]) if mass.get("proper_source_paths") else dict(row["proper"])
        selected_cycle = None
        if _calendars.SOURCE_PATH_RELATION not in proper:
            for variants, cycle in (
                (proper.get("cycles") or {}, (lectionary or {}).get("sunday")),
                (proper.get("weekday_cycles") or {}, (lectionary or {}).get("weekday")),
            ):
                selected = variants.get(cycle) if cycle else None
                if isinstance(selected, dict):
                    proper.update(selected)
                    selected_cycle = str(cycle)
                    break
            select_untranslated_records(proper, selected_cycle)
        form_name = row.get("form")
        form_id = row.get("form_id")
        if forms:
            form_id = str(form_id or form_name_to_id.get(str(form_name or "")) or "")
            if form_id not in forms_by_id:
                return {
                    "refused": (
                        "mass-propers appointed a form without its source-authored id: "
                        f"{form_name!r}"
                    ),
                    "propers": [],
                    "forms": [],
                    "selected_form": None,
                    "form_choice_required": False,
                    "placeholders": 0,
                }
        elif form_id not in (None, "", "main") or form_name not in (None, ""):
            return {
                "refused": "mass-propers appointed a named form absent from mass.forms",
                "propers": [],
                "forms": [],
                "selected_form": None,
                "form_choice_required": False,
                "placeholders": 0,
            }
        else:
            form_id = "main"
        source_indices[id(proper)] = source_index
        proper["form"] = form_name
        proper["form_id"] = form_id
        proper["taken_from"] = row.get("taken_from")
        # The words behind each citation, from the resolution `mass-propers`
        # performed. A verse the bible does not carry keeps its reference and
        # says so where the text would have been.
        if _calendars.SOURCE_PATH_RELATION not in proper:
            attach_passages(proper, passages)
        if forms:
            form = forms_by_id[str(form_id)]
            if is_placeholder(proper):
                form["placeholders"] += 1
            else:
                form["propers"].append(proper)
        entries.append(proper)

    requested_form = getattr(arguments, "form", None)
    selected_form = "main" if not forms else None
    if forms and requested_form in forms_by_id:
        selected_form = str(requested_form)
    elif forms and len(forms) > 1 and requested_form is None:
        # The same rule as `dayOfferedForms` in reader-state-adapters.js: a
        # vigil Mass its book appoints for the evening BEFORE is not a coequal
        # choice on the solemnity's own date (Normae universales n. 11).
        own = [
            one for one in forms
            if (one.get("celebrated") or {}).get("when") != "evening-before"
        ]
        if len(own) == 1:
            selected_form = own[0]["id"]
    selected_propers = (
        list(forms_by_id[selected_form]["propers"])
        if forms and selected_form is not None
        else ([p for p in entries if not is_placeholder(p)] if not forms else [])
    )
    selected_placeholders = (
        int(forms_by_id[selected_form]["placeholders"])
        if forms and selected_form is not None
        else (sum(1 for p in entries if is_placeholder(p)) if not forms else 0)
    )
    try:
        text_status = validated_text_status(mass.get("text_status"))
        ordinary_frame = validated_ordinary_frame(
            mass["ordinary_frame"]
            if "ordinary_frame" in mass
            else _ABSENT_ORDINARY_FRAME
        )
        for form in forms:
            if "ordinary_frame" in form:
                form["ordinary_frame"] = validated_ordinary_frame(
                    form["ordinary_frame"]
                )
        if (
            selected_form in forms_by_id
            and "ordinary_frame" in forms_by_id[selected_form]
        ):
            ordinary_frame = forms_by_id[selected_form]["ordinary_frame"]
        common_from = public_common_from(mass.get("common_from"))
    except Refused as error:
        return {
            "refused": str(error),
            "propers": [],
            "forms": forms,
            "selected_form": "main" if not forms else None,
            "form_choice_required": bool(forms),
            "placeholders": 0,
        }
    result = {
        # `propers` is the documented compatibility projection.  Alternative
        # forms never concatenate into it: without a selector their ordered
        # payloads remain inspectable only under `forms`.
        "propers": selected_propers,
        # Private until the expanded event projection is made.  A selected
        # form is a subsequence of the full appointed source list: numbering
        # its own rows would silently turn Day's 015-026 into 001-012.
        "_proper_source_indices": [source_indices[id(p)] for p in selected_propers],
        "_oration_source_rows": [{"proper": p, "sourceIndex": source_indices[id(p)]} for p in entries if not is_placeholder(p)],
        "forms": forms,
        "selected_form": selected_form,
        "form_choice_required": bool(forms and selected_form is None),
        "placeholders": selected_placeholders,
        "rank": mass.get("rank"),
        "edition": payload.get("edition"),
        "advisory": payload.get("advisory"),
        "stands_before": payload.get(_calendars.RECENSION_ACT),
        "recension_coverage": payload.get(_calendars.RECENSION_COVERAGE),
        "recension": mass.get(_calendars.RECENSION),
        "takes_from": mass.get("takes_from"),
        "common_from": common_from,
        "text_status": text_status,
        "ordinary_frame": ordinary_frame,
        "ordinary_appointments": {
            variable: row.get("option")
            for holder in (
                mass,
                forms_by_id.get(selected_form) if selected_form in forms_by_id else None,
            )
            for variable, row in ((holder or {}).get("ordinary_appointments") or {}).items()
            if isinstance(row, dict)
        },
        "bible": payload.get("bible") and {
            "id": payload["bible"].get("id"),
            "edition": payload["bible"].get("edition"),
        },
    }
    if _calendars.PROPER_APPOINTMENT_FACTS in payload:
        result[_calendars.PROPER_APPOINTMENT_FACTS] = _calendars.validate_proper_appointment_facts(payload[_calendars.PROPER_APPOINTMENT_FACTS], calendar)
    if "proper_source_paths" in mass:
        # mass-propers owns source validation and derived origin transport;
        # shared preparation validates the exact public relation before use.
        result["proper_source_paths"] = copy.deepcopy(mass["proper_source_paths"])
        result["_calendar_cycles"] = {
            family: lectionary[family]
            for family in ("sunday", "weekday")
            if family in (lectionary or {})
        }
        result["_source_path_passages"] = passages
    if forms and selected_form is None:
        # Absence here is the typed choice-required state, not the no-form
        # sentinel.  It prevents a null from being mistaken for `main`.
        result.pop("selected_form")
    return result


def run_show(arguments: argparse.Namespace) -> dict:
    lang = requested_language(arguments)
    if getattr(arguments, "proper_choice", None) and (not arguments.expanded or not arguments.calendar):
        raise ValueError("--proper-choice requires --expanded and an explicit --calendar")
    if lang not in SUPPORTED_LANGUAGES:
        raise ValueError(
            f"--lang must be one of {', '.join(SUPPORTED_LANGUAGES)}, not {lang!r}"
        )
    if arguments.form == "main":
        raise ValueError(
            "--form main is the internal no-form sentinel, not a selectable authored form"
        )
    if arguments.ordinary_variant and (
        arguments.json or arguments.format in {"json", "yaml"}
    ):
        raise Refused(
            "--ordinary-variant is a rendered text selection; machine output "
            "does not project a selected Ordinary"
        )
    if arguments.ordinary_variant and not (
        arguments.ordinary or arguments.expanded
    ):
        raise Refused(
            "--ordinary-variant requires --ordinary or --expanded"
        )
    when = arguments.date or dt.date.today().isoformat()
    try:
        dt.date.fromisoformat(when)
    except ValueError as error:
        raise ValueError(f"--date must be an ISO date, not {when!r}") from error

    # Expanded means the words, so it defaults a bible rather than leaving a
    # reader to remember one. It refuses rather than silently printing
    # citations with nothing behind them: an expanded Mass with no scripture in
    # it is not the thing that was asked for.
    chosen_bible = None
    if arguments.expanded and not arguments.bible:
        chosen_bible = default_bible(lang)
        if chosen_bible is None:
            held = ", ".join(sorted({str(one.get("id")) for one in indexed_bibles()})) or "none"
            raise ValueError(
                f"--expanded reads scripture and no indexed bible is held in "
                f"{lang}; name one with --bible (indexed: {held})"
            )
        arguments.bible = str(chosen_bible.get("id"))

    # The ranking, taken from where it already lives. `calendar-days` refuses to
    # rank — correctly, it is the arithmetic layer — and this tool used to print
    # its candidates under "no precedence is stated". That sentence stopped
    # being true when the rubrics sources landed: on Easter Sunday 2026 it
    # offered Easter Sunday and a third-class confessor as equal candidates.
    # `calendar-rubrics day` runs the browser's own model under node, so the
    # terminal and the page give one answer by construction.
    #
    # It is asked FIRST, and where it answers, the arithmetic layer is not asked
    # at all. Its result already carries the season, the week and the liturgical
    # year, so calling `calendar-days day` as well re-parsed a megabyte of YAML
    # to recompute what was already in hand — 2.1 of the 7.4 seconds a single
    # run took. The call remains as the fallback, which is the only case that
    # now needs it.
    problems: list[dict] = []

    def record_problem(problem: dict) -> None:
        """Keep one root problem per exact failed invocation."""
        if problem not in problems:
            problems.append(problem)

    ranked: dict[str, dict] = {}
    ranking_refused = None
    narrow = ["--calendar", arguments.calendar] if arguments.calendar else []
    try:
        payload = invoke("calendar-rubrics", ["day", "--date", when, *narrow])
        ranked = {
            str(one.get("calendar")): one
            for one in (payload.get("days") or [])
            if isinstance(one, dict)
        }
    except Refused as error:
        ranking_refused = str(error)
        record_problem({
            "component": "calendar-rubrics",
            "date": when,
            "calendar": arguments.calendar,
            "error": ranking_refused,
            "fallback": "calendar-days",
        })

    wanted = [name for name in ranked if not arguments.calendar or name == arguments.calendar]
    if wanted:
        resolved = {"days": [{"calendar": name} for name in sorted(wanted)]}
    else:
        # Narrowed, because the arithmetic layer loads every calendar it is not
        # told to skip and this tool knew which one it wanted all along.
        resolved = invoke("calendar-days", ["day", "--date", when, *narrow])

    days = []
    valid_territories: set[str] = set()
    territory_matched = False
    valid_mass_choices: set[str] = set()
    mass_choice_matched = False

    for day in resolved.get("days") or []:
        if arguments.calendar and day.get("calendar") != arguments.calendar:
            continue
        held = ranked.get(str(day.get("calendar")))
        source_branches = [
            one for one in ((held or {}).get("options") or []) if isinstance(one, dict)
        ]

        # Where the model answered, its own account of the day is the account:
        # asking a second tool for the season would be the second derivation
        # this tool exists not to have.
        if source_branches:
            liturgical_year = (held or {}).get("liturgicalYear") or {}
            day = dict(
                day,
                season=(held or {}).get("season"),
                week=(held or {}).get("week"),
                weekday=(held or {}).get("weekday"),
                lectionary=liturgical_year.get("lectionary"),
                unresolved=liturgical_year.get("unresolved") or [],
                anchors=liturgical_year.get("anchors"),
            )

        proper_keys = [
            str(found.get("key"))
            for source_branch in source_branches
            for found in (source_branch.get("readable") or [])
            if isinstance(found, dict) and found.get("key")
        ]
        if not source_branches:
            proper_keys.extend(
                str(candidate.get("key"))
                for candidate in (day.get("candidates") or [])
                if isinstance(candidate, dict) and candidate.get("key")
            )
            if not proper_keys:
                proper_keys.extend(
                    str(candidate.get("key"))
                    for candidate in (day.get("ferial_formulary") or [])
                    if isinstance(candidate, dict) and candidate.get("key")
                )
        proper_payloads = invoke_propers(
            str(day["calendar"]), proper_keys, arguments
        )

        def mass_entry(found: dict, source_branch: dict | None = None) -> dict:
            entry = _SourceMass({
                "key": found.get("key"),
                "name": found.get("label") or found.get("name"),
                "standing": found.get("state"),
                "rule": found.get("why") or found.get("rule"),
                "locus": found.get("locus"),
            })
            if source_branch is not None:
                entry._source_calendar = str(day["calendar"])
                entry._source_branch = source_branch
                entry._source_readable = found
            key = str(found.get("key"))
            entry.update(
                propers_of(
                    str(day["calendar"]),
                    key,
                    arguments,
                    day.get("lectionary"),
                    payload=proper_payloads.get(key),
                )
            )
            entry._oration_source_rows = entry.pop("_oration_source_rows", [])
            if entry.get("refused"):
                record_problem({
                    "component": "mass-propers",
                    "date": when,
                    "calendar": day.get("calendar"),
                    "mass": found.get("key"),
                    "error": entry["refused"],
                })
            return entry

        branch_rows: list[dict] = []
        selected_branch_index = None
        if source_branches:
            branch_ids = []
            for index, source_branch in enumerate(source_branches):
                option = source_branch.get("option")
                branch_id = str(option) if option else "unqualified"
                if branch_id in branch_ids:
                    raise Refused(f"calendar-rubrics returned duplicate branch id {branch_id!r}")
                branch_ids.append(branch_id)
            if len(source_branches) > 1:
                valid_territories.update(branch_ids)
            if arguments.territory:
                if arguments.territory in branch_ids and len(source_branches) > 1:
                    selected_branch_index = branch_ids.index(arguments.territory)
                    territory_matched = True
            elif len(source_branches) == 1:
                selected_branch_index = 0

            for index, (source_branch, branch_id) in enumerate(
                zip(source_branches, branch_ids)
            ):
                choice = source_branch.get("choice")
                choice = dict(choice) if isinstance(choice, dict) else None
                selectable = []
                for candidate in (choice or {}).get("among") or []:
                    if not isinstance(candidate, dict):
                        continue
                    mass_key = candidate.get("key") or candidate.get("candidateId")
                    formulary = candidate.get("formulary")
                    selectable.append({
                        "key": mass_key or formulary,
                        "mass": mass_key,
                        "formulary": formulary,
                        "name": candidate.get("name"),
                    })
                selected_here = index == selected_branch_index
                selectable_keys = {
                    str(value)
                    for one in selectable
                    for value in (one.get("key"), one.get("mass"), one.get("formulary"))
                    if value
                }
                if selected_here:
                    valid_mass_choices.update(selectable_keys)
                requested_mass = (
                    arguments.mass
                    if selected_here and arguments.mass in selectable_keys
                    else None
                )
                if requested_mass:
                    mass_choice_matched = True
                winner = source_branch.get("winner")
                winner_formulary = (
                    winner.get("formulary") if isinstance(winner, dict) else None
                )
                winner_key = (
                    winner_formulary.get("key")
                    if isinstance(winner_formulary, dict)
                    else None
                ) or (winner.get("key") if isinstance(winner, dict) else None)
                selected_mass = requested_mass or (winner_key if selected_here else None)
                intrinsic_choice = bool(
                    source_branch.get("choiceRequired")
                    or ((choice or {}).get("required") and not winner_key)
                )
                masses = [
                    mass_entry(found, source_branch)
                    for found in (source_branch.get("readable") or [])
                    if isinstance(found, dict) and found.get("key")
                ]
                for mass in masses:
                    mass["selected"] = bool(
                        selected_here and selected_mass and mass.get("key") == selected_mass
                    )
                branch_rows.append({
                    "id": branch_id,
                    "option": source_branch.get("option"),
                    "selected": selected_here,
                    "conditions": source_branch.get("conditions") or [],
                    "settled": bool(source_branch.get("settled")),
                    "winner": winner,
                    "choice": choice,
                    "choice_required": bool(
                        intrinsic_choice and selected_mass is None
                    ),
                    "selectable": selectable,
                    "selected_mass": selected_mass,
                    "unsettled": source_branch.get("unsettled") or [],
                    "orations": source_branch.get("orations") or {},
                    **({"oration_execution": source_branch["oration_execution"]} if "oration_execution" in source_branch else {}),
                    "masses": masses,
                })

            selected_branch = (
                branch_rows[selected_branch_index]
                if selected_branch_index is not None
                else None
            )
            masses = selected_branch["masses"] if selected_branch else []
            selected_mass = selected_branch.get("selected_mass") if selected_branch else None
            territory_choice_required = selected_branch is None
            choice_required = bool(
                territory_choice_required
                or (selected_branch and selected_branch.get("choice_required"))
            )
            settled = selected_branch.get("settled") if selected_branch else None
            unsettled = selected_branch.get("unsettled") if selected_branch else []
        else:
            if arguments.territory:
                # Validated after all calendars have been inspected, so an
                # unbranched first calendar cannot reject a later match.
                pass
            candidates = [
                candidate
                for candidate in (day.get("candidates") or [])
                if isinstance(candidate, dict)
            ]
            commemorated = set(day.get("commemorations") or [])
            proper_masses = [
                candidate
                for candidate in candidates
                if candidate.get("key") not in commemorated
            ]
            if not proper_masses:
                for borrowed in day.get("ferial_formulary") or []:
                    if isinstance(borrowed, dict):
                        candidates = [dict(borrowed, borrowed=True), *candidates]
            masses = []
            for candidate in candidates:
                entry = dict(candidate)
                entry.update(mass_entry(candidate))
                masses.append(entry)
            appointed = day.get("appointed")
            selected_mass = appointed or (
                masses[0].get("key") if len(masses) == 1 else None
            )
            for mass in masses:
                mass["selected"] = bool(selected_mass and mass.get("key") == selected_mass)
            territory_choice_required = False
            choice_required = False
            settled = None
            unsettled = []

        row = {
            "calendar": day.get("calendar"),
            "season": day.get("season"),
            "anchors": day.get("anchors"),
            "week": day.get("week"),
            "weekday": day.get("weekday"),
            "ranked": day.get("ranked"),
            "appointed": day.get("appointed"),
            "commemorations": day.get("commemorations") or [],
            "branches": branch_rows,
            "selected_territory": (
                branch_rows[selected_branch_index]["id"]
                if selected_branch_index is not None and len(branch_rows) > 1
                else None
            ),
            "territory_choice_required": territory_choice_required,
            "choice_required": choice_required,
            "selected_mass": selected_mass,
            "masses": masses,
            "settled": settled,
            "unsettled": unsettled,
            "ranking_refused": ranking_refused,
        }
        if arguments.why:
            row["why"] = {
                "lectionary": day.get("lectionary"),
                "unresolved": day.get("unresolved"),
                "ferial_formulary": day.get("ferial_formulary"),
                "precedence": None if day.get("ranked") else PRECEDENCE,
            }
        days.append(row)

    if arguments.territory and not territory_matched:
        held = ", ".join(sorted(valid_territories)) or "none on this date"
        raise ValueError(
            f"--territory {arguments.territory!r} is not available; valid branch ids: {held}"
        )
    if arguments.mass and not mass_choice_matched:
        held = ", ".join(sorted(valid_mass_choices)) or "none on the selected branch"
        raise ValueError(
            f"--mass {arguments.mass!r} is not an available Mass/formulary choice; "
            f"valid keys: {held}"
        )

    valid_forms: set[str] = set()
    form_matched = False
    for row in days:
        selected_mass = row.get("selected_mass")
        for mass in row.get("masses") or []:
            if mass.get("key") != selected_mass:
                continue
            valid_forms.update(str(one["id"]) for one in mass.get("forms") or [])
            if mass.get("selected_form") == arguments.form:
                form_matched = True
    if arguments.form and not form_matched:
        held = ", ".join(sorted(valid_forms)) or "none for the selected Mass"
        raise ValueError(
            f"--form {arguments.form!r} is not available; valid form ids: {held}"
        )

    if getattr(arguments, "proper_choice", None):
        selected = [
            (row, mass)
            for row in days
            for mass in row.get("masses") or []
            if mass.get("key") == row.get("selected_mass")
        ]
        if len(selected) != 1:
            raise Refused("--proper-choice requires one selected Mass on this date")
        row, mass = selected[0]
        proper_appointment_context_for(
            str(row["calendar"]), mass,
            ordinary_predicate_context_for(row, mass, when),
            arguments.proper_choice,
        )

    # The Ordinary belongs to one enacted Mass/form, never to a branch or
    # formulary alternative merely because it was listed first.
    if arguments.ordinary or arguments.expanded:
        for row in days:
            selected = next(
                (
                    mass
                    for mass in row.get("masses") or []
                    if mass.get("key") == row.get("selected_mass")
                ),
                None,
            )
            if selected is None:
                row["ordinary_suppressed"] = {
                    "kind": (
                        "territory-choice-required"
                        if row.get("territory_choice_required")
                        else "mass-choice-required"
                        if row.get("choice_required")
                        else "ferial-formulary-unavailable"
                        if row.get("settled") is True
                        else "day-unsettled"
                    )
                }
                continue
            if selected.get("form_choice_required"):
                row["ordinary_suppressed"] = {"kind": "form-choice-required"}
                continue
            frame = selected.get("ordinary_frame") or {"applicability": "full"}
            row["ordinary_frame"] = frame
            if frame.get("applicability") != "full":
                row["ordinary_suppressed"] = {
                    "kind": "ordinary-frame",
                    "applicability": frame.get("applicability"),
                    "basis": frame.get("basis"),
                }
                continue
            argv = [
                "show",
                "--calendar",
                str(row["calendar"]),
                "--lang",
                lang,
            ]
            try:
                row["ordinary"] = (
                    invoke("mass-ordinary", argv).get("ordinary") or [None]
                )[0]
            except Refused as error:
                row["ordinary"] = {"refused": str(error)}
                record_problem({
                    "component": "mass-ordinary",
                    "date": when,
                    "calendar": row.get("calendar"),
                    "error": str(error),
                })

    machine_events = arguments.expanded and (
        arguments.json or arguments.format in {"json", "yaml"}
    )
    source_path_rows: dict[int, list[dict]] = {}
    for row in days:
        readable = row.get("masses") or [
            mass for branch in row.get("branches") or []
            for mass in branch.get("masses") or []
        ]
        for mass in readable:
            if isinstance(mass, _SourceMass):
                mass._oration_context = oration_context_for(row, mass, when)
            source_indices = mass.get("_proper_source_indices", [])
            path_resolution = None
            if mass.get("proper_source_paths") or any(_calendars.SOURCE_PATH_RELATION in proper for proper in mass.get("propers") or []):
                source_path_rows[id(mass)] = []
                if not mass.get("form_choice_required"):
                    selected = mass.get("key") == row.get("selected_mass")
                    held_ordinary = row.get("ordinary")
                    path_ordinary = (
                        held_ordinary if selected and arguments.expanded
                        and not row.get("ordinary_suppressed")
                        and isinstance(held_ordinary, dict)
                        and not held_ordinary.get("refused") else None
                    )
                    predicates = ordinary_predicate_context_for(row, mass, when)
                    path_resolution = mass_events(
                        path_ordinary,
                        [{"proper": proper, "sourceIndex": index}
                         for proper, index in zip(mass.get("propers") or [], source_indices)],
                        arguments.ordinary_variant if path_ordinary is not None else None,
                        predicates,
                        proper_appointment_context_for(
                            str(row["calendar"]), mass, predicates,
                            getattr(arguments, "proper_choice", None) if selected else None,
                        ), getattr(mass, "_oration_context", None),
                    )
                    publish_appointment_resolution(mass, path_resolution)
                    source_path_rows[id(mass)] = path_resolution["_prepared_rows"]
                    publish_admitted_passages(mass, path_resolution)
                    if not (arguments.json or arguments.format in {"json", "yaml"}):
                        mass["_source_path_resolution"] = path_resolution
            if mass.get("key") != row.get("selected_mass"):
                continue
            if not machine_events:
                if path_resolution is not None:
                    continue
                if not (arguments.json or arguments.format in {"json", "yaml"}):
                    continue
                facts = mass.get(_calendars.PROPER_APPOINTMENT_FACTS) or {}
                if not any(
                    "usage_values" in facts.get(
                        ((proper.get(_calendars.ORDINARY_DISPOSITION) or {}).get("when") or {}).get("fact"), {}
                    )
                    for proper in mass.get("propers") or []
                ):
                    continue
                predicates = ordinary_predicate_context_for(row, mass, when)
                resolution = mass_events(
                    None, [{"proper": proper, "sourceIndex": index} for proper, index in zip(mass.get("propers") or [], source_indices)],
                    None, predicates, proper_appointment_context_for(str(row["calendar"]), mass, predicates),
                )
                publish_appointment_resolution(mass, resolution)
                continue
            ordinary = row.get("ordinary")
            if (
                row.get("ordinary_suppressed")
                or not isinstance(ordinary, dict)
                or ordinary.get("refused")
            ):
                if not (getattr(mass, "_oration_context", {}) or {}).get("execution") and not mass.get("proper_source_paths") and not any("appointment_identity" in proper or "appointment_replacement" in proper or _calendars.APPOINTMENT_APPLICABILITY in proper or _calendars.SOURCE_PATH_RELATION in proper for proper in mass.get("propers") or []) and not getattr(arguments, "proper_choice", None):
                    continue
                ordinary = None
            mass["expanded_events"] = expanded_event_projection(
                str(row["calendar"]), mass, ordinary, source_indices,
                ordinary_predicate_context_for(row, mass, when),
                getattr(arguments, "proper_choice", None),
                prepared_resolution=path_resolution, oration_context=getattr(mass, "_oration_context", None),
            )

    bible = chosen_bible or indexed_bible(arguments.bible)
    language = language_account(days, arguments.lang, bible, source_path_rows)
    if arguments.json or arguments.format in {"json", "yaml"}:
        for row in days:
            # Branches share their Mass objects with the selected projection;
            # clean each identity once, including unselected alternatives.
            masses = [*row.get("masses", []), *[
                mass for branch in row.get("branches") or []
                for mass in branch.get("masses") or []
            ]]
            for mass in masses:
                if mass.get("proper_source_paths") or any(mass is one for one in row.get("masses") or []):
                    mass.pop("_proper_source_indices", None)
                mass.pop("_calendar_cycles", None)
                mass.pop("_source_path_passages", None)

    return {
        "status": "partial" if problems else "ok",
        "problems": problems,
        "date": when,
        "days": days,
        "advisory": resolved.get("advisory"),
        "language": language,
        "scripture": (
            {
                "id": arguments.bible,
                "label": (bible or {}).get("label"),
                "edition": (bible or {}).get("edition"),
                "language": (bible or {}).get("language"),
                "defaulted": chosen_bible is not None,
            }
            if arguments.bible
            else None
        ),
    }


def wrap(text: str, indent: str) -> list[str]:
    out: list[str] = []
    for paragraph in str(text).strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if block:
            out.extend(textwrap.wrap(block, WIDTH - len(indent)))
            out.append("")
    return [indent + line if line else "" for line in (out[:-1] or out)]


def render_ordinary(
    one: dict,
    lang: str,
    style: Style,
    show_rubrics: bool,
    wanted: list[str] | str | None = None,
) -> None:
    """The frame printed after the propers, which is what `--ordinary` means.

    It is deliberately NOT what `--expanded` does. This appends the Ordinary
    below the day's propers; expanded sets the propers into it at the places
    the missal appoints. Both are useful and they are different questions.
    """
    if "refused" in one:
        print(f"  ordinary unavailable: {one['refused']}")
        return
    print("")
    for line in style.heading(one.get("title") or "The Ordinary"):
        print(f"  {line}")
    resolved = mass_events(one, [], wanted)
    for event in resolved["events"]:
        if event.get("kind") == "begin_section":
            print("")
            for line in style.heading(str(event["section"]["name"]), rule="-"):
                print(f"  {line}")
        elif event.get("kind") == "ordinary_element":
            for line in element_lines(
                event["element"], lang, style, indent="    ",
                show_rubrics=show_rubrics,
            ):
                print(line)
    for unresolved in resolved["unresolved"]:
        condition = unresolved.get("condition") or {}
        print("  " + style.note(
            "ordinary applicability unresolved at "
            f"{unresolved.get('element')}: "
            f"{condition.get('basis') or 'no positive source binding is held'}"
        ))


# ---------------------------------------------------------------- the seating
#
# The browser and terminal both run `ordinary-seating.js`. This adapter carries
# its semantic event stream across the Python/node boundary; it states no
# seating or traversal rule.


def ordinary_selection_map(
    ordinary: dict, wanted: list[str] | str | None,
) -> dict[str, str]:
    """Validate repeatable option ids and bind each to its declared group."""
    selected: dict[str, str] = {}
    requested = [wanted] if isinstance(wanted, str) else list(wanted or [])
    options = {
        option.get("id"): group.get("group")
        for group in ordinary.get("variants") or []
        for option in group.get("options") or []
    }
    for option in requested:
        group = options.get(option)
        if group is None:
            raise Refused(f"the Ordinary declares no variant option {option!r}")
        previous = selected.get(group)
        if previous is not None and previous != option:
            raise Refused(
                f"the Ordinary cannot select both {previous!r} and {option!r} "
                f"from one group {group!r}"
            )
        selected[group] = option
    return selected


def ordinary_predicates(propers: list[dict]) -> dict[str, bool]:
    """Positive applicability facts carried by this selected formulary."""
    predicates: dict[str, bool] = {}
    if any(
        (proper.get("proper") or proper).get("name") == "Second Reading"
        for proper in propers
    ):
        predicates["second-reading-appointed"] = True
    # No Preface row proves nothing: this corpus says Prefaces are unmodelled.
    # `mass-has-no-proper-preface` needs a future positive source binding.
    return predicates


def oration_context_for(day: dict, mass: dict, date: str | None = None) -> dict:
    branch = getattr(mass, "_source_branch", {})
    readable = getattr(mass, "_source_readable", {})
    return {
        "active": bool(day.get("selected_mass") == mass.get("key") and branch.get("settled") and readable.get("state") == "said"),
        "calendar": day.get("calendar"), "mainKey": mass.get("key"),
        "date": date, "season": day.get("season"), "facts": mass.get("proper_appointment_facts") or {},
        "execution": branch.get("oration_execution"),
        "series": (branch.get("orations") or {}).get("all") or (branch.get("orations") or {}).get("low_mass") or [],
        "owners": [{"key": owner.get("key"), "sourcePaths": owner.get("proper_source_paths") or [], "rows": getattr(owner, "_oration_source_rows", [])} for owner in day.get("masses") or []],
    }


def mass_events(
    ordinary: dict,
    propers: list[dict],
    wanted: list[str] | str | None,
    predicate_context: dict | None = None,
    proper_appointment_context: dict | None = None,
    oration_context: dict | None = None,
) -> dict:
    harness = (
        "const model = require(process.argv[1]);\n"
        "process.on('uncaughtException', error => {\n"
        "  process.stderr.write(JSON.stringify({code:error.code || 'shared-seating-failed',message:error.message,context:error.context || null}));\n"
        "  process.exitCode = 1;\n"
        "});\n"
        "let raw = '';\n"
        "process.stdin.on('data', (chunk) => { raw += chunk; });\n"
        "process.stdin.on('end', () => {\n"
        "  const input = JSON.parse(raw);\n"
        "  const predicates = Object.assign(\n"
        "    {}, model.predicateFacts(input.predicate_context), input.predicates);\n"
        "  const resolved = input.ordinary ? model.resolveElements(\n"
        "    input.ordinary, input.wanted, predicates) : {shown:[],unresolved:[],selected:{}};\n"
        "  const shown = resolved.shown;\n"
        "  const appointments = model.prepareProperAppointments(\n"
        "    input.propers, input.proper_appointment_context);\n"
        "  const placed = input.ordinary ? model.seatPropers(\n"
        "    appointments.rows, model.seats(input.ordinary, shown), null, appointments.selections) : null;\n"
        "  const events = input.ordinary ? model.massEvents(shown, placed) :\n"
        "    model.unframedEvents(appointments.rows, null, appointments.selections);\n"
        "  const activeRows = [];\n"
        "  events.forEach(event => {\n"
        "    if (event.kind === 'proper') activeRows.push({proper:event.proper,sourceIndex:event.sourceIndex});\n"
        "    if (event.kind === 'proper_choice' && event.selection && event.selection.state === 'selected') {\n"
        "      activeRows.push(...event.options.find(one => one.id === event.selection.option).rows);\n"
        "    }\n"
        "  });\n"
        "  const plan = model.orationPlan(activeRows, input.oration_context);\n"
        "  const planned = new Map(plan.map(one => [one.sourceIndex, one.groups]));\n"
        "  function attach(event) {\n"
        "    if (event.kind === 'proper' && planned.has(event.sourceIndex)) event.orationGroups = planned.get(event.sourceIndex);\n"
        "    if (event.kind === 'proper_choice' && event.selection && event.selection.state === 'selected') {\n"
        "      const option = event.options.find(one => one.id === event.selection.option);\n"
        "      option.rows.forEach(row => {if (planned.has(row.sourceIndex)) row.orationGroups = planned.get(row.sourceIndex);});\n"
        "    }\n"
        "  }\n"
        "  events.forEach(attach);\n"
        "  process.stdout.write(JSON.stringify({\n"
        "    events: events, unresolved: resolved.unresolved,\n"
        "    selected: resolved.selected,\n"
        "    proper_appointment_selections: appointments.selections,\n"
        "    proper_appointment_unresolved: appointments.unresolved,\n"
        "    proper_appointment_inactive: appointments.inactive,\n"
        "    proper_appointment_usage: appointments.usage,\n"
        "    prepared_rows: appointments.rows,\n"
        "    material_selections: appointments.materialSelections,\n"
        "    source_path_selections: appointments.sourcePathSelections,\n"
        "    source_path_unresolved: appointments.sourcePathUnresolved,\n"
        "    source_path_availability: appointments.sourcePathAvailability\n"
        "  }));\n"
        "});\n"
    )
    try:
        finished = subprocess.run(
            ["node", "-e", harness, str(SEATING_MODEL)],
            input=json.dumps({
                "ordinary": ordinary,
                "propers": [row if isinstance(row.get("proper"), dict) else {"proper": row, "sourceIndex": index} for index, row in enumerate(propers)],
                "wanted": ordinary_selection_map(ordinary or {}, wanted),
                "predicate_context": predicate_context,
                "proper_appointment_context": proper_appointment_context or {},
                "oration_context": oration_context,
                "predicates": ordinary_predicates(propers),
            }),
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError as error:
        raise Refused("node is not installed, so the Ordinary cannot be seated") from error
    if finished.returncode != 0:
        detail = (finished.stderr or finished.stdout or "").strip()
        raise Refused(f"the Ordinary seating model failed under node: {detail[:800]}")
    try:
        result = json.loads(finished.stdout)
    except json.JSONDecodeError as error:
        raise Refused(f"the Ordinary seating model returned invalid JSON: {error}") from error

    if not isinstance(result.get("events"), list) or not isinstance(
        result.get("unresolved"), list
    ):
        raise Refused("the Ordinary seating model returned no typed resolution")
    if (proper_appointment_context or {}).get("sourcePaths"):
        # The shared owner chose exact material owners before any body,
        # language or Scripture selection. This is the existing CLI merge
        # operation, consuming that admitted child without choosing a cycle.
        projected = {}
        for row in result.pop("prepared_rows", []):
            proper = copy.deepcopy(row["proper"])
            selector = row.get("materialCycle")
            if selector is not None:
                owner = row.get("materialOwner")
                if owner is not None:
                    proper.update(owner)
                select_untranslated_records(
                    proper, None if selector["cycle"] == "all" else selector["cycle"]
                )
                attach_passages(proper, getattr(proper_appointment_context, "_bible_passages", {}))
            projected[row["sourceIndex"]] = {"proper": proper, "sourceIndex": row["sourceIndex"]}
        result["_prepared_rows"] = list(projected.values())
        for event in result["events"]:
            if event.get("kind") == "proper":
                event["proper"] = projected[event["sourceIndex"]]["proper"]
            elif event.get("kind") == "proper_choice":
                for option in event["options"]:
                    option["rows"] = [projected[row["sourceIndex"]] for row in option["rows"]]
    else:
        result.pop("prepared_rows", None)
        for field in SOURCE_PATH_RESOLUTION_FIELDS:
            result.pop(field, None)
    return result


SOURCE_PATH_RESOLUTION_FIELDS = (
    "material_selections", "source_path_selections", "source_path_unresolved",
    "source_path_availability",
)


def publish_appointment_resolution(mass: dict, resolution: dict) -> None:
    for field in ("proper_appointment_selections", "proper_appointment_unresolved", "proper_appointment_inactive"):
        if resolution.get(field):
            mass[field] = resolution[field]
    if "proper_appointment_usage" in resolution:
        mass["proper_appointment_usage"] = resolution["proper_appointment_usage"]
    if mass.get("proper_source_paths"):
        for field in SOURCE_PATH_RESOLUTION_FIELDS:
            mass[field] = resolution[field]


def publish_admitted_passages(mass: dict, resolution: dict) -> None:
    """Transport only the exact JS-admitted owner's resolved verse metadata."""
    raw_by_index = dict(zip(mass.get("_proper_source_indices") or [], mass.get("propers") or []))
    for row in resolution["_prepared_rows"]:
        raw = raw_by_index[row["sourceIndex"]]
        if _calendars.SOURCE_PATH_RELATION not in raw:
            continue
        selector = resolution["material_selections"][str(row["sourceIndex"])]
        owner = raw if selector["family"] is None else raw[selector["family"]][selector["cycle"]]
        owner["verses"] = copy.deepcopy(row["proper"]["verses"])


def proper_appointment_context_for(calendar: str, mass: dict, predicate_context: dict, wanted=None) -> dict:
    choices = {}
    prefix = f"proper-choice/{calendar}/{mass['key']}/"
    for request in wanted or []:
        identifier, separator, option = request.partition("=")
        if not separator or not identifier.startswith(prefix) or not option:
            raise Refused("--proper-choice requires an exact choice identity of this edition and Mass, followed by =option")
        scope = identifier[len(prefix):]
        if len(scope.split("/")) != 2 or any(not _calendars.ORDINARY_DISPOSITION_ID.fullmatch(part) for part in (*scope.split("/"), option)):
            raise Refused("--proper-choice has an invalid form/group/option coordinate")
        if scope in choices:
            raise Refused("--proper-choice repeats an appointment group")
        choices[scope] = option
    context = {"calendar": calendar, "mass": mass["key"], "entrance": "day", "date": predicate_context.get("date"), "season": predicate_context.get("season"), "facts": mass.get(_calendars.PROPER_APPOINTMENT_FACTS) or {}, "choices": choices}
    if mass.get("proper_source_paths"):
        context = _ProperAppointmentContext(context)
        context._bible_passages = mass.get("_source_path_passages") or {}
        context.update(
            formId=mass.get("selected_form"), sourcePaths=mass["proper_source_paths"],
            calendarCycles=mass.get("_calendar_cycles") or {},
            conditionFacts=predicate_context.get("condition_facts", {}),
        )
    if isinstance(mass, _SourceMass) and mass.get("selected") is True and getattr(mass, "_source_calendar", None) == calendar:
        context["usageContext"] = {
            "calendar": calendar,
            "entrance": "day",
            "branch": mass._source_branch,
            "readable": mass._source_readable,
            "mass": {"key": mass["key"], "forms": [{"id": form.get("id")} for form in mass.get("forms") or []]},
            "formId": mass.get("selected_form"),
        }
    return context


def ordinary_predicate_context_for(day: dict, mass: dict, date: str) -> dict:
    """The same date and appointment facts for text and machine readings."""
    branch = next(
        (one for one in day.get("branches") or [] if one.get("selected")),
        None,
    )
    winner = branch.get("winner") if isinstance(branch, dict) else None
    return {
        "settled": branch.get("settled") if isinstance(branch, dict) else False,
        "weekday": day.get("weekday"),
        "season": day.get("season"),
        "nature": winner.get("nature") if isinstance(winner, dict) else None,
        "date": date,
        "anchors": day.get("anchors"),
        # A borrowed formulary's own variables are not today's appointments.
        "appointments": (
            {} if mass.get("borrowed") else mass.get("ordinary_appointments") or {}
        ),
    }


def expanded_event_projection(
    calendar: str,
    mass: dict,
    ordinary: dict,
    source_indices: list[int],
    predicate_context: dict,
    proper_choices=None,
    *, prepared_resolution: dict | None = None, oration_context: dict | None = None,
) -> list[dict]:
    """Publish only the ordered identities of the CLI's seated event stream."""
    propers = mass.get("propers") or []
    if (
        len(source_indices) != len(propers)
        or any(not isinstance(index, int) or index < 0 for index in source_indices)
        or source_indices != sorted(set(source_indices))
    ):
        raise Refused("the selected Proper rows lost their full source ordinals")
    rows = [
        {"proper": proper, "sourceIndex": index}
        for proper, index in zip(propers, source_indices)
    ]
    resolution = prepared_resolution if prepared_resolution is not None else mass_events(
        ordinary, rows, None, predicate_context,
        proper_appointment_context_for(calendar, mass, predicate_context, proper_choices), oration_context)
    stream = resolution["events"]
    publish_appointment_resolution(mass, resolution)
    mass_key = str(mass["key"])

    def proper_id(index: int) -> str:
        return f"proper/{calendar}/{mass_key}/{index + 1:03d}"

    def group_projection(groups):
        return [{**{key: value for key, value in group.items() if key != "members"},
                 "members": [{"id": f"proper/{calendar}/{member['key']}/{member['sourceIndex'] + 1:03d}",
                              "key": member["key"], "source_index": member["sourceIndex"],
                              "form_id": member["proper"].get("form_id") or "main",
                              **({"applicability": member["applicability"]} if "applicability" in member else {})}
                             for member in group["members"]]} for group in groups]

    events: list[dict] = []
    for event in stream:
        kind = event.get("kind")
        if kind == "begin_section":
            events.append({
                "id": "ordinary-section/" + str(event["section"]["key"]),
                "kind": "ordinary-section",
            })
        elif kind == "ordinary_element":
            events.append({
                "id": "ordinary-element/" + str(event["element"]["key"]),
                "kind": "ordinary-element",
            })
        elif kind == "proper":
            events.append({
                "id": proper_id(event["sourceIndex"]), "kind": "proper",
                "source_index": event["sourceIndex"],
                "form_id": str(event["proper"].get("form_id") or "main"),
                **({"oration_groups": group_projection(event["orationGroups"])} if event.get("orationGroups") else {}),
            })
        elif kind == "proper_choice":
            form_id = str(event["formId"])
            events.append({
                "id": f"proper-choice/{calendar}/{mass_key}/{form_id}/{event['group']}",
                "kind": "proper-choice", "source_index": event["sourceIndex"],
                "form_id": form_id,
                **({"selection": event["selection"]} if "selection" in event else {}),
                "options": [
                    {
                        "id": option["id"],
                        "events": [proper_id(row["sourceIndex"]) for row in option["rows"]],
                        **({"oration_groups": [{"id": proper_id(row["sourceIndex"]), "groups": group_projection(row["orationGroups"])} for row in option["rows"] if row.get("orationGroups")]} if any(row.get("orationGroups") for row in option["rows"]) else {}),
                    }
                    for option in event["options"]
                ],
            })
        else:
            raise Refused(f"the seated event stream has unknown kind {kind!r}")
    ids = [event["id"] for event in events]
    if len(ids) != len(set(ids)):
        raise Refused("the expanded event stream repeats a semantic identity")
    return events


def proper_head(proper: dict) -> str:
    """A proper's name, its form where it has one, and its scripture references."""
    head = str(proper.get("name") or "proper")
    if proper.get("form"):
        head += f" [{proper['form']}]"
    refs = [
        str(one.get("ref"))
        for one in (proper.get("verses") or [])
        if isinstance(one, dict) and one.get("ref")
    ]
    if refs:
        head += f" — {'; '.join(refs)}"
    return head


def proper_lines(
    proper: dict,
    style: Style,
    indent: str,
    *,
    lang: str,
    witness: str | None,
    seat: dict | None,
    why: bool,
) -> list[str]:
    """One proper of the day, expanded: its words, and where they came from."""
    body = indent + "  "
    lines = [""]
    lines.extend(indent + one for one in style.heading(proper_head(proper)))
    if proper.get("taken_from"):
        taken = proper["taken_from"]
        named = str(taken.get("mass") or "")
        printed = str(taken.get("citation") or "").strip()
        lines.append(body + style.note(
            f"taken from {named}"
            + (f", {taken['proper']}" if taken.get("proper") else "")
            + (f" ({printed})" if printed else "")
        ))
    if why and seat:
        lines.append(body + style.note(f"seated here by {seat.get('locus')}"))

    # A verified language-only whole-body absence does not turn the cited
    # Bible excerpt into that missing antiphon. The producer already validated
    # the exact source target and registered witness before projecting this row.
    language_body_gap = any(
        isinstance(row, dict) and row.get("lang") == lang
        and isinstance(row.get("target"), dict)
        and row["target"].get("extent") == "body"
        for row in (proper.get("untranslated") or []) + (proper.get("unavailable_translations") or [])
    )
    has_language_body = proper.get("source") == "scripture" and language_body_gap
    selection = language_projection(proper, lang, None) if has_language_body else {}
    selected_whole_body_held = selection.get("status") == "full-text" and any(
        isinstance(row, dict) and row.get("lang") == lang and row.get("text")
        and (witness is None or row.get("source_id") == witness)
        for row in selection.get("texts") or []
    )
    if has_language_body and selected_whole_body_held:
        lines.append(body + style.note(
            "Bible component only — shown separately from the selected antiphon body"
        ))
    if has_language_body and not selected_whole_body_held:
        lines.append(body + style.note(
            "Bible component only — the whole requested-language antiphon body is unavailable"
        ))
        states = {str(row.get("state") or "unavailable")
                  for row in (proper.get("untranslated") or []) +
                  (proper.get("unavailable_translations") or [])
                  if isinstance(row, dict) and row.get("lang") == lang}
        label = "rights restricted" if "rights-restricted" in states else "unavailable"
        lines.append(body + style.note(f"{lang} antiphon body unavailable: {label}"))
    for verse in proper.get("verses") or []:
        if not isinstance(verse, dict) or not verse.get("ref"):
            continue
        note = str(verse.get("note") or "")
        lines.append("")
        lines.append(body + style.note(str(verse["ref"]) + (f"  ({note})" if note else "")))
        if verse.get("text"):
            lines.extend(wrap_lines(str(verse["text"]), body + "  ", WIDTH))
        else:
            # A citation the named bible does not answer keeps its reference
            # and says so where the words would have been.
            lines.append(body + "  " + style.note(
                "[unresolved: the bible named here carries no text for this reference]"
            ))

    for text, attribution, note in _calendars.texts_of(proper, lang, witness):
        if text:
            lines.append("")
            if attribution:
                lines.append(body + style.note(f"[{attribution}]"))
            lines.extend(wrap_lines(text, body, WIDTH))
        if note:
            lines.append(body + style.note(f"({note})"))
    latin_note = latin_availability_note(proper, lang)
    if latin_note:
        lines.append(body + style.note(latin_note))
    notes_owner = proper
    if has_language_body and selected_whole_body_held:
        # A restriction on another witness does not withdraw selected public
        # wording. Keep notes about other languages/extents unchanged.
        notes_owner = dict(proper, untranslated=[
            row for row in proper.get("untranslated") or []
            if not (isinstance(row, dict) and row.get("lang") == lang
                    and isinstance(row.get("target"), dict)
                    and row["target"].get("extent") == "body")
        ])
    for note in untranslated_notes(notes_owner):
        lines.append(body + style.note(f"[{note}]"))
    return lines


def render_unresolved_formulary(mass: dict, indent: str, style: Style) -> None:
    """State structural Common directions and withheld formularies without guessing."""
    frame = mass.get("ordinary_frame") or {"applicability": "full"}
    if frame.get("applicability") != "full":
        applicability = str(frame.get("applicability") or "unavailable").replace("-", " ")
        print(indent + style.note(f"Ordinary frame {applicability} for this rite."))
        if frame.get("basis"):
            for line in wrap_lines(str(frame["basis"]), indent + "  ", WIDTH):
                print(style.note(line))
    if mass.get("form_choice_required"):
        print(indent + style.note("form choice required; select one with --form:"))
        for form in mass.get("forms") or []:
            if not isinstance(form, dict) or not form.get("id"):
                continue
            name = str(form.get("name") or form["id"])
            print(indent + style.note(f"  {form['id']} — {name}"))
    common = mass.get("common_from") or {}
    for option in common.get("options") or []:
        if not isinstance(option, dict) or not option.get("mass"):
            continue
        selection = str(option.get("selection") or "").strip()
        note = f"Common direction (text not resolved): {option['mass']}"
        if selection:
            note += f" — {selection}"
        print(indent + style.note(note))
    status = mass.get("text_status") or {}
    if status.get("state") == "unavailable":
        reasons = [
            str(one.get("kind") or "unspecified").replace("-", " ")
            for one in status.get("reasons") or []
            if isinstance(one, dict)
        ]
        reason = ", ".join(dict.fromkeys(reasons)) or "reason not recorded"
        scope = str(status.get("scope") or "formulary").replace("-", " ")
        print(indent + style.note(f"{scope} unavailable: {reason}"))


def render_recension_context(mass: dict, indent: str, style: Style) -> None:
    """Keep inherited text provenance beside the daily formulary it qualifies."""

    coverage = mass.get(_calendars.RECENSION_COVERAGE)
    stamp = mass.get(_calendars.RECENSION)
    advisory = str(mass.get("advisory") or "").strip()
    boundaries = mass.get(_calendars.RECENSION_ACT)
    if isinstance(boundaries, list) and boundaries:
        print(indent + style.note(
            "Historical boundary — stands before: " + "; ".join(boundaries)
        ))
    if isinstance(coverage, dict) and coverage.get("status"):
        print(indent + style.note(f"Recension coverage: {coverage['status']}"))
    if isinstance(stamp, dict):
        source = stamp.get("text_from") or stamp.get("calendar")
        if source:
            qualifier = "stated for this recension"
            if stamp.get("stated") is not True:
                inheritance = coverage.get("inheritance") if isinstance(coverage, dict) else {}
                collation = (
                    inheritance.get("status")
                    if isinstance(inheritance, dict)
                    else None
                ) or "uncollated"
                qualifier = f"inherited, {collation}"
            print(indent + style.note(
                f"Proper text source: {source} ({qualifier})"
            ))
        if stamp.get(_calendars.DEPARTURE_ACT):
            print(indent + style.note(
                f"Departure act: {stamp[_calendars.DEPARTURE_ACT]}"
            ))
        for row in stamp.get("also") or []:
            if isinstance(row, dict) and row.get(_calendars.DEPARTURE_ACT):
                label = "Additional departure act"
                if row.get("kind"):
                    label += f" ({row['kind']})"
                print(indent + style.note(
                    f"{label}: {row[_calendars.DEPARTURE_ACT]}"
                ))
    if advisory:
        for line in wrap(advisory, indent):
            print(style.note(line))


def render_expanded_mass(
    mass: dict,
    ordinary: dict | None,
    arguments: argparse.Namespace,
    style: Style,
    *,
    frame: bool,
    predicate_context: dict | None = None,
    calendar: str | None = None,
) -> None:
    """One Mass, set into the frame if it is the one the frame is drawn for."""
    indent = "      "
    propers = mass["propers"]
    if mass.get("refused"):
        print(f"    refused: {mass['refused']}")
    if mass.get("takes_from"):
        reference = mass["takes_from"]
        print(f"    takes the Mass of {reference.get('mass')}"
              + (f", form {reference['form']}" if reference.get("form") else ""))
    # Structural Common directions and typed availability are orthogonal to
    # the retained Proper rows.  In particular a borrowed Common may retain
    # its chants while the source explicitly says that its proper Collect is
    # unavailable; hiding that notice whenever any Proper exists changes the
    # meaning of the record.
    render_unresolved_formulary(mass, "    ", style)

    def aside(what: str) -> None:
        print("")
        for line in wrap_lines(what, "    ", WIDTH):
            print(style.note(line))

    def pour(held: list) -> None:
        for proper, seat in held:
            for line in proper_lines(
                proper, style, indent,
                lang=requested_language(arguments), witness=arguments.witness,
                seat=seat, why=arguments.why,
            ):
                print(line)

    def pour_event(event, seat=None):
        pour([(event["proper"], seat)])
        for group in event.get("orationGroups") or []:
            if group["position"] == 2 and 'intermediate-conclusion-spans-unbound' in group['execution'].get('unresolved', []):
                aside("Oration execution unresolved: printed ending cues are retained; exact intermediate conclusion spans are not established.")
            if 'source-name-placeholder-unbound' in group['execution'].get('unresolved', []):
                aside("Oration execution unresolved: the source name placeholder is retained; occurrence-specific wording is not established.")
            for member in group["members"]:
                if member["key"] == mass.get("key") and member["sourceIndex"] == event["sourceIndex"]:
                    continue
                aside(str(member.get("of_name") or member["key"]) + "; conclusion group " + str(group["conclusion_group"]))
                pour([(member["proper"], seat)])

    def pour_choice(event):
        selection = event.get("selection") or {"state": "required", "option": None}
        option = next((option for option in event["options"] if option["id"] == selection.get("option")), None)
        if option is None:
            aside("Proper choice required: " + str(event["group"]) + "; options: " + ", ".join(option["id"] for option in event["options"]))
        else:
            for row in option["rows"]:
                pour_event(row, event.get("seat"))

    source_rows = [{"proper": proper, "sourceIndex": index} for proper, index in zip(propers, mass.get("_proper_source_indices") or range(len(propers)))]
    # `frame` identifies the enacted Mass even when no Ordinary is available.
    # Other displayed formularies keep their own unselected appointment state.
    proper_choices = getattr(arguments, "proper_choice", None) if frame else None
    appointment_context = proper_appointment_context_for(str(calendar or arguments.calendar or ""), mass, predicate_context or {}, proper_choices)
    oration_context = getattr(mass, "_oration_context", None) if frame else None

    if ordinary is None or "refused" in (ordinary or {}) or not frame:
        if ordinary is not None and "refused" in ordinary:
            print(f"\n    no Ordinary is held for this calendar: {ordinary['refused']}")
            print("    the propers are printed in the missal's own order.")
        elif not frame and not mass.get("day_ordinary_suppressed"):
            aside(
                "the Ordinary is printed once, above; this formulary's propers "
                "are set out here in the missal's own order."
            )
        if not (oration_context or {}).get("execution") and not mass.get("proper_source_paths") and not any(_calendars.ORDINARY_DISPOSITION in proper or "appointment_replacement" in proper or _calendars.APPOINTMENT_APPLICABILITY in proper or _calendars.SOURCE_PATH_RELATION in proper for proper in propers) and not appointment_context["choices"]:
            pour([(proper, None) for proper in propers])
            return
        resolution = mass.get("_source_path_resolution") or mass_events(None, source_rows, None, predicate_context, appointment_context, oration_context)
        for event in resolution["events"]:
            if event["kind"] == "proper_choice":
                pour_choice(event)
            elif event["kind"] == "proper":
                pour_event(event)
        for unresolved in resolution["proper_appointment_unresolved"]:
            aside("Proper appointment unresolved: " + str(unresolved.get("basis") or unresolved.get("group")))
        for unresolved in resolution.get("source_path_unresolved") or []:
            aside("Source path required: " + str(unresolved["relation"]))
        return

    resolution = mass.get("_source_path_resolution") or mass_events(
        ordinary, source_rows, arguments.ordinary_variant, predicate_context, appointment_context, oration_context
    )
    for unresolved in resolution["unresolved"]:
        condition = unresolved.get("condition") or {}
        aside(
            "ordinary applicability unresolved at "
            f"{unresolved.get('element')}: "
            f"{condition.get('basis') or 'no positive source binding is held'}"
        )
    for unresolved in resolution["proper_appointment_unresolved"]:
        aside("Proper appointment unresolved: " + str(unresolved.get("basis") or unresolved.get("group")))
    for unresolved in resolution.get("source_path_unresolved") or []:
        aside("Source path required: " + str(unresolved["relation"]))

    announced: set[str] = set()
    for event in resolution["events"]:
        kind = event.get("kind")
        if kind == "begin_section":
            section = event["section"]
            print("")
            for line in style.heading(str(section.get("name") or ""), rule="-"):
                print(f"    {line}")
        elif kind == "ordinary_element":
            for line in element_lines(
                event["element"], requested_language(arguments), style,
                indent=indent, show_rubrics=arguments.rubrics, why=arguments.why,
                context={"calendar": str(calendar or arguments.calendar or ""), "formulary": str(mass.get("key") or "")},
            ):
                print(line)
        elif kind == "proper_choice":
            pour_choice(event)
        elif kind == "proper":
            placement = event.get("placement")
            if placement == "before" and placement not in announced:
                announced.add(placement)
                aside(
                    "this Mass opens with propers the Ordinary appoints no place for; "
                    "they are shown first, in the missal's own order."
                )
            elif placement == "after" and placement not in announced:
                announced.add(placement)
                aside(
                    "from here the day's propers no longer run forward through the "
                    "Ordinary: this day carries more than one formulary, or its rite "
                    "departs from the frame. The rest is shown in the missal's own "
                    "order, unseated and unreordered."
                )
            pour_event(event, event.get("seat"))


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("mass-today error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 1 if payload.get("problems") else 0
    if arguments.format == "yaml":
        import yaml

        yaml.SafeDumper.add_representer(_SourceMass, yaml.SafeDumper.represent_dict)
        print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
        return 1 if payload.get("problems") else 0

    style = getattr(arguments, "style_resolved", None) or Style()
    scripture = payload.get("scripture")

    print(payload["date"])
    for day in payload["days"]:
        head = f"{day['calendar']}"
        if day.get("season"):
            head += f" — {day['season']}"
            if day.get("week"):
                head += f", week {day['week']}"
        print("")
        print("\n".join(style.heading(head, rule="=")) if arguments.expanded else head)
        # Which edition the scripture was read from, said with the Mass and not
        # left to a flag the reader may not have passed. An unattributed
        # scripture text is the one thing a citation may never resolve to.
        if arguments.expanded and scripture:
            named = scripture.get("label") or scripture.get("id")
            print("  " + style.note(
                f"scripture read from {named}"
                + (" (defaulted; name another with --bible)" if scripture.get("defaulted") else "")
            ))
        if not day["masses"] and not day.get("territory_choice_required"):
            print("  no mass is written for this day")
        appointed = day.get("appointed")
        commemorated = set(day.get("commemorations") or [])

        if day.get("ranking_refused"):
            print(f"  the rubrics could not be consulted: {day['ranking_refused']}")
        ordinary_suppressed = day.get("ordinary_suppressed") or {}
        if day.get("territory_choice_required"):
            print("  " + style.note("territory choice required; select one with --territory:"))
            for branch in day.get("branches") or []:
                if isinstance(branch, dict) and branch.get("id"):
                    print("  " + style.note(f"  {branch['id']}"))
        elif day.get("choice_required"):
            print("  " + style.note("Mass choice required; select one with --mass:"))
            selected_branch = next(
                (
                    branch
                    for branch in day.get("branches") or []
                    if isinstance(branch, dict) and branch.get("selected")
                ),
                None,
            )
            for choice in (selected_branch or {}).get("selectable") or []:
                if isinstance(choice, dict) and choice.get("key"):
                    print("  " + style.note(f"  {choice['key']}"))
        # A day the rubrics settle is stated. A day they do not is stated as
        # not settled, with the reason — which is a different thing from the
        # arithmetic layer's older "no precedence is stated", and must not be
        # printed over a day that IS settled.
        if day.get("settled") is False:
            print("  this date is not settled here:")
            for note in day.get("unsettled") or []:
                print(f"    {note.get('what')}: {note.get('why')}")
        elif day.get("settled") is None and day["masses"] and not appointed \
                and not day.get("ranked"):
            print(f"  {len(day['masses'])} masses; {PRECEDENCE}")

        ordered = (
            day["masses"]
            if day.get("settled") is not None
            else sorted(
                day["masses"],
                key=lambda m: (m["key"] != appointed, m["key"] in commemorated),
            )
        )
        # The frame is drawn once a day, for the Mass that is said. A date
        # carrying several formularies still shows every one of them and every
        # one of their propers; what it does not do is print a hundred and
        # ninety-five unvarying elements four times over, or leave a reader to
        # work out which of four Ordinaries is the one they are at.
        # Only an explicitly resolved Mass receives the frame.  Falling back
        # to `ordered[0]` framed an arbitrary arm of an authorized optional-day
        # choice and made the next arm claim that an Ordinary had been printed
        # above when none had been enacted at all.
        framed = day.get("selected_mass")
        for mass in ordered:
            rank = f" ({mass['rank']})" if mass.get("rank") else ""
            mark = ""
            if mass.get("standing"):
                word = (
                    "an authorized option; select explicitly with --mass"
                    if day.get("choice_required") and mass["standing"] == "option"
                    else STANDING_WORDS.get(mass["standing"], mass["standing"])
                )
                mark = f"  — {word}" if word else ""
            elif mass.get("borrowed"):
                mark = "  — " + str(mass.get("rule") or "the formulary this day borrows")
            elif mass["key"] in commemorated:
                mark = "  — commemorated within the mass above"
            elif appointed and mass["key"] != appointed:
                mark = "  — also appointed here"
            name = f"{mass.get('name') or mass['key']}{rank}"
            print("")
            if arguments.expanded:
                for line in style.heading(name, rule="-"):
                    print(f"  {line}")
                if mark:
                    print("  " + style.note(mark.strip()))
            else:
                print(f"  {style.said(name) if not mark else name}{mark}")
            render_recension_context(mass, "    ", style)
            if arguments.why and mass.get("rule"):
                print(f"    why: {mass['rule']}")
            if arguments.expanded:
                if ordinary_suppressed:
                    mass["day_ordinary_suppressed"] = True
                render_expanded_mass(
                    mass, day.get("ordinary"), arguments, style,
                    frame=mass["key"] == framed,
                    predicate_context=ordinary_predicate_context_for(
                        day, mass, str(payload.get("date")),
                    ),
                    calendar=str(day["calendar"]),
                )
                if mass["placeholders"] and (
                    (mass.get("ordinary_frame") or {}).get("applicability", "full") == "full"
                ):
                    count = mass["placeholders"]
                    print(
                        f"\n    {count} placeholder{'' if count == 1 else 's'}: "
                        "this Mass's text is not yet transcribed"
                    )
                continue
            if mass.get("refused"):
                print(f"    refused: {mass['refused']}")
            render_unresolved_formulary(mass, "    ", style)
            displayed_propers = mass["propers"]
            if mass.get("proper_source_paths") or any(_calendars.ORDINARY_DISPOSITION in proper or "appointment_replacement" in proper or _calendars.APPOINTMENT_APPLICABILITY in proper or _calendars.SOURCE_PATH_RELATION in proper for proper in displayed_propers):
                context = ordinary_predicate_context_for(day, mass, str(payload.get("date")))
                source_rows = [{"proper": proper, "sourceIndex": index} for proper, index in zip(displayed_propers, mass.get("_proper_source_indices") or range(len(displayed_propers)))]
                prepared = mass.get("_source_path_resolution") or mass_events(None, source_rows, None, context, proper_appointment_context_for(str(day["calendar"]), mass, context))
                displayed_propers = []
                for event in prepared["events"]:
                    if event["kind"] == "proper":
                        displayed_propers.append(event["proper"])
                    elif event["kind"] == "proper_choice":
                        selection = event.get("selection") or {}
                        selected = next((option for option in event["options"] if option["id"] == selection.get("option")), None)
                        if selected is None:
                            print("    Proper choice required: " + event["group"])
                        else:
                            displayed_propers.extend(row["proper"] for row in selected["rows"])
                for unresolved in prepared["proper_appointment_unresolved"]:
                    print("    Proper appointment unresolved: " + str(unresolved.get("basis") or unresolved["group"]))
                for unresolved in prepared.get("source_path_unresolved") or []:
                    print("    Source path required: " + str(unresolved["relation"]))
            for proper in displayed_propers:
                # A scripture proper carries its reference rather than its
                # words: printing the name alone would show an empty slot
                # where the Missal prints a lesson.
                refs = [
                    str(one.get("ref"))
                    for one in (proper.get("verses") or [])
                    if isinstance(one, dict) and one.get("ref")
                ]
                head = proper.get("name") or "proper"
                if refs:
                    head += f" — {'; '.join(refs)}"
                print(f"\n    {head}")
                # Through the SAME selector the expanded view and
                # `mass-propers show` use. This printed `proper["text"]`
                # directly, which is the tracked Latin whatever `--lang` said,
                # so the day view answered a reader in Latin over an English
                # translation the same repository was publishing on the site.
                # That is the defect the failure register records as "the
                # English reaching the site and not the terminal", and it
                # recurred here because a third reader of one file grew its own
                # rule instead of calling the one that exists.
                shown = _calendars.texts_of(
                    proper, requested_language(arguments), getattr(arguments, "witness", None)
                )
                # A cited chant incipit is Latin identifying apparatus, not an
                # English rendering and not the full Latin proper.  The shared
                # helper carries both facts so this compact view cannot
                # silently put Latin under an English request.  Composed
                # rights/untranslated absences have their own typed path.
                incipit = _calendars.incipit_only_of(
                    proper, requested_language(arguments), getattr(arguments, "witness", None)
                )
                if incipit:
                    print(f"      {incipit['note']}: {incipit['text']}…")
                for text, attribution, note in shown:
                    if text:
                        if attribution:
                            print(f"      [{attribution}]")
                        for line in wrap(text, "      "):
                            print(line)
                    if note:
                        print(f"      ({note})")
                latin_note = latin_availability_note(
                    proper, requested_language(arguments)
                )
                if latin_note:
                    print(f"      {style.note(latin_note)}")
                for note in untranslated_notes(proper):
                    print(f"      [{note}]")
            if mass["placeholders"] and (
                (mass.get("ordinary_frame") or {}).get("applicability", "full") == "full"
            ):
                count = mass["placeholders"]
                print(
                    f"\n    {count} placeholder{'' if count == 1 else 's'}: "
                    "this Mass's text is not yet transcribed"
                )
        if arguments.why and day.get("why"):
            for note in day["why"].get("unresolved") or []:
                print(f"\n  unresolved: {note}")
        if arguments.ordinary and not arguments.expanded and day.get("ordinary"):
            render_ordinary(
                day["ordinary"], requested_language(arguments), style,
                arguments.rubrics, arguments.ordinary_variant,
            )
    problems = payload.get("problems") or []
    if problems:
        count = len(problems)
        print(
            f"\npartial result: {count} component "
            f"failure{'' if count == 1 else 's'}"
        )
    return 1 if problems else 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--date", help="the civil date to resolve (default: today)")
    shared.add_argument("--calendar", help="limit to one calendar, e.g. roman-1962")
    shared.add_argument(
        "--ordinary",
        action="store_true",
        help="print the Ordinary after the propers, unseated",
    )
    shared.add_argument(
        "--expanded",
        action="store_true",
        help="the whole Mass: scripture in words, propers set into the Ordinary",
    )
    shared.add_argument(
        "--ordinary-variant",
        action="append",
        help=(
            "select an Ordinary variant option by id; repeat for independent "
            "groups (default: each group's source-declared display default)"
        ),
    )
    shared.add_argument(
        "--territory",
        help="select a source-authored territorial calendar branch by id",
    )
    shared.add_argument(
        "--mass",
        help="select a Mass/formulary key where the rubrics require a choice",
    )
    shared.add_argument(
        "--form",
        help="select a source-authored form id within the enacted Mass",
    )
    shared.add_argument("--proper-choice", action="append", help="select an exact proper-choice/edition/Mass/form/group=option; repeat for independent groups")
    shared.add_argument(
        "--no-rubrics",
        dest="rubrics",
        action="store_false",
        default=True,
        help="hide the priest's actions (they still seat the propers)",
    )
    shared.add_argument(
        "--why",
        action="store_true",
        help="print the rule that placed each Mass, and what stayed unresolved",
    )
    shared.add_argument(
        "--format", choices=("text", "yaml", "json"), default="text", help="output form"
    )
    shared.add_argument("--bible", help="indexed bible to resolve scripture refs against")
    shared.add_argument(
        "--lang",
        help=(
            "language projection to print, en or la (default renderer: en; "
            "machine output keeps canonical-record mode)"
        ),
    )
    shared.add_argument("--witness", help="show only this translation's source_id")
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="mass-today",
        description="Print the Mass appointed for a date, with its propers and Ordinary.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "mass-today")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("show", help="print the Mass appointed for a date", parents=[shared]),
        EXAMPLES["show"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={"show": run_show},
        renderer=render,
        prefix="mass-today",
        argv=argv,
        default_verb="show",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={Refused: ("input", 2), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
