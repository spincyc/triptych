def caption_claims(record: dict) -> tuple[str, str]:
    identity, use = "", ""
    for claim in record["claims"]:
        if claim["evidence_state"] == "editorial-proposal":
            continue
        if claim["kind"] == "identity":
            identity = claim["text"]
        elif claim["kind"] in {"liturgical-use", "ceremonial-presence"}:
            use = claim["text"]
    digest = hashlib.sha256((identity + "\0" + use).encode()).hexdigest()
    if REDUNDANT_CAPTION_PAIRS.get(record["id"]) == digest:
        use = ""
    return identity, use


@functools.lru_cache(maxsize=4)
def _source_note_library(root: Path):
    path = root / "tools/source-library"
    loader = importlib.machinery.SourceFileLoader("rsd_source_library", str(path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    require(spec is not None, "cannot load source library")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    loader.exec_module(module)
    return module.load_library(root, check_binding_fingerprints=False)


def source_reference_text(edition: dict) -> tuple[str, str]:
    """Keep bibliographic prose, not a structured publication's audit ledger."""
    value = edition.get("publication")
    if isinstance(value, str) and value.lstrip().startswith("{"):
        try:
            value = json.loads(value)
        except json.JSONDecodeError as error:
            raise ContractError("invalid structured source publication metadata") from error
    if isinstance(value, str):
        require(bool(value.strip()), "source publication statement is empty")
        return edition["title"].strip().removesuffix("."), value.strip()
    require(isinstance(value, dict), "unsupported source publication metadata shape")
    require(isinstance(value.get("edition"), str) and bool(value["edition"].strip()),
            "structured source publication needs an edition statement")
    require(value.get("imprint") is None or isinstance(value["imprint"], str),
            "unsupported structured source publication imprint")
    return value["edition"].strip().removesuffix("."), (value.get("imprint") or "").strip()


def source_note_metadata(root: Path, records: list[dict], library=None) -> tuple[dict, dict, set[Path]]:
    """Resolve exact source metadata, without acquiring or reading witness bytes."""
    library = library if library is not None else _source_note_library(root.resolve())
    editions, bindings = {}, {}
    inputs = {root.resolve() / "tools/source-library"}
    for record in records:
        for source in record["sources"]:
            binding = source["binding"]
            target = library.records.get(binding)
            require(target is not None, f"{record['id']}: unknown source-note binding {binding}")
            inputs.add(target.path.resolve())
            edition_id = target.record_id if target.record_type == "edition" else target.data.get("edition_id")
            edition = library.records.get(edition_id)
            require(edition is not None and edition.record_type == "edition",
                    f"{binding}: source note has no identified edition")
            require(isinstance(edition.data.get("title"), str) and bool(edition.data["title"].strip()),
                    f"{edition_id}: source note needs title and publication metadata")
            source_reference_text(edition.data)
            inputs.add(edition.path.resolve())
            editions[edition_id] = edition.data
            bindings[binding] = edition_id
    return editions, bindings, inputs


def source_note_inputs(root: Path, records: list[dict]) -> set[Path]:
    """Metadata affecting notes; object TOML bindings remain the caller's inputs."""
    return source_note_metadata(root, records)[2]


def edition_source_note_inputs(root: Path, owner: Path, selection_id: str) -> set[Path]:
    selections = load(owner / "shared/schema/edition-selections.toml")
    editions = [row for row in selections["editions"] if row["id"] == selection_id]
    require(len(editions) == 1, f"unknown source-note selection: {selection_id}")
    alpha = canonical_alpha_assets(load(owner / "research/artwork-manifest.toml"))
    records = [load(path) for path in sorted((owner / "shared/objects").rglob("*.toml"))]
    selected_records = [record for record in records if alpha_selected(record, editions[0], alpha)
                        and record["id"] not in PUBLIC_RENDER_HOLD_IDS]
    return source_note_inputs(root, selected_records)


def source_notes_tex(records: list[dict], edition: dict, root: Path, library=None) -> list[str]:
    editions, bindings, _ = source_note_metadata(root, records, library)
    source_numbers = {key: number for number, key in enumerate(sorted(editions), 1)}
    lines = ["\\gdef\\RSDPrintSourceNotes{%", "\\RSDSourceNotesStart"]
    for number, record in enumerate(records, 1):
        references = list(dict.fromkeys(
            (source_numbers[bindings[source["binding"]]], source["locus"])
            for source in record["sources"]
        ))
        source_labels = "; ".join(
            f"\\RSDReferenceLink{{{source_number}}} {tex(locus.strip().removesuffix('.'))}"
            for source_number, locus in references
        ) + "."
        lines.append(f"\\RSDSourceNote{{{number}}}{{{tex(record['preferred_english_name'])}}}"
                     f"{{{source_labels}}}")
    lines.append("\\RSDSourceNotesEnd")
    lines.append("\\RSDReferencesStart")
    for edition_id, number in source_numbers.items():
        source_edition = editions[edition_id]
        title, publication = source_reference_text(source_edition)
        lines.append(f"\\RSDReference{{{number}}}{{{tex(title)}}}{{{tex(publication)}}}")
    lines.extend(["\\RSDReferencesEnd", "}"])
    return lines


def canonical_asset_path(value: str) -> str:
    """Return the manifest/TeX path relative to the dictionary root."""
    return value[len(DICTIONARY_PREFIX):] if value.startswith(DICTIONARY_PREFIX) else value


def canonical_alpha_assets(manifest: dict) -> set[str]:
    """Return only assets explicitly admitted to canonical alpha publication."""
    return {
        canonical_asset_path(item["path"])
        for table in ("asset_files", "asset")
        for item in manifest.get(table, [])
        if item.get("state") == "canonical-alpha-eligible"
    }


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ContractError(message)


def validate_record(record: dict, filename: Path, schema: dict) -> None:
    unknown = set(record) - OBJECT_KEYS
    require(not unknown, f"{filename}: unknown fields: {', '.join(sorted(unknown))}")
    for table, allowed in NESTED_KEYS.items():
        values = record.get(table, [])
        if isinstance(values, dict):
            values = [values]
        for value in values:
            nested_unknown = set(value) - allowed
            require(not nested_unknown,
                    f"{filename}: unknown {table} fields: {', '.join(sorted(nested_unknown))}")
    for key in schema["record"]["required"]:
        require(key in record, f"{filename}: missing required field {key}")
    require(record["schema_version"] == 1, f"{filename}: unsupported schema version")
    require(bool(ID.fullmatch(record["id"])) and record["id"].startswith("obj-"),
            f"{filename}: invalid object id")
    sources = {item["id"] for item in record.get("sources", [])}
    art = {item["id"] for item in record.get("artwork", [])}
    require(len(sources) == len(record.get("sources", [])), f"{filename}: duplicate source id")
    require(len(art) == len(record.get("artwork", [])), f"{filename}: duplicate artwork id")
    for claim in record["claims"]:
        require(all(source in sources for source in claim.get("source_ids", [])),
                f"{filename}: claim {claim['id']} references an unknown source")
    for variant in record.get("variants", []):
        require(all(source in sources for source in variant["source_ids"]),
                f"{filename}: variant {variant['id']} references an unknown source")
        require(all(item in art for item in variant["artwork_ids"]),
                f"{filename}: variant {variant['id']} references unknown artwork")


def publication_ready(record: dict, schema: dict, manifest_assets: set[str]) -> bool:
    gate = schema["publication_gate"]
    if record["workflow_state"] not in gate["selectable_workflow_states"]:
        return False
    claim_states = set(gate["allowed_claim_states"])
    claims = record["claims"]
    if any(claim["evidence_state"] not in claim_states for claim in claims):
        return False
    kinds = {claim["kind"] for claim in claims}
    if not set(gate["required_claim_kinds"]).issubset(kinds):
        return False
    if any(item["review_state"] not in gate["allowed_artwork_states"]
           or item["asset"] not in manifest_assets for item in record["artwork"]):
        return False
    return True


def selected(record: dict, edition: dict) -> bool:
    if record["id"] in edition.get("explicit_exclusions", []):
        return False
    if set(record["statuses"]) & set(edition.get("exclude_statuses", [])):
        return False
    if record["workflow_state"] not in edition["include_workflow_states"]:
        return False
    if edition["kind"] == "comprehensive":
        return bool(set(record["statuses"]) & set(edition.get("include_statuses", []))) \
            and bool(set(record["periods"]) & set(edition.get("include_periods", [])))
    field = edition["relevance_field"].split(".")[-1]
    by_relevance = record["audience_relevance"][field] in edition["include_relevance"]
    by_category = bool(set(record["categories"]) & set(edition.get("include_categories", [])))
    return by_relevance or by_category


def alpha_gate_failure(record: dict, alpha_assets: set[str]) -> str | None:
    """Return the first defect that bars the canonical alpha rendering."""
    if record["workflow_state"] not in {
        "source-audited", "art-reviewed", "publication-ready"
    }:
        return f"workflow state {record['workflow_state']}; identity/source audit incomplete"
    if "unresolved" in record["statuses"]:
        return "object identity or governing status remains unresolved"
    if any(
        claim["evidence_state"] == "unverified-lead"
        for claim in record["claims"]
    ):
        return "a printed claim remains an unverified lead"
    sources = {source["id"]: source for source in record["sources"]}
    if any(
        source_id not in sources
        or sources[source_id]["verification_state"] != "claim-verified"
        for claim in record["claims"]
        if claim["evidence_state"] != "editorial-proposal"
        for source_id in claim["source_ids"]
    ):
        return "a printed factual claim lacks a claim-verified source binding"
    if (
        not record["artwork"]
        and record["id"] not in TEX_NATIVE_ARTWORK_IDS
        and record.get("presentation_mode") != "text-only"
    ):
        return "no artwork is registered"
    if any(
        canonical_asset_path(artwork["asset"]) not in alpha_assets
        for artwork in record["artwork"]
    ):
        return "artwork lacks recorded rights, provenance, and asset identity"
    if any(
        artwork["review_state"] not in {
            "identity-checked", "liturgically-checked", "print-checked", "approved"
        }
        for artwork in record["artwork"]
    ):
        return "artwork has not passed basic identity and visual review"
    return None


def alpha_selected(record: dict, edition: dict, alpha_assets: set[str]) -> bool:
    """Select the canonical source-bounded alpha view for one edition."""
    if alpha_gate_failure(record, alpha_assets) is not None:
        return False
    if record["id"] in edition.get("explicit_exclusions", []):
        return False
    if edition["kind"] == "comprehensive":
        return True
    field = edition["relevance_field"].split(".")[-1]
    by_relevance = record["audience_relevance"][field] in edition["include_relevance"]
    by_category = bool(set(record["categories"]) & set(edition.get("include_categories", [])))
    return by_relevance or by_category


def alpha_omission_reason(
    record: dict, edition: dict, alpha_assets: set[str]
) -> str:
    gate_failure = alpha_gate_failure(record, alpha_assets)
    if gate_failure is not None:
        return gate_failure
    if record["id"] in edition.get("explicit_exclusions", []):
        return "explicitly excluded by the edition selection"
    if edition["kind"] != "comprehensive":
        return "not selected for this use-derived audience"
    return "not admitted by the canonical alpha selection"


def record_tex(record: dict, edition: dict, artwork_render_owners: dict[str, str]) -> str:
    public_artwork = [
        artwork
        for artwork in record["artwork"]
        if artwork["id"] not in PUBLIC_ARTWORK_HOLD_IDS
    ]
    has_owned_artwork = any(
        artwork_render_owners[artwork["id"]] == record["id"]
        for artwork in public_artwork
    )
    fallback_artwork_id = (
        public_artwork[0]["id"]
        if public_artwork and not has_owned_artwork
        else None
    )
    shared_layer_key = record["id"] == "obj-pontifical-tunicle" and any(
        artwork["id"] == LAYER_STUDY_ARTWORK_ID for artwork in public_artwork)
    if shared_layer_key:
        require(artwork_render_owners[LAYER_STUDY_ARTWORK_ID] == "obj-pontifical-dalmatic",
                "shared pontifical layer study needs its declared dalmatic owner")
    lines = [
        f"\\RSDObjectRecord{{{tex(record['id'])}}}"
        f"{{{tex(record['preferred_english_name'])}}}{{{tex(record['latin_headword'])}}}",
        f"\\RSDObjectAliases{{{tex(record.get('alternate_english_names', []))}}}"
        f"{{{tex(record.get('alternate_latin_names', []))}}}",
        f"\\RSDObjectClassification{{{tex(record['categories'])}}}{{{tex(record['periods'])}}}"
        f"{{{tex(record['statuses'])}}}{{{tex(record['ceremonies'])}}}",
        f"\\RSDObjectPresence{{{tex(record['presence']['locations'])}}}"
        f"{{{tex(record['presence']['contexts'])}}}",
        f"\\RSDObjectHandling{{{tex(record['handling']['ordinary_handlers'])}}}"
        f"{{{tex(record['handling']['server_relation'])}}}",
        f"\\RSDObjectRelations{{{tex(record.get('confusable_with', []))}}}"
        f"{{{tex(record.get('related_objects', []))}}}",
    ]
    if record.get("pronunciation_key"):
        lines.append(f"\\RSDObjectPronunciationKey{{{tex(record['pronunciation_key'])}}}")
    for claim in record["claims"]:
        if claim["evidence_state"] == "editorial-proposal":
            continue
        lines.append("\\RSDClaim"
                     f"{{{tex(claim['id'])}}}{{{tex(claim['kind'])}}}{{{tex(claim['text'])}}}"
                     f"{{{tex(claim['evidence_state'])}}}{{{tex(claim['source_ids'])}}}"
                     f"{{{tex(claim.get('applies_to_variants', []))}}}")
    identity, use = caption_claims(record)
    lines.append(f"\\RSDDisplayCaption{{{tex(identity)}}}{{{tex(use)}}}")
    warnings = " ".join(record["handling"].get("warnings", []))
    lines.append(f"\\RSDHandlingWarnings{{{tex(warnings)}}}")
    note_number = edition.get("_source_note_numbers", {}).get(record["id"], "")
    lines.append(f"\\RSDObjectNoteNumber{{{note_number}}}")
    if edition["audience"] == "altar-server":
        label = {
            "must-not-handle": "Recognize; do not handle.",
            "recognizes-only": "Recognize only.",
            "moves-only-by-direction": "Move only as directed.",
        }.get(record["handling"]["server_relation"], "")
        if label:
            lines.append(f"\\RSDHandlingCaption{{{tex(label)}}}")
    for variant in record.get("variants", []):
        lines.append("\\RSDVariant"
                     f"{{{tex(variant['id'])}}}{{{tex(variant['preferred_name'])}}}"
                     f"{{{tex(variant.get('latin_name', ''))}}}"
                     f"{{{tex(variant['distinguishing_features'])}}}{{{tex(variant['status'])}}}"
                     f"{{{tex(variant['source_ids'])}}}{{{tex(variant['artwork_ids'])}}}")
    for source in record.get("sources", []):
        lines.append("\\RSDSourceBinding"
                     f"{{{tex(source['id'])}}}{{{tex(source['binding'])}}}{{{tex(source['locus'])}}}"
                     f"{{{tex(source['role'])}}}{{{tex(source['verification_state'])}}}"
                     f"{{{tex(source.get('checked_on', ''))}}}")
    for artwork in record["artwork"]:
        if artwork["id"] in PUBLIC_ARTWORK_HOLD_IDS:
            continue
        render_owner = artwork_render_owners[artwork["id"]]
        # A contextual comparison may be linked by several component records.
        # Keep one canonical owner by default, but never emit an admitted
        # object as a blank card when that comparison is its only approved
        # view. The repeated rendering remains explicitly tied to the same
        # artwork identity and is preferable to inventing an isolated form.
        if artwork["id"] == fallback_artwork_id and not (
            shared_layer_key and artwork["id"] == LAYER_STUDY_ARTWORK_ID
        ):
            render_owner = record["id"]
        lines.append("\\RSDArtwork"
                     f"{{{tex(artwork['id'])}}}{{{tex(artwork['view'])}}}"
                     f"{{{tex(canonical_asset_path(artwork['asset']))}}}"
                     f"{{{tex(artwork['review_state'])}}}{{{tex(artwork['depicts'])}}}"
                     f"{{{tex(artwork.get('variant_id', ''))}}}"
                     f"{{{tex(artwork.get('scale_mode', 'not-applicable'))}}}"
                     f"{{{tex(render_owner)}}}")
    if shared_layer_key:
        lines.append("\\RSDSharedLayerKey")
    for note in record.get("audience_note", []):
        lines.append("\\RSDAudienceNote"
                     f"{{{tex(note['audience'])}}}{{{tex(note['text'])}}}"
                     f"{{{tex(note['claim_ids'])}}}{{{tex(record['id'])}}}")
        if note["audience"] == edition["audience"]:
            if note["text"] not in record["handling"].get("warnings", []) and note["text"] != warnings:
                lines.append(f"\\RSDSelectedAudienceNote{{{tex(note['text'])}}}")
    lines.append("\\RSDEndObjectRecord")
    return "\n".join(lines)


def primary_category(record: dict) -> str:
    """Choose one stable display category without changing canonical identity."""
    precedence = (
        "church-and-sanctuary", "altar-and-appointments", "sacred-vessels",
        "linens-and-textiles", "books-and-printed-objects", "service-objects",
        "incense", "priestly-vestments", "deacon-and-subdeacon",
        "pontifical-and-prelatial", "servers-ministers-and-choir", "requiem",
        "nuptial-and-ritual", "holy-week", "pontifical-mass-compositions",
        "related-ceremonies", "historical",
    )
    categories = set(record["categories"])
    return next((category for category in precedence if category in categories),
                record["categories"][0])


def section_for(record: dict, edition: dict) -> str:
    """Route an admitted record through the edition's declared reader order."""
    category = primary_category(record)
    edition_id = edition["id"]
    if category == "servers-ministers-and-choir":
        return "servers-ministers-and-choir"
    if edition_id == "ed-comprehensive":
        if any(record["id"] in ids for _, ids in SECTION_PLATE_PLANS[(edition_id, "pontifical-and-prelatial")]):
            return "pontifical-and-prelatial"
        if category == "sacred-vessels":
            return "linens-and-textiles"
        if category == "incense":
            return "service-objects"
        if category == "deacon-and-subdeacon":
            return "priestly-vestments"
        return category
    if edition_id == "ed-altar-server":
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial",
                        "servers-ministers-and-choir"}:
            return "vestments-ministers-and-insignia"
        if category in {"related-ceremonies", "requiem", "nuptial-and-ritual",
                        "holy-week", "pontifical-mass-compositions"}:
            return "special-masses-and-related-ceremonies"
        if category in {"church-and-sanctuary", "altar-and-appointments"}:
            return "sanctuary-orientation"
        return "objects-around-the-server"
    if edition_id == "ed-sacristan":
        if category in {"church-and-sanctuary", "altar-and-appointments",
                        "service-objects"}:
            return "sanctuary-and-altar-preparation"
        if category in {"sacred-vessels", "linens-and-textiles",
                        "books-and-printed-objects", "incense"}:
            return "vessels-linens-and-books"
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial"}:
            return "vestments-and-insignia"
        return "special-ceremony-equipment"
    if edition_id == "ed-mc-trainer":
        for (plan_edition, section), plates in SECTION_PLATE_PLANS.items():
            if plan_edition != edition_id:
                continue
            if any(record["id"] in object_ids for _, object_ids in plates):
                return section
        raise ContractError(
            f"{edition_id}: selected record {record['id']} is absent from "
            "the edition-wide plate plan"
        )
    if edition_id == "ed-general-reader":
        if category in {"church-and-sanctuary", "altar-and-appointments"}:
            return "sanctuary"
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial"}:
            return "vestments-and-insignia"
        if category == "historical":
            return "historical-perspective"
        return "objects-and-linens"
    if edition_id == "ed-pontifical":
        if category in {"priestly-vestments", "deacon-and-subdeacon"}:
            return "pontifical-vesture"
        if category == "pontifical-and-prelatial":
            return "insignia"
        if category in {"church-and-sanctuary", "altar-and-appointments",
                        "books-and-printed-objects"}:
            return "furnishings-and-books"
        return "ministers-and-object-transfers"
    raise ContractError(f"{edition_id}: no dense-layout section router")


def section_label(section: str) -> str:
    if section == "servers-ministers-and-choir":
        return "Servers, ministers and choir"
    if section == "linens-and-textiles":
        # The comprehensive section also collects the sacred-vessel records.
        return "Vessels and linens"
    if section == "water-and-ablutions":
        return "Water and Communion vessels"
    return section.replace("-", " ").title()


def dense_edition_tex(
    chosen: list[dict], edition: dict, artwork_render_owners: dict[str, str]
) -> list[str]:
    """Render section-ordered comparison plates with bounded plan overrides.

    Records remain canonical and audience notes remain edition-selected; this
    function changes only their comparison grouping and page architecture.
    """
    edition = {**edition, "_source_note_numbers": {
        record["id"]: number for number, record in enumerate(chosen, 1)
    }}
    if edition["id"] == "ed-mc-trainer":
        section_order = [
            section
            for plan_edition, section in SECTION_PLATE_PLANS
            if plan_edition == edition["id"]
        ]
    else:
        section_order = [
            section for section in edition["section_order"]
            if section not in {
                "recognition-and-handling-key", "status-and-handling-key",
                "relational-symbol-key", "visual-and-status-key",
                "status-and-relationship-key", "terminal-apparatus",
            }
        ]
    if any(primary_category(record) == "servers-ministers-and-choir" for record in chosen):
        if "servers-ministers-and-choir" not in section_order:
            before = next((index for index, section in enumerate(section_order)
                           if section in {"special-masses-and-related-ceremonies", "special-ceremony-equipment",
                                          "historical-perspective", "ministers-and-object-transfers"}), len(section_order))
            section_order.insert(before, "servers-ministers-and-choir")
    grouped = {section: [] for section in section_order}
    for record in chosen:
        section = section_for(record, edition)
        require(section in grouped,
                f"{edition['id']}: record {record['id']} routed outside section_order: {section}")
        grouped[section].append(record)
    category_rank = {
        name: index for index, name in enumerate((
            "church-and-sanctuary", "altar-and-appointments", "sacred-vessels",
            "linens-and-textiles", "books-and-printed-objects", "service-objects",
            "incense", "priestly-vestments", "deacon-and-subdeacon",
            "pontifical-and-prelatial", "servers-ministers-and-choir", "requiem",
            "nuptial-and-ritual", "holy-week", "pontifical-mass-compositions",
            "related-ceremonies", "historical",
        ))
    }
    lines: list[str] = []
    for section in section_order:
        records = grouped[section]
        records.sort(key=lambda record: (
            category_rank.get(primary_category(record), 999),
            record.get("sort_name", record["preferred_english_name"]).casefold(),
            record["id"],
        ))
        plan = SECTION_PLATE_PLANS.get((edition["id"], section))
        if section == "servers-ministers-and-choir" and records:
            plan = (("paired-studies-v1", ("obj-cassock", "obj-surplice")),)
        if plan is None:
            plan_parts = []
            for offset in range(0, len(records), 6):
                chunk = records[offset:offset + 6]
                layout = {
                    2: "balanced-two-tall-v1",
                    3: "relationship-three-feature-v1",
                    4: "balanced-four-v1",
                }.get(len(chunk), "dense-six-v1")
                plan_parts.append(
                    (layout, tuple(record["id"] for record in chunk))
                )
            plan = tuple(plan_parts)
        else:
            planned_ids = [
                object_id
                for _, object_ids in plan
                for object_id in object_ids
            ]
            actual_ids = [record["id"] for record in records]
            require(
                len(planned_ids) == len(set(planned_ids)),
                f"{edition['id']} {section}: plate plan repeats an object",
            )
            require(
                set(planned_ids) == set(actual_ids),
                f"{edition['id']} {section}: plate plan must cover the selected "
                "section exactly; missing="
                f"{sorted(set(actual_ids) - set(planned_ids))}, extra="
                f"{sorted(set(planned_ids) - set(actual_ids))}",
            )
        records_by_id = {record["id"]: record for record in records}
        for plate_number, (layout, object_ids) in enumerate(plan, start=1):
            plate = [records_by_id[object_id] for object_id in object_ids]
            if "obj-pontifical-tunicle" in object_ids:
                require("obj-pontifical-dalmatic" in object_ids,
                        "the shared pontifical layer study must keep both entries on one plate")
            if layout in {"story-spread-v1", "story-tall-v1"}:
                require(
                    (
                        len(plate) == 4
                        if layout == "story-tall-v1"
                        else 1 <= len(plate) <= 5
                    ),
                    f"{edition['id']} {section}: {layout} has invalid arity",
                )
                lines.append(
                    (
                        "\\RSDStoryTallPlateStart"
                        if layout == "story-tall-v1"
                        else "\\RSDStoryPlateStart"
                    )
                    + f"{{{tex(section_label(section))}}}"
                    f"{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index == 0:
                        lines.append(
                            "\\RSDStoryTallHeroNext"
                            if layout == "story-tall-v1"
                            else "\\RSDStoryHeroNext"
                        )
                    elif index == 1:
                        lines.append(
                            "\\RSDStoryTallCompanionsStart"
                            if layout == "story-tall-v1"
                            else "\\RSDStoryCompanionsStart"
                        )
                    else:
                        lines.append(
                            "\\RSDStoryTallCompanionBreak"
                            if layout == "story-tall-v1"
                            else "\\RSDStoryCompanionBreak"
                        )
                    if layout == "story-tall-v1" and index > 0:
                        lines.append("\\RSDSpacedCardNext")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                if len(plate) > 1:
                    lines.append(
                        "\\RSDStoryTallCompanionsEnd"
                        if layout == "story-tall-v1"
                        else "\\RSDStoryCompanionsEnd"
                    )
                lines.append(
                    "\\RSDStoryTallPlateEnd"
                    if layout == "story-tall-v1"
                    else "\\RSDStoryPlateEnd"
                )
                continue
            if layout in {"balanced-four-v1", "balanced-four-filled-v1"}:
                require(
                    len(plate) == 4,
                    f"{edition['id']} {section}: {layout} must "
                    "contain exactly four objects",
                )
                lines.append(
                    f"\\RSDBalancedFourPlateStart"
                    f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index == 2:
                        lines.append(
                            "\\RSDBalancedFourFilledPlateRowBreak"
                            if layout == "balanced-four-filled-v1"
                            else "\\RSDBalancedFourPlateRowBreak"
                        )
                    elif index in {1, 3}:
                        lines.append("\\RSDBalancedFourPlateCellBreak")
                    if layout == "balanced-four-filled-v1":
                        lines.append("\\RSDQuadCardNext")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append(
                    "\\RSDBalancedFourFilledPlateEnd"
                    if layout == "balanced-four-filled-v1"
                    else "\\RSDBalancedFourPlateEnd"
                )
                continue
            if layout in {"balanced-three-v1", "balanced-three-tall-v1"}:
                require(
                    len(plate) == 3,
                    f"{edition['id']} {section}: {layout} must contain "
                    "exactly three objects",
                )
                lines.append(
                    (
                        "\\RSDBalancedThreeTallPlateStart"
                        if layout == "balanced-three-tall-v1"
                        else "\\RSDBalancedThreePlateStart"
                    )
                    + f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if layout == "balanced-three-tall-v1":
                        if index:
                            lines.append("\\RSDBalancedThreeTallPlateCellBreak")
                        lines.append("\\RSDTallCardNext")
                    elif index == 1:
                            lines.append("\\RSDBalancedThreePlateCellBreak")
                    elif index == 2:
                            lines.append("\\RSDBalancedThreePlateLastStart")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append(
                    "\\RSDBalancedThreeTallPlateEnd"
                    if layout == "balanced-three-tall-v1"
                    else "\\RSDBalancedThreePlateEnd"
                )
                continue
            if layout in {"balanced-two-tall-v1", "paired-studies-v1"}:
                require(
                    len(plate) == 2,
                    f"{edition['id']} {section}: balanced-two-tall-v1 must "
                    "contain exactly two objects",
                )
                lines.append(
                    f"\\RSDBalancedTwoTallPlateStart"
                    f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index:
                        lines.append("\\RSDBalancedTwoTallPlateCellBreak")
                    lines.append("\\RSDPairedCardNext" if layout == "paired-studies-v1" else "\\RSDTallCardNext")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append("\\RSDBalancedTwoTallPlateEnd")
                continue
            if layout == "relationship-three-feature-v1":
                require(
                    len(plate) == 3,
                    f"{edition['id']} {section}: "
                    "relationship-three-feature-v1 must contain exactly "
                    "three objects",
                )
                lines.append(
                    f"\\RSDRelationshipThreePlateStart"
                    f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                lines.append("\\RSDTallCardNext")
                lines.append(record_tex(plate[0], edition, artwork_render_owners))
                lines.append("\\RSDRelationshipThreePlateCellBreak")
                lines.append("\\RSDRelationshipCardNext")
                lines.append(record_tex(plate[1], edition, artwork_render_owners))
                lines.append("\\RSDRelationshipThreePlateRightBreak")
                lines.append("\\RSDRelationshipCardNext")
                lines.append(record_tex(plate[2], edition, artwork_render_owners))
                lines.append("\\RSDRelationshipThreePlateEnd")
                continue
            if layout == "dense-seven-v1":
                require(
                    len(plate) == 7,
                    f"{edition['id']} {section}: dense-seven-v1 must "
                    "contain exactly seven objects",
                )
                lines.append(
                    f"\\RSDDenseSevenPlateStart"
                    f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index == 4:
                        lines.append("\\RSDDenseSevenPlateRowBreak")
                    elif index in {1, 2, 3, 5, 6}:
                        lines.append("\\RSDDenseSevenPlateCellBreak")
                    lines.append("\\RSDSevenCardNext")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append("\\RSDDenseSevenPlateEnd")
                continue
            if layout == "heterodox-five-v1":
                require(
                    len(plate) == 5,
                    f"{edition['id']} {section}: heterodox-five-v1 must "
                    "contain exactly five objects",
                )
                lines.append(
                    f"\\RSDHeterodoxFivePlateStart"
                    f"{{{tex(section_label(section))}}}{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index == 3:
                        lines.append("\\RSDHeterodoxFivePlateRowBreak")
                    elif index in {1, 2, 4}:
                        lines.append("\\RSDHeterodoxFivePlateCellBreak")
                    lines.append(
                        "\\RSDWideCardNext"
                        if index >= 3
                        else "\\RSDDiagnosticCardNext"
                    )
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append("\\RSDHeterodoxFivePlateEnd")
                continue
            if layout == "dense-six-diagnostic-v1":
                require(
                    len(plate) == 6,
                    f"{edition['id']} {section}: dense-six-diagnostic-v1 "
                    "must contain exactly six objects",
                )
                lines.append(
                    f"\\RSDDensePlateStart{{{tex(section_label(section))}}}"
                    f"{{{plate_number}}}"
                )
                for index, record in enumerate(plate):
                    if index == 3:
                        lines.append("\\RSDDensePlateRowBreak")
                    elif index in {1, 2, 4, 5}:
                        lines.append("\\RSDDensePlateCellBreak")
                    lines.append("\\RSDDiagnosticCardNext")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                lines.append("\\RSDDensePlateEnd")
                continue
            require(
                layout == "dense-six-v1" and 1 <= len(plate) <= 6,
                f"{edition['id']} {section}: invalid plate layout {layout}",
            )
            lines.append(
                f"\\RSDDensePlateStart{{{tex(section_label(section))}}}"
                f"{{{plate_number}}}"
            )
            for index, record in enumerate(plate):
                if index == 3:
                    lines.append("\\RSDDensePlateRowBreak")
                elif index in {1, 2, 4, 5}:
                    lines.append("\\RSDDensePlateCellBreak")
                lines.append("\\RSDFieldCardNext")
                lines.append(record_tex(record, edition, artwork_render_owners))
            lines.append("\\RSDDensePlateEnd")
    return lines


def resolve_artwork_render_owners(records: dict[str, dict]) -> dict[str, str]:
    """Assign each shared asset to one canonical linking object.

    An explicit render_owner wins. Otherwise the first depicted object that
    actually links the artwork owns its generated rendering. This makes the
    declared depicts order a deterministic default without suppressing an
    artwork whose contextual depicted objects do not link it.
    """
    links: dict[str, set[str]] = {}
    definitions: dict[str, dict] = {}
    for object_id, record in records.items():
        for artwork in record["artwork"]:
            links.setdefault(artwork["id"], set()).add(object_id)
            definitions.setdefault(artwork["id"], artwork)
    owners: dict[str, str] = {}
    for artwork_id, artwork in definitions.items():
        linked = links[artwork_id]
        explicit = artwork.get("render_owner")
        if explicit is not None:
            require(
                explicit in linked,
                f"{artwork_id}: render_owner {explicit} must link the shared artwork",
            )
            owners[artwork_id] = explicit
            continue
        owners[artwork_id] = next(
            (object_id for object_id in artwork["depicts"] if object_id in linked),
            sorted(linked)[0],
        )
    return owners


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--schema", type=Path, required=True)
    parser.add_argument("--selections", type=Path, required=True)
    parser.add_argument("--artwork-manifest", type=Path, required=True)
    parser.add_argument("--records", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    with_examples(parser, EXAMPLES[""])
    args = parser.parse_args()
    try:
        schema, selections, manifest = load(args.schema), load(args.selections), load(args.artwork_manifest)
        # Production manifests use ``asset_files``; the small schema fixture
        # retains ``asset``.  Both carry the same dictionary-relative path.
        asset_files = {
            item["id"]: canonical_asset_path(item["path"])
            for item in manifest.get("asset_files", [])
        }
        manifest_artwork_assets = {
            item["id"]: canonical_asset_path(item["asset"])
            for item in manifest.get("artworks", [])
        }
        manifest_artwork_assets.update({
            item["id"]: asset_files[item["asset_file_id"]]
            for item in manifest.get("artwork_links", [])
            if item.get("asset_file_id") in asset_files
        })
        manifest_assets = set(asset_files.values()) | {
            canonical_asset_path(item["path"])
            for item in manifest.get("asset", [])
        }
        alpha_assets = canonical_alpha_assets(manifest)
        canonical = load_canonical_validator()
        validator = canonical.Validator(schema, selections)
        record_paths = canonical.discover([args.records])
        require(bool(record_paths), f"{args.records}: no object TOML files found")
        validator.validate(record_paths)
        if validator.problems:
            detail = "\n".join(
                str(problem)
                for problem in sorted(
                    validator.problems,
                    key=lambda problem: (str(problem.path), problem.field, problem.message),
                )
            )
            raise ContractError("canonical inventory validation failed:\n" + detail)
        records = {object_id: data for object_id, (_, data) in validator.records.items()}
        artwork_render_owners = resolve_artwork_render_owners(records)
        for object_id, record in records.items():
            for index, artwork in enumerate(record["artwork"]):
                require(
                    artwork["id"] in manifest_artwork_assets,
                    f"{object_id}: artwork[{index}] ID is absent from canonical artwork manifest: "
                    f"{artwork['id']}",
                )
                require(
                    canonical_asset_path(artwork["asset"])
                    == manifest_artwork_assets.get(artwork["id"]),
                    f"{object_id}: artwork[{index}] ID {artwork['id']} resolves to "
                    f"{artwork['asset']}, not exact canonical manifest path "
                    f"{manifest_artwork_assets.get(artwork['id'])}",
                )
        args.output.mkdir(parents=True, exist_ok=True)
        for edition in selections["editions"]:
            chosen = [
                record for record in records.values()
                if alpha_selected(record, edition, alpha_assets)
                and record["id"] not in PUBLIC_RENDER_HOLD_IDS
            ]
            chosen.sort(key=lambda item: (
                item.get("sort_name", item["preferred_english_name"]).casefold(),
                item["id"],
            ))
            body = [
                "% Generated deterministically; do not edit.",
                "% Canonical source-bounded alpha view.",
                f"% edition: {edition['id']}",
            ]
            body.extend(dense_edition_tex(chosen, edition, artwork_render_owners))
            body.extend(source_notes_tex(chosen, edition, REPOSITORY_ROOT))
            data = ("\n".join(body) + "\n").encode()
            (args.output / f"{edition['id']}.tex").write_bytes(data)
            if edition["id"] == "ed-altar-server":
                vestments = [
                    record for record in chosen
                    if primary_category(record)
                    in {"priestly-vestments", "deacon-and-subdeacon"}
                ]
                vestment_body = [
                    "% Generated deterministically; do not edit.",
                    "% Canonical altar-server sacred-minister vestment alpha slice.",
                    "% edition: ed-altar-server",
                    *dense_edition_tex(
                        vestments,
                        {**edition, "section_order": ["vestments-ministers-and-insignia"]},
                        artwork_render_owners,
                    ),
                ]
                (args.output / "ed-altar-server-vestments.tex").write_text(
                    "\n".join(vestment_body) + "\n", encoding="utf-8"
                )

            chosen_ids = {record["id"] for record in chosen}
            omitted = [
                record for record in records.values()
                if record["id"] not in chosen_ids
            ]
            omitted.sort(
                key=lambda item: (
                    item.get("sort_name", item["preferred_english_name"]).casefold(),
                    item["id"],
                )
            )
            omission_body = [
                "% Generated deterministically; do not edit.",
                "% Canonical alpha omission register.",
            ]
            omission_body.extend(
                "\\RSDAlphaOmission"
                f"{{{tex(record['id'])}}}"
                f"{{{tex(record['preferred_english_name'])}}}"
                f"{{{tex(alpha_omission_reason(record, edition, alpha_assets))}}}"
                for record in omitted
            )
            if not omitted:
                omission_body.append("\\RSDAlphaNoOmissions")
            (args.output / f"{edition['id']}.alpha-omissions.tex").write_text(
                "\n".join(omission_body) + "\n", encoding="utf-8"
            )
            admitted_assets = sorted({
                canonical_asset_path(artwork["asset"])
                for record in chosen
                for artwork in record["artwork"]
            })
            sidecar = [
                "schema_version = 1",
                f'edition_id = "{edition["id"]}"',
                'status = "alpha"',
                'distribution_state = "public-alpha"',
                'admission_rule = "identity and governing status resolved; source-audited or later; every rendered factual claim has a claim-verified binding; illustrated records have manifest identity, rights/provenance, and identity-checked or later visual state; explicitly text-only records have no publication artwork; the two exact-source lesson-book records use the audited TeX-native generic-book contract; unresolved and unverified-lead records excluded"',
                f"admitted_object_count = {len(chosen)}",
                f"omitted_object_count = {len(omitted)}",
                "admitted_object_ids = [",
                *(f'  "{record["id"]}",' for record in chosen),
                "]",
                "admitted_artwork_paths = [",
                *(f'  "{path}",' for path in admitted_assets),
                "]",
                "",
            ]
            (args.output / f"{edition['id']}.alpha-admissions.toml").write_text(
                "\n".join(sidecar), encoding="utf-8"
            )
        digest = hashlib.sha256(args.selections.read_bytes()).hexdigest()
        (args.output / "selection-input.sha256").write_text(digest + "\n", encoding="ascii")
    except (OSError, tomllib.TOMLDecodeError, ContractError, KeyError, TypeError) as error:
        print(f"dictionary generation error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
