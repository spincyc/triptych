#!/usr/bin/env python3
"""Cross-provider research staleness ledger (policy: guidance/staleness.md).

A paper's inputs are its own research records, sibling providers'
records for the same leaf, and the source records it binds; any change
flags every provider's edition. This tool owns only fingerprints,
cause reporting, and rebaselining — evaluation is provider work.
Subcommands: status, explain PROVIDER LEAF, rebaseline, bootstrap.
Ledger: src/sources/inventories/research-staleness-v1.toml.
"""

from __future__ import annotations

import argparse
import hashlib
import sys
import tomllib
from pathlib import Path
