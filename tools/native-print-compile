#!/usr/bin/env python3
"""Compile every admitted native print edition from its source bundle alone."""
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))
from _native_print_compile import main
from _tooling import Example

EXAMPLES = {
    "prepare": (
        Example("tools/native-print-compile prepare --out .scratch/example-native-print-compile/papal "
                "--only papal:papal.benedict-xv.hf-ben-xv-enc-01121918-quod-iam-diu/la",
                ('{"editions": 1, "engines": {"xetex": 1}, "scope": "selected", "status": "prepared"}',),
                "Writes one served XeTeX bundle's mounted tree; without --only it prepares every admitted edition."),
        Example("tools/native-print-compile prepare --out .scratch/example-native-print-compile/proper "
                "--only publication:gpt/liturgy/roman-rite/1962/propers/temporal/49-ninth-after-pentecost",
                ('{"editions": 1, "engines": {"pdftex": 1}, "scope": "selected", "status": "prepared"}',),
                "Writes one pdfTeX publication bundle, including its URL-delivered shared sources."),
    ),
    "compile": (
        Example("tools/native-print-compile compile --out .scratch/example-native-print-compile/papal",
                ('{"editions": 1, "engines": {"xetex": 1}, "failed": [], "passes": {"2": 1}, '
                 '"scope": "selected", "status": "pass"}',),
                "Writes receipts/ and summary.json beside the prepared tree; exits 1 when any edition fails."),
        Example("tools/native-print-compile compile --out .scratch/example-native-print-compile/proper",
                ('{"editions": 1, "engines": {"pdftex": 1}, "failed": [], "passes": {"2": 1}, '
                 '"scope": "selected", "status": "pass"}',),
                "Requires host pdfTeX and pdfinfo; the Pages gate runs the full set in the pinned TeX Live image."),
    ),
}

if __name__ == "__main__":
    raise SystemExit(main(examples=EXAMPLES))
