#!/usr/bin/env python3
"""Triptych Tool (`tpt`) launcher.

Usage:
  tpt <tool> [<tool args>...]
  tpt <workflow-id> <doc-id> {seed,advance,status,intervene,debt} [options]
  tpt workflow {list,show <id>}
  tpt --list [--json]
  tpt --info <tool> [--json]
  tpt --path <tool>
  tpt --check

Tool ids never begin with a dash, so the launcher's own options can never be
shadowed by a registry entry.  Workflow ids are checked after the tool
registry, so no existing tool can be shadowed; a startup check rejects any
workflow id that collides with a registered tool id.

`tpt` is the unified entrypoint for repo tools. It loads the tool registry
from ``tmt.json`` and dispatches to the implementation at ``tools/<tool>``.
Workflow dispatch is handled by ``scripts/_workflow.py``, keeping this
launcher thin.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
import textwrap
from pathlib import Path

SELF = Path(__file__).resolve()
ROOT = SELF.parents[1]
MANIFEST = ROOT / "tmt.json"
TOOLS = ROOT / "tools"
sys.path.insert(0, str(ROOT / "scripts"))

from _tooling import (  # noqa: E402
    _Folded,
    add_style_flags,
    resolve_style,
    GROUPS,
    GROUP_OF,
    MODEL,
    NETWORK,
    NOTHING,
    REACHES,
    REACH_LABEL,
    Example,
    with_examples,
)
from _workflow import WorkflowEngine, WorkflowError  # noqa: E402

WORKFLOWS_DIR = ROOT / "workflows"

# Captured transcripts, never composed; see scripts/_tooling.py.
#
# The listing's transcript stops one line earlier than it could: the next line
# names a sibling tool, and tmt reads a bare sibling id anywhere in a tool body
# as an undeclared dependency, so showing it fails `tmt check` with
#
#     FAIL tpt: uses sibling 'knox-bible' without declaring it in requires
#
# Where to cut is the author's, and `make recapture-examples` keeps it.
EXAMPLES = {
    "--list": (
        Example(
            "tools/tpt --list",
            (
                "acquisition:",
                "  Retrieval from outside the project. This is the only group that reaches",
                "  outside your machine at all, and no tool in any other group makes a network",
                "... 62 more lines",
            ),
        ),
        Example(
            "tools/tpt --list --json",
            (
                "[{\"group\": \"calendar\", \"mutates\": true, \"nam... [+9430 chars]",
            ),
            "one object a tool, each carrying the group its listing section came from",
        ),
    ),
    "--info": (
        Example(
            "tools/tpt --info tpt",
            (
                "name: tpt",
                "group: launcher",
                "reaches: nothing",
                "purpose: Unified launcher for Triptych tools and tool discovery commands.",
                "usage: tpt <tool> [<tool args>...] | tpt {--list,--info,--path,--check} [--json]",
                "path: <repo>/tools/tpt",
                "... 1 more line",
            ),
        ),
        Example(
            "tools/tpt --info tpt --json",
            (
                "{\"idempotent\": true, \"json\": true, \"lang\": \"python\", \"mutates\": false, \"name\": \"tpt\", \"origin\": \"local\", \"path... [+280 chars]",
            ),
        ),
    ),
    "--path": (
        Example(
            "tools/tpt --path tpt",
            (
                "<repo>/tools/tpt",
            ),
        ),
        Example(
            "tools/tpt --path no-such-tool",
            (
                "tpt: unknown tool: no-such-tool",
            ),
            "exit 2",
        ),
    ),
    "--check": (
        Example(
            "tools/tpt --check",
            (
                "registry ok: 35 tools",
            ),
        ),
        Example(
            "tools/tpt --check --json",
            (
                "registry ok: 35 tools",
            ),
            "--check reports in text either way; it is a gate, not a query",
        ),
    ),
    "<tool>": (
        Example(
            "tools/tpt tpt --path tpt",
            (
                "<repo>/tools/tpt",
            ),
            "anything after the tool id is that tool's own argv, untouched \u2014 here the launcher dispatching to itself",
        ),
        Example(
            "tools/tpt no-such-tool",
            (
                "tpt: unknown tool: no-such-tool",
                "... 1 more line",
            ),
            "exit 2; the elided line lists every registered id",
        ),
    ),
}


ToolRecord = dict[str, object]
Registry = dict[str, ToolRecord]


class ToolError(RuntimeError):
    """A registry or tool-resolution failure worth reporting as one line."""


def load_registry() -> Registry:
    try:
        manifest = json.loads(MANIFEST.read_text(encoding="utf-8"))
    except OSError as error:
        raise ToolError(f"cannot read {MANIFEST}: {error}") from error
    except ValueError as error:
        raise ToolError(f"{MANIFEST} is not valid JSON: {error}") from error
    tools = manifest.get("tools")
    if not isinstance(tools, dict):
        raise ToolError(f"{MANIFEST} is missing a tools map")
    registry: Registry = {}
    for name, entry in sorted(tools.items()):
        if not isinstance(entry, dict):
            raise ToolError(f"{name}: registry entry is not an object")
        registry[str(name)] = entry
    dashed = sorted(name for name in registry if name.startswith("-"))
    if dashed:
        raise ToolError(f"registry ids may not begin with a dash: {', '.join(dashed)}")
    return registry


def tool_record(registry: Registry, name: str) -> ToolRecord:
    try:
        return registry[name]
    except KeyError:
        raise ToolError(f"unknown tool: {name}") from None


def resolve_tool_path(name: str) -> Path:
    path = TOOLS / name
    if not path.is_file():
        raise ToolError(f"{name}: no implementation at {path}")
    if not os.access(path, os.X_OK):
        raise ToolError(f"{name}: implementation is not executable: {path}")
    return path


def list_tools(registry: Registry, *, as_json: bool) -> int:
    if as_json:
        payload = [
            {
                "group": GROUP_OF.get(name),
                "name": name,
                "purpose": record.get("purpose"),
                "reaches": REACHES.get(name),
                "usage": record.get("usage"),
                "mutates": record.get("mutates"),
            }
            for name, record in registry.items()
        ]
        print(json.dumps(payload, sort_keys=True, ensure_ascii=False))
        return 0
    if not registry:
        print("(no tools registered)")
        return 0
    width = max(len(name) for name in registry) + 2

    def row(name: str) -> None:
        reach = REACH_LABEL.get(REACHES.get(name, NOTHING), "")
        mark = f"  [{reach}]" if reach else ""
        print(f"  {name:{width}}{registry[name].get('purpose', '')}{mark}")

    first = True
    for group, note, names in GROUPS:
        present = [name for name in names if name in registry]
        if not present:
            continue
        if not first:
            print()
        first = False
        print(f"{group}:")
        for line in textwrap.wrap(note, width=78, initial_indent="  ",
                                  subsequent_indent="  "):
            print(line)
        for name in present:
            row(name)
    ungrouped = [name for name in registry if name not in GROUP_OF]
    if ungrouped:
        # Never silently drop a tool from the listing: a reader who cannot see
        # it cannot run it.
        print()
        print("ungrouped (add it to GROUPS in scripts/_tooling.py):")
        for name in ungrouped:
            row(name)
    # The question a reader asks before running anything unfamiliar is whether
    # it spends something outside their machine, so answer it for the whole
    # list rather than leaving it to be inferred from the absence of a mark.
    print()
    print(reach_summary(registry))
    return 0


def reach_summary(registry: Registry) -> str:
    """One sentence naming every tool that reaches outside, or saying none do."""
    outward = {
        kind: sorted(n for n in registry if REACHES.get(n) == kind)
        for kind in (NETWORK, MODEL)
    }
    parts = [
        f"{REACH_LABEL[kind]}: {', '.join(names)}"
        for kind, names in outward.items()
        if names
    ]
    if not parts:
        return "No registered tool reaches the network or calls a model."
    return (
        "; ".join(parts)
        + ". No other registered tool reaches the network or calls a model."
    )


def show_tool_info(registry: Registry, name: str, *, as_json: bool) -> int:
    record = tool_record(registry, name)
    path = resolve_tool_path(name)
    if as_json:
        print(json.dumps({**record, "name": name, "path": str(path)},
                         sort_keys=True, ensure_ascii=False))
        return 0
    print(f"name: {name}")
    print(f"group: {GROUP_OF.get(name, '(none)')}")
    print(f"reaches: {REACHES.get(name, '(undeclared)')}")
    for field in ("purpose", "usage"):
        if field in record:
            print(f"{field}: {record[field]}")
    print(f"path: {path}")
    if "requires" in record:
        requires = record["requires"]
        joined = ", ".join(requires) if isinstance(requires, list) else str(requires)
        print(f"requires: {joined or '(none)'}")
    return 0


def run_tool(registry: Registry, name: str, tool_args: list[str]) -> int:
    tool_record(registry, name)
    path = resolve_tool_path(name)
    # Tools are executable scripts run as subprocesses, so each keeps its own
    # interpreter state and argv.
    code = subprocess.run([str(path), *tool_args]).returncode
    # Translate a signal death into the conventional 128+N shell status.
    return 128 - code if code < 0 else code


# ---------------------------------------------------------------------------
# Workflow dispatch
# ---------------------------------------------------------------------------

def _workflow_engine() -> WorkflowEngine:
    """Build a workflow engine rooted at this repository."""
    return WorkflowEngine(ROOT, WORKFLOWS_DIR)


def _workflow_ids() -> set[str]:
    """Return the set of registered workflow ids."""
    try:
        engine = _workflow_engine()
        return {w["id"] for w in engine.list_workflows()}
    except Exception:
        return set()


def dispatch_workflow(workflow_id: str, rest: list[str]) -> int:
    """Dispatch a workflow command.

    The grammar is:
        tpt <workflow-id> <doc-id> {seed,advance,status,intervene,debt} [opts]
    """
    engine = _workflow_engine()

    if not rest:
        raise ToolError(
            f"workflow {workflow_id}: missing document id and action\n"
            f"usage: tpt {workflow_id} <doc-id> "
            f"{{seed,advance,status,intervene,debt}} [options]"
        )

    doc_id = rest[0]
    action_args = rest[1:]

    if not action_args:
        raise ToolError(
            f"workflow {workflow_id}: missing action\n"
            f"usage: tpt {workflow_id} {doc_id} "
            f"{{seed,advance,status,intervene,debt}} [options]"
        )

    action = action_args[0]
    opts = action_args[1:]

    if action == "seed":
        return _workflow_seed(engine, workflow_id, doc_id, opts)
    if action == "advance":
        return _workflow_advance(engine, doc_id, opts)
    if action == "status":
        return _workflow_status(engine, doc_id, opts)
    if action == "intervene":
        return _workflow_intervene(engine, doc_id, opts)
    if action == "debt":
        return _workflow_debt(engine, doc_id, opts)

    raise ToolError(
        f"unknown workflow action: {action}\n"
        f"actions: seed, advance, status, intervene, debt"
    )


def _workflow_seed(
    engine: WorkflowEngine, workflow_id: str, doc_id: str, opts: list[str]
) -> int:
    provider = "gpt"
    i = 0
    while i < len(opts):
        if opts[i] == "--provider" and i + 1 < len(opts):
            provider = opts[i + 1]
            i += 2
        else:
            raise ToolError(f"seed: unknown option: {opts[i]}")
    result = engine.seed(workflow_id, {"proper": doc_id, "provider": provider})
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_advance(engine: WorkflowEngine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("advance: missing run-id")
    run_id = opts[0]
    rest = opts[1:]
    result_path = None
    run_gate = False
    i = 0
    while i < len(rest):
        if rest[i] == "--result" and i + 1 < len(rest):
            result_path = rest[i + 1]
            i += 2
        elif rest[i] == "--run-gate":
            run_gate = True
            i += 1
        else:
            raise ToolError(f"advance: unknown option: {rest[i]}")
    result = engine.advance(run_id, result_path=result_path, run_gate=run_gate)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_status(engine: WorkflowEngine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("status: missing run-id")
    run_id = opts[0]
    result = engine.status(run_id)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_intervene(engine: WorkflowEngine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("intervene: missing run-id")
    run_id = opts[0]
    rest = opts[1:]
    text = None
    stage = None
    i = 0
    while i < len(rest):
        if rest[i] == "--text" and i + 1 < len(rest):
            text = rest[i + 1]
            i += 2
        elif rest[i] == "--stage" and i + 1 < len(rest):
            stage = rest[i + 1]
            i += 2
        else:
            raise ToolError(f"intervene: unknown option: {rest[i]}")
    if text is None:
        raise ToolError("intervene: --text is required")
    result = engine.intervene(run_id, text, stage=stage)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_debt(engine: WorkflowEngine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("debt: missing run-id")
    run_id = opts[0]
    result = engine.debt(run_id)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def dispatch_workflow_meta(rest: list[str]) -> int:
    """Handle `tpt workflow {list,show <id>}`."""
    engine = _workflow_engine()
    if not rest:
        raise ToolError(
            "workflow: missing subcommand\n"
            "usage: tpt workflow {list,show <id>}"
        )
    sub = rest[0]
    if sub == "list":
        workflows = engine.list_workflows()
        if not workflows:
            print("(no workflows registered)")
            return 0
        for w in workflows:
            print(f"  {w['id']:30s} v{w['version']}  {w['description']}")
        return 0
    if sub == "show":
        if len(rest) < 2:
            raise ToolError("workflow show: missing workflow id")
        try:
            data = engine.load_workflow(rest[1])
        except WorkflowError as error:
            print(f"tpt: {error}", file=sys.stderr)
            return 2
        print(json.dumps(data, sort_keys=True, indent=2))
        return 0
    raise ToolError(
        f"unknown workflow subcommand: {sub}\n"
        f"subcommands: list, show <id>"
    )


def check_groups(registry: Registry) -> list[str]:
    """The grouping table and the registry must name the same tools.

    tmt.json cannot carry the group itself, so nothing but this check keeps
    the two in step. A new tool that no group claims would otherwise appear
    only in a trailing "ungrouped" block that nobody reads.
    """
    problems: list[str] = []
    seen: dict[str, str] = {}
    for group, note, names in GROUPS:
        if not note.strip():
            problems.append(f"group {group}: has no note saying what it holds")
        for name in names:
            if name in seen:
                problems.append(
                    f"{name}: claimed by both {seen[name]!r} and {group!r}"
                )
            seen[name] = group
            if name not in registry:
                problems.append(f"{name}: grouped under {group!r} but not registered")
    for name in registry:
        if name not in seen:
            problems.append(
                f"{name}: registered but in no group "
                "(see GROUPS in scripts/_tooling.py)"
            )
    problems.extend(check_reaches(registry))
    return problems


def check_reaches(registry: Registry) -> list[str]:
    """Every registered tool must say whether it reaches outside the machine.

    Undeclared is not the same as `nothing`, and a reader deciding whether to
    run something cannot tell the two apart from a listing. The declaration's
    truth is checked against each tool's source in
    tools/tests/test_tool_registry.py; this only checks that one exists.
    """
    known = set(REACH_LABEL)
    problems = [
        f"{name}: undeclared reach (see REACHES in scripts/_tooling.py)"
        for name in registry
        if name not in REACHES
    ]
    problems += [
        f"{name}: reach {REACHES[name]!r} is not one of: {', '.join(sorted(known))}"
        for name in registry
        if name in REACHES and REACHES[name] not in known
    ]
    problems += [
        f"{name}: declares a reach but is not registered"
        for name in REACHES
        if name not in registry
    ]
    return problems


def check_registry(registry: Registry) -> int:
    """Registry and filesystem must agree; the launcher can say so itself."""
    problems: list[str] = []
    for name in registry:
        try:
            resolve_tool_path(name)
        except ToolError as error:
            problems.append(str(error))
    companions = (".md", ".test")
    for path in sorted(TOOLS.iterdir()):
        if not path.is_file() or path.name.endswith(companions):
            continue
        if path.name not in registry:
            problems.append(f"{path.name}: implementation has no registry entry")
    problems.extend(check_groups(registry))
    for problem in problems:
        print(f"tpt: {problem}", file=sys.stderr)
    if problems:
        return 1
    print(f"registry ok: {len(registry)} tools")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tpt",
        description="Triptych Tool launcher. Run a tool as `tpt <tool> [args]`.",
    )
    what = parser.add_mutually_exclusive_group(required=True)
    what.add_argument("--list", action="store_true", help="list registered tools")
    what.add_argument("--info", metavar="TOOL", help="show one tool's registry entry")
    what.add_argument("--path", metavar="TOOL", help="print a tool's executable path")
    what.add_argument("--check", action="store_true",
                      help="verify the registry matches the filesystem")
    parser.add_argument("--json", action="store_true", help="emit JSON output")
    # tpt's modes are options rather than subcommands, so there is no per-verb
    # help to hang examples on; they all belong here.
    return with_examples(
        parser,
        tuple(example for mode in EXAMPLES for example in EXAMPLES[mode]),
    )


def dispatch(registry: Registry, raw: list[str]) -> int:
    if raw and not raw[0].startswith("-"):
        if raw[0] in registry:
            return run_tool(registry, raw[0], raw[1:])
        # Workflow meta command: `tpt workflow {list,show <id>}`
        if raw[0] == "workflow":
            return dispatch_workflow_meta(raw[1:])
        # Workflow dispatch: `tpt <workflow-id> <doc-id> <action> [opts]`
        wf_ids = _workflow_ids()
        collisions = wf_ids & set(registry)
        if collisions:
            raise ToolError(
                f"workflow id collides with registered tool id: "
                f"{', '.join(sorted(collisions))}"
            )
        if raw[0] in wf_ids:
            return dispatch_workflow(raw[0], raw[1:])
        available = sorted(set(registry) | wf_ids | {"workflow"})
        raise ToolError(
            f"unknown tool or workflow: {raw[0]}\n"
            f"available: {', '.join(available)}"
        )

    parser = add_style_flags(build_parser())
    args = parser.parse_args(raw)
    # The launcher prints too — a group's prose, a tool's registry entry — and
    # is subject to the same terminal as everything it dispatches to. It does
    # not go through `run_verb_cli`, so it installs the fold itself; a tool run
    # THROUGH it inherits nothing from here, because it is a subprocess with
    # its own stdout and answers the same question for itself.
    style = resolve_style(args)
    if style.plain and not args.json:
        sys.stdout = _Folded(sys.stdout)
    if args.check:
        return check_registry(registry)
    if args.list:
        return list_tools(registry, as_json=args.json)
    if args.info:
        return show_tool_info(registry, args.info, as_json=args.json)
    tool_record(registry, args.path)
    print(resolve_tool_path(args.path))
    return 0


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    try:
        return dispatch(load_registry(), raw)
    except (ToolError, WorkflowError) as error:
        print(f"tpt: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
