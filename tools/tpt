# this module's import cost before it reaches the tool, and the engine costs
# 18ms of it --- it pulls `concurrent.futures`, which pulls `logging` --- for a
# dispatch that does not touch a workflow. Tool dispatch is the overwhelming
# majority of invocations, and the suite makes hundreds of them.
def _workflow_module():
    """The workflow engine module, imported on first use."""
    import _workflow  # noqa: PLC0415

    return _workflow


def _workflow_error() -> type[BaseException]:
    return _workflow_module().WorkflowError

