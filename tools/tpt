def _workflow_engine():
    """Build a workflow engine rooted at this repository."""
    return _workflow_module().WorkflowEngine(ROOT, WORKFLOWS_DIR)


def _workflow_ids() -> set[str]:
    """Return the set of registered workflow ids."""
    try:
        engine = _workflow_engine()
        return {w["id"] for w in engine.list_workflows()}
    except Exception:
        return set()


WORKFLOW_ACTIONS = ("seed", "advance", "status", "replay", "intervene", "debt")


def workflow_help(engine, workflow_id: str) -> str:
    """The help a workflow can give about itself, from its own definition."""
    workflow = engine.load_workflow(workflow_id)
    argument = workflow.get("document_argument") or "doc"
    schema = workflow.get("argument_schema", {}).get(argument, {})
    described = schema.get("description", "")
    example = ""
    if "e.g. " in described:
        example = described.split("e.g. ", 1)[1].rstrip(")").strip()
    lines = [
        f"tpt {workflow_id} \u2014 {workflow.get('description', '')} "
        f"(v{workflow['version']})",
        "",
        "usage:",
        f"  tpt {workflow_id} list [--json]",
        f"  tpt {workflow_id} <{argument}> seed [--provider <name>]",
        f"  tpt {workflow_id} <{argument}> advance <run-id> --result <path>",
        f"  tpt {workflow_id} <{argument}> advance <run-id> "
        f"--lane-result <lane>=<path> ...",
        f"  tpt {workflow_id} <{argument}> advance <run-id> --run-gate",
        f"  tpt {workflow_id} <{argument}> status <run-id>",
        f"  tpt {workflow_id} <{argument}> replay <run-id>",
        f"  tpt {workflow_id} <{argument}> intervene <run-id> --text <text> "
        f"[--stage <id>]",
        f"  tpt {workflow_id} <{argument}> debt <run-id>",
        "",
    ]
    if workflow.get("document_discovery"):
        documents = engine.list_documents(workflow)
        shown = example if example in documents else (
            documents[0] if documents else "")
        lines += [
            f"the {argument}:",
            f"  every one this workflow can run ({len(documents)}):"
            f"  tpt {workflow_id} list",
        ]
        if shown:
            lines += [
                f"  a full id:                     {shown}",
                f"  or any unique tail of one:     "
                f"{shown.rsplit('/', 1)[-1]}",
            ]
        lines.append("")
    elif example:
        lines += [f"the {argument}, for example:", f"  {example}", ""]
    lines += [
        "each command prints the exact next command to run. Follow them",
        "until the disposition is ACCEPTED or BLOCKED.",
    ]
    return "\n".join(lines)


def _workflow_list(engine, workflow_id: str,
                   opts: list[str]) -> int:
    """Print the document ids this workflow can be seeded for."""
    as_json = False
    for opt in opts:
        if opt == "--json":
            as_json = True
        else:
            raise ToolError(f"list: unknown option: {opt}")
    workflow = engine.load_workflow(workflow_id)
    documents = engine.list_documents(workflow)
    if as_json:
        print(json.dumps(documents, indent=2))
        return 0
    if not documents:
        print(f"(no {workflow.get('document_argument') or 'document'} found "
              f"for {workflow_id})")
        return 0
    for document in documents:
        print(document)
    return 0


def dispatch_workflow(workflow_id: str, rest: list[str]) -> int:
    """Dispatch a workflow command.

    The grammar is:
        tpt <workflow-id> list [--json]
        tpt <workflow-id> <doc-id> {seed,advance,status,replay,intervene,debt}
    """
    engine = _workflow_engine()
    usage = (
        f"usage: tpt {workflow_id} list [--json]\n"
        f"       tpt {workflow_id} <doc-id> "
        f"{{{','.join(WORKFLOW_ACTIONS)}}} [options]\n"
        f"       tpt {workflow_id} --help"
    )

    if not rest or rest[0] in ("--help", "-h", "help"):
        # Without this, `--help` was read as the document id and the run
        # failed for want of an action, which told the reader nothing.
        print(workflow_help(engine, workflow_id))
        return 0

    if rest[0] == "list":
        return _workflow_list(engine, workflow_id, rest[1:])

    doc_id = engine.resolve_document(
        engine.load_workflow(workflow_id), rest[0]
    )
    action_args = rest[1:]

    if not action_args:
        raise ToolError(
            f"workflow {workflow_id}: missing action for {doc_id}\n{usage}"
        )

    action = action_args[0]
    opts = action_args[1:]

    if action == "seed":
        return _workflow_seed(engine, workflow_id, doc_id, opts)
    if action == "advance":
        return _workflow_advance(engine, doc_id, opts)
    if action == "status":
        return _workflow_status(engine, doc_id, opts)
    if action == "replay":
        return _workflow_replay(engine, doc_id, opts)
    if action == "intervene":
        return _workflow_intervene(engine, doc_id, opts)
    if action == "debt":
        return _workflow_debt(engine, doc_id, opts)

    raise ToolError(
        f"unknown workflow action: {action}\n"
        f"actions: {', '.join(WORKFLOW_ACTIONS)}\n{usage}"
    )


def _workflow_seed(
    engine, workflow_id: str, doc_id: str, opts: list[str]
) -> int:
    provider = None
    i = 0
    while i < len(opts):
        if opts[i] == "--provider" and i + 1 < len(opts):
            provider = opts[i + 1]
            i += 2
        else:
            raise ToolError(f"seed: unknown option: {opts[i]}")
    workflow = engine.load_workflow(workflow_id)
    doc_arg = workflow.get("document_argument")
    if not doc_arg:
        raise ToolError(
            f"workflow {workflow_id} declares no document_argument; it cannot "
            f"be seeded from the command line"
        )
    # The workflow's own argument schema owns the defaults; passing one here
    # would let the launcher and the definition disagree about a run's inputs.
    args = {doc_arg: doc_id}
    if provider is not None:
        args["provider"] = provider
    sys.stdout.buffer.write(engine.seed_bytes(workflow_id, args))
    return 0


def _workflow_advance(engine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("advance: missing run-id")
    run_id = opts[0]
    rest = opts[1:]
    result_path = None
    run_gate = False
    # Lane submissions are kept in the order the flags were given only so a
    # duplicate can be reported. The engine reorders them into the workflow's
    # canonical lane order before anything reads them.
    lane_results: list[tuple[str, str]] = []
    i = 0
    while i < len(rest):
        if rest[i] == "--result" and i + 1 < len(rest):
            result_path = rest[i + 1]
            i += 2
        elif rest[i] == "--lane-result" and i + 1 < len(rest):
            lane_id, separator, lane_path = rest[i + 1].partition("=")
            if not separator or not lane_id or not lane_path:
                raise ToolError(
                    "advance: --lane-result takes <lane-id>=<path>"
                )
            lane_results.append((lane_id, lane_path))
            i += 2
        elif rest[i] == "--run-gate":
            run_gate = True
            i += 1
        else:
            raise ToolError(f"advance: unknown option: {rest[i]}")
    engine.verify_document(run_id, doc_id)
    result = engine.advance(
        run_id, result_path=result_path, run_gate=run_gate,
        lane_results=lane_results,
    )
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_status(engine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("status: missing run-id")
    run_id = opts[0]
    engine.verify_document(run_id, doc_id)
    result = engine.status(run_id)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_replay(engine, doc_id: str, opts: list[str]) -> int:
    """Recompile the current packet from state and report whether it matches."""
    if not opts:
        raise ToolError("replay: missing run-id")
    run_id = opts[0]
    engine.verify_document(run_id, doc_id)
    result = engine.replay(run_id)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0 if result.get("deterministic") is not False else 1


def _workflow_intervene(engine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("intervene: missing run-id")
    run_id = opts[0]
    engine.verify_document(run_id, doc_id)
    rest = opts[1:]
    text = None
    stage = None
    i = 0
    while i < len(rest):
        if rest[i] == "--text" and i + 1 < len(rest):
            text = rest[i + 1]
            i += 2
        elif rest[i] == "--stage" and i + 1 < len(rest):
            stage = rest[i + 1]
            i += 2
        else:
            raise ToolError(f"intervene: unknown option: {rest[i]}")
    if text is None:
        raise ToolError("intervene: --text is required")
    result = engine.intervene(run_id, text, stage=stage)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def _workflow_debt(engine, doc_id: str, opts: list[str]) -> int:
    if not opts:
        raise ToolError("debt: missing run-id")
    run_id = opts[0]
    engine.verify_document(run_id, doc_id)
    result = engine.debt(run_id)
    print(json.dumps(result, sort_keys=True, indent=2))
    return 0


def dispatch_workflow_meta(rest: list[str]) -> int:
    """Handle `tpt workflow {list,show <id>}`."""
    engine = _workflow_engine()
    if not rest:
        raise ToolError(
            "workflow: missing subcommand\n"
            "usage: tpt workflow {list,show <id>}"
        )
    sub = rest[0]
    if sub == "list":
        workflows = engine.list_workflows()
        if not workflows:
            print("(no workflows registered)")
            return 0
        for w in workflows:
            print(f"  {w['id']:30s} v{w['version']}  {w['description']}")
        return 0
    if sub == "show":
        if len(rest) < 2:
            raise ToolError("workflow show: missing workflow id")
        try:
            data = engine.load_workflow(rest[1])
        except _workflow_error() as error:
            print(f"tpt: {error}", file=sys.stderr)
            return 2
        print(json.dumps(data, sort_keys=True, indent=2))
        return 0
    raise ToolError(
        f"unknown workflow subcommand: {sub}\n"
        f"subcommands: list, show <id>"
    )


def check_groups(registry: Registry) -> list[str]:
    """The grouping table and the registry must name the same tools.

    tmt.json cannot carry the group itself, so nothing but this check keeps
    the two in step. A new tool that no group claims would otherwise appear
    only in a trailing "ungrouped" block that nobody reads.
    """
    problems: list[str] = []
    seen: dict[str, str] = {}
    for group, note, names in GROUPS:
        if not note.strip():
            problems.append(f"group {group}: has no note saying what it holds")
        for name in names:
            if name in seen:
                problems.append(
                    f"{name}: claimed by both {seen[name]!r} and {group!r}"
                )
            seen[name] = group
            if name not in registry:
                problems.append(f"{name}: grouped under {group!r} but not registered")
    for name in registry:
        if name not in seen:
            problems.append(
                f"{name}: registered but in no group "
                "(see GROUPS in scripts/_tooling.py)"
            )
    problems.extend(check_reaches(registry))
    return problems


def check_reaches(registry: Registry) -> list[str]:
    """Every registered tool must say whether it reaches outside the machine.

    Undeclared is not the same as `nothing`, and a reader deciding whether to
    run something cannot tell the two apart from a listing. The declaration's
    truth is checked against each tool's source in
    tools/tests/test_tool_registry.py; this only checks that one exists.
    """
    known = set(REACH_LABEL)
    problems = [
        f"{name}: undeclared reach (see REACHES in scripts/_tooling.py)"
        for name in registry
        if name not in REACHES
    ]
    problems += [
        f"{name}: reach {REACHES[name]!r} is not one of: {', '.join(sorted(known))}"
        for name in registry
        if name in REACHES and REACHES[name] not in known
    ]
    problems += [
        f"{name}: declares a reach but is not registered"
        for name in REACHES
        if name not in registry
    ]
    return problems


def check_registry(registry: Registry) -> int:
    """Registry and filesystem must agree; the launcher can say so itself."""
    problems: list[str] = []
    for name in registry:
        try:
            resolve_tool_path(name)
        except ToolError as error:
            problems.append(str(error))
    companions = (".md", ".test")
    for path in sorted(TOOLS.iterdir()):
        if not path.is_file() or path.name.endswith(companions):
            continue
        if path.name not in registry:
            problems.append(f"{path.name}: implementation has no registry entry")
    problems.extend(check_groups(registry))
    try:
        _workflow_engine().check_collisions(set(registry))
    except _workflow_error() as error:
        problems.append(str(error))
    for problem in problems:
        print(f"tpt: {problem}", file=sys.stderr)
    if problems:
        return 1
    print(f"registry ok: {len(registry)} tools")
    return 0


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="tpt",
        description="Triptych Tool launcher. Run a tool as `tpt <tool> [args]`.",
    )
    what = parser.add_mutually_exclusive_group(required=True)
    what.add_argument("--list", action="store_true", help="list registered tools")
    what.add_argument("--info", metavar="TOOL", help="show one tool's registry entry")
    what.add_argument("--path", metavar="TOOL", help="print a tool's executable path")
    what.add_argument("--check", action="store_true",
                      help="verify the registry matches the filesystem")
    parser.add_argument("--json", action="store_true", help="emit JSON output")
    # tpt's modes are options rather than subcommands, so there is no per-verb
    # help to hang examples on; they all belong here.
    return with_examples(
        parser,
        tuple(example for mode in EXAMPLES for example in EXAMPLES[mode]),
    )


def dispatch(registry: Registry, raw: list[str]) -> int:
    if raw and not raw[0].startswith("-"):
        # Checked before the registry lookup, not after: a workflow id equal to
        # a tool id would otherwise run the tool and leave the workflow
        # unreachable, with nothing said about it.
        _workflow_engine().check_collisions(set(registry))
        if raw[0] in registry:
            return run_tool(registry, raw[0], raw[1:])
        # Workflow meta command: `tpt workflow {list,show <id>}`
        if raw[0] == "workflow":
            return dispatch_workflow_meta(raw[1:])
        # Workflow dispatch: `tpt <workflow-id> <doc-id> <action> [opts]`
        wf_ids = _workflow_ids()
        if raw[0] in wf_ids:
            return dispatch_workflow(raw[0], raw[1:])
        available = sorted(set(registry) | wf_ids | {"workflow"})
        raise ToolError(
            f"unknown tool or workflow: {raw[0]}\n"
            f"available: {', '.join(available)}"
        )

    parser = add_style_flags(build_parser())
    args = parser.parse_args(raw)
    # The launcher prints too — a group's prose, a tool's registry entry — and
    # is subject to the same terminal as everything it dispatches to. It does
    # not go through `run_verb_cli`, so it installs the fold itself; a tool run
    # THROUGH it inherits nothing from here, because it is a subprocess with
    # its own stdout and answers the same question for itself.
    style = resolve_style(args)
    if style.plain and not args.json:
        sys.stdout = _Folded(sys.stdout)
    if args.check:
        return check_registry(registry)
    if args.list:
        return list_tools(registry, as_json=args.json)
    if args.info:
        return show_tool_info(registry, args.info, as_json=args.json)
    tool_record(registry, args.path)
    print(resolve_tool_path(args.path))
    return 0


def main(argv: list[str] | None = None) -> int:
    raw = list(sys.argv[1:] if argv is None else argv)
    try:
        return dispatch(load_registry(), raw)
    except ToolError as error:
        print(f"tpt: {error}", file=sys.stderr)
        return 2
    except Exception as error:  # noqa: BLE001 - narrowed on the next line
        # A workflow error is reported the same way, but the class is only
        # resolvable by importing the engine, and naming it in the `except`
        # tuple above would import it while any exception at all propagates ---
        # including the ones a tool dispatch raises, which is the path that
        # never wants the engine. So the engine is asked for only once
        # something has already gone wrong.
        if "_workflow" not in sys.modules or not isinstance(error, _workflow_error()):
            raise
        print(f"tpt: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
