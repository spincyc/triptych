        Example(
            "tools/snapshot-store hydrate --all undeclared-example.json --json",
            (
                "{\"error\": \"select explicit snapshot paths or --all\", \"status\": \"error\"}",
            ),
            "The same refusal as JSON; use --archive-dir for offline hydration or explicitly --fetch.",
        ),
    ),
}

if __name__ == "__main__":
    raise SystemExit(main(examples=EXAMPLES))
