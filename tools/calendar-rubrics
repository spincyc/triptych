class SourceError(ValueError):
    """A rubrics source that cannot be trusted to emit anything."""


# --------------------------------------------------------------- reading


def calendars(root: Path, only: str | None) -> list[str]:
    if not root.is_dir():
        raise SourceError(f"no calendar directory at {root}")
    found = sorted(p.name for p in root.iterdir() if (p / SOURCE_NAME).is_file())
    if only:
        if only not in found:
            raise SourceError(f"no calendar {only!r} with a {SOURCE_NAME} under {root}; have {found}")
        return [only]
    if not found:
        raise SourceError(f"no calendar with a {SOURCE_NAME} under {root}")
    return found


def load_masses(root: Path, name: str) -> dict[str, dict]:
    """The calendar's own mass index, which the rubrics classify.

    Read through `_calendars.load_document`, which is the same derivation
    the calendar-day and Proper assemblers read, so a rank or a kind is never
    restated beside the file that owns it.

    THE `effective=True` IS LOAD-BEARING AND WAS NOT ALWAYS HERE. A recension's
    `propers.yaml` states only its DEPARTURES, so a raw parse of it returns the
    five rows of `roman-pre-1955` rather than the 491 masses that recension
    actually serves. Rubrics read that way would classify five days and be
    silent about four hundred and eighty-six, while the browser served all of
    them --- a second way to resolve a day, disagreeing with the first, in the
    layer that decides which day wins. A calendar that declares no `text_from`
    is returned exactly as it sits on disk, so the two non-recension calendars
    read identically through this path.
    """
    path = root / name / "propers.yaml"
    document = _calendars.load_document(root, name, effective=True)
    if not isinstance(document, dict):
        raise SourceError(f"{path}: top level must be a mapping")
    masses: dict[str, dict] = {}
    for section, body in sorted((document.get("sections") or {}).items()):
        # The Commune Sanctorum is formularies, not days. A Common has no date,
        # no season and no rank, it never occurs and never competes, and the
        # rank and rubrics of a day that takes one are the day's own. Giving it
        # an assignment basis would put a celebration in the precedence table
        # that the calendar never keeps.
        if str((body or {}).get("kind") or section) == COMMON_KIND:
            continue
        for mass in (body or {}).get("masses") or []:
            if not isinstance(mass, dict) or not mass.get("key"):
                continue
            key = str(mass["key"])
            source_forms = mass.get("forms")
            if source_forms is None:
                source_forms = []
            if not isinstance(source_forms, list):
                raise SourceError(f"{path}: mass {key!r} forms must be a list")
            forms: list[dict[str, str]] = []
            form_ids: set[str] = set()
            form_names: set[str] = set()
            for position, form in enumerate(source_forms):
                if not isinstance(form, dict):
                    raise SourceError(f"{path}: mass {key!r} form {position} must be a mapping")
                form_id = form.get("id")
                form_name = form.get("name")
                if not isinstance(form_id, str) or not form_id:
                    raise SourceError(f"{path}: mass {key!r} form {position} carries no nonempty id")
                if not isinstance(form_name, str) or not form_name:
                    raise SourceError(f"{path}: mass {key!r} form {form_id!r} carries no nonempty name")
                if form_id in form_ids:
                    raise SourceError(f"{path}: mass {key!r} repeats form id {form_id!r}")
                if form_name in form_names:
                    raise SourceError(f"{path}: mass {key!r} repeats form name {form_name!r}")
                form_ids.add(form_id)
                form_names.add(form_name)
                forms.append({"id": form_id, "name": form_name})
            masses[key] = {
                "key": key,
                "name": mass.get("name"),
                "section": section,
                "kind": mass.get("kind") or section,
                "rank": mass.get("rank"),
                "season": mass.get("season"),
                "dated": bool(mass.get("date")),
                "forms": forms,
            }
    if not masses:
        raise SourceError(f"{path}: carries no masses")
    return masses


def all_formularies(root: Path, name: str) -> set[str]:
    """Every mass key the index carries, the Commons included.

    `load_masses` drops the Commune on purpose: a Common is a formulary and not
    a liturgical day, and giving it a row would put a celebration in the
    precedence table that the calendar never keeps. But a formulary is exactly
    what the Saturday Office's Mass and a mass choice point AT, so the check
    that those pointers resolve has to see the whole index.
    """
    path = root / name / "propers.yaml"
    document = _calendars.load_document(root, name, effective=True)
    if not isinstance(document, dict):
        raise SourceError(f"{path}: top level must be a mapping")
    return {
        str(mass["key"])
        for body in (document.get("sections") or {}).values()
        for mass in ((body or {}).get("masses") or [])
        if isinstance(mass, dict) and mass.get("key")
    }


def load_source(root: Path, name: str) -> dict:
    import yaml

    path = root / name / SOURCE_NAME
    document = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict):
        raise SourceError(f"{path}: top level must be a mapping")
    missing = [field for field in REQUIRED_TOP if field not in document]
    if missing:
        raise SourceError(f"{path}: missing {', '.join(missing)}")
    if document.get("schema") != SCHEMA:
        raise SourceError(f"{path}: schema is {document.get('schema')!r}, expected {SCHEMA!r}")
    if document.get("calendar") != name:
        raise SourceError(f"{path}: declares calendar {document.get('calendar')!r}, lives under {name!r}")
    return document


# --------------------------------------------------------------- validation


def latin_body_paths(value: object, prefix: str = "") -> list[str]:
    """Return every data path whose final mapping key is ``latin``."""
    found: list[str] = []
    if isinstance(value, dict):
        for key, child in value.items():
            path = f"{prefix}.{key}" if prefix else str(key)
            if key == "latin":
                found.append(path)
            found.extend(latin_body_paths(child, path))
    elif isinstance(value, list):
        for index, child in enumerate(value):
            found.extend(latin_body_paths(child, f"{prefix}[{index}]"))
    return found


def latin_path_has_container(document: dict, path: str) -> bool:
    """Whether a withheld path still points to an existing structural slot."""
    parts = path.split(".")
    if len(parts) < 2 or parts[-1] != "latin":
        return False
    value: object = document
    for part in parts[:-1]:
        matched = LATIN_PATH_PART.fullmatch(part)
        if not matched or not isinstance(value, dict) or matched["key"] not in value:
            return False
        value = value[matched["key"]]
        if matched["index"] is not None:
            if not isinstance(value, list):
                return False
            index = int(matched["index"])
            if index >= len(value):
                return False
            value = value[index]
    return isinstance(value, dict)


def check_latin_text_status(document: dict, where: str) -> list[str]:
    """Hold withheld wording out of both whole and path-scoped sources."""
    problems: list[str] = []
    status = document.get("latin_text_status")
    if not isinstance(status, dict):
        return [f"{where}: latin_text_status must be a mapping"]
    extra = sorted(set(status) - LATIN_TEXT_STATUS_FIELDS)
    if extra:
        problems.append(f"{where}: latin_text_status carries unknown fields {extra}")
    for field, expected in LATIN_TEXT_STATUS.items():
        if status.get(field) != expected:
            problems.append(
                f"{where}: latin_text_status.{field} is {status.get(field)!r}, "
                f"expected {expected!r}"
            )

    present = set(latin_body_paths(document))
    if "paths" not in status:
        for path in sorted(present):
            problems.append(f"{where}: withheld Latin body is present at {path}")
        return problems

    paths = status["paths"]
    if not isinstance(paths, list) or not paths:
        problems.append(f"{where}: latin_text_status.paths must be a nonempty list")
        return problems
    withheld: set[str] = set()
    for position, path in enumerate(paths):
        if not isinstance(path, str) or not path:
            problems.append(
                f"{where}: latin_text_status.paths[{position}] must be a nonempty string"
            )
            continue
        if path in withheld:
            problems.append(f"{where}: latin_text_status.paths repeats {path!r}")
            continue
        withheld.add(path)
        if not latin_path_has_container(document, path):
            problems.append(
                f"{where}: latin_text_status.paths entry {path!r} has no structural container"
            )
        if path in present:
            problems.append(f"{where}: withheld Latin body is present at {path}")
    return problems


def check_precedence(document: dict, where: str) -> list[str]:
    problems: list[str] = []
    table = document["precedence"]
    if not table.get("stated"):
        problems.append(f"{where}: precedence.stated is false; this file exists to state it")
    if not table.get("locus"):
        problems.append(f"{where}: the precedence table carries no locus")
    rows = table.get("rows") or []
    numbers = [row.get("row") for row in rows]
    if numbers != list(range(1, len(rows) + 1)):
        problems.append(f"{where}: the precedence rows are not 1..{len(rows)} in order")
    for row in rows:
        if not row.get("label"):
            problems.append(f"{where}: row {row.get('row')} carries no label")
    return problems


def check_bases(document: dict, where: str) -> tuple[dict[str, int], list[str]]:
    problems: list[str] = []
    rows = {row["row"] for row in document["precedence"]["rows"]}
    index: dict[str, int] = {}
    for position, basis in enumerate(document["bases"]):
        identifier = basis.get("id")
        if not identifier:
            problems.append(f"{where}: a basis at position {position} carries no id")
            continue
        if identifier in index:
            problems.append(f"{where}: two bases share the id {identifier!r}")
        index[identifier] = position
        if not basis.get("why"):
            problems.append(f"{where}: basis {identifier!r} says nothing about why")
        # A basis names a class of days, and the page prints that name where the
        # index has no formulary to name it. Falling back to `why` put a whole
        # sentence where a day's name belongs.
        if not basis.get("label"):
            problems.append(f"{where}: basis {identifier!r} carries no short label")
        row = basis.get("row")
        if row is None:
            # A basis with no row is one that never competes; it must say so,
            # because a competitor with no row would silently win or lose.
            if basis.get("competes") is not False and basis.get("nature") != "commemoration":
                problems.append(
                    f"{where}: basis {identifier!r} carries no row and does not declare `competes: false`"
                )
        elif row not in rows:
            problems.append(f"{where}: basis {identifier!r} names row {row}, which the table does not have")
        elif basis.get("locus") in (None, ""):
            problems.append(f"{where}: basis {identifier!r} carries a row and no locus")
    return index, problems


def matches(rule: dict, mass: dict) -> bool:
    if "keys" in rule and mass["key"] not in rule["keys"]:
        return False
    if "key_matches" in rule and not re.search(rule["key_matches"], mass["key"]):
        return False
    if "dated" in rule and bool(rule["dated"]) != mass["dated"]:
        return False
    for field in ("kind", "rank", "season"):
        if field in rule and str(rule[field]) != str(mass.get(field)):
            return False
    return True


def assign(document: dict, masses: dict[str, dict], where: str) -> tuple[dict[str, dict], list[str]]:
    """Map every mass to exactly one basis, in declared order, first match wins."""
    problems: list[str] = []
    rules = document["assignment"]
    known = {basis["id"] for basis in document["bases"]}
    for position, rule in enumerate(rules):
        if rule.get("basis") not in known:
            problems.append(f"{where}: assignment rule {position} names unknown basis {rule.get('basis')!r}")
        if not any(field in rule for field in PREDICATE_FIELDS):
            problems.append(f"{where}: assignment rule {position} has no predicate and would take everything")

    assigned: dict[str, dict] = {}
    used = [0] * len(rules)
    for key in sorted(masses):
        mass = masses[key]
        for position, rule in enumerate(rules):
            if matches(rule, mass):
                used[position] += 1
                assigned[key] = {
                    "basis": rule["basis"],
                    "forms": mass["forms"],
                    "name": mass["name"],
                    "rule": position,
                }
                break
        else:
            problems.append(
                f"{where}: {key} ({mass['kind']}, rank {mass['rank']!r}) matches no assignment rule"
            )
    for position, count in enumerate(used):
        if count == 0:
            rules_shown = {field: rules[position][field] for field in PREDICATE_FIELDS if field in rules[position]}
            problems.append(f"{where}: assignment rule {position} {rules_shown} matches nothing")
    return assigned, problems


def check_implied(document: dict, basis_index: dict[str, int], where: str) -> list[str]:
    problems: list[str] = []
    seen: set[str] = set()
    for entry in document.get("implied") or []:
        identifier = entry.get("id")
        if not identifier:
            problems.append(f"{where}: an implied-day rule carries no id")
            continue
        if identifier in seen:
            problems.append(f"{where}: two implied-day rules share the id {identifier!r}")
        seen.add(identifier)
        if entry.get("basis") not in basis_index:
            problems.append(f"{where}: implied rule {identifier!r} names unknown basis {entry.get('basis')!r}")
        if not entry.get("season") and not entry.get("on_anchor"):
            problems.append(f"{where}: implied rule {identifier!r} is bounded by neither a season nor an anchor")
        if not entry.get("label"):
            problems.append(f"{where}: implied rule {identifier!r} carries no label")
        if entry.get("certain") is None:
            problems.append(f"{where}: implied rule {identifier!r} does not say whether it is certain")
        if entry.get("certain") is False and not entry.get("unless"):
            problems.append(f"{where}: implied rule {identifier!r} is uncertain and does not say what it cannot exclude")
    office = document.get("saturday_office") or {}
    if office and not office.get("stated_only"):
        if office.get("basis") not in basis_index:
            problems.append(f"{where}: saturday_office names unknown basis {office.get('basis')!r}")
    return problems


def javascript_regex_problem(pattern: str) -> str | None:
    """Return why ``pattern`` cannot be consumed by JavaScript's ``RegExp``.

    Override patterns are emitted unchanged and compiled by the browser.  A
    Python ``re.compile`` check is therefore the wrong boundary: Python accepts
    comments, atomic groups and possessive quantifiers that JavaScript rejects.
    Ask Node for the exact consumer grammar when it is available.  Structure
    remains usable on a host without Node only for the explicit, portable key
    matcher subset above.
    """
    node = shutil.which("node")
    if node:
        try:
            finished = subprocess.run(
                [
                    node,
                    "-e",
                    (
                        "try { new RegExp(process.argv[1]); } "
                        "catch (error) { console.error(error.message); process.exit(1); }"
                    ),
                    pattern,
                ],
                capture_output=True,
                text=True,
                timeout=5,
                check=False,
            )
        except (OSError, ValueError, subprocess.TimeoutExpired) as error:
            return f"could not be checked by JavaScript's RegExp: {error}"
        if finished.returncode:
            detail = (finished.stderr or finished.stdout).strip()
            return "is not valid for JavaScript's RegExp" + (f": {detail}" if detail else "")
        return None
    if FALLBACK_OVERRIDE_PATTERN.fullmatch(pattern):
        return None
    return (
        "cannot be proved portable without node; use only anchored ASCII key "
        "literals, character classes such as \\d, and ordinary quantifiers"
    )


def check_overrides(document: dict, assigned: dict[str, dict], basis_index: dict[str, int],
                    where: str) -> list[str]:
    """Validate every override shape consumed by the browser model."""
    problems: list[str] = []
    entries = document.get("overrides") or []
    if not isinstance(entries, list):
        return [f"{where}: overrides must be a list of mappings"]
    for position, entry in enumerate(entries):
        if not isinstance(entry, dict):
            problems.append(f"{where}: override {position} must be a mapping")
            continue
        label = entry.get("id") if isinstance(entry.get("id"), str) and entry.get("id") else position
        if REDUCTION_OVERRIDE_ACTIONS.intersection(entry):
            fields = REDUCTION_OVERRIDE_FIELDS
        elif "yields_to" in entry:
            fields = YIELD_OVERRIDE_FIELDS
        elif "over_key_matches" in entry or "when_same_row" in entry:
            fields = COLLISION_OVERRIDE_FIELDS
        elif "stated_only" in entry:
            fields = STATED_OVERRIDE_FIELDS
        else:
            problems.append(f"{where}: override {label!r} has no recognized action")
            continue
        missing = sorted(fields - set(entry))
        extra = sorted(set(entry) - fields)
        if missing:
            problems.append(f"{where}: override {label!r} is missing fields {missing}")
        if extra:
            problems.append(f"{where}: override {label!r} carries unknown fields {extra}")
        boolean_fields = {"stated_only", "when_same_row"}
        for field in fields - boolean_fields:
            if field in entry and (not isinstance(entry[field], str) or not entry[field]):
                problems.append(
                    f"{where}: override {label!r} field {field!r} must be a nonempty string"
                )
        for field in fields & boolean_fields:
            if field in entry and not isinstance(entry[field], bool):
                problems.append(f"{where}: override {label!r} field {field!r} must be boolean")
        key = entry.get("key")
        if isinstance(key, str) and key and key not in assigned:
            problems.append(
                f"{where}: override {label!r} names mass {key!r}, which this "
                "calendar's index does not carry"
            )
        pattern = entry.get("over_key_matches")
        if isinstance(pattern, str) and pattern:
            regex_problem = javascript_regex_problem(pattern)
            if regex_problem:
                problems.append(
                    f"{where}: override {label!r} key pattern {regex_problem}"
                )
        source_basis = entry.get("when_with_basis")
        target_basis = entry.get("reduce_with_to_basis")
        for field, basis in (
            ("when_with_basis", source_basis),
            ("reduce_with_to_basis", target_basis),
        ):
            if isinstance(basis, str) and basis and basis not in basis_index:
                problems.append(
                    f"{where}: reduction override {label!r} field {field!r} names unknown basis {basis!r}"
                )
        if source_basis and source_basis == target_basis:
            problems.append(
                f"{where}: reduction override {label!r} cannot reduce basis {source_basis!r} to itself"
            )
        if (
            isinstance(key, str)
            and key in assigned
            and isinstance(source_basis, str)
            and source_basis
            and assigned[key].get("basis") != source_basis
        ):
            problems.append(
                f"{where}: reduction override {label!r} expects {key!r} to have basis "
                f"{source_basis!r}, found {assigned[key].get('basis')!r}"
            )
    return problems


def check_mass_choices(document: dict, masses: dict[str, dict], basis_index: dict[str, int],
                       where: str) -> list[str]:
    """A choice the rubrics create, as against a collision they do not resolve.

    The two are different claims and the page renders them differently, so the
    fields that keep them apart are required rather than optional. An entry that
    named no locus would be this repository asserting a permission out of
    nowhere, which is the precedence-invention failure wearing another hat.

    `default` is checked for presence, not truthiness: `default: null` is the
    positive statement that the rubric orders neither, and it must be paid for
    with `open_because`. An entry that simply omitted the key would be silence.
    """
    problems: list[str] = []
    seen: set[str] = set()
    office = ((document.get("saturday_office") or {}).get("mass") or {})
    office_forms = {str(form.get("mass")) for form in (office.get("forms") or [])}

    for form in office.get("forms") or []:
        key = form.get("mass")
        if key not in masses:
            problems.append(
                f"{where}: the Saturday Office's Mass names formulary {key!r}, which this "
                "calendar's index does not carry"
            )
        if not form.get("printed"):
            problems.append(
                f"{where}: the Saturday Office form {key!r} does not record the heading the "
                "Missal prints it under, which is the only evidence its window is the book's"
            )
    if office and not office.get("locus"):
        problems.append(f"{where}: the Saturday Office's Mass carries no locus")

    for entry in document.get("mass_choices") or []:
        identifier = entry.get("id")
        if not identifier:
            problems.append(f"{where}: a mass choice carries no id")
            continue
        if identifier in seen:
            problems.append(f"{where}: two mass choices share the id {identifier!r}")
        seen.add(identifier)
        for field in ("what", "locus", "why"):
            if not entry.get(field):
                problems.append(f"{where}: mass choice {identifier!r} carries no {field}")
        if "default" not in entry:
            problems.append(
                f"{where}: mass choice {identifier!r} does not say which option is ordinarily "
                "said; state `default: <option id>`, or `default: null` with `open_because` "
                "where the rubric orders neither"
            )
        elif entry.get("default") is None and not entry.get("open_because"):
            problems.append(
                f"{where}: mass choice {identifier!r} leaves the choice open and does not say "
                "why, so the page would present a preference-free selector with no reason"
            )
        basis = (entry.get("when") or {}).get("winner_basis")
        if basis is not None and basis not in basis_index:
            problems.append(f"{where}: mass choice {identifier!r} names unknown basis {basis!r}")
        held = (entry.get("when") or {}).get("with_candidate")
        if held is not None and held not in masses:
            problems.append(
                f"{where}: mass choice {identifier!r} requires mass {held!r}, which this "
                "calendar's index does not carry"
            )
        among = entry.get("among") or []
        if len(among) < 2:
            problems.append(
                f"{where}: mass choice {identifier!r} offers {len(among)} option(s); a choice "
                "needs two"
            )
        names = {option.get("id") for option in among}
        if entry.get("default") is not None and entry["default"] not in names:
            problems.append(
                f"{where}: mass choice {identifier!r} defaults to {entry['default']!r}, which "
                f"is not one of its options {sorted(str(n) for n in names)}"
            )
        for option in among:
            for field in ("id", "label", "locus", "why"):
                if not option.get(field):
                    problems.append(
                        f"{where}: an option of mass choice {identifier!r} carries no {field}"
                    )
            takes = option.get("takes")
            if takes == "office_mass":
                if not office_forms:
                    problems.append(
                        f"{where}: option {option.get('id')!r} of {identifier!r} takes the "
                        "Saturday Office's Mass, and no such Mass is declared"
                    )
            elif takes == "mass":
                if option.get("mass") not in masses:
                    problems.append(
                        f"{where}: option {option.get('id')!r} of {identifier!r} names mass "
                        f"{option.get('mass')!r}, which this calendar's index does not carry"
                    )
            else:
                problems.append(
                    f"{where}: option {option.get('id')!r} of {identifier!r} declares "
                    f"takes={takes!r}; it must be 'office_mass' or 'mass'"
                )
    return problems


def check_absences(document: dict, where: str) -> list[str]:
    problems: list[str] = []
    for entry in document.get("known_absences") or []:
        if not entry.get("what"):
            problems.append(f"{where}: a known absence names nothing")
        if not entry.get("match"):
            problems.append(f"{where}: the absence {entry.get('what')!r} carries no date match")
        if not entry.get("effect"):
            problems.append(f"{where}: the absence {entry.get('what')!r} does not say what it changes")
        if not entry.get("locus"):
            problems.append(f"{where}: the absence {entry.get('what')!r} carries no locus")
    return problems


def check_seats(document: dict, assigned: dict[str, dict], where: str) -> list[str]:
    problems: list[str] = []
    transfer = (document["impediment"].get("transfer") or {})
    for seat in transfer.get("proper_seats") or []:
        key = seat.get("key")
        if key not in assigned:
            problems.append(f"{where}: a proper seat names {key!r}, which the calendar does not carry")
        if not seat.get("locus"):
            problems.append(f"{where}: the proper seat for {key!r} carries no locus")
        if not seat.get("own_date"):
            problems.append(f"{where}: the proper seat for {key!r} does not say which date it moves from")
    if transfer.get("destination", {}).get("computed_here") and not transfer.get("destination", {}).get("rule"):
        problems.append(f"{where}: transfer claims to compute a destination and states no rule")
    return problems


# --------------------------------------------------------------- emission


def document_for(document: dict, assigned: dict[str, dict], basis_index: dict[str, int]) -> dict:
    """The browser's copy: the same rules, with basis ids resolved to positions."""
    out: dict[str, object] = {"advisory": ADVISORY, "guidance": GUIDANCE, "source_advisory": document["advisory"]}
    for field in EMITTED:
        if field == "advisory":
            continue
        if field == "keys":
            out["keys"] = {
                key: {
                    "basis": basis_index[row["basis"]],
                    "forms": row["forms"],
                    "name": row["name"],
                }
                for key, row in sorted(assigned.items())
            }
            continue
        if field == "implied":
            out["implied"] = [
                {**entry, "basis": basis_index[entry["basis"]]}
                for entry in (document.get("implied") or [])
            ]
            continue
        if field == "saturday_office":
            office = document.get("saturday_office")
            if office and office.get("basis"):
                office = {**office, "basis": basis_index[office["basis"]]}
            out["saturday_office"] = office
            continue
        if field == "assignment":
            # Emitted so a reader can see which rule classified a mass without
            # opening the source; the browser reads `keys` and never re-matches.
            out["assignment"] = document["assignment"]
            continue
        if field == "latin_text_status":
            # The source status also carries audit-only scope and path data.
            # The public structure needs only the typed nonpresence reason.
            status = document.get(field)
            if isinstance(status, dict) and isinstance(status.get("kind"), str):
                out[field] = {"kind": status["kind"]}
            continue
        if field in document:
            out[field] = document[field]
    return out


def serialise_json(payload: dict, *, indent: int | None) -> str:
    """Return the canonical bytes this projection writes for one JSON object."""
    return json.dumps(
        payload,
        ensure_ascii=False,
        sort_keys=True,
        indent=indent,
        separators=(",", ":") if indent is None else None,
    ) + "\n"


def write_json(path: Path, payload: dict, *, indent: int | None) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(serialise_json(payload, indent=indent), encoding="utf-8")


def index_document(built: list[dict]) -> dict:
    return {
        "advisory": ADVISORY,
        "calendars": [
            {
                "calendar": row["calendar"],
                "code": row["code"],
                "edition": row["edition"],
                "edition_short": row.get("edition_short"),
                "path": f"structure/rubrics/{row['calendar']}.json",
                "precedence_stated": True,
                "commemorates": bool((row.get("commemoration") or {}).get("exists", True)),
            }
            for row in built
        ],
        "guidance": GUIDANCE,
        "note": (
            "structure/calendar/*/<year>.json lists a date's candidates and states that it "
            "does not rank them. This layer states the ranking, once per calendar rather than "
            "once per day: the file count here grows with calendars and never with years."
        ),
        "schema": SCHEMA,
    }


def rubric_json_files(out: Path) -> set[Path]:
    """Immediate JSON files owned by the rubrics projection.

    The layer owns ``structure/rubrics/*.json`` and nothing below a nested
    directory.  Keeping that boundary explicit lets an unscoped structure pass
    retire orphaned calendar leaves without treating an unknown directory as
    disposable.
    """
    target = out / "structure" / "rubrics"
    if not target.is_dir():
        return set()
    return {
        path
        for path in target.glob("*.json")
        if path.is_file() or path.is_symlink()
    }


def expected_rubric_names(built: list[dict]) -> set[str]:
    return {"index.json", *(f"{payload['calendar']}.json" for payload in built)}


def merge_scoped_index(index: Path, expected: dict) -> dict:
    """Replace selected rows while retaining unrelated shared-index rows.

    Scoped structure has no authority to validate or repair another calendar,
    so even an incomplete unrelated row travels unchanged.  The complete
    structure pass remains responsible for projecting the full canonical
    index.
    """
    if not index.exists():
        return expected
    try:
        current = json.loads(index.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise ValueError(
            f"cannot preserve malformed shared rubrics index {index}: {error}"
        ) from error
    current_rows = current.get("calendars") if isinstance(current, dict) else None
    if not isinstance(current_rows, list):
        raise ValueError(f"shared rubrics index {index} must contain a calendars list")
    expected_rows = {
        str(row["calendar"]): row
        for row in expected["calendars"]
        if isinstance(row, dict) and row.get("calendar")
    }
    selected = set(expected_rows)
    merged: list[dict] = []
    seen: set[str] = set()
    for row in current_rows:
        if not isinstance(row, dict):
            raise ValueError("the shared rubrics index contains a non-mapping row")
        calendar = str(row.get("calendar") or "")
        if not calendar:
            raise ValueError("the shared rubrics index has a row with no calendar identity")
        if calendar in seen:
            raise ValueError(f"the shared rubrics index repeats {calendar}")
        seen.add(calendar)
        if calendar in selected:
            replacement = expected_rows.pop(calendar, None)
            if replacement is not None:
                merged.append(replacement)
            continue
        merged.append(row)
    merged.extend(expected_rows.values())
    return {**expected, "calendars": merged}


def refuse_symlink_output(root: Path, target: Path) -> None:
    """Never follow an owned output component outside the requested tree."""
    current = root
    if current.is_symlink():
        raise ValueError(f"output root is a symlink: {current}")
    for part in target.relative_to(root).parts:
        current = current / part
        if current.is_symlink():
            raise ValueError(f"rubrics output path is a symlink: {current}")


# --------------------------------------------------------------- the model


def run_model(payload: dict) -> dict:
    """Run the browser's own derivation over a batch of cases, under node.

    The harness is written here rather than kept as a file so that there is
    exactly one implementation of the derivation in the repository and nothing
    beside it that could disagree.
    """
    harness = (
        "const model = require(process.argv[1]);\n"
        "let raw = '';\n"
        "process.stdin.on('data', (chunk) => { raw += chunk; });\n"
        "process.stdin.on('end', () => {\n"
        "  const input = JSON.parse(raw);\n"
        "  const out = input.cases.map((one) => {\n"
        "    try {\n"
        "      return { id: one.id, ok: true,"
        " result: model.derive({ date: one.date, year: one.year, rubrics: one.rubrics }) };\n"
        "    } catch (error) {\n"
        "      return { id: one.id, ok: false, error: String(error && error.stack || error) };\n"
        "    }\n"
        "  });\n"
        "  process.stdout.write(JSON.stringify({ results: out }));\n"
        "});\n"
    )
    finished = subprocess.run(
        ["node", "-e", harness, str(MODEL)],
        input=json.dumps(payload),
        capture_output=True,
        text=True,
        check=False,
    )
    if finished.returncode != 0:
        raise SourceError(f"the derivation model failed under node: {finished.stderr.strip()[:800]}")
    return json.loads(finished.stdout)


def year_file(data_root: Path, calendar: str, civil_year: int) -> dict:
    path = data_root / "structure" / "calendar" / calendar / f"{civil_year}.json"
    if not path.is_file():
        raise SourceError(f"no day file at {path}; run `calendar-days structure` first")
    return json.loads(path.read_text(encoding="utf-8"))


def name_of(result: dict, key: str) -> str:
    for candidate in result.get("candidates") or []:
        if candidate.get("key") == key:
            return candidate.get("name") or key
    return key


# Everything a solved case may assert, listed rather than inferred -- the same
# discipline REQUIRED_TOP applies to the sources themselves. `compare_one` asked
# `if "<field>" in expect` against no list at all, so a case that misspelled
# every one of its field names asserted nothing whatever and still counted
# towards "15 of 15 verified": a field nobody checked read exactly like a field
# that passed. The value is the part of the model's own result each field reads,
# which is what lets `check` report the fields no case asserts.
EXPECTATIONS = {
    "arrived": "winner",
    "commemorated": "losers",
    "conditional_on_implied": "conditions",
    # The formulary the day takes, which is not always the day. A feria borrows
    # the preceding Sunday's Mass under RGMR 299 and the Office of Our Lady on
    # Saturday has one of its own; asserting only the winner would pass whether
    # the right Mass or the wrong one was served under it.
    "formulary": "winner",
    "mass_choices": "massChoices",
    "omitted": "losers",
    # What a reader may be shown on the date, and under which standing. This is
    # the one field that guards against a displaced Mass being offered as
    # though it were the day's, so a case that cares about the Triduum asserts
    # it rather than the winner alone.
    "readable": "readable",
    "orations": "orations",
    "orations_low_mass": "orations",
    "orations_sung_non_conventual": "orations",
    "reduced": "losers",
    "settled": "settled",
    "transferred": "losers",
    "winner": "winner",
    "winner_row": "winner",
}

# What a case carries besides its expectations: what it is, where it was read
# from, and the date it is worked on. Anything else is a typo, not a note.
CASE_FIELDS = ("id", "source", "date", "why")
EXPECT_BLOCKS = ("expect", "expect_by_option")


def compare(case: dict, result: dict, where: str) -> list[str]:
    """One solved case against what the model actually derived."""
    problems: list[str] = []
    identifier = f"{where}: {case.get('id') or '<no id>'}"

    unknown = sorted(set(case) - set(CASE_FIELDS) - set(EXPECT_BLOCKS))
    if unknown:
        problems.append(
            f"{identifier}: carries unknown field(s) {unknown}; a solved case carries "
            f"{sorted(CASE_FIELDS)} and one of {sorted(EXPECT_BLOCKS)}"
        )
    held = [block for block in EXPECT_BLOCKS if block in case]
    if len(held) != 1:
        problems.append(
            f"{identifier}: carries {held or 'neither'} of {sorted(EXPECT_BLOCKS)}; a case "
            "must carry exactly one, or it rules on nothing"
        )
        return problems

    if "expect_by_option" in case:
        by_option = case["expect_by_option"] or {}
        if not by_option:
            problems.append(f"{identifier}: expect_by_option is empty, so the case asserts nothing")
            return problems
        derived = {row.get("option"): row for row in result["options"]}
        for option, expect in by_option.items():
            if option not in derived:
                problems.append(f"{identifier}: the model derived no branch for option {option!r}")
                continue
            problems.extend(compare_one(f"{identifier} [{option}]", expect, derived[option]))
        return problems

    options = result["options"]
    if len(options) != 1:
        problems.append(f"{identifier}: expected one derivation, the model returned {len(options)}")
        return problems
    problems.extend(compare_one(identifier, case["expect"], options[0]))
    return problems


def asserted_fields(case: dict) -> set[str]:
    """Which parts of the model's result this case actually rules on."""
    blocks = [case["expect"]] if "expect" in case else list((case.get("expect_by_option") or {}).values())
    return {EXPECTATIONS[field] for block in blocks for field in (block or {}) if field in EXPECTATIONS}


def compare_one(identifier: str, expect: dict, derived: dict) -> list[str]:
    problems: list[str] = []
    # Before any comparison: a field this does not know how to check is a
    # misspelling, and skipping it silently is how a case stops asserting the
    # very thing it was written to assert.
    expect = expect or {}
    unknown = sorted(set(expect) - set(EXPECTATIONS))
    if unknown:
        problems.append(
            f"{identifier}: asserts unknown field(s) {unknown}; a solved case may assert "
            f"{sorted(EXPECTATIONS)}"
        )
    elif not expect:
        problems.append(f"{identifier}: asserts nothing")
    winner = derived.get("winner")
    got_winner = winner.get("id") if winner else None
    if "winner" in expect and got_winner != expect["winner"]:
        problems.append(f"{identifier}: winner is {got_winner!r}, expected {expect['winner']!r}")
    if "winner_row" in expect and winner and winner.get("row") != expect["winner_row"]:
        problems.append(f"{identifier}: winner sits at row {winner.get('row')}, expected {expect['winner_row']}")
    if "arrived" in expect and winner and (winner.get("source") == "arrived") != expect["arrived"]:
        problems.append(f"{identifier}: winner source is {winner.get('source')!r}, expected an arrival")
    if "settled" in expect and bool(derived.get("settled")) != bool(expect["settled"]):
        problems.append(
            f"{identifier}: settled is {derived.get('settled')}, expected {expect['settled']}"
            + (f" ({'; '.join(row['why'] for row in derived.get('unsettled') or [])})" if derived.get("unsettled") else "")
        )
    by_disposition: dict[str, list[str]] = {}
    for loser in derived.get("losers") or []:
        by_disposition.setdefault(loser["disposition"], []).append(loser["id"])
    for field, disposition in (
        ("commemorated", "commemorated"),
        ("omitted", "omitted"),
        ("transferred", "transferred"),
        ("reduced", "reduced"),
    ):
        if field not in expect:
            continue
        got = sorted(by_disposition.get(disposition, []))
        if got != sorted(expect[field]):
            problems.append(f"{identifier}: {disposition} is {got}, expected {sorted(expect[field])}")
    orations = derived.get("orations") or {}
    for field, series in (
        ("orations_low_mass", "low_mass"),
        ("orations_sung_non_conventual", "sung_non_conventual"),
        ("orations", "all"),
    ):
        if field not in expect:
            continue
        got = orations.get(series)
        if got is None:
            problems.append(f"{identifier}: the model derived no {series} orations")
        elif len(got) != expect[field]:
            labels = ", ".join(row.get("of_name") or row.get("of") or "?" for row in got)
            problems.append(f"{identifier}: {series} has {len(got)} orations ({labels}), expected {expect[field]}")
    if "formulary" in expect:
        held = (winner or {}).get("formulary") or {}
        got = held.get("key")
        if got != expect["formulary"]:
            problems.append(
                f"{identifier}: the day takes formulary {got!r}, expected "
                f"{expect['formulary']!r}"
            )
    if "mass_choices" in expect:
        # Asserted as {choice id: [option ids]}, because a choice whose second
        # arm silently stopped resolving would still be a choice by its id alone
        # and the selector would have quietly become a label.
        derived_choices = {
            row["id"]: sorted(one["id"] for one in row.get("among") or [])
            for row in derived.get("massChoices") or []
        }
        wanted = {key: sorted(value) for key, value in (expect["mass_choices"] or {}).items()}
        if derived_choices != wanted:
            problems.append(
                f"{identifier}: mass choices are {derived_choices}, expected {wanted}"
            )
    if "readable" in expect:
        # Asserted as {standing: [mass keys]}. The standing is the assertion:
        # `chrism-mass` appearing at all is not the claim, `chrism-mass`
        # appearing as `additional` and never as `said` is.
        by_state: dict[str, list[str]] = {}
        for row in derived.get("readable") or []:
            by_state.setdefault(row["state"], []).append(row["key"])
        got = {state: sorted(keys) for state, keys in by_state.items()}
        wanted = {state: sorted(keys) for state, keys in (expect["readable"] or {}).items()}
        if got != wanted:
            problems.append(f"{identifier}: readable is {got}, expected {wanted}")
    if "conditional_on_implied" in expect:
        conditions = [row.get("id") for row in derived.get("conditions") or []]
        if expect["conditional_on_implied"] not in conditions:
            problems.append(
                f"{identifier}: expected the result to depend on implied rule "
                f"{expect['conditional_on_implied']!r}; conditions are {conditions}"
            )
    return problems


# --------------------------------------------------------------- verbs


def build(root: Path, only: str | None) -> tuple[list[dict], list[str], dict[str, dict]]:
    problems: list[str] = []
    built: list[dict] = []
    sources: dict[str, dict] = {}
    for name in calendars(root, only):
        where = f"{name}/{SOURCE_NAME}"
        document = load_source(root, name)
        masses = load_masses(root, name)
        problems.extend(check_latin_text_status(document, where))
        problems.extend(check_precedence(document, where))
        basis_index, found = check_bases(document, where)
        problems.extend(found)
        assigned, found = assign(document, masses, where)
        problems.extend(found)
        problems.extend(check_implied(document, basis_index, where))
        problems.extend(check_overrides(document, assigned, basis_index, where))
        problems.extend(check_seats(document, assigned, where))
        problems.extend(check_absences(document, where))
        problems.extend(
            check_mass_choices(document, all_formularies(root, name), basis_index, where)
        )
        for key, row in assigned.items():
            if row["name"] != masses[key]["name"]:
                problems.append(f"{where}: the name recorded for {key} disagrees with the calendar index")
        # The book this calendar's masses are printed in, taken from the mass
        # index that identifies it and not restated in this source. Both names
        # travel the same way: `edition` for the record, `edition_short` for the
        # control that has room for one line.
        for field in _calendars.INDEX_OWNED:
            document[field] = _calendars.index_header(root, name, field)
        if not document.get("edition"):
            problems.append(
                f"{where}: {name}/{_calendars.MASS_INDEX} declares no edition, so there "
                "is no book to name; this file derives it and states none of its own"
            )
        problems.extend(_calendars.restated_identity(root, name))
        sources[name] = document
        built.append(document_for(document, assigned, basis_index))
    return built, problems, sources


def run_structure(arguments: argparse.Namespace) -> dict:
    built, problems, _ = build(Path(arguments.root), arguments.calendar)
    if problems:
        raise SourceError("; ".join(problems[:4]) + (f" (and {len(problems) - 4} more)" if len(problems) > 4 else ""))
    out = Path(arguments.out)
    base = out / "structure" / "rubrics"
    index = base / "index.json"
    refuse_symlink_output(out, base)
    for payload in built:
        refuse_symlink_output(out, base / f"{payload['calendar']}.json")
    refuse_symlink_output(out, index)
    index_payload = index_document(built)
    if arguments.calendar:
        # Preserve the shared manifest before writing any selected leaf. A
        # malformed existing manifest must leave the output tree untouched.
        index_payload = merge_scoped_index(index, index_payload)
    written: list[str] = []
    for payload in built:
        path = out / "structure" / "rubrics" / f"{payload['calendar']}.json"
        write_json(path, payload, indent=None)
        written.append(str(path))
    write_json(index, index_payload, indent=1)
    written.append(str(index))
    if not arguments.calendar:
        expected = expected_rubric_names(built)
        for path in sorted(rubric_json_files(out)):
            if path.name not in expected:
                path.unlink()
    return {
        "files": len(written),
        "status": "ok",
        "written": written if arguments.verbose else written[-1:],
    }


def run_check(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    data = Path(arguments.out)
    built, problems, sources = build(root, arguments.calendar)

    # The written layer must be what the source would write now, or a page is
    # serving a rule the repository has already changed.
    stale: list[str] = []
    for payload in built:
        path = data / "structure" / "rubrics" / f"{payload['calendar']}.json"
        if not path.is_file():
            stale.append(f"{path} has not been written")
            continue
        try:
            current = path.read_bytes()
        except OSError:
            current = b""
        if current != serialise_json(payload, indent=None).encode("utf-8"):
            stale.append(f"{path} is stale; run `calendar-rubrics structure`")
    index = data / "structure" / "rubrics" / "index.json"
    if index.is_file():
        expected_index = index_document(built)
        try:
            current_index = index.read_bytes()
        except OSError:
            current_index = b""
        index_current = False
        if arguments.calendar:
            try:
                written_index = json.loads(current_index)
            except (UnicodeError, json.JSONDecodeError):
                written_index = None
            if isinstance(written_index, dict) and isinstance(
                written_index.get("calendars"), list
            ):
                selected = {payload["calendar"] for payload in built}
                written_index = {
                    **written_index,
                    "calendars": [
                        row
                        for row in written_index["calendars"]
                        if isinstance(row, dict) and row.get("calendar") in selected
                    ],
                }
                index_current = written_index == expected_index
        else:
            index_current = current_index == serialise_json(
                expected_index, indent=1
            ).encode("utf-8")
        if not index_current:
            stale.append(f"{index} is stale; run `calendar-rubrics structure`")
    elif built:
        stale.append(f"{index} has not been written")
    if not arguments.calendar:
        expected = expected_rubric_names(built)
        for path in sorted(rubric_json_files(data)):
            if path.name not in expected:
                stale.append(
                    f"{path} is extra; run `calendar-rubrics structure` to remove it"
                )
    problems.extend(stale)

    cases: list[dict] = []
    for payload in built:
        name = payload["calendar"]
        for case in sources[name]["worked_cases"]:
            civil_year = int(str(case["date"])[:4])
            try:
                year = year_file(data, name, civil_year)
            except SourceError as error:
                problems.append(f"{name}: {case['id']}: {error}")
                continue
            cases.append({"id": f"{name}/{case['id']}", "date": case["date"], "year": year, "rubrics": payload,
                          "case": case, "calendar": name})

    # A gate that cannot run is not a gate that passed. These three were skips
    # that still returned `status: ok`, so deleting the model, or running on a
    # host without node, printed a green line over a derivation nobody had
    # exercised -- the failure of TASK-110 exactly, where "0 stale bindings" was
    # printed over twenty-one real ones. There is deliberately no opt-out flag:
    # an environment genuinely without node can decline to run this check, but
    # nothing may run it and be told it passed.
    verified = 0
    asserted: set[str] = set()
    returned: set[str] = set()
    if not cases:
        problems.append(
            "no solved case could be prepared, so the browser's model was not exercised at all; "
            "the solved cases are the only thing holding it to the tracked rubrics"
        )
    elif not MODEL.is_file():
        problems.append(
            f"{MODEL.relative_to(ROOT)} is absent, so the model the solved cases exist to "
            "hold could not be run"
        )
    elif not shutil.which("node"):
        problems.append(
            "node is not installed, so the derivation was not exercised; install node "
            "(the solved cases replay the browser's own model and nothing else does)"
        )
    else:
        answered = run_model({"cases": [{k: v for k, v in row.items() if k in ("id", "date", "year", "rubrics")}
                                        for row in cases]})
        by_id = {row["id"]: row for row in answered["results"]}
        for row in cases:
            got = by_id.get(row["id"])
            if got is None:
                problems.append(f"{row['id']}: the model returned nothing")
                continue
            if not got.get("ok"):
                problems.append(f"{row['id']}: the model raised {got.get('error', '')[:300]}")
                continue
            asserted |= asserted_fields(row["case"])
            for branch in got["result"].get("options") or []:
                returned.update(branch)
            found = compare(row["case"], got["result"], row["calendar"])
            problems.extend(found)
            if not found:
                verified += 1

    if problems:
        head = "; ".join(problems[:5])
        raise SourceError(head + (f" (and {len(problems) - 5} more)" if len(problems) > 5 else ""))
    return {
        "calendars": [
            {
                "calendar": payload["calendar"],
                "bases": len(payload["bases"]),
                "rows": len(payload["precedence"]["rows"]),
                "masses_classified": len(payload["keys"]),
                "implied_rules": len(payload.get("implied") or []),
                "unsettled": len(payload.get("unsettled") or []),
            }
            for payload in built
        ],
        # `unasserted` is reported and not failed. A solved case is a ruling
        # taken from a worked example in the collated publications, and it rules
        # on one question; requiring every case to assert all seventeen fields
        # the model returns would turn a ruling into a snapshot of the current
        # implementation, and the first honest refactor of an unruled field
        # would fail this gate for a reason no book decides. But a field no case
        # has ever asserted is exactly where the model can drift unopposed, so
        # the list is printed on every run rather than left to be discovered.
        "solved_cases": {
            "declared": len(cases),
            "verified": verified,
            "asserted": sorted(asserted),
            "unasserted": sorted(returned - asserted),
        },
        "status": "ok",
    }


def run_day(arguments: argparse.Namespace) -> dict:
    """Derive one date, through the browser's own model. A reading verb.

    This exists so that there is ONE answer to "what Mass is said today" in this
    repository rather than two. The terminal reader used to compose the
    arithmetic layer, which refuses to rank by design, and then reported every
    candidate under the heading "no precedence is stated" — which stopped being
    true the moment these rubrics sources landed. On Easter Sunday 2026 it
    offered Easter Sunday and a third-class confessor as equal candidates, and
    on Maundy Thursday it led with the Chrism Mass. Both are settled here, and
    were.

    The fix is deliberately NOT a Python re-implementation of the ranking. That
    would make three answers where there were two. This runs `assembly-model.js`
    under node — the same file, through the same harness the solved cases use —
    so the terminal and the page agree by construction and not by coincidence.
    """
    data = Path(arguments.out)
    problems: list[str] = []
    # Read from the emitted layer, not rebuilt from the YAML sources. `build`
    # parses both calendars' mass indexes — a megabyte of YAML — to answer one
    # date, which cost 2.7 of the 7.4 seconds a single `mass-today` took. The
    # emitted file is byte-for-byte what `build` would produce and is exactly
    # what the browser consumes, so reading it is the same derivation over the
    # same input. Whether it is CURRENT is `check`'s question and it fails on a
    # stale one; a reading verb that re-validated the whole corpus on every
    # lookup would be answering a question nobody asked.
    built = []
    for name in calendars(Path(arguments.root), arguments.calendar):
        path = data / "structure" / "rubrics" / f"{name}.json"
        if not path.is_file():
            problems.append(f"no rubrics file at {path}; run `calendar-rubrics structure` first")
            continue
        built.append(json.loads(path.read_text(encoding="utf-8")))
    if not built:
        raise SourceError("; ".join(problems) or "no calendar has an emitted rubrics file")
    if not MODEL.is_file():
        raise SourceError(f"{MODEL.relative_to(ROOT)} is absent, so nothing can be derived")
    if not shutil.which("node"):
        raise SourceError("node is not installed, so the derivation cannot be run")

    date = str(arguments.date)
    civil_year = int(date[:4])
    cases = []
    for payload in built:
        name = payload["calendar"]
        try:
            year = year_file(data, name, civil_year)
        except SourceError as error:
            problems.append(f"{name}: {error}")
            continue
        cases.append({"id": name, "date": date, "year": year, "rubrics": payload})
    if not cases:
        raise SourceError("; ".join(problems) or f"no calendar carries a year file for {civil_year}")

    answered = run_model({"cases": cases})
    days = []
    for row in answered["results"]:
        if not row.get("ok"):
            problems.append(f"{row['id']}: the model raised {row.get('error', '')[:200]}")
            continue
        days.append(row["result"])
    if problems:
        raise SourceError("; ".join(problems))
    return {"date": date, "days": days, "problems": problems, "status": "ok"}


def run_assign(arguments: argparse.Namespace) -> dict:
    """What each mass was classified as, and by which rule. A reading verb."""
    root = Path(arguments.root)
    report = []
    for name in calendars(root, arguments.calendar):
        document = load_source(root, name)
        masses = load_masses(root, name)
        basis_index, _ = check_bases(document, name)
        assigned, _ = assign(document, masses, name)
        bases = document["bases"]
        rows = []
        for key in sorted(assigned):
            basis = bases[basis_index[assigned[key]["basis"]]]
            rows.append(
                {
                    "key": key,
                    "name": assigned[key]["name"],
                    "basis": basis["id"],
                    "row": basis.get("row"),
                    "rule": assigned[key]["rule"],
                }
            )
        report.append({"calendar": name, "masses": rows})
    return {"assignments": report, "status": "ok"}


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("calendar-rubrics error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    if "days" in payload:
        for day in payload["days"]:
            print(f"{day['calendar']} — {day.get('season') or 'no season'}")
            for branch in day["options"]:
                if branch.get("option"):
                    print(f"  where the option is {branch['option']}")
                for row in branch.get("readable") or []:
                    print(f"  {row['state']:<12} {row['label']}")
                if not branch.get("settled"):
                    for row in branch.get("unsettled") or []:
                        print(f"  not settled: {row['what']}: {row['why']}")
        for problem in payload.get("problems") or []:
            print(f"  problem: {problem}")
        return 0
    if "assignments" in payload:
        for row in payload["assignments"]:
            print(f"{row['calendar']}: {len(row['masses'])} masses")
            for mass in row["masses"]:
                place = f"row {mass['row']}" if mass["row"] is not None else "no row"
                print(f"  {mass['key']}: {place} — {mass['basis']}")
        return 0
    if "files" in payload:
        print(f"wrote {payload['files']} files")
        for path in payload["written"]:
            print(f"  -> {path}")
        return 0
    for row in payload["calendars"]:
        print(
            f"{row['calendar']}: {row['masses_classified']} masses classified over "
            f"{row['bases']} bases and {row['rows']} rows, "
            f"{row['implied_rules']} implied-day rules, {row['unsettled']} questions left open"
        )
    solved = payload["solved_cases"]
    print(f"solved cases: {solved['verified']} of {solved['declared']} verified against the browser's model")
    if solved["unasserted"]:
        covered = len(solved["asserted"])
        print(
            f"  asserting {covered} of {covered + len(solved['unasserted'])} fields the model "
            f"returns; no case asserts {', '.join(solved['unasserted'])}"
        )
    return 0


def main(argv: list[str] | None = None) -> int:
    def shared_options(*, verb: bool) -> argparse.ArgumentParser:
        shared = argparse.ArgumentParser(add_help=False)
        missing = argparse.SUPPRESS if verb else None
        shared.add_argument(
            "--root", default=argparse.SUPPRESS if verb else str(DEFAULT_ROOT),
            help="calendar directory"
        )
        shared.add_argument(
            "--out", default=argparse.SUPPRESS if verb else str(DEFAULT_DATA),
            help="the browser's data root"
        )
        shared.add_argument("--calendar", default=missing, help="limit to one calendar")
        shared.add_argument(
            "--format", choices=("text", "json"),
            default=argparse.SUPPRESS if verb else "text"
        )
        shared.add_argument(
            "--verbose", action="store_true",
            default=argparse.SUPPRESS if verb else False,
            help="list every file written"
        )
        shared.add_argument(
            "--json", action="store_true",
            default=argparse.SUPPRESS if verb else False,
            help="emit one compact key-sorted JSON object (cli-v1)"
        )
        shared.add_argument(
            "--date", default=argparse.SUPPRESS if verb else None,
            help="the civil date to derive (the `day` verb)"
        )
        return shared

    shared = shared_options(verb=False)
    verb_shared = shared_options(verb=True)
    parser = argparse.ArgumentParser(
        prog="calendar-rubrics",
        description="Validate the rubrical precedence sources and emit them for the browser.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "calendar-rubrics")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="validate the sources and run the solved cases", parents=[verb_shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("structure", help="write the browser's rubrics files", parents=[verb_shared]),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser("assign", help="report what each mass was classified as", parents=[verb_shared]),
        EXAMPLES["assign"],
    )
    with_examples(
        sub.add_parser("day", help="derive one date through the browser's model", parents=[verb_shared]),
        EXAMPLES["day"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={"check": run_check, "structure": run_structure, "assign": run_assign,
                  "day": run_day},
        renderer=render,
        prefix="calendar-rubrics",
        argv=argv,
        default_verb="check",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={SourceError: ("input", 2), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
