# How a refusal reads when it is the edition's own verse-alias table speaking
# rather than a gap. The distinction is load-bearing: a recorded refusal is
# settled data about the edition, and nothing downstream should read it as a
# correction that has gone stale.
NOT_CARRIED = "is recorded as not carried by this edition"


def sibling(name: str):
    """Load a sibling tool as a module rather than restating what it decides.

    Two tools are read this way and for the same reason. `mass-propers` decides
    what string it will look up, and deriving that string here from a copy of
    its logic is how an index silently stops resolving. `citations` owns what a
    reference string means, and a second parser is how a hand-written override
    and the calendar it corrects would come to disagree about a locus.
    """
    path = ROOT / "tools" / name
    loader = SourceFileLoader(f"_{name.replace('-', '_')}", str(path))
    spec = spec_from_loader(loader.name, loader)
    if spec is None:  # pragma: no cover - a broken checkout, not a code path
        raise ValueError(f"cannot load {path}")
    module = module_from_spec(spec)
    loader.exec_module(module)
    return module


def read_tsv(path: Path) -> list[dict[str, str]]:
    with path.open(encoding="utf-8", newline="") as handle:
        return list(csv.DictReader(handle, delimiter="\t"))


def sole(root: Path, prefix: str, suffix: str) -> Path:
    """The one file under a `<prefix>-<hash>/` artifact directory."""
    found = sorted(root.glob(f"{prefix}-*/*{suffix}"))
    if len(found) != 1:
        raise ValueError(f"expected exactly one {prefix} artifact under {root}, found {len(found)}")
    return found[0]


def normalize(name: str) -> str:
    return SPACING.sub(" ", name.replace(".", " ").strip()).casefold()


def load_books(artifacts: Path) -> dict[str, str]:
    """Map every name a calendar might print to this edition's book token.

    The Douay-Rheims prints Vulgate book names and the calendars print modern
    ones, and the trap is not the spelling but the Kings shift: Douay 1 and 2
    Kings are modern 1 and 2 Samuel, and Douay 3 and 4 Kings are modern 1 and
    2 Kings. The edition's own book index carries both columns, so the mapping
    is read from it rather than restated here. Modern names are claimed first
    so that an alternate spelling can never take a name a modern name owns.
    """
    rows = read_tsv(sole(artifacts, "book-index", "book-index.tsv"))
    if not rows:
        raise ValueError("the edition's book index is empty")
    names: dict[str, str] = {}
    for row in rows:
        names[normalize(row["modern_name"])] = row["token"]
    for row in rows:
        token = row["token"]
        aliases = [token, row["douay_title"], *row["alternate_names"].split(";")]
        # "Psalms" is the calendars' book name; "Psalm" is how a citation reads.
        if token == "Ps":
            aliases.append("Psalm")
        for alias in aliases:
            key = normalize(alias)
            if key and key not in names:
                names[key] = token
    return names


def load_verses(artifacts: Path) -> dict[tuple[str, int, int], str]:
    verses: dict[tuple[str, int, int], str] = {}
    files = sorted(artifacts.glob("verse-text-*/*.tsv"))
    if not files:
        raise ValueError(f"no verse-text artifacts under {artifacts}")
    for path in files:
        for row in read_tsv(path):
            verses[(row["book"], int(row["chapter"]), int(row["verse"]))] = row["text"]
    return verses


def load_aliases(artifacts: Path):
    """The locus a citation names, and the verse of this edition that carries it.

    Two things are recorded here. A verse this edition merged away resolves to
    the verse its text now stands in. A locus this edition does not carry under
    that book at all resolves to nothing: `resolves_to` is empty, and the
    lookup refuses instead of returning whatever the edition happens to print
    at those numbers. The King James Version needs the second kind because its
    canon is shaped differently — a Vulgate citation of Daniel 3:29 means the
    Prayer of Azarias, which this edition prints as a separate book, while its
    own Daniel 3:29 is Nabuchodonosor's decree and is real text at real numbers.

    Read through `_projection` rather than parsed here, so that the rules this
    resolver follows and the rules the edition's projection reports are the same
    rules. They were two parsers of one file, and this one ignored the `kind`
    column, so a kind with no projection meaning resolved here as a plain merge
    while the projection refused to describe it at all.
    """
    return alias_table(artifacts.parent)


class Bible:
    """One edition's text, addressed the way a citation addresses it."""

    def __init__(self, artifacts: Path) -> None:
        self.books = load_books(artifacts)
        self.verses = load_verses(artifacts)
        self.aliases = load_aliases(artifacts)
        # A chapter's verse numbers are not always 1..n. Where the Vulgate
        # splits a Hebrew psalm the Douay-Rheims prints the second part with
        # the numbering it had before the split: Psalm 115 runs 10-19 and
        # Psalm 147 runs 12-20. Both bounds are therefore read from the text.
        self.chapters: dict[tuple[str, int], tuple[int, int]] = {}
        for token, chapter, verse in self.verses:
            here = (token, chapter)
            low, high = self.chapters.get(here, (verse, verse))
            self.chapters[here] = (min(low, verse), max(high, verse))

    def token(self, book: str) -> str | None:
        return self.books.get(normalize(book))

    def carrier(self, token: str, chapter: int, verse: int) -> tuple | None:
        """The locus of this edition that carries a cited one, or None.

        The alias table is read first and its answer is final, including a
        recorded refusal. An edition can print real text at numbers a citation
        does not mean, and preferring what it prints is exactly how such a
        locus resolves to the wrong words with nothing to report.

        Two cited loci can share one carrier, because that is what a merged
        verse is; a range naming both must still read the words once.
        """
        here = (token, chapter, verse)
        if here in self.aliases:
            merged = self.aliases[here]
            return None if merged is None or merged not in self.verses else merged
        return here if here in self.verses else None

    def verse(self, token: str, chapter: int, verse: int) -> str | None:
        """The text this edition carries at a cited locus, or None."""
        found = self.carrier(token, chapter, verse)
        return None if found is None else self.verses[found]

    def refusal(self, token: str, chapter: int, verse: int, bounds: tuple) -> str:
        """Why a cited locus has no text here, in terms a maintainer can act on.

        The three cases want three different repairs and must not read alike. A
        locus the edition's own alias table refuses is settled data. A locus
        outside the verses the chapter prints is a numbering mismatch, and the
        repair is a row in this edition's verse aliases or a correction in the
        calendar. A gap inside the printed range is a hole in the artifact.
        """
        base, bound = bounds
        if (token, chapter, verse) in self.aliases:
            return f"{token} {chapter}:{verse} {NOT_CARRIED}"
        if verse > bound:
            return (
                f"{token} {chapter}:{verse} is past {token} {chapter}:{bound}, the last "
                f"verse this edition prints in that chapter; record where this edition "
                f"carries it in its verse aliases, or correct the citation"
            )
        if verse < base:
            return (
                f"{token} {chapter}:{verse} is before {token} {chapter}:{base}, the first "
                f"verse this edition prints in that chapter; record where this edition "
                f"carries it in its verse aliases, or correct the citation"
            )
        return f"{token} {chapter}:{verse} is missing"

    def span(self, token: str, span: dict) -> tuple[list[str], str, tuple, tuple]:
        """The verses one range names, with the locus each end resolved to.

        A converted range arrives in the numbering this edition prints, so the
        verses it names are looked up as they stand.

        Every verse the range names is looked up, including one past the last
        the chapter prints. Clamping the range to what the edition happens to
        carry is how a citation of a verse this edition does not have comes to
        return the neighbouring verses and read as a success; it also puts the
        clamp ahead of the alias table, so an edition that recorded where it
        carries the merged verse could never be consulted.
        """
        begin = span.get("begin") or {}
        end = span.get("end") or begin
        first = begin.get("chapter")
        last = end.get("chapter", first)
        if first is None:
            return [], "range has no chapter", (), ()
        texts: list[str] = []
        opened: tuple = ()
        closed: tuple = ()
        carried: tuple = ()
        for chapter in range(int(first), int(last) + 1):
            bounds = self.chapters.get((token, chapter))
            if bounds is None:
                # The edition prints no chapter of that number, and that is not
                # the end of the question: its alias table may record where it
                # carries those verses, which is precisely what a book divided
                # differently needs. Refusing here consulted `self.chapters`
                # ahead of the aliases — the same ordering defect as the verse
                # clamp, one level up, and it kept tracked concordance rows for
                # Esther and Daniel permanently out of reach.
                recorded = sorted(
                    verse
                    for (held, held_chapter, verse) in self.aliases
                    if held == token and held_chapter == chapter
                )
                if not recorded:
                    return [], f"{token} has no chapter {chapter}", (), ()
                bounds = (recorded[0], recorded[-1])
            base, bound = bounds
            low = begin.get("verse") if chapter == int(first) else None
            high = end.get("verse") if chapter == int(last) else None
            low = base if low is None else int(low)
            high = bound if high is None else int(high)
            for verse in range(low, high + 1):
                # A verse part ("6a") cannot be cut without editorial judgment,
                # so the whole verse stands and the citation keeps the part.
                found = self.carrier(token, chapter, verse)
                if found is None:
                    return [], self.refusal(token, chapter, verse, bounds), (), ()
                closed = (chapter, verse)
                opened = opened or closed
                # A range naming both a merged verse and the verse it was
                # merged into reaches the same words twice; print them once.
                if found == carried:
                    continue
                carried = found
                texts.append(self.verses[found])
        return texts, "", opened, closed

    def passage(self, token: str, ranges: list) -> tuple[str, str]:
        parts: list[str] = []
        previous: tuple = ()
        for span in ranges:
            texts, problem, opened, closed = self.span(token, span)
            if problem:
                return "", problem
            if parts and opened:
                abuts = previous == (opened[0], opened[1] - 1)
                parts.append(" " if abuts else ELISION)
            parts.append(" ".join(texts))
            previous = closed or previous
        text = SPACING.sub(" ", "".join(parts)).strip()
        return text, "" if text else "no text found"


# Where a calendar's citations do not address the text an edition in Vulgate
# numbering prints. The postconciliar Lectionary cites the Nova Vulgata, which
# divides Joel, Malachi and parts of Isaiah differently, and the reference that
# results is not merely wrong but resolvable: `Joel 3:1-5` returns the valley of
# Josaphat instead of the outpoured spirit, and nothing counts it as a failure.
#
# The correspondence is recorded per citation in the calendar rather than
# derived, because this library tracks no witness of the Nova Vulgata. There is
# nothing here to compile a concordance from, and a remembered one would
# mis-resolve exactly as quietly as the mismatch it replaced.
DIVERGENCES = "citation_divergences"

# The numbering every recorded resolution is written in. Each one was derived by
# reading the cited words out of a Vulgate-numbered edition, so it says where a
# Vulgate-numbered edition carries them and nothing more.
RESOLVED_IN = "vulgate"


# Every other numbering an indexed edition can be in, taken from the editions
# themselves so that registering one in a numbering nothing has ruled on cannot
# pass unnoticed: a divergent locus must say where each of these stands.
def other_numberings() -> tuple[str, ...]:
    return tuple(
        sorted(
            {str(edition["numbering"]) for edition in EDITIONS.values()} - {RESOLVED_IN}
        )
    )


# What a divergent locus says about an edition in some other numbering. The
# three are not interchangeable and the difference is the whole point: a book
# the Lectionary and a Greek-numbered New Testament divide alike wants the
# citation left exactly as it stands, and "correcting" it onto the Vulgate is
# the same silent mis-resolution in the other direction.
RESOLVED = "resolved"  # divides the book as the Vulgate does; use the resolution
AS_CITED = "as-cited"  # divides the book as the calendar cites it; leave it alone
UNRECORDED = "unrecorded"  # neither is established; refuse rather than guess
STANCES = (RESOLVED, AS_CITED, UNRECORDED)
STANCE = "numbering"


def chapters_touched(entry: dict) -> set[int]:
    """Every chapter a citation's ranges reach into, boundary-crossers included."""
    chapters: set[int] = set()
    for span in entry.get("ranges") or []:
        if not isinstance(span, dict):
            continue
        begin = span.get("begin") or {}
        end = span.get("end") or begin
        first = begin.get("chapter")
        if first is None:
            continue
        last = end.get("chapter")
        chapters.update(range(int(first), int(first if last is None else last) + 1))
    return chapters


class Divergences:
    """One calendar's declared numbering divergences, validated as they load.

    A declaration is worth only as much as its upkeep, so each one is checked
    against the citations the calendar actually makes. A resolution for a
    reference no longer cited, a resolution landing in another book, and a
    declared chapter nothing cites are all errors: dead entries that still read
    as coverage are how a table stops matching the thing it describes.

    What is deliberately *not* an error is a citation inside a declared locus
    with no resolution recorded. That one refuses, and the citation goes
    unindexed. Returning whatever verse the edition happens to print at those
    numbers is the defect this machinery exists to stop, and a refusal is the
    only answer that cannot be mistaken for the text.

    `numbering` is the numbering of the edition being indexed. The recorded
    resolutions are written in `RESOLVED_IN`; every other numbering an indexed
    edition may be in must be ruled on per locus under `STANCE`, because a book
    two systems divide alike wants no correction at all.
    """

    def __init__(
        self,
        calendar: str,
        document: dict,
        entries: list[dict],
        canon,
        numbering: str = RESOLVED_IN,
    ) -> None:
        self.calendar = calendar
        self.canon = canon
        self.numbering = numbering
        self.loci: list[tuple[str, frozenset[int], str, dict[str, str]]] = []
        self.resolved: dict[str, tuple[str, str, list]] = {}
        # Absent and empty both mean the calendar claims no divergence; a value
        # of any other shape is a mistake, and reading it as "none" would drop
        # the declaration silently, which is the failure mode being fixed here.
        declared = document.get(DIVERGENCES)
        declared = [] if declared is None else declared
        if not isinstance(declared, list):
            raise ValueError(f"{calendar}: {DIVERGENCES} must be a list of divergent loci")
        self.cited: dict[str, tuple[str, set[int]]] = {}
        for entry in entries:
            ref = str(entry["ref"])
            if ref not in self.cited:
                self.cited[ref] = (str(entry.get("book") or ""), chapters_touched(entry))
        for locus in declared:
            self._declare(locus)

    def _declare(self, locus: object) -> None:
        where = f"{self.calendar}: {DIVERGENCES}"
        if not isinstance(locus, dict):
            raise ValueError(f"{where}: each divergent locus must be a mapping")
        book = locus.get("book")
        if not isinstance(book, str) or not book:
            raise ValueError(f"{where}: a divergent locus must name a book")
        if book == PSALMS:
            # The psalter has a tracked verse-level concordance and converts
            # through it; a second mechanism here could only contradict it.
            raise ValueError(f"{where}: {book} numbering is owned by the psalm concordance")
        reason = locus.get("divergence")
        if not isinstance(reason, str) or not reason.strip():
            raise ValueError(f"{where}: {book} must say how the numbering diverges")
        chapters = self._chapters(where, book, locus.get("chapters"))
        stances = self._stances(where, book, locus.get(STANCE))
        resolutions = locus.get("citations")
        if not isinstance(resolutions, dict) or not resolutions:
            raise ValueError(f"{where}: {book} declares no citations; remove the locus instead")
        covered: set[int] = set()
        for ref, target in sorted(resolutions.items()):
            covered |= self._resolve(where, book, chapters, str(ref), target)
        stale = sorted(chapters - covered) if chapters else []
        if stale:
            raise ValueError(
                f"{where}: {book} declares chapters {stale} that no listed citation reaches"
            )
        self.loci.append((book, chapters, reason.strip(), stances))

    def _stances(self, where: str, book: str, declared: object) -> dict[str, str]:
        """Where each other numbering stands on this book, ruled on one by one.

        A default would be the wrong shape for this question: the two answers
        are opposites, one correcting a citation and the other leaving it
        untouched, and whichever were the default would be applied silently to
        the books nobody had thought about yet.
        """
        wanted = other_numberings()
        if not isinstance(declared, dict):
            raise ValueError(
                f"{where}: {book} must say under {STANCE} where each of "
                f"{list(wanted)} stands, one of {list(STANCES)}"
            )
        for numbering in wanted:
            stance = declared.get(numbering)
            if stance not in STANCES:
                raise ValueError(
                    f"{where}: {book} {STANCE} for {numbering!r} is {stance!r}; "
                    f"it must be one of {list(STANCES)}"
                )
        extra = sorted(set(declared) - set(wanted))
        if extra:
            raise ValueError(
                f"{where}: {book} {STANCE} rules on {extra}, which no indexed edition "
                f"is in ({RESOLVED_IN} always takes the resolution and is not listed)"
            )
        return {numbering: str(declared[numbering]) for numbering in wanted}

    def _chapters(self, where: str, book: str, declared: object) -> frozenset[int]:
        """The chapters this book diverges in; empty means the whole book."""
        if declared is None:
            return frozenset()
        if not isinstance(declared, list) or not declared:
            raise ValueError(f"{where}: {book} chapters must be a non-empty list")
        for chapter in declared:
            if not isinstance(chapter, int) or isinstance(chapter, bool) or chapter < 1:
                raise ValueError(f"{where}: {book} chapter {chapter!r} is not a chapter number")
        return frozenset(declared)

    def _resolve(
        self, where: str, book: str, chapters: frozenset[int], ref: str, target: object
    ) -> set[int]:
        """Validate one recorded resolution and keep it. Returns what it covers."""
        if not isinstance(target, str) or not target.strip():
            raise ValueError(f"{where}: {book} resolution for {ref!r} must be a reference string")
        if ref in self.resolved:
            raise ValueError(f"{where}: {ref!r} is resolved twice")
        found = self.cited.get(ref)
        if found is None:
            raise ValueError(f"{where}: {ref!r} is resolved but no longer cited by this calendar")
        home, touched = found
        if home != book:
            raise ValueError(f"{where}: {ref!r} is cited under {home!r}, not {book!r}")
        if chapters and not touched & chapters:
            raise ValueError(f"{where}: {ref!r} reaches no divergent chapter of {book}")
        try:
            passage = self.canon.parse_citation(target.strip())
        except self.canon.CitationError as error:
            raise ValueError(
                f"{where}: {ref!r} resolves to an unreadable reference: {error}"
            ) from error
        if passage["book"] != book:
            # An override may correct the numbering, never the book: a citation
            # that resolves into another book is a different citation.
            raise ValueError(
                f"{where}: {ref!r} resolves into {passage['book']}, outside {book}"
            )
        self.resolved[ref] = (book, target.strip(), passage["ranges"])
        return touched & chapters if chapters else touched

    def locus_of(self, book: str, touched: set[int]) -> tuple[str, dict[str, str]] | None:
        """The declared locus this citation falls in: how it diverges, and stances."""
        for declared, chapters, reason, stances in self.loci:
            if declared == book and (not chapters or touched & chapters):
                return reason, stances
        return None

    def stance(self, stances: dict[str, str]) -> str:
        """What this locus says about the edition being indexed."""
        if self.numbering == RESOLVED_IN:
            return RESOLVED
        return stances.get(self.numbering, UNRECORDED)

    def apply(self, entry: dict, ranges: list) -> tuple[list, str]:
        """The ranges that select this citation's text here, or why it refuses."""
        book = str(entry.get("book") or "")
        found = self.locus_of(book, chapters_touched(entry))
        if found is None:
            return ranges, ""
        reason, stances = found
        stance = self.stance(stances)
        if stance == AS_CITED:
            # This edition divides the book the way the calendar cites it, so
            # the citation already names the verses it means.
            return ranges, ""
        if stance == UNRECORDED:
            return [], (
                f"{self.calendar} numbers {book} divergently ({reason}); this edition is "
                f"in {self.numbering} numbering and the locus records no ruling for it "
                f"beyond {UNRECORDED!r}"
            )
        recorded = self.resolved.get(str(entry["ref"]))
        if recorded is not None:
            return recorded[2], ""
        return [], (
            f"{self.calendar} numbers {book} divergently ({reason}) and records no "
            f"resolution for this citation; add one under {DIVERGENCES}"
        )

    def confirm(self, bible: "Bible") -> None:
        """Every resolution must reach real text in an edition holding its book.

        A citation the edition cannot address is ordinary — a calendar may cite
        a book this edition never printed. A hand-written resolution that
        cannot be addressed is not: it is a correction that has stopped
        correcting, and it fails the build rather than joining the unresolved
        tally where a reader would read it as the calendar's problem.

        An edition the resolutions do not apply to is not asked to address
        them: it never uses one, and failing its build over a correction meant
        for another numbering would report the wrong edition's problem. Neither
        is an edition that has recorded, in its own verse aliases, that it does
        not carry the locus. That refusal is the edition speaking about itself,
        and it belongs in the unresolved tally rather than stopping the build.
        """
        for ref, (book, target, ranges) in sorted(self.resolved.items()):
            token = bible.token(book)
            if token is None:
                continue
            found = self.locus_of(book, self.cited[ref][1])
            if found is None or self.stance(found[1]) != RESOLVED:
                continue
            _, problem = bible.passage(token, ranges)
            if problem and not problem.endswith(NOT_CARRIED):
                raise ValueError(
                    f"{self.calendar}: {DIVERGENCES} resolves {ref!r} to {target!r}, "
                    f"which this edition cannot address: {problem}"
                )


def unnumber_titles(ranges: list) -> tuple[list, str]:
    """Move Hebrew-numbered psalm ranges onto an edition that numbers no title.

    Every calendar tracked here numbers a psalm's inscription, and the King
    James Version does not, so its Psalm 51:1 is the *Miserere* that a
    Hebrew-numbered calendar cites as 51:3. The shift is a property of the
    edition rather than of the reference, and it is applied to the ranges only:
    the key stays the string the calendar printed.

    A range this correspondence cannot carry is refused rather than moved by
    the offset at the head of the psalm. Two cases refuse. An endpoint on the
    inscription has no verse to move to, because the edition prints those words
    without a number. And where the two conventions divide a psalm's body
    differently the concordance records no verse-for-verse correspondence at
    all, so an offset taken from the first verse would land on real text some
    way from the words cited.
    """
    moved: list = []
    for span in ranges:
        piece: dict = {}
        for side in ("begin", "end"):
            end = span.get(side)
            if not isinstance(end, dict):
                continue
            chapter, verse = end.get("chapter"), end.get("verse")
            if chapter is None or verse is None:
                piece[side] = dict(end)
                continue
            found, problem = english_verse(int(chapter), int(verse))
            if found is None:
                return [], problem
            piece[side] = {**end, "verse": found}
        moved.append(piece)
    return moved, ""


def citation(
    entry: dict, source: str, target: str, tool, titles: str = ""
) -> tuple[str, list, str]:
    """The key `mass-propers` will look up, and the ranges that key covers.

    The key follows the tool exactly: only a psalm chapter is renumbered, and
    the calendar's own verse numbers stay in the string. The ranges are
    converted properly, verse shifts included, because they select the text.

    Numbering and title convention are two separate moves and both are needed.
    A calendar in Vulgate numbering is renumbered into the edition's system
    first; then, for an edition that leaves psalm inscriptions unnumbered, the
    ranges shift again. The second move applies even when the calendar and the
    edition already agree on numbering, which is the case that would otherwise
    read as needing no work at all.
    """
    ref = str(entry["ref"])
    book = str(entry.get("book") or "")
    ranges = [span for span in (entry.get("ranges") or []) if isinstance(span, dict)]
    if not ranges:
        return ref, [], "citation carries no ranges"
    if book != PSALMS:
        return ref, ranges, ""
    key = ref
    if source != target:
        chapter, verse = tool.locus_of(entry)
        if chapter is not None:
            try:
                converted, _ = convert_reference(book, chapter, source, target, verse)
                moved: list = []
                for span in ranges:
                    spans, _ = convert_range(
                        book, span.get("begin") or {}, span.get("end"), source, target
                    )
                    moved.extend(spans)
            except NumberingError as error:
                return ref, [], str(error)
            key = ref if converted == chapter else tool.renumber(ref, converted)
            ranges = moved
    if titles == UNNUMBERED_TITLES:
        try:
            ranges, problem = unnumber_titles(ranges)
        except NumberingError as error:
            return key, [], str(error)
        if problem:
            return key, [], problem
    return key, ranges, ""


def collect(
    bible: Bible, calendar_root: Path, target: str, titles: str, tool, canon
) -> dict:
    """Index every citation every calendar makes, and record what failed."""
    passages: dict[str, str] = {}
    unresolved: list[dict[str, str]] = []
    seen: set[tuple[str, str]] = set()
    counts: dict[str, dict[str, int]] = {}
    for calendar in tool.calendars(calendar_root):
        document = tool.load_calendar(calendar_root, calendar)
        source = document.get("psalm_numbering") or target
        # Each citation carries the numbering that applies to it, which is the
        # calendar's unless the proper declares otherwise.
        numbered = [
            pair
            for _, mass in tool.masses_of(document)
            for pair in tool.numbered_entries(mass, source)
        ]
        entries = [entry for entry, _ in numbered]
        # Both checks run before a single citation is indexed, so a declaration
        # that has fallen out of step stops the build rather than shaping it.
        divergences = Divergences(calendar, document, entries, canon, target)
        divergences.confirm(bible)
        wanted: set[str] = set()
        resolved: set[str] = set()
        for entry, numbering in numbered:
            ref = str(entry["ref"])
            wanted.add(ref)
            key, ranges, problem = citation(entry, numbering or source, target, tool, titles)
            if not problem:
                ranges, problem = divergences.apply(entry, ranges)
            if (calendar, ref) in seen:
                if key in passages:
                    resolved.add(ref)
                continue
            seen.add((calendar, ref))
            token = bible.token(str(entry.get("book") or ""))
            if token is None:
                problem = problem or f"no book named {entry.get('book')!r} in this edition"
            text = ""
            if token is not None and not problem:
                text, problem = bible.passage(token, ranges)
            if problem:
                unresolved.append({"calendar": calendar, "ref": ref, "reason": problem})
                continue
            resolved.add(ref)
            if passages.get(key, text) != text:
                unresolved.append(
                    {"calendar": calendar, "ref": ref, "reason": f"key {key!r} disagrees"}
                )
                continue
            passages[key] = text
        counts[calendar] = {"cited": len(wanted), "resolved": len(resolved)}
    return {
        "passages": dict(sorted(passages.items())),
        "calendars": dict(sorted(counts.items())),
        "unresolved": sorted(unresolved, key=lambda row: (row["calendar"], row["ref"])),
    }


def fragments_for(bible: Bible) -> dict[str, str]:
    """One JSON file per chapter, which is what a reader actually fetches.

    A chapter is the unit that is small enough to send for a three-verse
    antiphon and large enough to serve a reading that runs to the end of one,
    so the page fetches a chapter and the passage range filters it. Keyed by
    the edition's own book token and its own printed verse numbers, because a
    consumer that has resolved a citation is asking for numbers, not for a
    reference string.
    """
    chapters: dict[tuple[str, int], dict[int, str]] = {}
    for (token, chapter, verse), text in bible.verses.items():
        chapters.setdefault((token, chapter), {})[verse] = text
    written: dict[str, str] = {}
    for (token, chapter), verses in chapters.items():
        body = ",".join(
            f'{json.dumps(str(verse))}:{json.dumps(verses[verse], ensure_ascii=False)}'
            for verse in sorted(verses)
        )
        written[f"chapters/{token}/{chapter}.json"] = (
            f'{{"book":{json.dumps(token)},"chapter":{chapter},"verses":{{{body}}}}}\n'
        )
    return written


def write_fragments(root: Path, fragments: dict[str, str]) -> None:
    for relative, payload in sorted(fragments.items()):
        path = root / relative
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(payload, encoding="utf-8")


def stale_fragments(root: Path, fragments: dict[str, str]) -> list[str]:
    problems: list[str] = []
    for relative, payload in sorted(fragments.items()):
        path = root / relative
        if not path.is_file():
            problems.append(f"missing chapter fragment {relative}")
        elif path.read_text(encoding="utf-8") != payload:
            problems.append(f"stale chapter fragment {relative}")
    existing = {
        p.relative_to(root).as_posix()
        for p in (root / "chapters").rglob("*.json")
    } if (root / "chapters").is_dir() else set()
    for orphan in sorted(existing - set(fragments)):
        problems.append(f"chapter fragment no longer derived: {orphan}")
    return problems


def document_for(name: str, built: dict) -> dict:
    edition = EDITIONS[name]
    if edition["psalter"] not in PSALTERS:
        raise ValueError(f"{name}: psalter must be one of {list(PSALTERS)}")
    if edition["psalm_titles"] not in ("numbered", UNNUMBERED_TITLES):
        raise ValueError(f"{name}: psalm_titles must be numbered or {UNNUMBERED_TITLES}")
    if edition["psalm_titles"] == UNNUMBERED_TITLES and edition["numbering"] != "hebrew":
        # The correspondence is recorded from the Hebrew numbering outward, so
        # an edition declaring it must already be addressed in that numbering.
        raise ValueError(f"{name}: {UNNUMBERED_TITLES} psalm titles need hebrew numbering")
    return {
        "schema": "triptych-bible-index/v1",
        "edition": edition["edition"],
        "source_id": edition["source_id"],
        "rights": edition["rights"],
        "publishable": edition["publishable"],
        "language": edition["language"],
        "numbering": edition["numbering"],
        "psalter": edition["psalter"],
        # A consumer addressing this edition by chapter and verse needs both:
        # the numbering says which psalm, and this says whether its inscription
        # took a verse number away from the body.
        "psalm_titles": edition["psalm_titles"],
        "generator": "index-bible build",
        "coverage": "the references the tracked calendars make; rebuild after a "
        "calendar adds a reference",
        "passages": built["passages"],
    }


def serialize(document: dict) -> str:
    import yaml

    text = yaml.safe_dump(document, sort_keys=False, allow_unicode=True, width=88)
    # A quoted scalar that wraps must fold back to the same bytes, so prove it
    # rather than trusting the emitter with several megabytes of scripture.
    if yaml.safe_load(text) != document:
        raise ValueError("the emitted index does not round-trip; refusing to write it")
    return text


def projection_of(name: str, artifacts: Path) -> dict:
    """This edition's distance from the canon, derived, never named by hand.

    Deriving it here rather than reporting a stored number is the whole of the
    check: a projection that cannot be derived — an alias kind with no meaning,
    a numbering the concordance cannot reach, a psalm concordance that has moved
    — stops the build with the reason, instead of an edition quietly resolving
    through rules nothing can describe.

    Every count comes from the rules themselves. None of these numbers is
    written down anywhere, which is the point: the first version of the
    derivation reported a plausible sixteen-that-was-three uniformly across
    every edition, and a stored figure would have agreed with it.
    """
    rows = project(artifacts.parent, str(EDITIONS[name]["numbering"]))
    return {
        "counts": divergence(rows),
        "rules": [
            {
                "cited_locus": row.cited_locus,
                "resolves_to": row.resolves_to,
                "kind": row.kind,
                "note": row.note,
            }
            for row in rows
        ],
    }


def build(name: str, calendar_root: Path, artifacts: Path) -> dict:
    bible = Bible(artifacts)
    tool = sibling("mass-propers")
    built = collect(
        bible,
        calendar_root,
        str(EDITIONS[name]["numbering"]),
        str(EDITIONS[name]["psalm_titles"]),
        tool,
        sibling("citations"),
    )
    return {
        **built,
        "projection": projection_of(name, artifacts),
        "text": serialize(document_for(name, built)),
        "fragments": fragments_for(bible),
    }


def artifacts_for(name: str, arguments: argparse.Namespace) -> Path:
    if name not in EDITIONS:
        raise KeyError(f"no indexable edition {name!r}; known: {', '.join(sorted(EDITIONS))}")
    root = Path(arguments.source_root) / str(EDITIONS[name]["artifacts"])
    if not root.is_dir():
        raise ValueError(f"no tracked artifacts for {name} at {root}")
    return root


def summary(name: str, built: dict, path: Path, arguments: argparse.Namespace) -> dict:
    projection = built["projection"]
    return {
        "bible": name,
        "calendars": built["calendars"],
        "passages": len(built["passages"]),
        "path": str(path.relative_to(ROOT)) if path.is_relative_to(ROOT) else str(path),
        # The counts always, the rules only when asked: the counts are the
        # diffable line a reader watches, and the King James has 4313 rules.
        "projection": (
            {**projection["counts"], "rules": projection["rules"]}
            if arguments.verbose
            else projection["counts"]
        ),
        "unresolved": built["unresolved"] if arguments.verbose else len(built["unresolved"]),
        "status": "ok",
    }


def run_manifest(arguments: argparse.Namespace) -> dict:
    """List the editions a public page may offer, and only those.

    The site's translation choices are exactly the publishable editions. A
    licensed text is excluded here rather than filtered in the browser, so a
    page cannot offer what it has no right to serve even if its fragments were
    somehow present.
    """
    # An edition is offered only if its fragments are actually here to serve.
    # A manifest naming one that is not breaks the site build, and worse, would
    # promise a reader a translation the artifact cannot render.
    servable = {
        name
        for name in EDITIONS
        if (Path(arguments.bible_root) / name / "chapters").is_dir()
    }
    offered = [
        {
            "id": name,
            # The short name a reader chooses by; the full edition string
            # stays available for provenance.
            "label": str(edition.get("label") or edition["edition"]),
            "edition": str(edition["edition"]),
            "language": str(edition["language"]),
            "numbering": str(edition["numbering"]),
            "psalter": str(edition["psalter"]),
            "psalm_titles": str(edition["psalm_titles"]),
            "rights": str(edition["rights"]),
        }
        for name, edition in sorted(
            EDITIONS.items(), key=lambda row: (row[1].get("rank", 999), row[0])
        )
        if edition["publishable"] and name in servable
    ]
    path = Path(arguments.out) / "bibles.json"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        json.dumps({"bibles": offered}, ensure_ascii=False, sort_keys=True, indent=1) + "\n",
        encoding="utf-8",
    )
    return {
        "bible": "manifest",
        "offered": [row["id"] for row in offered],
        "withheld": sorted(
            name for name, edition in EDITIONS.items() if not edition["publishable"]
        ),
        "unservable": sorted(
            name
            for name, edition in EDITIONS.items()
            if edition["publishable"] and name not in servable
        ),
        "path": str(path),
        "status": "ok",
    }


def run_build(arguments: argparse.Namespace) -> dict:
    name = arguments.bible
    built = build(name, Path(arguments.root), artifacts_for(name, arguments))
    path = Path(arguments.bible_root) / name / "index.yaml"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(built["text"], encoding="utf-8")
    write_fragments(path.parent, built["fragments"])
    return summary(name, built, path, arguments)


def run_check(arguments: argparse.Namespace) -> dict:
    name = arguments.bible
    built = build(name, Path(arguments.root), artifacts_for(name, arguments))
    path = Path(arguments.bible_root) / name / "index.yaml"
    if not path.is_file():
        raise ValueError(f"no index at {path}; run `index-bible build`")
    current = path.read_text(encoding="utf-8")
    if current != built["text"]:
        raise ValueError(f"{path} is stale; run `index-bible build`")
    drift = stale_fragments(path.parent, built["fragments"])
    if drift:
        shown = "; ".join(drift[:3])
        more = f" (and {len(drift) - 3} more)" if len(drift) > 3 else ""
        raise ValueError(f"{shown}{more}; run `index-bible build`")
    return summary(name, built, path, arguments)


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("index-bible error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    if "offered" in payload:
        print(f"offered: {', '.join(payload['offered'])} -> {payload['path']}")
        if payload["withheld"]:
            print(f"withheld as unpublishable: {', '.join(payload['withheld'])}")
        if payload.get("unservable"):
            print(f"not offered, no fragments here: {', '.join(payload['unservable'])}")
        return 0
    print(f"{payload['bible']}: {payload['passages']} passages -> {payload['path']}")
    for calendar, counts in payload["calendars"].items():
        resolved, cited = counts["resolved"], counts["cited"]
        share = 100.0 * resolved / cited if cited else 0.0
        print(f"  {calendar}: {resolved}/{cited} references resolved ({share:.1f}%)")
    projection = payload["projection"]
    # Identity writes no rule, so the total is the distance from the canon and
    # not the size of the edition. Kinds that fired are named; kinds that did
    # not are left out rather than printed as zeros.
    kinds = ", ".join(f"{kind} {projection[kind]}" for kind in OVERRIDES if projection[kind])
    print(f"  projection: {projection['total']} rules ({kinds or 'none'})")
    for rule in projection.get("rules", ()):
        target = rule["resolves_to"] or "(refused)"
        print(f"  rule {rule['kind']} {rule['cited_locus']} -> {target}")
    rows = payload["unresolved"]
    if isinstance(rows, int):
        print(f"  unresolved: {rows}")
        return 0
    for row in rows:
        print(f"  unresolved {row['calendar']} {row['ref']}: {row['reason']}")
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument(
        "--bible", default="douay-rheims", help="edition id, e.g. douay-rheims"
    )
    shared.add_argument("--root", default=str(DEFAULT_CALENDAR_ROOT), help="calendar root")
    shared.add_argument(
        "--bible-root", default=str(DEFAULT_BIBLE_ROOT), help="where indexed bibles are written"
    )
    shared.add_argument(
        "--source-root", default=str(SOURCE_ROOT), help="source library works root"
    )
    shared.add_argument(
        "--format", choices=("text", "json"), default="text", help="output form"
    )
    shared.add_argument(
        "--verbose",
        action="store_true",
        help="list every citation that did not resolve, and every projection rule",
    )
    shared.add_argument(
        "--out", default="src/web/data", help="where `manifest` writes bibles.json"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="index-bible",
        description="Build an indexed bible from the source library's tracked verse text.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "index-bible")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("build", help="write the index", parents=[shared]),
        EXAMPLES["build"],
    )
    with_examples(
        sub.add_parser("check", help="rebuild in memory and report drift", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser(
            "manifest", help="list the editions a public page may offer", parents=[shared]
        ),
        EXAMPLES["manifest"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={"build": run_build, "check": run_check, "manifest": run_manifest},
        renderer=render,
        prefix="index-bible",
        argv=argv,
        # The read-only verb is the default: a bare invocation reports drift
        # rather than rewriting a tracked file.
        default_verb="check",
        dependency_message="install PyYAML (requirements-tools.txt)",
        # A projection that will not derive is bad tracked data, not a defect in
        # this tool: report it as an input failure rather than as an internal one.
        mapped_errors={
            KeyError: ("not-found", 3),
            ProjectionError: ("input", 2),
            ValueError: ("input", 2),
        },
    )


if __name__ == "__main__":
    raise SystemExit(main())
