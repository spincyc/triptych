#!/usr/bin/env python3
"""Compile pictographic render contracts and deterministic skeleton SVGs.

The approved structural corpus says what happens in a scene. A render contract
says where everything is, in explicit world coordinates, so that a later
artistic pass cannot mirror a book or invent a panel.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

from _pictographic import (  # noqa: E402
    SeedRefused,
    art_seed,
    composition_digest,
    compile_scene,
    contract_dir,
    underlay_module,
    readiness_report,
    write_contract,
    write_skeleton,
)
from _tooling import Example, examples_live_on_the_verbs, with_examples  # noqa: E402

# Captured transcripts, never composed; see scripts/_tooling.py.
EXAMPLES = {
    "render-contract": (
        Example(
            "tools/pictographic render-contract roman-1962 low-mass LM-001A "
            "--out build/example-render-contract",
            (
                "wrote build/example-render-contract/contracts/LM-001A.yaml",
            ),
            "WRITES under the named --out, so a scratch path keeps the tracked "
            "contracts untouched",
        ),
        Example(
            "tools/pictographic render-contract roman-1962 low-mass LM-136C "
            "--out build/example-render-contract",
            (
                "wrote build/example-render-contract/contracts/LM-136C.yaml",
            ),
            "the first post-ablution crossing, whose panel list adds a declared "
            "plan view",
        ),
    ),
    "skeleton": (
        Example(
            "tools/pictographic skeleton roman-1962 low-mass LM-001A "
            "--out build/example-render-contract",
            (
                "wrote build/example-render-contract/skeletons/LM-001A.svg",
            ),
            "WRITES under the named --out",
        ),
        Example(
            "tools/pictographic skeleton roman-1962 low-mass LM-035A "
            "--out build/example-render-contract",
            (
                "wrote build/example-render-contract/skeletons/LM-035A.svg",
            ),
            "the Gospel-side reading, where the book must not be mirrored",
        ),
    ),
    "underlay": (
        Example(
            "tools/pictographic underlay roman-1962 low-mass LM-001A "
            "--out build/example-underlay",
            (
                "wrote build/example-underlay/LM-001A/render-underlay.svg "
                "and render-underlay.png",
            ),
            "a recognizable projected drawing, not a labelled schematic",
        ),
        Example(
            "tools/pictographic underlay roman-1962 low-mass LM-035A "
            "--out build/example-underlay",
            (
                "wrote build/example-underlay/LM-035A/render-underlay.svg "
                "and render-underlay.png",
            ),
            "the Gospel-side reading, where the book moves but does not mirror",
        ),
    ),
    "composition-review": (
        Example(
            "tools/pictographic composition-review roman-1962 low-mass",
            (
                "canary LM-001A  preset nave-front",
                "  status  approved",
                "... 3 more lines",
            ),
            "whether anyone has looked at the picture the pipeline now draws",
        ),
    ),
    "art-seed": (
        Example(
            "tools/pictographic art-seed roman-1962 low-mass LM-001A "
            "--out build/example-art-seed",
            (
                "seeded LM-001A -> build/example-art-seed/LM-001A",
                "  render-underlay.png  render-underlay.svg  render-contract.yaml  skeleton.svg  provenance.yaml  ART-AGENT-INSTRUCTIONS.md",
                "  EDIT render-underlay.png; do not compose a fresh image",
                "  panels 1 (primary) - additional panels forbidden",
                "  PIPELINE CANARY: render this first; the lane proceeds only at STRUCTURE = PASS",
            ),
            "the only sanctioned way to hand a scene to an artistic agent",
        ),
        Example(
            "tools/pictographic art-seed roman-1962 low-mass LM-001B "
            "--out build/example-art-seed",
            (
                "REFUSED: LM-001B is BLOCKED_FOR_ART and must not be rendered.",
                "... 4 more lines",
            ),
            "fails closed on a blocked scene, naming the cue and writing nothing",
        ),
    ),
    "readiness": (
        Example(
            "tools/pictographic readiness roman-1962 low-mass",
            (
                "scenes 197  art-ready 140  blocked 57",
            ),
        ),
        Example(
            "tools/pictographic readiness roman-1962 low-mass --blocked",
            (
                "scenes 197  art-ready 140  blocked 57",
                "... 57 more lines",
            ),
            "--blocked also lists each blocked scene and its first unresolved cue",
        ),
    ),
}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    examples_live_on_the_verbs(parser, "pictographic")
    verbs = parser.add_subparsers(dest="verb", required=True)

    for name in ("render-contract", "skeleton", "underlay", "art-seed"):
        verb = with_examples(verbs.add_parser(name), EXAMPLES[name])
        verb.add_argument("calendar")
        verb.add_argument("form")
        verb.add_argument("scene")
        verb.add_argument("--out", type=Path, default=None)

    ready = with_examples(verbs.add_parser("readiness"), EXAMPLES["readiness"])
    ready.add_argument("calendar")
    ready.add_argument("form")
    ready.add_argument("--blocked", action="store_true")

    review = with_examples(
        verbs.add_parser("composition-review"), EXAMPLES["composition-review"]
    )
    review.add_argument("calendar")
    review.add_argument("form")
    review.add_argument(
        "--refresh",
        action="store_true",
        help="record the current composition as reviewed; only after looking",
    )

    args = parser.parse_args()
    directory = contract_dir(args.calendar, args.form)

    if args.verb == "composition-review":
        current, review = composition_digest(directory)
        recorded = review.get("reviewed_geometry_digest")
        state = "approved" if review.get("status") == "approved" else "NOT APPROVED"
        fresh = recorded == current
        print(f"canary {review.get('canary')}  preset {review.get('preset')}")
        print(f"  status  {state}")
        print(f"  recorded {recorded}")
        print(f"  current  {current}")
        print(f"  {'current' if fresh else 'STALE - art-seed will refuse'}")
        if not args.refresh:
            return 0 if (fresh and state == "approved") else 2
        master = directory / "sanctuary-master.yaml"
        body = master.read_text(encoding="utf-8")
        lines = []
        for line in body.split("\n"):
            if line.strip().startswith("reviewed_geometry_digest:"):
                indent = line[: len(line) - len(line.lstrip())]
                line = f"{indent}reviewed_geometry_digest: {current}"
            lines.append(line)
        master.write_text("\n".join(lines), encoding="utf-8")
        print(f"  recorded the current composition as reviewed: {current}")
        return 0

    if args.verb == "readiness":
        report = readiness_report(directory)
        totals = report["totals"]
        print(
            f"scenes {totals['scenes']}  art-ready {totals['ready']}  "
            f"blocked {totals['blocked']}"
        )
        if args.blocked:
            for entry in report["blocked_scenes"]:
                first = entry["unresolved_cues"][0]
                print(f"  {entry['scene_id']}  {first}")
        return 0

    if args.verb == "art-seed":
        out = args.out or (ROOT / "build" / "art-seed")
        try:
            seeded = art_seed(directory, args.scene, out)
        except SeedRefused as refusal:
            print(f"REFUSED: {refusal}", file=sys.stderr)
            return 2
        package, provenance = seeded["package"], seeded["provenance"]
        try:
            shown = package.relative_to(ROOT)
        except ValueError:
            shown = package
        panels = provenance["panel_manifest"]
        print(f"seeded {args.scene} -> {shown}")
        print("  render-underlay.png  render-underlay.svg  "
              "render-contract.yaml  skeleton.svg  provenance.yaml  "
              "ART-AGENT-INSTRUCTIONS.md")
        print("  EDIT render-underlay.png; do not compose a fresh image")
        print(f"  panels {len(panels)} ({', '.join(panels)}) - additional "
              f"panels {provenance['additional_panels']}")
        if provenance["is_pipeline_canary"]:
            print("  PIPELINE CANARY: render this first; the lane proceeds "
                  "only at STRUCTURE = PASS")
        return 0

    if args.verb == "underlay":
        out = args.out or (ROOT / "build" / "underlay")
        module = underlay_module(directory)
        try:
            contract = compile_scene(directory, args.scene)
        except KeyError:
            raise SystemExit(f"unknown scene {args.scene!r}")
        svg_path, png_path = module.write(contract, out / args.scene)
        try:
            shown = svg_path.parent.relative_to(ROOT)
        except ValueError:
            shown = svg_path.parent
        print(f"wrote {shown}/{svg_path.name} and {png_path.name}")
        return 0

    out = args.out or directory
    try:
        if args.verb == "render-contract":
            written = write_contract(directory, args.scene, out)
        else:
            written = write_skeleton(directory, args.scene, out)
    except KeyError as unknown:
        raise SystemExit(f"unknown scene {args.scene!r}") from unknown
    try:
        shown = written.relative_to(ROOT)
    except ValueError:
        shown = written
    print(f"wrote {shown}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
