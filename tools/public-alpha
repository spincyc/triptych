class ReleaseError(RuntimeError):
    pass


def requires_unadvertised_controls(authorization: dict) -> bool:
    return "unadvertised-public-hosting" in set(authorization.get("conditions", []))


def eligible_document_ids() -> set[tuple[str, str]]:
    """Return every leaf whose own record declares a publishable web edition."""
    source_root = ROOT / "src"
    eligible: set[tuple[str, str]] = set()
    for record_path in sorted(source_root.glob(f"*/**/{WEB_EDITION_RECORD}")):
        try:
            record = tomllib.loads(record_path.read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            raise ReleaseError(
                f"cannot read {record_path.relative_to(ROOT)}: {exc}"
            ) from exc
        if record.get("eligibility") != "eligible":
            continue
        relative = record_path.parent.relative_to(source_root)
        eligible.add((relative.parts[0], PurePosixPath(*relative.parts[1:]).as_posix()))
    return eligible


def document_pages(keys: set[tuple[str, str]] | None = None) -> dict[str, str]:
    """Map each reviewed web edition's tracked Markdown to its rendered page.

    Computed at use time so a caller that narrows the key set — or a test that
    replaces the fixed page map — sees exactly the pages it asked for.
    """
    if keys is None:
        keys = eligible_document_ids()
    return {
        f"web/{provider}/{leaf}.md": f"web/{provider}/{leaf}.html"
        for provider, leaf in sorted(keys)
    }


def included_document_pages(included_ids: set[tuple[str, str]]) -> dict[str, str]:
    """Return the document pages this artifact actually renders."""
    return document_pages(eligible_document_ids() & set(included_ids))


def site_pages() -> dict[str, str]:
    """Every source page the site renders, fixed and per-document alike."""
    return {**PAGE_MAP, **document_pages()}


