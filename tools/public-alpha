def _resolve_pictorial_asset_path(value: str, label: str) -> Path:
    candidate = PurePosixPath(value)
    if candidate.is_absolute() or not candidate.parts or ".." in candidate.parts:
        raise ReleaseError(f"{label} is not a safe relative path: {value!r}")
    possibilities = (PICTORIAL_ROOT.joinpath(*candidate.parts), ROOT.joinpath(*candidate.parts))
    existing = [path for path in possibilities if path.exists()]
    if len({path.resolve() for path in existing}) != 1:
        raise ReleaseError(
            f"{label} must resolve to exactly one dictionary or repository asset: {value!r}"
        )
    path = existing[0]
    if path.is_symlink() or not path.is_file() or path.suffix.lower() != ".png":
        raise ReleaseError(f"{label} is unsafe, missing, or not PNG: {value!r}")
    try:
        path.resolve().relative_to(ROOT.resolve())
    except ValueError as exc:
        raise ReleaseError(f"{label} leaves the repository: {value!r}") from exc
    return path


PICTORIAL_UNAVAILABLE_DEFINITION = (
    "A source-verified definition is not yet available; this pictured record "
    "remains under audit."
)


def _checked_definition(record: dict) -> tuple[str, bool]:
    claims = record.get("claims", [])
    for kind in (
        "identity",
        "liturgical-use",
        "ceremonial-presence",
        "appearance",
        "variation",
    ):
        for claim in claims:
            if (
                claim.get("kind") == kind
                and claim.get("evidence_state")
                in {
                    "checked-paraphrase",
                    "checked-quotation",
                    "source-grounded-synthesis",
                    "verified-source-text",
                }
                and isinstance(claim.get("text"), str)
                and claim["text"].strip()
            ):
                return claim["text"].strip(), False
    return PICTORIAL_UNAVAILABLE_DEFINITION, True


def pictorial_gallery_data() -> list[dict]:
    """Load the release-reviewed, canonical dictionary artwork exactly once."""
    manifest_path = ROOT / PICTORIAL_MANIFEST_RELATIVE
    try:
        manifest = tomllib.loads(manifest_path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ReleaseError(f"cannot read {PICTORIAL_MANIFEST_RELATIVE}: {exc}") from exc

    asset_files = {item["id"]: item for item in manifest.get("asset_files", [])}
    admitted: list[tuple[dict, dict]] = []
    required_reviews = {
        "factual": "passed",
        "visual": "passed",
        "print": "passed",
        "rights": "passed",
        "consumer": "passed",
        "release": "passed",
    }
    for artwork in manifest.get("artworks", []):
        if (
            artwork.get("workflow_state") == "consumer-review-passed"
            and artwork.get("reviews") == required_reviews
        ):
            asset_path = artwork.get("asset") or artwork.get("normalized", {}).get("path")
            matching = [item for item in asset_files.values() if item.get("path") == asset_path]
            if len(matching) != 1:
                raise ReleaseError(f"{artwork.get('id')}: full artwork has no unique asset-file record")
            admitted.append((artwork, matching[0]))
    for artwork in manifest.get("artwork_links", []):
        asset = asset_files.get(artwork.get("asset_file_id"))
        if (
            artwork.get("workflow_state") == "consumer-review-passed"
            and asset
            and asset.get("state") in {"canonical-alpha-eligible", "consumer-eligible"}
        ):
            admitted.append((artwork, asset))

    objects: dict[str, dict] = {}
    for source_relative in sorted(pictorial_object_source_paths()):
        try:
            record = tomllib.loads((ROOT / source_relative).read_text(encoding="utf-8"))
        except (OSError, tomllib.TOMLDecodeError) as exc:
            raise ReleaseError(f"cannot read {source_relative}: {exc}") from exc
        object_id = record.get("id")
        if not isinstance(object_id, str) or object_id in objects:
            raise ReleaseError(f"invalid or duplicate pictorial object id in {source_relative}")
        objects[object_id] = record

    grouped: dict[str, dict] = {}
    for artwork, asset in admitted:
        path = _resolve_pictorial_asset_path(
            str(asset.get("path", "")), f"{artwork.get('id')} asset"
        )
        technical = asset.get("technical", {})
        expected_hash = technical.get("sha256")
        if not isinstance(expected_hash, str) or not SHA256_RE.fullmatch(expected_hash):
            raise ReleaseError(f"{asset.get('id')}: missing valid canonical SHA-256")
        actual_hash = sha256(path)
        if actual_hash != expected_hash:
            raise ReleaseError(f"{asset.get('id')}: canonical PNG hash mismatch")
        expected_bytes = technical.get("bytes")
        if expected_bytes != path.stat().st_size:
            raise ReleaseError(f"{asset.get('id')}: canonical PNG byte count mismatch")
        key = path.relative_to(ROOT).as_posix()
        entry = grouped.setdefault(
            key,
            {
                "source": path,
                "sha256": actual_hash,
                "width": technical.get("width_px"),
                "height": technical.get("height_px"),
                "object_ids": set(),
                "views": set(),
                "artwork_ids": set(),
                "rights": set(),
            },
        )
        if entry["sha256"] != actual_hash:
            raise ReleaseError(f"duplicate pictorial path has conflicting bytes: {key}")
        entry["object_ids"].update(artwork.get("object_ids", []))
        entry["views"].add(str(artwork.get("view", "view")))
        entry["artwork_ids"].add(str(artwork.get("id")))
        if isinstance(artwork.get("rights"), str) and artwork["rights"].strip():
            entry["rights"].add(artwork["rights"].strip())

    cards: list[dict] = []
    for source_relative, entry in grouped.items():
        definitions = []
        for object_id in sorted(entry["object_ids"]):
            record = objects.get(object_id)
            if record is None:
                raise ReleaseError(f"{source_relative}: unknown object id {object_id}")
            definition, under_audit = _checked_definition(record)
            definitions.append(
                {
                    "id": object_id,
                    "name": record["preferred_english_name"],
                    "latin": record.get("latin_headword", ""),
                    "category": (record.get("categories") or ["other"])[0],
                    "definition": definition,
                    "under_audit": under_audit,
                }
            )
        if not definitions:
            raise ReleaseError(f"{source_relative}: admitted artwork has no object identity")
        if not all(isinstance(entry[item], int) and entry[item] > 0 for item in ("width", "height")):
            raise ReleaseError(f"{source_relative}: invalid canonical PNG dimensions")
        destination = (
            PICTORIAL_GALLERY_ASSET_ROOT
            / f"{entry['sha256'][:16]}-{Path(source_relative).name}"
        ).as_posix()
        cards.append(
            {
                **entry,
                "source_relative": source_relative,
                "destination": destination,
                "definitions": definitions,
                "sort_name": definitions[0]["name"].casefold(),
            }
        )
    cards.sort(key=lambda item: (item["sort_name"], item["sha256"]))
    return cards


def pictorial_gallery_source_paths() -> set[str]:
    if not (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
