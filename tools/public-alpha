def site_source_binding_errors(manifest: dict) -> list[str]:
    """Prove the approved site-source inventory is complete and exact.

    Manifest validation proves an entry is a well-formed hash naming a file that
    exists; only this proves the two correspond. Verification owns the check
    because `artifact_manifest_data` republishes these hashes inside
    PUBLICATION-MANIFEST.json as an attestation about the files that built the
    artifact, and verification is the last gate before that is published.

    Exactness alone is not the attestation: hashing only what is recorded
    reports exact over an input the record never mentions. `site_source_paths`
    is therefore differenced against the record in both directions here, so the
    published inventory is proved complete as well as current.
    """
    errors: list[str] = []
    authorizations = manifest.get("authorizations")
    if not isinstance(authorizations, dict):
        return errors
    for authorization_id, authorization in sorted(authorizations.items()):
        if not isinstance(authorization, dict):
            continue
        site_sources = authorization.get("site_sources")
        if not isinstance(site_sources, dict):
            continue
        label = f"authorization {authorization_id!r} site source"
        for source_relative, approved_hash in sorted(site_sources.items()):
            if not isinstance(source_relative, str) or not isinstance(approved_hash, str):
                continue
            try:
                source_path = safe_relative_path(source_relative, label)
            except ReleaseError as exc:
                errors.append(str(exc))
                continue
            if source_path.is_symlink() or not source_path.is_file():
                errors.append(f"{label} does not exist: {source_relative}")
                continue
            actual_hash = sha256(source_path)
            if actual_hash != approved_hash:
                errors.append(
                    f"{label} {source_relative} does not match its approved "
                    f"SHA-256: approved {approved_hash}, actual {actual_hash}"
                )
        unrecorded, unrecognized = site_source_inventory_gaps(site_sources)
        for source_relative in unrecorded:
            errors.append(
                f"{label} {source_relative} is recognized by the renderer and "
                "is not in the approved record"
            )
        for source_relative in unrecognized:
            errors.append(
                f"{label} {source_relative} is recorded but the renderer no "
                "longer reads it"
            )
    if errors:
        errors.append(REFRESH_BINDINGS_INSTRUCTION)
    return errors


def _artifact_entry_identity(entry: os.stat_result) -> tuple[int, int, int, int, int, int]:
    """Fields that prove a captured artifact entry is still the same object."""
    return (
        entry.st_dev,
        entry.st_ino,
        entry.st_mode,
        entry.st_size,
        entry.st_mtime_ns,
        entry.st_ctime_ns,
    )


def _scan_artifact_topology(
    root_fd: int,
) -> dict[str, os.stat_result]:
    """Inventory a held artifact tree without following any descendant link."""
    entries: dict[str, os.stat_result] = {}

    def scan(directory_fd: int, parent: PurePosixPath) -> None:
        try:
            names = sorted(os.listdir(directory_fd))
        except OSError as exc:
            raise ReleaseError(f"cannot safely scan artifact directory {parent}: {exc}") from exc
        for name in names:
            relative = parent / name
            label = relative.as_posix()
            try:
                entry = os.stat(name, dir_fd=directory_fd, follow_symlinks=False)
            except OSError as exc:
                raise ReleaseError(
                    f"artifact path changed during verification: {label}"
                ) from exc
            entries[label] = entry
            if not stat.S_ISDIR(entry.st_mode):
                continue
            try:
                child_fd = os.open(name, DIRECTORY_OPEN_FLAGS, dir_fd=directory_fd)
            except OSError as exc:
                raise ReleaseError(
                    f"artifact path changed during verification: {label}"
                ) from exc
            try:
                if not _same_inode(entry, os.fstat(child_fd)):
                    raise ReleaseError(
                        f"artifact path changed during verification: {label}"
                    )
                scan(child_fd, relative)
            finally:
                os.close(child_fd)

    scan(root_fd, PurePosixPath())
    return entries


def _artifact_topology_errors(
    entries: dict[str, os.stat_result],
) -> list[str]:
    errors: list[str] = []
    for relative, entry in entries.items():
        path = PurePosixPath(relative)
        if stat.S_ISLNK(entry.st_mode):
            errors.append(f"artifact contains a symlink: {relative}")
        elif stat.S_ISREG(entry.st_mode):
            if entry.st_nlink != 1:
                errors.append(f"artifact contains an unsafe hard link: {relative}")
            if (
                path.name not in {".nojekyll", "SHA256SUMS", "robots.txt", "_headers"}
                and path.suffix not in TEXT_SUFFIXES | {".pdf", ".png"}
            ):
                errors.append(f"artifact contains an unexpected file type: {relative}")
        elif not stat.S_ISDIR(entry.st_mode):
            errors.append(f"artifact contains a special file: {relative}")
        if any(
            part in {".git", "src", "guidance", "build", "__pycache__"}
            for part in path.parts
        ):
            errors.append(f"artifact contains a forbidden path: {relative}")
        if path.suffix in {".md", ".tex", ".log", ".aux"} or path.name == "retrieved.txt":
            errors.append(f"artifact contains a forbidden source/build file: {relative}")
    return errors


def _open_artifact_parent(
    root_fd: int,
    relative: PurePosixPath,
    topology: dict[str, os.stat_result],
) -> int:
    """Open every parent of an inventoried file from the held artifact root."""
    directory_fd = os.dup(root_fd)
    parent = PurePosixPath()
    try:
        for component in relative.parts[:-1]:
            parent /= component
            label = parent.as_posix()
            expected = topology.get(label)
            if expected is None or not stat.S_ISDIR(expected.st_mode):
                raise ReleaseError(f"artifact path changed during verification: {label}")
            try:
                entry = os.stat(
                    component, dir_fd=directory_fd, follow_symlinks=False
                )
                child_fd = os.open(
                    component, DIRECTORY_OPEN_FLAGS, dir_fd=directory_fd
                )
            except OSError as exc:
                raise ReleaseError(
                    f"artifact path changed during verification: {label}"
                ) from exc
            if (
                not stat.S_ISDIR(entry.st_mode)
                or _artifact_entry_identity(entry)
                != _artifact_entry_identity(expected)
                or not _same_inode(entry, os.fstat(child_fd))
            ):
                os.close(child_fd)
                raise ReleaseError(f"artifact path changed during verification: {label}")
            os.close(directory_fd)
            directory_fd = child_fd
        return directory_fd
    except BaseException:
        os.close(directory_fd)
        raise


def _read_artifact_regular_file(
    root_fd: int,
    relative: str,
    expected: os.stat_result,
    topology: dict[str, os.stat_result],
) -> bytes:
    """Capture one inventoried file through a no-follow descriptor chain."""
    if not getattr(os, "O_NOFOLLOW", 0):
        raise ReleaseError("safe no-follow artifact file opens are unavailable")
    path = PurePosixPath(relative)
    parent_fd = _open_artifact_parent(root_fd, path, topology)
    descriptor: int | None = None
    try:
        try:
            entry = os.stat(path.name, dir_fd=parent_fd, follow_symlinks=False)
            descriptor = os.open(
                path.name,
                os.O_RDONLY
                | getattr(os, "O_CLOEXEC", 0)
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0),
                dir_fd=parent_fd,
            )
        except OSError as exc:
            raise ReleaseError(
                f"artifact path changed during verification: {relative}"
            ) from exc
        opened = os.fstat(descriptor)
        if (
            not stat.S_ISREG(entry.st_mode)
            or not stat.S_ISREG(opened.st_mode)
            or _artifact_entry_identity(entry) != _artifact_entry_identity(expected)
            or not _same_inode(entry, opened)
        ):
            raise ReleaseError(f"artifact path changed during verification: {relative}")
        chunks: list[bytes] = []
        while chunk := os.read(descriptor, 1024 * 1024):
            chunks.append(chunk)
        if _artifact_entry_identity(os.fstat(descriptor)) != _artifact_entry_identity(
            expected
        ):
            raise ReleaseError(f"artifact changed while being read: {relative}")
        return b"".join(chunks)
    finally:
        if descriptor is not None:
            os.close(descriptor)
        os.close(parent_fd)


@contextmanager
def _capture_artifact_snapshot(
    root_fd: int,
    topology: dict[str, os.stat_result],
):
    """Materialize descriptor-captured bytes for all path-based verifiers."""
    with tempfile.TemporaryDirectory(prefix="triptych-public-alpha-verify-") as temporary:
        temporary_path = Path(temporary)
        temporary_fd = os.open(temporary_path, DIRECTORY_OPEN_FLAGS)
        snapshot_fd: int | None = None
        try:
            os.mkdir("artifact", dir_fd=temporary_fd)
            snapshot_fd = _open_child_directory(
                temporary_fd, temporary_path, "artifact", create=False
            )
            snapshot = _descriptor_path(snapshot_fd)
            for relative, entry in sorted(
                topology.items(),
                key=lambda item: (len(PurePosixPath(item[0]).parts), item[0]),
            ):
                destination = snapshot.joinpath(*PurePosixPath(relative).parts)
                if stat.S_ISDIR(entry.st_mode):
                    destination.mkdir()
                elif stat.S_ISREG(entry.st_mode):
                    destination.write_bytes(
                        _read_artifact_regular_file(
                            root_fd, relative, entry, topology
                        )
                    )
            yield snapshot
        finally:
            if snapshot_fd is not None:
                os.close(snapshot_fd)
            os.close(temporary_fd)


def _require_artifact_topology_matches(
    root_fd: int,
    expected: dict[str, os.stat_result],
) -> None:
    current = _scan_artifact_topology(root_fd)
    if current.keys() != expected.keys():
        raise ReleaseError("artifact contents changed during verification")
    for relative, entry in current.items():
        if _artifact_entry_identity(entry) != _artifact_entry_identity(expected[relative]):
            raise ReleaseError(f"artifact path changed during verification: {relative}")


def _verify_output_contents(
    manifest: dict,
    publications: dict[tuple[str, str], dict],
    output_fd: int,
    preview: bool,
) -> None:
    """Capture a held artifact safely, then verify only its immutable copy."""
    topology = _scan_artifact_topology(output_fd)
    topology_errors = _artifact_topology_errors(topology)
    unsafe = [
        error
        for error in topology_errors
        if error.startswith("artifact contains a symlink:")
        or error.startswith("artifact contains a special file:")
        or error.startswith("artifact contains an unsafe hard link:")
    ]
    if unsafe:
        errors = site_source_binding_errors(manifest) + topology_errors
        raise ReleaseError("Public-alpha artifact verification failed:\n- " + "\n- ".join(errors))
    with _capture_artifact_snapshot(output_fd, topology) as snapshot:
        try:
            _verify_snapshot_contents(manifest, publications, snapshot, preview)
        finally:
            _require_artifact_topology_matches(output_fd, topology)


def _verify_snapshot_contents(
    manifest: dict,
    publications: dict[tuple[str, str], dict],
    output: Path,
    preview: bool,
) -> None:
    errors: list[str] = site_source_binding_errors(manifest)
    primary, _ = declared_providers(manifest)
    included = included_publications(publications, preview)
    expected_authorization = artifact_authorization(manifest, included)
    expected_pdf_paths = {f"pdf/{provider}/{leaf}.pdf" for provider, leaf in included}
    # The tracks are PDFs under pdf/ that belong to no publication record, so
    # they are named here as well as in the file set: the publication check
    # below is what proves no publication's PDF is missing, and it must not
    # read a track as a publication that has escaped the manifest.
    expected_pdf_paths |= set(reading_plan_pdfs())
    if not output.is_dir():
        raise ReleaseError(f"artifact does not exist: {output.relative_to(ROOT)}")

    actual_file_paths: set[str] = set()
    actual_pdf_paths: set[str] = set()
    unsafe_topology_errors: list[str] = []
    for path in output.rglob("*"):
        relative = path.relative_to(output).as_posix()
        if path.is_symlink():
            error = f"artifact contains a symlink: {relative}"
            errors.append(error)
            unsafe_topology_errors.append(error)
            actual_file_paths.add(relative)
        elif path.is_file():
            actual_file_paths.add(relative)
            if path.suffix == ".pdf":
                actual_pdf_paths.add(relative)
            elif path.name not in {".nojekyll", "SHA256SUMS", "robots.txt", "_headers"} and path.suffix not in TEXT_SUFFIXES | {".png"}:
                errors.append(f"artifact contains an unexpected file type: {relative}")
        elif not path.is_dir():
            error = f"artifact contains a special file: {relative}"
            errors.append(error)
            unsafe_topology_errors.append(error)
        if any(part in {".git", "src", "guidance", "build", "__pycache__"} for part in path.relative_to(output).parts):
            errors.append(f"artifact contains a forbidden path: {relative}")
        if path.suffix in {".md", ".tex", ".log", ".aux"} or path.name == "retrieved.txt":
            errors.append(f"artifact contains a forbidden source/build file: {relative}")

    # Every later verification pass opens artifact files.  Once the topology
    # scan has found an entry that could redirect or synthesize those reads,
    # report it before any hash, parser, or privacy scanner touches the tree.
    if unsafe_topology_errors:
        raise ReleaseError("Public-alpha artifact verification failed:\n- " + "\n- ".join(errors))

    expected_file_paths = expected_artifact_files(
        manifest, included, preview, expected_authorization
    )
    if actual_file_paths != expected_file_paths:
        errors.append(
            "artifact file-set mismatch: "
            f"missing={sorted(expected_file_paths - actual_file_paths)!r}, "
            f"extra={sorted(actual_file_paths - expected_file_paths)!r}"
        )

    if actual_pdf_paths != expected_pdf_paths:
        errors.append(
            "artifact PDF mismatch: "
            f"missing={sorted(expected_pdf_paths - actual_pdf_paths)!r}, "
            f"extra={sorted(actual_pdf_paths - expected_pdf_paths)!r}"
        )

    artifact_manifest_path = output / "PUBLICATION-MANIFEST.json"
    try:
        artifact_manifest = json.loads(artifact_manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid PUBLICATION-MANIFEST.json: {exc}")
        artifact_manifest = {}
    if artifact_manifest != artifact_manifest_data(manifest, included, preview):
        errors.append("artifact manifest does not exactly match the release policy")
    for key, publication in included.items():
        provider, leaf = key
        pdf_path = output / "pdf" / provider / f"{leaf}.pdf"
        if pdf_path.is_file():
            actual_hash = sha256(pdf_path)
            expected_hash = sha256(ROOT / "pdf" / provider / f"{leaf}.pdf")
            mismatch = "does not match its alpha SHA-256"
            if actual_hash != expected_hash:
                errors.append(
                    f"{publication_label(key, primary)}: artifact PDF {mismatch}"
                )

    included_ids = set(included)
    rendered_pages = {**PAGE_MAP, **included_document_pages(included_ids)}
    for source_relative, output_relative in rendered_pages.items():
        html_path = output / output_relative
        if html_path.is_file() and html_path.read_text(
            encoding="utf-8", errors="replace"
        ) != render_source_page(
            source_relative,
            output_relative,
            included_ids,
            preview,
            expected_authorization,
        ):
            errors.append(f"{output_relative}: rendered page does not match its approved source")

    for output_relative, source in sorted(web_browser_pages().items()):
        html_path = output / output_relative
        if html_path.is_file() and html_path.read_text(
            encoding="utf-8", errors="replace"
        ) != render_browser_page(
            source, output_relative, preview, expected_authorization
        ):
            errors.append(f"{output_relative}: rendered page does not match its approved source")

    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        gallery_path = output / PICTORIAL_GALLERY_OUTPUT
        expected_gallery = render_pictorial_gallery(preview, expected_authorization)
        if gallery_path.is_file() and gallery_path.read_text(
            encoding="utf-8", errors="replace"
        ) != expected_gallery:
            errors.append(f"{PICTORIAL_GALLERY_OUTPUT}: generated gallery does not match canonical inputs")
        for card in pictorial_gallery_data():
            artifact_path = output / card["destination"]
            if artifact_path.is_file() and sha256(artifact_path) != card["sha256"]:
                errors.append(f"{card['destination']}: gallery PNG does not match canonical bytes")

    static_sources = [
        *[
            (TEMPLATE_ROOT / asset_relative, output / asset_relative)
            for asset_relative in ("assets/site.css", SOCIAL_CARD_RELATIVE, SITE_ICON_RELATIVE)
        ],
        *[
            (ROOT / source_relative, output / source_relative)
            for source_relative in artifact_license_source_paths()
        ],
        *[
            (source, output / destination_relative)
            for destination_relative, source in sorted(reading_plan_pdfs().items())
        ],
    ]
    for source_path, artifact_path in static_sources:
        if artifact_path.is_file() and sha256(artifact_path) != sha256(source_path):
            errors.append(
                f"{artifact_path.relative_to(output)}: static file does not match its repository source"
            )

    nojekyll_path = output / ".nojekyll"
    if nojekyll_path.is_file() and nojekyll_path.read_bytes() != b"":
        errors.append(".nojekyll must be empty")

    disallowed_ids = set(publications) - set(included)
    privacy_patterns = {
        # A machine-local home path, not a /home/ segment in some host's URL.
        re.compile(r"(?<![\w.-])/home/[A-Za-z0-9._-]+"): "home-directory path",
        re.compile(r"file://"): "local file URL",
        re.compile(r"github_pat_"): "GitHub token pattern",
        re.compile(r"ghp_"): "GitHub token pattern",
        re.compile(r"BEGIN PRIVATE KEY"): "private key marker",
    }
    for path in output.rglob("*"):
        if not path.is_file() or path.suffix not in TEXT_SUFFIXES and path.name not in {"robots.txt", "SHA256SUMS", "_headers"}:
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        relative = path.relative_to(output).as_posix()
        for pattern, label in privacy_patterns.items():
            if pattern.search(text):
                errors.append(f"{relative}: contains {label}")
        if path.suffix == ".html":
            for href in parsed_html(path).links:
                for excluded_key in disallowed_ids:
                    excluded_provider, excluded_leaf = excluded_key
                    # Every surface an excluded publication could reach the
                    # reader through: its PDF and its web edition alike.
                    excluded_targets = (
                        f"pdf/{excluded_provider}/{excluded_leaf}.pdf",
                        f"web/{excluded_provider}/{excluded_leaf}.html",
                    )
                    if any(target in unquote(href) for target in excluded_targets):
                        errors.append(
                            f"{relative}: links to excluded publication "
                            f"{publication_label(excluded_key, primary)}"
                        )

    robots = (output / "robots.txt").read_text(encoding="utf-8", errors="replace") if (output / "robots.txt").is_file() else ""
    controlled_hosting = requires_unadvertised_controls(expected_authorization)
    expected_robots = "User-agent: *\nDisallow: /\n" if preview else "User-agent: *\nAllow: /\n"
    if robots != expected_robots:
        errors.append("robots.txt does not exactly match the release mode")

    headers_path = output / "_headers"
    if preview or controlled_hosting:
        if not headers_path.is_file():
            errors.append("no-index artifact is missing _headers")
        elif headers_path.read_text(encoding="utf-8", errors="replace") != headers_policy_text(
            expected_authorization, preview
        ):
            errors.append("_headers does not exactly match the release policy")

    if not preview and controlled_hosting:
        worker_path = output / "_worker.js"
        expected_expiry = expected_authorization.get("expires_at")
        if expected_expiry:
            if not worker_path.is_file():
                errors.append("temporary public artifact is missing _worker.js")
            elif worker_path.read_text(
                encoding="utf-8", errors="replace"
            ) != worker_policy_text(expected_authorization):
                errors.append("_worker.js does not exactly match the release policy")
        elif worker_path.exists():
            errors.append("perpetual public artifact must not contain a cutoff _worker.js")
        hosting_conditions_path = output / "HOSTING-CONDITIONS.txt"
        if not hosting_conditions_path.is_file():
            errors.append("unadvertised public artifact is missing HOSTING-CONDITIONS.txt")
        elif hosting_conditions_path.read_text(
            encoding="utf-8", errors="replace"
        ) != hosting_conditions_text(expected_authorization):
            errors.append("HOSTING-CONDITIONS.txt does not exactly match the release policy")
        for html_path in output.rglob("*.html"):
            page = html_path.read_text(encoding="utf-8", errors="replace")
            if f'<meta name="robots" content="{ROBOTS_DIRECTIVES}">' not in page:
                errors.append(f"{html_path.relative_to(output)}: missing unadvertised no-index metadata")
            expiry_marker = '<meta name="triptych-authorization-expires"'
            if expected_expiry:
                if f'{expiry_marker} content="{expected_expiry}">' not in page:
                    errors.append(f"{html_path.relative_to(output)}: missing authorization expiry metadata")
            elif expiry_marker in page:
                errors.append(f"{html_path.relative_to(output)}: has expiry metadata for perpetual authorization")
            if '<meta name="robots" content="index, follow">' in page:
                errors.append(f"{html_path.relative_to(output)}: public indexing is enabled")

    errors.extend(verify_link_previews(output, preview, expected_authorization))
    errors.extend(verify_links(output))
    errors.extend(verify_catalog_reachability(manifest, included, output))
    errors.extend(verify_web_data(output))
    checksum_path = output / "SHA256SUMS"
    if not checksum_path.is_file():
        errors.append("artifact is missing SHA256SUMS")
    elif checksum_path.read_text(encoding="utf-8") != expected_checksum_text(output):
        errors.append("SHA256SUMS does not match artifact contents")

    if errors:
        raise ReleaseError("Public-alpha artifact verification failed:\n- " + "\n- ".join(errors))


def verify_output(
    manifest: dict,
    publications: dict[tuple[str, str], dict],
    output: Path,
    preview: bool,
) -> None:
    """Verify the fixed artifact while holding every parent directory open."""
    expected = OUTPUT_ROOT / ("preview" if preview else "site")
    if output != expected:
        raise ReleaseError(f"refusing unsafe verification path: {output} is not {expected}")
    with _public_alpha_parent(create=False) as parent_fd:
        target = "preview" if preview else "site"
        output_fd = _open_child_directory(
            parent_fd, OUTPUT_ROOT, target, create=False
        )
        try:
            _verify_output_contents(
                manifest,
                publications,
                output_fd,
                preview,
            )
            _require_entry_matches_fd(
                parent_fd, target, output_fd, OUTPUT_ROOT / target
            )
        finally:
            os.close(output_fd)


SOCIAL_PROPERTY_RE = re.compile(r'<meta property="(og:[a-z_:]+)" content="([^"]*)">')
SOCIAL_NAME_RE = re.compile(r'<meta name="((?:twitter:[a-z]+)|description)" content="([^"]*)">')
# TN3156, "Respect resource usage guidelines": the previewed document is limited
# to 1 MB, preview images should be at least 900 pixels wide, and icons should
# be square and at least 108 pixels per side.
PREVIEW_DOCUMENT_LIMIT = 1_000_000
PREVIEW_IMAGE_MINIMUM_WIDTH = 900
PREVIEW_ICON_MINIMUM_SIDE = 108


def verify_link_previews(output: Path, preview: bool, authorization: dict) -> list[str]:
    """Prove every page can actually raise a link preview.

    Nothing renders these tags locally, so a page that quietly lost them looks
    exactly like a page that has them until someone sends the link to a phone.
    The numbers checked here are Apple's own, from TN3156.
    """
    errors: list[str] = []
    advertised = not preview and not requires_unadvertised_controls(authorization)
    required_properties = {
        "og:type",
        "og:site_name",
        "og:title",
        "og:description",
        "og:url",
        "og:image",
        "og:image:width",
        "og:image:height",
    }

    icon = output / SITE_ICON_RELATIVE
    if not icon.is_file():
        errors.append(f"{SITE_ICON_RELATIVE}: the artifact carries no icon for a link preview")
    else:
        width, height = png_dimensions(icon)
        if width != height or width < PREVIEW_ICON_MINIMUM_SIDE:
            errors.append(
                f"{SITE_ICON_RELATIVE}: icon is {width}x{height}; a preview icon must be "
                f"square and at least {PREVIEW_ICON_MINIMUM_SIDE} pixels a side"
            )

    for path in sorted(output.rglob("*.html")):
        relative = path.relative_to(output).as_posix()
        page = path.read_text(encoding="utf-8", errors="replace")
        size = path.stat().st_size
        if size > PREVIEW_DOCUMENT_LIMIT:
            errors.append(
                f"{relative}: {size} bytes exceeds the {PREVIEW_DOCUMENT_LIMIT}-byte "
                "document limit a link preview will fetch"
            )
        names = dict(SOCIAL_NAME_RE.findall(page))
        if not names.get("description"):
            errors.append(f"{relative}: no description metadata")
        if 'rel="apple-touch-icon"' not in page:
            errors.append(f"{relative}: no apple-touch-icon for the preview's icon")
        page_advertised = advertised and (
            f'<meta name="robots" content="{ROBOTS_DIRECTIVES}">' not in page
        )
        if not page_advertised:
            # A no-index copy deliberately carries no absolute public URLs.
            if SOCIAL_PROPERTY_RE.search(page):
                errors.append(f"{relative}: a no-index artifact must not advertise the public site")
            continue
        properties = dict(SOCIAL_PROPERTY_RE.findall(page))
        for missing in sorted(required_properties - set(properties)):
            errors.append(f"{relative}: no {missing} metadata")
        if names.get("twitter:card") != "summary_large_image":
            errors.append(f"{relative}: no summary_large_image twitter:card")
        title = properties.get("og:title", "")
        if title.endswith(f"· {SITE_NAME}"):
            errors.append(
                f"{relative}: og:title repeats the site name, which belongs in og:site_name"
            )
        expected_url = public_site_url(relative)
        if properties.get("og:url") != expected_url:
            errors.append(f"{relative}: og:url is not {expected_url}")
        image = properties.get("og:image", "")
        expected_image = public_site_url(SOCIAL_CARD_RELATIVE)
        if image != expected_image:
            errors.append(f"{relative}: og:image is not {expected_image}")
            continue
        card = output / SOCIAL_CARD_RELATIVE
        if not card.is_file():
            errors.append(f"{relative}: og:image {image} is not in the artifact")
            continue
        width, height = png_dimensions(card)
        if width < PREVIEW_IMAGE_MINIMUM_WIDTH:
            errors.append(
                f"{relative}: og:image is {width} pixels wide; a preview image should be "
                f"at least {PREVIEW_IMAGE_MINIMUM_WIDTH}"
            )
        if properties.get("og:image:width") != str(width) or properties.get(
            "og:image:height"
        ) != str(height):
            errors.append(f"{relative}: og:image dimensions disagree with the image itself")
    return errors


class StagingWriter:
    """Create one artifact tree solely through held directory descriptors."""

    def __init__(self, root_fd: int):
        if not getattr(os, "O_NOFOLLOW", 0) or not getattr(os, "O_DIRECTORY", 0):
            raise ReleaseError(
                "descriptor-safe staged artifact writes are unavailable"
            )
        self.root_fd = os.dup(root_fd)
        self.directories: dict[PurePosixPath, os.stat_result] = {
            PurePosixPath(): os.fstat(self.root_fd)
        }
        self.files: dict[str, tuple[str, os.stat_result]] = {}

    def close(self) -> None:
        if self.root_fd >= 0:
            os.close(self.root_fd)
            self.root_fd = -1

    def __enter__(self) -> StagingWriter:
        return self

    def __exit__(self, *_exc) -> None:
        self.close()

    @staticmethod
    def _relative(value: str | PurePosixPath) -> PurePosixPath:
        path = PurePosixPath(value)
        if (
            path.is_absolute()
            or not path.parts
            or any(part in {"", ".", ".."} for part in path.parts)
        ):
            raise ReleaseError(f"unsafe staged artifact path: {value}")
        return path

    def _open_directory(self, path: PurePosixPath) -> int:
        """Reopen a recorded chain with at most one descendant fd held."""
        descriptor = os.dup(self.root_fd)
        current = PurePosixPath()
        try:
            for component in path.parts:
                current /= component
                expected = self.directories.get(current)
                if expected is None:
                    raise ReleaseError(
                        f"staged directory changed during build: {current}"
                    )
                entry = _entry_stat(descriptor, component)
                if (
                    entry is None
                    or not stat.S_ISDIR(entry.st_mode)
                    or not _same_inode(entry, expected)
                ):
                    raise ReleaseError(
                        f"staged directory changed during build: {current}"
                    )
                try:
                    child_fd = os.open(
                        component, DIRECTORY_OPEN_FLAGS, dir_fd=descriptor
                    )
                except OSError as exc:
                    raise ReleaseError(
                        f"staged directory changed during build: {current}"
                    ) from exc
                if not _same_inode(entry, os.fstat(child_fd)):
                    os.close(child_fd)
                    raise ReleaseError(
                        f"staged directory changed during build: {current}"
                    )
                os.close(descriptor)
                descriptor = child_fd
            return descriptor
        except BaseException:
            os.close(descriptor)
            raise

    def _directory(self, path: PurePosixPath) -> int:
        if path in self.directories:
            return self._open_directory(path)
        parent_fd = self._directory(path.parent)
        try:
            try:
                os.mkdir(path.name, dir_fd=parent_fd)
            except OSError as exc:
                raise ReleaseError(
                    f"could not exclusively create staged directory: {path}"
                ) from exc
            entry = _entry_stat(parent_fd, path.name)
            if entry is None or not stat.S_ISDIR(entry.st_mode):
                raise ReleaseError(f"staged directory changed while opening: {path}")
            try:
                descriptor = os.open(
                    path.name, DIRECTORY_OPEN_FLAGS, dir_fd=parent_fd
                )
            except OSError as exc:
                raise ReleaseError(
                    f"staged directory changed while opening: {path}"
                ) from exc
            if not _same_inode(entry, os.fstat(descriptor)):
                os.close(descriptor)
                raise ReleaseError(f"staged directory changed while opening: {path}")
            self.directories[path] = entry
            return descriptor
        finally:
            os.close(parent_fd)

    def _validate_directories(self) -> None:
        for path in sorted(self.directories, key=lambda item: len(item.parts)):
            descriptor = self._open_directory(path)
            os.close(descriptor)

    def _write(self, relative: str, chunks: Iterable[bytes]) -> None:
        path = self._relative(relative)
        label = path.as_posix()
        if label in self.files or path in self.directories:
            raise ReleaseError(f"staged artifact path written twice: {label}")
        parent_fd = self._directory(path.parent)
        descriptor: int | None = None
        digest = hashlib.sha256()
        try:
            try:
                descriptor = os.open(
                    path.name,
                    os.O_WRONLY
                    | os.O_CREAT
                    | os.O_EXCL
                    | getattr(os, "O_CLOEXEC", 0)
                    | getattr(os, "O_NOFOLLOW", 0)
                    | getattr(os, "O_NONBLOCK", 0),
                    0o666,
                    dir_fd=parent_fd,
                )
            except OSError as exc:
                raise ReleaseError(
                    f"could not exclusively create staged file: {label}"
                ) from exc
            opened = os.fstat(descriptor)
            entry = _entry_stat(parent_fd, path.name)
            if (
                entry is None
                or not stat.S_ISREG(entry.st_mode)
                or entry.st_nlink != 1
                or not _same_inode(entry, opened)
            ):
                raise ReleaseError(f"staged file changed while opening: {label}")
            size = 0
            for chunk in chunks:
                digest.update(chunk)
                view = memoryview(chunk)
                while view:
                    written = os.write(descriptor, view)
                    if written <= 0:
                        raise ReleaseError(f"short write to staged file: {label}")
                    size += written
                    view = view[written:]
            final = os.fstat(descriptor)
            current = _entry_stat(parent_fd, path.name)
            if (
                current is None
                or not stat.S_ISREG(final.st_mode)
                or final.st_nlink != 1
                or final.st_size != size
                or not _same_inode(current, final)
            ):
                raise ReleaseError(f"staged file changed while writing: {label}")
            self.files[label] = (digest.hexdigest(), final)
            check_fd = self._open_directory(path.parent)
            os.close(check_fd)
        finally:
            if descriptor is not None:
                try:
                    current = os.fstat(descriptor)
                    self.files.setdefault(label, ("", current))
                finally:
                    os.close(descriptor)
            os.close(parent_fd)

    def copy(self, source: Path, relative: str) -> None:
        with source.open("rb") as stream:
            self._write(
                relative,
                iter(lambda: stream.read(1024 * 1024), b""),
            )

    def text(self, relative: str, value: str) -> None:
        self._write(relative, (value.encode("utf-8"),))

    def checksums(self) -> None:
        lines = [
            f"{self.files[relative][0]}  {relative}"
            for relative in sorted(self.files, key=PurePosixPath)
        ]
        self.text("SHA256SUMS", "\n".join(lines) + "\n")

    def cleanup_topology(self) -> dict[str, os.stat_result]:
        topology = {
            path.as_posix(): entry
            for path, entry in self.directories.items()
            if path.parts
        }
        topology.update(
            {relative: entry for relative, (_digest, entry) in self.files.items()}
        )
        return topology

    def finish(self) -> dict[str, os.stat_result]:
        self._validate_directories()
        expected = self.cleanup_topology()
        current = _scan_artifact_topology(self.root_fd)
        if current.keys() != expected.keys():
            raise ReleaseError("staged artifact contents changed during build")
        for relative, entry in current.items():
            recorded = expected[relative]
            if stat.S_ISDIR(recorded.st_mode):
                matches = stat.S_ISDIR(entry.st_mode) and _same_inode(entry, recorded)
            else:
                matches = _artifact_entry_identity(entry) == _artifact_entry_identity(
                    recorded
                )
            if not matches:
                raise ReleaseError(f"staged artifact changed during build: {relative}")
        unsafe = [
            error
            for error in _artifact_topology_errors(current)
            if error.startswith("artifact contains a symlink:")
            or error.startswith("artifact contains a special file:")
            or error.startswith("artifact contains an unsafe hard link:")
        ]
        if unsafe:
            raise ReleaseError("unsafe staged artifact:\n- " + "\n- ".join(unsafe))
        return current


def assemble_web_data(
    writer: StagingWriter | Path, preview: bool, authorization: dict
) -> None:
    """Assemble the reading pages, their shared machinery, and the corpus."""
    if isinstance(writer, Path):
        output = writer
        try:
            output.mkdir()
            entry = os.stat(output, follow_symlinks=False)
            output_fd = os.open(output, DIRECTORY_OPEN_FLAGS)
        except OSError as exc:
            raise ReleaseError(
                f"cannot safely create browser-data output {output}: {exc}"
            ) from exc
        try:
            if not _same_inode(entry, os.fstat(output_fd)):
                raise ReleaseError(
                    f"browser-data output changed while opening: {output}"
                )
            with StagingWriter(output_fd) as anchored:
                assemble_web_data(anchored, preview, authorization)
                anchored.finish()
        finally:
            os.close(output_fd)
        return
    for destination_relative, source in sorted(web_data_files().items()):
        writer.copy(source, destination_relative)
    for output_relative, source in sorted(web_browser_pages().items()):
        writer.text(
            output_relative,
            render_browser_page(source, output_relative, preview, authorization),
        )


def _build_site_contents(
    manifest: dict,
    publications: dict[tuple[str, str], dict],
    preview: bool,
    writer: StagingWriter,
) -> None:
    included = included_publications(publications, preview)
    authorization = artifact_authorization(manifest, included)

    for asset_relative in ("assets/site.css", SOCIAL_CARD_RELATIVE, SITE_ICON_RELATIVE):
        writer.copy(TEMPLATE_ROOT / asset_relative, asset_relative)

    for source_relative in artifact_license_source_paths():
        license_path = ROOT / source_relative
        writer.copy(license_path, source_relative)

    for provider, leaf in sorted(included):
        source = ROOT / "pdf" / provider / f"{leaf}.pdf"
        writer.copy(source, f"pdf/{provider}/{leaf}.pdf")

    for destination_relative, source in sorted(reading_plan_pdfs().items()):
        writer.copy(source, destination_relative)

    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        for card in pictorial_gallery_data():
            writer.copy(card["source"], card["destination"])

    assemble_web_data(writer, preview, authorization)

    included_ids = set(included)
    rendered_pages = {**PAGE_MAP, **included_document_pages(included_ids)}
    for source_relative, output_relative in rendered_pages.items():
        writer.text(
            output_relative,
            render_source_page(
                source_relative,
                output_relative,
                included_ids,
                preview,
                authorization,
            ),
        )
    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        writer.text(
            PICTORIAL_GALLERY_OUTPUT,
            render_pictorial_gallery(preview, authorization),
        )

    artifact_manifest = artifact_manifest_data(manifest, included, preview)
    writer.text(
        "PUBLICATION-MANIFEST.json",
        json.dumps(artifact_manifest, indent=2, ensure_ascii=False) + "\n",
    )
    writer.text(".nojekyll", "")
    controlled_hosting = requires_unadvertised_controls(authorization)
    robots = "User-agent: *\nDisallow: /\n" if preview else "User-agent: *\nAllow: /\n"
    writer.text("robots.txt", robots)
    if preview or controlled_hosting:
        writer.text("_headers", headers_policy_text(authorization, preview))
    if not preview and controlled_hosting:
        if authorization.get("expires_at"):
            writer.text("_worker.js", worker_policy_text(authorization))
        writer.text(
            "HOSTING-CONDITIONS.txt",
            hosting_conditions_text(authorization),
        )
    writer.checksums()


def build_site(
    manifest: dict, publications: dict[tuple[str, str], dict], preview: bool
) -> Path:
    """Build privately, then atomically replace the fixed artifact directory."""
    target = "preview" if preview else "site"
    with _public_alpha_parent(create=True) as parent_fd:
        current = _entry_stat(parent_fd, target)
        if current is not None:
            if stat.S_ISLNK(current.st_mode):
                raise ReleaseError(
                    f"refusing unsafe output path: {OUTPUT_ROOT / target} is a symlink"
                )
            if not stat.S_ISDIR(current.st_mode):
                raise ReleaseError(
                    f"refusing unsafe output path: {OUTPUT_ROOT / target} is not a directory"
                )
        staged, staged_fd = _new_directory_entry(parent_fd, f"{target}-build")
        writer: StagingWriter | None = None
        try:
            writer = StagingWriter(staged_fd)
            _build_site_contents(
                manifest,
                publications,
                preview,
                writer,
            )
            staged_topology = writer.finish()
            try:
                _replace_directory_entry(
                    parent_fd,
                    staged,
                    staged_fd,
                    target,
                    validate_installed=lambda: _require_artifact_topology_matches(
                        staged_fd, staged_topology
                    ),
                )
            except InstalledCleanupError:
                staged = ""
                raise
            try:
                _require_entry_matches_fd(
                    parent_fd, target, staged_fd, OUTPUT_ROOT / target
                )
                _require_artifact_topology_matches(staged_fd, staged_topology)
            except ReleaseError:
                installed = _entry_stat(parent_fd, target)
                if (
                    installed is not None
                    and _same_inode(installed, os.fstat(staged_fd))
                    and _entry_stat(parent_fd, staged) is None
                ):
                    os.rename(
                        target,
                        staged,
                        src_dir_fd=parent_fd,
                        dst_dir_fd=parent_fd,
                    )
                raise
            staged = ""
        finally:
            try:
                if staged:
                    _remove_directory_entry(
                        parent_fd,
                        staged,
                        staged_fd,
                        writer.cleanup_topology() if writer is not None else {},
                    )
            finally:
                try:
                    if writer is not None:
                        writer.close()
                finally:
                    os.close(staged_fd)
    return OUTPUT_ROOT / target


def print_policy_summary(manifest: dict, publications: dict[tuple[str, str], dict]) -> None:
    counts = Counter(publication["status"] for publication in publications.values())
    alpha_count = counts["release"] + counts["review"]
    print(
        "public-alpha policy valid: "
        f"{len(publications)} publications "
        f"({alpha_count} alpha, {counts['hold']} hold)"
    )
    if alpha_count == 0:
        print("public build is fail-closed: no PDFs are currently cleared for distribution")
    else:
        authorization = artifact_authorization(manifest, included_publications(publications, False))
        condition_summary = ", ".join(authorization.get("conditions", []))
        if authorization.get("expires_at"):
            print(
                "temporary authorization active: "
                f"{condition_summary}; expires at {authorization['expires_at']} "
                f"({authorization['timezone']})"
            )
        else:
            print(
                "perpetual authorization active: "
                f"{condition_summary}; effective from {authorization['effective_at']} "
                f"({authorization['timezone']})"
            )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=("check", "prepare", "build", "verify"),
        help=(
            "prepare prints a candidate hash inventory only; it never records "
            "approval or changes release files"
        ),
    )
    parser.add_argument(
        "--preview",
        action="store_true",
        help="use a private, no-index preview of the public-alpha publication set",
    )
    parser.add_argument(
        "--deployment-target",
        choices=("github-pages",),
        help="with verify, reject conditions the named deployment target cannot enforce",
    )
    with_examples(parser, tuple(e for verb in EXAMPLES for e in EXAMPLES[verb]))
    args = parser.parse_args()
    try:
        manifest = load_manifest()
        if args.deployment_target and (args.command != "verify" or args.preview):
            raise ReleaseError(
                "--deployment-target is valid only for public artifact verification"
            )
        if args.command == "prepare":
            if args.preview:
                raise ReleaseError("--preview is not meaningful with prepare")
            inventory = prepare_candidate_inventory(manifest)
            print(json.dumps(inventory, indent=2, sort_keys=True, ensure_ascii=False))
            return 0
        publications = validate_manifest(manifest, require_active_release=not args.preview)
        if args.command == "check":
            if args.preview:
                raise ReleaseError("--preview is not meaningful with check")
            print_policy_summary(manifest, publications)
        elif args.command == "build":
            output = build_site(manifest, publications, args.preview)
            verify_command = "verify --preview" if args.preview else "verify"
            print(
                f"built {output.relative_to(ROOT)}; not verified — run "
                f"tools/public-alpha {verify_command} before publication"
            )
        else:
            output = OUTPUT_ROOT / ("preview" if args.preview else "site")
            verify_output(manifest, publications, output, args.preview)
            if args.deployment_target:
                validate_deployment_target(
                    artifact_authorization(
                        manifest, included_publications(publications, False)
                    ),
                    args.deployment_target,
                )
            print(f"verified {output.relative_to(ROOT)}")
    except ReleaseError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
