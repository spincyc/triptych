            latin = definition["latin"]
            latin_text = (
                f' <span class="gallery-latin" lang="la">({html.escape(latin)})</span>'
                if latin and latin != "Latin term not asserted"
                else ""
            )
            descriptions.append(
                f'<dt>{html.escape(definition["name"])}{latin_text}</dt>'
                f'<dd>{html.escape(definition["definition"])}</dd>'
            )
        views = ", ".join(sorted(card["views"])).replace("-", " ")
        rights = "".join(
            f'<p class="gallery-rights">{html.escape(statement)}</p>'
            for statement in sorted(card["rights"])
        )
        blocks.extend(
            [
                f'<figure class="gallery-card"{category_id}>',
                '<div class="gallery-image">',
                (
                    f'<img src="../{html.escape(card["destination"], quote=True)}" '
                    f'width="{card["width"]}" height="{card["height"]}" loading="lazy" '
                    f'decoding="async" alt="{html.escape("Pencil study: " + title, quote=True)}">'
                ),
                "</div>",
                "<figcaption>",
                f"<h2>{html.escape(title)}</h2>",
                f'<p class="gallery-view">{html.escape(views.title())}</p>',
                f'<dl>{"".join(descriptions)}</dl>',
                rights,
                "</figcaption>",
                "</figure>",
            ]
        )
    blocks.extend(
        [
            "</div>",
            "",
            (
                '<p class="gallery-note">Definitions are drawn only from verified claims '
                "in the canonical object records, preferring identity and liturgical-use "
                "claims before narrower ceremonial or appearance descriptions. The drawings "
                "are study aids, not substitutes for the governing liturgical books or "
                "local direction.</p>"
            ),
            (
                '<p class="gallery-note gallery-rights-context">Each image follows its '
                "tracked artwork audit. Project-created content follows the "
                '<a href="../license.html">Triptych licensing statement</a>; source and '
                "third-party boundaries, including required attributions, remain governed "
                'by the <a href="../third-party.html">third-party material notice</a>. '
                "A card prints an additional rights statement only when its structured "
                "artwork record supplies one.</p>"
            ),
        ]
    )
    return render_page(
        PICTORIAL_MANIFEST_RELATIVE.as_posix(),
        "\n".join(blocks) + "\n",
        PICTORIAL_GALLERY_OUTPUT,
        preview,
        authorization,
    )


class LinkParser(HTMLParser):
    def __init__(self) -> None:
        super().__init__(convert_charrefs=True)
        self.links: list[str] = []
        self.ids: set[str] = set()

    def handle_starttag(self, tag: str, attrs: list[tuple[str, str | None]]) -> None:
        values = dict(attrs)
        if values.get("id"):
            self.ids.add(values["id"] or "")
        for attribute in ("href", "src"):
            if values.get(attribute):
                self.links.append(values[attribute] or "")


def parsed_html(path: Path) -> LinkParser:
    parser = LinkParser()
    parser.feed(path.read_text(encoding="utf-8"))
    return parser


def verify_links(output: Path) -> list[str]:
    errors: list[str] = []
    parsers = {path.resolve(): parsed_html(path) for path in output.rglob("*.html")}
    output_resolved = output.resolve()
    for path_resolved, parser in parsers.items():
        path = Path(path_resolved)
        for href in parser.links:
            parts = urlsplit(href)
            if parts.scheme or parts.netloc or href.startswith("//"):
                continue
            if parts.path.startswith("/"):
                errors.append(f"{path.relative_to(output)}: root-relative link is not portable: {href}")
                continue
            target = path if not parts.path else (path.parent / unquote(parts.path)).resolve()
            try:
                target.relative_to(output_resolved)
            except ValueError:
                errors.append(f"{path.relative_to(output)}: link leaves artifact: {href}")
                continue
            if target.is_dir():
                target = target / "index.html"
            if not target.is_file():
                errors.append(f"{path.relative_to(output)}: broken local link: {href}")
                continue
            if parts.fragment and target.suffix == ".html":
                target_parser = parsers.get(target.resolve())
                if target_parser is None or unquote(parts.fragment) not in target_parser.ids:
                    errors.append(f"{path.relative_to(output)}: missing fragment target: {href}")
    return errors


def verify_catalog_reachability(
    manifest: dict,
    included: dict[tuple[str, str], dict],
    output: Path,
) -> list[str]:
    """Require every copied PDF to remain linked or marker-owned by its catalog."""
    errors: list[str] = []
    primary, _ = declared_providers(manifest)
    for key, publication in sorted(included.items()):
        provider, leaf = key
        catalog_source = publication["catalog"]
        catalog_output = PAGE_MAP.get(catalog_source)
        if catalog_output is None:
            errors.append(
                f"{publication_label(key, primary)}: catalog has no rendered page"
            )
            continue
        catalog_path = output / catalog_output
        if not catalog_path.is_file():
            continue
        destination = f"pdf/{provider}/{leaf}.pdf"
        expected_href = relative_link(catalog_output, destination)
        local_paths = {
            unquote(urlsplit(href).path)
            for href in parsed_html(catalog_path).links
            if not urlsplit(href).scheme and not urlsplit(href).netloc
        }
        if expected_href not in local_paths:
            catalog_markers = {
                (marked_provider or primary, marked_leaf)
                for marked_provider, marked_leaf in CATALOG_PUBLICATION_ID_RE.findall(
                    (ROOT / catalog_source).read_text(encoding="utf-8")
                )
            }
            if key not in catalog_markers:
                errors.append(
                    f"{publication_label(key, primary)}: copied PDF is not reachable "
                    f"from {catalog_output}"
                )
    return errors


def verify_web_data(output: Path) -> list[str]:
    """Confirm the assembled data root serves exactly what it may, and all of it."""
    expected = web_data_files()
    if not expected:
        return []
    errors: list[str] = []
    data_root = output / SITE_DATA_ROOT
    if not data_root.is_dir():
        return ["artifact is missing the browser's data root"]

    actual = {
        path.relative_to(output).as_posix()
        for path in data_root.rglob("*")
        if path.is_file()
    }
    for relative in sorted(actual & set(expected)):
        if sha256(output / relative) != sha256(expected[relative]):
            errors.append(f"{relative}: data file does not match its repository source")

    manifest_relative = (SITE_DATA_ROOT / "bibles.json").as_posix()
    if manifest_relative not in actual:
        return errors + ["assembled data root is missing bibles.json"]
    try:
        offered = parse_bible_manifest(output / manifest_relative, manifest_relative)
    except ReleaseError as exc:
        return errors + [str(exc)]

    # Read back from the artifact rather than from the repository: what the
    # site serves is the only thing a reader can reach, and an edition that is
    # not in the served manifest may not have its verse text sitting beside it.
    unpublishable = sorted(data_root_edition_ids(actual) - set(offered))
    if unpublishable:
        errors.append(
            f"artifact data root carries unpublishable editions: {unpublishable!r}"
        )

    # Presence of the copied files is owned by the artifact file-set check; what
    # is checked here is that the data root is internally complete — every locus
    # the served structure resolves has verse text beside it, in the numbering
    # that edition declares, since the browser ships no numbering logic of its own.
    loci: dict[str, set[tuple[str, int]]] = {}
    for path in sorted((data_root / "structure").rglob("*.json")):
        try:
            structure_loci(load_json_file(path, path.relative_to(output).as_posix()), loci)
        except ReleaseError as exc:
            errors.append(str(exc))
    for bible_id, numbering in sorted(offered.items()):
        # An edition may legitimately not hold a book at all: the King James
        # and the World English print the Greek additions to Esther and Daniel
        # as separate books, so neither has an Esther 11-16 to ship. That is a
        # canon divergence the page reports, not a fragment that failed to copy.
        # The repository is the authority on what the edition holds, so a
        # chapter it has and the artifact lacks is still a defect — asking the
        # artifact would let a lost book excuse its own absence.
        source_chapters = ROOT / BIBLE_SOURCE_ROOT_RELATIVE / bible_id / BIBLE_FRAGMENT_DIRECTORY
        missing = sorted(
            f"{token} {chapter}"
            for token, chapter in loci.get(numbering, set())
            if (source_chapters / token / f"{chapter}.json").is_file()
            and (
                SITE_DATA_ROOT / bible_id / BIBLE_FRAGMENT_DIRECTORY / token / f"{chapter}.json"
            ).as_posix()
            not in actual
        )
        if missing:
            errors.append(
                f"{bible_id}: the structure files cite chapters the artifact has no "
                f"fragment for: {missing[:10]!r} ({len(missing)} in all)"
            )
    return errors


def write_checksums(output: Path) -> None:
    checksum_path = output / "SHA256SUMS"
    lines = []
    for path in sorted(item for item in output.rglob("*") if item.is_file() and item != checksum_path):
        lines.append(f"{sha256(path)}  {path.relative_to(output).as_posix()}")
    checksum_path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def expected_checksum_text(output: Path) -> str:
    checksum_path = output / "SHA256SUMS"
    lines = []
    for path in sorted(item for item in output.rglob("*") if item.is_file() and item != checksum_path):
        lines.append(f"{sha256(path)}  {path.relative_to(output).as_posix()}")
    return "\n".join(lines) + "\n"


def verify_output(
    manifest: dict,
    publications: dict[tuple[str, str], dict],
    output: Path,
    preview: bool,
) -> None:
    errors: list[str] = []
    primary, _ = declared_providers(manifest)
    included = included_publications(publications, preview)
    expected_authorization = artifact_authorization(manifest, included)
    expected_pdf_paths = {f"pdf/{provider}/{leaf}.pdf" for provider, leaf in included}
    if not output.is_dir():
        raise ReleaseError(f"artifact does not exist: {output.relative_to(ROOT)}")

    actual_file_paths: set[str] = set()
    actual_pdf_paths: set[str] = set()
    for path in output.rglob("*"):
        relative = path.relative_to(output).as_posix()
        if path.is_symlink():
            errors.append(f"artifact contains a symlink: {relative}")
            actual_file_paths.add(relative)
        elif path.is_file():
            actual_file_paths.add(relative)
            if path.suffix == ".pdf":
                actual_pdf_paths.add(relative)
            elif path.name not in {".nojekyll", "SHA256SUMS", "robots.txt", "_headers"} and path.suffix not in TEXT_SUFFIXES | {".png"}:
                errors.append(f"artifact contains an unexpected file type: {relative}")
        elif not path.is_dir():
            errors.append(f"artifact contains a special file: {relative}")
        if any(part in {".git", "src", "guidance", "build", "__pycache__"} for part in path.relative_to(output).parts):
            errors.append(f"artifact contains a forbidden path: {relative}")
        if path.suffix in {".md", ".tex", ".log", ".aux"} or path.name == "retrieved.txt":
            errors.append(f"artifact contains a forbidden source/build file: {relative}")

    expected_file_paths = expected_artifact_files(
        manifest, included, preview, expected_authorization
    )
    if actual_file_paths != expected_file_paths:
        errors.append(
            "artifact file-set mismatch: "
            f"missing={sorted(expected_file_paths - actual_file_paths)!r}, "
            f"extra={sorted(actual_file_paths - expected_file_paths)!r}"
        )

    if actual_pdf_paths != expected_pdf_paths:
        errors.append(
            "artifact PDF mismatch: "
            f"missing={sorted(expected_pdf_paths - actual_pdf_paths)!r}, "
            f"extra={sorted(actual_pdf_paths - expected_pdf_paths)!r}"
        )

    artifact_manifest_path = output / "PUBLICATION-MANIFEST.json"
    try:
        artifact_manifest = json.loads(artifact_manifest_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as exc:
        errors.append(f"invalid PUBLICATION-MANIFEST.json: {exc}")
        artifact_manifest = {}
    if artifact_manifest != artifact_manifest_data(manifest, included, preview):
        errors.append("artifact manifest does not exactly match the release policy")
    for key, publication in included.items():
        provider, leaf = key
        pdf_path = output / "pdf" / provider / f"{leaf}.pdf"
        if pdf_path.is_file():
            actual_hash = sha256(pdf_path)
            expected_hash = sha256(ROOT / "pdf" / provider / f"{leaf}.pdf")
            mismatch = "does not match its alpha SHA-256"
            if actual_hash != expected_hash:
                errors.append(
                    f"{publication_label(key, primary)}: artifact PDF {mismatch}"
                )

    included_ids = set(included)
    rendered_pages = {**PAGE_MAP, **included_document_pages(included_ids)}
    for source_relative, output_relative in rendered_pages.items():
        html_path = output / output_relative
        if html_path.is_file() and html_path.read_text(
            encoding="utf-8", errors="replace"
        ) != render_source_page(
            source_relative,
            output_relative,
            included_ids,
            preview,
            expected_authorization,
        ):
            errors.append(f"{output_relative}: rendered page does not match its approved source")

    for output_relative, source in sorted(web_browser_pages().items()):
        html_path = output / output_relative
        if html_path.is_file() and html_path.read_text(
            encoding="utf-8", errors="replace"
        ) != render_browser_page(
            source, output_relative, preview, expected_authorization
        ):
            errors.append(f"{output_relative}: rendered page does not match its approved source")

    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        gallery_path = output / PICTORIAL_GALLERY_OUTPUT
        expected_gallery = render_pictorial_gallery(preview, expected_authorization)
        if gallery_path.is_file() and gallery_path.read_text(
            encoding="utf-8", errors="replace"
        ) != expected_gallery:
            errors.append(f"{PICTORIAL_GALLERY_OUTPUT}: generated gallery does not match canonical inputs")
        for card in pictorial_gallery_data():
            artifact_path = output / card["destination"]
            if artifact_path.is_file() and sha256(artifact_path) != card["sha256"]:
                errors.append(f"{card['destination']}: gallery PNG does not match canonical bytes")

    static_sources = [
        *[
            (TEMPLATE_ROOT / asset_relative, output / asset_relative)
            for asset_relative in ("assets/site.css", SOCIAL_CARD_RELATIVE, SITE_ICON_RELATIVE)
        ],
        *[
            (ROOT / source_relative, output / source_relative)
            for source_relative in artifact_license_source_paths()
        ],
    ]
    for source_path, artifact_path in static_sources:
        if artifact_path.is_file() and sha256(artifact_path) != sha256(source_path):
            errors.append(
                f"{artifact_path.relative_to(output)}: static file does not match its repository source"
            )

    nojekyll_path = output / ".nojekyll"
    if nojekyll_path.is_file() and nojekyll_path.read_bytes() != b"":
        errors.append(".nojekyll must be empty")

    disallowed_ids = set(publications) - set(included)
    privacy_patterns = {
        # A machine-local home path, not a /home/ segment in some host's URL.
        re.compile(r"(?<![\w.-])/home/[A-Za-z0-9._-]+"): "home-directory path",
        re.compile(r"file://"): "local file URL",
        re.compile(r"github_pat_"): "GitHub token pattern",
        re.compile(r"ghp_"): "GitHub token pattern",
        re.compile(r"BEGIN PRIVATE KEY"): "private key marker",
    }
    for path in output.rglob("*"):
        if not path.is_file() or path.suffix not in TEXT_SUFFIXES and path.name not in {"robots.txt", "SHA256SUMS", "_headers"}:
            continue
        text = path.read_text(encoding="utf-8", errors="replace")
        relative = path.relative_to(output).as_posix()
        for pattern, label in privacy_patterns.items():
            if pattern.search(text):
                errors.append(f"{relative}: contains {label}")
        if path.suffix == ".html":
            for href in parsed_html(path).links:
                for excluded_key in disallowed_ids:
                    excluded_provider, excluded_leaf = excluded_key
                    # Every surface an excluded publication could reach the
                    # reader through: its PDF and its web edition alike.
                    excluded_targets = (
                        f"pdf/{excluded_provider}/{excluded_leaf}.pdf",
                        f"web/{excluded_provider}/{excluded_leaf}.html",
                    )
                    if any(target in unquote(href) for target in excluded_targets):
                        errors.append(
                            f"{relative}: links to excluded publication "
                            f"{publication_label(excluded_key, primary)}"
                        )

    robots = (output / "robots.txt").read_text(encoding="utf-8", errors="replace") if (output / "robots.txt").is_file() else ""
    controlled_hosting = requires_unadvertised_controls(expected_authorization)
    expected_robots = "User-agent: *\nDisallow: /\n" if preview else "User-agent: *\nAllow: /\n"
    if robots != expected_robots:
        errors.append("robots.txt does not exactly match the release mode")

    headers_path = output / "_headers"
    if preview or controlled_hosting:
        if not headers_path.is_file():
            errors.append("no-index artifact is missing _headers")
        elif headers_path.read_text(encoding="utf-8", errors="replace") != headers_policy_text(
            expected_authorization, preview
        ):
            errors.append("_headers does not exactly match the release policy")

    if not preview and controlled_hosting:
        worker_path = output / "_worker.js"
        expected_expiry = expected_authorization.get("expires_at")
        if expected_expiry:
            if not worker_path.is_file():
                errors.append("temporary public artifact is missing _worker.js")
            elif worker_path.read_text(
                encoding="utf-8", errors="replace"
            ) != worker_policy_text(expected_authorization):
                errors.append("_worker.js does not exactly match the release policy")
        elif worker_path.exists():
            errors.append("perpetual public artifact must not contain a cutoff _worker.js")
        hosting_conditions_path = output / "HOSTING-CONDITIONS.txt"
        if not hosting_conditions_path.is_file():
            errors.append("unadvertised public artifact is missing HOSTING-CONDITIONS.txt")
        elif hosting_conditions_path.read_text(
            encoding="utf-8", errors="replace"
        ) != hosting_conditions_text(expected_authorization):
            errors.append("HOSTING-CONDITIONS.txt does not exactly match the release policy")
        for html_path in output.rglob("*.html"):
            page = html_path.read_text(encoding="utf-8", errors="replace")
            if f'<meta name="robots" content="{ROBOTS_DIRECTIVES}">' not in page:
                errors.append(f"{html_path.relative_to(output)}: missing unadvertised no-index metadata")
            expiry_marker = '<meta name="triptych-authorization-expires"'
            if expected_expiry:
                if f'{expiry_marker} content="{expected_expiry}">' not in page:
                    errors.append(f"{html_path.relative_to(output)}: missing authorization expiry metadata")
            elif expiry_marker in page:
                errors.append(f"{html_path.relative_to(output)}: has expiry metadata for perpetual authorization")
            if '<meta name="robots" content="index, follow">' in page:
                errors.append(f"{html_path.relative_to(output)}: public indexing is enabled")

    errors.extend(verify_link_previews(output, preview, expected_authorization))
    errors.extend(verify_links(output))
    errors.extend(verify_catalog_reachability(manifest, included, output))
    errors.extend(verify_web_data(output))
    checksum_path = output / "SHA256SUMS"
    if not checksum_path.is_file():
        errors.append("artifact is missing SHA256SUMS")
    elif checksum_path.read_text(encoding="utf-8") != expected_checksum_text(output):
        errors.append("SHA256SUMS does not match artifact contents")

    if errors:
        raise ReleaseError("Public-alpha artifact verification failed:\n- " + "\n- ".join(errors))


SOCIAL_PROPERTY_RE = re.compile(r'<meta property="(og:[a-z_:]+)" content="([^"]*)">')
SOCIAL_NAME_RE = re.compile(r'<meta name="((?:twitter:[a-z]+)|description)" content="([^"]*)">')
# TN3156, "Respect resource usage guidelines": the previewed document is limited
# to 1 MB, preview images should be at least 900 pixels wide, and icons should
# be square and at least 108 pixels per side.
PREVIEW_DOCUMENT_LIMIT = 1_000_000
PREVIEW_IMAGE_MINIMUM_WIDTH = 900
PREVIEW_ICON_MINIMUM_SIDE = 108


def verify_link_previews(output: Path, preview: bool, authorization: dict) -> list[str]:
    """Prove every page can actually raise a link preview.

    Nothing renders these tags locally, so a page that quietly lost them looks
    exactly like a page that has them until someone sends the link to a phone.
    The numbers checked here are Apple's own, from TN3156.
    """
    errors: list[str] = []
    advertised = not preview and not requires_unadvertised_controls(authorization)
    required_properties = {
        "og:type",
        "og:site_name",
        "og:title",
        "og:description",
        "og:url",
        "og:image",
        "og:image:width",
        "og:image:height",
    }

    icon = output / SITE_ICON_RELATIVE
    if not icon.is_file():
        errors.append(f"{SITE_ICON_RELATIVE}: the artifact carries no icon for a link preview")
    else:
        width, height = png_dimensions(icon)
        if width != height or width < PREVIEW_ICON_MINIMUM_SIDE:
            errors.append(
                f"{SITE_ICON_RELATIVE}: icon is {width}x{height}; a preview icon must be "
                f"square and at least {PREVIEW_ICON_MINIMUM_SIDE} pixels a side"
            )

    for path in sorted(output.rglob("*.html")):
        relative = path.relative_to(output).as_posix()
        page = path.read_text(encoding="utf-8", errors="replace")
        size = path.stat().st_size
        if size > PREVIEW_DOCUMENT_LIMIT:
            errors.append(
                f"{relative}: {size} bytes exceeds the {PREVIEW_DOCUMENT_LIMIT}-byte "
                "document limit a link preview will fetch"
            )
        names = dict(SOCIAL_NAME_RE.findall(page))
        if not names.get("description"):
            errors.append(f"{relative}: no description metadata")
        if 'rel="apple-touch-icon"' not in page:
            errors.append(f"{relative}: no apple-touch-icon for the preview's icon")
        if not advertised:
            # A no-index copy deliberately carries no absolute public URLs.
            if SOCIAL_PROPERTY_RE.search(page):
                errors.append(f"{relative}: a no-index artifact must not advertise the public site")
            continue
        properties = dict(SOCIAL_PROPERTY_RE.findall(page))
        for missing in sorted(required_properties - set(properties)):
            errors.append(f"{relative}: no {missing} metadata")
        if names.get("twitter:card") != "summary_large_image":
            errors.append(f"{relative}: no summary_large_image twitter:card")
        title = properties.get("og:title", "")
        if title.endswith(f"· {SITE_NAME}"):
            errors.append(
                f"{relative}: og:title repeats the site name, which belongs in og:site_name"
            )
        expected_url = f"{SITE_ORIGIN}/{relative}"
        if properties.get("og:url") != expected_url:
            errors.append(f"{relative}: og:url is not {expected_url}")
        image = properties.get("og:image", "")
        if not image.startswith(f"{SITE_ORIGIN}/"):
            errors.append(f"{relative}: og:image is not an absolute URL on {SITE_ORIGIN}")
            continue
        card = output / image.removeprefix(f"{SITE_ORIGIN}/")
        if not card.is_file():
            errors.append(f"{relative}: og:image {image} is not in the artifact")
            continue
        width, height = png_dimensions(card)
        if width < PREVIEW_IMAGE_MINIMUM_WIDTH:
            errors.append(
                f"{relative}: og:image is {width} pixels wide; a preview image should be "
                f"at least {PREVIEW_IMAGE_MINIMUM_WIDTH}"
            )
        if properties.get("og:image:width") != str(width) or properties.get(
            "og:image:height"
        ) != str(height):
            errors.append(f"{relative}: og:image dimensions disagree with the image itself")
    return errors


def assemble_web_data(output: Path, preview: bool, authorization: dict) -> None:
    """Assemble the reading pages, their shared machinery, and the corpus."""
    for destination_relative, source in sorted(web_data_files().items()):
        destination = output / destination_relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, destination)
    for output_relative, source in sorted(web_browser_pages().items()):
        destination = output / output_relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(
            render_browser_page(source, output_relative, preview, authorization),
            encoding="utf-8",
        )


def build_site(
    manifest: dict, publications: dict[tuple[str, str], dict], preview: bool
) -> Path:
    included = included_publications(publications, preview)
    authorization = artifact_authorization(manifest, included)
    output = OUTPUT_ROOT / ("preview" if preview else "site")
    output_root_resolved = OUTPUT_ROOT.resolve()
    try:
        output.resolve().relative_to(output_root_resolved)
    except ValueError as exc:
        raise ReleaseError(f"refusing unsafe output path: {output}") from exc
    if output.exists():
        shutil.rmtree(output)
    output.mkdir(parents=True)

    for asset_relative in ("assets/site.css", SOCIAL_CARD_RELATIVE, SITE_ICON_RELATIVE):
        asset_destination = output / asset_relative
        asset_destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(TEMPLATE_ROOT / asset_relative, asset_destination)

    for source_relative in artifact_license_source_paths():
        license_path = ROOT / source_relative
        destination = output / source_relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(license_path, destination)

    for provider, leaf in sorted(included):
        source = ROOT / "pdf" / provider / f"{leaf}.pdf"
        destination = output / "pdf" / provider / f"{leaf}.pdf"
        destination.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(source, destination)

    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        for card in pictorial_gallery_data():
            destination = output / card["destination"]
            destination.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(card["source"], destination)

    assemble_web_data(output, preview, authorization)

    included_ids = set(included)
    rendered_pages = {**PAGE_MAP, **included_document_pages(included_ids)}
    for source_relative, output_relative in rendered_pages.items():
        destination = output / output_relative
        destination.parent.mkdir(parents=True, exist_ok=True)
        destination.write_text(
            render_source_page(
                source_relative,
                output_relative,
                included_ids,
                preview,
                authorization,
            ),
            encoding="utf-8",
        )
    if (ROOT / PICTORIAL_MANIFEST_RELATIVE).is_file():
        gallery_destination = output / PICTORIAL_GALLERY_OUTPUT
        gallery_destination.parent.mkdir(parents=True, exist_ok=True)
        gallery_destination.write_text(
            render_pictorial_gallery(preview, authorization), encoding="utf-8"
        )

    artifact_manifest = artifact_manifest_data(manifest, included, preview)
    (output / "PUBLICATION-MANIFEST.json").write_text(
        json.dumps(artifact_manifest, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    (output / ".nojekyll").write_text("", encoding="utf-8")
    controlled_hosting = requires_unadvertised_controls(authorization)
    robots = "User-agent: *\nDisallow: /\n" if preview else "User-agent: *\nAllow: /\n"
    (output / "robots.txt").write_text(robots, encoding="utf-8")
    if preview or controlled_hosting:
        (output / "_headers").write_text(
            headers_policy_text(authorization, preview), encoding="utf-8"
        )
    if not preview and controlled_hosting:
        if authorization.get("expires_at"):
            (output / "_worker.js").write_text(worker_policy_text(authorization), encoding="utf-8")
        (output / "HOSTING-CONDITIONS.txt").write_text(
            hosting_conditions_text(authorization),
            encoding="utf-8",
        )
    write_checksums(output)
    return output


def print_policy_summary(manifest: dict, publications: dict[tuple[str, str], dict]) -> None:
    counts = Counter(publication["status"] for publication in publications.values())
    alpha_count = counts["release"] + counts["review"]
    print(
        "public-alpha policy valid: "
        f"{len(publications)} publications "
        f"({alpha_count} alpha, {counts['hold']} hold)"
    )
    if alpha_count == 0:
        print("public build is fail-closed: no PDFs are currently cleared for distribution")
    else:
        authorization = artifact_authorization(manifest, included_publications(publications, False))
        condition_summary = ", ".join(authorization.get("conditions", []))
        if authorization.get("expires_at"):
            print(
                "temporary authorization active: "
                f"{condition_summary}; expires at {authorization['expires_at']} "
                f"({authorization['timezone']})"
            )
        else:
            print(
                "perpetual authorization active: "
                f"{condition_summary}; effective from {authorization['effective_at']} "
                f"({authorization['timezone']})"
            )


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command",
        choices=("check", "prepare", "build", "verify"),
        help=(
            "prepare prints a candidate hash inventory only; it never records "
            "approval or changes release files"
        ),
    )
    parser.add_argument(
        "--preview",
        action="store_true",
        help="use a private, no-index preview of the public-alpha publication set",
    )
    parser.add_argument(
        "--deployment-target",
        choices=("github-pages",),
        help="with verify, reject conditions the named deployment target cannot enforce",
    )
    with_examples(parser, tuple(e for verb in EXAMPLES for e in EXAMPLES[verb]))
    args = parser.parse_args()
    try:
        manifest = load_manifest()
        if args.deployment_target and (args.command != "verify" or args.preview):
            raise ReleaseError(
                "--deployment-target is valid only for public artifact verification"
            )
        if args.command == "prepare":
            if args.preview:
                raise ReleaseError("--preview is not meaningful with prepare")
            inventory = prepare_candidate_inventory(manifest)
            print(json.dumps(inventory, indent=2, sort_keys=True, ensure_ascii=False))
            return 0
        publications = validate_manifest(manifest, require_active_release=not args.preview)
        if args.command == "check":
            if args.preview:
                raise ReleaseError("--preview is not meaningful with check")
            print_policy_summary(manifest, publications)
        elif args.command == "build":
            output = build_site(manifest, publications, args.preview)
            verify_command = "verify --preview" if args.preview else "verify"
            print(
                f"built {output.relative_to(ROOT)}; not verified — run "
                f"tools/public-alpha {verify_command} before publication"
            )
        else:
            output = OUTPUT_ROOT / ("preview" if args.preview else "site")
            verify_output(manifest, publications, output, args.preview)
            if args.deployment_target:
                validate_deployment_target(
                    artifact_authorization(
                        manifest, included_publications(publications, False)
                    ),
                    args.deployment_target,
                )
            print(f"verified {output.relative_to(ROOT)}")
    except ReleaseError as exc:
        print(str(exc), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
