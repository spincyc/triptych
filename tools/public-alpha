def document_title(title: str) -> str:
    """Avoid the redundant ``Triptych · Triptych`` browser title."""
    return "Triptych" if title.casefold() == "triptych" else f"{title} · Triptych"


def png_dimensions(path: Path) -> tuple[int, int]:
    """Read a PNG's own IHDR rather than restating its size beside it."""
    header = path.read_bytes()[:24]
    if header[:8] != b"\x89PNG\r\n\x1a\n" or header[12:16] != b"IHDR":
        raise ReleaseError(f"{path.name}: not a PNG")
    return struct.unpack(">II", header[16:24])


PARAGRAPH_RE = re.compile(r"<p\b[^>]*>(.*?)</p>", re.DOTALL)
LEDE_RE = re.compile(r'<p class="lede"[^>]*>(.*?)</p>', re.DOTALL)
MARKUP_RE = re.compile(r"<[^>]+>")
# Long enough that a breadcrumb ("Return to the library"), a running head or a
# script's "Loading…" placeholder cannot be mistaken for the page's own prose,
# and short enough to admit a publication's one-line subtitle, which is the best
# description most of the reading editions have.
DESCRIPTION_FLOOR = 55
DESCRIPTION_CEILING = 300


def social_description(content: str, declared: str) -> str:
    """Describe the page from what the page already says.

    A description authored beside a page is a second copy of its opening, and
    the two drift; the reader's own lede cannot. So the order is: what the page
    declared for itself, then its opening paragraph, then — only for a page
    whose opening the script writes after load, and which therefore has no
    static prose at all — the site's standing description.
    """
    if declared:
        return declared
    # A page that states a lede has said what it is about; a later paragraph on
    # the same page has not, so a short lede falls through to the site rather
    # than to whatever prose happens to come next. A page with no lede at all —
    # every page rendered from Markdown — opens with its first paragraph.
    lede = LEDE_RE.search(content)
    candidates = [lede] if lede else PARAGRAPH_RE.finditer(content)
    for match in candidates:
        text = " ".join(html.unescape(MARKUP_RE.sub("", match.group(1))).split())
        if len(text) >= DESCRIPTION_FLOOR:
            return shorten_description(text)
    return SITE_DESCRIPTION


def shorten_description(text: str) -> str:
    """Cut a long lede at a word boundary; never mid-word."""
    if len(text) <= DESCRIPTION_CEILING:
        return text
    return text[:DESCRIPTION_CEILING].rsplit(" ", 1)[0].rstrip(" ,;:—-") + "…"


def social_meta(output_relative: str, title: str, description: str) -> str:
    """The link-preview metadata, absolute, for one page.

    Verified against Apple's TN3156 (Create Rich Previews for Messages): a rich
    iMessage preview needs og:title and og:image and nothing else; the site name
    belongs in og:site_name; the image must be at least 900 pixels wide and
    carry no text, since it is displayed at sizes Apple does not promise.
    LPLinkMetadata has no description field at all, so og:description and the
    twitter:* properties below change nothing in Messages — they are here for
    Slack, Discord, Facebook and search, which do read them.
    """
    card = TEMPLATE_ROOT / SOCIAL_CARD_RELATIVE
    width, height = png_dimensions(card)
    page_url = f"{SITE_ORIGIN}/{output_relative}"
    card_url = f"{SITE_ORIGIN}/{SOCIAL_CARD_RELATIVE}"
    properties = [
        ("og:type", "website"),
        ("og:site_name", SITE_NAME),
        ("og:title", title),
        ("og:description", description),
        ("og:url", page_url),
        ("og:image", card_url),
        ("og:image:width", str(width)),
        ("og:image:height", str(height)),
        ("og:image:alt", "Three panels of an open triptych, the site's mark."),
    ]
    names = [
        ("twitter:card", "summary_large_image"),
        ("twitter:title", title),
        ("twitter:description", description),
        ("twitter:image", card_url),
    ]
    lines = [f'<meta property="{key}" content="{html.escape(value)}">' for key, value in properties]
    lines += [f'<meta name="{key}" content="{html.escape(value)}">' for key, value in names]
    return "".join(f"\n  {line}" for line in lines)


def navigation_state(source_relative: str) -> tuple[str, str, str]:
    """Return aria-current attributes for the stable primary navigation."""
    if source_relative == "README.md":
        return (' aria-current="page"', "", "")
    if source_relative == "CONTRIBUTING.md":
        return ("", "", ' aria-current="page"')
    if source_relative == "ABOUT.md":
        return ("", ' aria-current="page"', "")
    if source_relative.startswith(("library/", "web/")):
        # A shelf or a reading page is reached from the landing page, which is
        # where the library lives.
        return (' aria-current="page"', "", "")
    return ("", "", "")


def reader_shelf(source_relative: str) -> tuple[str, str] | None:
    """Resolve a web edition to the reader-facing shelf that owns its subject."""
    if not source_relative.startswith("web/"):
        return None
    routes = (
        ("/liturgy/roman-rite/1962/", "Traditional Latin Mass", "library/traditional-latin-mass.html"),
        ("/liturgy/roman-rite/postconciliar/", "Novus Ordo", "library/novus-ordo-liturgy.html"),
        ("/liturgy/roman-rite/comparative/", "Liturgy", "library/liturgy.html"),
        ("/history/catholic-exorcism/", "Catholic Exorcism", "library/catholic-exorcism.html"),
        ("/curriculums/ecclesiastical-latin/", "Ecclesiastical Latin", "library/ecclesiastical-latin.html"),
        ("/biographies/", "Biographies", "library/biographies.html"),
        ("/theology/heresies/", "Heresies", "library/heresies.html"),
        ("/theology/mariology/", "Mariology", "library/mariology.html"),
        ("/theology/", "Faith", "library/faith.html"),
        ("/history/", "Historical Accounts", "library/historical-accounts.html"),
        ("/canon-law/", "Law and Church Discipline", "library/law-and-church-discipline.html"),
        ("/devotions/", "Prayer", "library/prayer.html"),
        ("/scripture/", "Scripture", "library/scripture.html"),
        ("/articles/", "Faith", "library/faith.html"),
    )
    normalized = "/" + source_relative.removeprefix("web/").split("/", 1)[-1] + "/"
    for marker, label, destination in routes:
        if marker in normalized:
            return label, destination
    return "Library", "library.html"


def breadcrumb(source_relative: str, output_relative: str) -> str:
    shelf = reader_shelf(source_relative)
    if shelf is None:
        return ""
    label, destination = shelf
    library_href = html.escape(relative_link(output_relative, "index.html"), quote=True)
    shelf_href = html.escape(relative_link(output_relative, destination), quote=True)
    if destination == "index.html":
        return (
            '<nav class="breadcrumb" aria-label="Breadcrumb">'
            f'<a href="{library_href}">Library</a></nav>'
        )
    return (
        '<nav class="breadcrumb" aria-label="Breadcrumb">'
        f'<a href="{library_href}">Library</a><span aria-hidden="true">›</span>'
        f'<a href="{shelf_href}">{html.escape(label)}</a></nav>'
    )


def add_table_header_scopes(rendered_html: str) -> str:
    """Identify Markdown table headers as column headers for assistive tech."""
    return re.sub(
        r"<th(?=\s|>)(?![^>]*\bscope=)",
        '<th scope="col"',
        rendered_html,
    )


def reject_internal_reader_labels(source_relative: str, rendered_html: str) -> None:
    """Keep implementation identities out of navigation and catalog prose."""
    if source_relative == "README.md" or source_relative.startswith("library/"):
        forbidden = {
            "PC-ANN": "internal postconciliar registry identifier",
            "triptych-publication-id": "internal publication marker",
        }
        for token, description in forbidden.items():
            if re.search(re.escape(token), rendered_html, flags=re.IGNORECASE):
                raise ReleaseError(
                    f"{source_relative}: {description} leaked into rendered HTML: {token}"
                )


def render_page(
    source_relative: str,
    markdown_text: str,
    output_relative: str,
    preview: bool,
    authorization: dict,
) -> str:
    try:
        import markdown  # type: ignore
    except ImportError as exc:
        raise ReleaseError(
            "Python Markdown is required; install requirements-public-alpha.txt in an isolated environment"
        ) from exc
    require_locked_markdown_dependency()

    content = add_table_header_scopes(markdown.markdown(
        page_body_markdown(source_relative, markdown_text),
        # Web editions are endnote-heavy and carry their own section anchors,
        # so footnotes and heading attributes must become real markup rather
        # than literal [^n] and {#id} text.
        extensions=["tables", "sane_lists", "toc", "footnotes", "attr_list"],
        output_format="html5",
    ))
    return wrap_in_layout(
        source_relative,
        output_relative,
        page_classes(source_relative, output_relative),
        page_title(markdown_text),
        breadcrumb(source_relative, output_relative),
        content,
        preview,
        authorization,
    )


def wrap_in_layout(
    source_relative: str,
    output_relative: str,
    page_class: str,
    title: str,
    breadcrumb_html: str,
    content: str,
    preview: bool,
    authorization: dict,
    head_extra: str = "",
    body_extra: str = "",
    declared_description: str = "",
) -> str:
    """Put one page's content inside the site's chrome.

    Every page a reader can reach comes through here, whichever way its content
    was produced, so the header, navigation, footer, stylesheet and robots
    metadata cannot differ between one page and the next.
    """
    template = (TEMPLATE_ROOT / "layout.html").read_text(encoding="utf-8")
    if preview:
        robots = f'<meta name="robots" content="{ROBOTS_DIRECTIVES}">'
        banner = (
            '<aside class="release-banner preview" aria-label="Edition status">'
            "<strong>Preview.</strong> Local review copy; not for distribution.</aside>"
        )
    elif requires_unadvertised_controls(authorization):
        robots = f'<meta name="robots" content="{ROBOTS_DIRECTIVES}">'
        if authorization.get("expires_at"):
            expires_at = html.escape(str(authorization["expires_at"]))
            robots += (
                "\n"
                f'  <meta name="triptych-authorization-expires" content="{expires_at}">'
            )
        banner = ""
    else:
        robots = '<meta name="robots" content="index, follow">'
        banner = ""
    description = social_description(content, declared_description)
    # Only the public, advertised artifact carries link-preview metadata. Its
    # URLs are absolute and name the one public origin, which a preview or an
    # unadvertised copy is deliberately not; such a copy would otherwise hand a
    # reader the public page it was built to stand apart from.
    social = f'\n  <meta name="description" content="{html.escape(description)}">'
    if not preview and not requires_unadvertised_controls(authorization):
        social += social_meta(output_relative, title, description)
    home_current, about_current, feedback_current = navigation_state(source_relative)
    replacements = {
        "{{PAGE_CLASS}}": page_class,
        "{{DOCUMENT_TITLE}}": html.escape(document_title(title)),
        "{{ROBOTS}}": robots,
        "{{SOCIAL}}": social,
        "{{ICON_PATH}}": relative_link(output_relative, SITE_ICON_RELATIVE),
        "{{ASSET_PATH}}": relative_link(output_relative, "assets/site.css"),
        "{{HEAD_EXTRA}}": head_extra,
        "{{HOME_PATH}}": relative_link(output_relative, "index.html"),
        "{{ABOUT_PATH}}": relative_link(output_relative, "about.html"),
        "{{CONTRIBUTING_PATH}}": relative_link(output_relative, "contributing.html"),
        "{{LICENSE_PATH}}": relative_link(output_relative, "license.html"),
        "{{THIRD_PARTY_PATH}}": relative_link(output_relative, "third-party.html"),
        "{{MODE_BANNER}}": banner,
        "{{HOME_CURRENT}}": home_current,
        "{{ABOUT_CURRENT}}": about_current,
        "{{FEEDBACK_CURRENT}}": feedback_current,
        "{{BREADCRUMB}}": breadcrumb_html,
        "{{CONTENT}}": content,
        "{{BODY_EXTRA}}": body_extra,
    }
    for marker, replacement in replacements.items():
        template = template.replace(marker, replacement)
    unresolved = re.findall(r"\{\{[A-Z_]+\}\}", template)
    if unresolved:
        raise ReleaseError(f"unresolved layout markers: {sorted(set(unresolved))!r}")
    reject_internal_reader_labels(source_relative, template)
    return template


BROWSER_TITLE_RE = re.compile(r"<title>(.*?)</title>", re.DOTALL)
BROWSER_HEAD_RE = re.compile(r"<head>(.*?)</head>", re.DOTALL)
BROWSER_BODY_RE = re.compile(r"<body([^>]*)>(.*?)</body>", re.DOTALL)
BROWSER_STYLESHEET_RE = re.compile(r'<link rel="stylesheet" href="[^"]+">')
BROWSER_SCRIPT_RE = re.compile(r'<script src="[^"]+"></script>')
BROWSER_SKIP_LINK_RE = re.compile(r'<a class="skip-link" href="[^"]+">.*?</a>\s*', re.DOTALL)
BROWSER_BODY_CLASS_RE = re.compile(r'\bclass="([^"]*)"')
# What a browser page's head may hold. Anything else is a page doing something
# the layout has no place for, and is refused rather than dropped: a stylesheet
# or a meta tag silently discarded here would reach the reader as a page that
# renders almost right.
BROWSER_HEAD_ALLOWED_RE = re.compile(
    r"""\s*
    (?: <!--.*?-->
      | <meta\ charset="utf-8">
      | <meta\ name="viewport"\ content="[^"]*">
      | <meta\ name="description"\ content="[^"]*">
      | <title>.*?</title>
      | <link\ rel="stylesheet"\ href="[^"]+">
    )\s*""",
    re.DOTALL | re.VERBOSE,
)
BROWSER_DESCRIPTION_RE = re.compile(r'<meta name="description" content="([^"]*)">')


def browser_page_parts(source_path: Path, output_relative: str) -> dict:
    """Take one standalone browser page apart into what the layout needs.

    The page is authored as a whole document so it can be opened straight from
    the repository during development. Published, it is the same content inside
    the site's chrome. Refuse anything the split cannot account for.
    """
    label = source_path.relative_to(ROOT).as_posix()
    text = source_path.read_text(encoding="utf-8")

    title_match = BROWSER_TITLE_RE.search(text)
    head_match = BROWSER_HEAD_RE.search(text)
    body_match = BROWSER_BODY_RE.search(text)
    if not (title_match and head_match and body_match):
        raise ReleaseError(f"{label}: not a whole HTML document with a head, body and title")

    head = head_match.group(1)
    if BROWSER_HEAD_ALLOWED_RE.sub("", head).strip():
        raise ReleaseError(
            f"{label}: head carries markup the site layout has no place for; "
            "the layout owns charset, viewport, title, robots and the site stylesheet"
        )
    stylesheets = BROWSER_STYLESHEET_RE.findall(head)
    if not stylesheets:
        raise ReleaseError(f"{label}: declares no stylesheet of its own")

    body_attributes, body = body_match.group(1), body_match.group(2)
    scripts = BROWSER_SCRIPT_RE.findall(body)
    if not scripts:
        raise ReleaseError(f"{label}: declares no script; the page cannot render without one")
    content = BROWSER_SCRIPT_RE.sub("", body)
    # The layout supplies its own skip link, to its own main element. Two of
    # them puts the reader on a target that is no longer the top of the content.
    content = BROWSER_SKIP_LINK_RE.sub("", content, count=1)

    body_class = BROWSER_BODY_CLASS_RE.search(body_attributes)
    classes = ["page-shell", "page-browser", "section-toned"]
    classes.append(f"section-{BROWSER_SECTION_COLOURS[output_relative.split('/')[0]]}")
    if body_class:
        classes.extend(body_class.group(1).split())
    # A page whose lede the script writes after load has no static prose to be
    # described by, so it may declare its own description instead. A page that
    # opens with a real lede must not: the two would drift.
    declared = BROWSER_DESCRIPTION_RE.search(head)
    return {
        "title": title_match.group(1).strip(),
        "declared_description": html.unescape(declared.group(1)) if declared else "",
        "head_extra": "".join(f"\n  {link}" for link in stylesheets),
        "body_extra": "".join(f"\n  {script}" for script in scripts),
        "content": content.strip("\n"),
        "page_class": " ".join(classes),
    }


# The liturgy pages are entered from the site's red section and the reading
# pages from its gold one. Naming the colour here rather than in each page's
# stylesheet is what lets those stylesheets stop carrying a copy of the site's
# palette that had to be re-copied every time the site was retuned.
BROWSER_SECTION_COLOURS = {"liturgy": "red", "scripture": "gold"}


def render_browser_page(
    source_path: Path,
    output_relative: str,
    preview: bool,
    authorization: dict,
) -> str:
    parts = browser_page_parts(source_path, output_relative)
    return wrap_in_layout(
        source_path.relative_to(ROOT).as_posix(),
        output_relative,
        parts["page_class"],
        parts["title"],
        "",
        parts["content"],
        preview,
        authorization,
        head_extra=parts["head_extra"],
        body_extra=parts["body_extra"],
        declared_description=parts["declared_description"],
    )


def render_source_page(
    source_relative: str,
    output_relative: str,
    included_ids: set[tuple[str, str]],
    preview: bool,
    authorization: dict,
) -> str:
    markdown_text = (ROOT / source_relative).read_text(encoding="utf-8")
    if source_relative.startswith("library/"):
        markdown_text = filter_catalog(source_relative, markdown_text, included_ids)
    markdown_text = rewrite_links(
        source_relative, output_relative, markdown_text, included_ids
    )
    if source_relative.startswith("library/"):
        markdown_text = remove_private_catalog_columns(markdown_text)
    return render_page(
        source_relative,
        markdown_text,
        output_relative,
        preview,
        authorization,
    )


