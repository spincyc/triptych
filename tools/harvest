def _load(path: Path) -> dict:
    import yaml

    if not path.is_file():
        return {}
    return yaml.safe_load(path.read_text(encoding="utf-8")) or {}


def _umask() -> int:
    current = os.umask(0)
    os.umask(current)
    return current


def _write_atomic(path: Path, text: str) -> None:
    """Replace the file in one step, so a reader never sees a partial write.

    A write straight to the destination truncates it first, and a crash or a
    concurrent reader in that window sees a file that is neither the old
    content nor the new. Writing a sibling and renaming makes the swap atomic
    within the directory, which is all any reader here needs.
    """
    path.parent.mkdir(parents=True, exist_ok=True)
    handle, temporary = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.", suffix=".tmp")
    try:
        with os.fdopen(handle, "w", encoding="utf-8") as stream:
            stream.write(text)
            stream.flush()
            os.fsync(stream.fileno())
        # mkstemp is private by construction; a tracked file is not.
        os.chmod(temporary, path.stat().st_mode & 0o7777 if path.exists() else 0o644 & ~_umask())
        os.replace(temporary, path)
    except BaseException:
        Path(temporary).unlink(missing_ok=True)
        raise


def _dump(path: Path, payload: dict) -> None:
    import yaml

    _write_atomic(
        path,
        yaml.safe_dump(payload, sort_keys=False, allow_unicode=True, width=88),
    )


@contextmanager
def _locked(path: Path):
    """Hold an exclusive lock over one file's read-modify-write cycle.

    Every mutating verb loads the whole ledger, changes it and dumps it back.
    Two of those interleaving lose whichever run was recorded first: it was
    observed live, the ledger falling from six runs to three and back. The
    lock makes the second writer read the first writer's result rather than
    overwrite it.
    """
    try:
        import fcntl
    except ImportError:  # pragma: no cover - not a platform this repo builds on
        yield
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    guard = path.with_name(path.name + ".lock")
    with open(guard, "w", encoding="utf-8") as handle:
        fcntl.flock(handle.fileno(), fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(handle.fileno(), fcntl.LOCK_UN)


def _dump_ledger(path: Path, ledger: dict, *, allow_shrink: bool = False) -> None:
    """Write the ledger, refusing to drop runs unless that is asked for.

    Recorded evidence is the only thing this tool cannot reconstruct, so a
    write that ends with fewer runs than the file already holds is treated as
    a defect until an operator says otherwise.
    """
    before = len(_ledger_runs(_load(path)))
    now = len(_ledger_runs(ledger))
    if now < before and not allow_shrink:
        raise ValueError(
            f"{path}: writing {now} runs over {before} would drop recorded evidence; "
            "pass --allow-shrink if that is intended"
        )
    _dump(path, ledger)


def _ledger_runs(ledger: dict) -> list[dict]:
    return [r for r in (ledger.get("runs") or []) if isinstance(r, dict)]


# One implementation, in scripts/_commentary.py, because the corpus that reads
# this harvest must split references exactly the same way or the two key spaces
# silently fail to meet.
_chapter_loci = chapter_loci


def _locus_answers(run: dict, aliases: dict) -> dict[str, dict]:
    """One run's answer, folded onto the loci the index stores.

    A run may hold several keys over one chapter — three early pilot runs asked
    about `Psalms 24:1-24:3`, `Psalms 24:3` and `Psalms 24:4` separately — and
    all of them are that run's single answer about Psalms 24. Folded here they
    are counted once; counted per key a work would appear more often than there
    were runs to produce it, and confidence is appearances over runs.

    Widening a verse range to its chapter is the sound direction: a work that
    comments on Psalms 24:4 comments on Psalms 24. The reverse is not, which is
    why nothing here ever narrows.
    """
    answered: dict[str, dict] = {}
    for passage, works in (run.get("passages") or {}).items():
        for locus in _chapter_loci(passage):
            bucket = answered.setdefault(locus, {})
            for rank, work in enumerate(works):
                found = bucket.setdefault(_key(work, aliases), {"work": work, "best": rank})
                found["best"] = min(found["best"], rank)
    return answered


def run_plan(arguments: argparse.Namespace) -> dict:
    """Passages that still need harvesting, with how many runs each has."""
    corpus = _load(Path(arguments.corpus)) if arguments.corpus else {}
    if corpus:
        wanted = [p["passage"] for p in corpus.get("passages") or [] if p.get("passage")]
    else:
        raise ValueError("--corpus is required; build it with commentary-work-index")
    seen: dict[str, int] = defaultdict(int)
    for run in _ledger_runs(_load(Path(getattr(arguments, 'ledger', LEDGER)))):
        for locus in {
            locus
            for passage in (run.get("passages") or {})
            for locus in _chapter_loci(passage)
        }:
            seen[locus] += 1

    def harvested(passage: str) -> int:
        """A reference is harvested only as far as its least-harvested chapter."""
        return min((seen[locus] for locus in _chapter_loci(passage)), default=0)

    target = arguments.runs
    if arguments.by_chapter:
        loci: list[str] = []
        for passage in wanted:
            for locus in _chapter_loci(passage):
                if locus not in loci:
                    loci.append(locus)
        wanted = loci
    pending = [p for p in wanted if harvested(p) < target]
    if arguments.limit:
        pending = pending[: arguments.limit]
    return {
        "target_runs": target,
        "total": len(wanted),
        "pending": len(pending),
        "cutoff_year": CUTOFF_YEAR,
        "roles": list(ROLES),
        # The worklist prints modern book names beside Vulgate psalm numbers, so
        # a reader sees "1 Samuel 16" next to "Psalms 24" and has every reason
        # to read the 24 as Hebrew. It is not: Psalm 24 here is Ad te levavi.
        # Of three independent harvest agents given this list, two derived the
        # numbering correctly by checking incipits and one inferred Hebrew from
        # the book names and hedged its ranges to be safe under either. The
        # hedge saved that run's data; the next reader may not hedge, so the
        # list now says which system it is instead of leaving it to be worked
        # out.
        "numbering": NUMBERING,
        "numbering_note": NUMBERING_NOTE,
        "passages": [{"passage": p, "runs": harvested(p)} for p in pending],
    }


# --- asking the model -------------------------------------------------------
#
# The one place in this repository that spends anything outside this machine on
# a model. It goes through the `claude` CLI rather than hand-rolled HTTP: the
# CLI is already installed and already authenticated, it takes a JSON schema and
# validates the answer against it before returning, and it reports which model
# actually served the request. That last point is the whole reason this verb
# exists — see `_answered_by`.
#
# `--safe-mode` matters as much as `--tools ""`. Without it the subprocess would
# inherit this repository's CLAUDE.md, its hooks and its skills, and the harvest
# would be answering with the repository looking over its shoulder; the first
# probe of this path came back talking about a hook rather than about Psalms.
# With it the query is just the prompt below, which is what the ledger claims.
CLAUDE_CLI = "claude"
# An alias, not a pinned id: it resolves to whatever is current, and what the
# run is stamped with comes from the answer regardless.
ASK_MODEL = "opus"
ASK_TIMEOUT = 900


def _ask_schema() -> dict:
    """The answer's shape, derived from what `record` will accept.

    Both are generated from ROLES and nothing restates them, because a schema
    that let a role through which `record` then rejects would spend a query to
    produce something unusable.
    """
    return {
        "type": "object",
        "additionalProperties": False,
        "required": ["works"],
        "properties": {
            "works": {
                "type": "array",
                "items": {
                    "type": "object",
                    "additionalProperties": False,
                    "required": ["author", "title", "role", "death_year"],
                    "properties": {
                        # minLength, because `_check_work` refuses a blank and a
                        # bare "string" does not. The gap was not theoretical:
                        # the whole-canon audit of 2026-08-01 returned an author
                        # with an empty title on Sirach, the answer validated,
                        # and `record` then refused the entire run of 72 books
                        # for it. A schema that lets through what record rejects
                        # spends a query to produce something unusable, which is
                        # what this function's own docstring says it exists to
                        # prevent.
                        "author": {"type": "string", "minLength": 1},
                        "title": {"type": "string", "minLength": 1},
                        "role": {"type": "string", "enum": list(ROLES)},
                        "death_year": {"type": "integer"},
                        "aliases": {"type": "array", "items": {"type": "string"}},
                    },
                },
            }
        },
    }


def _ask_prompt(passage: str, top: int) -> str:
    """What is asked, built from the same constants `record` validates against.

    Hand-typing the cutoff or the role list here would let the prompt and the
    validator drift, and the drift would show up as whole runs rejected at
    `record` after the queries had already been paid for.
    """
    return (
        f"List up to {top} distinct pre-{CUTOFF_YEAR} commentary works on "
        f"{passage}.\n"
        "\n"
        f"{NUMBERING_NOTE}\n"
        "\n"
        "A work qualifies if it is a commentary, homily series, catena or "
        "exposition that treats this passage, and its author died in or "
        f"before {CUTOFF_YEAR}. Give death_year as the author's year of "
        f"death. Give role as one of: {', '.join(ROLES)} — "
        "ecclesiastical-writer is patrology's own term for an orthodox writer "
        "who is not venerated as a saint, and is the right slot for "
        "Cassiodorus, Nicholas of Lyra or Cornelius a Lapide. Put any other "
        "name the same work is known by in aliases.\n"
        "\n"
        "Name no work you are not confident exists. An empty list is a valid "
        "answer and is worth more than a plausible invention: agreement across "
        "independent runs is what this is scored on, so a guess costs more "
        "than a gap."
    )


def _answered_by(events: list[dict]) -> str:
    """The model that produced the answer, taken from the answer.

    Never the model that was asked for. `--model opus` is an alias that
    resolves to whatever is current, a request can be served by a fallback, and
    a run stamped with a model that did not produce it is exactly the defect
    this repository is built to avoid: a reference that resolves successfully
    and wrongly.

    It is read from the `model` each assistant message declares, and not from
    the run's `modelUsage` tally, which is where the first version of this
    looked and was wrong: an opus query bills a helper model for work nobody
    asked about, so the tally named claude-haiku-4-5 beside claude-opus-5 and
    could not say which of them wrote the answer. The assistant messages can:
    every one of them on that same query said claude-opus-5. Disagreement among
    them stops the run rather than being resolved by picking.
    """
    served = sorted(
        {
            str(event["message"]["model"])
            for event in events
            if event.get("type") == "assistant"
            and isinstance(event.get("message"), dict)
            and event["message"].get("model")
        }
    )
    if len(served) != 1:
        raise ValueError(
            f"the answer was written by {len(served)} models ({served or 'none'}); "
            "a run can only be stamped with the one model that produced it"
        )
    return served[0]


def _ask_model(prompt: str, *, model: str, budget: float = 0.0) -> tuple[list[dict], str]:
    """One query. Returns what was said and who said it, never one without the other.

    The streaming form is asked for because the single-object form reports only
    a per-model token tally, and a tally cannot say which model wrote the text;
    the stream's assistant messages each name their own. See `_answered_by`.
    """
    argv = [
        CLAUDE_CLI,
        "--print",
        prompt,
        # No customization, no tools, no session on disk: the query is the
        # prompt and nothing else, and it cannot read or write this checkout.
        "--safe-mode",
        "--tools",
        "",
        "--no-session-persistence",
        "--output-format",
        "stream-json",
        "--verbose",
        "--json-schema",
        json.dumps(_ask_schema()),
        "--model",
        model,
    ]
    if budget:
        argv += ["--max-budget-usd", str(budget)]
    try:
        finished = subprocess.run(
            argv,
            capture_output=True,
            text=True,
            timeout=ASK_TIMEOUT,
            stdin=subprocess.DEVNULL,
        )
    except FileNotFoundError:
        raise ValueError(
            f"{CLAUDE_CLI} is not on PATH; `ask` reaches a model through it"
        ) from None
    except subprocess.TimeoutExpired:
        raise ValueError(f"no answer within {ASK_TIMEOUT}s") from None
    if finished.returncode != 0:
        raise ValueError(
            f"{CLAUDE_CLI} exited {finished.returncode}: "
            f"{(finished.stderr or finished.stdout or '').strip()[:200]}"
        )
    events = []
    for line in finished.stdout.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            events.append(json.loads(line))
        except ValueError:
            raise ValueError(f"unreadable answer: {line[:200]!r}") from None
    outcome = next((e for e in reversed(events) if e.get("type") == "result"), None)
    if outcome is None:
        raise ValueError("the query returned no result")
    if outcome.get("is_error") or outcome.get("subtype") != "success":
        raise ValueError(f"the query failed: {str(outcome.get('result'))[:200]}")
    answered_by = _answered_by(events)
    works = (outcome.get("structured_output") or {}).get("works")
    if not isinstance(works, list):
        raise ValueError("the answer carried no works list")
    return works, answered_by


def _ask_worklist(arguments: argparse.Namespace) -> list[str]:
    """What to ask about: `plan`'s answer, never a second implementation of it."""
    chosen = list(dict.fromkeys(getattr(arguments, "passage", None) or []))
    if chosen:
        # --limit caps the worklist, and a worklist named on the command line is
        # still a worklist. Ignoring the flag here let `--passage A --passage B
        # --limit 1` ask about both and report a cap it had not applied, which
        # is a small instance of the failure this tool exists to refuse: an
        # answer that looks like the one requested and is not.
        return chosen[: arguments.limit] if arguments.limit else chosen
    if not arguments.corpus:
        raise ValueError("--corpus or --passage is required; ask what plan says is missing")
    planned = run_plan(
        argparse.Namespace(
            corpus=arguments.corpus,
            runs=arguments.runs,
            limit=arguments.limit,
            by_chapter=arguments.by_chapter,
            ledger=getattr(arguments, "ledger", LEDGER),
        )
    )
    return [entry["passage"] for entry in planned["passages"]]


def _ask_run(
    passages: list[str], arguments: argparse.Namespace
) -> tuple[dict[str, list[dict]], set[str], list[str]]:
    """One run over the whole worklist, one query a passage.

    A passage that fails is dropped from the run rather than failing it: a run
    is a set of passages, and the ones that were answered are evidence whether
    or not the rest were.
    """
    answers: dict[str, list[dict]] = {}
    served: set[str] = set()
    failed: list[str] = []

    def one(passage: str) -> None:
        try:
            works, model = _ask_model(
                _ask_prompt(passage, arguments.top),
                model=arguments.model,
                budget=arguments.budget,
            )
        except ValueError as error:
            failed.append(f"{passage}: {error}")
            print(f"  ! {passage}: {error}", file=sys.stderr)
            return
        answers[passage] = works
        served.add(model)
        print(f"  {passage}: {len(works)}", file=sys.stderr)

    if arguments.jobs > 1:
        with ThreadPoolExecutor(max_workers=arguments.jobs) as pool:
            list(pool.map(one, passages))
    else:
        for passage in passages:
            one(passage)
    return {p: answers[p] for p in sorted(answers)}, served, failed


def run_ask(arguments: argparse.Namespace) -> dict:
    """Ask the model, N independent times, and write what `record` ingests.

    The only verb in this repository that spends anything outside this machine.
    It writes one results file per run and stops there: recording is `record`'s
    job, and keeping the two apart means the evidence survives on disk even if
    the ingest is refused.
    """
    import yaml

    passages = _ask_worklist(arguments)
    if not passages:
        raise ValueError("nothing to ask about; every passage already has its runs")
    out = Path(arguments.out)
    audited_on = date.today().isoformat()
    if arguments.dry_run:
        return {
            "status": "dry-run",
            "passages": len(passages),
            "runs": arguments.runs,
            "queries": len(passages) * arguments.runs,
            "model_requested": arguments.model,
            "model_recorded": "whichever model answers, read from the answer",
            "audited_on": audited_on,
            "out": str(out),
            "first_passage": passages[0],
            "prompt": _ask_prompt(passages[0], arguments.top),
        }

    written: list[str] = []
    recorded: list[str] = []
    served: set[str] = set()
    failures: list[str] = []
    for index in range(1, arguments.runs + 1):
        print(f"run {index}/{arguments.runs}: {len(passages)} passages", file=sys.stderr)
        answers, models, failed = _ask_run(passages, arguments)
        served |= models
        failures += failed
        if not answers:
            raise ValueError(f"run {index} answered no passage at all; " + "; ".join(failed[:3]))
        model = _one_model(models)
        # Written as soon as the run is complete, not deferred to the report:
        # unlike everything else here the queries cannot be re-run for free, so
        # a failure after they are paid for must not also lose them.
        path = out / f"{audited_on}-{model}-run{index}.yaml"
        _write_atomic(
            path,
            yaml.safe_dump(
                {"passages": answers}, sort_keys=False, allow_unicode=True, width=88
            ),
        )
        written.append(str(path))
        if arguments.record:
            outcome = run_record(
                argparse.Namespace(
                    results=str(path),
                    model=model,
                    audited_on=audited_on,
                    ledger=getattr(arguments, "ledger", LEDGER),
                    allow_shrink=False,
                )
            )
            recorded.append(outcome["run_id"])
    model = _one_model(served)
    return {
        "status": "asked",
        "model": model,
        "audited_on": audited_on,
        "passages": len(passages),
        "runs": arguments.runs,
        "queries": len(passages) * arguments.runs,
        "failures": len(failures),
        "results": written,
        # A run is keyed in the ledger by what it said, so two runs that
        # answered identically are one run there. That is right — it is the
        # same guard that makes re-recording a file a no-op — but silent it
        # would leave an operator believing three runs of corroboration landed
        # where one did, and confidence is appearances over runs.
        **({"identical_runs": len(recorded) - len(set(recorded))}
           if arguments.record and len(recorded) != len(set(recorded)) else {}),
        **({"recorded": recorded} if arguments.record else {
            # Its own path, not the launcher's: naming a sibling id in a tool
            # body reads to tmt as an undeclared dependency, and harvest does
            # not depend on tpt to run.
            "record_with": [
                f"tools/harvest record --results {path} "
                f"--model {model} --audited-on {audited_on}"
                for path in written
            ]
        }),
    }


def _one_model(served: set[str]) -> str:
    """One run, one model. Two would make `model` in the ledger a half-truth."""
    if len(served) != 1:
        raise ValueError(
            f"answers came from {sorted(served)}; a run records one model, so "
            "pass --model with a pinned id and ask again"
        )
    return next(iter(served))


def _check_work(work: dict, where: str, problems: list[str]) -> None:
    for field in ("author", "title", "role"):
        if not str(work.get(field) or "").strip():
            problems.append(f"{where}: {field} is required")
    if work.get("role") not in ROLES:
        problems.append(f"{where}: role must be one of {list(ROLES)}, got {work.get('role')!r}")
    death = work.get("death_year")
    if not isinstance(death, int):
        problems.append(f"{where}: death_year must be an integer so the cutoff is checkable")
    elif death > CUTOFF_YEAR:
        problems.append(f"{where}: death_year {death} is after the {CUTOFF_YEAR} cutoff")


def run_record(arguments: argparse.Namespace) -> dict:
    """Ingest one run. The model and date are recorded, not inferred."""
    results = _load(Path(arguments.results))
    passages = results.get("passages")
    if not isinstance(passages, dict) or not passages:
        raise ValueError(f"{arguments.results}: no passages mapping")
    problems: list[str] = []
    cleaned: dict[str, list[dict]] = {}
    for passage, works in sorted(passages.items()):
        if not isinstance(works, list):
            problems.append(f"{passage}: works must be a list")
            continue
        kept = []
        for index, work in enumerate(works):
            if not isinstance(work, dict):
                problems.append(f"{passage}[{index}]: work must be a mapping")
                continue
            _check_work(work, f"{passage}[{index}]", problems)
            kept.append(
                {
                    "author": str(work.get("author", "")).strip(),
                    "title": str(work.get("title", "")).strip(),
                    "role": work.get("role"),
                    "death_year": work.get("death_year"),
                    **({"aliases": sorted({str(a).strip() for a in work["aliases"] if str(a).strip()})}
                       if work.get("aliases") else {}),
                    **({"work_id": work["work_id"]} if work.get("work_id") else {}),
                }
            )
        cleaned[str(passage)] = kept
    if problems:
        raise ValueError("; ".join(problems[:6]) + (f"; +{len(problems) - 6} more" if len(problems) > 6 else ""))

    digest = hashlib.sha256(
        json.dumps(cleaned, sort_keys=True, ensure_ascii=False).encode()
    ).hexdigest()
    run_id = f"{arguments.audited_on}-{arguments.model}-{digest[:8]}"
    path = Path(getattr(arguments, 'ledger', LEDGER))
    # The load, the duplicate check and the write are one critical section:
    # split apart, two concurrent records each write a ledger missing the
    # other's run, and both report success.
    with _locked(path):
        ledger = _load(path) or {"schema": SCHEMA, "runs": []}
        runs = _ledger_runs(ledger)
        if any(r.get("run_id") == run_id for r in runs):
            return {"status": "already recorded", "run_id": run_id, "runs": len(runs)}
        runs.append(
            {
                "run_id": run_id,
                "model": arguments.model,
                "audited_on": arguments.audited_on,
                "passage_count": len(cleaned),
                "passages": cleaned,
            }
        )
        ledger["schema"] = SCHEMA
        ledger["runs"] = sorted(runs, key=lambda r: r["run_id"])
        _dump_ledger(path, ledger, allow_shrink=getattr(arguments, "allow_shrink", False))
    return {"status": "recorded", "run_id": run_id, "passages": len(cleaned), "runs": len(ledger["runs"])}


def _fold(value: object) -> str:
    return str(value or "").casefold().strip()


def _titles(work: dict) -> list[str]:
    names = [work.get("title", "")] + list(work.get("aliases") or [])
    return [str(n).casefold().strip() for n in names if str(n).strip()]


# --- work identity -----------------------------------------------------------
#
# Two runs naming one commentary differently split it in the index, and each
# fragment then scores below what the work earned. Matching on author alone
# corroborates 78% of attributions where matching on author and title as
# written corroborates 35%: the 43-point gap is naming, not disagreement about
# who commented.
#
# The runs already assert the aliases. Treating every asserted name as an edge
# between names and taking connected components per author derives the
# groupings from the evidence rather than from a hand-typed list, which is the
# same discipline the psalm concordance follows. What cannot be derived is
# whether a group is one work: closure alone merged Peter Lombard's psalm gloss
# with his Pauline Collectanea, because "Magna Glossatura" names both, and two
# runs asserted it of each. So the closure is tracked, reviewed and validated,
# and the review's corrections live beside it as data with a reason attached.


def _alias_evidence(runs: list[dict]) -> tuple[dict, dict, dict]:
    """Every alias a run asserted, and how often each name was used as a title.

    Returned as edges keyed (author, name, name) with the runs asserting them,
    so how well attested a grouping is stays visible rather than being averaged
    away into a yes.

    A name that names a person is refused as a name of a work. Runs offer the
    author's other name in `aliases` — `Haymo of Auxerre` for Haymo of
    Halberstadt, `Benedictus Pererius` for Benedict Pereira, six such names in
    the ledger — and as an edge each one joins every work its author wrote:
    Haymo's Isaiah commentary and his minor prophets came out one work whose
    canonical title named Isaiah and whose own names named Zechariah. The set
    of persons is the ledger's own author column, so nothing is typed here, and
    dropping the edge is the sound direction: a work genuinely sharing a
    person's name loses one join rather than gaining a merge.
    """
    people = {
        _fold(work.get("author"))
        for run in runs
        for works in (run.get("passages") or {}).values()
        for work in works
        if _fold(work.get("author"))
    }
    edges: dict[tuple[str, str, str], set[str]] = defaultdict(set)
    used: dict[tuple[str, str], int] = defaultdict(int)
    spelling: dict[tuple[str, str], str] = {}
    for run in runs:
        run_id = str(run.get("run_id") or "")
        for works in (run.get("passages") or {}).values():
            for work in works:
                author, title = _fold(work.get("author")), _fold(work.get("title"))
                if not author or not title:
                    continue
                used[(author, title)] += 1
                spelling.setdefault((author, ""), str(work.get("author")).strip())
                spelling.setdefault((author, title), str(work.get("title")).strip())
                for alias in work.get("aliases") or []:
                    name = _fold(alias)
                    if not name or name == title or name in people:
                        continue
                    spelling.setdefault((author, name), str(alias).strip())
                    edges[(author, *sorted((title, name)))].add(run_id)
    return edges, used, spelling


def _evidence_digest(edges: dict) -> str:
    """A digest of the alias claims alone, so only a new claim ages the table."""
    return hashlib.sha256(
        json.dumps(sorted(list(k) for k in edges), ensure_ascii=False).encode()
    ).hexdigest()


def _review_rules(review: dict) -> tuple[set, set, set]:
    """The reviewer's corrections: names that mean two works, and denied or
    asserted joins. Each carries a reason in the table; none is inferable."""
    ambiguous = {
        (_fold(e.get("author")), _fold(e.get("title")))
        for e in (review.get("ambiguous_titles") or [])
    }
    def pairs(field: str) -> set:
        out = set()
        for entry in review.get(field) or []:
            names = [_fold(t) for t in entry.get("titles") or []]
            if len(names) != 2 or not all(names):
                raise ValueError(f"review.{field}: each entry needs exactly two titles")
            out.add((_fold(entry.get("author")), *sorted(names)))
        return out
    return ambiguous, pairs("not_aliases"), pairs("also_aliases")


def _reviewed_names(review: dict) -> dict[tuple[str, str], str]:
    """The name a reviewer settled on a group, keyed by a title the group holds.

    Derivation picks the most-used title, which names the part when the part is
    what the propers cite: Aquinas's Pauline commentary is one work over ten
    epistles and drew its name from Romans because Romans is what the missals
    quote. Which name covers a work is a cataloguing judgement, so it lives
    here beside the other judgements rather than in the derivation.
    """
    chosen: dict[tuple[str, str], str] = {}
    for entry in review.get("canonical_titles") or []:
        author = _fold(entry.get("author"))
        member = _fold(entry.get("instead_of"))
        title = str(entry.get("title") or "").strip()
        if not author or not member or not title:
            raise ValueError(
                "review.canonical_titles: each entry needs author, instead_of and title"
            )
        if (author, member) in chosen:
            raise ValueError(
                f"review.canonical_titles: {author}: {member!r} is named twice"
            )
        chosen[(author, member)] = title
    return chosen


def _name_groups(groups: list[dict], review: dict) -> None:
    """Rename each reviewed group in place, refusing an entry that hits none.

    An override keyed on a title the grouping no longer holds would stop
    applying the moment the alias graph moved, and stop silently — the group
    would go back to being named after a tenth of itself with the review entry
    still sitting there looking honoured.
    """
    chosen = _reviewed_names(review)
    used: dict[tuple[str, str], str] = {}
    for group in groups:
        author = _fold(group["author"])
        for (reviewed_author, member), title in chosen.items():
            if reviewed_author != author or member not in group["titles"]:
                continue
            if (reviewed_author, member) in used:
                raise ValueError(
                    f"review.canonical_titles: {author}: {member!r} matches two groups"
                )
            used[(reviewed_author, member)] = title
            group["work"] = title
            if _fold(title) not in group["titles"]:
                # The reviewed name has to be one of the group's own titles or
                # the table will not validate, and it should be: a later run
                # offering it must land in this group and not start another.
                group["titles"] = sorted(group["titles"] + [_fold(title)])
    missing = sorted(set(chosen) - set(used))
    if missing:
        raise ValueError(
            "review.canonical_titles: no group holds "
            + "; ".join(f"{author}: {title!r}" for author, title in missing)
        )


# --- Rule 8: a title that names the work, not one book of it ------------------
#
# The catena prints the author and the title above every fragment, which turns
# a wrong name from an invisible defect into a rendered one. A group named after
# one book of the ten it spans would have its other nine acquired, filed and
# displayed under the name of the first.
#
# Detection needs to know which words in a title name a book, and that is
# derived from the ledger rather than typed out: an attribution already ties a
# title to a locus, and a locus already names its book.

_WORDS = re.compile(r"[a-z]+")
# A word has to clear all three to count, because volume alone does not
# distinguish a book name from a genre word: `explanatio` sits on 418 psalm
# attributions and would pass a share test, while heading titles on the
# Apocalypse and on John as well.
_BOOK_WORD_TITLES = 3
_BOOK_WORD_AUTHORS = 2


def _book_words(runs: list[dict]) -> dict[str, str]:
    """Names' words that name exactly one book of scripture, from the evidence.

    A word qualifies when every attributed name carrying it landed on the same
    book, at least `_BOOK_WORD_AUTHORS` authors use it, and at least
    `_BOOK_WORD_TITLES` distinct names do. Anything short of that is not
    consulted, so the check is sound where it is incomplete: it never invents a
    book a title does not name.

    Every name the attribution gives counts, aliases included, because an alias
    is tied to its locus exactly as the title is and `_key` already matches on
    it. Reading titles alone left `gospel` naming John — the six attributed
    titles carrying it all landed there — while `commentary on the gospel of
    luke`, `... of mark` and `... of matthew` sat in the ledger as aliases,
    unread. Rule 8 then refused Albert the Great's Luke commentary for holding
    a name that supposedly named John. Counting the aliases makes the word
    ambiguous, which is what it is, and adds the book names that only ever
    appear as aliases.
    """
    books: dict[tuple[str, str], set[str]] = defaultdict(set)
    for run in runs:
        for locus, works in (run.get("passages") or {}).items():
            book = book_of(locus)
            for work in works:
                for name in _titles(work):
                    books[(_fold(work.get("author")), name)].add(book)
    named: dict[str, set[str]] = defaultdict(set)
    authors: dict[str, set[str]] = defaultdict(set)
    titles: dict[str, set[str]] = defaultdict(set)
    for (author, title), reached in books.items():
        for word in set(_WORDS.findall(title)):
            named[word] |= reached
            authors[word].add(author)
            titles[word].add(title)
    return {
        word: next(iter(reached))
        for word, reached in sorted(named.items())
        if len(reached) == 1
        and len(authors[word]) >= _BOOK_WORD_AUTHORS
        and len(titles[word]) >= _BOOK_WORD_TITLES
    }


def _books_named(title: str, words: dict[str, str]) -> set[str]:
    return {words[word] for word in _WORDS.findall(title) if word in words}


def _check_titles_cover_the_work(
    groups: list[dict], runs: list[dict], where: str
) -> None:
    """Refuse a group whose canonical title names a book its own names do not share.

    Rule 8 of `guidance/catena.md`. A sibling title that names no book at all is
    passed over rather than counted against the canonical one: the derivation
    above knows only the words it could prove, and an unproved word must not
    read as a contradiction.
    """
    words = _book_words(runs)
    for group in groups:
        canonical = _books_named(_fold(group.get("work")), words)
        if not canonical:
            continue
        for title in group.get("titles") or []:
            named = _books_named(_fold(title), words)
            if named and not (named & canonical):
                raise ValueError(
                    f"{where}: {group.get('author')}: the canonical title "
                    f"{group.get('work')!r} names {', '.join(sorted(canonical))} "
                    f"while {title!r}, one of its own names, names "
                    f"{', '.join(sorted(named))}; one work is named by the whole, "
                    "not by a part — settle it in review.canonical_titles"
                )


def _derive_groups(runs: list[dict], review: dict) -> tuple[list[dict], str]:
    """Connected components of the asserted-alias graph, per author."""
    edges, used, spelling = _alias_evidence(runs)
    ambiguous, denied, asserted = _review_rules(review)
    linked: dict[tuple[str, str], set[str]] = defaultdict(set)
    parent: dict[tuple[str, str], tuple[str, str]] = {}

    def find(node):
        parent.setdefault(node, node)
        while parent[node] != node:
            parent[node] = parent[parent[node]]
            node = parent[node]
        return node

    def union(left, right):
        left, right = find(left), find(right)
        if left != right:
            parent[left] = right

    for (author, one, two), asserting in list(edges.items()) + [(k, set()) for k in asserted]:
        find((author, one))
        find((author, two))
        if (author, one) in ambiguous or (author, two) in ambiguous:
            continue
        if (author, one, two) in denied:
            continue
        union((author, one), (author, two))
        linked[(author, one, two)] |= asserting
    for key in used:
        find(key)

    members: dict[tuple[str, str], list[tuple[str, str]]] = defaultdict(list)
    for node in list(parent):
        members[find(node)].append(node)
    groups = []
    for names in members.values():
        if len(names) < 2:
            continue  # a name with no alias groups nothing
        author = names[0][0]
        titles = sorted(t for _, t in names)
        best = max(titles, key=lambda t: (used.get((author, t), 0), -len(t), t))
        runs_seen = {r for k, v in linked.items() if k[0] == author and set(titles) & {k[1], k[2]} for r in v}
        groups.append(
            {
                "author": spelling.get((author, ""), author),
                "work": spelling.get((author, best), best),
                "uses": sum(used.get((author, t), 0) for t in titles),
                "attested_by": len(runs_seen),
                "titles": titles,
            }
        )
    _name_groups(groups, review)
    groups.sort(key=lambda g: (g["author"].casefold(), -g["uses"], g["work"].casefold()))
    return groups, _evidence_digest(edges)


def _alias_registry(path: Path, runs: list[dict]) -> dict:
    """Load the tracked table, validated, and report whether it still fits.

    Validation refuses a table where one title maps into two groups: that is
    the failure the table exists to prevent, and a table that permitted it
    would resolve successfully and wrongly.
    """
    document = _load(path)
    if not document:
        return {"present": False, "registry": {}, "display": {}, "stale": False, "groups": 0}
    if document.get("schema") != ALIAS_SCHEMA:
        raise ValueError(f"{path}: schema must be {ALIAS_SCHEMA}, got {document.get('schema')!r}")
    registry: dict[tuple[str, str], tuple[str, str]] = {}
    display: dict[tuple[str, str], tuple[str, str]] = {}
    for index, group in enumerate(document.get("groups") or []):
        where = f"{path}: groups[{index}]"
        author = _fold(group.get("author"))
        work = str(group.get("work") or "").strip()
        titles = [_fold(t) for t in group.get("titles") or []]
        if not author or not work:
            raise ValueError(f"{where}: author and work are required")
        if len(titles) < 2 or not all(titles):
            raise ValueError(f"{where}: a group needs at least two non-empty titles")
        if _fold(work) not in titles:
            raise ValueError(f"{where}: the canonical work {work!r} is not among its own titles")
        canonical = (author, _fold(work))
        display[canonical] = (str(group.get("author")).strip(), work)
        for title in titles:
            previous = registry.get((author, title))
            if previous is not None and previous != canonical:
                raise ValueError(
                    f"{where}: {author}: title {title!r} maps into two groups "
                    f"({previous[1]!r} and {canonical[1]!r}); one title is one work"
                )
            registry[(author, title)] = canonical
    _check_titles_cover_the_work(document.get("groups") or [], runs, str(path))
    ambiguous, denied, _ = _review_rules(document.get("review") or {})
    for author, title in sorted(ambiguous):
        if (author, title) in registry:
            raise ValueError(
                f"{path}: {author}: {title!r} is declared ambiguous but still groups a work"
            )
    for author, one, two in sorted(denied):
        left, right = registry.get((author, one)), registry.get((author, two))
        if left is not None and left == right:
            raise ValueError(
                f"{path}: {author}: {one!r} and {two!r} are declared distinct works but "
                f"a chain of aliases still joins them under {left[1]!r}"
            )
    return {
        "present": True,
        "registry": registry,
        "display": display,
        "groups": len(document.get("groups") or []),
        "stale": document.get("evidence_sha256") != _evidence_digest(_alias_evidence(runs)[0]),
        "review": document.get("review") or {},
    }


def _alias_path(arguments: argparse.Namespace) -> Path:
    """The alias table beside the ledger it was derived from.

    A table describes one ledger's alias claims, so it follows `--ledger`
    rather than staying pinned to the tracked one; pointed at a scratch ledger
    the tool reads that ledger's table, not the repository's.
    """
    chosen = getattr(arguments, "alias_table", None)
    if chosen:
        return Path(chosen)
    ledger = Path(getattr(arguments, "ledger", LEDGER))
    return ledger.parent / ALIASES.name if ledger != LEDGER else ALIASES


def _seed_registry(
    arguments: argparse.Namespace, runs: list[dict], *, require: bool = False
) -> tuple[dict, dict]:
    """The alias registry `_key` starts from, refusing a table the ledger outgrew.

    Also returns the name each group is reported under, so a work is named the
    same way everywhere rather than however the first run to mention it did.
    """
    table = _alias_registry(_alias_path(arguments), runs)
    if table["present"] and table["stale"] and require:
        raise ValueError(
            "the work-alias table no longer covers the ledger's alias claims; "
            "rebuild it with `harvest aliases --rebuild` and review the diff before promoting"
        )
    return dict(table["registry"]), dict(table["display"])


def run_aliases(arguments: argparse.Namespace) -> dict:
    """Derive the work-alias table from the ledger, or check the tracked one."""
    path = _alias_path(arguments)
    runs = _ledger_runs(_load(Path(getattr(arguments, "ledger", LEDGER))))
    if not runs:
        raise ValueError("the harvest ledger holds no runs")
    existing = _load(path)
    review = existing.get("review") or {}
    groups, digest = _derive_groups(runs, review)
    if not arguments.rebuild:
        table = _alias_registry(path, runs)
        return {
            "status": "stale" if (table["present"] and table["stale"]) else
                      ("absent" if not table["present"] else "current"),
            "tracked_groups": table["groups"],
            "derived_groups": len(groups),
            "titles": len(table["registry"]),
            "reviewed": sum(len(v) for v in (review or {}).values() if isinstance(v, list)),
        }
    import yaml

    document = {
        "schema": ALIAS_SCHEMA,
        "derived_on": arguments.audited_on,
        "evidence_sha256": digest,
        "review": review or {"ambiguous_titles": [], "not_aliases": [], "also_aliases": []},
        "groups": groups,
    }
    _write_atomic(path, _ALIAS_HEADER + yaml.safe_dump(
        document, sort_keys=False, allow_unicode=True, width=88))
    _alias_registry(path, runs)  # refuse to leave an invalid table on disk
    return {
        "status": "rebuilt",
        "groups": len(groups),
        "titles": sum(len(g["titles"]) for g in groups),
        "reviewed": sum(len(v) for v in (review or {}).values() if isinstance(v, list)),
    }


_ALIAS_HEADER = """\
# Which commentary titles name one work.
#
# Derived by `tools/tpt harvest aliases --rebuild` from the alias claims the
# harvest runs themselves made, not hand-typed: `groups` is the connected
# components of the "these names are the same work" graph, per author, and is
# regenerated whole. `review` is the part that cannot be derived, because
# whether a group is one work is a judgement about the works; each entry
# carries the reason it was made. Loading validates that no title reaches two
# groups, that no name declared ambiguous still groups a work, that no chain of
# aliases has re-joined works declared distinct, and that no group's canonical
# title names a book its own other names do not share.
#
# `evidence_sha256` covers the alias claims alone, so recording a run that
# asserts a new alias ages the table and `harvest promote` refuses until the
# new grouping has been looked at.
"""


def _key(work: dict, registry: dict[tuple[str, str], tuple[str, str]] | None = None):
    """Identity is author plus any known title. Aliases collapse to one entry.

    Three runs named one Aquinas work two ways and it split in the corpus,
    each fragment scoring below what the work earned, so a title alias is
    matched as readily as the title itself.

    The registry is seeded from the reviewed alias table, which decides every
    grouping the ledger has evidence for. What it does not know it learns from
    the run in hand, which is first-come and so depends on the order the ledger
    is walked; the table exists to leave nothing for that path to decide.
    """
    author = str(work.get("author", "")).casefold().strip()
    if registry is not None:
        for title in _titles(work):
            if (author, title) in registry:
                return registry[(author, title)]
    canonical = (author, str(work.get("title", "")).casefold().strip())
    if registry is not None:
        for title in _titles(work):
            registry[(author, title)] = canonical
    return canonical


def run_promote(arguments: argparse.Namespace) -> dict:
    """Confidence is agreement across runs, not a number the model supplied."""
    runs = _ledger_runs(_load(Path(getattr(arguments, 'ledger', LEDGER))))
    if not runs:
        raise ValueError("the harvest ledger holds no runs")
    aliases, naming = _seed_registry(arguments, runs, require=True)
    seen: dict[str, dict[tuple[str, str], dict]] = defaultdict(dict)
    counts: dict[str, int] = defaultdict(int)
    for run in runs:
        for locus, answers in _locus_answers(run, aliases).items():
            counts[locus] += 1
            for key, found in answers.items():
                entry = seen[locus].setdefault(
                    key, {"work": found["work"], "key": key, "appearances": 0}
                )
                entry["appearances"] += 1
    payload = []
    for passage in sorted(seen):
        total = counts[passage]
        works = []
        for entry in seen[passage].values():
            confidence = round(entry["appearances"] / total, 4)
            if confidence < arguments.min_confidence:
                continue
            work = entry["work"]
            # Report the group's name, not whichever of its names the first run
            # to mention it happened to use.
            author, title = naming.get(entry["key"], (work["author"], work["title"]))
            works.append(
                {
                    **({"work_id": work["work_id"]} if work.get("work_id") else {}),
                    "author": author,
                    "title": title,
                    "date": str(work.get("death_year") or ""),
                    "role": work["role"],
                    "confidence": confidence,
                    "runs": total,
                }
            )
        works.sort(key=lambda w: (-w["confidence"], w["author"].casefold(), w["title"].casefold()))
        if works:
            payload.append({"passage": passage, "works": works})
    # The index answers one question once. It was promoted holding both
    # `Psalms 24` and `Psalms 24:4`, and the two carried different corpora for
    # the same text: a consumer keyed on chapters lost seven of the verse row's
    # nineteen works, a consumer keyed on the verse row saw a different list,
    # and both looked complete. The detector is cheap and its absence is why
    # that reached a tracked artifact.
    clashes = overlapping_keys([entry["passage"] for entry in payload])
    if clashes:
        shown = "; ".join(f"{one!r} and {two!r}" for one, two in clashes[:4])
        raise ValueError(
            f"{len(clashes)} pairs of index keys cover the same text ({shown}"
            f"{', +more' if len(clashes) > 4 else ''}); the index stores one "
            "granularity and derives the rest"
        )
    # Which system the keys above are addressed in, derived rather than
    # asserted. The psalter half is settled by construction: every psalm key
    # comes through `_canonical_passage`, which converts each calendar's
    # citations out of the system that calendar declares and into this one, so
    # a key is Vulgate because the conversion made it Vulgate. The rest of the
    # canon is not converted at all — a citation's chapter becomes the key as
    # printed — so a calendar citing the Lectionary's division can produce a
    # key that is not in this system, and `numbering_survey` finds exactly
    # those from the calendars' own divergence registers.
    survey = _index_numbering_survey()
    for entry in payload:
        override = survey.get(entry["passage"])
        if override:
            entry.update(override)
            entry["works"] = entry.pop("works")
    # And a key that claims the declared system must be able to exist in it.
    # A row already declaring `unrecorded` claims nothing and is exempt: it is
    # the statement that the key is *not* in this system, so measuring it
    # against this system's bounds would refuse the honest row.
    ceilings = dict(_canonical_chapters())
    impossible = [
        problem
        for entry in payload
        if not entry.get("numbering")
        for problem in [impossible_key(entry["passage"], NUMBERING, ceilings)]
        if problem
    ]
    if impossible:
        shown = "; ".join(impossible[:4])
        raise ValueError(
            f"{len(impossible)} index key(s) cannot exist in {NUMBERING} "
            f"numbering ({shown}{', +more' if len(impossible) > 4 else ''}); a "
            "key outside the declared system resolves against nothing and "
            "would be answered from whatever the reader's edition happens to "
            "print at those numbers"
        )
    index = {
        "schema": INDEX_SCHEMA,
        "updated": arguments.audited_on,
        "numbering": NUMBERING,
        "numbering_note": INDEX_NUMBERING_NOTE,
        # Derived, and worth a diff of its own: §8.0's rule that a projection's
        # size measures how far a thing sits from the canon applies here too.
        # If this grows, the index has taken on another key nobody can resolve.
        "numbering_unrecorded_count": sum(
            1 for entry in payload if entry.get("numbering")
        ),
        "harvest_runs": len(runs),
        "min_confidence": arguments.min_confidence,
        "passages": payload,
    }
    target = Path(getattr(arguments, 'index', INDEX))
    return {
        "status": "promoted" if not arguments.dry_run else "dry-run",
        "passages": len(payload),
        "runs": len(runs),
        "works": sum(len(p["works"]) for p in payload),
        "distinct_works": len({(w["author"], w["title"]) for p in payload for w in p["works"]}),
        "numbering": NUMBERING,
        "numbering_unrecorded": index["numbering_unrecorded_count"],
        "index": str(target),
        # Deferred so the index lands only once the run can also be reported.
        # Writing first left a text-mode promote having written the file and
        # exited non-zero, which tells an operator nothing about what landed.
        **({} if arguments.dry_run else {"_commit": lambda: _dump(target, index)}),
    }


@lru_cache(maxsize=1)
def _canonical_chapters(root: Path = ROOT) -> tuple[tuple[str, int], ...]:
    """The last chapter each book of the canon prints, read from the witness.

    Not typed here and not typed anywhere: `_catena.canon` already derives the
    canon and its chapter counts from the tracked Clementine, which is the
    edition `_projection.CANONICAL` names, so this is the same table the catena
    validates fragment extents against rather than a second copy of it.
    """
    import _catena

    return tuple((book["name"], int(book["chapters"])) for book in _catena.canon(root))


def _work_index_tool():
    from importlib.machinery import SourceFileLoader

    return SourceFileLoader(
        "cwi", str(ROOT / "tools" / "commentary-work-index")
    ).load_module()


@lru_cache(maxsize=1)
def _index_numbering_survey(root: Path = ROOT) -> dict[str, dict[str, str]]:
    """Index keys the calendars themselves put outside `NUMBERING`.

    Derived on every promotion and never hand-typed, so it is self-cleaning in
    both directions: a key that stops being reached only by a divergent
    citation loses its override, and a new divergent citation gains one. The
    tracked calendars' `citation_divergences` are already gated against the
    citations actually made, so this rests on a register that cannot go stale
    without its own build failing first.

    The calendars are `commentary-work-index`'s own default set and are read
    through `_calendars`, so the survey asks the same question of the same
    documents the corpus was built from. Which calendars belong in the union,
    and why a recension is not one of them, is stated there and not restated
    here.
    """
    index = _work_index_tool()
    citations = index._load_citations_tool()
    documents: dict[str, dict] = {}
    for calendar in index.DEFAULT_CALENDARS:
        documents[calendar] = _calendar_document(root, calendar)
    return index.numbering_survey(citations, documents)


def _calendar_document(root: Path, calendar: str) -> dict:
    """One calendar's mass index, as the model resolves it and not as it sits.

    `yaml.safe_load` on the file itself is the shape of defect this repository
    has recorded before: it reads a RECENSION as the handful of departure rows
    it is written as, so a caller asking for `roman-pre-1955` would see six
    masses where the model has 490, would see placeholder rows in place of the
    base's text, and would resolve no `takes_from` reference. There is one
    derivation of a calendar document here -- `scripts/_calendars` -- and this
    is a caller of it. A calendar that is nobody's recension comes back exactly
    as it sits, so the tracked calendars are unaffected.
    """
    calendars = root / "src" / "sources" / "calendars"
    path = calendars / calendar / "propers.yaml"
    if not path.is_file():
        raise ValueError(f"missing calendar index: {path}")
    return _calendars.load_document(calendars, calendar)


def _mass_passages(missal: str, mass: str) -> list[str]:
    """The canonical passage keys a mass cites, via the corpus's own speller."""
    index = _work_index_tool()

    document = _calendar_document(ROOT, missal)
    citations = index._load_citations_tool()
    records = index._collect_mass_records(citations, document, missal)
    found = [r for r in records if r["mass_key"] == mass or r["mass_key"].startswith(f"{mass}:")]
    if not found:
        # Two different answers, and one message for both would be a lie in one
        # of them. A mass the calendar holds and cites no scripture in is the
        # ordinary case for a recension's own entries, which state a placement
        # rather than a text; saying it is not there would send a reader
        # looking for a key that is.
        if mass in _calendars.mass_index(document):
            raise KeyError(
                f"{missal}: {mass!r} is in the calendar and cites no scripture, "
                "so there is nothing here to harvest commentary against"
            )
        raise KeyError(f"{missal}: no mass with key {mass!r}")
    seen: list[str] = []
    for record in found:
        canonical = index._canonical_passage(record["passage"], record.get("numbering", "vulgate"))
        if canonical["ref"] not in seen:
            seen.append(canonical["ref"])
    return seen


def run_harvest(arguments: argparse.Namespace) -> dict:
    """One mass's ranked works, naming any passage still short of its runs.

    The cache stays keyed by passage, not by mass: masses share passages, and
    asking per mass would consult the model repeatedly for the same text.
    """
    # The mass cites verse ranges and the harvest is keyed by chapter, so the
    # citation is resolved to the loci the index stores rather than matched
    # against them as a string. Matching by spelling met only the handful of
    # pilot keys that happened to be spelled as a range.
    passages: list[str] = []
    for cited in _mass_passages(arguments.missal, arguments.mass):
        for locus in _chapter_loci(cited):
            if locus not in passages:
                passages.append(locus)
    ledger_runs = _ledger_runs(_load(Path(getattr(arguments, 'ledger', LEDGER))))
    aliases, naming = _seed_registry(arguments, ledger_runs)
    runs_for: dict[str, int] = defaultdict(int)
    works_for: dict[str, dict] = defaultdict(dict)
    for run in ledger_runs:
        for locus, answers in _locus_answers(run, aliases).items():
            if locus not in passages:
                continue
            runs_for[locus] += 1
            for key, found in answers.items():
                entry = works_for[locus].setdefault(key, {"work": found["work"], "n": 0})
                entry["n"] += 1
    pending = [p for p in passages if runs_for[p] < arguments.runs]

    ranked: dict[tuple[str, str], dict] = {}
    for passage in passages:
        total = runs_for[passage] or 1
        for rank, entry in enumerate(
            sorted(works_for[passage].values(), key=lambda e: -e["n"])
        ):
            work = entry["work"]
            key = _key(work, aliases)
            author, title = naming.get(key, (work["author"], work["title"]))
            slot = ranked.setdefault(
                key,
                {**work, "author": author, "title": title,
                 "score": 0.0, "confidence": 0.0, "passages": []},
            )
            slot["score"] += 1.0 / (rank + 1)
            slot["confidence"] = max(slot["confidence"], round(entry["n"] / total, 4))
            slot["passages"].append(passage)
    top = sorted(
        ranked.values(),
        key=lambda w: (-w["score"], w["author"].casefold(), w["title"].casefold()),
    )[: arguments.top]
    for work in top:
        work["score"] = round(work["score"], 4)
        work["passages"] = sorted(set(work["passages"]))
    return {
        "missal": arguments.missal,
        "mass": arguments.mass,
        "passages": passages,
        "pending_passages": pending,
        "target_runs": arguments.runs,
        "works": top,
    }


def run_propers(arguments: argparse.Namespace) -> dict:
    """Collate every harvested passage into one ranked acquisition list.

    The terminal step: the union across all propers of both missals,
    deduplicated by author and title, which is the list of works to pull into
    the source vault.
    """
    runs = _ledger_runs(_load(Path(getattr(arguments, 'ledger', LEDGER))))
    if not runs:
        raise ValueError("the harvest ledger holds no runs; harvest some masses first")
    aliases, naming = _seed_registry(arguments, runs)
    per_passage: dict[str, dict] = defaultdict(dict)
    counts: dict[str, int] = defaultdict(int)
    for run in runs:
        for locus, answers in _locus_answers(run, aliases).items():
            counts[locus] += 1
            for key, found in answers.items():
                entry = per_passage[locus].setdefault(
                    key, {"work": found["work"], "n": 0, "best": found["best"]}
                )
                entry["n"] += 1
                entry["best"] = min(entry["best"], found["best"])

    collated: dict[tuple[str, str], dict] = {}
    for passage, entries in per_passage.items():
        total = counts[passage]
        for key, entry in entries.items():
            work = entry["work"]
            author, title = naming.get(key, (work["author"], work["title"]))
            slot = collated.setdefault(key, {
                **({"work_id": work["work_id"]} if work.get("work_id") else {}),
                "author": author, "title": title, "role": work["role"],
                "death_year": work["death_year"],
                **({"aliases": work["aliases"]} if work.get("aliases") else {}),
                "score": 0.0, "confidence": 0.0,
                "passages": [],
            })
            slot["score"] += 1.0 / (entry["best"] + 1)
            slot["confidence"] = max(slot["confidence"], round(entry["n"] / total, 4))
            slot["passages"].append(passage)

    works = sorted(collated.values(),
                   key=lambda w: (-w["score"], w["author"].casefold(), w["title"].casefold()))
    for work in works:
        work["score"] = round(work["score"], 4)
        work["passage_count"] = len(set(work["passages"]))
        work["passages"] = sorted(set(work["passages"]))
    if arguments.min_confidence:
        works = [w for w in works if w["confidence"] >= arguments.min_confidence]
    if arguments.top:
        works = works[: arguments.top]
    return {"harvest_runs": len(runs), "passages_harvested": len(per_passage), "works": works}


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--json", action="store_true", default=argparse.SUPPRESS,
                        help="emit one compact JSON object")
    shared.add_argument(
        "--format", choices=("text", "yaml", "json"), default=argparse.SUPPRESS,
        help="human-readable text, YAML, or JSON; every verb offers all three",
    )
    # A concrete default here would be re-applied by the subparser and clobber
    # a value given before the verb, so leave it unset and fall back.
    shared.add_argument("--ledger", default=argparse.SUPPRESS, help="harvest ledger path")
    shared.add_argument("--index", default=argparse.SUPPRESS, help="discovery index path")
    shared.add_argument("--alias-table", default=argparse.SUPPRESS,
                        help="tracked work-alias table path")
    shared.add_argument(
        "--src-list-only", action="store_true", default=argparse.SUPPRESS,
        help="just the works to extract, without scores or passage detail",
    )
    parser = argparse.ArgumentParser(
        prog="harvest",
        description=(
            "Plan, ask, record and promote model-harvested commentary\n"
            "candidates.\n"
            "\n"
            "One verb calls a model: `ask`, and nothing else here opens a\n"
            "socket or spends anything outside this machine. `ask` writes only\n"
            "a results file, stamped with the model that answered — read out of\n"
            "the answer, never the model that was requested — and the date it\n"
            "ran. `record` ingests that file; every other verb reads the ledger\n"
            "and derives from it."
        ),
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "harvest")
    sub = parser.add_subparsers(dest="command")

    propers = with_examples(
        sub.add_parser(
            "propers", help="one collated list across every harvested proper", parents=[shared]
        ),
        EXAMPLES["propers"],
    )
    propers.add_argument("--top", type=int, default=0, help="cap the list; 0 is all")
    propers.add_argument("--min-confidence", type=float, default=0.0)

    plan = with_examples(
        sub.add_parser("plan", help="passages still needing harvest", parents=[shared]),
        EXAMPLES["plan"],
    )
    plan.add_argument("--corpus", required=True, help="corpus emitted by commentary-work-index")
    plan.add_argument("--runs", type=int, default=3, help="target runs per passage")
    plan.add_argument("--limit", type=int, default=0, help="cap the worklist")
    plan.add_argument(
        "--by-chapter", action="store_true",
        help="one locus per chapter, never wider; more queries, no drops",
    )

    ask = with_examples(
        sub.add_parser(
            "ask",
            help="query the model for a worklist, N runs over",
            description=(
                "Ask the model for the works, N independent times.\n"
                "\n"
                "The only verb here that reaches outside this machine. It runs\n"
                "the `claude` CLI once per passage per run, with no tools, no\n"
                "session on disk and this repository's own customization\n"
                "switched off, and validates each answer against a schema\n"
                "derived from what `record` accepts.\n"
                "\n"
                "It writes one results file per run under --out, in exactly the\n"
                "shape `record --results` ingests, named for the date and the\n"
                "model that answered. Both stamps are discovered, not supplied:\n"
                "the date is today's and the model is read out of the response,\n"
                "so a run cannot be attributed to a model that did not produce\n"
                "it. Recording is left to `record` unless --record is given;\n"
                "two runs that answered identically are one run in the ledger,\n"
                "which is reported as identical_runs rather than left to be\n"
                "noticed in a confidence figure later.\n"
                "\n"
                "--dry-run prints the worklist size, the query count and the\n"
                "prompt verbatim, and asks nothing."
            ),
            parents=[shared],
        ),
        EXAMPLES["ask"],
    )
    ask.add_argument("--corpus", help="corpus emitted by commentary-work-index")
    ask.add_argument(
        "--passage", action="append", default=[],
        help="ask about this passage instead of a corpus worklist; repeatable",
    )
    ask.add_argument("--runs", type=int, default=3,
                     help="independent runs per passage; collation reconciles them")
    ask.add_argument("--limit", type=int, default=0, help="cap the worklist")
    ask.add_argument("--top", type=int, default=20, help="works to ask for per passage")
    ask.add_argument(
        "--by-chapter", action="store_true",
        help="one locus per chapter, never wider; more queries, no drops",
    )
    ask.add_argument("--out", default="build/harvest-runs",
                     help="directory for the results files")
    ask.add_argument("--model", default=ASK_MODEL,
                     help="model to request; what is recorded comes from the answer")
    ask.add_argument("--jobs", type=int, default=1, help="queries in flight at once")
    ask.add_argument("--budget", type=float, default=0.0,
                     help="cap in USD for a single query; 0 leaves it uncapped")
    ask.add_argument("--record", action="store_true",
                     help="also ingest each run, with the model and date discovered")
    ask.add_argument("--dry-run", action="store_true",
                     help="print what would be asked, of how many, and ask nothing")

    record = with_examples(
        sub.add_parser(
            "record",
            help="ingest one run's results",
            description=(
                "Ingest one run's results into the dated ledger.\n"
                "\n"
                "The run happened elsewhere. --model and --audited-on are what\n"
                "you were told about it, recorded rather than discovered, and the\n"
                "run id is those two plus a digest of the results — so recording\n"
                "the same file twice is a no-op. Nothing here calls a model or\n"
                "opens a socket."
            ),
            parents=[shared],
        ),
        EXAMPLES["record"],
    )
    record.add_argument("--results", required=True)
    record.add_argument("--model", required=True, help="the model that produced them")
    record.add_argument("--audited-on", required=True, help="ISO date of the run")
    record.add_argument(
        "--allow-shrink", action="store_true",
        help="permit a write that leaves the ledger holding fewer runs than it does now",
    )

    alias = with_examples(
        sub.add_parser(
            "aliases", help="derive or check the tracked work-alias table", parents=[shared]
        ),
        EXAMPLES["aliases"],
    )
    alias.add_argument("--rebuild", action="store_true", help="rederive and write the table")
    alias.add_argument("--audited-on", default="", help="ISO date to stamp a rebuild with")

    harvest = with_examples(
        sub.add_parser(
            "harvest", help="one mass's ranked works", parents=[shared]
        ),
        EXAMPLES["harvest"],
    )
    harvest.add_argument("missal")
    harvest.add_argument("mass")
    harvest.add_argument("--runs", type=int, default=3)
    harvest.add_argument("--top", type=int, default=20)

    promote = with_examples(
        sub.add_parser("promote", help="write the discovery index", parents=[shared]),
        EXAMPLES["promote"],
    )
    promote.add_argument("--audited-on", required=True)
    promote.add_argument("--min-confidence", type=float, default=0.0)
    promote.add_argument("--dry-run", action="store_true")

    def emit(payload: dict, arguments: argparse.Namespace) -> int:
        # `works` is a list of works for the collating verbs and a count for
        # promote, so every branch below tests the shape rather than the name.
        listed = isinstance(payload.get("works"), list)
        if getattr(arguments, "src_list_only", False) and listed:
            payload = {
                "works": [
                    {k: w[k] for k in ("work_id", "author", "title", "role", "death_year") if k in w}
                    for w in payload["works"]
                ]
            }
        want = getattr(arguments, "format", "text")
        if getattr(arguments, "json", False) or want == "json":
            print_json(payload)
            return 0
        if want == "yaml":
            import yaml

            print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True, width=88).rstrip())
            return 0
        if listed:
            for work in payload["works"]:
                bits = [f"{work['author']} — {work['title']}"]
                if "confidence" in work:
                    bits.append(f"conf {work['confidence']:.2f}")
                if "passage_count" in work:
                    bits.append(f"{work['passage_count']} passages")
                print(f"  {work.get('death_year', '?')}  " + "  ".join(bits))
            if "passages_harvested" in payload:
                print(
                    f"# {len(payload['works'])} works across "
                    f"{payload['passages_harvested']} passages, "
                    f"{payload['harvest_runs']} runs",
                    file=sys.stderr,
                )
            return 0
        if "passages" in payload and isinstance(payload["passages"], list) and "pending" in payload:
            for entry in payload["passages"]:
                print(f"{entry['runs']}\t{entry['passage']}")
            print(
                f"# {payload['numbering_note']}\n"
                f"# {payload['pending']} of {payload['total']} passages below "
                f"{payload['target_runs']} runs",
                file=sys.stderr,
            )
            return 0
        # The prompt is the one payload value that is a document rather than a
        # field, and a dry run exists to show it. Printing it inline would
        # break the key: value shape the rest of this renderer keeps, so it
        # goes to stderr whole, the way plan prints its numbering note.
        prompt = payload.pop("prompt", None)
        for key, value in sorted(payload.items()):
            print(f"{key}: {value}")
        if prompt:
            # Or a piped stdout buffers past the unbuffered stderr and the
            # prompt lands above the report that introduces it.
            sys.stdout.flush()
            print("\n--- asked of every passage, verbatim ---", file=sys.stderr)
            print(prompt, file=sys.stderr)
        return 0

    def render(payload: object, arguments: argparse.Namespace) -> int:
        """Render first, then let the verb commit what it rendered.

        A verb that wrote its output file before returning left a failed
        render having already changed the tree, and the operator with no
        report of what changed. Anything a verb defers here lands only once
        the run can also be described.
        """
        if not isinstance(payload, dict):
            print("harvest error: invalid payload", file=sys.stderr)
            return 70
        commit = payload.pop("_commit", None)
        status = emit(payload, arguments)
        if commit is not None:
            # Buffered output fails at interpreter exit, long after a commit
            # here would have run, so the report is not reported until it is
            # actually out.
            sys.stdout.flush()
            if status == 0:
                commit()
        return status

    return run_verb_cli(
        parser=parser,
        handlers={"plan": run_plan, "ask": run_ask, "record": run_record,
                  "promote": run_promote, "harvest": run_harvest,
                  "propers": run_propers, "aliases": run_aliases},
        renderer=render,
        prefix="harvest",
        argv=argv,
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
