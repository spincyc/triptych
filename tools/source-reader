def run_list(arguments: argparse.Namespace) -> dict:
    library = load(arguments)
    works = selected(library, arguments)
    return {
        **tally(works),
        "works_listed": [
            {
                "id": work["id"],
                "title": work["title"],
                "author": work["author"],
                "category": work["category"],
                "editions": [
                    {
                        "id": edition["id"],
                        "title": edition["title"],
                        "language": edition["language"],
                        "date": edition["date"],
                        "passages": len(edition["passages"]),
                        "readable": _readable_count(edition),
                    }
                    for edition in work["editions"]
                ],
            }
            for work in works
        ],
        "status": "ok",
    }


def run_show(arguments: argparse.Namespace) -> dict:
    library = load(arguments)
    works = selected(library, arguments)
    return {
        **tally(works),
        "works_shown": [
            {**edition_payload(work, edition), "work_id": work["id"]}
            for work in works
            for edition in work["editions"]
        ],
        "status": "ok",
    }


def load(arguments: argparse.Namespace):
    library = source_library().load_library(
        ROOT, check_binding_fingerprints=False
    )
    if getattr(arguments, "strict", False) and library.errors:
        raise ReaderError(
            "the source library does not validate: " + library.errors[0]
        )
    return library


# --- rendering -------------------------------------------------------------


def _plural(count: int, noun: str) -> str:
    return f"{count} {noun}" if count == 1 else f"{count} {noun}s"


def _print_work(record: dict, width: int) -> None:
    for index, edition in enumerate(record["editions"]):
        name = record["title"] if index == 0 else ""
        held = (
            f"{edition['readable']}/{edition['passages']}"
            if edition["passages"]
            else "--"
        )
        print(
            f"{(record['author'] or '')[:24]:<24} {name[:width]:<{width}} "
            f"{(edition['date'] or '')[:10]:<10} {edition['language'] or '':<6} "
            f"{held:>7}  {edition['id']}"
        )


def _print_edition(record: dict) -> None:
    work = record["work"]
    edition = record["edition"]
    print(f"{work['author'] or '(no author recorded)'}  —  {work['title']}")
    print(f"  work       {work['id']}")
    print(f"  category   {work['category']}")
    if work["alternate_titles"]:
        print(f"  also       {'; '.join(work['alternate_titles'])}")
    print(f"  edition    {edition['title']}")
    print(f"             {edition['id']}")
    print(f"  language   {edition['language']}    date {edition['date']}")
    if edition["translators"]:
        print(f"  translated {', '.join(edition['translators'])}")
    if edition["editors"]:
        print(f"  edited     {', '.join(edition['editors'])}")
    print(f"  artifacts  {len(record['artifacts'])}")
    for artifact in record["artifacts"]:
        print(
            f"    {artifact['rights']:<15} {artifact['storage']:<11} "
            f"{artifact['media_type']}"
        )
    readable = sum(1 for one in record["passages"] if one["readable"])
    print(f"  passages   {readable} of {len(record['passages'])} readable here")
    for passage in record["passages"]:
        if passage["readable"]:
            mark = f"{passage['words']} words"
            print(f"    {passage['locus']:<28} {mark:>12}  {passage['source']}")
        else:
            print(f"    {passage['locus']:<28} {'not shown':>12}  {passage['withheld']}")
            print(f"      {passage['reason']}")


def render(payload: object, arguments: argparse.Namespace) -> int:
    if not isinstance(payload, dict):
        print("source-reader error: invalid payload", file=sys.stderr)
        return 70
    if arguments.json or arguments.format == "json":
        print_json(payload)
        return 0
    if arguments.format == "yaml":
        import yaml

        print(
            yaml.safe_dump(payload, allow_unicode=True, sort_keys=True, width=100).rstrip()
        )
        return 0

    listed = payload.get("works_listed") or ()
    width = min(46, max((len(str(one["title"] or "")) for one in listed), default=0))
    for record in listed:
        _print_work(record, width)
    for index, record in enumerate(payload.get("works_shown") or ()):
        if index:
            print()
        _print_edition(record)

    print(
        ", ".join(
            _plural(payload[field], noun)
            for field, noun in (
                ("works", "work"),
                ("editions", "edition"),
                ("artifacts", "artifact"),
                ("passages", "passage"),
            )
        )
        + f"; {payload['readable']} readable here."
    )
    if "withheld" in payload:
        print(f"  passages the rights records withhold: {payload['withheld']}")
        print(f"  every one of them listed with its reason: yes")
        for line in payload.get("library_errors") or ():
            print(f"  the library reports: {line}")
        print(f"  the page's own derivation, replayed: {payload['replayed']}")
    if payload.get("written"):
        print(f"  -> {payload['written']} ({payload['files']} files)")
    if payload.get("current"):
        print(f"  {payload['current']} is current ({payload['files']} files)")
    return 0


