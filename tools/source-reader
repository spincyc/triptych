def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--work", help="one work, by record id")
    shared.add_argument("--edition", help="one edition, by record id")
    shared.add_argument("--author", help="one work's responsible creator or body, exactly")
    shared.add_argument("--language", help="one edition language code as the records state it")
    shared.add_argument("--category", help="one work_type as the records state it")
    shared.add_argument(
        "--rights",
        help="only records touching this rights status: public-domain, licensed, ...",
    )
    shared.add_argument(
        "--readable",
        action="store_true",
        help="only editions carrying at least one passage that may be read here",
    )
    shared.add_argument("--find", help="match title, author, publication, editors or notes")
    shared.add_argument("--sort", choices=SORTS, default="author")
    shared.add_argument("--format", choices=("text", "yaml", "json"), default="text")
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    shared.add_argument("--out", default=DEFAULT_OUT, help="where `structure` writes")
    shared.add_argument(
        "--check",
        action="store_true",
        help="`structure`: prove the tracked projection matches the records, and write nothing",
    )
    shared.add_argument(
        "--strict",
        action="store_true",
        help="refuse to run at all while the source library reports any validation error",
    )

    parser = argparse.ArgumentParser(
        prog="source-reader",
        description="Read the source corpus: search it, and step through a work passage by passage.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "source-reader")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser(
            "check",
            help="prove nothing the rights records withhold is emitted",
            parents=[shared],
        ),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("list", help="one line per edition", parents=[shared]),
        EXAMPLES["list"],
    )
    with_examples(
        sub.add_parser(
            "show", help="one edition in full, with every passage", parents=[shared]
        ),
        EXAMPLES["show"],
    )
    with_examples(
        sub.add_parser(
            "structure", help="write what the reading page fetches", parents=[shared]
        ),
        EXAMPLES["structure"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={
            "check": run_check,
            "list": run_list,
            "show": run_show,
            "structure": run_structure,
        },
        renderer=render,
        prefix="source-reader",
        argv=argv,
        default_verb="check",
        dependency_message="install PyYAML (requirements-tools.txt) for --format yaml",
        mapped_errors={ReaderError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
