# `\fi{}` is the inline form of an edition conditional: the empty group is what
# stops \fi from eating the space after it, so it marks a branch standing inside
# a sentence rather than between blocks.  TeX gobbles the whitespace after \else
# and lets a line-ending comment eat its own newline, so an inline branch
# contributes no whitespace of its own at either seam.  Pandoc honours neither
# rule: it reads the newline before \ifdefined together with the one after \else
# as a paragraph boundary, and the newline a comment ended as a space before
# whatever punctuation follows.  Splicing an inline branch flush at both seams is
# what keeps the sentence the PDF sets continuously one sentence on the page.
INLINE_BRANCH_MARKER = "{}"
BRANCH_TAIL_RE = re.compile(r"(?:(?<!\\)%[^\n]*)?\s*\Z")
APPOINTED_HEADING_RE = re.compile(r"\\fulltextheading(?=\s*\{)")
HYPERSETUP_RE = re.compile(r"pdf(title|subject)\s*=\s*\{")
