FENCED_DIV_RE = re.compile(r"^[ \t]*(?:>[ \t]*)?:::", re.MULTILINE)
ANCHOR_DEFINITION_RE = re.compile(r"\{#([^\s{}]+)[^{}]*\}")
ANCHOR_LINK_RE = re.compile(r"\[((?:[^\[\]\\]|\\.)*)\]\(#([^)\s]+)\)")
LINK_ATTRIBUTE_RE = re.compile(r"(\]\([^()\s]+\))\{[^{}]*\}")
TABLE_ENVIRONMENT_RE = re.compile(r"\\newenvironment\*?\s*\{([A-Za-z@]+)\}")
