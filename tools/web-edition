def sanitize_column_spec(spec: str) -> str:
    """Keep in each >{...} prefix only the declarations pandoc renders."""
    out, index = [], 0
    while (arrow := spec.find(">", index)) >= 0:
        cursor = skip_gap(spec, arrow + 1)
        if spec[cursor : cursor + 1] != "{":
            out.append(spec[index : arrow + 1])
            index = arrow + 1
            continue
        content, close = brace_group(spec, cursor)
        kept = [f"\\{name}" for name in re.findall(r"\\([A-Za-z@]+)", content)
                if name in PREFIX_KEEP]
        out.append(spec[index:arrow] + ">{" + "".join(kept) + "}")
        index = close
    out.append(spec[index:])
    return "".join(out)


def fix_column_specs(text: str) -> str:
    """Sanitize every column specification's prefixes, at any brace depth."""
    text = ALIGNMENT_FIXUP_RE.sub("", text)
    out, index = [], 0
    for match in TABLE_SPEC_RE.finditer(text):
        if match.start() < index:
            continue
        cursor = match.end()
        try:
            if match.group(1):
                cursor = skip_gap(text, cursor)
                if text[cursor : cursor + 1] == "[":
                    cursor = text.index("]", cursor) + 1
                if match.group(1) in ("tabularx", "tabular*"):
                    _, cursor = brace_group(text, cursor)
            else:
                _, cursor = brace_group(text, cursor)
                cursor = skip_gap(text, cursor)
                if text[cursor : cursor + 1] == "[":
                    cursor = text.index("]", cursor) + 1
            spec, close = brace_group(text, cursor)
        except (ConversionError, ValueError):
            continue
        opening = text.index("{", cursor)
        sanitized = sanitize_column_spec(spec)
        out.append(text[index : opening + 1] + sanitized + "}")
        index = close
        # A \multicolumn's own spec replaces its column's, and the shim keeps
        # only the span's text: the face that spec gives is carried into it.
        face = "".join(
            f"\\{name}" for name in re.findall(r"\\([A-Za-z@]+)", sanitized)
            if name in PREFIX_KEEP and name != "raggedright"
        )
        if match.group(0).startswith("\\multicolumn") and face:
            try:
                content, end = brace_group(text, close)
            except ConversionError:
                continue
            out.append(text[close : text.index("{", close)] + "{{" + face + " " + content + "}}")
            index = end
    out.append(text[index:])
    return "".join(out)


def terminate_swallowers(text: str) -> str:
    """Close the commands pandoc would let take the number that follows."""
    text = ROW_COMMAND_RE.sub(
        lambda m: m.group(0) if m.string.startswith("{}", m.end())
        else "\\" + m.group(1) + (m.group(2) or "") + "{}",
        text,
    )
    return NUMBER_SWALLOWER_RE.sub(lambda m: "\\" + m.group(1) + (m.group(2) or "") + "{}", text)


# A longtable that declares \endfirsthead and \endhead carries two heads: the
# first for its opening page and a continuation head that print repeats after
# each page break. Pandoc set both, so the header row published twice, the
# second copy as the first body row. The web has no page break to continue
# across, so only the first head is kept. Each longtable is handled alone --
# from its column spec to its \end{longtable}, or to the close of the
# definition group that holds its opening -- and in either order of the two
# heads; a table with no continuation head is left untouched.
HEAD_MARKER_RE = re.compile(r"\\(endfirsthead|endhead|endfoot|endlastfoot)(?![A-Za-z@])")
LONGTABLE_BEGIN_RE = re.compile(r"\\begin\s*\{longtable\}")


def table_rows_extent(text: str, start: int, name: str = "longtable") -> int:
    """Where the rows of a table opening at start end: its \\end, or its group's close."""
    closing, depth, index = "\\end{" + name + "}", 0, start
    while index < len(text):
        if depth == 0 and text.startswith(closing, index):
            return index
        character = text[index]
        if character == "\\":
            index += 2
            continue
        if character == "{":
            depth += 1
        elif character == "}":
            if depth == 0:
                return index
            depth -= 1
        index += 1
    return len(text)


def continuation_head(rows: str) -> tuple[int, int, int, int] | None:
    """Offsets of a table's continuation head and of its \\endfirsthead marker.

    Returns (start, end) of the rows that close with \\endhead, marker included,
    and (start, end) of the \\endfirsthead marker, or None unless the table has
    exactly one of each.
    """
    markers = list(HEAD_MARKER_RE.finditer(rows))
    firsts = [marker for marker in markers if marker.group(1) == "endfirsthead"]
    heads = [marker for marker in markers if marker.group(1) == "endhead"]
    if len(firsts) != 1 or len(heads) != 1:
        return None
    before = [marker for marker in markers if marker.end() <= heads[0].start()]
    start = before[-1].end() if before else 0
    return start, heads[0].end(), firsts[0].start(), firsts[0].end()


def drop_continuation_heads(text: str) -> str:
    masked = mask_tex_comments(text)
    edits = []
    for match in LONGTABLE_BEGIN_RE.finditer(masked):
        cursor = skip_gap(masked, match.end())
        try:
            if masked[cursor : cursor + 1] == "[":
                cursor = masked.index("]", cursor) + 1
            _, cursor = brace_group(masked, cursor)
        except (ConversionError, ValueError):
            continue
        end = table_rows_extent(masked, cursor)
        found = continuation_head(masked[cursor:end])
        if found is None:
            continue
        head_start, head_end, first_start, first_end = (cursor + offset for offset in found)
        edits.append((head_start, head_end, ""))
        edits.append((first_start, first_end, "\\endhead"))
    for start, end, replacement in sorted(edits, reverse=True):
        text = text[:start] + replacement + text[end:]
    return text


