class ConversionError(RuntimeError):
    """A conversion that would lose content, reported instead of written."""


def brace_group(text: str, start: int) -> tuple[str, int]:
    """Return the balanced ``{...}`` group beginning at or after ``start``."""
    index, depth, escaped = start, 0, False
    while index < len(text) and text[index].isspace():
        index += 1
    if index >= len(text) or text[index] != "{":
        raise ConversionError(f"expected a brace group at offset {start}")
    for cursor in range(index, len(text)):
        # A row-ending \\ must not be read as escaping the brace that follows it.
        if escaped:
            escaped = False
            continue
        if text[cursor] == "\\":
            escaped = True
            continue
        depth += (text[cursor] == "{") - (text[cursor] == "}")
        if depth == 0:
            return text[index + 1 : cursor], cursor + 1
    raise ConversionError(f"unbalanced brace group at offset {start}")


def flatten(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("\\", "")).strip()


def strip_for_scan(text: str) -> str:
    return MATH_RE.sub(" ", COMMENT_RE.sub("", text))


def resolve_input(name: str, provider: str) -> Path | None:
    """Resolve ``\\input{name}`` under the build's ``cd src/<provider>; TEXINPUTS=..``."""
    candidates = (SRC / provider / name, SRC / provider / f"{name}.tex",
                  SRC / name, SRC / f"{name}.tex")
    return next((path for path in candidates if path.is_file()), None)


def select_branch(match: re.Match[str]) -> str:
    """Splice the web branch in, flush at both seams where it stands inline."""
    branch = match.group(2)
    following = match.string[match.end() : match.end() + len(INLINE_BRANCH_MARKER)]
    if following != INLINE_BRANCH_MARKER:
        return branch
    return BRANCH_TAIL_RE.sub("", branch.lstrip())


def select_web_branches(text: str, *, proper: bool = False) -> str:
    """Select web-active text before resolving includes or auditing commands."""
    text = PRINT_EDITION_BRANCH_RE.sub(select_branch, text)
    if proper:
        text = SYNTHESIS_EDITION_BRANCH_RE.sub(select_branch, text)
    return text


def anchor_appointed_elements(body: str, element_keys: set[str]) -> str:
    """Give unlabeled appointed-text headings the manifest's stable element key."""
    out, index = [], 0
    for match in APPOINTED_HEADING_RE.finditer(body):
        title, end = brace_group(body, match.end())
        name = re.match(r"[A-Za-z][A-Za-z-]*", title.lstrip())
        key = name.group().lower() if name else ""
        if key not in element_keys:
            raise ConversionError(f"undeclared appointed element in heading: {title}")
        out.append(body[index:end])
        if not LABEL_RE.match(body[end:].lstrip()):
            out.append(r"\label{proper-" + key + "}")
        index = end
    out.append(body[index:])
    return "".join(out)


def assemble(
    text: str, provider: str, seen: dict[Path, str] | None, *, proper: bool = False
) -> str:
    """Inline every ``\\input`` in ``text``; record each file when ``seen`` is given."""
    text = select_web_branches(text, proper=proper)
    out, index = [], 0
    for match in INPUT_RE.finditer(text):
        out.append(text[index : match.start()])
        index = match.end()
        name = match.group(1).strip()
        # The shim replaces the shared preamble; every other include is content
        # or a definition the document needs.
        if name.endswith("common/preamble"):
            continue
        target = resolve_input(name, provider)
        if target is None:
            raise ConversionError(f"cannot resolve \\input{{{name}}}")
        nested = target.read_text(encoding="utf-8")
        nested = select_web_branches(nested, proper=proper)
        if seen is not None:
            seen[target] = nested
        out.append(assemble(nested, provider, seen, proper=proper))
    out.append(text[index:])
    return "".join(out)


def split_document(text: str) -> tuple[str, str]:
    begin = text.find(r"\begin{document}")
    end = text.rfind(r"\end{document}")
    if begin < 0 or end < 0:
        raise ConversionError("main.tex has no document environment")
    return text[:begin], text[begin + len(r"\begin{document}") : end]


def pdf_metadata(preamble: str) -> tuple[str, str]:
    values = {}
    for match in HYPERSETUP_RE.finditer(preamble):
        values[match.group(1)] = brace_group(preamble, match.end() - 1)[0]
    if "title" not in values:
        raise ConversionError("no pdftitle in \\hypersetup")
    return values["title"], values.get("subject", "")


def skip_gap(text: str, cursor: int) -> int:
    """Advance past the whitespace and comments between a definition's groups."""
    while True:
        cursor += len(text[cursor:]) - len(text[cursor:].lstrip())
        if text[cursor : cursor + 1] != "%":
            return cursor
        newline = text.find("\n", cursor)
        cursor = len(text) if newline < 0 else newline + 1


def replace_grouped_macro(
    text: str, name: str, argument_count: int, replacement
) -> str:
    """Replace calls to a known brace-argument macro without flattening nesting."""
    pattern = re.compile(re.escape("\\" + name) + r"\s*\{")
    out, index = [], 0
    while (match := pattern.search(text, index)) is not None:
        out.append(text[index : match.start()])
        cursor, arguments = match.end() - 1, []
        for _ in range(argument_count):
            argument, cursor = brace_group(text, cursor)
            arguments.append(argument)
        out.append(replacement(arguments))
        index = cursor
    out.append(text[index:])
    return "".join(out)


def chronology_projection(body: str) -> str:
    """Resolve the generated annotation helper macros to their visible payload."""
    body = replace_grouped_macro(body, "chronologyannotationreach", 3, lambda _: "")
    body = replace_grouped_macro(
        body, "chronologyannotationclaim", 6, lambda arguments: arguments[5]
    )
    return replace_grouped_macro(
        body, "chronologyannotationgroup", 3, lambda arguments: arguments[2]
    )


def expand_chronology_annotations(
    body: str, definition_source: str
) -> tuple[str, list[str]]:
    """Expand deterministic generated chronology definitions before pandoc."""
    definitions: dict[str, str] = {}
    for match in CHRONOLOGY_DEFINITION_RE.finditer(definition_source):
        key = match.group(1)
        if key in definitions:
            raise ConversionError(f"duplicate generated chronology annotation: {key}")
        definitions[key] = brace_group(definition_source, match.end() - 1)[0]

    expected = []

    def resolve(arguments: list[str]) -> str:
        key = arguments[0].strip()
        if key not in definitions:
            raise ConversionError(f"no generated chronology annotation for: {key}")
        projected = chronology_projection(definitions[key])
        expected.append(projected)
        return projected

    return replace_grouped_macro(body, "chronologyannotation", 1, resolve), expected


def local_definitions(preamble: str) -> str:
    """Carry the leaf's own presentation macros through; the shim wins conflicts."""
    kept, index = [], 0
    while (match := DEFINE_RE.search(preamble, index)) is not None:
        # \newcommand takes a name and a body; \newenvironment takes a name and
        # both delimiters.  Optional [n] arguments may sit between them, and the
        # corpus wraps definitions across lines.
        wanted = 3 if "environment" in match.group(0) else 2
        cursor, parts, mandatory = match.end(), [], 0
        try:
            while mandatory < wanted:
                cursor = skip_gap(preamble, cursor)
                if preamble[cursor : cursor + 1] == "[":
                    close = preamble.index("]", cursor) + 1
                    parts.append(preamble[cursor:close])
                    cursor = close
                    continue
                body, cursor = brace_group(preamble, cursor)
                parts.append("{" + body + "}")
                mandatory += 1
        except (ConversionError, ValueError):
            index = match.end()
            continue
        kept.append(match.group(0) + "".join(parts))
        index = cursor
    return "\n".join(kept)


def deduplicate_contributions(body: str) -> str:
    """Keep contribution declarations inert in the reader-facing web edition."""
    out, index, previous = [], 0, None
    for match in CONTRIBUTION_RE.finditer(body):
        if match.start() < index:
            continue
        cursor, groups = match.end(), []
        for _ in range(3):
            group, cursor = brace_group(body, cursor)
            groups.append(group)
        out.append(body[index : match.start()])
        repeat = previous == tuple(groups[:2])
        previous = tuple(groups[:2])
        name = r"\AIModelContributionRepeat" if repeat else r"\AIModelContribution"
        out.append(name + "".join("{" + group + "}" for group in groups))
        index = cursor
    out.append(body[index:])
    return "".join(out)


def strip_layout_macros(body: str) -> str:
    """Drop in-body heading restyling, which carries no text and stops pandoc."""
    out, index = [], 0
    for match in LAYOUT_MACRO_RE.finditer(body):
        if match.start() < index:
            continue
        cursor = match.end()
        while True:
            gap = body[cursor:]
            skipped = len(gap) - len(gap.lstrip())
            # A blank line ends the call; beyond it a group belongs to the text.
            if "\n\n" in body[cursor : cursor + skipped]:
                break
            probe = cursor + skipped
            if body[probe : probe + 1] == "{":
                _, cursor = brace_group(body, probe)
            elif body[probe : probe + 1] == "[":
                cursor = body.index("]", probe) + 1
            else:
                break
        out.append(body[index : match.start()])
        index = cursor
    out.append(body[index:])
    return "".join(out)


def defined_names(text: str) -> set[str]:
    return {name for match in DEFINITION_RE.finditer(text) for name in match.groups() if name}


def undefined_uses(sources: dict[Path, str], defined: set[str]) -> list[str]:
    """Name every control sequence pandoc would delete, with the file that uses it."""
    failures = []
    scanned = {path: strip_for_scan(text) for path, text in sorted(sources.items())}
    # A section file may define a macro that main.tex uses, so definitions are
    # pooled across the whole assembled document before anything is judged.
    known = defined.union(*(defined_names(text) for text in scanned.values()))
    for path, text in scanned.items():
        for name in sorted(set(COMMAND_RE.findall(text)) - {""}):
            if name not in known and name not in KNOWN_COMMANDS:
                failures.append(f"{path}: unknown macro \\{name}")
        for name in sorted(set(ENVIRONMENT_RE.findall(text))):
            if name not in known and name not in KNOWN_ENVIRONMENTS:
                failures.append(f"{path}: unknown environment {name}")
    return failures


def resolve_anchors(markdown: str) -> str:
    """Unlink a cross-reference to a label no heading in the page carries."""
    # A reference's pandoc attributes restate the label and carry no text.
    markdown = LINK_ATTRIBUTE_RE.sub(r"\1", markdown)
    declared = set(ANCHOR_DEFINITION_RE.findall(markdown))
    return ANCHOR_LINK_RE.sub(
        lambda match: match.group(0) if match.group(2) in declared else match.group(1),
        markdown,
    )


def normalize_unnumbered_headings(markdown: str, labels: set[str]) -> str:
    """Drop Pandoc-only heading metadata without discarding source labels."""
    return UNNUMBERED_HEADING_ATTRIBUTE_RE.sub(
        lambda match: (
            f"{match.group(1)} {{#{match.group(2)}}}"
            if match.group(2) in labels
            else match.group(1)
        ),
        markdown,
    )


def table_count(body: str, definitions: str) -> int:
    """Count table environments the body opens, including named table wrappers."""
    names = {"tabular", "tabularx", "longtable"}
    for match in TABLE_ENVIRONMENT_RE.finditer(definitions):
        cursor = match.end()
        try:
            while definitions[cursor:].lstrip()[:1] == "[":
                cursor += definitions[cursor:].index("]") + 1
            opening, _ = brace_group(definitions, cursor)
        except (ConversionError, ValueError):
            continue
        if any(start in opening for start in TABLE_STARTS):
            names.add(match.group(1))
    return sum(
        len(re.findall(r"\\begin\s*\{" + name + r"\}", body)) for name in sorted(names)
    )


# Pure line-breaking hints. They carry no content, so pandoc is free to leave
# them in place -- and does, inside \url and \texttt, where it copies its
# argument verbatim. In a URL that is not merely untidy: it publishes a broken
# link, because the reader's browser gets the macro as part of the address.
# Stripping them from the markdown is lossless, and it is the only place the
# fix belongs, since the LaTeX needs the hints to break a long URL on paper.
CONTENTLESS_BREAKS_RE = re.compile(
    r"\\{1,2}(?:allowbreak|nobreak|linebreak|newline|-|/)(?![A-Za-z])\s*"
)


def strip_contentless_breaks(markdown: str) -> str:
    """Remove break hints pandoc passed through verbatim."""
    return CONTENTLESS_BREAKS_RE.sub("", markdown)


def source_openings(sources: str) -> set[str]:
    """Every word the leaf's own files open a passage of running text with."""
    openings = set()
    for piece in SOURCE_BREAK_RE.split(COMMENT_RE.sub("", sources)):
        word = WORD_RE.search(CONTROL_WORD_RE.sub(" ", piece))
        if word is not None:
            openings.add(word.group().casefold())
    return openings


def prose_blocks(markdown: str) -> list[str]:
    """The output blocks that carry a sentence, stripped of their own markup."""
    text = MARKDOWN_TARGET_RE.sub("]", MARKDOWN_TAG_RE.sub(" ", markdown))
    blocks = []
    for block in BLOCK_SPLIT_RE.split(text):
        block = re.sub(r"^[ \t]*>[ \t]?", "", block, flags=re.MULTILINE).strip()
        if not block or block.startswith(OPAQUE_BLOCK_PREFIXES + ("#",)):
            blocks.append("")
            continue
        blocks.append(MARKDOWN_OPENING_RE.sub("", block).strip())
    return blocks


def reflowed_sentences(sources: str, markdown: str) -> list[str]:
    """Name every paragraph the output opened in the middle of a sentence."""
    # Without the leaf's own files there is nothing to judge an opening against,
    # and a check with no reference would report every lowercase opening there is.
    if not sources.strip():
        return []
    openings = source_openings(sources)
    blocks = prose_blocks(markdown)
    broken = []
    for index, block in enumerate(blocks[1:], start=1):
        previous = blocks[index - 1]
        if not block or not previous or SENTENCE_END_RE.search(previous):
            continue
        word = WORD_RE.match(block)
        if word is None or not word.group()[:1].islower():
            continue
        if word.group().casefold() not in openings:
            broken.append(f"{previous[-40:]!r} then {block[:40]!r}")
    return broken


def normalize_audit_text(text: str) -> str:
    """Normalize spacing, dashes and bold wrappers without dropping their text."""
    text = replace_grouped_macro(text, "textbf", 1, lambda arguments: arguments[0])
    text = text.replace("**", "")
    text = COMMENT_RE.sub("", text).replace(r"\space", " ").replace("~", " ")
    text = text.replace("--", "-")
    text = re.sub(r"[\N{EN DASH}\N{EM DASH}\N{MINUS SIGN}]", "-", text)
    return re.sub(r"\s+", " ", text.replace("\\", "")).strip()


def audit_output(
    body: str,
    markdown: str,
    tables: int = 0,
    chronology_annotations: list[str] | None = None,
    sources: str = "",
) -> list[str]:
    """Compare critical macro payloads in the LaTeX body against the Markdown."""
    failures = []
    # A table pandoc could not write as a pipe table becomes an HTML table; a
    # table it dropped becomes neither.  A repeated-header longtable may split
    # into several tables, so only a shortfall is a loss.
    written = len(OUTPUT_TABLE_RE.findall(markdown)) + markdown.count("<table")
    if written < tables:
        failures.append(f"{tables} table environments became {written} tables")
    # A headerless source table legitimately writes an empty header row, which
    # is the one immediately above the delimiter; any other is a dropped row.
    lines = markdown.splitlines()
    blank = sum(
        1
        for index, line in enumerate(lines)
        if EMPTY_ROW_RE.match(line)
        and not OUTPUT_TABLE_RE.match(lines[index + 1] if index + 1 < len(lines) else "")
    )
    if blank:
        failures.append(f"{blank} table row(s) written with every cell empty")
    divs = FENCED_DIV_RE.findall(markdown)
    if divs:
        failures.append(f"{len(divs)} unconverted fenced-div delimiter(s) left in output")
    reflowed = reflowed_sentences(sources, markdown)
    if reflowed:
        failures.append(
            f"{len(reflowed)} paragraph(s) opened on a lowercase word the leaf's "
            "sources open none with, after a block that closed no sentence: "
            + "; ".join(reflowed)
        )
    source_headings = {
        level: len(
            re.findall(
                rf"\\{name}\*?\s*\{{",
                body,
            )
        )
        for level, name in (
            (2, "section"),
            (3, "subsection"),
            (4, "subsubsection"),
            (5, "paragraph"),
            (6, "subparagraph"),
        )
    }
    output_headings = {
        level: len(re.findall(rf"^{'#' * level}\s+", markdown, re.MULTILINE))
        for level in source_headings
    }
    for level, expected in source_headings.items():
        if output_headings[level] < expected:
            failures.append(
                f"{expected} level-{level} source heading(s) became "
                f"{output_headings[level]} heading(s)"
            )
    anchors = ANCHOR_DEFINITION_RE.findall(markdown)
    duplicate_anchors = sorted(
        anchor for anchor in set(anchors) if anchors.count(anchor) > 1
    )
    if duplicate_anchors:
        failures.append("duplicate heading anchor(s): " + " ".join(duplicate_anchors))
    linked_targets = {target for _, target in ANCHOR_LINK_RE.findall(markdown)}
    missing_targets = sorted(linked_targets - set(anchors))
    if missing_targets:
        failures.append("missing internal anchor target(s): " + " ".join(missing_targets))
    # Table cells and escapes reflow the text; flattening lets a payload be
    # searched for as the continuous run of words it is.
    flat = flatten(markdown.replace("|", " "))
    notes, kept = len(NOTE_MACRO_RE.findall(body)), len(FOOTNOTE_DEF_RE.findall(markdown))
    if kept < notes:
        failures.append(f"{notes} endnote/footnote calls became {kept} footnotes")
    # A URL must survive verbatim; prose payloads are only checked where LaTeX
    # and Markdown spell them identically.
    for macro in (r"\sourceurl", r"\href", r"\work", r"\latin", r"\Latin", r"\CanonLatin"):
        verbatim = macro in (r"\sourceurl", r"\href")
        for match in re.finditer(re.escape(macro) + r"\s*\{", body):
            payload = brace_group(body, match.end() - 1)[0].strip()
            if not (verbatim or SAFE_PAYLOAD_RE.match(payload)):
                continue
            if payload and flatten(payload) not in flat:
                failures.append(f"{macro} payload dropped: {payload}")
    # Math is passed through as math and is not a dropped macro.
    residual = sorted(set(re.findall(r"\\[A-Za-z@]{2,}", MATH_RE.sub(" ", markdown))))
    if residual:
        failures.append("raw LaTeX left in output: " + " ".join(residual))
    raw_chronology = sorted(set(RAW_CHRONOLOGY_TOKEN_RE.findall(markdown)))
    if raw_chronology:
        failures.append(
            "raw generated chronology annotation token(s) left in output: "
            + " ".join(raw_chronology)
        )
    normalized_markdown = normalize_audit_text(markdown)
    for payload, expected_count in Counter(
        normalize_audit_text(annotation) for annotation in chronology_annotations or []
    ).items():
        actual_count = normalized_markdown.count(payload)
        if actual_count < expected_count:
            failures.append(
                "generated chronology annotation payload shortfall: "
                f"expected {expected_count}, found {actual_count}: {payload}"
            )
    if "Reuse and rights." not in markdown:
        failures.append("rights colophon missing from output")
    if "Last revised (UTC):" not in markdown:
        failures.append("revision timestamp missing from output")
    if re.search(r"\bModel\s*:", markdown, re.IGNORECASE):
        failures.append("reader-visible model metadata remains in output")
    if re.search(r"\beffort\s*=", markdown, re.IGNORECASE):
        failures.append("reader-visible model effort remains in output")
    return failures


def convert(provider: str, leaf: str, out: Path = OUT) -> Path:
    main = SRC / provider / leaf / "main.tex"
    if not main.is_file():
        raise ConversionError(f"no such document: {main}")
    source = main.read_text(encoding="utf-8")
    proper = (main.parent / "proper-components.toml").is_file()
    source = select_web_branches(source, proper=proper)
    head, tail = split_document(source)
    # Preamble includes supply definitions but never content, so they are not
    # scanned; only what reaches the body can lose scholarship.
    preamble = assemble(head, provider, None, proper=proper)
    sources: dict[Path, str] = {main: tail}
    body = assemble(tail, provider, sources, proper=proper)
    if proper:
        components = tomllib.loads((main.parent / "proper-components.toml").read_text())
        body = anchor_appointed_elements(body, set(components.get("element_keys", [])))
    body, chronology_annotations = expand_chronology_annotations(body, preamble)
    title, subtitle = pdf_metadata(preamble)
    body = TITLEPAGE_RE.sub("", body).replace(r"\tableofcontents", "")
    body = REGISTER_ASSIGNMENT_RE.sub("", body)
    body = PARTIAL_RULE_RE.sub("", body)
    body = ALIGNMENT_FIXUP_RE.sub("", body)
    body = strip_layout_macros(body)
    body = LIST_OPTION_RE.sub(r"\1", body)
    body = deduplicate_contributions(body)
    if r"\TriptychRightsNotice" not in body:
        body += "\n\\TriptychRightsNotice\n"
    shim_text = ALIGNMENT_FIXUP_RE.sub("", SHIM.read_text(encoding="utf-8"))
    locals_text = ALIGNMENT_FIXUP_RE.sub(
        "", LIST_OPTION_RE.sub(r"\1", local_definitions(preamble))
    )
    failures = undefined_uses(sources, defined_names(shim_text + locals_text))
    if failures:
        raise ConversionError("\n".join(failures))
    with tempfile.NamedTemporaryFile("w", suffix=".tex", encoding="utf-8") as handle:
        handle.write(
            f"{shim_text}\n{locals_text}\n"
            f"\\begin{{document}}\n{body}\n\\end{{document}}\n"
        )
        handle.flush()
        # Source \section becomes H2 so the document title alone holds H1. The
        # output dialect is narrowed to what the site's Markdown renderer reads:
        # pipe tables only, no header attributes, and literal typography rather
        # than ASCII stand-ins no downstream renderer would resolve.
        command = ["pandoc", "-f", "latex", "-t", MARKDOWN_DIALECT, "--wrap=none",
                   "--shift-heading-level-by=1", handle.name]
        result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise ConversionError(f"pandoc failed:\n{result.stderr.strip()}")
    if MATH_WARNING_RE.search(result.stderr):
        raise ConversionError(f"math left as raw TeX:\n{result.stderr.strip()}")
    markdown = strip_contentless_breaks(
        normalize_unnumbered_headings(
            resolve_anchors(result.stdout), set(LABEL_RE.findall(body))
        )
    )
    # The paragraph audit is judged against the leaf's files as they stand on
    # disk, before any branch was selected or any macro resolved, so a rewriting
    # that introduced a break cannot supply the reference that excuses it.
    raw_sources = "\n\n".join(
        path.read_text(encoding="utf-8") for path in sorted(sources)
    )
    failures = audit_output(
        body,
        markdown,
        table_count(body, shim_text + locals_text),
        chronology_annotations,
        shim_text + "\n\n" + raw_sources,
    )
    if failures:
        raise ConversionError("\n".join(failures))
    heading = f"# {title}\n"
    if subtitle:
        heading += f"\n*{subtitle}*\n"
    destination = out / provider / f"{leaf}.md"
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(f"{heading}\n{markdown}", encoding="utf-8")
    return destination


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", required=True)
    parser.add_argument("documents", nargs="*")
    parser.add_argument("--all", action="store_true")
    parser.add_argument(
        "--output",
        type=Path,
        default=OUT,
        help="write below this directory instead of build/web/",
    )
    with_examples(parser, EXAMPLES[""])
    arguments = parser.parse_args()
    root = SRC / arguments.provider
    if arguments.all:
        leaves = sorted(str(p.parent.relative_to(root)) for p in root.rglob("main.tex"))
    elif arguments.documents:
        leaves = [document.strip("/") for document in arguments.documents]
    else:
        parser.error("give one or more document ids or --all")
    status = 0
    for leaf in leaves:
        try:
            print(convert(arguments.provider, leaf, arguments.output))
        except ConversionError as error:
            print(f"web-edition: {arguments.provider}/{leaf}\n{error}", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
