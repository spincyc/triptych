# that neither TeX nor pandoc reads there.
TEX_COMMENT_RE = re.compile(
    r"(\\(?:url|href|nolinkurl)\s*\{[^{}]*\}|\\.)"
    r"|^[ \t]*%[^\n]*(?:\n|\Z)|%[^\n]*",
    re.DOTALL | re.MULTILINE,
)
# Pandoc can leave fenced-div syntax inside a block quote.  The site's
# Python-Markdown renderer does not enable fenced divs, so either form would
# become reader-visible punctuation.
FENCED_DIV_RE = re.compile(r"^[ \t]*(?:>[ \t]*)?:::", re.MULTILINE)
ANCHOR_DEFINITION_RE = re.compile(r"\{#([^\s{}]+)[^{}]*\}")
ANCHOR_LINK_RE = re.compile(r"\[((?:[^\[\]\\]|\\.)*)\]\(#([^)\s]+)\)")
LINK_ATTRIBUTE_RE = re.compile(r"(\]\([^()\s]+\))\{[^{}]*\}")
TABLE_ENVIRONMENT_RE = re.compile(r"\\newenvironment\*?\s*\{([A-Za-z@]+)\}")
TABLE_STARTS = (r"\begin{longtable}", r"\begin{tabularx}", r"\begin{tabular}")
# Pandoc sizes each delimiter cell to its column's widest content, so a column
# whose every cell is one character wide is written "-:" or ":-". Requiring two
# dashes therefore missed whole tables that were present, and reported them as
# dropped. A dropped table emits no delimiter row at all, so accepting a single
# dash removes the false positive without weakening the shortfall check.
OUTPUT_TABLE_RE = re.compile(r"^\|(?:[ :]*-+[ :]*\|)+\s*$", re.MULTILINE)
# A row of nothing but cell separators is a row whose text the reader dropped.
EMPTY_ROW_RE = re.compile(r"^\|(?:\s*\|)+[ \t]*$", re.MULTILINE)
# A construct pandoc could not carry inline becomes a block boundary, and the
# tail of the sentence it stood in is then set as a paragraph of its own. The
# reader meets that as a paragraph opening on a lowercase word, after a block
# that never closed its sentence -- the one signature the damage always leaves,
# whatever construct did the cutting. It is judged against the leaf's own files
# as they stand on disk, not against the body the conversion has already
# rewritten, so a rewriting that introduces the break cannot also excuse it.
BLOCK_SPLIT_RE = re.compile(r"\n[ \t]*\n")
MARKDOWN_OPENING_RE = re.compile(
    r"^(?:[>\s]*)(?:(?:[-*+]|\d+\.)[ \t]+)?[\\*_`~\[\]("
    "\N{LEFT DOUBLE QUOTATION MARK}\N{LEFT SINGLE QUOTATION MARK}\"']*"
)
# Every LaTeX boundary a run of words may not be read across: a blank line, a
# row or cell break, a list item, a heading, an environment edge. The
# environment alternative eats the name and any column spec with it, so a
# `tabular` argument does not enter the run as words of its own.
SOURCE_BREAK_RE = re.compile(
    r"\n[ \t]*\n"
    r"|\\(?:begin|end)\s*\{[^{}]*\}(?:[ \t]*\[[^\[\]]*\])?(?:[ \t]*\{[^{}]*\})?"
    r"|\\\\(?:[ \t]*\[[^\[\]]*\])?"
    r"|&"
    r"|\\(?:item|par|newline|linebreak|hline|tabularnewline|toprule|midrule"
    r"|bottomrule|clearpage|newpage|pagebreak"
    r"|(?:sub){0,2}section\*?|(?:sub)?paragraph\*?)(?![A-Za-z@])"
)
CONTROL_WORD_RE = re.compile(r"\\[A-Za-z@]+\*?")
MARKDOWN_TAG_RE = re.compile(r"<[^<>]*>")
MARKDOWN_TARGET_RE = re.compile(r"\]\([^()\s]*\)")
WORD_RE = re.compile(r"[^\W\d_]+")
# A block already closed by its own terminal punctuation, or by the marker of a
# note that carries the rest of its thought, is a block that ended -- whatever
# the next one opens with.
SENTENCE_END_RE = re.compile(
    r"(?:[.!?:;]|\[\^[^\]]+\])[)\]\"'*_`"
    "\N{RIGHT DOUBLE QUOTATION MARK}\N{RIGHT SINGLE QUOTATION MARK}]*$"
)
# Only prose is compared: a table, a raw HTML block and a fenced code block
# carry no sentence for a construct to cut in half.
OPAQUE_BLOCK_PREFIXES = ("|", "<", "```", ":::", "$$")
MATH_WARNING_RE = re.compile(r"^\[WARNING\] Could not convert TeX math", re.MULTILINE)
DEFINE_RE = re.compile(r"\\(?:new|renew|provide)command\*?|\\(?:new|renew)environment\*?")
CHRONOLOGY_DEFINITION_RE = re.compile(
    r"\\expandafter\s*\\def\s*\\csname\s*"
    r"triptychchronologyannotation@([A-Za-z0-9._:-]+)\s*\\endcsname\s*\{"
)
RAW_CHRONOLOGY_TOKEN_RE = re.compile(
    r"triptychchronologyannotation@[A-Za-z0-9._:-]+"
)


class ConversionError(RuntimeError):
    """A conversion that would lose content, reported instead of written."""


def brace_group(text: str, start: int) -> tuple[str, int]:
    """Return the balanced ``{...}`` group beginning at or after ``start``."""
    index, depth, escaped = start, 0, False
    while index < len(text) and text[index].isspace():
        index += 1
    if index >= len(text) or text[index] != "{":
        raise ConversionError(f"expected a brace group at offset {start}")
    for cursor in range(index, len(text)):
        # A row-ending \\ must not be read as escaping the brace that follows it.
        if escaped:
            escaped = False
            continue
        if text[cursor] == "\\":
            escaped = True
            continue
        depth += (text[cursor] == "{") - (text[cursor] == "}")
        if depth == 0:
            return text[index + 1 : cursor], cursor + 1
    raise ConversionError(f"unbalanced brace group at offset {start}")


def flatten(text: str) -> str:
    return re.sub(r"\s+", " ", text.replace("\\", "")).strip()


def clean_markdown_line_endings(markdown: str) -> str:
    """Preserve hard breaks as HTML while emitting no trailing whitespace."""
    terminal_newline = markdown.endswith("\n")
    lines = []
    for line in markdown.splitlines():
        match = re.search(r"[ \t]{2,}$", line)
        lines.append((line[:match.start()] + "<br>") if match else line.rstrip(" \t"))
    return "\n".join(lines) + ("\n" if terminal_newline else "")


def strip_for_scan(text: str) -> str:
    return MATH_RE.sub(" ", COMMENT_RE.sub("", text))


def resolve_input(name: str, provider: str) -> Path | None:
    """Resolve ``\\input{name}`` under the build's ``cd src/<provider>; TEXINPUTS=..``."""
    candidates = (SRC / provider / name, SRC / provider / f"{name}.tex",
                  SRC / name, SRC / f"{name}.tex")
    return next((path for path in candidates if path.is_file()), None)


def select_branch(match: re.Match[str]) -> str:
    """Splice the web branch in so it contributes no whitespace of its own.

    The inline form, marked by the empty group after \\fi, is spliced flush.
    The block form keeps its line structure but not the newlines its own
    delimiters stand on: the source already ended a line before \\ifdefined and
    begins one after \\fi, so returning a branch that still starts and ends with
    a newline hands pandoc a blank line at each seam. Where the guard stands
    between blocks those blank lines are harmless -- the blocks were separate
    anyway. Where it stands mid-sentence they are not, and a reference set as
    one continuous bullet on the page became three paragraphs, two of them
    sentence fragments, in the web edition of every leaf that had one.
    """
    branch = match.group(2)
    following = match.string[match.end() : match.end() + len(INLINE_BRANCH_MARKER)]
    if following == INLINE_BRANCH_MARKER:
        return BRANCH_TAIL_RE.sub("", branch.lstrip())
    if match.string[match.start() - 1 : match.start()] == "\n":
        branch = branch[1:] if branch.startswith("\n") else branch
    if match.string[match.end() : match.end() + 1] == "\n":
        branch = branch[:-1] if branch.endswith("\n") else branch
    return branch


def select_web_branches(text: str, *, proper: bool = False) -> str:
    """Select web-active text before resolving includes or auditing commands."""
    text = LEAD_COMMENT_RE.sub("", text)
    text = PRINT_EDITION_BRANCH_RE.sub(select_branch, text)
    if proper:
        text = SYNTHESIS_EDITION_BRANCH_RE.sub(select_branch, text)
    return text


def heading_element_key(title: str) -> str:
    """The declared element a heading names, ignoring any ordinal before it."""
    text = re.sub(r"^\s*\d+\.\s*", "", title.lstrip())
    name = re.match(r"[A-Za-z][A-Za-z-]*", text)
    return name.group().lower() if name else ""


def anchor_appointed_elements(body: str, element_keys: set[str]) -> str:
    r"""Give unlabeled appointed-text headings the manifest's stable element key.

    Two heading forms, judged differently. `\fulltextheading` exists to head an
    appointed element and nothing else, so a name it carries that the manifest
    does not declare is a defect and stops the conversion. `\subsection*` heads
    an appointed element in some leaves and ordinary prose in all of them, so a
    name the manifest does not declare is simply not an appointed heading and is
    passed over. Both forms yield the same anchor, which is the point: an
    element's durable anchor must not depend on which macro its leaf heads it
    with, and until now it did -- every claude edition had none.
    """
    anchored = []
    for match in APPOINTED_HEADING_RE.finditer(body):
        title, end = brace_group(body, match.end())
        key = heading_element_key(title)
        if key not in element_keys:
            raise ConversionError(f"undeclared appointed element in heading: {title}")
        anchored.append((end, key))
    for match in NUMBERED_HEADING_RE.finditer(body):
        title, end = brace_group(body, match.end())
        named = APPOINTED_TITLE_RE.match(title)
        if named and named.group(1).lower() in element_keys:
            anchored.append((end, named.group(1).lower()))
    out, index = [], 0
    for end, key in sorted(anchored):
        out.append(body[index:end])
        if not LABEL_RE.match(body[end:].lstrip()):
            out.append(r"\label{proper-" + key + "}")
        index = end
    out.append(body[index:])
    return "".join(out)


def proper_anchor_failures(anchors: list[str], expected: set[str], stage: str) -> list[str]:
    """Check identity and multiplicity, not whether an author chose the right passage."""
    counts = Counter(anchor for anchor in anchors if anchor.startswith("proper-"))
    failures = []
    for description, keys in (
        ("missing", expected - counts.keys()),
        ("undeclared", counts.keys() - expected),
        ("duplicate", {key for key, count in counts.items() if count > 1}),
    ):
        if keys:
            failures.append(f"{description} schema-2 {stage} proper anchor(s): " + ", ".join(sorted(keys)))
    return failures


def rendered_markdown_targets(markdown: str) -> tuple[list[str], set[str]]:
    """Read IDs and proper links using the site's owning renderer and dependency lock."""
    try:
        rendered = render_markdown(markdown, ROOT)
    except MarkdownRenderError as exc:
        raise ConversionError(f"schema-2 site-rendered anchor audit failed: {exc}") from exc

    class AnchorParser(HTMLParser):
        def __init__(self) -> None:
            super().__init__()
            self.anchors: list[str] = []
            self.proper_links: set[str] = set()

        def handle_starttag(self, tag: str, attributes: list[tuple[str, str | None]]) -> None:
            self.anchors.extend(value for name, value in attributes if name == "id" and value is not None)
            for name, value in attributes:
                if name == "href" and value is not None and value.startswith("#"):
                    target = unquote(value[1:])
                    if target.startswith("proper-"):
                        self.proper_links.add(target)

    parser = AnchorParser()
    parser.feed(rendered)
    return parser.anchors, parser.proper_links


def rendered_markdown_anchors(markdown: str) -> list[str]:
    return rendered_markdown_targets(markdown)[0]


def audit_schema_two_targets(
    markdown: str, expected: set[str],
) -> list[str]:
    anchors, links = rendered_markdown_targets(markdown)
    failures = proper_anchor_failures(anchors, expected, "rendered")
    missing_links = links - set(anchors)
    if missing_links:
        failures.append("unresolved schema-2 proper fragment(s): " + ", ".join(sorted(missing_links)))
    if failures:
        raise ConversionError("\n".join(failures))
    return anchors


def assemble(
    text: str, provider: str, seen: dict[Path, str] | None, *, proper: bool = False
) -> str:
    """Inline every ``\\input`` in ``text``; record each file when ``seen`` is given."""
    text = select_web_branches(text, proper=proper)
    out, index = [], 0
    for match in INPUT_RE.finditer(text):
        out.append(text[index : match.start()])
        index = match.end()
        name = match.group(1).strip()
        # The shim replaces the shared preamble. Tests and historical sources
        # need not provide a physical copy; schema-2 graph validation already
        # requires and records it when the current contract applies.
        if name.endswith("common/preamble"):
            target = resolve_input(name, provider)
            if seen is not None and target is not None:
                seen[target.resolve()] = target.read_text(encoding="utf-8")
            continue
        target = resolve_input(name, provider)
        if target is None:
            raise ConversionError(f"cannot resolve \\input{{{name}}}")
        target = target.resolve()
        nested = target.read_text(encoding="utf-8")
        nested = select_web_branches(nested, proper=proper)
        if seen is not None:
            seen[target] = nested
        out.append(assemble(nested, provider, seen, proper=proper))
    out.append(text[index:])
    return "".join(out)


def split_document(text: str) -> tuple[str, str]:
    begin = text.find(r"\begin{document}")
    end = text.rfind(r"\end{document}")
    if begin < 0 or end < 0:
        raise ConversionError("main.tex has no document environment")
    return text[:begin], text[begin + len(r"\begin{document}") : end]


def pdf_metadata(preamble: str) -> tuple[str, str]:
    values = {}
    for match in HYPERSETUP_RE.finditer(preamble):
        values[match.group(1)] = brace_group(preamble, match.end() - 1)[0]
    if "title" not in values:
        raise ConversionError("no pdftitle in \\hypersetup")
    return values["title"], values.get("subject", "")


def skip_gap(text: str, cursor: int) -> int:
    """Advance past the whitespace and comments between a definition's groups."""
    while True:
        cursor += len(text[cursor:]) - len(text[cursor:].lstrip())
        if text[cursor : cursor + 1] != "%":
            return cursor
        newline = text.find("\n", cursor)
        cursor = len(text) if newline < 0 else newline + 1


def replace_grouped_macro(
    text: str, name: str, argument_count: int, replacement
) -> str:
    """Replace calls to a known brace-argument macro without flattening nesting."""
    pattern = re.compile(re.escape("\\" + name) + r"\s*\{")
    out, index = [], 0
    while (match := pattern.search(text, index)) is not None:
        out.append(text[index : match.start()])
        cursor, arguments = match.end() - 1, []
        for _ in range(argument_count):
            argument, cursor = brace_group(text, cursor)
            arguments.append(argument)
        out.append(replacement(arguments))
        index = cursor
    out.append(text[index:])
    return "".join(out)


def chronology_projection(body: str) -> str:
    """Resolve the generated annotation helper macros to their visible payload."""
    body = replace_grouped_macro(body, "chronologyannotationreach", 3, lambda _: "")
    body = replace_grouped_macro(
        body, "chronologyannotationcomparisonclaim", 8,
        lambda arguments: arguments[7]
    )
    body = replace_grouped_macro(
        body, "chronologyannotationclaim", 6, lambda arguments: arguments[5]
    )
    body = replace_grouped_macro(
        body, "chronologyannotationcomparisongroup", 4,
        lambda arguments: arguments[3]
    )
    return replace_grouped_macro(
        body, "chronologyannotationgroup", 3, lambda arguments: arguments[2]
    )


def expand_chronology_annotations(
    body: str, definition_source: str
) -> tuple[str, list[str]]:
    """Expand deterministic generated chronology definitions before pandoc."""
    definitions: dict[str, str] = {}
    for match in CHRONOLOGY_DEFINITION_RE.finditer(definition_source):
        key = match.group(1)
        if key in definitions:
            raise ConversionError(f"duplicate generated chronology annotation: {key}")
        definitions[key] = brace_group(definition_source, match.end() - 1)[0]

    expected = []

    def resolve(arguments: list[str]) -> str:
        key = arguments[0].strip()
        if key not in definitions:
            raise ConversionError(f"no generated chronology annotation for: {key}")
        projected = chronology_projection(definitions[key])
        expected.append(projected)
        return projected

    return replace_grouped_macro(body, "chronologyannotation", 1, resolve), expected


def local_definitions(preamble: str) -> str:
    """Carry the leaf's own presentation macros through; the shim wins conflicts."""
    kept, index = [], 0
    while (match := DEFINE_RE.search(preamble, index)) is not None:
        # \newcommand takes a name and a body; \newenvironment takes a name and
        # both delimiters.  Optional [n] arguments may sit between them, and the
        # corpus wraps definitions across lines.
        wanted = 3 if "environment" in match.group(0) else 2
        cursor, parts, mandatory = match.end(), [], 0
        try:
            while mandatory < wanted:
                cursor = skip_gap(preamble, cursor)
                if preamble[cursor : cursor + 1] == "[":
                    close = preamble.index("]", cursor) + 1
                    parts.append(preamble[cursor:close])
                    cursor = close
                    continue
                body, cursor = brace_group(preamble, cursor)
                parts.append("{" + body + "}")
                mandatory += 1
        except (ConversionError, ValueError):
            index = match.end()
            continue
        kept.append(match.group(0) + "".join(parts))
        index = cursor
    return "\n".join(kept)


# A bracket-opening command's argument count, optional default and replacement.
BracketedCommand = tuple[int, str | None, str]


def command_signature(text: str, cursor: int) -> tuple[int, str | None, str, int]:
    """Read ``[n][default]{body}`` after a command name: count, default, body, body start."""
    count, default = 0, None
    cursor = skip_gap(text, cursor)
    if text[cursor : cursor + 1] == "[":
        close = text.index("]", cursor)
        count = int(text[cursor + 1 : close].strip())
        cursor = skip_gap(text, close + 1)
        if text[cursor : cursor + 1] == "[":
            close = text.index("]", cursor)
            default = text[cursor + 1 : close]
            cursor = skip_gap(text, close + 1)
    body, _ = brace_group(text, cursor)
    return count, default, body, cursor


def guard_opening_brackets(
    definitions: str,
) -> tuple[str, dict[str, BracketedCommand]]:
    """Put an empty group ahead of every command body that opens with ``[``.

    Returns the guarded definitions and, for the audit, each such command's
    argument count, optional default and replacement text.
    """
    out, index, guarded = [], 0, {}
    for match in COMMAND_DEFINITION_RE.finditer(definitions):
        try:
            count, default, body, opening = command_signature(definitions, match.end())
        except (ConversionError, ValueError):
            continue
        if not body.lstrip().startswith("["):
            continue
        guarded[match.group(1) or match.group(2)] = (count, default, body)
        opening += 1
        out.append(definitions[index:opening] + "{}")
        index = opening
    out.append(definitions[index:])
    return "".join(out), guarded


def word_phrase(text: str) -> str:
    """The words of a text, casefolded and single-spaced, for sequence matching."""
    return " ".join(word.casefold() for word in WORD_RE.findall(text))


def bracketed_shortfalls(
    body: str, markdown: str, commands: dict[str, BracketedCommand]
) -> list[str]:
    """Name every bracket-opening command call whose words the output lacks."""
    failures: list[str] = []
    expected: Counter[str] = Counter()
    shown: dict[str, str] = {}
    for name, (count, default, replacement) in sorted(commands.items()):
        for match in re.finditer(re.escape("\\" + name) + r"(?![A-Za-z@])", body):
            # A definition in the body names the command without calling it.
            if DEFINITION_HEAD_RE.search(body, max(0, match.start() - 40), match.start()):
                continue
            cursor, arguments = match.end(), []
            try:
                for position in range(count):
                    if position == 0 and default is not None:
                        gap = skip_gap(body, cursor)
                        if body[gap : gap + 1] == "[":
                            close = body.index("]", gap)
                            arguments.append(body[gap + 1 : close])
                            cursor = close + 1
                        else:
                            arguments.append(default)
                        continue
                    argument, cursor = brace_group(body, cursor)
                    arguments.append(argument)
            except (ConversionError, ValueError):
                failures.append(f"cannot read the arguments of a \\{name} call")
                continue
            text = replacement
            for number, argument in enumerate(arguments, start=1):
                text = text.replace(f"#{number}", argument)
            phrase = word_phrase(CONTROL_WORD_RE.sub(" ", COMMENT_RE.sub("", text)))
            if phrase:
                expected[phrase] += 1
                call = "\\" + name + "".join("{" + a + "}" for a in arguments)
                shown.setdefault(phrase, re.sub(r"\s+", " ", call).strip())
    output = MARKDOWN_TARGET_RE.sub("]", MARKDOWN_TAG_RE.sub(" ", markdown))
    output = f" {word_phrase(output)} "
    for phrase, wanted in expected.items():
        found = output.count(f" {phrase} ")
        if found < wanted:
            failures.append(
                f"bracketed macro payload dropped (expected {wanted}, found "
                f"{found}): {shown[phrase]}"
            )
    return failures


# A title macro sets each argument as a line of its own, in argument order.
# Pandoc could not expand the empty-field tests in \propertitle and dropped its
# second and third lines from every proper title block, while the words of both
# still stood in the opening prose, so no search of the whole edition could see
# the loss. Each call's non-empty fields must arrive as that many consecutive
# output blocks, in the same order.
TITLE_MACROS = {"propertitle": 4, "weektitle": 3, "pcweektitle": 3}
TITLE_TOKEN_RE = re.compile(r"[^\W_]+")


def title_tokens(text: str) -> tuple[str, ...]:
    """The casefolded words and numbers of one title line."""
    return tuple(token.casefold() for token in TITLE_TOKEN_RE.findall(text))


def title_shortfalls(body: str, markdown: str) -> list[str]:
    """Name every title block whose declared lines the output does not set."""
    failures: list[str] = []
    expected: Counter[tuple[tuple[str, ...], ...]] = Counter()
    shown: dict[tuple[tuple[str, ...], ...], tuple[str, list[str]]] = {}
    for name, count in sorted(TITLE_MACROS.items()):
        for match in re.finditer(re.escape("\\" + name) + r"(?![A-Za-z@])", body):
            if DEFINITION_HEAD_RE.search(body, max(0, match.start() - 40), match.start()):
                continue
            cursor, fields = match.end(), []
            try:
                for _ in range(count):
                    field, cursor = brace_group(body, cursor)
                    fields.append(field)
            except ConversionError:
                failures.append(f"cannot read the fields of a \\{name} call")
                continue
            declared = [
                (re.sub(r"\s+", " ", field).strip(), tokens)
                for field in fields
                if (tokens := title_tokens(CONTROL_WORD_RE.sub(
                    " ", COMMENT_RE.sub("", field).replace("\\\\", " "))))
            ]
            lines = tuple(tokens for _, tokens in declared)
            if lines:
                expected[lines] += 1
                shown.setdefault(lines, (name, [text for text, _ in declared]))
    text = MARKDOWN_TARGET_RE.sub("]", MARKDOWN_TAG_RE.sub(" ", markdown))
    blocks = [
        tokens for tokens in map(title_tokens, BLOCK_SPLIT_RE.split(text)) if tokens
    ]
    for lines, wanted in expected.items():
        found = sum(
            tuple(blocks[start : start + len(lines)]) == lines
            for start in range(len(blocks) - len(lines) + 1)
        )
        if found < wanted:
            name, texts = shown[lines]
            absent = [text for text, tokens in zip(texts, lines) if tokens not in blocks]
            failures.append(
                f"\\{name} title block not set as its {len(lines)} declared "
                f"line(s) in order (expected {wanted}, found {found})"
                + (": line(s) absent: " + "; ".join(absent) if absent else "")
            )
    return failures


def deduplicate_contributions(body: str) -> str:
    """Keep contribution declarations inert in the reader-facing web edition."""
    out, index, previous = [], 0, None
    for match in CONTRIBUTION_RE.finditer(body):
        if match.start() < index:
            continue
        cursor, groups = match.end(), []
        for _ in range(3):
            group, cursor = brace_group(body, cursor)
            groups.append(group)
        out.append(body[index : match.start()])
        repeat = previous == tuple(groups[:2])
        previous = tuple(groups[:2])
        name = r"\AIModelContributionRepeat" if repeat else r"\AIModelContribution"
        out.append(name + "".join("{" + group + "}" for group in groups))
        index = cursor
    out.append(body[index:])
    return "".join(out)


def strip_tex_comments(text: str) -> str:
    """The text as TeX reads it once its comments are gone."""
    return TEX_COMMENT_RE.sub(lambda match: match.group(1) or "", text)


def mask_tex_comments(text: str) -> str:
    """The text with every comment blanked in place, so offsets still agree."""
    return TEX_COMMENT_RE.sub(
        lambda match: match.group(1) or re.sub(r"[^\n]", " ", match.group(0)), text
    )


def lift_dossier_notes(body: str) -> str:
    """Set each spanned dossier note beneath its row; the table resumes after it.

    Only live source is lifted. A commented-out note is text the PDF never sets,
    so the tables are found in a comment-masked copy and each one's rows are
    read with their comments stripped before any note is moved out of them.
    """
    out, index = [], 0
    for match in DOSSIER_TABLE_RE.finditer(mask_tex_comments(body)):
        name = match.group(1)
        rows = strip_tex_comments(body[match.start(2) : match.end(2)])
        for macro, form in DOSSIER_NOTE_FORMS:
            rows = replace_grouped_macro(
                rows, macro, 1,
                lambda arguments, form=form: (
                    f"\n\\end{{{name}}}\n\n{form.format(arguments[0].strip())}"
                    f"\n\n\\begin{{{name}}}\n"
                ),
            )
        out.append(body[index : match.start()])
        # A segment left with no row of its own, between two notes or after
        # the last, would be a header over nothing.
        out.append(EMPTY_DOSSIER_RE.sub("", f"\\begin{{{name}}}{rows}\\end{{{name}}}"))
        index = match.end()
    out.append(body[index:])
    return "".join(out)


def strip_layout_macros(body: str) -> str:
    """Drop in-body heading restyling, which carries no text and stops pandoc."""
    out, index = [], 0
    for match in LAYOUT_MACRO_RE.finditer(body):
        if match.start() < index:
            continue
        cursor = match.end()
        while True:
            gap = body[cursor:]
            skipped = len(gap) - len(gap.lstrip())
            # A blank line ends the call; beyond it a group belongs to the text.
            if "\n\n" in body[cursor : cursor + skipped]:
                break
            probe = cursor + skipped
            if body[probe : probe + 1] == "{":
                _, cursor = brace_group(body, probe)
            elif body[probe : probe + 1] == "[":
                cursor = body.index("]", probe) + 1
            else:
                break
        out.append(body[index : match.start()])
        index = cursor
    out.append(body[index:])
    return "".join(out)


def defined_names(text: str) -> set[str]:
    return {name for match in DEFINITION_RE.finditer(text) for name in match.groups() if name}


def undefined_uses(sources: dict[Path, str], defined: set[str]) -> list[str]:
    """Name every control sequence pandoc would delete, with the file that uses it."""
    failures = []
    scanned = {path: strip_for_scan(text) for path, text in sorted(sources.items())}
    # A section file may define a macro that main.tex uses, so definitions are
    # pooled across the whole assembled document before anything is judged.
    known = defined.union(*(defined_names(text) for text in scanned.values()))
    for path, text in scanned.items():
        for match in COMMAND_RE.finditer(text):
            if (match.group(1) == "path"
                    and not text[match.end():].lstrip().startswith("{")):
                failures.append(f"{path}: unsupported \\path syntax; expected a braced file locator")
        for name in sorted(set(COMMAND_RE.findall(text)) - {""}):
            if name not in known and name not in KNOWN_COMMANDS:
                failures.append(f"{path}: unknown macro \\{name}")
        for name in sorted(set(ENVIRONMENT_RE.findall(text))):
            if name not in known and name not in KNOWN_ENVIRONMENTS:
                failures.append(f"{path}: unknown environment {name}")
    return failures


def resolve_anchors(markdown: str, anchors: list[str] | None = None) -> str:
    """Unlink references without a heading or an explicitly supplied inline target."""
    # A reference's pandoc attributes restate the label and carry no text.
    markdown = LINK_ATTRIBUTE_RE.sub(r"\1", markdown)
    declared = set(ANCHOR_DEFINITION_RE.findall(markdown) if anchors is None else anchors)
    return ANCHOR_LINK_RE.sub(
        lambda match: match.group(0) if match.group(2) in declared else match.group(1),
        markdown,
    )


def normalize_unnumbered_headings(markdown: str, labels: set[str]) -> str:
    """Drop Pandoc-only heading metadata without discarding source labels."""
    return UNNUMBERED_HEADING_ATTRIBUTE_RE.sub(
        lambda match: (
            f"{match.group(1)} {{#{match.group(2)}}}"
            if match.group(2) in labels
            else match.group(1)
        ),
        markdown,
    )


def table_count(body: str, definitions: str) -> int:
    """Count table environments the body opens, including named table wrappers.

    A commented-out opening sets no table, so it is not counted.
    """
    body = mask_tex_comments(body)
    names = {"tabular", "tabularx", "longtable"}
    for match in TABLE_ENVIRONMENT_RE.finditer(definitions):
        cursor = match.end()
        try:
            while definitions[cursor:].lstrip()[:1] == "[":
                cursor += definitions[cursor:].index("]") + 1
            opening, _ = brace_group(definitions, cursor)
        except (ConversionError, ValueError):
            continue
        if any(start in opening for start in TABLE_STARTS):
            names.add(match.group(1))
    return sum(
        len(re.findall(r"\\begin\s*\{" + name + r"\}", body)) for name in sorted(names)
    )


# Pure line-breaking hints. They carry no content, so pandoc is free to leave
# them in place -- and does, inside \url and \texttt, where it copies its
# argument verbatim. In a URL that is not merely untidy: it publishes a broken
# link, because the reader's browser gets the macro as part of the address.
# Stripping them from the markdown is lossless, and it is the only place the
# fix belongs, since the LaTeX needs the hints to break a long URL on paper.
CONTENTLESS_BREAKS_RE = re.compile(
    r"\\{1,2}(?:allowbreak|nobreak|linebreak|newline|-|/)(?![A-Za-z])\s*"
)
# The subset that must go before pandoc rather than after it. Pandoc does not
# pass \allowbreak through in every context: inside \texttt it consumed the
# token after it, and `sections/50-resumed-sundays.tex` reached the reader as
# `sections/-resumed-sundays.tex` -- a silent deletion no audit could see,
# because the macro the markdown would have carried was eaten along with the
# digits. Stripping these from the copy handed to pandoc is lossless: they are
# break hints with no content, the file on disk keeps them, and the PDF still
# breaks its long identifiers on paper. `\linebreak` and `\newline` stay
# behind, because those a reader does meet as a line ending.
PRE_CONVERSION_BREAKS_RE = re.compile(
    r"\\(?:allowbreak|nobreak|-|/)(?![A-Za-z])\s*"
)
# Pandoc drops \textperiodcentered without a warning, and the identity block of
# every proper guide separates its fields with one: "Dominica Decima Sexta post
# Pentecosten \textperiodcentered{} II classis" reached the reader as "post
# Pentecosten II classis". It was listed among the commands that "may drop
# without losing content", which is true of a break hint and false of a
# separator the reader needs. Substituted before pandoc can drop it.
# `{}` terminates the control word and the space after it is the author's own:
# the identity block writes `\textperiodcentered{} II classis` and means the
# space. Bare, TeX gobbles what follows, and the Catalan geminate in
# `Miscel\textperiodcentered lania` means no space at all. Both forms are in the
# corpus and they differ by exactly that.
PERIOD_CENTERED_RE = re.compile(
    r"\\textperiodcentered(?![A-Za-z])(?:\s*\{\}|\s*)"
)
# Pandoc drops \textemdash and \textendash outright, and the number after either
# with them: "1884\textendash 94" published as "1884". They are set as the
# characters themselves, with the same reading of a following space as above.
TEXT_DASH_RE = re.compile(r"\\text(em|en)dash(?![A-Za-z])(?:\s*\{\}|\s*)")


def set_text_dashes(text: str) -> str:
    return TEXT_DASH_RE.sub(
        lambda match: "\N{EM DASH}" if match.group(1) == "em" else "\N{EN DASH}", text
    )
# Pandoc reads a `[` that follows many control words as that command's optional
# argument and throws it away with the command: \par, \noindent, \nopagebreak,
# \quad and \relax among them, none of which TeX gives such an argument, or only
# a numeric one. TeX never meets the bracket there when a macro supplies it,
# because it does not look through an unexpanded macro for one; pandoc expands
# the macro first. A postconciliar study opened the quotation of Acts 16:14 with
# `\notread{...}`, which sets the unappointed half of the verse in brackets,
# inside an environment whose opening ends in \nopagebreak: the whole bracketed
# clause reached the reader as nothing, and the conversion exited zero. An empty
# group ahead of the bracket sets nothing in either reader and ends the
# lookahead, so every command whose replacement text opens with `[` is handed to
# pandoc with one, and the audit checks that each call's words arrived.
COMMAND_DEFINITION_RE = re.compile(
    r"\\(?:new|renew|provide)command\*?\s*"
    r"(?:\{\s*\\([A-Za-z@]+)\s*\}|\\([A-Za-z@]+))"
)
DEFINITION_HEAD_RE = re.compile(r"\\(?:new|renew|provide)command\*?\s*\{?\s*\Z")


def strip_contentless_breaks(markdown: str) -> str:
    """Remove break hints pandoc passed through verbatim."""
    return CONTENTLESS_BREAKS_RE.sub("", markdown)


def source_openings(sources: str) -> set[str]:
    """Every word the leaf's own files open a passage of running text with."""
    openings = set()
    for piece in SOURCE_BREAK_RE.split(COMMENT_RE.sub("", sources)):
        word = WORD_RE.search(CONTROL_WORD_RE.sub(" ", piece))
        if word is not None:
            openings.add(word.group().casefold())
    return openings


def prose_blocks(markdown: str) -> list[str]:
    """The output blocks that carry a sentence, stripped of their own markup."""
    text = MARKDOWN_TARGET_RE.sub("]", MARKDOWN_TAG_RE.sub(" ", markdown))
    blocks = []
    for block in BLOCK_SPLIT_RE.split(text):
        block = re.sub(r"^[ \t]*>[ \t]?", "", block, flags=re.MULTILINE).strip()
        if not block or block.startswith(OPAQUE_BLOCK_PREFIXES + ("#",)):
            blocks.append("")
            continue
        blocks.append(MARKDOWN_OPENING_RE.sub("", block).strip())
    return blocks


def reflowed_sentences(sources: str, markdown: str) -> list[str]:
    """Name every paragraph the output opened in the middle of a sentence."""
    # Without the leaf's own files there is nothing to judge an opening against,
    # and a check with no reference would report every lowercase opening there is.
    if not sources.strip():
        return []
    openings = source_openings(sources)
    blocks = prose_blocks(markdown)
    broken = []
    for index, block in enumerate(blocks[1:], start=1):
        previous = blocks[index - 1]
        if not block or not previous or SENTENCE_END_RE.search(previous):
            continue
        word = WORD_RE.match(block)
        if word is None or not word.group()[:1].islower():
            continue
        if word.group().casefold() not in openings:
            broken.append(f"{previous[-40:]!r} then {block[:40]!r}")
    return broken


# A brace group is an argument boundary: `\weektitle{title}{subtitle}{rite}`
# sets three fields the page keeps apart, and their words are no more one run
# than two paragraphs are. SOURCE_BREAK_RE does not break on braces because the
# case rule only ever reads the first word after a break.
RUN_BREAK_RE = re.compile(SOURCE_BREAK_RE.pattern + r"|[{}]")


def source_word_runs(sources: str) -> list[list[str]]:
    """The leaf's words, grouped by the runs no reader may be read across."""
    return [
        [word.casefold() for word in WORD_RE.findall(CONTROL_WORD_RE.sub(" ", piece))]
        for piece in RUN_BREAK_RE.split(COMMENT_RE.sub("", sources))
    ]


def severed_runs(sources: str, markdown: str, span: int = 6) -> list[str]:
    """Name every output break that fell inside one unbroken run of source words.

    The case rule in `reflowed_sentences` reads the opening word and cannot see
    a fragment that opens on a capital, which is how a reference cut into three
    paragraphs -- "Council of Trent," / "Session VI ... from the" / "Tauchnitz
    1887 printing" -- passed an audit added to catch exactly that cut. This
    asks the question the case rule approximates, and asks it of the words
    themselves: the source held these words in one run, across no boundary a
    reader may not read across, and the output put a paragraph break in the
    middle of them. It needs no view of what did the cutting, so it reports a
    construct nobody has thought of yet as readily as a spliced edition guard.

    The window is six words either side. Three matched a leaf's own title
    and subtitle standing next to each other in a metadata line, which is a
    real run of those words but not the run the break fell in; six is long
    enough that a coincidental repetition has to quote the whole passage,
    and short enough that any severed sentence carries it. A block with
    fewer than six words of its own is not judged at all: a bold label is
    not a severed sentence, and the case rule already reads those.
    """
    if not sources.strip():
        return []
    runs = source_word_runs(sources)
    blocks = prose_blocks(markdown)
    severed = []
    for index, block in enumerate(blocks[1:], start=1):
        previous = blocks[index - 1]
        if not block or not previous or SENTENCE_END_RE.search(previous):
            continue
        head = [w.casefold() for w in WORD_RE.findall(previous)][-span:]
        tail = [w.casefold() for w in WORD_RE.findall(block)][:span]
        if len(head) < span or len(tail) < span:
            continue
        joined = head + tail
        if any(
            run[start : start + len(joined)] == joined
            for run in runs
            for start in range(len(run) - len(joined) + 1)
        ):
            severed.append(f"{previous[-40:]!r} then {block[:40]!r}")
    return severed


def normalize_audit_text(text: str) -> str:
    """Normalize spacing, punctuation and bold wrappers without dropping text."""
    text = replace_grouped_macro(text, "textbf", 1, lambda arguments: arguments[0])
    text = text.replace("**", "")
    text = COMMENT_RE.sub("", text).replace(r"\space", " ").replace("~", " ")
    # Pandoc smartens an ASCII apostrophe within a name even though the source
    # chronology payload retains ASCII.  This comparison is an omission audit,
    # so that typographic substitution is immaterial; no prose output changes.
    text = text.replace("\N{RIGHT SINGLE QUOTATION MARK}", "'")
    text = text.replace("--", "-")
    text = re.sub(r"[\N{EN DASH}\N{EM DASH}\N{MINUS SIGN}]", "-", text)
    return re.sub(r"\s+", " ", text.replace("\\", "")).strip()


# The row-opening audit. Pandoc's number-swallowing has many triggers, so the
# audit does not name them: it reads what each table cell of the source opens
# with and requires the output to hold a table cell that opens the same way.
#
# The source side is the body as assembled, before any of the converter's own
# rewriting, so no rewriting can hide a loss from it. Comments are stripped
# from the body and from every definition. Commands the body or the leaf
# defines are expanded where a table is built from them, and so are the row
# macros (definitions that contain & or \\) that build rows. Each table, of any
# environment the shim, the leaf or the body defines, is read alone to its own
# \end or its group's close; a nested table leaves its enclosing cell
# unpredictable and is read as its own table; a longtable's continuation head
# is set aside as the web sets it aside. Rows split at \\ and cells at &.
#
# A cell's opening is the first sixteen letters and digits of the literal text
# it starts with, read through text-bearing commands and the leaf's own macros
# and past layout, including any command closed with an empty group. A cell
# that opens with anything the audit cannot predict -- math, a reference, an
# accent or letter command, an unknown command with an argument -- is skipped,
# so the audit cannot misfire on it. A cell whose opening is its whole text
# must be matched exactly: "1" is not found in "12".
#
# The output side is every pipe-table and HTML-table cell reduced the same
# way, footnote references removed. Each opening needs its own output cell;
# exact openings are matched first, then prefixes from the longest down. In a
# leaf of the shared proper format, a dossier note is lifted out of its table,
# so its opening must instead open a paragraph.
BUILTIN_TABLES = {"longtable": 1, "tabular": 1, "tabularx": 2, "tabular*": 2, "array": 1}
OPENING_TEXT_COMMANDS = frozenset(
    """
    textbf textit emph textsc textsl textup textmd textrm textsf texttt textnormal
    underline latin Latin CanonLatin work term Term rubric incipit bid mbox
    textsuperscript textsubscript nolinkurl path hyperref
    """.split()
)
OPENING_SKIP_COMMANDS = {"label": 1, "index": 1, "hspace": 1, "vspace": 1, "phantom": 1,
                         "footnote": 1, "endnote": 1, "rule": 2, "hypertarget": 1,
                         "noalign": 1}
# Commands that set a letter of their own: the opening cannot be predicted.
OPENING_LETTER_COMMANDS = frozenset("aa AA ae AE oe OE ss o O l L i j".split())
OPENING_SPACE_SYMBOLS = frozenset(" ,;:!@/-&%#_$")
OPENING_LENGTH = 16
# A row end's optional spacing argument, as TeX reads it: across spaces and one
# line end, never across a blank line, so "[June] 1923" opening the next row
# after a blank line stays that row's text.
ROW_END_RE = re.compile(
    r"\\\\\*?(?:[ \t]*(?:\n[ \t]*)?\[[^\[\]]*\])?|\\tabularnewline(?![A-Za-z@])"
)
CELL_LAYOUT_RE = re.compile(
    r"\\(?:toprule|midrule|bottomrule|hline|endhead|endfirsthead|endfoot|endlastfoot"
    r"|addlinespace|newpage|pagebreak|clearpage|smallskip|medskip|bigskip|nopagebreak"
    r"|phantomsection)(?![A-Za-z@])(?:\s*\[[^\[\]]*\])?(?:\{\})?"
    r"|\\noalign\s*\{[^{}]*\}|" + PARTIAL_RULE_RE.pattern
)
LIFTED_NOTES = ("dossierprose", "dossierevent")
Macro = tuple[int, str | None, str]


def table_environments(definitions: str) -> dict[str, int]:
    """Table environment names with the brace arguments their \\begin takes."""
    environments = dict(BUILTIN_TABLES)
    for match in TABLE_ENVIRONMENT_RE.finditer(definitions):
        cursor, count = match.end(), 0
        try:
            gap = skip_gap(definitions, cursor)
            if definitions[gap : gap + 1] == "[":
                close = definitions.index("]", gap)
                count, cursor = int(definitions[gap + 1 : close]), close + 1
            opening, _ = brace_group(definitions, cursor)
        except (ConversionError, ValueError):
            continue
        if any(start in opening for start in TABLE_STARTS):
            environments[match.group(1)] = count
    return environments


def command_definitions(
    text: str, macros: dict[str, Macro] | None = None
) -> tuple[dict[str, Macro], str]:
    """The commands the text defines, and the text with the definitions cut out.

    As in pandoc, the first definition of a name stands and only \\renewcommand
    replaces it, so the shim, read first, wins over a leaf's own definition.
    """
    macros, cuts = dict(macros or {}), []
    for match in COMMAND_DEFINITION_RE.finditer(text):
        try:
            count, default, body, opening = command_signature(text, match.end())
            _, end = brace_group(text, opening)
        except (ConversionError, ValueError):
            continue
        name = match.group(1) or match.group(2)
        if name not in macros or match.group(0).startswith("\\renew"):
            macros[name] = (count, default, body)
        cuts.append((match.start(), end))
    # An environment defined in the body holds its table's opening rows, which
    # the audit reads where the environment is used, not where it is defined.
    for match in re.finditer(r"\\(?:new|renew)environment\*?\s*\{[^{}]*\}", text):
        cursor = match.end()
        try:
            for groups in range(2):
                cursor = skip_gap(text, cursor)
                while text[cursor : cursor + 1] == "[":
                    cursor = skip_gap(text, text.index("]", cursor) + 1)
                _, cursor = brace_group(text, cursor)
        except (ConversionError, ValueError):
            continue
        cuts.append((match.start(), cursor))
    out, index = [], 0
    for start, end in sorted(cuts):
        if start < index:
            continue
        out.append(text[index:start])
        index = end
    out.append(text[index:])
    return macros, "".join(out)


def macro_call(text: str, start: int, macro: Macro) -> tuple[str, int] | None:
    """Expand the call whose arguments begin at start: (expansion, end)."""
    count, default, replacement = macro
    cursor, arguments = start, []
    try:
        for position in range(count):
            gap = skip_gap(text, cursor)
            if position == 0 and default is not None:
                if text[gap : gap + 1] == "[":
                    close = text.index("]", gap)
                    arguments.append(text[gap + 1 : close])
                    cursor = close + 1
                else:
                    arguments.append(default)
                continue
            argument, cursor = brace_group(text, cursor)
            arguments.append(argument)
    except (ConversionError, ValueError):
        return None
    for number, argument in enumerate(arguments, start=1):
        replacement = replacement.replace(f"#{number}", argument)
    return replacement, cursor


def expand_macros(text: str, macros: dict[str, Macro]) -> str:
    for _ in range(3):
        before = text
        for name, macro in macros.items():
            out, index = [], 0
            for match in re.finditer(re.escape("\\" + name) + r"(?![A-Za-z@])", text):
                if match.start() < index:
                    continue
                call = macro_call(text, match.end(), macro)
                if call is None:
                    continue
                out.append(text[index : match.start()] + call[0])
                index = call[1]
            out.append(text[index:])
            text = "".join(out)
        if text == before:
            break
    return text


def split_top_level(text: str, separator: re.Pattern[str]) -> list[str]:
    """Split at separator matches that stand outside every brace group."""
    pieces, depth, start, index = [], 0, 0, 0
    while index < len(text):
        character = text[index]
        if character == "\\" and index + 1 < len(text):
            match = separator.match(text, index) if depth == 0 else None
            if match:
                pieces.append(text[start:index])
                start = index = match.end()
                continue
            index += 2
            continue
        if character == "{":
            depth += 1
        elif character == "}":
            depth = max(0, depth - 1)
        elif depth == 0 and (match := separator.match(text, index)):
            pieces.append(text[start:index])
            start = index = match.end()
            continue
        index += 1
    pieces.append(text[start:])
    return pieces


def cell_opening(cell: str, macros: dict[str, Macro] | None = None) -> tuple[str | None, bool, str]:
    """A source cell's opening, whether that is its whole text, and a skip reason."""
    macros = macros or {}
    text = cell
    for _ in range(64):
        text = text.lstrip()
        if not text:
            return None, False, "empty"
        if text[0] in "{}":
            text = text[1:]
            continue
        if text.startswith("\\multicolumn"):
            try:
                _, cursor = brace_group(text, len("\\multicolumn"))
                _, cursor = brace_group(text, cursor)
                content, cursor = brace_group(text, cursor)
            except ConversionError:
                return None, False, "unreadable span"
            text = content + text[cursor:]
            continue
        word = re.match(r"\\([A-Za-z@]+)\*?", text)
        if word:
            name, after = word.group(1), text[word.end():]
            if after.startswith("{}"):
                text = after[2:]
                continue
            if name in OPENING_TEXT_COMMANDS:
                cursor = skip_gap(text, word.end())
                if text[cursor : cursor + 1] == "[" and "]" in text[cursor:]:
                    cursor = text.index("]", cursor) + 1
                if text[cursor:].lstrip().startswith("{"):
                    content, cursor = brace_group(text, cursor)
                    text = content + text[cursor:]
                    continue
            if name in OPENING_SKIP_COMMANDS:
                cursor = word.end()
                try:
                    gap = skip_gap(text, cursor)
                    if text[gap : gap + 1] == "[":
                        cursor = text.index("]", gap) + 1
                    for _ in range(OPENING_SKIP_COMMANDS[name]):
                        _, cursor = brace_group(text, cursor)
                except (ConversionError, ValueError):
                    return None, False, "unreadable command"
                text = text[cursor:]
                continue
            if name in macros:
                call = macro_call(text, word.end(), macros[name])
                if call is None:
                    return None, False, "unreadable macro"
                text = call[0] + text[call[1]:]
                continue
            if name in OPENING_LETTER_COMMANDS:
                return None, False, "letter command"
            if name.startswith("if") or name in ("csname", "expandafter", "else", "fi"):
                return None, False, "computed or conditional text"
            if after.lstrip().startswith(("{", "[")):
                return None, False, "command with an argument"
            # A register assignment such as \\hyphenchar\\font=45 sets no text.
            text = re.sub(r"^\s*=\s*-?[0-9.]+(?:\s*(?:pt|em|ex|mm|cm|in|bp|sp)(?![A-Za-z]))?",
                          "", after)
            continue
        if text.startswith("\\"):
            if text[1:2] in OPENING_SPACE_SYMBOLS:
                text = text[2:]
                continue
            return None, False, "accent or symbol"
        break
    if text.startswith("$"):
        return None, False, "math or nested table"
    run, index, whole = [], 0, False
    while True:
        if index >= len(text):
            whole = True
            break
        character = text[index]
        if character == "\\":
            word = re.match(r"\\([A-Za-z@]+)\*?", text[index:])
            if word and word.group(1) in OPENING_TEXT_COMMANDS:
                after = index + word.end()
                if text[after:].lstrip().startswith("{"):
                    content, cursor = brace_group(text, after)
                    text = text[:index] + content + text[cursor:]
                    continue
            if text[index + 1 : index + 2] in OPENING_SPACE_SYMBOLS:
                index += 2
                continue
            break
        if character in "$&":
            break
        run.append(character)
        index += 1
    opening = "".join(ch for ch in "".join(run).casefold() if ch.isalnum())
    if not opening:
        return None, False, "no letters or digits"
    return opening[:OPENING_LENGTH], whole and len(opening) <= OPENING_LENGTH, ""


def table_source_openings(
    body: str, definitions: str, lifted_notes: bool = False
) -> tuple[Counter[tuple[str, bool]], Counter[str], Counter[str]]:
    """Cell openings, lifted-note openings, and skipped cells by reason."""
    cells: Counter[tuple[str, bool]] = Counter()
    paragraphs: Counter[str] = Counter()
    skipped: Counter[str] = Counter()
    defined, _ = command_definitions(strip_tex_comments(definitions))
    macros, text = command_definitions(strip_tex_comments(body), defined)
    environments = table_environments(strip_tex_comments(definitions) + "\n" + strip_tex_comments(body))
    names = "|".join(re.escape(name) for name in environments)
    begin_re = re.compile(r"\\begin\s*\{(" + names + r")\}")
    builders = {name: macro for name, macro in macros.items() if begin_re.search(macro[2])}
    rows_macros = {name: macro for name, macro in macros.items()
                   if "&" in macro[2] or "\\\\" in macro[2]}
    text = expand_macros(text, builders)
    for match in begin_re.finditer(text):
        name, cursor = match.group(1), match.end()
        try:
            gap = skip_gap(text, cursor)
            if text[gap : gap + 1] == "[":
                cursor = text.index("]", gap) + 1
            for _ in range(environments[name]):
                _, cursor = brace_group(text, cursor)
        except (ConversionError, ValueError):
            skipped["unreadable table"] += 1
            continue
        region = text[cursor : table_rows_extent(text, cursor, name)]
        # A nested table is read as its own table; its enclosing cell is not.
        nested = []
        for inner in begin_re.finditer(region):
            if nested and inner.start() < nested[-1][1]:
                continue
            closing = "\\end{" + inner.group(1) + "}"
            finish = region.find(closing, inner.end())
            nested.append((inner.start(), len(region) if finish < 0 else finish + len(closing)))
        for start, finish in reversed(nested):
            region = region[:start] + "$" + region[finish:]
        if lifted_notes and name == "dossiertable":
            for note in LIFTED_NOTES:
                def lift(arguments: list[str]) -> str:
                    opening, _, reason = cell_opening(arguments[0], macros)
                    if opening:
                        paragraphs[opening] += 1
                    else:
                        skipped[reason] += 1
                    return ""
                region = replace_grouped_macro(region, note, 1, lift)
        region = expand_macros(region, rows_macros)
        if name == "longtable":
            found = continuation_head(region)
            if found is not None:
                region = region[: found[0]] + region[found[1] :]
        for row in split_top_level(region, ROW_END_RE):
            for cell in split_top_level(row, re.compile(r"&")):
                opening, whole, reason = cell_opening(CELL_LAYOUT_RE.sub(" ", cell), macros)
                if opening:
                    cells[(opening, whole)] += 1
                elif reason != "empty":
                    skipped[reason] += 1
    return cells, paragraphs, skipped


FOOTNOTE_REFERENCE_RE = re.compile(
    r"\[\^[^\]]*\]|<a\b[^>]*\bfootnote-ref\b[^>]*>.*?</a>", re.DOTALL
)


def reduced(text: str) -> str:
    text = FOOTNOTE_REFERENCE_RE.sub("", text)
    text = MARKDOWN_TAG_RE.sub("", MARKDOWN_TARGET_RE.sub("]", text))
    return "".join(ch for ch in text.casefold() if ch.isalnum())


def output_cell_openings(markdown: str) -> list[str]:
    cells = []
    for line in markdown.splitlines():
        line = re.sub(r"^(?:[ \t]*>[ \t]?)+", "", line)
        if line.startswith("|") and not OUTPUT_TABLE_RE.match(line):
            cells.extend(re.split(r"(?<!\\)\|", line.strip())[1:-1])
    cells.extend(re.findall(r"<t[dh]\b[^>]*>(.*?)</t[dh]>", markdown, re.DOTALL))
    return [reduced(cell) for cell in cells]


def output_paragraph_openings(markdown: str) -> list[str]:
    blocks = BLOCK_SPLIT_RE.split(re.sub(r"<table\b.*?</table>", "", markdown, flags=re.DOTALL))
    return [reduced(block) for block in blocks
            if block.strip() and not block.lstrip().startswith(("|", "#"))]


def match_openings(wanted: Counter[tuple[str, bool]], unused: list[str | None]) -> list[str]:
    lost = []
    order = sorted(wanted, key=lambda key: (not key[1], -len(key[0]), key[0]))
    for opening, whole in order:
        found = 0
        for index, cell in enumerate(unused):
            if found == wanted[(opening, whole)]:
                break
            if cell is not None and (cell == opening if whole else cell.startswith(opening)):
                unused[index] = None
                found += 1
        if found < wanted[(opening, whole)]:
            lost.append(f"{opening!r} (expected {wanted[(opening, whole)]}, found {found})")
    return lost


def lost_cell_openings(
    body: str, markdown: str, definitions: str, lifted_notes: bool = False
) -> list[str]:
    """Source openings no output cell (or, for a lifted note, paragraph) holds."""
    cells, paragraphs, _ = table_source_openings(body, definitions, lifted_notes)
    lost = match_openings(cells, list(output_cell_openings(markdown)))
    lost += match_openings(
        Counter({(opening, False): count for opening, count in paragraphs.items()}),
        list(output_paragraph_openings(markdown)),
    )
    return sorted(lost)


def repeated_headers(markdown: str) -> int:
    """Tables whose first body row repeats their header row exactly."""
    lines = [re.sub(r"^(?:[ \t]*>[ \t]?)+", "", line) for line in markdown.splitlines()]
    def cells(line: str) -> list[str]:
        return [cell.strip() for cell in re.split(r"(?<!\\)\|", line.strip())[1:-1]]
    count = 0
    for index, line in enumerate(lines[1:-1], start=1):
        if OUTPUT_TABLE_RE.match(line) and lines[index + 1].startswith("|"):
            header, first = cells(lines[index - 1]), cells(lines[index + 1])
            if any(header) and header == first:
                count += 1
    for table in re.findall(r"<table\b.*?</table>", markdown, re.DOTALL):
        head = re.search(r"<thead>\s*(<tr>.*?</tr>)", table, re.DOTALL)
        body_row = re.search(r"<tbody>\s*(<tr>.*?</tr>)", table, re.DOTALL)
        if head and body_row:
            strip = lambda row: re.sub(r"<t[hd]\b", "<td", re.sub(r"</t[hd]>", "</td>", row))
            text = MARKDOWN_TAG_RE.sub("", head.group(1)).strip()
            if text and strip(head.group(1)) == strip(body_row.group(1)):
                count += 1
    return count


def audit_output(
    body: str,
    markdown: str,
    tables: int = 0,
    chronology_annotations: list[str] | None = None,
    sources: str = "",
    rendered_anchors: list[str] | None = None,
    required_anchors: set[str] | None = None,
    bracketed: dict[str, BracketedCommand] | None = None,
    definitions: str = "",
    source_body: str | None = None,
    lifted_notes: bool = False,
) -> list[str]:
    """Compare critical macro payloads in the LaTeX body against the Markdown.

    The row-opening audit reads `source_body`, the body before the converter's
    own rewriting, where one is given.
    """
    failures = bracketed_shortfalls(body, markdown, bracketed or {})
    failures.extend(title_shortfalls(body, markdown))
    # A table pandoc could not write as a pipe table becomes an HTML table; a
    # table it dropped becomes neither.  A repeated-header longtable may split
    # into several tables, so only a shortfall is a loss.
    written = len(OUTPUT_TABLE_RE.findall(markdown)) + markdown.count("<table")
    if written < tables:
        failures.append(f"{tables} table environments became {written} tables")
    # A headerless source table legitimately writes an empty header row, which
    # is the one immediately above the delimiter; any other is a dropped row.
    lines = markdown.splitlines()
    blank = sum(
        1
        for index, line in enumerate(lines)
        if EMPTY_ROW_RE.match(line)
        and not OUTPUT_TABLE_RE.match(lines[index + 1] if index + 1 < len(lines) else "")
    )
    if blank:
        failures.append(f"{blank} table row(s) written with every cell empty")
    # A delimiter row that no body row follows closes a table over nothing.
    unquoted = [re.sub(r"^(?:[ \t]*>[ \t]?)+", "", line) for line in lines]
    bare = sum(
        1
        for index, line in enumerate(unquoted)
        if OUTPUT_TABLE_RE.match(line)
        and not (unquoted[index + 1] if index + 1 < len(unquoted) else "").startswith("|")
    )
    if bare:
        failures.append(f"{bare} table(s) written with a header row and no body row")
    repeated = repeated_headers(markdown)
    if repeated:
        failures.append(f"{repeated} table(s) repeat their header row as their first body row")
    lost = lost_cell_openings(
        body if source_body is None else source_body, markdown, definitions, lifted_notes
    )
    if lost:
        failures.append("table cell opening(s) lost in conversion: " + "; ".join(lost))
    divs = FENCED_DIV_RE.findall(markdown)
    if divs:
        failures.append(f"{len(divs)} unconverted fenced-div delimiter(s) left in output")
    severed = severed_runs(sources, markdown)
    if severed:
        failures.append(
            f"{len(severed)} paragraph break(s) fell inside a run of words the "
            "leaf's sources keep unbroken: " + "; ".join(severed)
        )
    reflowed = reflowed_sentences(sources, markdown)
    if reflowed:
        failures.append(
            f"{len(reflowed)} paragraph(s) opened on a lowercase word the leaf's "
            "sources open none with, after a block that closed no sentence: "
            + "; ".join(reflowed)
        )
    source_headings = {
        level: len(
            re.findall(
                rf"\\{name}\*?\s*\{{",
                body,
            )
        )
        for level, name in (
            (2, "section"),
            (3, "subsection"),
            (4, "subsubsection"),
            (5, "paragraph"),
            (6, "subparagraph"),
        )
    }
    output_headings = {
        level: len(re.findall(rf"^{'#' * level}\s+", markdown, re.MULTILINE))
        for level in source_headings
    }
    for level, expected in source_headings.items():
        if output_headings[level] < expected:
            failures.append(
                f"{expected} level-{level} source heading(s) became "
                f"{output_headings[level]} heading(s)"
            )
    anchors = ANCHOR_DEFINITION_RE.findall(markdown) if rendered_anchors is None else rendered_anchors
    if required_anchors is not None:
        failures.extend(proper_anchor_failures(anchors, required_anchors, "rendered"))
    duplicate_anchors = sorted(
        anchor for anchor in set(anchors) if anchors.count(anchor) > 1
    )
    if duplicate_anchors:
        failures.append("duplicate heading anchor(s): " + " ".join(duplicate_anchors))
    linked_targets = {target for _, target in ANCHOR_LINK_RE.findall(markdown)}
    missing_targets = sorted(linked_targets - set(anchors))
    if missing_targets:
        failures.append("missing internal anchor target(s): " + " ".join(missing_targets))
    # Table cells and escapes reflow the text; flattening lets a payload be
    # searched for as the continuous run of words it is.
    flat = flatten(markdown.replace("|", " "))
    notes, kept = len(NOTE_MACRO_RE.findall(body)), len(FOOTNOTE_DEF_RE.findall(markdown))
    if kept < notes:
        failures.append(f"{notes} endnote/footnote calls became {kept} footnotes")
    # URLs and file locators must survive verbatim; prose payloads are only
    # checked where LaTeX and Markdown spell them identically.
    for macro in (r"\sourceurl", r"\href", r"\path", r"\work", r"\latin", r"\Latin", r"\CanonLatin"):
        verbatim = macro in (r"\sourceurl", r"\href", r"\path")
        for match in re.finditer(re.escape(macro) + r"\s*\{", body):
            payload = brace_group(body, match.end() - 1)[0].strip()
            if not (verbatim or SAFE_PAYLOAD_RE.match(payload)):
                continue
            if payload and flatten(payload) not in flat:
                failures.append(f"{macro} payload dropped: {payload}")
    # Math is passed through as math and is not a dropped macro.
    residual = sorted(set(re.findall(r"\\[A-Za-z@]{2,}", MATH_RE.sub(" ", markdown))))
    if residual:
        failures.append("raw LaTeX left in output: " + " ".join(residual))
    # A span with no attribute is a LaTeX argument pandoc kept but could not
    # place, such as a partial rule's column range; the reader sees it as text.
    if SPAN_CELL_MARK in markdown:
        failures.append("collapsed-span mark left in output")
    # An emphasis around nothing, or bold written inside bold, is what a column
    # prefix broken by a paragraph break leaves behind.
    empty = len(re.findall(r"<(strong|em)>\s*</\1>", markdown))
    if empty:
        failures.append(f"{empty} empty emphasis element(s) left in output")
    nested = len(re.findall(r"\*\*\*\*(?=[^\s*|])|<strong><strong>", markdown))
    if nested:
        failures.append(f"{nested} bold-inside-bold run(s) left in output")
    stray = re.findall(r"<span>([^<]*)</span>", markdown)
    if stray:
        failures.append("unattributed span(s) left in output: " + "; ".join(sorted(set(stray))))
    raw_chronology = sorted(set(RAW_CHRONOLOGY_TOKEN_RE.findall(markdown)))
    if raw_chronology:
        failures.append(
            "raw generated chronology annotation token(s) left in output: "
            + " ".join(raw_chronology)
        )
    normalized_markdown = normalize_audit_text(markdown)
    for payload, expected_count in Counter(
        normalize_audit_text(annotation) for annotation in chronology_annotations or []
    ).items():
        actual_count = normalized_markdown.count(payload)
        if actual_count < expected_count:
            failures.append(
                "generated chronology annotation payload shortfall: "
                f"expected {expected_count}, found {actual_count}: {payload}"
            )
    if "Reuse and rights." not in markdown:
        failures.append("rights colophon missing from output")
    if "Last revised (UTC):" not in markdown:
        failures.append("revision timestamp missing from output")
    if re.search(r"\bModel\s*:", markdown, re.IGNORECASE):
        failures.append("reader-visible model metadata remains in output")
    if re.search(r"\beffort\s*=", markdown, re.IGNORECASE):
        failures.append("reader-visible model effort remains in output")
    return failures


def convert(provider: str, leaf: str, out: Path = OUT) -> Path:
    main = SRC / provider / leaf / "main.tex"
    if not main.is_file():
        raise ConversionError(f"no such document: {main}")
    source = main.read_text(encoding="utf-8")
    proper = (main.parent / "proper-components.toml").is_file()
    components = None
    semantic_graph = None
    if proper:
        components = tomllib.loads((main.parent / "proper-components.toml").read_text())
        if components.get("schema") == 2 and components.get("format_contract") == "propers-format-v1":
            from _proper_components import include_graph
            try:
                semantic_graph = include_graph(main, main.parent, SRC / provider)
            except ValueError as exc:
                raise ConversionError(f"schema-2 semantic source graph rejected: {exc}") from exc
    source = select_web_branches(source, proper=proper)
    head, tail = split_document(source)
    # Preamble includes supply definitions but never content, so they are not
    # scanned; only what reaches the body can lose scholarship.
    preamble_sources: dict[Path, str] = {}
    preamble = assemble(head, provider, preamble_sources, proper=proper)
    sources: dict[Path, str] = {main: tail}
    body = assemble(tail, provider, sources, proper=proper)
    # The row-opening audit reads the body as assembled, before any rewriting.
    assembled_body = body
    if semantic_graph is not None:
        assembled_graph = {main.resolve(), *preamble_sources, *sources}
        if assembled_graph != semantic_graph:
            missing = sorted(path.as_posix() for path in semantic_graph - assembled_graph)
            extra = sorted(path.as_posix() for path in assembled_graph - semantic_graph)
            details = []
            if missing:
                details.append("not assembled: " + ", ".join(missing))
            if extra:
                details.append("not accepted: " + ", ".join(extra))
            raise ConversionError("schema-2 web graph disagrees with the semantic source graph ("
                                  + "; ".join(details) + ")")
    required_anchors = None
    if proper:
        if components.get("schema") == 2:
            from _proper_components import KEY, strings
            try:
                keys = strings(components.get("element_keys"), "element_keys")
                if any(not KEY.fullmatch(key) for key in keys):
                    raise ValueError("element_keys must use stable lowercase kebab-case")
            except ValueError as exc:
                raise ConversionError(str(exc)) from exc
            required_anchors = {f"proper-{key}" for key in keys}
        else:
            body = anchor_appointed_elements(body, set(components.get("element_keys", [])))
    body = set_text_dashes(PERIOD_CENTERED_RE.sub("\N{MIDDLE DOT}", body))
    body = PRE_CONVERSION_BREAKS_RE.sub("", body)
    body, chronology_annotations = expand_chronology_annotations(body, preamble)
    title, subtitle = pdf_metadata(preamble)
    body = TITLEPAGE_RE.sub("", body)
    toc_count = body.count(r"\tableofcontents")
    if required_anchors is not None:
        # Keep the Contents at the author's chosen location.  A plain sentinel
        # survives pandoc's LaTeX reader; after conversion it becomes the
        # Python-Markdown toc extension's marker and therefore links the
        # reflowed page rather than retaining meaningless print page numbers.
        body = body.replace(
            r"\tableofcontents", rf"\par {WEB_TOC_SENTINEL}\par"
        )
    else:
        body = body.replace(r"\tableofcontents", "")
    body = REGISTER_ASSIGNMENT_RE.sub("", body)
    body = PARTIAL_RULE_RE.sub("", body)
    body = drop_continuation_heads(terminate_swallowers(
        STARRED_ROW_END_RE.sub(r"\\\\", fix_column_specs(body))
    ))
    body = strip_layout_macros(body)
    body = LIST_OPTION_RE.sub(r"\1", body)
    # The dossier names are the shared format's; a leaf's own dossier is not lifted.
    if semantic_graph is not None:
        body = lift_dossier_notes(body)
    body = deduplicate_contributions(body)
    if r"\TriptychRightsNotice" not in body:
        body += "\n\\TriptychRightsNotice\n"
    if required_anchors is not None:
        failures = proper_anchor_failures(LABEL_RE.findall(strip_for_scan(body)), required_anchors, "source")
        if failures:
            raise ConversionError("\n".join(failures))
    shim_text, shim_bracketed = guard_opening_brackets(
        terminate_swallowers(fix_column_specs(set_text_dashes(SHIM.read_text(encoding="utf-8"))))
    )
    locals_text, locals_bracketed = guard_opening_brackets(drop_continuation_heads(
        terminate_swallowers(fix_column_specs(
            STARRED_ROW_END_RE.sub(r"\\\\", PARTIAL_RULE_RE.sub(
                "", LIST_OPTION_RE.sub(r"\1", set_text_dashes(local_definitions(preamble)))
            ))
        ))
    ))
    body, bracketed = guard_opening_brackets(body)
    # The shim wins conflicts, so its replacement text is the one to expect.
    bracketed.update(locals_bracketed)
    bracketed.update(shim_bracketed)
    failures = undefined_uses(sources, defined_names(shim_text + locals_text))
    if failures:
        raise ConversionError("\n".join(failures))
    with tempfile.NamedTemporaryFile(
        "w", suffix=".lua", encoding="utf-8"
    ) as table_filter, tempfile.NamedTemporaryFile("w", suffix=".tex", encoding="utf-8") as handle:
        table_filter.write(TABLE_FILTER)
        table_filter.flush()
        handle.write(
            f"{shim_text}\n{locals_text}\n"
            f"\\begin{{document}}\n{body}\n\\end{{document}}\n"
        )
        handle.flush()
        # Source \section becomes H2 so the document title alone holds H1. The
        # output dialect is narrowed to what the site's Markdown renderer reads:
        # pipe tables only, no header attributes, and literal typography rather
        # than ASCII stand-ins no downstream renderer would resolve.
        dialect = (
            PROPER_STUDY_MARKDOWN_DIALECT
            if required_anchors is not None
            else MARKDOWN_DIALECT
        )
        command = ["pandoc", "-f", "latex", "-t", dialect, "--wrap=none",
                   "--shift-heading-level-by=1", f"--lua-filter={table_filter.name}",
                   handle.name]
        result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0:
        raise ConversionError(f"pandoc failed:\n{result.stderr.strip()}")
    if MATH_WARNING_RE.search(result.stderr):
        raise ConversionError(f"math left as raw TeX:\n{result.stderr.strip()}")
    converted = clean_markdown_line_endings(result.stdout)
    if required_anchors is not None and toc_count:
        converted_toc_count = converted.count(WEB_TOC_SENTINEL)
        if converted_toc_count != toc_count:
            raise ConversionError(
                "table of contents marker shortfall: "
                f"expected {toc_count}, found {converted_toc_count}"
            )
        converted = converted.replace(WEB_TOC_SENTINEL, "[TOC]")
    heading = f"# {title}\n"
    if subtitle:
        heading += f"\n*{subtitle}*\n"
    rendered_anchors = None
    if required_anchors is None:
        markdown = strip_contentless_breaks(
            normalize_unnumbered_headings(
                resolve_anchors(converted), set(LABEL_RE.findall(body))
            )
        )
    else:
        markdown = strip_contentless_breaks(normalize_unnumbered_headings(
            LINK_ATTRIBUTE_RE.sub(r"\1", converted), set(LABEL_RE.findall(body))
        ))
        # Validate before legacy unlinking can erase a broken proper reference,
        # and again on the exact final publication, title and subtitle included.
        rendered_anchors = audit_schema_two_targets(
            f"{heading}\n{markdown}", required_anchors,
        )
        markdown = resolve_anchors(markdown, rendered_anchors)
        rendered_anchors = audit_schema_two_targets(
            f"{heading}\n{markdown}", required_anchors,
        )
    # The paragraph audit is judged against the leaf's files as they stand on
    # disk, before any branch was selected or any macro resolved, so a rewriting
    # that introduced a break cannot supply the reference that excuses it.
    raw_sources = "\n\n".join(
        path.read_text(encoding="utf-8") for path in sorted(sources)
    )
    failures = audit_output(
        body,
        markdown,
        table_count(body, shim_text + locals_text),
        chronology_annotations,
        shim_text + "\n\n" + raw_sources,
        rendered_anchors,
        required_anchors,
        bracketed,
        SHIM.read_text(encoding="utf-8") + "\n" + local_definitions(preamble),
        assembled_body,
        semantic_graph is not None,
    )
    if failures:
        raise ConversionError("\n".join(failures))
    destination = out / provider / f"{leaf}.md"
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(clean_markdown_line_endings(f"{heading}\n{markdown}"), encoding="utf-8")
    return destination


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--provider", required=True)
    parser.add_argument("documents", nargs="*")
    parser.add_argument("--all", action="store_true")
    parser.add_argument(
        "--output",
        type=Path,
        default=OUT,
        help="write below this directory instead of build/web/",
    )
    with_examples(parser, EXAMPLES[""])
    arguments = parser.parse_args()
    root = SRC / arguments.provider
    if arguments.all:
        leaves = sorted(str(p.parent.relative_to(root)) for p in root.rglob("main.tex"))
    elif arguments.documents:
        leaves = [document.strip("/") for document in arguments.documents]
    else:
        parser.error("give one or more document ids or --all")
    status = 0
    for leaf in leaves:
        try:
            print(convert(arguments.provider, leaf, arguments.output))
        except ConversionError as error:
            print(f"web-edition: {arguments.provider}/{leaf}\n{error}", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main())
