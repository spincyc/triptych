# Pandoc sizes each delimiter cell to its column's widest content, so a column
# whose every cell is one character wide is written "-:" or ":-". Requiring two
# dashes therefore missed whole tables that were present, and reported them as
# dropped. A dropped table emits no delimiter row at all, so accepting a single
# dash removes the false positive without weakening the shortfall check.
OUTPUT_TABLE_RE = re.compile(r"^\|(?:[ :]*-+[ :]*\|)+\s*$", re.MULTILINE)
# A row of nothing but cell separators is a row whose text the reader dropped.
EMPTY_ROW_RE = re.compile(r"^\|(?:\s*\|)+[ \t]*$", re.MULTILINE)
# A construct pandoc could not carry inline becomes a block boundary, and the
# tail of the sentence it stood in is then set as a paragraph of its own. The
