# once.
TABLE_FILTER = """
local MARK = "@MARK@"
local FORMATS = {Strong = true, Emph = true, SmallCaps = true, Underline = true}

local function empty_chain(block)
  if (block.t ~= "Para" and block.t ~= "Plain") or #block.content ~= 1 then return nil end
  local chain, inline = {}, block.content[1]
  while FORMATS[inline.t] do
    table.insert(chain, inline.t)
    if #inline.content == 0 then return chain end
    if #inline.content ~= 1 then return nil end
    inline = inline.content[1]
  end
  return nil
end

-- Delete the span mark opening a block and unwrap the formatting around it.
local function unmark(block)
  if block.t ~= "Para" and block.t ~= "Plain" then return false end
  local chain, list = {}, block.content
  while #list > 0 and FORMATS[list[1].t] do
    table.insert(chain, list[1])
    list = list[1].content
  end
  local first = list[1]
  if first == nil or first.t ~= "Str" or first.text:sub(1, #MARK) ~= MARK then return false end
  first.text = first.text:sub(#MARK + 1)
  if first.text == "" then
    list:remove(1)
    if list[1] and (list[1].t == "Space" or list[1].t == "SoftBreak") then list:remove(1) end
  end
  for index = #chain, 1, -1 do
    local parent = index == 1 and block.content or chain[index - 1].content
    local merged = pandoc.Inlines{}
    merged:extend(chain[index].content)
    for position = 2, #parent do merged:insert(parent[position]) end
    if index == 1 then block.content = merged else chain[index - 1].content = merged end
  end
  return true
end

local function flatten(element)
  local out = pandoc.Inlines{}
  for _, inline in ipairs(element.content) do
    if inline.t == "Strong" then out:extend(inline.content) else out:insert(inline) end
  end
  element.content = out
  return element
end

local function repair(cell)
  local blocks, changed, span = cell.contents, false, false
  for _, block in ipairs(blocks) do
    if unmark(block) then
      span = true
      break
    end
  end
  if span then
    local kept = pandoc.Blocks{}
    for _, block in ipairs(blocks) do
      local text = block.t ~= "Para" and block.t ~= "Plain"
        or (#block.content > 0 and empty_chain(block) == nil)
      if text then kept:insert(block) end
    end
    blocks, changed = kept, true
  else
    local chain = #blocks > 1 and empty_chain(blocks[1]) or nil
    local rest = chain and pandoc.Blocks{} or nil
    for index = 2, (rest and #blocks or 0) do
      if blocks[index].t ~= "Para" and blocks[index].t ~= "Plain" then rest = nil break end
      rest:insert(blocks[index])
    end
    if rest then
      for _, block in ipairs(rest) do
        local content = block.content
        for index = #chain, 1, -1 do content = pandoc.Inlines{pandoc[chain[index]](content)} end
        block.content = content
      end
      blocks, changed = rest, true
    end
  end
  if changed and #blocks == 1 and blocks[1].t == "Para" then
    blocks[1] = pandoc.Plain(blocks[1].content)
  end
  cell.contents = blocks:walk({Strong = flatten})
end

local function rows(list)
  for _, row in ipairs(list) do
    for _, cell in ipairs(row.cells) do repair(cell) end
  end
end

return {
  {
    Table = function(tbl)
      rows(tbl.head.rows)
      for _, body in ipairs(tbl.bodies) do
        rows(body.head)
        rows(body.body)
      end
      rows(tbl.foot.rows)
      return tbl
    end,
  },
}
""".replace("@MARK@", SPAN_CELL_MARK)

