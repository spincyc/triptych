class InputRefused(ValueError):
    """An argument the reader cannot act on."""


def _size(value: str) -> tuple[int, int]:
    match = re.fullmatch(r"(\d+)x(\d+)", value)
    if not match:
        raise argparse.ArgumentTypeError("size is WIDTHxHEIGHT, e.g. 120x40")
    width, height = int(match.group(1)), int(match.group(2))
    if width < 60 or height < 16:
        raise argparse.ArgumentTypeError("the reader needs at least 60x16")
    return width, height


def _date(value: str) -> str:
    try:
        return dt.date.fromisoformat(value).isoformat()
    except ValueError as error:
        raise argparse.ArgumentTypeError(f"not a date: {value!r} ({error})") from error


def _common(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--surface", choices=tuple(module for _, _, module in SURFACES), default="day",
                        help="the surface to open on (default: day)")
    parser.add_argument("--date", type=_date, help="the civil date for the day surface (default: today)")
    parser.add_argument("--calendar", help="the calendar to show first, e.g. roman-1962")
    parser.add_argument("--mass", help="a Mass key for the propers surface")
    parser.add_argument("--ref", help="a book and chapter for catena or scripture, e.g. 'Gen 1'")
    parser.add_argument("--leaf", help="a work's path for the texts surface, e.g. biographies/origen")
    parser.add_argument("--provider", choices=("claude", "gpt"), help="with --leaf: one treatment of the work")
    parser.add_argument("--passage", help="a passage id for the sources surface, as Catena Omnia cites it")
    parser.add_argument("--edition", help="an edition id for the sources surface")
    parser.add_argument("--canon", help="a citation for the law surface, e.g. '1983 c. 1008'")
    parser.add_argument("--view", choices=("timeline", "map", "catalogue"), help="the history view to open")
    parser.add_argument("--tradition", help="a tradition id for the history timeline")
    parser.add_argument("--theme", choices=THEMES, default="triptych", help="palette (default: triptych)")


def _intent(arguments: argparse.Namespace) -> dict[str, str]:
    found = {}
    for name in ("date", "calendar", "mass", "ref", "leaf", "provider", "passage", "edition",
                 "canon", "view", "tradition"):
        value = getattr(arguments, name, None)
        if value:
            found[name] = value
    return found


def open_reader(arguments: argparse.Namespace) -> int:
    if not sys.stdout.isatty():
        raise InputRefused("open needs a terminal; use `lectern snapshot` to render without one")
    from lectern.app import TriptychApp

    # A drawn reader cannot be ASCII; asked for plain, it takes the monochrome
    # palette, which keeps only the hues that mark a warning or a season.
    style = getattr(arguments, "style_resolved", None)
    theme = "triptych-compline" if style and style.plain else arguments.theme
    TriptychApp(start=arguments.surface, intent=_intent(arguments), theme=theme).run()
    return 0


def snapshot(arguments: argparse.Namespace) -> str:
    from lectern.snapshot import render

    keys = [key for key in (arguments.keys or "").split(",") if key]
    style = getattr(arguments, "style_resolved", None)
    plain = bool(style and style.plain)
    if plain and arguments.format == "svg":
        raise InputRefused("an SVG drawing is not plain text; drop --plain or ask for --format text")
    return render(
        surface=arguments.surface,
        intent=_intent(arguments),
        size=arguments.size,
        keys=keys,
        form=arguments.format,
        theme="triptych-compline" if plain else arguments.theme,
        plain=plain,
    )


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="lectern",
        description="Read the published missal, catena and corpus in a terminal.",
    )
    verbs = parser.add_subparsers(dest="command")
    opened = with_examples(
        verbs.add_parser("open", help="the interactive reader (the default)"),
        EXAMPLES["open"],
    )
    _common(opened)
    shot = with_examples(
        verbs.add_parser("snapshot", help="render the reader headlessly and print the screen"),
        EXAMPLES["snapshot"],
    )
    _common(shot)
    shot.add_argument("--size", type=_size, default=(120, 40), help="WIDTHxHEIGHT (default: 120x40)")
    shot.add_argument("--keys", help="comma-separated keys to press once loaded, e.g. 'right,e'")
    shot.add_argument("--format", choices=("text", "ansi", "svg"), default="text",
                      help="plain text, text with ANSI colour, or SVG (default: text)")
    # A bare `lectern` opens the reader, so the verb's defaults must hold
    # without its subparser having run.
    parser.set_defaults(surface="day", date=None, calendar=None, mass=None, ref=None, leaf=None,
                        provider=None, passage=None, edition=None, canon=None, view=None,
                        tradition=None, theme="triptych")
    examples_live_on_the_verbs(parser, "lectern")

    def render(payload: object, arguments: argparse.Namespace) -> int:
        if isinstance(payload, int):
            return payload
        sys.stdout.write(str(payload))
        return 0

    return run_verb_cli(
        parser=parser,
        handlers={"open": open_reader, "snapshot": snapshot},
        renderer=render,
        prefix="lectern",
        argv=argv,
        default_verb="open",
        dependency_message=DEPENDENCY,
        mapped_errors={InputRefused: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
