#!/usr/bin/env python3
"""Validate tracked revision timestamps and AI provenance in source and PDFs."""

from __future__ import annotations

import argparse
import datetime as dt
import os
import re
import subprocess
import sys
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[1]
REVISION_RE = re.compile(
    r"^\\AIDocumentRevisionTimestamp\{([^{}]+)\}\s*$", re.MULTILINE
)
CONTRIBUTION_RE = re.compile(
    r"^\\AIModelContribution\{([^{}]+)\}\{([^{}]+)\}\{([^{}]+)\}\s*$",
    re.MULTILINE,
)
INHERITANCE_RE = re.compile(
    r"^\\AIInheritedGenerationMetadata\{([^{}]+)\}\s*$", re.MULTILINE
)
LEGACY_LABEL_RE = re.compile(
    r"\\textbf\{(?:Generated|Last revised(?: \(UTC\))?|Model|Agent/runtime):\}",
    re.IGNORECASE,
)
RENDERED_LEDGER_LABEL_RE = re.compile(
    r"\b(?:Agent/runtime|Client/runtime|Agent instance|Contribution count|"
    r"Process (?:history|ledger))\s*:",
    re.IGNORECASE,
)
GENERATION_METADATA_HEADING_RE = re.compile(
    r"(?:"
    r"\\(?:part|chapter|section|subsection|subsubsection)\*?\s*\{"
    r"|\\addcontentsline[^\n]{0,160}"
    r"|(?:\\bfseries|\\textbf\s*\{)[^\n]{0,80}"
    r")"
    r"(?:AI\s+)?Generation Metadata",
    re.IGNORECASE,
)
GENERIC_MODEL_RE = re.compile(
    r"(?:based runtime|model family|unexposed|unknown|unavailable)"
    r"|^gpt[- ]?5$"
    r"|^claude$"
    r"|^claude[- ]?[0-9]+(?:\.[0-9]+)?$"
    r"|^claude[- ](?:opus|sonnet|haiku|fable|mythos)$",
    re.IGNORECASE,
)
QUALIFIER_RE = re.compile(r"^[A-Za-z][A-Za-z0-9_-]*=[^;\s]+$")
REQUIRED_MODEL_QUALIFIERS = {
    "gpt-5.6-sol": {"effort"},
    # The Claude Code runtime exposes no numeric qualifiers; the empty set
    # records that decision explicitly and behaves identically to omission.
    "claude-fable-5": set(),
    "claude-opus-5[1m]": set(),
}
REQUIRED_RUNTIME_PATTERNS = {
    "gpt-5.6-sol": (
        re.compile(r"\bOpenAI Codex\b"),
        re.compile(r"\bCodex CLI [0-9]+\.[0-9]+\.[0-9]+\b"),
        re.compile(r"\bAPI workspace\b"),
        re.compile(r"\bunexposed: server revision\b"),
    ),
    "claude-fable-5": (
        re.compile(r"\bAnthropic Claude Code\b"),
        re.compile(r"\bClaude Code CLI [0-9]+\.[0-9]+\.[0-9]+\b"),
        re.compile(r"\bunexposed: server revision\b"),
    ),
    "claude-opus-5[1m]": (
        re.compile(r"\bAnthropic Claude Code\b"),
        re.compile(r"\bClaude Code CLI [0-9]+\.[0-9]+\.[0-9]+\b"),
        re.compile(r"\bunexposed: server revision\b"),
    ),
}


@dataclass(frozen=True)
class Contribution:
    model: str
    qualifiers: str
    runtime: str


@dataclass(frozen=True)
class Record:
    revision_timestamp: str
    contributions: tuple[Contribution, ...]
    inheritance: str | None


def active_tex(text: str) -> str:
    """Remove TeX comments so commented declarations cannot satisfy the gate."""
    return "\n".join(re.sub(r"(?<!\\)%.*$", "", line) for line in text.splitlines())


def parse_record(path: Path) -> Record:
    text = active_tex(path.read_text(encoding="utf-8"))
    revisions = REVISION_RE.findall(text)
    contributions = tuple(Contribution(*parts) for parts in CONTRIBUTION_RE.findall(text))
    inheritances = INHERITANCE_RE.findall(text)
    residue = REVISION_RE.sub("", text)
    residue = CONTRIBUTION_RE.sub("", residue)
    residue = INHERITANCE_RE.sub("", residue)

    if len(revisions) != 1:
        raise ValueError("requires exactly one document revision timestamp")
    first_declaration = text.lstrip()
    if REVISION_RE.match(first_declaration) is None:
        raise ValueError("document revision timestamp must be the first declaration")
    if len(inheritances) > 1:
        raise ValueError("contains more than one inheritance declaration")
    if inheritances and contributions:
        raise ValueError("mixes inherited and local generation provenance")
    if not inheritances and not contributions:
        raise ValueError("requires at least one model contribution")
    if len(set(contributions)) != len(contributions):
        raise ValueError("contains an exact duplicate model contribution")
    seen_identities: set[tuple[str, str]] = set()
    previous_identity: tuple[str, str] | None = None
    for contribution in contributions:
        identity = (contribution.model, contribution.qualifiers)
        if identity != previous_identity and identity in seen_identities:
            raise ValueError("repeats a noncontiguous model and qualifier group")
        seen_identities.add(identity)
        previous_identity = identity
    if residue.strip():
        raise ValueError("contains text outside the structured provenance commands")

    return Record(
        revision_timestamp=revisions[0],
        contributions=contributions,
        inheritance=inheritances[0] if inheritances else None,
    )


def validate_revision_timestamp(value: str) -> dt.datetime:
    if not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z", value):
        raise ValueError(
            f"document revision timestamp must use UTC whole-second form "
            f"YYYY-MM-DDTHH:MM:SSZ: {value!r}"
        )
    try:
        parsed = dt.datetime.strptime(value, "%Y-%m-%dT%H:%M:%SZ").replace(
            tzinfo=dt.timezone.utc
        )
    except ValueError as exc:
        raise ValueError(f"invalid document revision timestamp {value!r}") from exc
    if parsed.strftime("%Y-%m-%dT%H:%M:%SZ") != value:
        raise ValueError(f"document revision timestamp is not canonical: {value!r}")
    return parsed


def validate_contribution(contribution: Contribution) -> None:
    model = contribution.model.strip()
    qualifiers = contribution.qualifiers.strip()
    runtime = contribution.runtime.strip()

    if not model or GENERIC_MODEL_RE.search(model):
        raise ValueError(f"model identifier is generic or unavailable: {model!r}")

    if not qualifiers:
        raise ValueError(f"model {model!r} has an empty qualifier field")
    qualifier_keys: set[str] = set()
    for item in (part.strip() for part in qualifiers.split(";")):
        if item.lower().startswith("unexposed:"):
            if not item.partition(":")[2].strip():
                raise ValueError("unexposed qualifier must name the unavailable component")
        elif not QUALIFIER_RE.fullmatch(item):
            raise ValueError(
                f"qualifier {item!r} must use key=value or 'unexposed: component'"
            )
        else:
            key = item.partition("=")[0]
            if key in qualifier_keys:
                raise ValueError(f"duplicate model qualifier {key!r}")
            qualifier_keys.add(key)

    missing = REQUIRED_MODEL_QUALIFIERS.get(model, set()) - qualifier_keys
    if missing:
        raise ValueError(
            f"model {model!r} is missing required exposed qualifier(s): "
            + ", ".join(sorted(missing))
        )

    if not runtime:
        raise ValueError(f"model {model!r} has an empty agent/runtime field")
    if not re.search(r"\b(?:CLI|client|build|revision)\b", runtime, re.IGNORECASE):
        raise ValueError(
            "agent/runtime must identify an exposed version kind or unavailable revision"
        )
    for pattern in REQUIRED_RUNTIME_PATTERNS.get(model, ()):
        if not pattern.search(runtime):
            raise ValueError(
                f"model {model!r} requires runtime component matching {pattern.pattern!r}"
            )


def normalize(text: str) -> str:
    return re.sub(r"\s+", " ", text).strip()


def validate_source_metadata_display(text: str) -> None:
    heading = GENERATION_METADATA_HEADING_RE.search(active_tex(text))
    if heading:
        raise ValueError(
            "contains a standalone generation-metadata wrapper heading"
        )


def pdf_text(path: Path) -> str:
    result = subprocess.run(
        ["pdftotext", str(path), "-"],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise ValueError(f"pdftotext failed for {path}: {result.stderr.strip()}")
    return normalize(result.stdout)


def validate_pdf_info(path: Path, revision_timestamp: str) -> None:
    result = subprocess.run(
        ["pdfinfo", "-rawdates", str(path)],
        check=False,
        capture_output=True,
        text=True,
    )
    if result.returncode:
        raise ValueError(f"pdfinfo failed for {path}: {result.stderr.strip()}")
    fields = {}
    for line in result.stdout.splitlines():
        if ":" in line:
            key, value = line.split(":", 1)
            fields[key.strip()] = value.strip()
    for field in ("Title", "Subject"):
        if not fields.get(field):
            raise ValueError(f"rendered PDF has an empty {field} document-info field")
    parsed_revision = validate_revision_timestamp(revision_timestamp)
    expected_pdf_date = parsed_revision.strftime("D:%Y%m%d%H%M%SZ")
    if fields.get("ModDate") != expected_pdf_date:
        raise ValueError(
            "rendered PDF ModDate does not match its tracked revision timestamp: "
            f"expected {expected_pdf_date!r}, found {fields.get('ModDate')!r}"
        )
    if fields.get("CreationDate"):
        raise ValueError("rendered PDF contains a build-derived CreationDate")
    if re.search(rb"/ID\s*\[", path.read_bytes()):
        raise ValueError("rendered PDF contains an automatic trailer ID")


def validate_rendered_record(
    path: Path, record: Record, inherited_record: Record | None = None
) -> None:
    validate_pdf_info(path, record.revision_timestamp)
    rendered = pdf_text(path)
    revision_field = f"Last revised (UTC): {record.revision_timestamp}"
    normalized_revision = normalize(revision_field)
    if rendered.count(normalized_revision) != 1:
        raise ValueError(
            f"rendered PDF must contain exactly one tracked revision field "
            f"{revision_field!r}"
        )
    forbidden_label = RENDERED_LEDGER_LABEL_RE.search(rendered)
    if forbidden_label:
        raise ValueError(
            "rendered PDF contains an internal production-ledger field "
            f"{forbidden_label.group(0)!r}"
        )
    audit_contributions = (
        inherited_record.contributions
        if record.inheritance and inherited_record is not None
        else record.contributions
    )
    for contribution in audit_contributions:
        for kind, value in (
            ("model identifier", contribution.model),
            ("model qualifier", contribution.qualifiers),
            ("agent/runtime record", contribution.runtime),
        ):
            normalized_value = normalize(value)
            if normalized_value and normalized_value in rendered:
                raise ValueError(
                    f"rendered PDF contains a tracked {kind} {normalized_value!r}"
                )

    if record.inheritance:
        return

    effort_field = re.search(r"\beffort\s*=", rendered, re.IGNORECASE)
    if effort_field:
        raise ValueError(
            "rendered PDF contains a reader-visible model effort qualifier"
        )


def audit_document(source_root: Path, relative: str, pdf: Path | None = None) -> Record:
    leaf = source_root / relative
    main = leaf / "main.tex"
    metadata = leaf / "generation-metadata.tex"
    if not main.is_file():
        raise ValueError(f"missing source document {main}")
    if not metadata.is_file():
        raise ValueError(f"missing structured provenance record {metadata}")

    main_text = active_tex(main.read_text(encoding="utf-8"))
    expected_input = re.compile(
        rf"\\input\{{{re.escape(relative)}/generation-metadata(?:\.tex)?\}}"
    )
    if len(expected_input.findall(main_text)) != 1:
        raise ValueError("main.tex must input its structured provenance exactly once")
    for tex_source in leaf.rglob("*.tex"):
        if tex_source == metadata:
            continue
        source_text = active_tex(tex_source.read_text(encoding="utf-8"))
        validate_source_metadata_display(source_text)
        if LEGACY_LABEL_RE.search(source_text):
            raise ValueError(
                f"{tex_source.relative_to(leaf)} contains a handwritten generation-metadata field"
            )

    record = parse_record(metadata)
    inherited_record: Record | None = None
    if record.inheritance:
        target = Path(record.inheritance)
        if target.is_absolute() or ".." in target.parts:
            raise ValueError("inheritance target must be a safe provider-relative document path")
        target_metadata = source_root / target / "generation-metadata.tex"
        if not target_metadata.is_file():
            raise ValueError(f"inheritance target has no provenance record: {target}")
        inherited_record = parse_record(target_metadata)
        if inherited_record.inheritance:
            raise ValueError("generation provenance inheritance may not be chained")
        validate_revision_timestamp(inherited_record.revision_timestamp)
        for contribution in inherited_record.contributions:
            validate_contribution(contribution)
    else:
        for contribution in record.contributions:
            validate_contribution(contribution)

    validate_revision_timestamp(record.revision_timestamp)

    if pdf is not None:
        if not pdf.is_file():
            raise ValueError(f"rendered PDF not found: {pdf}")
        validate_rendered_record(pdf, record, inherited_record)
    return record


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--provider", default=os.environ.get("PROVIDER", "gpt"))
    parser.add_argument(
        "--pdf",
        nargs=2,
        metavar=("DOCUMENT", "PDF"),
        help="also compare one rendered PDF with its structured source record",
    )
    args = parser.parse_args()
    source_root = ROOT / "src" / args.provider

    errors: list[str] = []
    records: list[Record] = []
    if args.pdf:
        relative, pdf_name = args.pdf
        documents = [(relative, Path(pdf_name))]
    else:
        documents = [
            (str(path.parent.relative_to(source_root)), None)
            for path in sorted(source_root.rglob("main.tex"))
        ]

    if not documents:
        print(f"metadata error: no documents found beneath {source_root}", file=sys.stderr)
        return 1

    for relative, pdf in documents:
        try:
            records.append(audit_document(source_root, relative, pdf))
        except (OSError, ValueError) as exc:
            errors.append(f"{relative}: {exc}")

    if errors:
        for error in errors:
            print(f"metadata error: {error}", file=sys.stderr)
        return 1

    inherited = sum(record.inheritance is not None for record in records)
    canonical = len(records) - inherited
    print(
        f"Generation metadata valid: {canonical} canonical record(s), "
        f"{inherited} inherited record(s)."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
