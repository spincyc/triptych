def _load_yaml(path: Path) -> Any:
    import yaml

    if not path.exists():
        return {}
    text = path.read_text(encoding="utf-8")
    if not text.strip():
        return {}
    data = _calendars.read_yaml(path)
    return data if isinstance(data, dict) else {}


def _dump_yaml(payload: Any) -> str:
    import yaml

    return yaml.safe_dump(
        payload,
        sort_keys=False,
        allow_unicode=True,
        width=88,
    )


