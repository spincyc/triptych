# The calendars the corpus unions when the caller names none. TWO, with a third
# in the repository, and the two are the ones that STATE THEIR OWN TEXT.
#
# `roman-pre-1955` is a recension: it is held as its departures from
# `roman-1962` and states six of them, none of which carries a word of
# scripture. Resolved through `_calendars.load_document` it yields 276 masses
# and 1,178 passage keys, and every one of those keys is already contributed by
# `roman-1962` -- measured, not assumed: the set difference is empty. Unioning
# it would therefore double the mass rows of a corpus whose whole purpose is to
# say which passages want commentary, and add no passage to it.
#
# There is a second reason, and it is the one that could go wrong quietly. A
# recension's effective document carries the BASE's masses under the
# RECENSION's own top-level registers, so `citation_divergences` does not cross
# the join. `roman-1962` declares none today, so nothing moves; the day it
# declares one, a recension unioned here would offer the same citation with no
# divergence attached and `numbering_survey` would read the key as sound.
#
# So this is a refusal with a reason and not a set nobody revisited. `--calendar
# roman-pre-1955` is accepted and now resolves correctly, because the loading
# below goes through `_calendars` rather than round a recension's back; what is
# refused is unioning it by DEFAULT. A calendar that states its own text belongs
# in this tuple.
DEFAULT_CALENDARS = ("roman-1962", "postconciliar")

