#!/usr/bin/env python3
"""Build and query a passage-to-commentary-work index.

Usage:
  commentary-work-index discover [--discovery PATH] --passage PASSAGE
    [--numbering {vulgate,hebrew}] [--max-results N]
  commentary-work-index build-corpus [--discovery PATH] [--root DIR]
    [--calendar CALENDAR ...] [--max-results-per-mass N]
    [--max-results-per-passage N] [--output PATH]

This tool does not invoke external search agents. It works from curated mapping
records in `--discovery`, and returns ranked work metadata for each passage.

The index and the propers speak two key spaces: the index is keyed one chapter
at a time and a proper cites a verse range. A lookup therefore builds its key
from the parsed citation rather than from its spelling, answers from both key
spaces, and falls back to the chapters a range touches — saying so, and saying
which chapters, whenever it does.
"""

from __future__ import annotations

