# The corpus unions both missals, which number the psalter differently, so
# every psalm reference is normalised to one system before it becomes a key.
# Vulgate, because the patristic works the corpus exists to acquire are
# numbered that way throughout.
CANONICAL_NUMBERING = "vulgate"
NUMBERING_SYSTEMS = ("vulgate", "hebrew")


def _canonical_passage(
    record: dict[str, Any], source: str, target: str = CANONICAL_NUMBERING
) -> dict[str, Any]:
    """Renumber a psalm passage into the system the index is keyed in.

    `target` is a parameter and not the constant, because the index now says
    which system it is keyed in and a consumer must follow the declaration
    rather than its own assumption about it.
    """
    if not isinstance(record, dict):
        return record
    if record.get("book") != PSALMS or source == target:
        # Still re-render, so every key uses one spelling regardless of system.
        canonical = dict(record)
        canonical["ref"] = _normalize_ref_from_record(canonical)
        return canonical
    ranges = []
    for entry in record.get("ranges") or []:
        begin = dict(entry.get("begin") or {})
        end = dict(entry.get("end") or begin)
        b_ch, b_v, _ = convert_point(
            begin.get("chapter"), begin.get("verse"), source, target
        )
        e_ch, e_v, _ = convert_point(
            end.get("chapter", begin.get("chapter")), end.get("verse"),
            source, target,
        )
        ranges.append(
            {**entry, "begin": {**begin, "chapter": b_ch, "verse": b_v},
             "end": {**end, "chapter": e_ch, "verse": e_v}}
        )
    canonical = {**record, "ranges": ranges}
    canonical["ref"] = _normalize_ref_from_record(canonical)
    return canonical


