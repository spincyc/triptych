#!/usr/bin/env python3
"""Build and query a passage-to-commentary-work index.

Usage:
  commentary-work-index discover [--discovery PATH] --passage PASSAGE [--max-results N]
  commentary-work-index build-corpus [--discovery PATH] [--root DIR]
    [--calendar CALENDAR ...] [--max-results-per-mass N]
    [--max-results-per-passage N] [--output PATH]

This tool does not invoke external search agents. It works from curated mapping
records in `--discovery`, and returns ranked work metadata for each passage.
"""

from __future__ import annotations

import argparse
import dataclasses
import hashlib
import sys
from collections import defaultdict
from importlib.machinery import SourceFileLoader
from pathlib import Path
from typing import Any

