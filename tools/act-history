class Problem(Exception):
    pass


# --- Loading ----------------------------------------------------------------


# Tables whose rows carry an identity, and can therefore be amended by a file
# that extends another. `departures` is not among them: it has no identity, so
# an extending file only ever adds departures.
KEYED_TABLES = ("lines", "acts", "witnesses", "masses", "units")
APPENDED_TABLES = ("departures",)


def load(source: Path) -> dict:
    """Read a slice, resolving `extends` so a wider slice never copies a narrower one.

    A slice may declare `extends = "<file>"`, and then it is read on top of that
    file rather than beside it. This exists because guidance/the-shape.md
    section 2 is unambiguous: two copies of a fact are a prediction that they
    will differ, and it has never failed here. A wider history that restated the
    twelve Holy Week acts would be that copy.

    A row whose id already stands in the base must carry `amends`, which says
    why the base is being changed, and it then PATCHES that row field by field.
    Anything else is appended. So an extending file can only add, or amend in
    writing -- it cannot quietly replace.
    """
    return _load(source, seen=[])


def _load(source: Path, seen: list[Path]) -> dict:
    source = source.resolve()
    if source in seen:
        raise Problem("extends: " + " -> ".join(str(step) for step in [*seen, source]) + " is a cycle")
    if not source.exists():
        raise Problem(f"no source at {source}")
    data = tomllib.loads(source.read_text(encoding="utf-8"))
    if data.get(SCHEMA_KEY) != SCHEMA_VERSION:
        raise Problem(f"{source}: {SCHEMA_KEY} must be {SCHEMA_VERSION}")
    extends = data.pop("extends", None)
    if not extends:
        data["extends_chain"] = [source.name]
        return data
    base = _load(source.parent / extends, [*seen, source])
    return overlay(base, data, source)


def overlay(base: dict, extension: dict, source: Path) -> dict:
    """Read one slice on top of another. Additive, or amended in writing."""
    merged = dict(base)
    for key, value in extension.items():
        if key not in KEYED_TABLES and key not in APPENDED_TABLES:
            merged[key] = value
    for table in APPENDED_TABLES:
        merged[table] = list(base.get(table, [])) + list(extension.get(table, []))
    for table in KEYED_TABLES:
        rows = [dict(row) for row in base.get(table, [])]
        at = {row.get("id"): index for index, row in enumerate(rows)}
        for row in extension.get(table, []):
            identifier = row.get("id")
            if identifier in at:
                if not str(row.get("amends", "")).strip():
                    raise Problem(
                        f"{source.name}: {table} row {identifier!r} already stands in "
                        f"{base.get('extends_chain', ['the base'])[-1]}; an extending file that "
                        "changes a row must say why, in `amends`"
                    )
                rows[at[identifier]].update(row)
            else:
                if str(row.get("amends", "")).strip():
                    raise Problem(
                        f"{source.name}: {table} row {identifier!r} carries `amends` and amends "
                        "nothing; the base holds no such row"
                    )
                rows.append(dict(row))
        merged[table] = rows
    merged["extends_chain"] = [*base.get("extends_chain", []), source.name]
    return merged


def indexed(rows: list[dict], key: str, what: str) -> dict[str, dict]:
    out: dict[str, dict] = {}
    for row in rows:
        identifier = row.get(key)
        if not identifier:
            raise Problem(f"{what}: a row has no {key}")
        if identifier in out:
            raise Problem(f"{what}: duplicate {key} {identifier!r}")
        out[identifier] = row
    return out


def topological(acts: dict[str, dict]) -> list[str]:
    """Acts in an order where every parent precedes its children.

    Ties break on (date, id) so the output is byte-stable and so a reader sees
    the history in the order it happened rather than in the order it was typed.
    """
    remaining = dict(acts)
    placed: list[str] = []
    done: set[str] = set()
    while remaining:
        ready = sorted(
            (identifier for identifier, act in remaining.items()
             if all(parent in done for parent in act.get("parents", []))),
            key=lambda identifier: (acts[identifier].get("date", ""), identifier),
        )
        if not ready:
            raise Problem("acts: parent cycle or missing parent among " + ", ".join(sorted(remaining)))
        for identifier in ready:
            placed.append(identifier)
            done.add(identifier)
            del remaining[identifier]
    return placed


# --- The state a station leaves ---------------------------------------------
#
# A state is a flat map from repository path to bytes. Keeping it flat is what
# lets a reslot be an ordinary key move, and what lets the three-way merge below
# be a comparison of two dictionaries against a third rather than a walk of two
# trees.


# The top directory a mass stands in. It defaults to `holy-week` because that
# is where the first slice put everything and a default that moved existing
# paths would rewrite a history nobody changed. A slice carrying more than one
# part of the missal sets `book` on each mass.
DEFAULT_BOOK = "holy-week"

# Everything a station writes that is NOT liturgy. `commonality` compares two
# lines' liturgies, and comparing their act records instead would report that
# two rites differ because two decrees have different names.
RECORD_PREFIXES = ("acts/", "witnesses/", "gaps/", "unestablished/")

# --- Paths sort in the order the thing has ----------------------------------
#
# `acts/` and `witnesses/` are directory listings a reader browses, and a
# listing of a history that reads in alphabetical order is a listing that hides
# the one property the history has. So every per-act and per-witness path takes
# its date as a prefix, and a corpus running from 1474 to 2008 reads in order in
# any file manager, on GitHub, and in `ls`.
#
# The prefix is DERIVED, here, from the date already in the record. It is never
# typed beside it: a hand-typed prefix and a date field are two copies of one
# fact, and guidance/the-shape.md section 2 predicts they will differ. The
# functions below are idempotent, so an id that already carries its date is not
# given it twice.
#
# An UNDATED printing gets the literal prefix `undated`, which sorts after every
# year because `u` follows `9`. It is not given a guessed year: a year invented
# into a filename is provenance invented in the quietest place there is.

YEAR = re.compile(r"(\d{4})")


def year_of(printed: str) -> str:
    found = YEAR.search(str(printed or ""))
    return found.group(1) if found else "undated"


def sorted_name(prefix: str, identifier: str) -> str:
    """`1570-07-14` + `quo-primum-1570` -> `1570-07-14-quo-primum`.

    Ids in this project already end in their year, because that is how a reader
    tells `editio-typica-1920` from `editio-typica-1962`. Moving that year to
    the front rather than printing it twice is the whole convention; a trailing
    year is dropped only when it is the SAME year the prefix carries, so an id
    naming a different year keeps it.
    """
    if identifier.startswith(f"{prefix}-"):
        return identifier
    year = year_of(prefix)
    if identifier.endswith(f"-{year}"):
        identifier = identifier[: -len(year) - 1]
    return f"{prefix}-{identifier}"


def act_file(act: dict) -> str:
    return f"acts/{sorted_name(str(act['date']), act['id'])}.txt"


def gap_file(act: dict) -> str:
    return f"gaps/{sorted_name(str(act['date']), act['id'])}.txt"


def witness_file(witness: dict) -> str:
    return f"witnesses/{sorted_name(year_of(witness.get('printed')), witness['id'])}.txt"


def unit_path(book: str, mass: str, slot: str) -> str:
    return f"{book}/{mass}/{slot}.txt"


def is_liturgy(path: str) -> bool:
    return path != "README.md" and not path.startswith(RECORD_PREFIXES)


# A clause ends at a full stop, a colon or a semicolon. Breaking there and
# nowhere else is what makes a changed clause show as a changed line instead of
# lighting up a whole prayer, and doing it here rather than in the source is what
# stops the next person's re-wrapping from producing a diff nobody made. Commas
# are deliberately not breaks: Latin orations are comma-dense and breaking on
# them would put three words on a line and lose the clause as the unit a reader
# compares.
CLAUSE_END = re.compile(r"(?<=[.:;])\s+")


def ventilate(text: str) -> list[str]:
    """One clause to a line, mechanically.

    The rule is applied by the generator and never by hand, so an unchanged text
    always serialises to the same bytes.
    """
    flowed = " ".join(text.split())
    return [part for part in (piece.strip() for piece in CLAUSE_END.split(flowed)) if part]


def unit_body(name: str, incipit: str, text: str) -> str:
    """What a unit's file holds.

    The name, the incipit and the text, and nothing else. Provenance
    deliberately stays out: a unit file that carried its own witness list would
    make every re-reading of a scan show up as a change to the liturgy, which is
    the exact confusion this tool exists to prevent. The slot is the path, so a
    reslot with unchanged words is a rename and git's own similarity detection
    finds it without being told.
    """
    lines = [name, incipit]
    if text:
        lines.append("")
        lines.extend(ventilate(text))
    return "\n".join(lines) + "\n"


def mass_body(mass: dict) -> str:
    lines = [f"title: {mass['title']}", f"day: {mass['day']}"]
    hour = mass.get("hour", "")
    lines.append(f"hour: {hour}" if hour else "hour: not established")
    return "\n".join(lines) + "\n"


def order_body(paths: list[str]) -> str:
    return "".join(f"{path}\n" for path in paths)


class State:
    """The liturgy as one act left it, plus the record files of that station."""

    def __init__(self) -> None:
        self.units: dict[str, dict] = {}   # unit id -> {mass, slot, name, incipit, text, order}
        self.masses: dict[str, dict] = {}  # mass id -> {title, day, hour}
        self.files: dict[str, str] = {}    # extra tracked paths (acts/, witnesses/, gaps/, README)

    def copy(self) -> "State":
        other = State()
        other.units = {key: dict(value) for key, value in self.units.items()}
        other.masses = {key: dict(value) for key, value in self.masses.items()}
        other.files = dict(self.files)
        return other

    def tree(self) -> dict[str, str]:
        out = dict(self.files)
        by_mass: dict[str, list[dict]] = {}
        for unit in self.units.values():
            by_mass.setdefault(unit["mass"], []).append(unit)
        for mass_id, units in by_mass.items():
            mass = self.masses.get(mass_id)
            if mass is None:
                raise Problem(f"unit stands in mass {mass_id!r}, which no act has introduced")
            book = mass.get("book") or DEFAULT_BOOK
            out[f"{book}/{mass_id}/mass.txt"] = mass_body(mass)
            ordered = sorted(units, key=lambda unit: (unit["order"], unit["slot"]))
            out[f"{book}/{mass_id}/order.txt"] = order_body([unit["slot"] for unit in ordered])
            for unit in ordered:
                out[unit_path(book, mass_id, unit["slot"])] = unit_body(
                    unit["name"], unit["incipit"], unit.get("text", "")
                )
        return out


def merge(parents: list[State], ancestor: State, act_id: str) -> State:
    """Three-way merge of the states two parents left.

    A merge commit asserts that a reception happened. Where the parents changed
    the same thing to two different values, no reception can be read off the
    record, so this refuses rather than choosing. Silently preferring one side
    is how a synthesis nobody performed gets drawn.
    """
    if not parents:
        return State()
    if len(parents) == 1:
        return parents[0].copy()
    merged = ancestor.copy()
    for field in ("units", "masses", "files"):
        base = getattr(ancestor, field)
        keys = set(base)
        for parent in parents:
            keys |= set(getattr(parent, field))
        out = getattr(merged, field)
        out.clear()
        for key in sorted(keys):
            original = base.get(key)
            proposals = [getattr(parent, field).get(key) for parent in parents]
            changed = [value for value in proposals if value != original]
            if not changed:
                if original is not None:
                    out[key] = original
                continue
            first = changed[0]
            if any(value != first for value in changed[1:]):
                raise Problem(
                    f"{act_id}: its parents leave {field[:-1]} {key!r} in two different states; "
                    "a merge here would assert a synthesis the record does not show"
                )
            if first is not None:
                out[key] = first
    return merged


def common_ancestor(act_id: str, acts: dict[str, dict], states: dict[str, State]) -> State:
    """The state every parent of ``act_id`` inherits from.

    Walks each parent's ancestry and takes the latest act all of them reach. A
    slice with no common ancestor merges against nothing, which is the right
    answer for two independent roots and would be a conflict machine for
    anything else -- so `check` refuses that case separately.
    """
    parents = acts[act_id].get("parents", [])
    reach: list[set[str]] = []
    for parent in parents:
        seen: set[str] = set()
        pending = [parent]
        while pending:
            current = pending.pop()
            if current in seen:
                continue
            seen.add(current)
            pending.extend(acts[current].get("parents", []))
        reach.append(seen)
    shared = set.intersection(*reach) if reach else set()
    if not shared:
        return State()
    latest = max(shared, key=lambda identifier: (acts[identifier].get("date", ""), identifier))
    return states[latest]


# --- Applying an act's departures --------------------------------------------


def apply_departures(state: State, act_id: str, departures: list[dict]) -> list[str]:
    """Apply one act's departures, and report the kinds it used."""
    used: list[str] = []
    for departure in sorted(departures, key=lambda row: (row.get("kind", ""), row.get("unit") or row.get("mass") or "")):
        kind = departure.get("kind")
        used.append(kind)
        target = departure.get("unit")
        mass_target = departure.get("mass")
        if kind == "absent":
            if target not in state.units:
                raise Problem(f"{act_id}: absent names unit {target!r}, which the inherited state does not hold")
            del state.units[target]
        elif kind == "added":
            if target in state.units:
                raise Problem(f"{act_id}: added names unit {target!r}, which already stands")
            state.units[target] = {
                "mass": departure["to_mass"],
                "slot": departure["to_slot"],
                "name": departure["name"],
                "incipit": departure.get("incipit", ""),
                "text": departure.get("text", ""),
                "order": departure["order"],
            }
        elif kind == "replaced":
            if target not in state.units:
                raise Problem(f"{act_id}: replaced names unit {target!r}, which the inherited state does not hold")
            unit = state.units[target]
            before = dict(unit)
            for field in ("incipit", "text", "name"):
                if field in departure:
                    unit[field] = departure[field]
            if unit == before:
                raise Problem(f"{act_id}: replaced on {target!r} changes nothing; identity writes no row")
        elif kind == "renamed":
            if mass_target is not None:
                if mass_target not in state.masses:
                    raise Problem(f"{act_id}: renamed names mass {mass_target!r}, which the inherited state does not hold")
                if state.masses[mass_target]["title"] == departure["title"]:
                    raise Problem(f"{act_id}: renamed on mass {mass_target!r} changes nothing")
                state.masses[mass_target]["title"] = departure["title"]
            else:
                if target not in state.units:
                    raise Problem(f"{act_id}: renamed names unit {target!r}, which the inherited state does not hold")
                if state.units[target]["name"] == departure["name"]:
                    raise Problem(f"{act_id}: renamed on unit {target!r} changes nothing")
                state.units[target]["name"] = departure["name"]
        elif kind == "moved":
            if mass_target not in state.masses:
                raise Problem(f"{act_id}: moved names mass {mass_target!r}, which the inherited state does not hold")
            mass = state.masses[mass_target]
            before = dict(mass)
            for field in ("day", "hour"):
                if field in departure:
                    mass[field] = departure[field]
            if mass == before:
                raise Problem(f"{act_id}: moved on mass {mass_target!r} changes nothing")
        elif kind == "reslotted":
            if target not in state.units:
                raise Problem(f"{act_id}: reslotted names unit {target!r}, which the inherited state does not hold")
            unit = state.units[target]
            if departure.get("to_mass", unit["mass"]) == unit["mass"] and departure.get("to_slot", unit["slot"]) == unit["slot"]:
                raise Problem(f"{act_id}: reslotted on {target!r} moves it nowhere")
            unit["mass"] = departure.get("to_mass", unit["mass"])
            unit["slot"] = departure.get("to_slot", unit["slot"])
            if "name" in departure:
                unit["name"] = departure["name"]
            if "order" in departure:
                unit["order"] = departure["order"]
        elif kind == "unrecorded":
            # guidance/recensions.md Rule 3, both halves of it. The departure
            # resolves to nothing -- no state is guessed -- and it must not
            # silently fall back to the base either, so the unit leaves the
            # liturgy and a marker takes its place saying what is not known.
            # Carrying the inherited text forward would be the stronger claim,
            # made for free, that nothing changed.
            if target in state.units:
                del state.units[target]
            state.files[f"unestablished/{target}.txt"] = (
                f"{target}\n\n"
                "The state of this unit after this act is NOT ESTABLISHED.\n"
                "It is not carried forward from the inherited state, because carrying it\n"
                "forward would assert that nothing changed.\n\n"
                + departure["note"].strip() + "\n"
            )
        else:
            raise Problem(f"{act_id}: unknown departure kind {kind!r}")
    return used


