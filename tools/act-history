class Problem(Exception):
    pass


# --- Loading ----------------------------------------------------------------


# Tables whose rows carry an identity, and can therefore be amended by a file
# that extends another. `departures` is not among them: it has no identity, so
# an extending file only ever adds departures. Neither is `interpretations`: an
# interpretation is an event, and a second one on the same canon is a second
# row rather than a correction of the first.
KEYED_TABLES = ("lines", "acts", "witnesses", "masses", "units")
APPENDED_TABLES = ("departures", "interpretations")


def load(source: Path) -> dict:
    """Read a slice, resolving `extends` so a wider slice never copies a narrower one.

    A slice may declare `extends = "<file>"`, and then it is read on top of that
    file rather than beside it. This exists because guidance/the-shape.md
    section 2 is unambiguous: two copies of a fact are a prediction that they
    will differ, and it has never failed here. A wider history that restated the
    twelve Holy Week acts would be that copy.

    A row whose id already stands in the base must carry `amends`, which says
    why the base is being changed, and it then PATCHES that row field by field.
    Anything else is appended. So an extending file can only add, or amend in
    writing -- it cannot quietly replace.
    """
    return _load(source, seen=[])


def _load(source: Path, seen: list[Path]) -> dict:
    source = source.resolve()
    if source in seen:
        raise Problem("extends: " + " -> ".join(str(step) for step in [*seen, source]) + " is a cycle")
    if not source.exists():
        raise Problem(f"no source at {source}")
    data = tomllib.loads(source.read_text(encoding="utf-8"))
    if data.get(SCHEMA_KEY) != SCHEMA_VERSION:
        raise Problem(f"{source}: {SCHEMA_KEY} must be {SCHEMA_VERSION}")
    normalise(data, source)
    resolve_withholdings(data, source)
    extends = data.pop("extends", None)
    if not extends:
        data.update(chained([str(source)]))
        return data
    base = _load(source.parent / extends, [*seen, source])
    return overlay(base, data, source)


def chained(paths: list[str]) -> dict:
    """The files a slice was read from, and the names derived from them.

    One fact and not two. `plate` hashes the files to pin the edition it drew
    and everything else names them, and a hand-kept list of names beside a list
    of paths is the restatement guidance/the-shape.md section 2 is about.
    """
    return {"source_files": paths, "extends_chain": [Path(path).name for path in paths]}


# --- One number, typed once ---------------------------------------------------
#
# A canon's number is the fact that orders it, names it, and identifies it. It
# is written ONCE, as an integer, and its unit id, its file name and its
# position are derived here. Typing `id = "cic17-c-1012-1"` beside `canon =
# 1012` would be two copies of one fact, which guidance/the-shape.md section 2
# says is a prediction that they will differ; this project has already been bitten
# by exactly that in a lookup table it had to delete.
#
# The file name is the number ZERO-PADDED, so that a listing of a book of the
# Code reads as the Code reads rather than as an alphabet -- `can-0006` before
# `can-1012`, where `c-6` would sort after it. Four digits carry every canon of
# the three codes in view: the 1917 Code ends at 2414, the 1983 at 1752, the
# Eastern Code at 1546. The id keeps the number unpadded, because `c. 1012` is
# how a lawyer says it and an id is read by people.

CANON_PAD = 4
PARAGRAPH_PAD = 2


def canon_identity(row: dict, where: str) -> dict:
    """`code = "cic17", canon = 1012, paragraph = 1` -> id, slot, order, name."""
    code = str(row.get("code") or "").strip()
    if not code:
        raise Problem(f"{where}: a canon row must name the `code` it stands in")
    if not SLUG.match(code):
        raise Problem(f"{where}: code {code!r} is not a slug")
    try:
        canon = int(row["canon"])
    except (KeyError, TypeError, ValueError):
        raise Problem(f"{where}: a canon row must carry `canon` as a whole number") from None
    paragraph = row.get("paragraph")
    if paragraph is not None:
        try:
            paragraph = int(paragraph)
        except (TypeError, ValueError):
            raise Problem(f"{where}: `paragraph` must be a whole number") from None
    tail = f"-{paragraph}" if paragraph is not None else ""
    padded = f"-{paragraph:0{PARAGRAPH_PAD}d}" if paragraph is not None else ""
    return {
        "id": f"{code}-c-{canon}{tail}",
        "slot": f"can-{canon:0{CANON_PAD}d}{padded}",
        "order": canon * 100 + (paragraph or 0),
        "name": f"can. {canon}" + (f" §{paragraph}" if paragraph is not None else ""),
    }


def normalise(data: dict, source: Path) -> None:
    """Put one file's own tables into the shape the rest of the tool reads.

    Two things, and both are done per file before any `extends` overlay, so that
    an extending file's rows carry ids by the time they are matched against the
    base's.

    The container table is renamed to the internal one. A code's containers are
    `[[divisions]]` and a missal's are `[[masses]]`, and calling a title of the
    Code a mass in the source would be a lie told for the convenience of a
    dictionary key. Internally there is one table, because the code that walks
    it is identical.

    A law slice's canon rows are given their derived identity. A row that states
    its `id` outright keeps it -- an id is sometimes a thing with a history, and
    this only fills in what was not written.
    """
    vocabulary = str(data.get("vocabulary") or DEFAULT_VOCABULARY)
    if vocabulary not in VOCABULARIES:
        raise Problem(f"{source.name}: vocabulary must be one of {tuple(sorted(VOCABULARIES))}")
    vocab = VOCABULARIES[vocabulary]
    if vocab.group_table != "masses":
        if "masses" in data:
            raise Problem(
                f"{source.name}: a {vocab.name} slice keeps its containers in "
                f"[[{vocab.group_table}]], not [[masses]]"
            )
        if vocab.group_table in data:
            data["masses"] = data.pop(vocab.group_table)
    if vocabulary != "law":
        for row in data.get("units", []):
            if "canon" in row:
                raise Problem(
                    f"{source.name}: a unit carries `canon` but the slice's vocabulary is "
                    f"{vocabulary!r}; canon numbering belongs to a law slice"
                )
        return
    for index, row in enumerate(data.get("units", [])):
        if "canon" in row:
            derived = canon_identity(row, f"{source.name}: unit {index}")
            for field, value in derived.items():
                row.setdefault(field, value)
            if not row.get("mass"):
                if not row.get("division"):
                    raise Problem(
                        f"{source.name}: unit {row['id']} names no `division` of the code to stand in"
                    )
                row["mass"] = row.pop("division")
    for index, row in enumerate(data.get("departures", [])):
        # `division` is the law slice's word for the container, and only the
        # word: internally there is one container table and one key, so nothing
        # downstream has to ask which vocabulary it is reading.
        for stated, internal in (("division", "mass"), ("to_division", "to_mass")):
            if row.get(stated):
                row[internal] = row.pop(stated)
        if "canon" in row:
            derived = canon_identity(row, f"{source.name}: departure {index}")
            row.setdefault("unit", derived["id"])
            row.setdefault("name", derived["name"])
            if row.get("kind") in ("added", "reslotted"):
                row.setdefault("to_slot", derived["slot"])
                row.setdefault("order", derived["order"])
    for index, row in enumerate(data.get("interpretations", [])):
        if "canon" in row:
            row.setdefault("unit", canon_identity(row, f"{source.name}: interpretation {index}")["id"])


def resolve_withholdings(data: dict, source: Path) -> None:
    """Let a row name the reason its text is withheld instead of restating it.

    A slice that may publish none of a code's text writes `withheld` on every
    one of its canons, and the reason is one sentence about one rights position.
    Typing that sentence two hundred times is two hundred chances for it to
    drift, so the slice states it once in [withheld] and a row names the key.
    An unknown key is refused rather than passed through: a reason that reads as
    a key is exactly the absence that would print as a reason.
    """
    reasons = data.get("withheld") or {}
    if not isinstance(reasons, dict):
        raise Problem(f"{source.name}: [withheld] must be a table of reason keys")
    for table in ("units", "departures", "interpretations"):
        for row in data.get(table, []):
            key = row.get("withheld")
            if not key or not isinstance(key, str):
                continue
            if key in reasons:
                row["withheld"] = str(reasons[key]).strip()
            elif SLUG.match(key):
                raise Problem(
                    f"{source.name}: withheld = {key!r} names no reason in [withheld]"
                )


# What a row would be carrying BESIDE the marker that says it carries nothing.
# Named per table because the words of a canon and the words of a responsum live
# under different keys; the leak is the same one either way.
WITHHELD_WORDS = {
    "units": ("incipit", "text"),
    "departures": ("incipit", "text"),
    "interpretations": ("dubium", "responsum"),
}


def withheld_and_carried(row: dict, fields: tuple[str, ...], where: str) -> list[str]:
    """Every way one row both withholds its words and carries them.

    `withheld` is a rights position, and the renderers act on it: `unit_body`
    writes `[text withheld: ...]` where the incipit would stand and
    `interpretation_block` writes `[words withheld: ...]` above the entry. Both
    then write whatever words the row does hold, underneath the notice saying
    there are none. A marker nothing enforces is worth less than no marker,
    because a reader who has seen it hold once relies on it holding.

    An EMPTY field is not "carried". Clearing `text` is exactly how an act
    withdraws words the record once held, and refusing that would leave a slice
    unable to say that a published text became unpublishable.
    """
    if not str(row.get("withheld") or "").strip():
        return []
    return [
        f"{where}: carries `{field}` and also withholds its words; one or the other"
        for field in fields
        if str(row.get(field) or "").strip()
    ]


def overlay(base: dict, extension: dict, source: Path) -> dict:
    """Read one slice on top of another. Additive, or amended in writing."""
    merged = dict(base)
    for key, value in extension.items():
        if key not in KEYED_TABLES and key not in APPENDED_TABLES:
            merged[key] = value
    for table in APPENDED_TABLES:
        merged[table] = list(base.get(table, [])) + list(extension.get(table, []))
    for table in KEYED_TABLES:
        rows = [dict(row) for row in base.get(table, [])]
        at = {row.get("id"): index for index, row in enumerate(rows)}
        for row in extension.get(table, []):
            identifier = row.get("id")
            if identifier in at:
                if not str(row.get("amends", "")).strip():
                    raise Problem(
                        f"{source.name}: {table} row {identifier!r} already stands in "
                        f"{base.get('extends_chain', ['the base'])[-1]}; an extending file that "
                        "changes a row must say why, in `amends`"
                    )
                rows[at[identifier]].update(row)
            else:
                if str(row.get("amends", "")).strip():
                    raise Problem(
                        f"{source.name}: {table} row {identifier!r} carries `amends` and amends "
                        "nothing; the base holds no such row"
                    )
                rows.append(dict(row))
        merged[table] = rows
    merged.update(chained([*base.get("source_files", []), str(source)]))
    return merged


def indexed(rows: list[dict], key: str, what: str) -> dict[str, dict]:
    out: dict[str, dict] = {}
    for row in rows:
        identifier = row.get(key)
        if not identifier:
            raise Problem(f"{what}: a row has no {key}")
        if identifier in out:
            raise Problem(f"{what}: duplicate {key} {identifier!r}")
        out[identifier] = row
    return out


def topological(acts: dict[str, dict]) -> list[str]:
    """Acts in an order where every parent precedes its children.

    Ties break on (date, id) so the output is byte-stable and so a reader sees
    the history in the order it happened rather than in the order it was typed.
    """
    remaining = dict(acts)
    placed: list[str] = []
    done: set[str] = set()
    while remaining:
        ready = sorted(
            (identifier for identifier, act in remaining.items()
             if all(parent in done for parent in act.get("parents", []))),
            key=lambda identifier: (acts[identifier].get("date", ""), identifier),
        )
        if not ready:
            raise Problem("acts: parent cycle or missing parent among " + ", ".join(sorted(remaining)))
        for identifier in ready:
            placed.append(identifier)
            done.add(identifier)
            del remaining[identifier]
    return placed


# --- The state a station leaves ---------------------------------------------
#
# A state is a flat map from repository path to bytes. Keeping it flat is what
# lets a reslot be an ordinary key move, and what lets the three-way merge below
# be a comparison of two dictionaries against a third rather than a walk of two
# trees.


# Everything a station writes that is NOT liturgy. `commonality` compares two
# lines' liturgies, and comparing their act records instead would report that
# two rites differ because two decrees have different names.
RECORD_PREFIXES = ("acts/", "witnesses/", "gaps/", "unestablished/", "interpretations/")

# --- Paths sort in the order the thing has ----------------------------------
#
# `acts/` and `witnesses/` are directory listings a reader browses, and a
# listing of a history that reads in alphabetical order is a listing that hides
# the one property the history has. So every per-act and per-witness path takes
# its date as a prefix, and a corpus running from 1474 to 2008 reads in order in
# any file manager, on GitHub, and in `ls`.
#
# The prefix is DERIVED, here, from the date already in the record. It is never
# typed beside it: a hand-typed prefix and a date field are two copies of one
# fact, and guidance/the-shape.md section 2 predicts they will differ. The
# functions below are idempotent, so an id that already carries its date is not
# given it twice.
#
# An UNDATED printing gets the literal prefix `undated`, which sorts after every
# year because `u` follows `9`. It is not given a guessed year: a year invented
# into a filename is provenance invented in the quietest place there is.

YEAR = re.compile(r"(\d{4})")


def year_of(printed: str) -> str:
    found = YEAR.search(str(printed or ""))
    return found.group(1) if found else "undated"


def sorted_name(prefix: str, identifier: str) -> str:
    """`1570-07-14` + `quo-primum-1570` -> `1570-07-14-quo-primum`.

    Ids in this project already end in their year, because that is how a reader
    tells `editio-typica-1920` from `editio-typica-1962`. Moving that year to
    the front rather than printing it twice is the whole convention; a trailing
    year is dropped only when it is the SAME year the prefix carries, so an id
    naming a different year keeps it.
    """
    if identifier.startswith(f"{prefix}-"):
        return identifier
    year = year_of(prefix)
    if identifier.endswith(f"-{year}"):
        identifier = identifier[: -len(year) - 1]
    return f"{prefix}-{identifier}"


def act_file(act: dict) -> str:
    return f"acts/{sorted_name(str(act['date']), act['id'])}.txt"


def gap_file(act: dict) -> str:
    return f"gaps/{sorted_name(str(act['date']), act['id'])}.txt"


def witness_file(witness: dict) -> str:
    return f"witnesses/{sorted_name(year_of(witness.get('printed')), witness['id'])}.txt"


def unit_path(book: str, mass: str, slot: str) -> str:
    return f"{book}/{mass}/{slot}.txt"


def is_liturgy(path: str) -> bool:
    return path != "README.md" and not path.startswith(RECORD_PREFIXES)


# A clause ends at a full stop, a colon or a semicolon. Breaking there and
# nowhere else is what makes a changed clause show as a changed line instead of
# lighting up a whole prayer, and doing it here rather than in the source is what
# stops the next person's re-wrapping from producing a diff nobody made. Commas
# are deliberately not breaks: Latin orations are comma-dense and breaking on
# them would put three words on a line and lose the clause as the unit a reader
# compares.
CLAUSE_END = re.compile(r"(?<=[.:;])\s+")


def ventilate(text: str) -> list[str]:
    """One clause to a line, mechanically.

    The rule is applied by the generator and never by hand, so an unchanged text
    always serialises to the same bytes.
    """
    flowed = " ".join(text.split())
    return [part for part in (piece.strip() for piece in CLAUSE_END.split(flowed)) if part]


def unit_body(unit: dict, vocab: Vocabulary) -> str:
    """What a unit's file holds.

    The name, the incipit and the text, and nothing else. Provenance
    deliberately stays out: a unit file that carried its own witness list would
    make every re-reading of a scan show up as a change to the liturgy, which is
    the exact confusion this tool exists to prevent. The slot is the path, so a
    reslot with unchanged words is a rename and git's own similarity detection
    finds it without being told.

    The one addition is a law slice's withheld text, and it is not provenance:
    which act established the text of a canon is the canon's legal state, and
    where the words may not be printed it is the only state the file can carry.
    See VOCABULARIES.
    """
    # An empty incipit and a WITHHELD incipit are two different claims, and a
    # renderer that showed them alike would tell a reader the words were never
    # read when in fact they may not be printed here. guidance/the-shape.md
    # section 4: the gap has to survive contact with the renderer.
    incipit, text = unit.get("incipit", ""), unit.get("text", "")
    withheld = unit.get("withheld", "")
    lines = [unit["name"], incipit if incipit else (f"[{vocab.withheld_label}: {withheld}]" if withheld else "")]
    if withheld and not incipit and vocab.unit_carries_establishing_act and unit.get("established_at"):
        lines.append(f"text established by: {unit['established_at']}")
    if text:
        lines.append("")
        lines.extend(ventilate(text))
    return "\n".join(lines) + "\n"


def group_body(group: dict, vocab: Vocabulary) -> str:
    """What a Mass's or a division's header holds: its own fields, in order."""
    lines = []
    for field in vocab.group_fields:
        value = group.get(field, "")
        if value:
            lines.append(f"{field}: {value}")
        elif field in vocab.group_always:
            lines.append(f"{field}: not established")
    return "\n".join(lines) + "\n"


def order_body(paths: list[str]) -> str:
    return "".join(f"{path}\n" for path in paths)


# --- Where a container stands inside another ---------------------------------
#
# A Mass stands nowhere; a title of the Code stands inside a Part inside a Book,
# and that is how a canon is cited and how a lawyer navigates. So a container may
# declare `within`, naming the container it stands in, and the chain from the
# outermost down to its own is DERIVED here from those single links. Typing the
# chain on every canon would be the restatement guidance/the-shape.md section 2
# forbids: two hundred canons carrying a copy of `Liber VII > Pars III > Titulus
# I` is two hundred chances for one of them to disagree with the Book.
#
# The chain is written into the record ONLY where a slice declares any `within`
# at all. A slice that names one container per unit has a one-level structure,
# and that flatness is the honest picture of what it holds rather than something
# to be padded out.


def ancestry(groups: dict[str, dict], group_id: str) -> list[str]:
    """The containers `group_id` stands in, outermost first, itself last."""
    chain: list[str] = []
    seen: set[str] = set()
    current: str | None = group_id
    while current:
        if current in seen:
            raise Problem("within: " + " -> ".join([*chain, current]) + " is a cycle")
        seen.add(current)
        chain.append(current)
        current = groups.get(current, {}).get("within")
    return list(reversed(chain))


def nests(groups: dict[str, dict]) -> bool:
    return any(group.get("within") for group in groups.values())


def chain_of(groups: dict[str, dict], group_id: str, vocab: Vocabulary) -> list[dict]:
    """One container's ancestry as the page reads it: id, designation, title."""
    if not nests(groups) or group_id not in groups:
        return []
    return [
        {
            "id": step,
            **{field: groups[step].get(field, "") for field in vocab.group_always},
        }
        for step in ancestry(groups, group_id)
    ]


class State:
    """The liturgy as one act left it, plus the record files of that station."""

    def __init__(self, vocab: Vocabulary) -> None:
        self.vocab = vocab
        self.units: dict[str, dict] = {}   # unit id -> {mass, slot, name, incipit, text, order}
        self.masses: dict[str, dict] = {}  # container id -> its own fields
        self.files: dict[str, str] = {}    # extra tracked paths (acts/, witnesses/, gaps/, README)

    def copy(self) -> "State":
        other = State(self.vocab)
        other.units = {key: dict(value) for key, value in self.units.items()}
        other.masses = {key: dict(value) for key, value in self.masses.items()}
        other.files = dict(self.files)
        return other

    def tree(self) -> dict[str, str]:
        out = dict(self.files)
        by_mass: dict[str, list[dict]] = {}
        for unit in self.units.values():
            by_mass.setdefault(unit["mass"], []).append(unit)
        for mass_id, units in by_mass.items():
            mass = self.masses.get(mass_id)
            if mass is None:
                raise Problem(f"unit stands in mass {mass_id!r}, which no act has introduced")
            book = mass.get("book") or self.vocab.default_book
            out[f"{book}/{mass_id}/{self.vocab.group_word}.txt"] = group_body(mass, self.vocab)
            ordered = sorted(units, key=lambda unit: (unit["order"], unit["slot"]))
            out[f"{book}/{mass_id}/order.txt"] = order_body([unit["slot"] for unit in ordered])
            for unit in ordered:
                out[unit_path(book, mass_id, unit["slot"])] = unit_body(unit, self.vocab)
        return out


def merge(parents: list[State], ancestor: State, act_id: str) -> State:
    """Three-way merge of the states two parents left.

    A merge commit asserts that a reception happened. Where the parents changed
    the same thing to two different values, no reception can be read off the
    record, so this refuses rather than choosing. Silently preferring one side
    is how a synthesis nobody performed gets drawn.
    """
    if not parents:
        return ancestor.copy()
    if len(parents) == 1:
        return parents[0].copy()
    merged = ancestor.copy()
    for field in ("units", "masses", "files"):
        base = getattr(ancestor, field)
        keys = set(base)
        for parent in parents:
            keys |= set(getattr(parent, field))
        out = getattr(merged, field)
        out.clear()
        for key in sorted(keys):
            original = base.get(key)
            proposals = [getattr(parent, field).get(key) for parent in parents]
            changed = [value for value in proposals if value != original]
            if not changed:
                if original is not None:
                    out[key] = original
                continue
            first = changed[0]
            if any(value != first for value in changed[1:]):
                raise Problem(
                    f"{act_id}: its parents leave {field[:-1]} {key!r} in two different states; "
                    "a merge here would assert a synthesis the record does not show"
                )
            if first is not None:
                out[key] = first
    return merged


def common_ancestor(act_id: str, acts: dict[str, dict], states: dict[str, State], vocab: Vocabulary) -> State:
    """The state every parent of ``act_id`` inherits from.

    Walks each parent's ancestry and takes the latest act all of them reach. A
    slice with no common ancestor merges against nothing, which is the right
    answer for two independent roots and would be a conflict machine for
    anything else -- so `check` refuses that case separately.
    """
    parents = acts[act_id].get("parents", [])
    reach: list[set[str]] = []
    for parent in parents:
        seen: set[str] = set()
        pending = [parent]
        while pending:
            current = pending.pop()
            if current in seen:
                continue
            seen.add(current)
            pending.extend(acts[current].get("parents", []))
        reach.append(seen)
    shared = set.intersection(*reach) if reach else set()
    if not shared:
        return State(vocab)
    latest = max(shared, key=lambda identifier: (acts[identifier].get("date", ""), identifier))
    return states[latest]


# --- Applying an act's departures --------------------------------------------


def established(state: State, unit_id: str, act_id: str) -> None:
    """Record which act established this unit's text, where that is carried.

    Only a law slice carries it, and only where the words are withheld -- see
    VOCABULARIES for why. Derived from the act applying the departure, so the
    field cannot drift from the station it names.
    """
    if state.vocab.unit_carries_establishing_act:
        state.units[unit_id]["established_at"] = act_id


def apply_departures(state: State, act_id: str, departures: list[dict]) -> list[str]:
    """Apply one act's departures, and report the kinds it used."""
    used: list[str] = []
    for departure in sorted(departures, key=lambda row: (row.get("kind", ""), row.get("unit") or row.get("mass") or "")):
        kind = departure.get("kind")
        used.append(kind)
        target = departure.get("unit")
        mass_target = departure.get("mass")
        if kind == "absent":
            if target not in state.units:
                raise Problem(f"{act_id}: absent names unit {target!r}, which the inherited state does not hold")
            del state.units[target]
        elif kind == "added":
            if target in state.units:
                raise Problem(f"{act_id}: added names unit {target!r}, which already stands")
            state.units[target] = {
                "mass": departure["to_mass"],
                "slot": departure["to_slot"],
                "name": departure["name"],
                "incipit": departure.get("incipit", ""),
                "text": departure.get("text", ""),
                "order": departure["order"],
                "withheld": departure.get("withheld", ""),
            }
            established(state, target, act_id)
        elif kind == "replaced":
            if target not in state.units:
                raise Problem(f"{act_id}: replaced names unit {target!r}, which the inherited state does not hold")
            unit = state.units[target]
            words = lambda row: {key: value for key, value in row.items() if key != "established_at"}
            before = words(unit)
            for field in ("incipit", "text", "name", "withheld"):
                if field in departure:
                    unit[field] = departure[field]
            # Identity writes no row -- except where the words are withheld. An
            # act that substitutes a canon this project may not print changes
            # the establishing act and nothing else the file can show, and
            # refusing that row would leave the record unable to say that the
            # canon was substituted at all.
            if words(unit) == before and not (state.vocab.unit_carries_establishing_act and unit.get("withheld")):
                raise Problem(f"{act_id}: replaced on {target!r} changes nothing; identity writes no row")
            established(state, target, act_id)
        elif kind == "renamed":
            if mass_target is not None:
                if mass_target not in state.masses:
                    raise Problem(f"{act_id}: renamed names mass {mass_target!r}, which the inherited state does not hold")
                if state.masses[mass_target]["title"] == departure["title"]:
                    raise Problem(f"{act_id}: renamed on mass {mass_target!r} changes nothing")
                state.masses[mass_target]["title"] = departure["title"]
            else:
                if target not in state.units:
                    raise Problem(f"{act_id}: renamed names unit {target!r}, which the inherited state does not hold")
                if state.units[target]["name"] == departure["name"]:
                    raise Problem(f"{act_id}: renamed on unit {target!r} changes nothing")
                state.units[target]["name"] = departure["name"]
        elif kind == "moved":
            if mass_target not in state.masses:
                raise Problem(f"{act_id}: moved names mass {mass_target!r}, which the inherited state does not hold")
            mass = state.masses[mass_target]
            before = dict(mass)
            for field in ("day", "hour"):
                if field in departure:
                    mass[field] = departure[field]
            if mass == before:
                raise Problem(f"{act_id}: moved on mass {mass_target!r} changes nothing")
        elif kind == "reslotted":
            if target not in state.units:
                raise Problem(f"{act_id}: reslotted names unit {target!r}, which the inherited state does not hold")
            unit = state.units[target]
            if departure.get("to_mass", unit["mass"]) == unit["mass"] and departure.get("to_slot", unit["slot"]) == unit["slot"]:
                raise Problem(f"{act_id}: reslotted on {target!r} moves it nowhere")
            unit["mass"] = departure.get("to_mass", unit["mass"])
            unit["slot"] = departure.get("to_slot", unit["slot"])
            if "name" in departure:
                unit["name"] = departure["name"]
            if "order" in departure:
                unit["order"] = departure["order"]
        elif kind == "unrecorded":
            # guidance/recensions.md Rule 3, both halves of it. The departure
            # resolves to nothing -- no state is guessed -- and it must not
            # silently fall back to the base either, so the unit leaves the
            # liturgy and a marker takes its place saying what is not known.
            # Carrying the inherited text forward would be the stronger claim,
            # made for free, that nothing changed.
            if target in state.units:
                del state.units[target]
            state.files[f"unestablished/{target}.txt"] = (
                f"{target}\n\n"
                "The state of this unit after this act is NOT ESTABLISHED.\n"
                "It is not carried forward from the inherited state, because carrying it\n"
                "forward would assert that nothing changed.\n\n"
                + departure["note"].strip() + "\n"
            )
        else:
            raise Problem(f"{act_id}: unknown departure kind {kind!r}")
    return used


# --- An interpretation is not a departure ------------------------------------
#
# The Pontifical Council (now Dicastery) for Legislative Texts answers doubts
# about the Code, and its answer settles what a canon MEANS without altering a
# syllable of what it says. That is a real act, by a competent authority, with a
# date and an Acta citation, and under the Code itself an authentic
# interpretation given by way of law has the force of the law it interprets --
# 1917 c. 17 §2, whose words this record carries, and 1983 c. 16 §2 in the same
# terms.
#
# THE DECISION, and it is the one the brief asked to be argued rather than
# assumed. An interpretation is a STATION and is NOT a departure. It is a
# station because an authority acted, on a date, citing an instrument, which is
# the whole test this history applies. It is not a departure because every
# departure kind in guidance/recensions.md section 3 -- absent, added, replaced,
# renamed, moved, reslotted, unrecorded -- is a claim about the TEXT, and an
# interpretation makes no such claim. Recording one as `replaced` would put
# words in the legislator's mouth; recording it as `added` would invent a canon;
# recording it as `unrecorded` would say the state is unknown when it is
# precisely known and newly clarified.
#
# So it writes its own file, beside the canon and never inside it, and the
# canon's own file is untouched -- which is the correct diff, because the canon
# did not change. `interpretations/` joins RECORD_PREFIXES for the same reason
# `acts/` is there: `commonality` compares what two lines' LAW says, and two
# codes do not differ because one has been asked more questions.
#
# The cost is stated rather than hidden: `git log --follow` on a canon's file
# will not show its interpretations, because nothing in that file moved. A
# reader wanting both asks for both paths, and the browser fragments carry the
# interpretations on the unit's own history so the page does not have to.

INTERPRETATION_HEADER = """\
{unit}: authentic interpretations

An authentic interpretation changes what this canon MEANS and not one word of
what it SAYS. The canon's own file is therefore untouched by every entry below;
that is the record working, not the record missing something. An interpretation
given by way of law has the force of the law it interprets.
"""


def interpretation_block(act: dict, row: dict) -> str:
    lines = [
        "",
        f"{act['date']}  {act['title']}",
        f"  force:     {row.get('force', 'unstated')}",
    ]
    if row.get("papal_act"):
        lines.append(f"  papal act: {row['papal_act']}")
    if row.get("withheld"):
        lines.append(f"  [words withheld: {row['withheld']}]")
    for field, label in (("dubium", "dubium"), ("responsum", "responsum"),
                         ("question", "question asked"), ("answer", "answer given"),
                         ("citation", "citation"), ("basis", "basis"), ("note", "note")):
        value = (row.get(field) or "").strip()
        if value:
            lines.append(f"  {label + ':':<11}" + value.replace("\n", "\n" + " " * 13))
    lines.append(f"  read from: {row.get('read_from', 'not-read')}")
    return "\n".join(lines) + "\n"


def apply_interpretations(state: State, acts: dict[str, dict], act_id: str, rows: list[dict]) -> None:
    for row in sorted(rows, key=lambda row: str(row.get("unit"))):
        unit = str(row.get("unit"))
        path = f"interpretations/{unit}.txt"
        if path not in state.files:
            state.files[path] = INTERPRETATION_HEADER.format(unit=unit)
        state.files[path] += interpretation_block(acts[act_id], row)


PRINTED_WARNING = """\
THIS STATION IS A PRINTING, AND THAT IS A WEAKER CLAIM.
No act has been located for it. It stands here because the book survives and
refusing it would leave the record silent about a missal that exists -- not
because an authority is known to have issued it. Nothing about the date, the
authority or the reach of a change may be read off this station.
"""


def render_act(act: dict) -> str:
    printed = act.get("station_kind") == "printed"
    lines = [
        act["title"],
        "",
        f"station:    {act.get('station_kind', 'promulgated')}",
    ]
    if printed:
        lines.extend(["", PRINTED_WARNING.strip(), ""])
        lines.append(f"printing:   {act.get('printing', 'not named')}")
    else:
        lines.append(f"instrument: {act['instrument']}")
        lines.append(f"authority:  {act['authority']}")
    lines.extend([
        f"date:       {act['date']} ({precision_of(act['date'])})",
        f"kind:       {act['kind']}",
        f"line:       {act['line']}",
        f"citation:   {act['citation']}",
        f"instrument: {act['act_citation']}",
        f"read from:  {act.get('read_from', 'not-read')}",
    ])
    if act.get("parent_kind"):
        lines.append(f"edge:       {act['parent_kind']}")
    if act.get("same_instrument_as"):
        lines.append(f"also at:    {act['same_instrument_as']} (one instrument, two bodies of law)")
    if act.get("locus"):
        lines.append(f"locus:      {act['locus']}")
    if act.get("dateline"):
        lines.extend(["", "dateline as printed:", act["dateline"].strip()])
    for field, label in (("root_basis", "why this is a root"),
                         ("root_basis_superseded", "why this was formerly a root"),
                         ("parent_basis", "why this edge"),
                         ("use_declared", "what each book declares its use to be"),
                         ("distinct_edition_basis", "why this is a distinct edition"),
                         ("amends", "why this row was amended"),
                         ("reception_basis", "why these parents converge"),
                         ("act_citation_note", "on the missing instrument"),
                         ("act_citation_scope", "what was searched, and where not-found stops"),
                         ("quotation", "quoted"), ("parent_quotation", "quoted for the edge"),
                         ("effect", "effect"), ("effect_note", "on that effect")):
        if act.get(field):
            lines.extend(["", f"{label}:", act[field].strip()])
    lines.append("")
    lines.append(f"effect established: {'yes' if act.get('effect_established') else 'not established'}")
    return "\n".join(lines) + "\n"


def render_witness(witness: dict) -> str:
    lines = [
        witness["label"],
        "",
        f"language:   {witness['language']}",
        f"printed:    {witness['printed']}",
        f"attests:    {witness['attests']} ({witness.get('attests_kind', 'unstated')})",
        f"read from:  {witness['read_from']}",
        f"rights:     {witness['rights']}",
    ]
    if witness.get("ocr_artifact"):
        lines.append(f"artifact:   {witness['ocr_artifact']}")
    for field, label in (("attests_basis", "why it attests that act"),
                         ("not_a_station", "why it is not a station"),
                         ("rights_basis", "rights basis"),
                         ("units_read_note", "what was read"),
                         ("related_record", "related record")):
        if witness.get(field):
            lines.extend(["", f"{label}:", witness[field].strip()])
    return "\n".join(lines) + "\n"


def render_readme(data: dict, line: dict) -> str:
    return (
        f"# {data['slice']}: {line['label']}\n\n"
        "A generated repository. It is a build artifact like a PDF: regenerate it and\n"
        "every hash changes. The record is the source encoding it was built from, in the\n"
        "Triptych repository, under src/sources/inventories/:\n\n"
        + "".join(f"    {name}\n" for name in data.get("extends_chain", []))
        + "\nA commit is normally an ACT -- a promulgation, revision, reform, rubrical code\n"
        "or exemption -- and cites its instrument. A printing is normally NOT an act:\n"
        "printings are witnesses, under witnesses/, and hang beneath the history. A\n"
        "difference between two printings with no act behind it is a difference between\n"
        "witnesses or an error of a scanner, and never appears as a commit.\n\n"
        "THE ONE EXCEPTION DECLARES ITSELF. Where no act has been located for a missal\n"
        "that survives, the printing stands as a station and its commit subject begins\n"
        "`[printed]`. That is a WEAKER claim than every other commit here, and its\n"
        "message says so at length. `[printed]` never means an act was found and not\n"
        "read; it means none is claimed.\n\n"
        "READ THE DATES FROM THE SUBJECT LINE. Every commit subject begins with the\n"
        "act's true date, so `git log --oneline` and `--graph` show 1570 through 1962.\n"
        "The date is also in each commit's Act-date trailer and in acts/.\n\n"
        "The commit STAMP is that date shifted forward ten thousand years, and cannot\n"
        "be the real one. fast-import will write a negative timestamp and the object\n"
        "keeps it, but git then prints every date format empty, `fsck --strict` calls\n"
        "it badDate, and GitHub runs fsck on receive and refuses the push:\n\n"
        "    remote: error: object ...: badDate: invalid author/committer line\n"
        "    error: remote unpack failed: index-pack failed\n\n"
        "A smaller shift was rejected on purpose. The least shift clearing 1970 is\n"
        "about four hundred years, which would date Quo primum to 1970 and the 1962\n"
        "edition to 2362 -- plausible enough to be mistaken for a real date, which is\n"
        "worse than a stamp no one can misread. 11570 cannot be mistaken for anything.\n\n"
        f"{line['note'].strip()}\n"
    )


# --- Building the history ----------------------------------------------------


def build(data: dict) -> tuple[list[str], dict[str, State], dict[str, list[str]]]:
    vocab = vocabulary_of(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    lines = indexed(data.get("lines", []), "id", "lines")
    witnesses = indexed(data.get("witnesses", []), "id", "witnesses")
    order = topological(acts)

    departures_by_act: dict[str, list[dict]] = {}
    for departure in data.get("departures", []):
        departures_by_act.setdefault(departure.get("act", ""), []).append(departure)
    units_by_act: dict[str, list[dict]] = {}
    for unit in data.get("units", []):
        units_by_act.setdefault(unit.get("at", order[0]), []).append(unit)
    masses_by_act: dict[str, list[dict]] = {}
    for mass in data.get("masses", []):
        masses_by_act.setdefault(mass.get("at", order[0]), []).append(mass)
    witnesses_by_act: dict[str, list[dict]] = {}
    for identifier, witness in witnesses.items():
        witnesses_by_act.setdefault(witness.get("attests", ""), []).append(witness)
    interpretations_by_act: dict[str, list[dict]] = {}
    for row in data.get("interpretations", []):
        interpretations_by_act.setdefault(row.get("act", ""), []).append(row)

    states: dict[str, State] = {}
    kinds_used: dict[str, list[str]] = {}
    for act_id in order:
        act = acts[act_id]
        parents = act.get("parents", [])
        for parent in parents:
            if parent not in acts:
                raise Problem(f"{act_id}: names parent {parent!r}, which is not an act")
            if acts[parent]["line"] != act["line"] and len(parents) > 1:
                raise Problem(f"{act_id}: merges across lines; lines never rejoin")
        state = merge(
            [states[parent] for parent in parents],
            common_ancestor(act_id, acts, states, vocab),
            act_id,
        )
        for mass in masses_by_act.get(act_id, []):
            state.masses[mass["id"]] = {
                **{field: mass.get(field, "") for field in vocab.group_fields},
                "book": mass.get("book") or vocab.default_book,
            }
        for unit in units_by_act.get(act_id, []):
            state.units[unit["id"]] = {
                "mass": unit["mass"], "slot": unit["slot"], "name": unit["name"],
                "incipit": unit.get("incipit", ""), "text": unit.get("text", ""),
                "order": unit["order"], "withheld": unit.get("withheld", ""),
            }
            established(state, unit["id"], act_id)
        kinds_used[act_id] = apply_departures(state, act_id, departures_by_act.get(act_id, []))
        apply_interpretations(state, acts, act_id, interpretations_by_act.get(act_id, []))
        # THE STATE, and not only the rows that made it. A `replaced` departure
        # may set `withheld` on a unit that already carries inherited words and
        # clear nothing, and no reading of the rows can see that combination --
        # it is made here. `check` reports the row-level case in its own list;
        # this refuses at the one function `emit`, `structure`, `plate`, `graph`
        # and `commonality` all get their bytes from, before any of them has
        # written or removed anything, so the words are unwritable rather than
        # merely unrecommended.
        for unit_id, unit in sorted(state.units.items()):
            carried = withheld_and_carried(unit, WITHHELD_WORDS["units"], f"unit {unit_id}")
            if carried:
                raise Problem(f"{act_id}: {carried[0]}")
        state.files[act_file(act)] = render_act(act)
        for witness in sorted(witnesses_by_act.get(act_id, []), key=lambda row: row["id"]):
            state.files[witness_file(witness)] = render_witness(witness)
        if act.get("via_unrepresented"):
            state.files[gap_file(act)] = (
                "Stations between this act and its parent that this record does not hold:\n\n"
                + "".join(f"  - {item}\n" for item in act["via_unrepresented"])
                + "\nThe edge below this commit therefore means 'descends from', not\n"
                "'immediately follows'.\n"
                + ("\n" + act["via_unrepresented_basis"].strip() + "\n" if act.get("via_unrepresented_basis") else "")
            )
        if not parents:
            state.files["README.md"] = render_readme(data, lines[act["line"]])
        states[act_id] = state
    return order, states, kinds_used


# --- Checking ----------------------------------------------------------------


def check(data: dict) -> dict:
    problems: list[str] = []
    vocab = vocabulary_of(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    lines = indexed(data.get("lines", []), "id", "lines")
    witnesses = indexed(data.get("witnesses", []), "id", "witnesses")

    for act_id, act in sorted(acts.items()):
        if not SLUG.match(act_id):
            problems.append(f"act {act_id!r}: id is not a slug")
        station_kind = act.get("station_kind")
        if station_kind not in STATION_KINDS:
            problems.append(f"act {act_id}: station_kind must be one of {STATION_KINDS}")
        required = ("line", "kind", "date", "title", "citation")
        if station_kind != "printed":
            required += ("authority", "instrument")
        for field in required:
            if not act.get(field):
                problems.append(f"act {act_id}: missing {field}")
        if act.get("line") not in lines:
            problems.append(f"act {act_id}: line {act.get('line')!r} is not declared")
        if act.get("read_from") not in READINGS:
            problems.append(f"act {act_id}: read_from must be one of {READINGS}")
        try:
            derived = precision_of(act.get("date", ""))
            if act.get("date_precision") and act["date_precision"] != derived:
                problems.append(
                    f"act {act_id}: date_precision says {act['date_precision']!r} and the date "
                    f"{act['date']!r} says {derived!r}; write the date to the precision you have"
                )
        except Problem as problem:
            problems.append(f"act {act_id}: {problem}")
        parents = act.get("parents", [])
        parent_kind = act.get("parent_kind")
        if not parents and not act.get("root_basis"):
            problems.append(f"act {act_id}: a root must say why the record starts here")
        if parents and not act.get("parent_basis"):
            problems.append(f"act {act_id}: an edge is a claim of descent and must cite its basis")
        if parents and parent_kind not in PARENT_KINDS:
            problems.append(f"act {act_id}: parent_kind must be one of {PARENT_KINDS}")
        if not parents and parent_kind:
            problems.append(f"act {act_id}: a root has no edge and may not declare a parent_kind")
        if parent_kind == "use-continuity" and not act.get("use_declared"):
            problems.append(
                f"act {act_id}: a use-continuity edge asserts only that two books declare the same "
                "use, so it must quote what each declares, in `use_declared`"
            )
        if len(parents) > 1 and not act.get("reception_basis"):
            problems.append(
                f"act {act_id}: more than one parent asserts a reception; cite it or draw no merge"
            )
        if "effect_established" not in act:
            problems.append(f"act {act_id}: must say whether its effect is established")
        if act.get("act_citation") not in ACT_CITATIONS:
            problems.append(f"act {act_id}: act_citation must be one of {ACT_CITATIONS}")
        if act.get("act_citation") == "not-found" and not act.get("act_citation_note"):
            problems.append(
                f"act {act_id}: a station whose instrument was not found must say so at length"
            )
        # guidance/act-histories.md section 10, item 2, and the correction box in
        # section 7.2 that produced it. `not-found` once meant "not in these seven
        # text layers" and read as a claim about the repository, and the decree it
        # denied was registered here the whole time. A negative belongs to the
        # corpus it was taken in, so the field that records it says which.
        if act.get("act_citation") == "not-found" and not act.get("act_citation_scope"):
            problems.append(
                f"act {act_id}: `not-found` is a result of a search and must name what was "
                "searched, in `act_citation_scope`; a bare not-found reads as a claim about "
                "the tree rather than about a corpus"
            )
        if act.get("act_citation_scope") and act.get("act_citation") != "not-found":
            problems.append(
                f"act {act_id}: `act_citation_scope` records the bound on a not-found search "
                "and this station's instrument is not not-found"
            )
        # The narrow exception, held narrow. A `printed` station claims no act,
        # so it must name the printing it stands on and say why that printing is
        # a distinct edition and not a rescan of one already carried -- which is
        # the whole hazard of letting a book be a station at all.
        if station_kind == "printed":
            if act.get("act_citation") != "none-claimed":
                problems.append(
                    f"act {act_id}: a printed station claims no instrument, so act_citation must be "
                    "'none-claimed'; 'not-found' says an instrument is believed to exist"
                )
            if not act.get("printing"):
                problems.append(f"act {act_id}: a printed station must name the printing it stands on")
            elif act["printing"] not in witnesses:
                problems.append(f"act {act_id}: printing {act['printing']!r} is not a witness")
            if not act.get("distinct_edition_basis"):
                problems.append(
                    f"act {act_id}: a printed station must say why this is a distinct edition and "
                    "not a reprint or a rescan of one already carried"
                )
            if act.get("instrument"):
                problems.append(
                    f"act {act_id}: a printed station names an instrument; if an act was located "
                    "the station is promulgated"
                )
        elif act.get("act_citation") == "none-claimed":
            problems.append(
                f"act {act_id}: only a printed station may claim no instrument at all"
            )
        elif act.get("printing"):
            problems.append(f"act {act_id}: `printing` belongs to a printed station")
        # One instrument, two bodies of law. Ad tuendam fidem amends the Latin
        # Code and the Eastern Code in one document, and the two Codes are two
        # lines whose states cannot fork through one commit -- so the instrument
        # stands as two stations. That is a restatement, and a restatement is a
        # prediction that the two copies will differ
        # (guidance/the-shape.md section 2), so the pair is DECLARED and the
        # facts about the instrument are checked to agree rather than trusted.
        twin = act.get("same_instrument_as")
        if twin:
            if twin not in acts:
                problems.append(f"act {act_id}: same_instrument_as names {twin!r}, which is not an act")
            elif acts[twin].get("same_instrument_as") != act_id:
                problems.append(
                    f"act {act_id}: says it is the same instrument as {twin!r}, and {twin!r} does "
                    "not say so back; one instrument standing as two stations must be declared "
                    "from both sides"
                )
            elif acts[twin].get("line") == act.get("line"):
                problems.append(
                    f"act {act_id}: stands on the same line as {twin!r}; one instrument is split "
                    "into two stations only because two bodies of law are two lines"
                )
            else:
                for field in ("instrument", "authority", "date", "citation"):
                    if act.get(field) != acts[twin].get(field):
                        problems.append(
                            f"act {act_id}: and {twin!r} are declared one instrument and their "
                            f"{field} disagrees: {act.get(field)!r} against {acts[twin].get(field)!r}"
                        )

    for witness_id, witness in sorted(witnesses.items()):
        for field in ("label", "language", "printed", "attests", "attests_basis", "read_from", "rights", "rights_basis"):
            if not witness.get(field):
                problems.append(f"witness {witness_id}: missing {field}")
        if witness.get("read_from") not in READINGS:
            problems.append(f"witness {witness_id}: read_from must be one of {READINGS}")
        attests = witness.get("attests")
        if attests not in acts and attests != "unestablished":
            problems.append(f"witness {witness_id}: attests {attests!r}, which is not an act")

    masses = indexed(data.get("masses", []), "id", vocab.group_table)
    for mass_id, mass in sorted(masses.items()):
        if not SLUG.match(mass_id):
            problems.append(f"{vocab.group_word} {mass_id!r}: id is not a slug")
        for field in vocab.group_always:
            if not mass.get(field):
                problems.append(f"{vocab.group_word} {mass_id}: missing {field}")
        within = mass.get("within")
        if within and within not in masses:
            problems.append(
                f"{vocab.group_word} {mass_id}: within names {within!r}, which is not a declared "
                f"{vocab.group_word}"
            )
        elif within:
            try:
                ancestry(masses, mass_id)
            except Problem as problem:
                problems.append(f"{vocab.group_word} {mass_id}: {problem}")

    units = indexed(data.get("units", []), "id", "units")
    for unit_id, unit in sorted(units.items()):
        if not UNIT_ID.match(unit_id):
            problems.append(f"unit {unit_id!r}: id is not a dotted slug")
        for field in ("mass", "slot", "name", "order"):
            if unit.get(field) in (None, ""):
                problems.append(f"unit {unit_id}: missing {field}")
        if unit.get("mass") not in masses:
            problems.append(
                f"unit {unit_id}: {vocab.group_word} {unit.get('mass')!r} is not declared"
            )
        if not SLUG.match(str(unit.get("slot", ""))):
            problems.append(f"unit {unit_id}: slot is not a slug")
        if unit.get("read_from") not in READINGS:
            problems.append(f"unit {unit_id}: read_from must be one of {READINGS}")
        if unit.get("read_from") == "page-image" and not unit.get("collated"):
            problems.append(f"unit {unit_id}: claims a page image without a collation date")
        problems.extend(withheld_and_carried(unit, WITHHELD_WORDS["units"], f"unit {unit_id}"))

    departures = data.get("departures", [])
    for index, departure in enumerate(departures):
        where = f"departure {index}"
        if departure.get("act") not in acts:
            problems.append(f"{where}: act {departure.get('act')!r} is not an act")
        if departure.get("kind") not in DEPARTURE_KINDS:
            problems.append(f"{where}: kind must be one of {DEPARTURE_KINDS}")
        if not departure.get("basis"):
            problems.append(f"{where}: a departure must cite its basis")
        if departure.get("kind") == "unrecorded" and not departure.get("note"):
            problems.append(f"{where}: unrecorded must say what is not established")
        if departure.get("kind") == "reslotted" and not (departure.get("to_mass") or departure.get("to_slot")):
            problems.append(f"{where}: reslotted must say where to")
        # An `added` or `replaced` departure carries the words it puts into the
        # unit, so it can withhold and carry in one row exactly as a base unit
        # can. TASK-130 counted 11 withheld departures of 131 in the Code slice
        # and 2 of 13 in the missal, so this is not the rarer half of the hole.
        problems.extend(withheld_and_carried(departure, WITHHELD_WORDS["departures"], where))

    # An interpretation asserts that an authority answered a doubt about a
    # named canon. Each half of that has to be there: the act, the canon, the
    # doubt, the answer, and where it is printed. Without the citation it is a
    # recollection, and a recollection of a responsum is the one thing this
    # record must never carry.
    for index, row in enumerate(data.get("interpretations", [])):
        where = f"interpretation {index}"
        if row.get("act") not in acts:
            problems.append(f"{where}: act {row.get('act')!r} is not an act")
        if row.get("unit") not in units:
            problems.append(f"{where}: unit {row.get('unit')!r} is not a unit")
        for field in ("citation", "basis"):
            if not row.get(field):
                problems.append(f"{where}: missing {field}")
        # The words of a responsum are an official act of the Holy See, and this
        # project may not print the modern ones (see the canon-law rights
        # record). So an interpretation carries EITHER the dubium and the
        # responsum as they stand, OR a stated withholding and this project's
        # own English statement of what was asked and what was answered -- which
        # is a fact about the law, not the law's words. Never a blank, and never
        # English standing in a field a reader would take for the Latin.
        if row.get("withheld"):
            for field in ("question", "answer"):
                if not row.get(field):
                    problems.append(
                        f"{where}: its words are withheld, so it must say in `{field}` what was "
                        "asked and what was answered, in this project's own words"
                    )
            problems.extend(
                withheld_and_carried(row, WITHHELD_WORDS["interpretations"], where)
            )
        else:
            for field in ("dubium", "responsum"):
                if not row.get(field):
                    problems.append(f"{where}: missing {field}")
        if row.get("read_from") not in READINGS:
            problems.append(f"{where}: read_from must be one of {READINGS}")
        if row.get("force") not in INTERPRETATION_FORCES:
            problems.append(f"{where}: force must be one of {INTERPRETATION_FORCES}")
        if row.get("papal_act") is not None and row.get("papal_act") not in PAPAL_ACTS:
            problems.append(f"{where}: papal_act must be one of {PAPAL_ACTS}")

    if problems:
        raise Problem("\n".join(problems))

    order, states, kinds_used = build(data)
    # Build the tree of every state, and throw the result away. `build` computes
    # what each act left; only `State.tree` lays it out as paths, and only there
    # is it found that a unit stands in a container no act on its line has
    # introduced -- which is what happens when a container declares no `at` and
    # silently defaults to the first station in the whole graph, on another line.
    # Leaving that to `emit` meant `check` said ok about a slice that could not
    # be written.
    for act_id in order:
        try:
            states[act_id].tree()
        except Problem as problem:
            raise Problem(f"{act_id}: {problem}") from None
    counted: dict[str, int] = {}
    for kinds in kinds_used.values():
        for kind in kinds:
            counted[kind] = counted.get(kind, 0) + 1
    stations: dict[str, int] = {}
    edges: dict[str, int] = {}
    for act in acts.values():
        key = str(act.get("station_kind"))
        stations[key] = stations.get(key, 0) + 1
        if act.get("parents"):
            kind = str(act.get("parent_kind"))
            edges[kind] = edges.get(kind, 0) + len(act["parents"])
    return {
        "acts": len(acts),
        "base_units": len(units),
        "departure_kinds": counted,
        "departures": len(departures),
        "edge_kinds": edges,
        "extends_chain": data.get("extends_chain", []),
        "groups": len(masses),
        "group_plural": vocab.group_table,
        "group_word": vocab.group_word,
        "interpretations": len(data.get("interpretations", [])),
        "lines": len(lines),
        "masses": len(masses),
        "order": order,
        "roots": sorted(act_id for act_id, act in acts.items() if not act.get("parents")),
        "station_kinds": stations,
        "status": "ok",
        "unit_plural": vocab.unit_plural,
        "unit_word": vocab.unit_word,
        "vocabulary": vocab.name,
        "withheld_units": sum(1 for unit in units.values() if unit.get("withheld")),
        "witnesses": len(witnesses),
    }


# --- Emitting ----------------------------------------------------------------


def days_from_civil(year: int, month: int, day: int) -> int:
    """Days since 1970-01-01, proleptic Gregorian, for years Python cannot hold.

    `datetime` stops at 9999 and every act here lands past that once shifted, so
    the arithmetic is done directly. Howard Hinnant's civil-from-days, the same
    routine the corpus this drew on uses.
    """
    year -= month <= 2
    era = (year if year >= 0 else year - 399) // 400
    year_of_era = year - era * 400
    month_prime = month - 3 if month > 2 else month + 9
    day_of_year = (153 * month_prime + 2) // 5 + day - 1
    day_of_era = year_of_era * 365 + year_of_era // 4 - year_of_era // 100 + day_of_year
    return era * 146097 + day_of_era - 719468


# A date is written to the precision the record actually has: `1497` for a book
# dated only by its year, `1971` for a reprint whose leaf gives no month, and a
# full `1962-06-23` where a dateline prints the day. Nothing pads the source, and
# no day is invented so that a filename will sort. The precision is DERIVED from
# how much was written rather than declared beside it, because a declaration
# beside a value is a second copy of one fact.
DATE = re.compile(r"^(\d{4})(?:-(\d{2}))?(?:-(\d{2}))?$")
PRECISIONS = {1: "year", 2: "month", 3: "day"}


def date_parts(date: str) -> tuple[int, int, int]:
    found = DATE.match(str(date))
    if not found:
        raise Problem(f"date {date!r} is not YYYY, YYYY-MM or YYYY-MM-DD")
    return tuple(int(part) if part else 1 for part in found.groups())  # type: ignore[return-value]


def precision_of(date: str) -> str:
    found = DATE.match(str(date))
    if not found:
        raise Problem(f"date {date!r} is not YYYY, YYYY-MM or YYYY-MM-DD")
    return PRECISIONS[sum(1 for part in found.groups() if part)]


def stamp(date: str) -> str:
    year, month, day = date_parts(date)
    return f"{days_from_civil(year + YEAR_SHIFT, month, day) * 86400 + 12 * 3600} +0000"


def git(repo: Path, *args: str, stdin: str | None = None) -> str:
    result = subprocess.run(
        ["git", *args], cwd=repo, input=stdin, text=True, capture_output=True, check=True
    )
    return result.stdout.strip()


def write_tree(repo: Path, files: dict[str, str]) -> str:
    """Build a tree object from a flat path map, without touching a work tree.

    Going through the index would need a checkout and would make the result
    depend on the filesystem; `mktree` from the bottom up keeps the emit
    deterministic and lets an empty directory simply not exist.
    """
    nested: dict = {}
    for path, body in sorted(files.items()):
        parts = path.split("/")
        here = nested
        for part in parts[:-1]:
            here = here.setdefault(part, {})
        here[parts[-1]] = git(repo, "hash-object", "-w", "--stdin", stdin=body)

    def tree_of(level: dict) -> str:
        entries = []
        for name, value in sorted(level.items()):
            if isinstance(value, dict):
                entries.append(f"040000 tree {tree_of(value)}\t{name}")
            else:
                entries.append(f"100644 blob {value}\t{name}")
        return git(repo, "mktree", stdin="\n".join(entries) + "\n")

    return tree_of(nested)


def commit_message(act: dict, kinds: list[str]) -> str:
    # The act's true date leads the subject.
    #
    # It cannot lead the commit stamp. fast-import will write a negative
    # timestamp and the object keeps it verbatim, but git prints every date
    # format empty for one, `fsck --strict` calls it `badDate`, and GitHub
    # runs fsck on receive and refuses the push outright:
    #
    #     remote: error: object ...: badDate: invalid author/committer line
    #     error: remote unpack failed: index-pack failed
    #
    # So the stamp is shifted and the real date goes where every view of the
    # history shows it — `git log --oneline`, `--graph`, a GitHub commit list —
    # rather than only in the trailer, which none of those print.
    #
    # A `printed` station says so in the subject line, because the subject is
    # the only part of a commit that `git log --oneline` and a GitHub commit
    # list show. A weaker station that reads identically to a stronger one in
    # the one view everybody uses is a claim laundered by a renderer.
    printed = act.get("station_kind") == "printed"
    mark = "[printed] " if printed else ""
    body = [f"{act['date']}  {mark}{act['title']}", ""]
    if printed:
        body.extend([PRINTED_WARNING.strip(), ""])
    effect = act.get("effect", "").strip()
    if effect:
        body.extend([effect, ""])
    body.append("Station: " + str(act.get("station_kind", "promulgated")))
    if printed:
        body.append(f"Printing: {act.get('printing', 'not named')}")
        body.append("Act: none claimed")
    else:
        body.append(f"Act: {act['instrument']}")
        body.append(f"Authority: {act['authority']}")
    body.append(f"Act-date: {act['date']}")
    body.append(f"Line: {act['line']}")
    body.append(f"Citation: {act['citation']}")
    if act.get("parents"):
        body.append("Descends-from: " + ", ".join(act["parents"]))
        body.append("Descent-rests-on: " + str(act.get("parent_kind")))
    if act.get("via_unrepresented"):
        body.append("Via-unrepresented: " + ", ".join(act["via_unrepresented"]))
    body.append("Effect-established: " + ("yes" if act.get("effect_established") else "not established"))
    if kinds:
        counted: dict[str, int] = {}
        for kind in kinds:
            counted[kind] = counted.get(kind, 0) + 1
        body.append("Departures: " + ", ".join(f"{kind} {count}" for kind, count in sorted(counted.items())))
    else:
        body.append("Departures: none in this slice")
    body.append("Timestamp-shift: +10000 years; git refuses a pre-1970 date")
    return "\n".join(body) + "\n"


def emit(data: dict, out: Path) -> dict:
    order, states, kinds_used = build(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    if out.exists():
        subprocess.run(["rm", "-rf", str(out)], check=True)
    out.mkdir(parents=True)
    git(out, "init", "--quiet", "--bare")
    # `git gc` WOULD BREAK THIS REPOSITORY, so it is emitted with the switch
    # already thrown. The commit-graph stores a commit date in 34 bits -- a
    # ceiling near the year 2514 -- and the ten-thousand-year shift puts every
    # stamp here about eighteen times past it. `gc` writes a commit-graph by
    # default; `fsck --strict` then exits 16 reporting every commit, and a
    # date-ordered walk reads the truncated dates and puts a 1570 station ahead
    # of a 1962 one. This is local config and does not travel with a clone, so
    # it protects the repository this tool creates and not one somebody else
    # copies -- which is why the hazard also has to be stated on the artifact.
    git(out, "config", "gc.writeCommitGraph", "false")

    commits: dict[str, str] = {}
    for act_id in order:
        act = acts[act_id]
        tree = write_tree(out, states[act_id].tree())
        header = [f"tree {tree}"]
        header.extend(f"parent {commits[parent]}" for parent in act.get("parents", []))
        timestamp = stamp(act["date"])
        identity = str(data.get("identity") or IDENTITY)
        header.extend([f"author {identity} {timestamp}", f"committer {identity} {timestamp}", ""])
        raw = "\n".join(header) + "\n" + commit_message(act, kinds_used[act_id])
        # `git commit-tree` parses the date through git's own reader, which
        # rejects anything it cannot render; writing the object directly is the
        # only route for a shifted stamp, and is what the corpus this drew on does.
        commits[act_id] = git(out, "hash-object", "--literally", "-t", "commit", "-w", "--stdin", stdin=raw)
        git(out, "update-ref", f"refs/tags/act/{act_id}", commits[act_id])

    # One ref per line, at that line's head. A line whose descent is broken --
    # several pre-Tridentine printings of one use with nothing joining them --
    # has more than one head, and each extra head gets its own ref rather than
    # being dropped. A commit reachable from no branch is a commit a clone will
    # not show, and silently losing a station is worse than an awkward ref name.
    branches: dict[str, str] = {}
    for line, heads in sorted(line_heads(acts, order).items()):
        for index, act_id in enumerate(heads):
            ref = line if index == 0 else f"{line}--{act_id}"
            branches[ref] = commits[act_id]
    for ref, commit in sorted(branches.items()):
        git(out, "update-ref", f"refs/heads/{ref}", commit)
    git(out, "symbolic-ref", "HEAD", f"refs/heads/{acts[order[0]]['line']}")
    return {
        "branches": sorted(branches),
        "commits": len(order),
        "out": str(out),
        "status": "ok",
        "tags": len(order),
    }


def graph(data: dict) -> dict:
    order, _, kinds_used = build(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    rows = []
    for act_id in order:
        act = acts[act_id]
        rows.append({
            "act": act_id,
            "date": act["date"],
            "departures": sorted(set(kinds_used[act_id])),
            "line": act["line"],
            "parents": act.get("parents", []),
            "station_kind": act.get("station_kind"),
            "parent_kind": act.get("parent_kind"),
            "via_unrepresented": act.get("via_unrepresented", []),
        })
    return {"rows": rows, "status": "ok"}


# --- What two lines share, computed ------------------------------------------
#
# This is the reason the Git shape earns its keep. "What did Sarum and Rome
# share before they diverged" is not a question anyone should answer by writing
# a table; a hand-written table beside a derived one is a second source of truth
# and this project has already been bitten by exactly that
# (guidance/the-shape.md section 2). It is a merge-base query.
#
# The shared base is derived ONCE, here, from the act graph. `commonality` then
# runs `git merge-base` against the emitted repository and REFUSES if the two
# disagree -- so the derivation is not merely trusted, it is proved against the
# tool whose semantics it claims to have.
#
# The commonest answer in liturgical history is NONE, and that is a finding
# rather than a failure. Two rites that never shared an act in this record have
# no shared base, and saying so is the whole point of not drawing an edge.


def ancestors(acts: dict[str, dict], act_id: str) -> set[str]:
    """Every act reachable from this one, itself included."""
    seen: set[str] = set()
    pending = [act_id]
    while pending:
        current = pending.pop()
        if current in seen:
            continue
        seen.add(current)
        pending.extend(acts[current].get("parents", []))
    return seen


def merge_base_acts(acts: dict[str, dict], left: str, right: str) -> list[str]:
    """The best common ancestors of two acts: git's merge-base, on the act graph.

    A common ancestor that is itself an ancestor of another common ancestor is
    not a best one, so it is dropped. What remains is what `git merge-base`
    returns, and the equality is asserted rather than assumed.
    """
    shared = ancestors(acts, left) & ancestors(acts, right)
    best = [
        candidate for candidate in shared
        if not any(candidate in ancestors(acts, other) - {other} for other in shared)
    ]
    return sorted(best, key=lambda identifier: (acts[identifier].get("date", ""), identifier))


def line_heads(acts: dict[str, dict], order: list[str]) -> dict[str, list[str]]:
    """Each line's heads: its acts that no act on the same line descends from.

    Normally one. More than one means the line's own descent is broken, which
    is the honest pre-Tridentine shape and must not be hidden by picking the
    latest and calling it the line.
    """
    named: dict[str, set[str]] = {}
    for act_id, act in acts.items():
        for parent in act.get("parents", []):
            if acts[parent]["line"] == act["line"]:
                named.setdefault(act["line"], set()).add(parent)
    heads: dict[str, list[str]] = {}
    for act_id in reversed(order):
        line = acts[act_id]["line"]
        if act_id not in named.get(line, set()):
            heads.setdefault(line, []).append(act_id)
    return heads


def shared_bases(data: dict) -> list[dict]:
    """Every pair of lines, with the acts they last held in common."""
    order, _, _ = build(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    heads = line_heads(acts, order)
    rows = []
    names = sorted(heads)
    for index, left in enumerate(names):
        for right in names[index + 1:]:
            base: set[str] = set()
            for left_head in heads[left]:
                for right_head in heads[right]:
                    base.update(merge_base_acts(acts, left_head, right_head))
            rows.append({
                "a": left,
                "b": right,
                "shared_base": sorted(base, key=lambda identifier: (acts[identifier]["date"], identifier)),
                "shared_base_line": sorted({acts[identifier]["line"] for identifier in base}),
                "diverged_at": (
                    max(base, key=lambda identifier: (acts[identifier]["date"], identifier))
                    if base else None
                ),
            })
    return rows


def blobs(repo: Path, ref: str) -> dict[str, str]:
    """One commit's liturgy, path to blob hash. The record files are excluded."""
    out: dict[str, str] = {}
    listing = git(repo, "ls-tree", "-r", ref)
    for row in listing.splitlines():
        meta, path = row.split("\t", 1)
        if is_liturgy(path):
            out[path] = meta.split()[2]
    return out


def commonality(data: dict, repo: Path, wanted: tuple[str, str] | None) -> dict:
    """What two lines share and where they part, from the emitted repository.

    Two halves, and they answer different questions:

      THE SHARED BASE is about ACTS. It is `git merge-base` on the two lines'
      heads, and it says whether any authority's act stands behind both. Where
      the answer is none, the two rites have no act in common in this record and
      the tool says exactly that.

      THE DIVERGENCE is about TEXT. It compares the two tips' trees and reports
      what stands in both identically, in both differently, and in one alone.
      Two lines with no shared act can still hold the same prayer, and that is
      the interesting case -- inheritance older than anything this record
      carries, visible as agreement without an edge.
    """
    if not repo.exists():
        emit(data, repo)
    order, _, _ = build(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    heads = line_heads(acts, order)
    derived = {(row["a"], row["b"]): row for row in shared_bases(data)}
    pairs = [wanted] if wanted else sorted(derived)

    rows = []
    for left, right in pairs:
        key = (left, right) if (left, right) in derived else (right, left)
        if key not in derived:
            raise Problem(f"commonality: no such pair of lines: {left!r}, {right!r}")
        row = derived[key]
        # The proof. git is asked the same question the DAG was asked, and a
        # disagreement is a defect in this tool rather than a fact about the
        # history, so it raises instead of reporting.
        left_ref, right_ref = heads[key[0]][0], heads[key[1]][0]
        result = subprocess.run(
            ["git", "merge-base", "--all", f"act/{left_ref}", f"act/{right_ref}"],
            cwd=repo, text=True, capture_output=True,
        )
        found = sorted(line.strip() for line in result.stdout.splitlines() if line.strip())
        expected = sorted(
            git(repo, "rev-parse", f"act/{act_id}") for act_id in row["shared_base"]
        )
        if found != expected:
            raise Problem(
                f"commonality {key[0]}/{key[1]}: git merge-base and the act graph disagree; "
                f"git says {found}, the graph says {expected}"
            )
        left_tree, right_tree = blobs(repo, f"act/{left_ref}"), blobs(repo, f"act/{right_ref}")
        both = sorted(set(left_tree) & set(right_tree))
        same = [path for path in both if left_tree[path] == right_tree[path]]
        rows.append({
            **row,
            "a_head": key[0] and heads[key[0]][0],
            "b_head": heads[key[1]][0],
            "same_text": same,
            "differing_text": [path for path in both if left_tree[path] != right_tree[path]],
            "only_a": sorted(set(left_tree) - set(right_tree)),
            "only_b": sorted(set(right_tree) - set(left_tree)),
        })
    return {"pairs": rows, "repo": str(repo), "status": "ok"}


# --- What an act changed, unit by unit ---------------------------------------
#
# The map's detail panel shows a reader WHAT an act did, not merely that it did
# five things called `absent`. The only honest source for that is the same state
# computation `emit` commits, so the change set is derived here out of `build`'s
# own states and written beside the map. Nothing recomputes it. A second
# derivation in the page is how two answers to "what changed in 1955" ship
# inside one artifact, and guidance/the-shape.md section 2 is about exactly that
# pair.
#
# The departure KIND is never inferred from the diff. A field that moved says
# which field; what the act called the movement is read from the recorded
# departure beside it, with the basis the source states. Where a unit enters
# with no departure behind it, that is this record first carrying the unit and
# is labelled as such rather than as an addition somebody made.
#
# Fragmented, because a reader opening the map must not download every diff of
# every station in order to see the map. The spine carries the counts, which is
# what a reader needs to choose; opening a station costs that station.

# `withheld` is here beside `incipit` on purpose. A unit whose words were never
# read and a unit whose words may not be published both show an empty incipit,
# and a page that could not tell them apart would report a rights position as
# ignorance. It is carried to the fragments so the page can say which it is.
UNIT_FIELDS = ("mass", "slot", "name", "incipit", "text", "order", "withheld")
LAW_UNIT_FIELDS = UNIT_FIELDS + ("established_at",)
UNESTABLISHED = "unestablished/"
INTERPRETATIONS = "interpretations/"


def unit_fields(vocab: Vocabulary) -> tuple[str, ...]:
    return LAW_UNIT_FIELDS if vocab.unit_carries_establishing_act else UNIT_FIELDS


def side(row: dict | None, fields: tuple[str, ...]) -> dict | None:
    """One side of a change, carrying only what the state holds.

    An empty incipit is not an empty prayer: it is a unit whose words this
    record never carried. The value is passed through as it stands so the page
    can say so, and nothing here fills it in.
    """
    if row is None:
        return None
    return {field: row.get(field, "") for field in fields}


def differing(before: dict | None, after: dict | None, fields: tuple[str, ...]) -> list[str]:
    if before is None or after is None:
        return []
    return [field for field in fields if before.get(field, "") != after.get(field, "")]


def cited(departures: list[dict]) -> list[dict]:
    """What the source says it did, and on what basis, for one target."""
    return [
        {
            "kind": departure.get("kind"),
            "basis": (departure.get("basis") or "").strip(),
            "note": (departure.get("note") or "").strip(),
        }
        for departure in departures
    ]


def inherited(act_id: str, acts: dict[str, dict], states: dict[str, State]) -> State:
    """The state an act inherits, through the same merge `build` performs.

    Not a reimplementation: it calls the two functions the build calls, in the
    same order, so a merge that refuses there refuses here.
    """
    parents = acts[act_id].get("parents", [])
    return merge(
        [states[parent] for parent in parents],
        common_ancestor(act_id, acts, states, states[act_id].vocab),
        act_id,
    )


def markers(state: State, prefix: str = UNESTABLISHED) -> dict[str, str]:
    return {
        path[len(prefix):-len(".txt")]: text
        for path, text in state.files.items()
        if path.startswith(prefix)
    }


def change_set(act_id: str, before: State, after: State, departures: list[dict],
               interpretations: list[dict]) -> dict:
    """Everything one act moved, keyed by the unit or container it moved."""
    vocab = after.vocab
    fields = unit_fields(vocab)
    by_unit: dict[str, list[dict]] = {}
    by_mass: dict[str, list[dict]] = {}
    for departure in departures:
        if departure.get("unit"):
            by_unit.setdefault(departure["unit"], []).append(departure)
        elif departure.get("mass"):
            by_mass.setdefault(departure["mass"], []).append(departure)

    marked = markers(after)
    was_marked = markers(before)

    units = []
    for unit_id in sorted(set(before.units) | set(after.units) | set(by_unit)):
        was = before.units.get(unit_id)
        now = after.units.get(unit_id)
        recorded = by_unit.get(unit_id, [])
        if was == now and not recorded:
            continue
        units.append({
            "unit": unit_id,
            "state": "entered" if was is None else ("gone" if now is None else "changed"),
            "kinds": sorted({departure.get("kind") for departure in recorded}),
            "fields": differing(was, now, fields),
            "before": side(was, fields),
            "after": side(now, fields),
            "cited": cited(recorded),
            # Rule 3 of guidance/recensions.md, carried to the page: a unit an
            # act left unestablished prints its marker rather than falling back
            # to the words it inherited.
            "marker": marked.get(unit_id) if marked.get(unit_id) != was_marked.get(unit_id) else None,
        })

    masses = []
    for mass_id in sorted(set(before.masses) | set(after.masses) | set(by_mass)):
        was = before.masses.get(mass_id)
        now = after.masses.get(mass_id)
        recorded = by_mass.get(mass_id, [])
        if was == now and not recorded:
            continue
        masses.append({
            vocab.group_word: mass_id,
            "state": "entered" if was is None else ("gone" if now is None else "changed"),
            "kinds": sorted({departure.get("kind") for departure in recorded}),
            "fields": differing(was, now, vocab.group_fields),
            "before": side(was, vocab.group_fields),
            "after": side(now, vocab.group_fields),
            "cited": cited(recorded),
        })

    orphaned = [
        {"unit": unit_id, "marker": text}
        for unit_id, text in sorted(marked.items())
        if was_marked.get(unit_id) != text and unit_id not in by_unit
    ]

    payload = {
        "act": act_id,
        "units": units,
        vocab.group_table: masses,
        "unestablished": orphaned,
        "totals": {
            "units_entered": sum(1 for row in units if row["state"] == "entered"),
            "units_gone": sum(1 for row in units if row["state"] == "gone"),
            "units_changed": sum(1 for row in units if row["state"] == "changed"),
            f"{vocab.group_table}_touched": len(masses),
            "unestablished": sum(1 for row in units if row["marker"]) + len(orphaned),
            "standing": len(after.units),
        },
    }
    # Written only where there are any, so a slice that knows nothing of
    # authentic interpretations emits exactly the bytes it emitted before this
    # field existed. An interpretation is carried whole, because a reader
    # deciding what a canon means needs the doubt and the answer, not a count.
    if interpretations:
        payload["interpretations"] = [
            {
                "unit": row.get("unit"),
                "force": row.get("force"),
                "papal_act": row.get("papal_act") or "",
                "withheld": (row.get("withheld") or "").strip(),
                "question": (row.get("question") or "").strip(),
                "answer": (row.get("answer") or "").strip(),
                "dubium": (row.get("dubium") or "").strip(),
                "responsum": (row.get("responsum") or "").strip(),
                "citation": (row.get("citation") or "").strip(),
                "basis": (row.get("basis") or "").strip(),
                "note": (row.get("note") or "").strip(),
                "read_from": row.get("read_from"),
            }
            for row in sorted(interpretations, key=lambda row: str(row.get("unit")))
        ]
        payload["totals"]["interpretations"] = len(interpretations)
    return payload


def standing(act_id: str, act: dict, state: State) -> dict:
    """The text as it stood when that act had done its work.

    A reader arriving at a station wants to read the book, not only the delta,
    and a container that holds no unit is printed with none rather than dropped:
    an empty Mass, or an empty title of the Code, is this record saying it
    carries nothing there.
    """
    vocab = state.vocab
    fields = unit_fields(vocab)
    held: dict[str, list[dict]] = {}
    for unit_id, unit in state.units.items():
        held.setdefault(unit["mass"], []).append({"unit": unit_id, **side(unit, fields)})
    masses = []
    for mass_id in sorted(set(state.masses) | set(held)):
        mass = state.masses.get(mass_id) or {}
        masses.append({
            vocab.group_word: mass_id,
            **{field: mass.get(field, "") for field in vocab.group_fields},
            "units": sorted(held.get(mass_id, []), key=lambda row: (row["order"], row["slot"])),
        })
    payload = {
        "act": act_id,
        "date": str(act.get("date")),
        "title": act.get("title"),
        "line": act.get("line"),
        "station_kind": act.get("station_kind"),
        vocab.group_table: masses,
        "unestablished": [
            {"unit": unit_id, "marker": text} for unit_id, text in sorted(markers(state).items())
        ],
        "totals": {vocab.group_table: len(masses), "units": len(state.units)},
    }
    interpreted = markers(state, INTERPRETATIONS)
    if interpreted:
        payload["interpretations"] = [
            {"unit": unit_id, "record": text} for unit_id, text in sorted(interpreted.items())
        ]
    return payload


def unit_histories(order: list[str], acts: dict[str, dict], sets: dict[str, dict]) -> dict[str, dict]:
    """One prayer's whole life, gathered from the per-act change sets.

    Inverted from the same rows the stations show, so the history a reader
    follows and the diff a reader arrives at can never disagree.
    """
    histories: dict[str, dict] = {}
    for act_id in order:
        act = acts[act_id]
        for row in sets[act_id]["units"]:
            history = histories.setdefault(row["unit"], {"unit": row["unit"], "stations": []})
            history["stations"].append({
                "act": act_id,
                "date": str(act.get("date")),
                "title": act.get("title"),
                "line": act.get("line"),
                "station_kind": act.get("station_kind"),
                "instrument": act.get("instrument"),
                **{key: row[key] for key in ("state", "kinds", "fields", "before", "after", "cited", "marker")},
            })
        # An interpretation is a stop in a canon's life and not a change to its
        # text, so it joins the history with no departure kind, no before and no
        # after. A page that drew it as a change would say the legislator
        # rewrote a canon nobody rewrote.
        for row in sets[act_id].get("interpretations", []):
            history = histories.setdefault(row["unit"], {"unit": row["unit"], "stations": []})
            history["stations"].append({
                "act": act_id,
                "date": str(act.get("date")),
                "title": act.get("title"),
                "line": act.get("line"),
                "station_kind": act.get("station_kind"),
                "instrument": act.get("instrument"),
                "state": "interpreted",
                "kinds": [],
                "fields": [],
                "before": None,
                "after": None,
                "cited": [],
                "marker": None,
                "interpretation": row,
            })
    for history in histories.values():
        stops = history["stations"]
        recent = next((stop for stop in reversed(stops) if stop["after"]), None)
        last = (recent or {}).get("after") or {}
        history["entered_at"] = stops[0]["act"]
        history["standing"] = stops[-1]["state"] != "gone"
        history["name"] = last.get("name", "")
        history["mass"] = last.get("mass", "")
        history["slot"] = last.get("slot", "")
        history["last_held_at"] = recent["act"] if recent else None
        history["left_at"] = stops[-1]["act"] if stops[-1]["state"] == "gone" else None
    return histories


def write_json(target: Path, payload: dict) -> None:
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
    )


def fragments(data: dict, root: Path, slice_id: str) -> dict[str, dict]:
    """Write one file per station, per state and per unit; return the summaries.

    The file names come from `sorted_name`, the same helper the spine's
    `station_path` and `state_path` are built from, so there is one naming rule
    and the page follows the path it was given rather than composing one.
    """
    order, states, _ = build(data)
    acts = indexed(data.get("acts", []), "id", "acts")
    departures_by_act: dict[str, list[dict]] = {}
    for departure in data.get("departures", []):
        departures_by_act.setdefault(departure.get("act", ""), []).append(departure)
    interpretations_by_act: dict[str, list[dict]] = {}
    for row in data.get("interpretations", []):
        interpretations_by_act.setdefault(row.get("act", ""), []).append(row)

    sets = {
        act_id: change_set(
            act_id,
            inherited(act_id, acts, states),
            states[act_id],
            departures_by_act.get(act_id, []),
            interpretations_by_act.get(act_id, []),
        )
        for act_id in order
    }
    histories = unit_histories(order, acts, sets)

    for act_id in order:
        act = acts[act_id]
        name = sorted_name(str(act["date"]), act_id)
        # Why this station descends from what it descends from, and -- where two
        # descents converge -- the reception the merge asserts. All of it is
        # prose, all of it is long, and it belongs beside the diff a reader
        # opened rather than in the spine every reader downloads.
        edges = {
            field: (act.get(field) or "").strip()
            for field in ("root_basis", "parent_basis", "reception_basis",
                          "via_unrepresented_basis", "printing_basis", "act_citation_note",
                          "act_citation_scope")
            if act.get(field)
        }
        write_json(root / slice_id / "station" / f"{name}.json", {**sets[act_id], "edges": edges})
        write_json(root / slice_id / "state" / f"{name}.json", standing(act_id, act, states[act_id]))
    for unit_id, history in sorted(histories.items()):
        write_json(root / slice_id / "unit" / f"{unit_id}.json", history)
    vocab = vocabulary_of(data)
    groups = indexed(data.get("masses", []), "id", vocab.group_table)
    index = []
    for _, history in sorted(histories.items()):
        row = {
            "unit": history["unit"],
            "name": history["name"],
            "mass": history["mass"],
            "slot": history["slot"],
            "entered_at": history["entered_at"],
            "left_at": history["left_at"],
            "standing": history["standing"],
            "stations": len(history["stations"]),
            "path": f"{slice_id}/unit/{history['unit']}.json",
            # Which line the unit belongs to, DERIVED from the act that first
            # carried it rather than typed on the unit. Two codes number
            # independently, so a page that could not tell which body of law a
            # canon 1012 belongs to would gather two different canons into one.
            "line": history["stations"][0]["line"],
        }
        chain = chain_of(groups, history["mass"], vocab)
        if chain:
            row["divisions"] = chain
        index.append(row)
    write_json(root / slice_id / "units.json", {
        "slice": slice_id,
        "units": index,
        # The containers themselves, so a reader of the index can be shown
        # `Liber VII` and its subject rather than a slug. Written beside the
        # units because the index is the one file a lookup always costs.
        vocab.group_table: [
            {
                vocab.group_word: group_id,
                **{field: group.get(field, "") for field in vocab.group_fields},
                **({"within": group["within"]} if group.get("within") else {}),
            }
            for group_id, group in sorted(groups.items())
        ],
    })
    return {act_id: sets[act_id]["totals"] for act_id in order}


def held(root: Path) -> list[dict]:
    """The slices that are THERE, read off the map files themselves.

    Not the slices this run built. One `--source` run writes one map file, so a
    manifest naming only what the run produced would drop every other slice the
    reader can open the moment anybody rebuilt one of them -- and a file whose
    whole purpose is to stop the page guessing a slice id must not itself
    advertise a 404. Run into the site's data root it names all three; run into
    an empty directory it names the one that was just written.

    Each row is read out of the map file rather than out of the source, so the
    manifest cannot disagree with the file the page will fetch. A map file is
    admitted only if it says it is one and calls itself by the name it is filed
    under: that is the name the page composes its fragment paths from, so a file
    naming some other slice is not reachable at that path and is not listed.
    """
    listed = []
    for path in sorted(root.glob("*.json")):
        if path.name == MAP_MANIFEST:
            continue
        try:
            payload = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        if not isinstance(payload, dict) or payload.get("schema") != MAP_SCHEMA:
            continue
        if payload.get("slice") != path.stem:
            continue
        listed.append(
            {
                "id": path.stem,
                # Which words the slice keeps its fragments in. A page that
                # cannot read this vocabulary is reading a slice it was not
                # written for, and can say so before fetching anything.
                "vocabulary": payload.get("vocabulary"),
                "stations": len(payload.get("stations") or []),
                "lines": len(payload.get("lines") or []),
            }
        )
    # The landing slice first, then by id. The order is stable and states what
    # it is; nothing reads the landing slice out of it.
    listed.sort(key=lambda entry: (entry["id"] != LANDING_SLICE, entry["id"]))
    return listed


def landing_of(listed: list[dict]) -> str:
    """The declared landing slice, or the first held one where it is not there.

    Derived once and read twice -- into the manifest and into what `structure`
    reports -- because a second copy of this rule is a prediction that the file
    and the transcript will one day disagree about which slice the page opens.
    """
    if any(entry["id"] == LANDING_SLICE for entry in listed):
        return LANDING_SLICE
    return listed[0]["id"] if listed else ""


def write_manifest(root: Path) -> tuple[Path, list[dict]]:
    """Write the manifest naming the held slices and declaring the landing one."""
    listed = held(root)
    target = root / MAP_MANIFEST
    if not listed:
        return target, listed
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        json.dumps(
            {
                # Named, and not merely first. A reader of this file should not
                # have to infer the landing slice from row order, and a page
                # that reads it must not trust that order: sorting is a fact
                # about names and the landing slice is a judgement about which
                # one shows a reader what this map is.
                "default": landing_of(listed),
                "slices": listed,
            },
            ensure_ascii=False,
            sort_keys=True,
            indent=1,
        )
        + "\n",
        encoding="utf-8",
    )
    return target, listed


def structure(data: dict, out: Path) -> dict:
    """Write the browser's map file: the stations in order, whole.

    The map is drawn from this and from nothing else, so every field a reader
    sees on a station is carried here rather than restated in the page. The
    order is the graph's own topological order, which is what lets a drawing
    put a station to the right of the act it descends from without deciding
    anything the history does not already say.

    The spine holds no text. What each act changed, the state it left, and each
    unit's own history are written beside it as fragments and fetched only when
    a reader opens one.

    The manifest is rewritten beside it, naming every slice that is there and
    declaring which one the page opens on, so that no page has to guess a slice
    id and none has to name one in its own source.
    """
    rows = graph(data)["rows"]
    known = {act["id"]: act for act in data["acts"]}
    slice_id = str(data.get("slice"))
    root = out / "structure" / "act-history"
    totals = fragments(data, root, slice_id)
    stations = []
    for row in rows:
        act = known[row["act"]]
        stations.append(
            {
                "id": act["id"],
                "line": act["line"],
                "date": str(act["date"]),
                "date_precision": precision_of(str(act["date"])),
                "kind": act.get("kind"),
                "title": act.get("title"),
                "authority": act.get("authority"),
                "instrument": act.get("instrument"),
                "parents": list(act.get("parents") or []),
                "via_unrepresented": list(act.get("via_unrepresented") or []),
                "departures": row["departures"],
                "changed": totals[act["id"]],
                # Added, never substituted. A map that drew a printing and a
                # promulgation the same way would show a reader a weaker claim
                # wearing a stronger one's clothes.
                "station_kind": act.get("station_kind"),
                "parent_kind": act.get("parent_kind"),
                "printing": act.get("printing"),
                "same_instrument_as": act.get("same_instrument_as"),
                "act_citation": act.get("act_citation"),
                "citation": act.get("citation"),
                "effect": act.get("effect"),
                "effect_established": bool(act.get("effect_established")),
                "amended": bool(act.get("amends")),
                # Derived once, here, and read rather than rebuilt. Both are
                # relative to structure/act-history/.
                "station_path": f"{slice_id}/station/{sorted_name(str(act['date']), act['id'])}.json",
                "state_path": f"{slice_id}/state/{sorted_name(str(act['date']), act['id'])}.json",
            }
        )
    vocab = vocabulary_of(data)
    payload = {
        "schema": MAP_SCHEMA,
        "slice": slice_id,
        # Declared, so a page reads the fragments in the words the slice keeps
        # them in rather than assuming a missal. `group_key` is the key a state
        # fragment's containers stand under and `unit_word` is what one unit is
        # called; a page that finds neither is reading a slice it was not
        # written for and should say so instead of drawing an empty map.
        "vocabulary": vocab.name,
        "group_key": vocab.group_table,
        "group_word": vocab.group_word,
        "unit_word": vocab.unit_word,
        "extent": data.get("extent"),
        "lines": data.get("lines"),
        "stations": stations,
        # Derived from the act graph, never typed. `commonality` proves the same
        # derivation against `git merge-base` on the emitted repository.
        "commonality": shared_bases(data),
        "extends_chain": data.get("extends_chain", []),
    }
    target = root / f"{slice_id}.json"
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(
        json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n",
        encoding="utf-8",
    )
    manifest, listed = write_manifest(root)
    return {
        "stations": len(stations),
        "lines": len(payload["lines"] or []),
        "written": str(target),
        "manifest": str(manifest),
        "slices": [entry["id"] for entry in listed],
        "default": landing_of(listed),
    }


# --- The printed map's source ------------------------------------------------
#
# guidance/time-machine.md section 9 settled the route and this verb only walks
# it. Octilinear layout is NP-complete (Nollenburg 2005, from Planar 3-SAT) and
# the 2011 exact formulation takes ten hours on London, so nothing here writes a
# layout algorithm. LOOM's `octi` implements the 2020 grid-routing
# approximation -- London in 2.7 seconds, within 7.3 per cent of optimal -- and
# it reads a DOT file whose nodes carry `pos="x,y"` as plain Cartesian doubles.
# So an abstract graph needs no geography at all: emit x = date and y =
# tradition lane, and let `octi` octilinearise it.
#
# What this verb emits is therefore the SOURCE of the printed map and not the
# map. `octi` is not installed on this machine and is neither installed nor
# vendored by this repository, so the SVG step is not run here; the command a
# reader runs is in the file's own header and in guidance/act-histories.md. A
# DOT a reader can render is a deliverable. A step that silently did nothing
# would not be.
#
# Rule 5 is why this is a verb here rather than a second tool: the interactive
# map, the git repository and the plate come off one generator, because a second
# generator is a restatement and restatements drift.
#
# THE ONE CHOICE section 9 SAYS MUST BE MADE EXPLICITLY. Strict octilinearity
# and strictly time-proportional edge length cannot both hold -- a 45-degree
# edge's x-extent is length over root two -- and no published diagram is both.
# This picks: the x axis is monotone in date and NOT proportional to it. Between
# consecutive distinct dates the abscissa advances by the elapsed time, clamped
# to a floor and a ceiling. That is Beck's own distortion, stated rather than
# stumbled into, and it is what makes section 3's requirement readable: four
# centuries and four years must both read, so the widest gap on the plate is
# sixteen times the narrowest and not thirty-eight thousand times it.
#
# NOTHING HERE READS A CLOCK. Section 9 wants an edition stamp on the plate, and
# an edition stamp is the release's, never the build machine's: a `Date.now()`
# in this file would put a different byte in the artifact every run and destroy
# the reproducibility Rule 5 asks for.

# Units of the abscissa per elapsed year, and the floor and ceiling it is
# clamped between. The floor keeps two acts a day apart -- 1960-07-25 and
# 1960-07-26 are both here -- from landing on one point; the ceiling keeps the
# 268 years between 1634 and 1902 from pushing everything else off the sheet.
YEAR_UNIT = 4
MIN_STEP = 25
MAX_STEP = 400

# Between one tradition's lane and the next. Four times the floor, so a station
# is nearer the one before it on its own line than the line beside it.
LANE_SEPARATION = 100

# Days in the mean Gregorian year, as an exact ratio. The abscissa is computed
# in integers throughout so that the same input gives the same bytes on any
# machine, rather than the same bytes on this one.
GREGORIAN_YEAR_DAYS = 3652425
GREGORIAN_YEAR_SCALE = 10000

PLATE_SCHEMA = "triptych-act-plate/v1"

# What a reader runs on the emitted file. Recorded as ONE string read into the
# header, the transcript and the guidance, because three copies of a command
# line is three chances to document a pipeline nobody can run.
OCTILINEARISE = "octi < {path} | transitmap > {stem}.svg"

# The release this record stands in, and the page this sheet is the printed twin
# of. Both are read rather than typed: the release identity is the release
# record's own, and the origin belongs to the tool that publishes to it, which
# the release-binding checker loads for the same reason.
RELEASE_RECORD = ROOT / "release" / "public-alpha.json"
PUBLIC_ALPHA = ROOT / "tools" / "public-alpha"
WEB_BROWSER = ROOT / "src" / "web" / "browser"
TWIN_PAGE = WEB_BROWSER / "history" / "index.html"


# --- The monochrome grammar ---------------------------------------------------
#
# guidance/time-machine.md section 9, measured from the plate: Transport for
# London publishes an official black-and-white Tube map distinguishing
# TWENTY-TWO services with no colour at all, and the grammar is copyable --
# constant band width for every line, so weight stays free for another
# dimension; the differentiation is the band's INTERNAL TEXTURE plus THREE GREY
# VALUES; and it is paid for with 2.4 times more repeated inline naming.
#
# WHAT THIS SEPARATES, AND IT IS NOT SEVENTEEN BY DASHES. Six textures times
# three greys is EIGHTEEN lines, which is where `latin-missal`'s seventeen fit.
# The DASH CHANNEL ALONE SEPARATES SIX, and it is the channel that survives a
# photocopy; the grey channel is the rest of the way to eighteen and needs the
# sheet printed rather than copied. Past eighteen the pairs repeat, and the file
# names which lines share one rather than claiming a distinction it does not
# draw.
#
# Six is the engineering draughtsman's own set and is chosen for that: it is the
# largest set of dash patterns with a name apiece that a reader can hold.
#
# The dash lengths are SVG `stroke-dasharray` values at the nominal band width
# below; a renderer that scales the band scales them with it.
NOMINAL_BAND = "2"
TEXTURES = (
    ("solid", ""),
    ("long-dash", "8 3"),
    ("short-dash", "3 3"),
    ("dotted", "0.5 2.5"),
    ("dash-dot", "8 2.5 0.5 2.5"),
    ("dash-dot-dot", "8 2.5 0.5 2.5 0.5 2.5"),
)
GREYS = (
    ("black", "#000000", "100"),
    ("mid-grey", "#595959", "65"),
    ("light-grey", "#8c8c8c", "45"),
)
DISTINGUISHED = len(TEXTURES) * len(GREYS)

# The width channel is the one section 9's constant band leaves free, and what
# an edge here has left to say is what the descent rests on. Three tiers over
# the five declared `parent_kind` values, because five widths inside one band
# are not tellable apart in print and a grammar that claims five separates
# three; the exact kind stays on the edge in `descent` for a reader who needs
# it. Ordered strongest first, and the order is PARENT_KINDS' own.
DESCENT_TIERS = (
    ("stated", "3", ("act-states-it", "book-states-it"),
     "an instrument's own text, or the book's own title page, draws the edge"),
    ("attributed", "2", ("attributed",),
     "a scholarly attribution draws it, cited to its source"),
    ("sequence", "1", ("use-continuity", "line-order"),
     "nothing draws it: two books declare one use, or two acts stand in this order"),
)


def monochrome(lanes: dict[str, int]) -> dict[str, dict[str, str]]:
    """A texture and a grey for every line, keyed to the lane and to nothing else.

    The texture turns over fastest, so two lines sharing a texture stand at
    least six lanes apart -- and lanes are adjacent exactly where the traditions
    were drawn adjacent, which is where a reader has to tell two bands apart
    while following one across a crossing.

    Keyed to the derived lane rather than to the line's name, so the grammar
    moves with the drawing and an editorial rename does not restripe the sheet.
    """
    keyed: dict[str, dict[str, str]] = {}
    for line, lane in sorted(lanes.items(), key=lambda pair: pair[1]):
        texture, dasharray = TEXTURES[lane % len(TEXTURES)]
        grey, colour, _ = GREYS[(lane // len(TEXTURES)) % len(GREYS)]
        keyed[line] = {
            "texture": texture,
            "dasharray": dasharray,
            "grey": grey,
            "colour": colour,
        }
    return keyed


def sharing_a_key(keyed: dict[str, dict[str, str]]) -> list[str]:
    """The lines that share another line's texture and grey, named.

    Empty below eighteen lines. Above it the pairs repeat, and a plate that said
    nothing would be claiming to separate what it draws identically.
    """
    seen: dict[tuple[str, str], str] = {}
    shared: list[str] = []
    for line, key in keyed.items():
        pair = (key["texture"], key["grey"])
        if pair in seen:
            shared.append(f"{line} = {seen[pair]}")
        else:
            seen[pair] = line
    return shared


def descent_tier(kind: str) -> tuple[str, str]:
    """A `parent_kind` to the width tier that draws it, or nothing."""
    for name, width, kinds, _ in DESCENT_TIERS:
        if kind in kinds:
            return name, width
    return "", ""


# --- The apparatus ------------------------------------------------------------
#
# Section 9: the ICS chronostratigraphic chart carries ON THE PLATE a notation
# legend, an epistemic marker defined, a status disclaimer, the provenance of
# the data WITH ITS EXCEPTIONS NAMED, an edition stamp, a version-pinned URL and
# a "To cite:" line -- and for a derived artifact that must match its
# interactive twin at a stated moment, the pinned URL and the edition stamp are
# the highest-value lines on the sheet.
#
# What to reject is Priestley: he refused per-item citation as "endless" and
# gave a global bibliography instead, and that refusal is precisely what
# separates an infographic from scholarship. Rule 1 already gives every station
# an instrument, so the stations cite themselves and the sheet cites the sheet.
#
# ALL OF IT IS COMPUTED. A legend typed beside the emitter would drift from it
# the first time a texture moved, and every count here is the count the file
# itself carries.


def release_identity() -> str:
    """The release this record stands in, from the release record's own id.

    The edition stamp is the RELEASE's and never the build machine's. Nothing
    here reads a clock: a `Date.now()` in this file would put a different byte
    in the artifact every run and destroy the reproducibility Rule 5 asks for.
    Absent or unreadable, the stamp says so rather than inventing a date.
    """
    try:
        payload = json.loads(RELEASE_RECORD.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return ""
    identity = payload.get("release_id") if isinstance(payload, dict) else None
    return identity if isinstance(identity, str) else ""


def site() -> tuple[str, str]:
    """The published origin and the site's name, asked of the tool that owns them.

    tools/public-alpha declares the one origin the site is reached at, and
    the release-binding checker already loads it rather than copying it. A second
    copy of an origin is a second chance to print a URL nobody can follow.
    """
    loader = importlib.machinery.SourceFileLoader("triptych_public_alpha", str(PUBLIC_ALPHA))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        return "", ""
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
        origin = module.SITE_ORIGIN
        name = module.SITE_NAME
    except Exception:  # the renderer owns the origin; an unreadable one is no origin
        return "", ""
    return (origin if isinstance(origin, str) else ""), (name if isinstance(name, str) else "")


def twin_url(origin: str, slice_id: str) -> str:
    """Where the interactive twin of this sheet is published, or nothing.

    Derived from the page that is actually there: the site serves a reading
    directory's pages at `<directory>/<page>`, and a URL composed for a page
    this repository does not hold would be an apparatus line that 404s.
    """
    if not origin or not TWIN_PAGE.is_file():
        return ""
    return f"{origin}/{TWIN_PAGE.relative_to(WEB_BROWSER).as_posix()}?slice={slice_id}"


def digests(data: dict) -> list[tuple[str, str]]:
    """Every file the slice was read from, with its SHA-256. This is the pin.

    A version-pinned URL is what section 9 asks for and what a one-edition site
    cannot give: the origin serves whatever was published last. So the pin is
    the record's own, and it is checkable with `sha256sum` against the files
    named -- which is a stronger pin than a URL, because it names the bytes.
    """
    pinned: list[tuple[str, str]] = []
    for path in (Path(name) for name in data.get("source_files") or []):
        try:
            digest = hashlib.sha256(path.read_bytes()).hexdigest()
        except OSError:
            digest = "unreadable"
        try:
            shown = path.resolve().relative_to(ROOT).as_posix()
        except ValueError:
            shown = path.name
        pinned.append((shown, digest))
    return pinned


def tallied(counts: dict[str, int], order: tuple[str, ...]) -> str:
    """`kind N, kind N` in a declared order, and only what is there."""
    return ", ".join(f"{kind} {counts[kind]}" for kind in order if counts.get(kind))


def counted(number: int, singular: str) -> str:
    """`1 station`, `26 stations`. An apparatus reading "1 stations" was typed."""
    return f"{number} {singular}" + ("" if number == 1 else "s")


# The marker section 9 asks to be DEFINED on the plate, and the ICS chart's own.
# It rides on the station rather than being left for the labeller to re-derive,
# so the sheet and the file cannot disagree about which dates are approximate.
APPROXIMATE = "~"


def day_number(date: str) -> int:
    """The date as a day count, at the precision the record actually has.

    A year-only date is its first day. That is a reading of an imprecise date
    and not an invented one: it fixes where the station sits on the axis, and
    the true string rides on the node as `date` with its `date_precision` so
    the labeller prints `1497` and never `1497-01-01`.
    """
    year, month, day = date_parts(date)
    return days_from_civil(year, month, day)


def abscissa(dates: list[str]) -> dict[str, int]:
    """Distinct dates to x, monotone in time and clamped at both ends.

    Every distinct date gets a distinct x, so two acts of one week are two
    stations rather than one blot; and the clamp is the explicit answer to
    section 9's "strict octilinearity and strict proportionality cannot both
    hold". Driven only by the sorted set of dates, so it is the same map of
    dates to positions whatever order the acts arrive in.
    """
    positions: dict[str, int] = {}
    x = 0
    previous: str | None = None
    for date in sorted(set(dates), key=lambda value: (day_number(value), value)):
        if previous is not None:
            elapsed = day_number(date) - day_number(previous)
            step = elapsed * YEAR_UNIT * GREGORIAN_YEAR_SCALE // GREGORIAN_YEAR_DAYS
            x += min(MAX_STEP, max(MIN_STEP, step))
        positions[date] = x
        previous = date
    return positions


def line_openings(acts: dict[str, dict]) -> dict[str, str]:
    """Each line's earliest station, by date and then by id.

    The line's opening, never a declared first act: a line whose own descent is
    broken has several heads and no single beginning, which is the honest
    pre-Tridentine shape, and picking the earliest station states only when the
    tradition enters this record.
    """
    openings: dict[str, str] = {}
    for act_id in sorted(acts):
        line = acts[act_id]["line"]
        standing = openings.get(line)
        if standing is None or (str(acts[act_id]["date"]), act_id) < (
            str(acts[standing]["date"]),
            standing,
        ):
            openings[line] = act_id
    return openings


def tradition_lanes(acts: dict[str, dict]) -> dict[str, int]:
    """Each line to its lane on the y axis, DERIVED and never curated.

    The declared order of the `lines` table is an editorial arrangement and
    Rule 3 will not have one deciding a drawing. So the order is walked out of
    the graph: a line's lane follows the line it was born from, because the
    fork edge is the one edge that leaves a lane and a long one would read as
    a relation rather than as an accident of ordering. Roots come in the order
    they enter the record, and so do a line's children.

    Only an ordering. `octi` moves everything; what this fixes is which
    traditions start adjacent, which is what it can usefully be told.
    """
    openings = line_openings(acts)
    born_from: dict[str, str | None] = {}
    for line, opening in openings.items():
        elsewhere = sorted(
            (parent for parent in acts[opening].get("parents", []) if acts[parent]["line"] != line),
            key=lambda parent: (str(acts[parent]["date"]), parent),
        )
        born_from[line] = acts[elsewhere[0]]["line"] if elsewhere else None
    children: dict[str, list[str]] = {}
    for line, parent_line in born_from.items():
        if parent_line is not None and parent_line != line:
            children.setdefault(parent_line, []).append(line)

    def entered(line: str) -> tuple[str, str]:
        return (str(acts[openings[line]]["date"]), line)

    walked: list[str] = []
    seen: set[str] = set()

    def walk(line: str) -> None:
        if line in seen:
            return
        seen.add(line)
        walked.append(line)
        for child in sorted(children.get(line, []), key=entered):
            walk(child)

    for line in sorted((name for name, parent in born_from.items() if parent is None), key=entered):
        walk(line)
    # Anything a cycle in the birth relation left unwalked. It cannot arise from
    # a valid slice, since a line is born at an earlier act, but a lane map that
    # silently dropped a tradition would drop it from the plate.
    for line in sorted(born_from, key=entered):
        walk(line)
    return {line: index for index, line in enumerate(walked)}


def dot_string(value: object) -> str:
    """A DOT quoted string. Whitespace is collapsed: TOML prose arrives wrapped."""
    text = " ".join(str(value).split())
    return '"' + text.replace("\\", "\\\\").replace('"', '\\"') + '"'


def attributes(pairs: list[tuple[str, object]]) -> str:
    """A DOT attribute list. An empty value writes no attribute at all.

    So `terminus` stands on the stations that are one and is absent from the
    rest, rather than every node carrying a `terminus="false"` a reader has to
    filter. Absence is the negative here, and it is the same convention the
    fragments use.
    """
    return "[" + ", ".join(f"{name}={dot_string(value)}" for name, value in pairs if value != "") + "]"


def apparatus(
    data: dict,
    slice_id: str,
    rows: list[dict],
    acts: dict[str, dict],
    keyed: dict[str, dict[str, str]],
    counts: dict[str, int],
    tiers: dict[str, int],
) -> list[tuple[str, list[str]]]:
    """Section 9's apparatus, computed from the slice and never typed.

    Returned as (key, lines) so that one computation is written twice and
    restated never: into the file's header, where a person reads it, and into
    the graph's own attributes, where the labelling pass that places it on the
    sheet will read it off the graph it is labelling.
    """
    witnesses = data.get("witnesses") or []
    units = data.get("units") or []
    readings: dict[str, dict[str, int]] = {}
    for what, holders in (("acts", acts.values()), ("witnesses", witnesses), ("units", units)):
        held: dict[str, int] = {}
        for row in holders:
            held[str(row.get("read_from"))] = held.get(str(row.get("read_from")), 0) + 1
        readings[what] = held

    citation_kinds: dict[str, int] = {}
    approximate = 0
    unestablished = 0
    for act in acts.values():
        kind = str(act.get("act_citation"))
        citation_kinds[kind] = citation_kinds.get(kind, 0) + 1
        if precision_of(str(act.get("date"))) != "day":
            approximate += 1
        if not act.get("effect_established"):
            unestablished += 1
    through_unrepresented = sum(1 for row in rows for _ in row.get("via_unrepresented") or [])
    kinds: dict[str, int] = {}
    for row in rows:
        kind = str(acts[row["act"]].get("parent_kind") or "")
        for _ in row["parents"]:
            kinds[kind] = kinds.get(kind, 0) + 1

    release = release_identity()
    origin, site_name = site()
    url = twin_url(origin, slice_id)
    recorded = str(data.get("recorded_on") or "")
    pinned = digests(data)
    stations = counts["stations"]
    lines = counts["lines"]

    edition = [
        f"Release {release}." if release
        else f"No release identity: {RELEASE_RECORD.relative_to(ROOT).as_posix()} could not be read.",
        f"Slice {slice_id}, recorded {recorded} by the record itself." if recorded
        else f"Slice {slice_id}, which declares no `recorded_on`; the digests below are the whole pin.",
        f"acts_schema {SCHEMA_VERSION}; {PLATE_SCHEMA}.",
        "No clock was read to write this: the stamp is the release's, and the same"
        " source gives the same bytes.",
    ]

    vocab = vocabulary_of(data)
    provenance = [
        f"A {data.get('record_type') or 'record of acts'} in the {vocab.name} vocabulary,"
        f" read from these files and pinned by their SHA-256:",
        *(f"{path}  sha256 {digest}" for path, digest in pinned),
        f"{stations} stations on {lines} lines, {counts['edges']} edges,"
        f" {len(witnesses)} witnesses, {len(units)} base {vocab.unit_plural}.",
        *(
            [f"Acts read from: {tallied(readings['acts'], READINGS)}."]
            if any(readings["acts"].get(kind) for kind in READINGS) else []
        ),
        *(
            [f"Witnesses read from: {tallied(readings['witnesses'], READINGS)}."]
            if any(readings["witnesses"].get(kind) for kind in READINGS) else []
        ),
    ]

    # Named, and counted, and only where there are any. An exception nobody
    # states is a claim the sheet makes silently.
    exceptions = []
    if counts["printed"]:
        exceptions.append(
            f"{counts['printed']} of {stations} stations claim NO ACT AT ALL"
            " (station_kind=printed): a book survives, no instrument is claimed, and the"
            " station is the weaker claim wherever it appears."
        )
    if citation_kinds.get("not-found"):
        exceptions.append(
            counted(citation_kinds["not-found"], "station")
            + " whose instrument is believed to exist and was not found in the corpus"
            " searched; each names what was searched."
        )
    if counts["roots"]:
        exceptions.append(
            f"Stations beginning a line with NO RECORDED DESCENT: {counts['roots']}."
            " Where the corpus holds no earlier act the branch is a root, and the"
            " emptiness is the record rather than a gap in it."
        )
    if tiers.get("sequence"):
        exceptions.append(
            counted(tiers["sequence"], "edge")
            + " rest on NOTHING BUT ORDER ("
            + tallied(kinds, ("use-continuity", "line-order"))
            + "): two books declare one use, or two acts stand on one line in this order"
            " and neither names the other. They are drawn at the lightest width."
        )
    if tiers.get("attributed"):
        exceptions.append(
            counted(tiers["attributed"], "edge")
            + " rest on a scholarly attribution rather than on an act's own words."
        )
    if through_unrepresented:
        exceptions.append(
            "Descents passing through acts this record does not carry:"
            f" {through_unrepresented}. The edge names them in `via_unrepresented` and is"
            " drawn straight, because a station this record cannot cite is not a station."
        )
    for what, word in (("acts", "acts"), ("witnesses", "witnesses"), ("units", vocab.unit_plural)):
        weak = tallied(readings[what], ("ocr-only", "not-read"))
        if weak:
            exceptions.append(f"Read no better than this: {word} {weak}.")
    withheld = sum(1 for unit in units if unit.get("withheld"))
    if withheld:
        exceptions.append(
            counted(withheld, vocab.unit_word)
            + " whose text is withheld here. That is a rights position and not ignorance."
        )
    if unestablished:
        exceptions.append(
            counted(unestablished, "act")
            + " whose effect this record does not claim was established. What an act"
            " CHANGED is a historical judgement and is contested for some of them; the"
            " station stands on the act and never on the judgement."
        )
    if not exceptions:
        exceptions.append("None: every station cites an instrument and every edge cites its basis.")

    epistemic = [
        f"{APPROXIMATE} before a date means the record holds only the year or the month."
        " The station carries the mark itself, in `approximate`, rather than leaving a"
        " labeller to work out again which dates are approximate.",
        (
            f"{approximate} of {stations} stations carry it. Such a station is PLACED on"
            " the first day it could be, and the true string rides on the node as `date`"
            " with `date_precision` beside it, so a label reads 1497 and never 1497-01-01."
            if approximate else
            f"No station here carries it: all {stations} dates are days."
        ),
        "Nothing else on this sheet is an uncertainty mark. What a descent rests on is the"
        " width channel, defined under GRAMMAR.",
    ]

    legend = [
        "A station is an act. A band is a line, and a line is a tradition.",
        f"role: root {counts['roots']}, through {counts['through']},"
        f" interchange {counts['interchanges']}. An interchange is a DOCUMENTED RECEPTION"
        " -- two edges of one line arriving at one station -- and is the only place a"
        " reader may change trains.",
        f"terminus {counts['termini']}: nothing in this record descends from it."
        + (
            f" Lines that are one station and nothing more: {counts['alone']}, each a"
            " tradition that begins and ends inside this record."
            if counts["alone"] else ""
        ),
        f"station_kind: promulgated {counts['promulgated']}, printed {counts['printed']}.",
        f"fork {counts['forks']}: a line is BORN at a station of another line. It is the"
        " one edge that leaves a lane, and it is a birth and never a rejoining -- lines"
        " here never rejoin.",
        "Descent carries no arrowhead. x is monotone in date, so direction is read off the"
        " axis, which is how stemmatology draws descent for the same reason.",
    ]

    shared = sharing_a_key(keyed)
    grammar = [
        "Monochrome, after Transport for London's black-and-white plate, which separates"
        " 22 services with no colour at all: constant band width for identity,"
        " differentiation by the band's internal texture and three grey values.",
        f"{len(TEXTURES)} textures x {len(GREYS)} greys = {DISTINGUISHED} lines separated."
        f" This slice has {lines}.",
        f"THE DASH CHANNEL ALONE SEPARATES {len(TEXTURES)}, and it is the channel that"
        " survives a photocopy. The greys carry the rest of the way and need the sheet"
        " printed rather than copied. The texture turns over fastest, so two lines sharing"
        f" one stand at least {len(TEXTURES)} lanes apart.",
        (
            "Past that the pairs repeat, and these lines are drawn identically: "
            + "; ".join(shared) + "."
        ) if shared else
        f"No two lines here are drawn alike; above {DISTINGUISHED} lines the pairs would"
        " repeat and this line would name which.",
        "Width is the channel the constant band leaves free, and it carries what the"
        " descent rests on: "
        + "; ".join(
            f"{name} {width} ({explanation}, {tiers.get(name, 0)} edges)"
            for name, width, _, explanation in DESCENT_TIERS
        )
        + ". Three tiers over five declared kinds, because five widths inside one band are"
        " not tellable apart; the exact kind stays on the edge in `descent`.",
        "The three greys, as ink: "
        + ", ".join(f"{grey} {colour} at {black} per cent black" for grey, colour, black in GREYS)
        + f". Dash lengths are SVG stroke-dasharray values at the nominal band width of"
        f" {NOMINAL_BAND}; a renderer that scales the band scales them with it.",
    ]

    citation = [
        "To cite: "
        + ", ".join(
            part for part in (
                site_name,
                f"act history of the {slice_id} slice",
                f"{release} edition" if release else "",
                f"recorded {recorded}" if recorded else "",
            ) if part
        )
        + ". " + (url or "Unpublished; cite the files and digests under PROVENANCE."),
        "PER STATION, cite the act. Every station carries its own `instrument`,"
        " `authority`, `citation` and `act_citation`, so no reader is sent to a global"
        " bibliography for a single claim -- which is the one thing to reject in"
        " Priestley, who called per-item citation endless and gave one instead.",
    ]

    twin = [
        (f"{url} is the interactive twin, drawn from the same generator and the same slice.")
        if url else
        "The interactive twin is not published from this checkout, so no URL is given"
        " rather than one that cannot be followed.",
        "The site serves ONE edition at a time, so the pin is not in the URL: it is the"
        " digests under PROVENANCE, which `sha256sum` checks against the files named. A"
        " reader who follows the URL later and finds other digests is reading a later"
        " edition, and that is what the pin is for.",
    ]

    unmarked = [
        "This file is the SOURCE of a printed map and not the map. `octi` was not run"
        " here; the command that runs it is above.",
        "NO LABEL IS PLACED. Labelling, not layout, is where automation still fails, and"
        " neither octi nor TikZ will do it. Every node carries what a label must say and"
        " nothing here places one.",
        "A CROSSING IS NOT MARKED. Two bands crossing with no station between them means"
        " the lines meet nowhere, and no published metro map has a grammar separating that"
        " from an interchange. This sheet does not invent one and claims no"
        " conventionality for the one it will need.",
        f"NO SHEET SIZE IS SET. This is {stations} stations, and the measurement is 40 on"
        " A3, 100 on A2, 200 on A1, with 15 to 25 per cent of the sheet reserved for the"
        " key. Which one to print is a layout decision and not a generator's.",
    ]

    return [
        ("edition", edition),
        ("provenance", provenance),
        ("exceptions", exceptions),
        ("epistemic", epistemic),
        ("legend", legend),
        ("grammar", grammar),
        ("url", twin),
        ("cite", citation),
        ("unmarked", unmarked),
    ]


def plate(data: dict, out: Path) -> dict:
    """Write the printed map's DOT: stations at (date, lane), edges by line.

    The topology IS the content, so it is carried and not summarised. Parallel
    traditions are parallel lanes. An edge takes the line of the station it
    arrives at, which makes a fork the one place a line touches another's
    station -- the interchange of Rule 2 -- and leaves every other crossing
    exactly what section 6 says no published metro map has a grammar for: two
    lines that meet nowhere. There is no merge edge across lines to draw,
    because `check` refuses one.

    Undirected, with the parent always written on the left. Descent is read off
    the axis, since x is monotone in date, and stemmatology draws descent
    without arrowheads for the same reason. It also keeps the file the shape a
    transit layouter expects.

    Labelling is not done here and cannot be: section 9 found that labelling,
    not layout, is where automation still fails, and neither `octi` nor TikZ
    will do it. Every node therefore carries what a label must say -- the title,
    the authority, the instrument, the date at its true precision -- so the
    labelling pass reads the graph it is labelling rather than a second copy of
    the slice.
    """
    rows = graph(data)["rows"]
    acts = indexed(data.get("acts", []), "id", "acts")
    slice_id = str(data.get("slice"))
    lanes = tradition_lanes(acts)
    positions = abscissa([str(row["date"]) for row in rows])
    descended_from: dict[str, int] = {}
    for row in rows:
        for parent in row["parents"]:
            descended_from[parent] = descended_from.get(parent, 0) + 1
    on_line: dict[str, int] = {}
    for row in rows:
        on_line[row["line"]] = on_line.get(row["line"], 0) + 1

    keyed = monochrome(lanes)

    nodes: list[str] = []
    edges: list[str] = []
    roots = 0
    interchanges = 0
    termini = 0
    forks = 0
    printed = 0
    tiers: dict[str, int] = {}
    for row in rows:
        act = acts[row["act"]]
        date = str(row["date"])
        parents = list(row["parents"])
        # A station with two parents is a documented reception, which is the one
        # thing Rule 2 lets a line join at, and `check` refuses one that cites
        # nothing. A station nothing descends from is a terminus: a use that
        # ended, and on five lines here a use that is a terminus and a root at
        # once, which is the emptiness the record is making visible.
        terminus = row["act"] not in descended_from
        role = "interchange" if len(parents) > 1 else "root" if not parents else "through"
        if not parents:
            roots += 1
        if len(parents) > 1:
            interchanges += 1
        if terminus:
            termini += 1
        if (act.get("station_kind") or "promulgated") == "printed":
            printed += 1
        key = keyed[row["line"]]
        nodes.append(
            "  "
            + dot_string(row["act"])
            + " "
            + attributes(
                [
                    ("pos", f"{positions[date]},{lanes[row['line']] * LANE_SEPARATION}"),
                    # The act's id, written out rather than left to DOT's
                    # default, because a layouter that carries the label
                    # through must find one to carry. What a reader is shown
                    # is composed by the labelling pass from the fields below.
                    ("label", row["act"]),
                    ("line", row["line"]),
                    ("lane", lanes[row["line"]]),
                    ("date", date),
                    ("date_precision", precision_of(date)),
                    # Section 9's epistemic marker, ON the station. A date the
                    # record holds only to the year is placed on the first day
                    # it could be, and this is what says so.
                    ("approximate", APPROXIMATE if precision_of(date) != "day" else ""),
                    ("station_kind", act.get("station_kind") or "promulgated"),
                    ("role", role),
                    ("terminus", "true" if terminus else ""),
                    ("act_citation", act.get("act_citation") or ""),
                    ("title", act.get("title") or ""),
                    ("authority", act.get("authority") or ""),
                    ("instrument", act.get("instrument") or ""),
                    # The line's own key, carried on the station too. Five lines
                    # here are one station and have no band at all, and a key
                    # that lived only on the edges would leave them unkeyed.
                    ("texture", key["texture"]),
                    ("grey", key["grey"]),
                    ("color", key["colour"]),
                ]
            )
            + ";"
        )
        for parent in parents:
            # The band is the line's identity and says nothing about strength;
            # the width says what the descent rests on and nothing about which
            # line it is. Two channels, one for each question, which is what
            # keeps the uncertainty grammar off the channel identity uses.
            strength, width = descent_tier(str(act.get("parent_kind") or ""))
            tiers[strength] = tiers.get(strength, 0) + 1
            if acts[parent]["line"] != row["line"]:
                forks += 1
            edges.append(
                "  "
                + dot_string(parent)
                + " -- "
                + dot_string(row["act"])
                + " "
                + attributes(
                    [
                        ("line", row["line"]),
                        # What the edge rests on, carried so the plate can draw
                        # a weak descent as a weak one.
                        ("descent", act.get("parent_kind") or ""),
                        ("strength", strength),
                        ("penwidth", width),
                        ("texture", key["texture"]),
                        ("dasharray", key["dasharray"]),
                        ("grey", key["grey"]),
                        ("color", key["colour"]),
                        ("fork", "true" if acts[parent]["line"] != row["line"] else ""),
                        (
                            "via_unrepresented",
                            ",".join(row.get("via_unrepresented") or []),
                        ),
                    ]
                )
                + ";"
            )

    single = sorted(line for line, count in on_line.items() if count == 1)
    counts = {
        "stations": len(rows),
        "lines": len(lanes),
        "edges": len(edges),
        "roots": roots,
        "through": len(rows) - roots - interchanges,
        "interchanges": interchanges,
        "termini": termini,
        "forks": forks,
        "printed": printed,
        "promulgated": len(rows) - printed,
        "alone": len(single),
    }
    block = apparatus(data, slice_id, rows, acts, keyed, counts, tiers)
    target = out / f"{slice_id}.dot"
    labels = {str(line.get("id")): str(line.get("label") or "") for line in (data.get("lines") or [])}
    header = [
        f"// {PLATE_SCHEMA}",
        f"// Written by tools/act-history plate from {slice_id}. Do not edit: Rule 5 of",
        "// guidance/time-machine.md forbids a hand-tweak, because a tweak is a",
        "// restatement and restatements drift.",
        "//",
        f"// stations {len(rows)}, lines {len(lanes)}, roots {roots}, termini {termini},",
        f"// interchanges {interchanges}, single-station lines {len(single)}.",
        "//",
        "// x is monotone in date and NOT proportional to it: the step between",
        f"// consecutive dates is {YEAR_UNIT} units a year clamped to [{MIN_STEP}, {MAX_STEP}].",
        f"// y is the tradition lane, {LANE_SEPARATION} apart, ordered by descent from the",
        "// line each was born from.",
        "//",
        "// To octilinearise, with LOOM (https://github.com/ad-freiburg/loom), GPL-3.0:",
        f"//   {OCTILINEARISE.format(path=target.name, stem=slice_id)}",
        "// It was NOT run to produce this file: octi is not installed here and this",
        "// repository neither ships nor vendors it.",
        "//",
        "// THE APPARATUS, guidance/time-machine.md section 9. Every line of it is",
        "// computed from the slice, and the graph carries the same text in its own",
        "// attributes so that the pass which places it reads the graph it is placing.",
    ]
    for name, said in block:
        header.append("//")
        header.append(f"// {name.upper()}")
        header.extend(f"//   {text}" for text in said)
    header.extend([
        "//",
        "// THE KEY. A band's texture and grey are its line's, and both are on every",
        "// station and every edge of it.",
        "//",
        "// lane  stations  texture       grey        line              carries",
    ])
    for line, lane in sorted(lanes.items(), key=lambda pair: pair[1]):
        key = keyed[line]
        header.append(
            f"// {lane:>4}  {on_line.get(line, 0):>8}  {key['texture']:<12}  "
            f"{key['grey']:<10}  {line:<16}  {labels.get(line, '')}".rstrip()
        )
    body = [
        f"graph {dot_string(slice_id)} {{",
        "  graph " + attributes([
            ("schema", PLATE_SCHEMA),
            ("slice", slice_id),
            *((name, " ".join(said)) for name, said in block),
        ]) + ";",
        "",
        *nodes,
        "",
        *edges,
        "}",
    ]
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text("\n".join([*header, "", *body]) + "\n", encoding="utf-8")
    return {
        "slice": slice_id,
        "stations": len(rows),
        "lines": len(lanes),
        "edges": len(edges),
        "roots": roots,
        "termini": termini,
        "interchanges": interchanges,
        "single_station_lines": single,
        "forks": forks,
        "descent_tiers": tiers,
        "apparatus": dict(block),
        # What the grammar separates, said in the report as well as on the
        # plate, because a claim of seventeen where six are distinguishable is
        # the failure this is measured to avoid.
        "textures": len(TEXTURES),
        "greys": len(GREYS),
        "distinguished": DISTINGUISHED,
        "sharing_a_key": sharing_a_key(keyed),
        "written": str(target),
        "octilinearise": OCTILINEARISE.format(path=str(target), stem=slice_id),
    }


# --- CLI ---------------------------------------------------------------------


def render(payload: object, arguments: argparse.Namespace) -> int:
    assert isinstance(payload, dict)
    if getattr(arguments, "json", False):
        print_json(payload)
        return 0
    verb = arguments.command
    if verb == "check":
        kinds = payload["departure_kinds"]
        print(
            f"ok: {payload['acts']} acts, {payload['lines']} lines, {payload['witnesses']} witnesses, "
            f"{payload['groups']} {payload['group_plural']}, {payload['base_units']} base "
            f"{payload['unit_plural']}, {payload['departures']} departures"
        )
        if payload.get("interpretations"):
            print(f"authentic interpretations: {payload['interpretations']}")
        if payload.get("withheld_units"):
            print(f"{payload['unit_word']}s whose text is withheld: {payload['withheld_units']}")
        print("stations: " + ", ".join(f"{kind} {count}" for kind, count in sorted(payload["station_kinds"].items()))
              + f"; {len(payload['roots'])} roots")
        if payload["edge_kinds"]:
            print("edges rest on: " + ", ".join(f"{kind} {count}" for kind, count in sorted(payload["edge_kinds"].items())))
        print("departure kinds used: " + (", ".join(f"{kind} {count}" for kind, count in sorted(kinds.items())) or "none"))
    elif verb == "graph":
        for row in payload["rows"]:
            edge = "root" if not row["parents"] else "<- " + ", ".join(row["parents"])
            if row["via_unrepresented"]:
                edge += " (via unrepresented: " + ", ".join(row["via_unrepresented"]) + ")"
            marks = " [" + ",".join(row["departures"]) + "]" if row["departures"] else ""
            printed = "* " if row.get("station_kind") == "printed" else "  "
            print(f"{printed}{row['line']:<17} {row['act']:<38} {row['date']}  {edge}{marks}")
    elif verb == "structure":
        print(f"{payload['stations']} stations on {payload['lines']} lines")
        print(f"  -> {payload['written']}")
        print(f"  -> {payload['manifest']}")
        print(f"  slices there: {', '.join(payload['slices'])}; opens on {payload['default']}")
    elif verb == "plate":
        print(f"{payload['stations']} stations on {payload['lines']} lines, {payload['edges']} edges")
        print(
            f"  roots {payload['roots']}, termini {payload['termini']}, "
            f"interchanges {payload['interchanges']}, "
            f"single-station lines {len(payload['single_station_lines'])}"
        )
        print(
            f"  monochrome: {payload['textures']} textures x {payload['greys']} greys "
            f"separates {payload['distinguished']} lines"
            + (
                "; drawn alike here: " + ", ".join(payload["sharing_a_key"])
                if payload["sharing_a_key"] else ""
            )
        )
        # What the apparatus carries, and not what it says. The edition stamp
        # names the release, and a release id printed in a captured transcript
        # is a bare sibling tool id in this file, which `tmt check` reads as an
        # undeclared dependency. The stamp belongs on the sheet; the report says
        # the sheet has one.
        print("  apparatus: " + ", ".join(payload["apparatus"]))
        print(f"  -> {payload['written']}")
        print(f"  octilinearise: {payload['octilinearise']}")
    elif verb == "commonality":
        for row in payload["pairs"]:
            base = ", ".join(row["shared_base"]) if row["shared_base"] else "NONE: no act stands behind both"
            print(f"{row['a']} / {row['b']}")
            print(f"  shared base : {base}")
            print(f"  tips        : {row['a_head']} / {row['b_head']}")
            print(
                f"  units       : {len(row['same_text'])} identical, {len(row['differing_text'])} differing, "
                f"{len(row['only_a'])} only in {row['a']}, {len(row['only_b'])} only in {row['b']}"
            )
            for path in row["same_text"][:5]:
                print(f"    = {path}")
    else:
        print(f"wrote {payload['commits']} commits on {len(payload['branches'])} branches to {payload['out']}")
    return 0


def main(argv: list[str] | None = None) -> int:
    parser = examples_live_on_the_verbs(
        argparse.ArgumentParser(prog="act-history", description=__doc__.splitlines()[0]),
        "tools/act-history",
    )
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--source", type=Path, default=DEFAULT_SOURCE)
    shared.add_argument("--json", action="store_true")
    subparsers = parser.add_subparsers(dest="command")
    for verb, help_text in (
        ("check", "validate the act history and its departures"),
        ("graph", "print the act graph in topological order"),
        ("structure", "write the browser's map file and the manifest naming the slices"),
        ("plate", "write the printed map's DOT, for octi to octilinearise"),
        ("commonality", "report what two lines share, by git merge-base"),
        ("emit", "write the Git repository"),
    ):
        sub = subparsers.add_parser(verb, help=help_text, parents=[shared])
        if verb == "emit":
            sub.add_argument("--out", type=Path, default=DEFAULT_OUT)
        if verb == "structure":
            sub.add_argument("--out", type=Path, default=DEFAULT_DATA)
        if verb == "plate":
            sub.add_argument("--out", type=Path, default=DEFAULT_PLATE)
        if verb == "commonality":
            sub.add_argument("lines", nargs="*", metavar="LINE",
                             help="two line ids; omit for every pair")
            sub.add_argument("--repo", type=Path, default=DEFAULT_OUT,
                             help="an emitted repository; written if it is not there")
        with_examples(sub, EXAMPLES[verb])

    def run(arguments: argparse.Namespace) -> object:
        data = load(arguments.source)
        if arguments.command == "check":
            return check(data)
        if arguments.command == "graph":
            return graph(data)
        check(data)
        if arguments.command == "structure":
            return structure(data, arguments.out)
        if arguments.command == "plate":
            return plate(data, arguments.out)
        if arguments.command == "commonality":
            wanted = getattr(arguments, "lines", []) or []
            if len(wanted) not in (0, 2):
                raise Problem("commonality takes two line ids, or none for every pair")
            return commonality(data, arguments.repo, (wanted[0], wanted[1]) if wanted else None)
        return emit(data, arguments.out)

    return run_verb_cli(
        parser=parser,
        handlers={verb: run for verb in ("check", "graph", "structure", "plate", "commonality", "emit")},
        renderer=render,
        prefix="act-history",
        argv=argv,
        default_verb="check",
        mapped_errors={Problem: ("invalid-history", 1)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
