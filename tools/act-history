# --- What a slice is a history OF --------------------------------------------
#
# The shape does not change between a missal and a code. Stations are acts,
# units are the addressable things acts move, a container holds units, and the
# diff of a station is the acceptance test. What changes is the words, and the
# words matter: a page that called a title of the Code a `mass` would be the
# defect guidance/the-shape.md section 1 is about -- a reference that resolves
# successfully and wrongly.
#
# So a slice declares one `vocabulary`, and it decides four things and no
# others: the TOML table containers stand in, the key those containers take in
# the emitted fragments, what a container carries, and how a unit's file reads.
# Nothing else in this tool branches on it.
#
# `law` differs from `liturgy` in one further way, and it is the whole reason
# the distinction is worth having. A canon of the 1983 Code is a text this
# project may not publish (see the rights record), so its unit file carries the
# canon's identity and a stated absence rather than its words. A file that said
# only "withheld" would then read the same before and after an act that
# substituted the canon, and a station that substituted twenty-one canons would
# show an empty diff. So where the text is withheld, a law unit also carries the
# act that established the text being withheld -- which is not provenance about
# a reading but the legal state itself, and is exactly how a lawyer cites a
# canon: c. 1671 *as substituted by* Mitis Iudex. It is DERIVED from the act
# that applied the departure, never typed beside it.


class Vocabulary:
    def __init__(self, name, group_table, group_word, group_fields, group_always,
                 unit_word, unit_plural, withheld_label, unit_carries_establishing_act,
                 default_book):
        self.name = name
        self.default_book = default_book
        self.group_table = group_table
        self.group_word = group_word
        self.group_fields = group_fields
        self.group_always = group_always
        self.unit_word = unit_word
        self.unit_plural = unit_plural
        self.withheld_label = withheld_label
        self.unit_carries_establishing_act = unit_carries_establishing_act


