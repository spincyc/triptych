def _toml_string(value: str) -> str:
    return json.dumps(value, ensure_ascii=False)


def _toml_array(values: list[str]) -> str:
    return "[" + ", ".join(_toml_string(value) for value in values) + "]"


def _safe_repo_path(value: str) -> bool:
    path = PurePosixPath(value)
    return (
        bool(value)
        and "\\" not in value
        and not path.is_absolute()
        and path.as_posix() == value
        and all(part not in {"", ".", ".."} for part in path.parts)
    )


def _rooted(root: Path, value: str | Path) -> Path:
    path = Path(value)
    return path if path.is_absolute() else root / path


def _safe_rooted(root: Path, value: Any, label: str) -> tuple[Path | None, list[str]]:
    if not isinstance(value, str) or not _safe_repo_path(value):
        return None, [f"{label} must be a safe repository-relative path"]
    path = root / value
    try:
        path.resolve().relative_to(root.resolve())
    except (OSError, ValueError):
        return None, [f"{label} resolves outside the repository root"]
    return path, []


def _read_toml(path: Path, label: str) -> tuple[dict[str, Any] | None, list[str]]:
    try:
        with path.open("rb") as source:
            data = tomllib.load(source)
    except (OSError, tomllib.TOMLDecodeError) as error:
        return None, [f"{label}: cannot read TOML: {error}"]
    if not isinstance(data, dict):
        return None, [f"{label}: TOML root must be a table"]
    return data, []


def _hash_payload(value: Any) -> str:
    encoded = json.dumps(
        value,
        default=lambda item: f"<{type(item).__name__}:{item}>",
        ensure_ascii=False,
        sort_keys=True,
        separators=(",", ":"),
    ).encode("utf-8")
    return "sha256:" + hashlib.sha256(encoded).hexdigest()


def _document_set_snapshot(documents: list[str]) -> str:
    payload = "".join(f"{document}\n" for document in sorted(documents)).encode(
        "utf-8"
    )
    return "sha256:" + hashlib.sha256(payload).hexdigest()


def _file_sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def _string_list(value: Any, *, nonempty: bool = False) -> bool:
    return (
        isinstance(value, list)
        and (not nonempty or bool(value))
        and all(isinstance(item, str) and bool(item.strip()) for item in value)
    )


def _sorted_unique_strings(value: Any, *, nonempty: bool = False) -> bool:
    return _string_list(value, nonempty=nonempty) and value == sorted(set(value))


def _choice(value: Any, choices: set[str]) -> bool:
    return isinstance(value, str) and value in choices


def _iso_date(value: Any) -> dt.date | None:
    if not isinstance(value, str):
        return None
    try:
        return dt.date.fromisoformat(value)
    except ValueError:
        return None


def _inventory_context(root: Path, path: Path) -> tuple[dict[str, Any] | None, list[str]]:
    errors = SOURCE_INVENTORY_VALIDATOR["_validate"](root, path)
    data, read_errors = _read_toml(path, path.as_posix())
    errors.extend(read_errors)
    if data is None:
        return None, errors
    audited_on = _iso_date(data.get("audited_on"))
    if audited_on is None:
        errors.append(f"{path}: audited_on must be an ISO date")
    documents = data.get("documents")
    owners = data.get("owners")
    files = data.get("files")
    if not isinstance(documents, list) or not isinstance(owners, list) or not isinstance(files, list):
        return None, errors + [f"{path}: documents, owners, and files must be arrays"]
    expected_snapshot = _hash_payload(
        {"documents": documents, "owners": owners, "files": files}
    )
    if data.get("snapshot") != expected_snapshot:
        errors.append(f"{path}: snapshot is stale; expected {expected_snapshot}")
    document_ids: list[str] = []
    owner_ids: list[str] = []
    for index, document in enumerate(documents, start=1):
        if not isinstance(document, dict) or not isinstance(document.get("id"), str):
            errors.append(f"{path}: documents[{index}].id must be a string")
            continue
        document_ids.append(document["id"])
    for index, owner in enumerate(owners, start=1):
        if not isinstance(owner, dict) or not isinstance(owner.get("id"), str):
            errors.append(f"{path}: owners[{index}].id must be a string")
            continue
        owner_ids.append(owner["id"])
    if document_ids != sorted(set(document_ids)):
        errors.append(f"{path}: document IDs must be unique and sorted")
    if owner_ids != sorted(set(owner_ids)):
        errors.append(f"{path}: owner IDs must be unique and sorted")
    unit_ids = sorted(set(document_ids) | set(owner_ids))
    known_units = set(unit_ids)
    unit_files: dict[str, list[dict[str, Any]]] = {unit: [] for unit in unit_ids}
    file_by_path: dict[str, dict[str, Any]] = {}
    file_paths: list[str] = []
    for index, item in enumerate(files, start=1):
        label = f"{path}: files[{index}]"
        if not isinstance(item, dict) or set(item) != {"path", "sha256", "kind", "owners"}:
            errors.append(f"{label} must contain exactly path, sha256, kind, and owners")
            continue
        relative = item.get("path")
        digest = item.get("sha256")
        assigned = item.get("owners")
        if not isinstance(relative, str) or not _safe_repo_path(relative):
            errors.append(f"{label}.path must be a safe repository-relative path")
            continue
        file_paths.append(relative)
        if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
            errors.append(f"{label}.sha256 must be a bare lowercase SHA-256")
        if not _sorted_unique_strings(assigned, nonempty=True):
            errors.append(f"{label}.owners must be a nonempty sorted unique string array")
            assigned = []
        unknown = sorted(set(assigned) - known_units)
        if unknown:
            errors.append(f"{label}.owners are unknown: {', '.join(unknown)}")
        actual_path = root / relative
        if not actual_path.is_file():
            errors.append(f"{label}.path is missing: {relative}")
        elif isinstance(digest, str):
            actual_digest = _file_sha256(actual_path)
            if digest != actual_digest:
                errors.append(
                    f"{label}.sha256 is stale for {relative}; expected {actual_digest}"
                )
        file_by_path[relative] = item
        for owner_id in assigned:
            if owner_id in unit_files:
                unit_files[owner_id].append(item)
    if file_paths != sorted(set(file_paths)):
        errors.append(f"{path}: file paths must be unique and sorted")
    surface_snapshots = {
        owner_id: _hash_payload(sorted(rows, key=lambda row: row["path"]))
        for owner_id, rows in unit_files.items()
    }
    context = {
        "data": data,
        "audited_on": audited_on,
        "snapshot": expected_snapshot,
        "documents": documents,
        "document_ids": document_ids,
        "owner_ids": owner_ids,
        "unit_ids": unit_ids,
        "unit_files": unit_files,
        "file_by_path": file_by_path,
        "surface_snapshots": surface_snapshots,
    }
    return context, sorted(set(errors))


def _classification_context(
    path: Path, inventory: dict[str, Any]
) -> tuple[dict[str, Any] | None, list[str]]:
    _, errors = SOURCE_INVENTORY_VALIDATOR["_classification_review"](
        path,
        inventory["document_ids"],
        allow_unresolved=True,
    )
    data, read_errors = _read_toml(path, path.as_posix())
    errors.extend(read_errors)
    if data is None:
        return None, errors
    audited_on = _iso_date(data.get("audited_on"))
    if audited_on is None:
        errors.append(f"{path}: audited_on must be an ISO date")
    rows = data.get("classifications")
    if not isinstance(rows, list):
        return None, errors + [f"{path}: classifications must be an array"]
    normalized: list[dict[str, Any]] = []
    documents: list[str] = []
    mapping: dict[str, list[str]] = {}
    for index, row in enumerate(rows, start=1):
        label = f"{path}: classifications[{index}]"
        if not isinstance(row, dict) or set(row) != {"document", "source_categories"}:
            errors.append(f"{label} must contain exactly document and source_categories")
            continue
        document = row.get("document")
        categories = row.get("source_categories")
        if not isinstance(document, str) or not document:
            errors.append(f"{label}.document must be a nonempty string")
            continue
        documents.append(document)
        if not _sorted_unique_strings(categories, nonempty=True):
            errors.append(f"{label}.source_categories must be sorted and unique")
            continue
        normalized.append({"document": document, "source_categories": categories})
        mapping[document] = categories
    if documents != sorted(set(documents)):
        errors.append(f"{path}: reviewed document IDs must be unique and sorted")
    actual_documents = inventory["document_ids"]
    if documents != actual_documents:
        errors.append(f"{path}: publication set diverges from the source inventory")
    publication_snapshot = _document_set_snapshot(documents)
    if data.get("publication_snapshot") != publication_snapshot:
        errors.append(
            f"{path}: publication_snapshot is stale; expected {publication_snapshot}"
        )
    classification_snapshot = _hash_payload(normalized)
    if data.get("classification_snapshot") != classification_snapshot:
        errors.append(
            f"{path}: classification_snapshot is stale; expected {classification_snapshot}"
        )
    for document in inventory["documents"]:
        if document.get("inventory_state") != "records-enumerated":
            if document.get("source_categories") != mapping.get(document.get("id")):
                errors.append(
                    f"{path}: inventory categories diverge for {document.get('id')}"
                )
    return {
        "data": data,
        "audited_on": audited_on,
        "snapshot": classification_snapshot,
        "mapping": mapping,
    }, sorted(set(errors))


def _canonical_catalog(root: Path) -> tuple[set[str], str, list[str]]:
    paths = [
        *root.glob("src/sources/works/**/work.toml"),
        *root.glob("src/sources/works/**/edition.toml"),
        *root.glob("src/sources/works/**/artifact.toml"),
        *root.glob("src/sources/works/**/passages/*.toml"),
        *root.glob("src/sources/works/**/segments/*.toml"),
        *root.glob("src/sources/corpora/*.toml"),
    ]
    found: set[str] = set()
    errors: list[str] = []
    catalog_rows: list[dict[str, str]] = []
    for path in sorted(set(paths)):
        try:
            digest = _file_sha256(path)
        except OSError as error:
            errors.append(f"{path}: cannot hash canonical source manifest: {error}")
            continue
        catalog_rows.append(
            {
                "path": path.relative_to(root).as_posix(),
                "sha256": digest,
            }
        )
        data, read_errors = _read_toml(path, path.as_posix())
        errors.extend(read_errors)
        if data is None:
            continue
        record_type = data.get("record_type")
        record_id = data.get("id")
        schema = data.get("schema")
        allowed_record_types = (
            CANONICAL_RECORD_TYPES_BY_SCHEMA.get(schema)
            if isinstance(schema, int) and not isinstance(schema, bool)
            else None
        )
        if (
            allowed_record_types is None
            or not _choice(record_type, allowed_record_types)
            or not isinstance(record_id, str)
            or not record_id.startswith(f"{record_type}.")
        ):
            errors.append(f"{path}: canonical source identity is malformed")
            continue
        if record_id in found:
            errors.append(f"{path}: duplicate canonical source ID {record_id}")
        found.add(record_id)
    return found, _hash_payload(catalog_rows), sorted(set(errors))


def _ledger_snapshot(data: dict[str, Any]) -> str:
    payload = {key: value for key, value in data.items() if key != "snapshot"}
    return _hash_payload(payload)


def membership_snapshot(canonical_ids: list[str]) -> str:
    """A fingerprint of exactly which sources a family claims.

    `reviewed_on` says when a family was last reviewed; this says WHAT was
    reviewed. Without it the only way to prove a family's membership had been
    looked at was to demand it be re-reviewed today, which is why accepting one
    new source used to require re-dating every review in the ledger.
    """
    joined = "\n".join(sorted(canonical_ids))
    return "sha256:" + hashlib.sha256(joined.encode("utf-8")).hexdigest()


def _family_screening_snapshot(families: list[dict[str, Any]]) -> str:
    fields = (
        "id",
        "label",
        "kind",
        "source_categories",
        "identity_confidence",
        "identity_gaps",
        "trace_patterns",
    )
    projection = [
        {field: family[field] for field in fields}
        for family in families
    ]
    return _hash_payload(projection)


def _validate_family(
    family: Any,
    index: int,
    ledger_date: dt.date,
    canonical_ids: set[str],
) -> tuple[dict[str, Any] | None, list[str]]:
    label = f"families[{index}]"
    errors: list[str] = []
    expected = {
        "id",
        "label",
        "kind",
        "source_categories",
        "identity_confidence",
        "identity_gaps",
        "artifact_availability",
        "storage_plan",
        "rights_review",
        "mutability",
        "freshness_rule",
        "evidence_ceiling",
        "disposition",
        "priority",
        "canonical_ids",
        "trace_patterns",
        "reviewed_on",
        "notes",
    }
    # Optional, and its ABSENCE is meaningful: a family with no fingerprint has
    # no record of what its review covered, so acceptance treats it as moved and
    # asks for a fresh review. That is the safe direction, and it lets a writer
    # that has not learned the field yet still produce a valid ledger.
    optional = {"membership_snapshot"}
    if not isinstance(family, dict) or not expected <= set(family) or set(family) - expected - optional:
        return None, [f"{label} must contain exactly the documented family fields"]
    normalized = dict(family)
    family_id = family.get("id")
    if not isinstance(family_id, str) or not FAMILY_ID_RE.fullmatch(family_id):
        errors.append(f"{label}.id must be a ledger-local family.* ID")
    if not isinstance(family.get("label"), str) or not family["label"].strip():
        errors.append(f"{label}.label must be nonempty")
    if not _choice(family.get("kind"), FAMILY_KINDS):
        errors.append(f"{label}.kind is invalid")
    categories = family.get("source_categories")
    if not _sorted_unique_strings(categories, nonempty=True):
        errors.append(f"{label}.source_categories must be sorted and unique")
        normalized["source_categories"] = []
    elif set(categories) - SOURCE_CATEGORIES:
        errors.append(f"{label}.source_categories contain invalid values")
    confidence = family.get("identity_confidence")
    gaps = family.get("identity_gaps")
    if not _choice(confidence, IDENTITY_CONFIDENCE):
        errors.append(f"{label}.identity_confidence is invalid")
    if not _sorted_unique_strings(gaps):
        errors.append(f"{label}.identity_gaps must be sorted and unique")
        normalized["identity_gaps"] = []
    elif set(gaps) - IDENTITY_GAPS:
        errors.append(f"{label}.identity_gaps contain invalid values")
    if (
        isinstance(confidence, str)
        and confidence in {"ambiguous", "unreviewed"}
        and not gaps
    ):
        errors.append(f"{label}.identity_gaps must expose unresolved identity")
    availability = family.get("artifact_availability")
    if not _choice(availability, ARTIFACT_AVAILABILITY):
        errors.append(f"{label}.artifact_availability is invalid")
    storage = family.get("storage_plan")
    if not _sorted_unique_strings(storage, nonempty=True):
        errors.append(f"{label}.storage_plan must be sorted and unique")
        normalized["storage_plan"] = []
    elif set(storage) - STORAGE_PLANS:
        errors.append(f"{label}.storage_plan contains invalid values")
    rights = family.get("rights_review")
    if not _choice(rights, RIGHTS_REVIEW):
        errors.append(f"{label}.rights_review is invalid")
    if isinstance(storage, list) and "tracked" in storage:
        if rights != "all-known-artifacts-reviewed":
            errors.append(f"{label}: tracked storage requires reviewed candidate rights")
        if "restricted" in storage:
            errors.append(f"{label}: tracked and restricted storage cannot be combined")
    if availability == "unavailable" and storage != ["unavailable"]:
        errors.append(f"{label}: unavailable artifacts require unavailable storage")
    mutability = family.get("mutability")
    freshness = family.get("freshness_rule")
    if not _choice(mutability, MUTABILITY):
        errors.append(f"{label}.mutability is invalid")
    if not isinstance(freshness, str) or not freshness.strip():
        errors.append(f"{label}.freshness_rule must be nonempty")
    elif mutability == "fixed" and freshness != "not-applicable":
        errors.append(f"{label}: fixed families use freshness_rule = not-applicable")
    elif mutability != "fixed" and freshness == "not-applicable":
        errors.append(f"{label}: mutable, serial, mixed, or unknown families need a rule")
    if not _choice(family.get("evidence_ceiling"), EVIDENCE_CEILINGS):
        errors.append(f"{label}.evidence_ceiling is invalid")
    disposition = family.get("disposition")
    if not _choice(disposition, DISPOSITIONS):
        errors.append(f"{label}.disposition is invalid")
    if not _choice(family.get("priority"), PRIORITIES):
        errors.append(f"{label}.priority is invalid")
    canonical = family.get("canonical_ids")
    if not _sorted_unique_strings(canonical):
        errors.append(f"{label}.canonical_ids must be sorted and unique")
        canonical = []
        normalized["canonical_ids"] = []
    unknown = sorted(set(canonical) - canonical_ids)
    if unknown:
        errors.append(f"{label}.canonical_ids do not resolve: {', '.join(unknown)}")
    if availability == "canonicalized" and not canonical:
        errors.append(f"{label}: canonicalized availability requires canonical_ids")
    if disposition == "bind-existing" and not canonical:
        errors.append(f"{label}: bind-existing requires canonical_ids")
    patterns = family.get("trace_patterns")
    if not _sorted_unique_strings(patterns, nonempty=True):
        errors.append(f"{label}.trace_patterns must be sorted and unique")
        normalized["trace_patterns"] = []
    else:
        valid_patterns: list[str] = []
        for pattern in patterns:
            try:
                re.compile(pattern, re.IGNORECASE | re.DOTALL)
            except re.error as error:
                errors.append(f"{label}.trace_patterns has invalid regex {pattern!r}: {error}")
            else:
                valid_patterns.append(pattern)
        normalized["trace_patterns"] = valid_patterns
    reviewed_on = _iso_date(family.get("reviewed_on"))
    if reviewed_on is None:
        errors.append(f"{label}.reviewed_on must be an ISO date")
    elif reviewed_on > ledger_date:
        errors.append(f"{label}.reviewed_on cannot be later than audited_on")
    if not isinstance(family.get("notes"), str) or not family["notes"].strip():
        errors.append(f"{label}.notes must be nonempty")
    return normalized if isinstance(family_id, str) else None, errors


def _path_matches_family(root: Path, path: str, family: dict[str, Any]) -> bool:
    try:
        text = (root / path).read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError):
        return False
    return any(
        re.search(pattern, text, re.IGNORECASE | re.DOTALL)
        for pattern in family["trace_patterns"]
    )


def _validate_ledger(
    root: Path,
    path: Path,
    *,
    check_external: bool = True,
    require_screened: bool = False,
    candidate: dict[str, Any] | None = None,
) -> tuple[dict[str, Any] | None, dict[str, Any] | None, list[str]]:
    if candidate is None:
        data, errors = _read_toml(path, path.as_posix())
        if data is None:
            return None, None, errors
    else:
        data = candidate
        errors = []
    if check_external:
        errors.extend(_source_library_errors(root))
    expected = {
        "migration_ledger_schema",
        "record_type",
        "audited_on",
        "inventory_path",
        "inventory_snapshot",
        "classification_review_path",
        "classification_snapshot",
        "canonical_catalog_snapshot",
        "coverage_granularity",
        "atomic_citation_coverage",
        "snapshot",
        "families",
        "review_units",
    }
    if set(data) != expected:
        errors.append(f"{path}: ledger must contain exactly the documented fields")
    if data.get("migration_ledger_schema") != 1 or isinstance(
        data.get("migration_ledger_schema"), bool
    ):
        errors.append(f"{path}: migration_ledger_schema must be integer 1")
    if data.get("record_type") != "reviewed-source-family-migration-ledger":
        errors.append(f"{path}: record_type is invalid")
    ledger_date = _iso_date(data.get("audited_on"))
    if ledger_date is None:
        errors.append(f"{path}: audited_on must be an ISO date")
        ledger_date = dt.date.min
    if data.get("coverage_granularity") != "owner-record-family":
        errors.append(f"{path}: coverage_granularity must be owner-record-family")
    if data.get("atomic_citation_coverage") is not False:
        errors.append(f"{path}: atomic_citation_coverage must be boolean false")
    for field in (
        "inventory_snapshot",
        "classification_snapshot",
        "canonical_catalog_snapshot",
        "snapshot",
    ):
        if not isinstance(data.get(field), str) or not SHA256_RE.fullmatch(data[field]):
            errors.append(f"{path}: {field} must be sha256:<lowercase digest>")
    expected_snapshot = _ledger_snapshot(data)
    if data.get("snapshot") != expected_snapshot:
        errors.append(f"{path}: snapshot is stale; expected {expected_snapshot}")

    inventory_path, path_errors = _safe_rooted(
        root, data.get("inventory_path"), f"{path}: inventory_path"
    )
    errors.extend(path_errors)
    review_path, path_errors = _safe_rooted(
        root,
        data.get("classification_review_path"),
        f"{path}: classification_review_path",
    )
    errors.extend(path_errors)
    inventory = None
    classification = None
    if inventory_path is not None:
        inventory, inventory_errors = _inventory_context(root, inventory_path)
        errors.extend(inventory_errors)
    if inventory is not None and review_path is not None:
        classification, classification_errors = _classification_context(
            review_path, inventory
        )
        errors.extend(classification_errors)
    if check_external and inventory is not None:
        if data.get("inventory_snapshot") != inventory["snapshot"]:
            errors.append(f"{path}: pinned inventory_snapshot is stale")
    if check_external and classification is not None:
        if data.get("classification_snapshot") != classification["snapshot"]:
            errors.append(f"{path}: pinned classification_snapshot is stale")
    if check_external and ledger_date != dt.date.min:
        if (
            inventory is not None
            and inventory["audited_on"] is not None
            and ledger_date < inventory["audited_on"]
        ):
            errors.append(f"{path}: audited_on predates the pinned source inventory")
        if (
            classification is not None
            and classification["audited_on"] is not None
            and ledger_date < classification["audited_on"]
        ):
            errors.append(
                f"{path}: audited_on predates the pinned classification review"
            )

    canonical, canonical_catalog_snapshot, canonical_errors = _canonical_catalog(root)
    errors.extend(canonical_errors)
    if (
        check_external
        and data.get("canonical_catalog_snapshot") != canonical_catalog_snapshot
    ):
        errors.append(f"{path}: pinned canonical_catalog_snapshot is stale")
    families = data.get("families")
    if not isinstance(families, list):
        errors.append(f"{path}: families must be an array of tables")
        families = []
    normalized_families: list[dict[str, Any]] = []
    family_ids: list[str] = []
    canonical_owners: dict[str, str] = {}
    for index, family in enumerate(families, start=1):
        normalized, family_errors = _validate_family(
            family, index, ledger_date, canonical
        )
        errors.extend(f"{path}: {error}" for error in family_errors)
        if normalized is None:
            continue
        normalized_families.append(normalized)
        family_ids.append(normalized["id"])
        for canonical_id in normalized["canonical_ids"]:
            prior = canonical_owners.get(canonical_id)
            if prior is not None:
                errors.append(
                    f"{path}: canonical ID {canonical_id} belongs to both {prior} and {normalized['id']}"
                )
            canonical_owners[canonical_id] = normalized["id"]
    if family_ids != sorted(set(family_ids)):
        errors.append(f"{path}: family IDs must be unique and sorted")
    if check_external and normalized_families:
        unassigned = sorted(canonical - set(canonical_owners))
        if unassigned:
            errors.append(
                f"{path}: canonical source IDs lack family membership: "
                f"{', '.join(unassigned)}"
            )
    family_by_id = {family["id"]: family for family in normalized_families}
    current_family_snapshot = _family_screening_snapshot(normalized_families)

    review_units = data.get("review_units")
    if not isinstance(review_units, list) or not review_units:
        errors.append(f"{path}: review_units must be a nonempty array of tables")
        review_units = []
    unit_ids: list[str] = []
    pending: list[str] = []
    trace_records = 0
    for index, unit in enumerate(review_units, start=1):
        label = f"{path}: review_units[{index}]"
        if not isinstance(unit, dict):
            errors.append(f"{label} must be a table")
            continue
        allowed = {
            "owner_id",
            "surface_snapshot",
            "review_state",
            "reviewed_on",
            "family_screening_snapshot",
            "family_presence",
        }
        required = {"owner_id", "surface_snapshot", "review_state"}
        if not required <= set(unit) or set(unit) - allowed:
            errors.append(f"{label} contains invalid or missing fields")
            continue
        owner_id = unit.get("owner_id")
        if not isinstance(owner_id, str) or not owner_id:
            errors.append(f"{label}.owner_id must be nonempty")
            continue
        unit_ids.append(owner_id)
        surface = unit.get("surface_snapshot")
        if not isinstance(surface, str) or not SHA256_RE.fullmatch(surface):
            errors.append(f"{label}.surface_snapshot must be sha256:<digest>")
        state = unit.get("review_state")
        if not _choice(state, REVIEW_STATES):
            errors.append(f"{label}.review_state is invalid")
        if state == "pending":
            pending.append(owner_id)
            if "reviewed_on" in unit:
                errors.append(f"{label}: pending units must not have reviewed_on")
            if "family_screening_snapshot" in unit:
                errors.append(
                    f"{label}: pending units must not have family_screening_snapshot"
                )
        elif state == "family-screened":
            reviewed_on = _iso_date(unit.get("reviewed_on"))
            if reviewed_on is None:
                errors.append(f"{label}: screened units require an ISO reviewed_on")
            elif reviewed_on > ledger_date:
                errors.append(f"{label}: reviewed_on cannot be later than audited_on")
            family_snapshot = unit.get("family_screening_snapshot")
            if not isinstance(family_snapshot, str) or not SHA256_RE.fullmatch(
                family_snapshot
            ):
                errors.append(
                    f"{label}: screened units require family_screening_snapshot"
                )
            elif check_external and family_snapshot != current_family_snapshot:
                errors.append(
                    f"{label}: family_screening_snapshot is stale; expected "
                    f"{current_family_snapshot}"
                )
        if check_external and inventory is not None:
            expected_surface = inventory["surface_snapshots"].get(owner_id)
            if expected_surface is None:
                errors.append(f"{label}.owner_id is not in the current inventory")
            elif surface != expected_surface:
                errors.append(f"{label}.surface_snapshot is stale; expected {expected_surface}")
        presences = unit.get("family_presence", [])
        if not isinstance(presences, list):
            errors.append(f"{label}.family_presence must be an array of tables")
            presences = []
        presence_ids: list[str] = []
        for presence_index, presence in enumerate(presences, start=1):
            presence_label = f"{label}.family_presence[{presence_index}]"
            if not isinstance(presence, dict) or set(presence) != {
                "family_id",
                "basis",
                "record_paths",
            }:
                errors.append(f"{presence_label} must contain exactly family_id, basis, and record_paths")
                continue
            family_id = presence.get("family_id")
            basis = presence.get("basis")
            records = presence.get("record_paths")
            if not isinstance(family_id, str) or family_id not in family_by_id:
                errors.append(f"{presence_label}.family_id does not resolve")
                continue
            presence_ids.append(family_id)
            if not _choice(basis, PRESENCE_BASES):
                errors.append(f"{presence_label}.basis is invalid")
            if state == "pending" and basis != "trace-scan":
                errors.append(f"{presence_label}: pending units may retain trace-scan evidence only")
            if state == "family-screened" and basis != "reviewed":
                errors.append(f"{presence_label}: screened units require reviewed presence")
            if not _sorted_unique_strings(records, nonempty=True):
                errors.append(f"{presence_label}.record_paths must be sorted and unique")
                records = []
            trace_records += len(records)
            if check_external and inventory is not None:
                owned = {
                    item["path"] for item in inventory["unit_files"].get(owner_id, [])
                }
                for record_path in records:
                    if record_path not in owned:
                        errors.append(
                            f"{presence_label}.record_paths is not owned by {owner_id}: {record_path}"
                        )
                    elif basis == "trace-scan" and not _path_matches_family(
                        root, record_path, family_by_id[family_id]
                    ):
                        errors.append(
                            f"{presence_label}.record_paths lacks a replayable trace: {record_path}"
                        )
        if presence_ids != sorted(set(presence_ids)):
            errors.append(f"{label}.family_presence must be unique and sorted")
    if unit_ids != sorted(set(unit_ids)):
        errors.append(f"{path}: review-unit owner IDs must be unique and sorted")
    if check_external and inventory is not None and unit_ids != inventory["unit_ids"]:
        missing = sorted(set(inventory["unit_ids"]) - set(unit_ids))
        extra = sorted(set(unit_ids) - set(inventory["unit_ids"]))
        if missing:
            errors.append(f"{path}: review units are missing: {', '.join(missing)}")
        if extra:
            errors.append(f"{path}: review units are unknown: {', '.join(extra)}")
    if require_screened and pending:
        errors.append(f"{path}: pending family review units: {', '.join(pending)}")
    context = {
        "inventory": inventory,
        "classification": classification,
        "families": normalized_families,
        "family_by_id": family_by_id,
        "pending": pending,
        "trace_records": trace_records,
    }
    return data, context, sorted(set(errors))


def _render(data: dict[str, Any]) -> str:
    lines = [
        f"migration_ledger_schema = {data['migration_ledger_schema']}",
        f"record_type = {_toml_string(data['record_type'])}",
        f"audited_on = {_toml_string(data['audited_on'])}",
        f"inventory_path = {_toml_string(data['inventory_path'])}",
        f"inventory_snapshot = {_toml_string(data['inventory_snapshot'])}",
        f"classification_review_path = {_toml_string(data['classification_review_path'])}",
        f"classification_snapshot = {_toml_string(data['classification_snapshot'])}",
        f"canonical_catalog_snapshot = {_toml_string(data['canonical_catalog_snapshot'])}",
        f"coverage_granularity = {_toml_string(data['coverage_granularity'])}",
        "atomic_citation_coverage = "
        + ("true" if data["atomic_citation_coverage"] else "false"),
        f"snapshot = {_toml_string(data['snapshot'])}",
    ]
    if not data["families"]:
        lines.append("families = []")
    for family in data["families"]:
        lines.extend(
            [
                "",
                "[[families]]",
                f"id = {_toml_string(family['id'])}",
                f"label = {_toml_string(family['label'])}",
                f"kind = {_toml_string(family['kind'])}",
                f"source_categories = {_toml_array(family['source_categories'])}",
                f"identity_confidence = {_toml_string(family['identity_confidence'])}",
                f"identity_gaps = {_toml_array(family['identity_gaps'])}",
                f"artifact_availability = {_toml_string(family['artifact_availability'])}",
                f"storage_plan = {_toml_array(family['storage_plan'])}",
                f"rights_review = {_toml_string(family['rights_review'])}",
                f"mutability = {_toml_string(family['mutability'])}",
                f"freshness_rule = {_toml_string(family['freshness_rule'])}",
                f"evidence_ceiling = {_toml_string(family['evidence_ceiling'])}",
                f"disposition = {_toml_string(family['disposition'])}",
                f"priority = {_toml_string(family['priority'])}",
                f"canonical_ids = {_toml_array(family['canonical_ids'])}",
                f"trace_patterns = {_toml_array(family['trace_patterns'])}",
                f"reviewed_on = {_toml_string(family['reviewed_on'])}",
            ]
            # CARRIED, never recomputed. The stored value records what the
            # review covered; recomputing it on write would make it always
            # equal the current membership, so a family whose ids had been
            # edited would report itself reviewed and the guard would never
            # fire. Omitted when absent, which the acceptance path reads as
            # "unknown, therefore moved".
            + (
                [f"membership_snapshot = {_toml_string(family['membership_snapshot'])}"]
                if family.get("membership_snapshot")
                else []
            )
            + [f"notes = {_toml_string(family['notes'])}"]
        )
    for unit in data["review_units"]:
        lines.extend(
            [
                "",
                "[[review_units]]",
                f"owner_id = {_toml_string(unit['owner_id'])}",
                f"surface_snapshot = {_toml_string(unit['surface_snapshot'])}",
                f"review_state = {_toml_string(unit['review_state'])}",
            ]
        )
        if "reviewed_on" in unit:
            lines.append(f"reviewed_on = {_toml_string(unit['reviewed_on'])}")
        if "family_screening_snapshot" in unit:
            lines.append(
                "family_screening_snapshot = "
                f"{_toml_string(unit['family_screening_snapshot'])}"
            )
        for presence in unit.get("family_presence", []):
            lines.extend(
                [
                    "[[review_units.family_presence]]",
                    f"family_id = {_toml_string(presence['family_id'])}",
                    f"basis = {_toml_string(presence['basis'])}",
                    f"record_paths = {_toml_array(presence['record_paths'])}",
                ]
            )
    return "\n".join(lines) + "\n"


def _write_atomic(
    path: Path,
    text: str,
    *,
    expected_bytes: bytes | None = None,
) -> None:
    if expected_bytes is not None and path.read_bytes() != expected_bytes:
        raise RuntimeError(f"{path}: changed during refresh; retry")
    path.parent.mkdir(parents=True, exist_ok=True)
    descriptor, temporary_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    temporary = Path(temporary_name)
    try:
        with os.fdopen(descriptor, "w", encoding="utf-8", newline="\n") as output:
            output.write(text)
            output.flush()
            os.fsync(output.fileno())
        mode = stat.S_IMODE(path.stat().st_mode) if path.exists() else 0o644
        os.chmod(temporary, mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def _bootstrap_data(
    inventory_path: str,
    inventory: dict[str, Any],
    review_path: str,
    classification: dict[str, Any],
    canonical_catalog_snapshot: str,
    audited_on: str,
) -> dict[str, Any]:
    data = {
        "migration_ledger_schema": 1,
        "record_type": "reviewed-source-family-migration-ledger",
        "audited_on": audited_on,
        "inventory_path": inventory_path,
        "inventory_snapshot": inventory["snapshot"],
        "classification_review_path": review_path,
        "classification_snapshot": classification["snapshot"],
        "canonical_catalog_snapshot": canonical_catalog_snapshot,
        "coverage_granularity": "owner-record-family",
        "atomic_citation_coverage": False,
        "families": [],
        "review_units": [
            {
                "owner_id": owner_id,
                "surface_snapshot": inventory["surface_snapshots"][owner_id],
                "review_state": "pending",
            }
            for owner_id in inventory["unit_ids"]
        ],
    }
    data["snapshot"] = _ledger_snapshot(data)
    return data


def _refresh_data(
    root: Path,
    old: dict[str, Any],
    inventory: dict[str, Any],
    classification: dict[str, Any],
    audited_on: str,
    accepted_canonical_catalog_snapshot: str | None = None,
) -> dict[str, Any]:
    family_by_id = {family["id"]: family for family in old["families"]}
    current_family_snapshot = _family_screening_snapshot(old["families"])
    prior_units = {unit["owner_id"]: unit for unit in old["review_units"]}
    units: list[dict[str, Any]] = []
    for owner_id in inventory["unit_ids"]:
        current_surface = inventory["surface_snapshots"][owner_id]
        prior = prior_units.get(owner_id)
        family_review_is_current = (
            prior is not None
            and (
                prior["review_state"] == "pending"
                or prior.get("family_screening_snapshot")
                == current_family_snapshot
            )
        )
        if (
            prior is not None
            and prior["surface_snapshot"] == current_surface
            and family_review_is_current
        ):
            units.append(prior)
            continue
        refreshed: dict[str, Any] = {
            "owner_id": owner_id,
            "surface_snapshot": current_surface,
            "review_state": "pending",
        }
        retained: list[dict[str, Any]] = []
        owned = {item["path"] for item in inventory["unit_files"][owner_id]}
        if prior is not None:
            for presence in prior.get("family_presence", []):
                family = family_by_id[presence["family_id"]]
                records = [
                    record
                    for record in presence["record_paths"]
                    if record in owned and _path_matches_family(root, record, family)
                ]
                if records:
                    retained.append(
                        {
                            "family_id": presence["family_id"],
                            "basis": "trace-scan",
                            "record_paths": sorted(set(records)),
                        }
                    )
        if retained:
            refreshed["family_presence"] = sorted(
                retained, key=lambda presence: presence["family_id"]
            )
        units.append(refreshed)
    data = {
        "migration_ledger_schema": 1,
        "record_type": "reviewed-source-family-migration-ledger",
        "audited_on": audited_on,
        "inventory_path": old["inventory_path"],
        "inventory_snapshot": inventory["snapshot"],
        "classification_review_path": old["classification_review_path"],
        "classification_snapshot": classification["snapshot"],
        "canonical_catalog_snapshot": (
            accepted_canonical_catalog_snapshot
            if accepted_canonical_catalog_snapshot is not None
            else old["canonical_catalog_snapshot"]
        ),
        "coverage_granularity": "owner-record-family",
        "atomic_citation_coverage": False,
        "families": old["families"],
        "review_units": units,
    }
    data["snapshot"] = _ledger_snapshot(data)
    return data


def _print_errors(errors: list[str]) -> None:
    for error in errors:
        print(f"source-family-migration error: {error}", file=sys.stderr)


def _source_library_errors(root: Path) -> list[str]:
    result = subprocess.run(
        [sys.executable, str(SOURCE_LIBRARY_TOOL), "--root", str(root), "validate"],
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode == 0:
        return []
    details = [line for line in result.stderr.splitlines() if line.strip()]
    return ["canonical source library is invalid", *details]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=ROOT)
    examples_live_on_the_verbs(parser, "source-family-migration")
    subparsers = parser.add_subparsers(dest="command", required=True)
    check = with_examples(
        subparsers.add_parser("check"),
        EXAMPLES["check"],
    )
    check.add_argument("ledger", nargs="?", type=Path, default=DEFAULT_LEDGER)
    check.add_argument("--require-family-screened", action="store_true")
    bootstrap = with_examples(
        subparsers.add_parser("bootstrap"),
        EXAMPLES["bootstrap"],
    )
    bootstrap.add_argument("output", type=Path)
    bootstrap.add_argument("--audited-on", required=True)
    bootstrap.add_argument("--inventory", type=Path, default=DEFAULT_INVENTORY)
    bootstrap.add_argument(
        "--classification-review", type=Path, default=DEFAULT_CLASSIFICATION_REVIEW
    )
    refresh = with_examples(
        subparsers.add_parser("refresh"),
        EXAMPLES["refresh"],
    )
    refresh.add_argument("ledger", nargs="?", type=Path, default=DEFAULT_LEDGER)
    refresh.add_argument("--audited-on", required=True)
    refresh.add_argument("--accept-canonical-catalog", action="store_true")
    args = parser.parse_args()
    root = args.root.resolve()

    if args.command == "check":
        ledger_path = _rooted(root, args.ledger)
        _, context, errors = _validate_ledger(
            root,
            ledger_path,
            require_screened=args.require_family_screened,
        )
        if errors:
            _print_errors(errors)
            return 1
        assert context is not None
        print(
            "source-family-migration valid: "
            f"families={len(context['families'])} "
            f"review_units={len(context['inventory']['unit_ids'])} "
            f"screened={len(context['inventory']['unit_ids']) - len(context['pending'])} "
            f"pending={len(context['pending'])} "
            f"trace_records={context['trace_records']} "
            "atomic_citation_coverage=false"
        )
        return 0

    audited_on = _iso_date(args.audited_on)
    if audited_on is None:
        parser.error("--audited-on must be an ISO date")

    if args.command == "bootstrap":
        output = _rooted(root, args.output)
        if output.exists():
            _print_errors([f"{output}: already exists; use refresh"])
            return 1
        inventory_relative = args.inventory.as_posix()
        review_relative = args.classification_review.as_posix()
        if not _safe_repo_path(inventory_relative) or not _safe_repo_path(review_relative):
            _print_errors(["bootstrap pin paths must be repository-relative and safe"])
            return 1
        inventory, errors = _inventory_context(root, root / args.inventory)
        if inventory is None or errors:
            _print_errors(errors)
            return 1
        classification, errors = _classification_context(
            root / args.classification_review, inventory
        )
        if classification is None or errors:
            _print_errors(errors)
            return 1
        source_dates = [inventory["audited_on"], classification["audited_on"]]
        if any(source_date is not None and audited_on < source_date for source_date in source_dates):
            _print_errors(
                ["--audited-on cannot predate the inventory or classification review"]
            )
            return 1
        _, canonical_catalog_snapshot, canonical_errors = _canonical_catalog(root)
        if canonical_errors:
            _print_errors(canonical_errors)
            return 1
        data = _bootstrap_data(
            inventory_relative,
            inventory,
            review_relative,
            classification,
            canonical_catalog_snapshot,
            args.audited_on,
        )
        _, _, candidate_errors = _validate_ledger(
            root,
            output,
            candidate=data,
        )
        if candidate_errors:
            _print_errors(candidate_errors)
            return 1
        _write_atomic(output, _render(data))
        return 0

    ledger_path = _rooted(root, args.ledger)
    try:
        ledger_before = ledger_path.read_bytes()
    except OSError as error:
        _print_errors([f"{ledger_path}: cannot capture refresh input: {error}"])
        return 1
    accepted_prior_date: dt.date | None = None
    if args.accept_canonical_catalog:
        reviewed, errors = _read_toml(ledger_path, ledger_path.as_posix())
        if reviewed is not None:
            accepted_prior_date = _iso_date(reviewed.get("audited_on"))
            if accepted_prior_date is None:
                errors.append(f"{ledger_path}: prior audited_on must be an ISO date")
            elif audited_on < accepted_prior_date:
                errors.append("--audited-on cannot predate the prior ledger")
            else:
                reviewed["audited_on"] = args.audited_on
                reviewed["snapshot"] = _ledger_snapshot(reviewed)
                old, _, validation_errors = _validate_ledger(
                    root,
                    ledger_path,
                    check_external=False,
                    candidate=reviewed,
                )
                errors.extend(validation_errors)
            if errors:
                old = None
        else:
            old = None
    else:
        old, _, errors = _validate_ledger(root, ledger_path, check_external=False)
    if old is None or errors:
        _print_errors(errors)
        return 1
    inventory_path, errors = _safe_rooted(
        root, old["inventory_path"], f"{ledger_path}: inventory_path"
    )
    if inventory_path is None or errors:
        _print_errors(errors)
        return 1
    inventory, errors = _inventory_context(root, inventory_path)
    if inventory is None or errors:
        _print_errors(errors)
        return 1
    review_path, errors = _safe_rooted(
        root,
        old["classification_review_path"],
        f"{ledger_path}: classification_review_path",
    )
    if review_path is None or errors:
        _print_errors(errors)
        return 1
    classification, errors = _classification_context(review_path, inventory)
    if classification is None or errors:
        _print_errors(errors)
        return 1
    prior_date = (
        accepted_prior_date
        if args.accept_canonical_catalog
        else _iso_date(old["audited_on"])
    )
    source_dates = [
        prior_date,
        inventory["audited_on"],
        classification["audited_on"],
    ]
    if any(source_date is not None and audited_on < source_date for source_date in source_dates):
        _print_errors(
            [
                "--audited-on cannot predate the prior ledger, inventory, or "
                "classification review"
            ]
        )
        return 1
    accepted_catalog_snapshot = None
    if args.accept_canonical_catalog:
        canonical_ids, accepted_catalog_snapshot, canonical_errors = (
            _canonical_catalog(root)
        )
        if canonical_errors:
            _print_errors(canonical_errors)
            return 1
        # A bootstrap ledger with no reviewed families makes no membership
        # claim: its owner review units remain explicitly pending.  It may pin
        # a changed canonical catalogue without pretending that every source
        # has already been grouped.  Once even one reviewed family exists, the
        # ledger claims exhaustive family membership and acceptance must keep
        # requiring every canonical source ID to belong to one.
        if old["families"]:
            represented_ids = {
                canonical_id
                for family in old["families"]
                for canonical_id in family["canonical_ids"]
            }
            missing_ids = sorted(canonical_ids - represented_ids)
            if missing_ids:
                _print_errors(
                    [
                        "cannot accept canonical catalog; source IDs lack reviewed "
                        f"family membership: {', '.join(missing_ids)}"
                    ]
                )
                return 1
        # Only a family whose MEMBERSHIP has moved needs re-reviewing. This
        # used to demand `reviewed_on == audited_on` of every family carrying
        # canonical ids, so admitting one new source asserted a fresh review of
        # all 369 — a claim nobody could make truthfully, which meant the gate
        # went red the moment the library grew and stayed red. A family whose
        # recorded fingerprint still matches what it claims was reviewed then,
        # and that review stands.
        stale_family_reviews = sorted(
            family["id"]
            for family in old["families"]
            if family["canonical_ids"]
            and family.get("membership_snapshot")
            != membership_snapshot(family["canonical_ids"])
            and family["reviewed_on"] != args.audited_on
        )
        if stale_family_reviews:
            _print_errors(
                [
                    "cannot accept canonical catalog; families with canonical "
                    "membership must be reviewed_on the acceptance date: "
                    f"{', '.join(stale_family_reviews)}"
                ]
            )
            return 1
    refreshed = _refresh_data(
        root,
        old,
        inventory,
        classification,
        args.audited_on,
        accepted_catalog_snapshot,
    )
    _, _, candidate_errors = _validate_ledger(
        root,
        ledger_path,
        candidate=refreshed,
    )
    if candidate_errors:
        _print_errors(candidate_errors)
        return 1
    try:
        _write_atomic(
            ledger_path,
            _render(refreshed),
            expected_bytes=ledger_before,
        )
    except (OSError, RuntimeError) as error:
        _print_errors([f"cannot complete refresh: {error}"])
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
