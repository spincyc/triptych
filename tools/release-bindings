# `approve` records a dated authorization into the tracked release records.
# There is no scratch target for it and no dry run, so the only invocation that
# can be captured is the refusal. Saying that is better than showing a
# transcript nobody produced.
UNAVAILABLE = {
    "approve": (
        "a successful approve writes a dated authorization into release/, which "
        "cannot be captured without recording a real approval. Only the refusal "
        "is shown."
    ),
}

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "release" / "public-alpha.json"
PUBLIC_ALPHA = Path(__file__).with_name("public-alpha")

SNAPSHOT_HEADER = "## Exact approved snapshots"
SITE_HEADER = "## Exact approved reader-facing site sources"
PUBLICATION_RECORD_ROOT = "release/publications"


class BindingError(Exception):
    pass


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_manifest() -> dict:
    try:
        return json.loads(MANIFEST.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise BindingError(f"cannot load manifest: {exc}")


def save_manifest(manifest: dict) -> None:
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def primary_provider(manifest: dict) -> str:
    provider = manifest.get("provider")
    if not isinstance(provider, str) or not provider:
        raise BindingError("manifest provider must be a non-empty string")
    return provider


def split_id(manifest: dict, publication_id: str) -> tuple[str, str]:
    if ":" in publication_id:
        provider, leaf = publication_id.split(":", 1)
    else:
        provider, leaf = primary_provider(manifest), publication_id
    if not provider or not leaf:
        raise BindingError(f"malformed publication id: {publication_id!r}")
    return provider, leaf


def pdf_path(manifest: dict, publication_id: str) -> Path:
    provider, leaf = split_id(manifest, publication_id)
    return ROOT / "pdf" / provider / f"{leaf}.pdf"


def single_authorization(manifest: dict) -> dict:
    authorizations = manifest.get("authorizations")
    if not isinstance(authorizations, dict) or len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    (authorization,) = authorizations.values()
    if not isinstance(authorization, dict):
        raise BindingError("authorization must be an object")
    return authorization


def rights_record_path(authorization: dict) -> Path:
    record = authorization.get("rights_record")
    if not isinstance(record, str) or not record.startswith("release/rights/"):
        raise BindingError("authorization rights_record must live under release/rights/")
    path = ROOT / record
    if not path.is_file():
        raise BindingError(f"rights record missing: {record}")
    return path


def compute_publication_hashes(manifest: dict) -> dict[str, str]:
    hashes: dict[str, str] = {}
    for publication in manifest.get("publications", []):
        publication_id = publication.get("id")
        if publication.get("status") not in {"release", "review"}:
            continue
        path = pdf_path(manifest, publication_id)
        if not path.is_file():
            raise BindingError(f"installed PDF missing for {publication_id}: {path}")
        hashes[publication_id] = sha256_file(path)
    return hashes


def publication_status_counts(manifest: dict) -> tuple[str, dict[str, int]]:
    """Count the active publication inventory in its actual storage schema.

    Migrated manifests own one record per publication under
    ``release/publications``.  The legacy aggregate remains readable so an
    older checkout can still record an honest supplement during migration.
    The returned schema name lets the prose use the statuses that really exist
    instead of calling an alpha record a legacy release row.
    """
    primary = primary_provider(manifest)
    providers = manifest.get("providers", [primary])
    if (
        not isinstance(providers, list)
        or not providers
        or not all(
            isinstance(provider, str)
            and re.fullmatch(r"[a-z0-9-]+", provider)
            for provider in providers
        )
        or len(providers) != len(set(providers))
        or primary not in providers
    ):
        raise BindingError(
            "manifest providers must be a unique non-empty provider list "
            "containing the primary provider"
        )
    record_root = ROOT / PUBLICATION_RECORD_ROOT
    local_records = (
        sorted(record_root.rglob("*.json")) if record_root.is_dir() else []
    )
    if "publications" in manifest:
        if local_records:
            raise BindingError(
                "cannot approve a mixed legacy aggregate and local publication-record "
                "inventory; finish migration first"
            )
        publications = manifest.get("publications")
        if not isinstance(publications, list):
            raise BindingError("manifest publications must be a list")
        counts = {"release": 0, "review": 0, "hold": 0}
        for number, publication in enumerate(publications, 1):
            if not isinstance(publication, dict):
                raise BindingError(f"publication {number} must be an object")
            status = publication.get("status")
            if status not in counts:
                raise BindingError(
                    f"publication {number} has invalid legacy status {status!r}"
                )
            if status in {"release", "review"}:
                publication_id = publication.get("id")
                if not isinstance(publication_id, str) or not publication_id:
                    raise BindingError(
                        f"publication {number} has invalid id {publication_id!r}"
                    )
                provider, _leaf = split_id(manifest, publication_id)
                if provider not in providers:
                    raise BindingError(
                        f"publication {number} names undeclared provider {provider!r}"
                    )
                path = pdf_path(manifest, publication_id)
                if path.is_symlink() or not path.is_file():
                    raise BindingError(
                        f"installed PDF missing for {publication_id}: "
                        f"{path.relative_to(ROOT)}"
                    )
            counts[status] += 1
        return "legacy", counts

    counts = {"alpha": 0, "hold": 0}
    declared_records: set[Path] = set()
    for provider in providers:
        provider_root = ROOT / PUBLICATION_RECORD_ROOT / provider
        if not provider_root.is_dir():
            continue
        for path in sorted(provider_root.rglob("*.json")):
            declared_records.add(path)
            if path.is_symlink() or not path.is_file():
                raise BindingError(
                    f"unsafe publication record: {path.relative_to(ROOT)}"
                )
            try:
                publication = json.loads(path.read_text(encoding="utf-8"))
            except (OSError, UnicodeError, json.JSONDecodeError) as exc:
                raise BindingError(
                    f"cannot read publication record {path.relative_to(ROOT)}: {exc}"
                ) from exc
            if not isinstance(publication, dict) or publication.get("schema_version") != 1:
                raise BindingError(
                    f"{path.relative_to(ROOT)} must be a schema-version-1 object"
                )
            leaf = path.relative_to(provider_root).with_suffix("").as_posix()
            if publication.get("id") != leaf:
                raise BindingError(
                    f"{path.relative_to(ROOT)} id does not match its path"
                )
            status = publication.get("status")
            if status not in counts:
                raise BindingError(
                    f"{path.relative_to(ROOT)} has invalid status {status!r}"
                )
            if status == "alpha":
                installed = ROOT / "pdf" / provider / f"{leaf}.pdf"
                if installed.is_symlink() or not installed.is_file():
                    raise BindingError(
                        "installed PDF missing for "
                        f"{provider}:{leaf}: {installed.relative_to(ROOT)}"
                    )
            counts[status] += 1
    undeclared_records = set(local_records) - declared_records
    if undeclared_records:
        names = ", ".join(
            path.relative_to(ROOT).as_posix()
            for path in sorted(undeclared_records)
        )
        raise BindingError(f"publication records name undeclared providers: {names}")
    if not any(counts.values()):
        raise BindingError("publication record inventory is empty")
    return "records", counts


def publication_clearance_summary(schema: str, counts: dict[str, int]) -> str:
    """The supplement sentence for the status vocabulary actually counted."""
    if schema == "records":
        return (
            f"The approval binds all {counts['alpha']} exact installed public-alpha\n"
            f"PDF snapshots, records {counts['hold']} publication(s) on hold, and binds\n"
        )
    if schema == "legacy":
        return (
            f"The approval binds all {counts['release']} exact installed release\n"
            f"PDF snapshots, all {counts['review']} conspicuously labelled public-alpha\n"
            f"review snapshots, records {counts['hold']} publication(s) on hold, and binds\n"
        )
    raise BindingError(f"unknown publication inventory schema: {schema!r}")


def recognized_site_sources() -> set[str]:
    """Ask the renderer which repository inputs can change the artifact."""
    loader = importlib.machinery.SourceFileLoader("triptych_public_alpha", str(PUBLIC_ALPHA))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise BindingError(f"cannot load {PUBLIC_ALPHA.relative_to(ROOT)}")
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
        module.ROOT = ROOT
        return set(module.site_source_paths())
    except Exception as exc:  # the renderer owns the input set; report it verbatim
        raise BindingError(f"cannot read the recognized site-source set: {exc}")


def recorded_site_sources(authorization: dict) -> dict[str, str]:
    site_sources = authorization.get("site_sources")
    if not isinstance(site_sources, dict) or not site_sources:
        raise BindingError("authorization site_sources must be a non-empty object")
    return site_sources


# A recorded path with no file behind it. A rename produces this, and it is a
# divergence exactly as a changed byte is: the record names something the
# release cannot supply.
ABSENT = "<no such file>"
# A recognized input the record never mentions, and so the one thing an
# exactness-only check cannot see: there is no entry to hash.
UNRECORDED = "<not in the record>"


class Divergence(NamedTuple):
    """One disagreement: kind is stale, missing, unrecorded, or unrecognized."""

    kind: str
    source: str
    recorded: str
    actual: str


def site_source_divergences(authorization: dict) -> list[Divergence]:
    """Every way the site record fails to describe the renderer's inputs.

    The one comparison in this tool. ``status`` reports it, ``refresh``
    rewrites from it, and ``approve`` refuses on it; a second copy would drift
    from this one, and the drift would be invisible because all of them would
    still print a number.

    Three kinds, not one. Hashing the recorded entries answers only whether
    what is written down is current; the recognized set is differenced against
    the record in both directions so that an input nobody recorded and an entry
    nothing renders are divergences too. Only exactness was compared until
    2026-07-31, and twelve recognized inputs — the icon, the social card, the
    six installed reading tracks and the whole catena page — sat outside the
    authorization under a green line the whole time.
    """
    recorded = recorded_site_sources(authorization)
    recognized = recognized_site_sources()
    divergences: list[Divergence] = []
    for source in sorted(recorded):
        path = ROOT / source
        actual = sha256_file(path) if path.is_file() else ABSENT
        if source not in recognized:
            divergences.append(
                Divergence("unrecognized", source, recorded[source], actual)
            )
        elif actual != recorded[source]:
            kind = "missing" if actual == ABSENT else "stale"
            divergences.append(Divergence(kind, source, recorded[source], actual))
    for source in sorted(recognized - set(recorded)):
        path = ROOT / source
        actual = sha256_file(path) if path.is_file() else ABSENT
        divergences.append(Divergence("unrecorded", source, UNRECORDED, actual))
    return sorted(divergences, key=lambda divergence: divergence.source)


def describe(divergence: Divergence) -> str:
    """One line's right-hand side, naming what the record says and what is."""
    if divergence.kind == "unrecorded":
        return (
            f"nothing recorded, actual {divergence.actual}; "
            "`make refresh-release-bindings ADOPT=1` adopts it"
        )
    if divergence.kind == "unrecognized":
        return (
            f"recorded {divergence.recorded}, the renderer no longer reads it; "
            "`make refresh-release-bindings ADOPT=1` retires it"
        )
    detail = "no such file" if divergence.actual == ABSENT else f"actual {divergence.actual}"
    return f"recorded {divergence.recorded}, {detail}"


def compute_site_hashes(
    authorization: dict,
    adopt: bool = False,
    only: list[str] | None = None,
) -> dict[str, str]:
    site_sources = recorded_site_sources(authorization)
    # Refresh re-derives the recorded inputs only; adoption reconciles the
    # record with the set the renderer currently recognizes.
    recognized = recognized_site_sources() if adopt else set()

    def in_scope(source: str) -> bool:
        return only is None or any(
            source == path_only or source.startswith(path_only.rstrip("/") + "/")
            for path_only in only
        )

    if not adopt:
        sources = set(site_sources)
    elif only is None:
        sources = recognized
    else:
        # Scoped adoption may add or retire only within the named paths. Every
        # recorded sibling survives byte-for-byte, and an unrecorded sibling
        # cannot be signed merely because it is visible to the renderer.
        sources = {
            source
            for source in site_sources
            if not in_scope(source) or source in recognized
        }
        sources.update(source for source in recognized if in_scope(source))
    hashes: dict[str, str] = {}
    for source in sorted(sources):
        # Scope is checked before the filesystem. A sibling which was deleted,
        # renamed, or stopped being recognized is still outside this operator's
        # review and must keep its recorded value; refusing because its old file
        # is gone would make a supposedly scoped refresh impossible.
        if only is not None and not in_scope(source):
            held = site_sources.get(source)
            if held is not None:
                hashes[source] = held
                continue
        path = ROOT / source
        if not path.is_file():
            raise BindingError(f"site source missing: {source}")
        # `--only` re-records the named paths and carries every other entry
        # forward at the value it already held.
        #
        # Without it this is all-or-nothing, and in a tree where more than one
        # agent is at work that is not a preference but a fault: adopting your
        # own changed page also adopts whatever half-finished file a sibling
        # happens to have on disk. An authorization is a statement that someone
        # reviewed those bytes, so signing for bytes you have not read is the
        # one thing it must not be able to do by accident.
        hashes[source] = sha256_file(path)
    return hashes


def rewrite_table(text: str, header: str, label: str, rows: list[tuple[str, str]]) -> str:
    pattern = re.compile(
        rf"^{re.escape(header)}\s*$([\s\S]*?)(?=^## |\Z)", flags=re.MULTILINE
    )
    if not pattern.search(text):
        raise BindingError(f"rights record lacks section: {header}")
    body_lines = ["", f"| {label} | SHA-256 |", "| --- | --- |"]
    for key, value in rows:
        body_lines.append(f"| `{key}` | `{value}` |")
    body_lines.append("")
    replacement = header + "\n" + "\n".join(body_lines) + "\n"
    return pattern.sub(lambda _: replacement, text, count=1)


def refresh(manifest: dict, adopt: bool = False, only: list[str] | None = None) -> list[str]:
    changes: list[str] = []
    authorization = single_authorization(manifest)
    record_path = rights_record_path(authorization)

    # Read the divergences before rewriting the record they are measured
    # against; `status` reports this same list without writing anything. Only
    # the stale kind names a rewritten hash: the set differences are reported
    # below as adoptions and retirements, from the same comparison.
    diverged = {
        divergence.source
        for divergence in site_source_divergences(authorization)
        if divergence.kind == "stale"
    }
    site_hashes = compute_site_hashes(authorization, adopt, only)
    recorded = authorization["site_sources"]
    for source in sorted(set(site_hashes) - set(recorded)):
        changes.append(f"adopted site {source}")
    for source in sorted(set(recorded) - set(site_hashes)):
        changes.append(f"retired site {source}")
    # Report what actually moved, not what diverged. Under `--only` a source
    # can be stale and deliberately carried forward, and announcing it as
    # refreshed would describe a write that did not happen.
    for source in sorted(diverged & set(site_hashes) & set(recorded)):
        if site_hashes[source] != recorded[source]:
            changes.append(f"site {source}")
    authorization["site_sources"] = dict(sorted(site_hashes.items()))

    text = record_path.read_text(encoding="utf-8")
    site_rows = sorted(site_hashes.items())
    new_text = rewrite_table(text, SITE_HEADER, "Repository path", site_rows)
    if new_text != text:
        record_path.write_text(new_text, encoding="utf-8")
        changes.append(f"rights tables {record_path.relative_to(ROOT)}")

    record_hash = sha256_file(record_path)
    if authorization.get("rights_record_sha256") != record_hash:
        authorization["rights_record_sha256"] = record_hash
        changes.append("rights_record_sha256")

    save_manifest(manifest)
    return changes


def approve(manifest: dict, note: str, timezone_name: str) -> None:
    note = note.strip()
    if not note:
        raise BindingError("approve requires a non-empty operator instruction note")
    authorization = single_authorization(manifest)
    record_path = rights_record_path(authorization)
    # The supplement below says the approval binds every recognized
    # artifact-affecting input at its current bytes. That is a claim about the
    # record's completeness and currency, so it is computed here instead of
    # asserted: an approval written over a record that omits a recognized input
    # attests a coverage nobody established, and until this refusal existed the
    # sentence was written while nothing had ever called
    # `recognized_site_sources`.
    divergences = site_source_divergences(authorization)
    if divergences:
        named = ", ".join(divergence.source for divergence in divergences[:5])
        more = "" if len(divergences) <= 5 else f", and {len(divergences) - 5} more"
        raise BindingError(
            f"refusing to approve: {len(divergences)} site-source divergence(s) "
            f"({named}{more}). An approval states that every recognized "
            "artifact-affecting input is inventoried at its current bytes; run "
            "`make check-release-bindings` for the full list and "
            "`make refresh-release-bindings ADOPT=1` to settle the record first"
        )
    site_sources = recorded_site_sources(authorization)
    zone = zoneinfo.ZoneInfo(timezone_name)
    now = datetime.datetime.now(tz=zone).replace(microsecond=0)
    publication_schema, counts = publication_status_counts(manifest)
    day = now.strftime("%-d %B %Y")
    supplement = (
        f"## Supplemental exact-current-snapshot clearance — {day}\n\n"
        f"At `{now.isoformat()}` in `{timezone_name}`, the maintainer instructed:\n"
        f"“{note}” This is recorded as perpetual worldwide\n"
        "exact-current-snapshot distribution authorization under the existing\n"
        "represented authority in this record. The sole condition remains\n"
        "`no-project-initiated-promotion`.\n\n"
        + publication_clearance_summary(publication_schema, counts)
        + f"all {len(site_sources)} exact recognized\n"
        "artifact-affecting reader-site inputs inventoried below, which were\n"
        "compared against the renderer's recognized set and their current\n"
        "bytes before this approval was recorded. It is an\n"
        "exact-byte distribution clearance only: it does not represent\n"
        "completion of any outstanding work-specific rights, source,\n"
        "collation, specialist, or ecclesiastical review, and no imprimatur,\n"
        "nihil obstat, or ecclesiastical approval is claimed. Every\n"
        "limitation in the prior supplements, release README, catalogs, and\n"
        "work-specific research records remains operative. This approval does\n"
        "not authorize a push, deployment, tag, history rewrite, public\n"
        "release attachment, announcement, or promotion.\n\n"
    )
    text = record_path.read_text(encoding="utf-8")
    if SNAPSHOT_HEADER not in text:
        raise BindingError(f"rights record lacks section: {SNAPSHOT_HEADER}")
    record_path.write_text(
        text.replace(SNAPSHOT_HEADER, supplement + SNAPSHOT_HEADER, 1),
        encoding="utf-8",
    )
    authorization["approved_on"] = now.date().isoformat()
    authorization["effective_at"] = now.isoformat()
    save_manifest(manifest)
    # Approval re-derives the recorded inventory; widening it stays the
    # separate, explicit adoption step.
    refresh(load_manifest())


def add_publication(
    manifest: dict, provider: str, leaf: str, catalog: str, status: str
) -> str:
    if status not in {"hold", "alpha"}:
        raise BindingError("status must be hold or alpha")
    providers = manifest.get("providers") or [primary_provider(manifest)]
    if provider not in providers:
        raise BindingError(f"provider {provider!r} is not declared in the manifest")
    publication_id = leaf if provider == primary_provider(manifest) else f"{provider}:{leaf}"
    path = ROOT / "pdf" / provider / f"{leaf}.pdf"
    if status == "alpha" and not path.is_file():
        raise BindingError(f"installed PDF missing: {path.relative_to(ROOT)}")
    authorizations = list(manifest.get("authorizations", {}))
    if len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    entry = {
        "schema_version": 1,
        "id": leaf,
        "catalog": catalog,
        "status": status,
        "authorization": authorizations[0] if status == "alpha" else None,
    }
    destination = ROOT / PUBLICATION_RECORD_ROOT / provider / f"{leaf}.json"
    if destination.exists():
        raise BindingError(f"publication record already exists: {destination.relative_to(ROOT)}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(entry, indent=2) + "\n", encoding="utf-8")
    return publication_id


def migrate_publications(manifest: dict) -> int:
    """Move legacy rows to independent records without touching hash tables."""
    authorizations = list(manifest.get("authorizations", {}))
    if len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    migrated = 0
    for publication in manifest.get("publications", []):
        publication_id = publication.get("id")
        provider, leaf = split_id(manifest, publication_id)
        legacy_status = publication.get("status")
        status = "hold" if legacy_status == "hold" else "alpha"
        record = {
            "schema_version": 1,
            "id": leaf,
            "catalog": publication.get("catalog"),
            "status": status,
            "authorization": authorizations[0] if status == "alpha" else None,
        }
        destination = ROOT / PUBLICATION_RECORD_ROOT / provider / f"{leaf}.json"
        destination.parent.mkdir(parents=True, exist_ok=True)
        encoded = json.dumps(record, indent=2) + "\n"
        if destination.exists() and destination.read_text(encoding="utf-8") != encoded:
            raise BindingError(f"conflicting publication record: {destination.relative_to(ROOT)}")
        if not destination.exists():
            destination.write_text(encoded, encoding="utf-8")
            migrated += 1
    manifest.pop("publications", None)
    manifest.pop("expected_counts", None)
    manifest.pop("gates", None)
    save_manifest(manifest)
    return migrated


def report_status(manifest: dict) -> int:
    stale = 0
    authorization = single_authorization(manifest)
    # Site sources are compared here, against their bytes and against the set
    # the renderer recognizes, because nothing else does it. Publication PDF
    # hashes are genuinely generated into the artifact and are not recorded
    # here, but this comment used to say the same of the site sources and drop
    # them from the report. It was wrong twice: the renderer's policy check
    # proves an entry is a well-formed hash naming a file that exists, never
    # that the two correspond, and `refresh` maintains these entries and the
    # artifact publishes them, so they are live records rather than migration
    # history. Between 2026-07-27 and 2026-07-31 the comparison existed only
    # inside `refresh`, which meant the drift could be seen only by performing
    # the write that a lane mid-flight must not do.
    for divergence in site_source_divergences(authorization):
        print(f"{divergence.kind} site source {divergence.source}: {describe(divergence)}")
        stale += 1
    record_path = rights_record_path(authorization)
    if authorization.get("rights_record_sha256") != sha256_file(record_path):
        print("stale rights_record_sha256")
        stale += 1
    print(f"{'stale' if stale else 'exact'}: {stale} stale binding(s)")
    return 1 if stale else 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="release-bindings")
    examples_live_on_the_verbs(parser, "release-bindings")
    subparsers = parser.add_subparsers(dest="command", required=True)
    refresh_parser = with_examples(
        subparsers.add_parser("refresh"),
        EXAMPLES["refresh"],
    )
    refresh_parser.add_argument(
        "--adopt-new-site-sources",
        dest="adopt",
        action="store_true",
        help="reconcile the recorded inputs with the renderer's recognized set",
    )
    refresh_parser.add_argument(
        "--only",
        action="append",
        metavar="PATH",
        help="re-record only this repository path (repeatable; a directory "
        "covers what is under it). Every other entry keeps the value it "
        "already held, so adopting your own work cannot sign for someone "
        "else's unreviewed bytes",
    )
    with_examples(
        subparsers.add_parser("status"),
        EXAMPLES["status"],
    )
    with_examples(
        subparsers.add_parser("migrate-publications"),
        EXAMPLES["migrate-publications"],
    )
    approve_parser = with_examples(
        subparsers.add_parser("approve"),
        EXAMPLES["approve"],
        unavailable=UNAVAILABLE["approve"],
    )
    approve_parser.add_argument("--note", required=True)
    approve_parser.add_argument("--timezone", default="America/Chicago")
    add_parser = with_examples(
        subparsers.add_parser("add-publication"),
        EXAMPLES["add-publication"],
    )
    add_parser.add_argument("--provider", required=True)
    add_parser.add_argument("--id", dest="leaf", required=True)
    add_parser.add_argument("--catalog", required=True)
    add_parser.add_argument("--status", default="hold")
    args = parser.parse_args(argv)
    try:
        manifest = load_manifest()
        if args.command == "refresh":
            changes = refresh(manifest, args.adopt, args.only)
            for change in changes:
                print(f"refreshed {change}")
            print(f"release bindings exact: {len(changes)} change(s)")
        elif args.command == "status":
            return report_status(manifest)
        elif args.command == "migrate-publications":
            migrated = migrate_publications(manifest)
            print(f"migrated {migrated} publication record(s)")
        elif args.command == "approve":
            approve(manifest, args.note, args.timezone)
            print("supplement recorded and bindings refreshed")
        elif args.command == "add-publication":
            publication_id = add_publication(
                manifest, args.provider, args.leaf, args.catalog, args.status
            )
            print(f"added {publication_id} at status {args.status}")
    except BindingError as exc:
        print(f"release-bindings error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
