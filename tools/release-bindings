# `approve` records a dated authorization into the tracked release records.
# There is no scratch target for it and no dry run, so the only invocation that
# can be captured is the refusal. Saying that is better than showing a
# transcript nobody produced.
UNAVAILABLE = {
    "approve": (
        "a successful approve writes a dated authorization into release/, which "
        "cannot be captured without recording a real approval. Only the refusal "
        "is shown."
    ),
}

ROOT = Path(__file__).resolve().parents[1]
MANIFEST = ROOT / "release" / "public-alpha.json"
PUBLIC_ALPHA = Path(__file__).with_name("public-alpha")

SNAPSHOT_HEADER = "## Exact approved snapshots"
SITE_HEADER = "## Exact approved reader-facing site sources"
PUBLICATION_RECORD_ROOT = "release/publications"


class BindingError(Exception):
    pass


def sha256_file(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_manifest() -> dict:
    try:
        return json.loads(MANIFEST.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise BindingError(f"cannot load manifest: {exc}")


def save_manifest(manifest: dict) -> None:
    MANIFEST.write_text(json.dumps(manifest, indent=2) + "\n", encoding="utf-8")


def primary_provider(manifest: dict) -> str:
    provider = manifest.get("provider")
    if not isinstance(provider, str) or not provider:
        raise BindingError("manifest provider must be a non-empty string")
    return provider


def split_id(manifest: dict, publication_id: str) -> tuple[str, str]:
    if ":" in publication_id:
        provider, leaf = publication_id.split(":", 1)
    else:
        provider, leaf = primary_provider(manifest), publication_id
    if not provider or not leaf:
        raise BindingError(f"malformed publication id: {publication_id!r}")
    return provider, leaf


def pdf_path(manifest: dict, publication_id: str) -> Path:
    provider, leaf = split_id(manifest, publication_id)
    return ROOT / "pdf" / provider / f"{leaf}.pdf"


def single_authorization(manifest: dict) -> dict:
    authorizations = manifest.get("authorizations")
    if not isinstance(authorizations, dict) or len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    (authorization,) = authorizations.values()
    if not isinstance(authorization, dict):
        raise BindingError("authorization must be an object")
    return authorization


def rights_record_path(authorization: dict) -> Path:
    record = authorization.get("rights_record")
    if not isinstance(record, str) or not record.startswith("release/rights/"):
        raise BindingError("authorization rights_record must live under release/rights/")
    path = ROOT / record
    if not path.is_file():
        raise BindingError(f"rights record missing: {record}")
    return path


def compute_publication_hashes(manifest: dict) -> dict[str, str]:
    hashes: dict[str, str] = {}
    for publication in manifest.get("publications", []):
        publication_id = publication.get("id")
        if publication.get("status") not in {"release", "review"}:
            continue
        path = pdf_path(manifest, publication_id)
        if not path.is_file():
            raise BindingError(f"installed PDF missing for {publication_id}: {path}")
        hashes[publication_id] = sha256_file(path)
    return hashes


def recognized_site_sources() -> set[str]:
    """Ask the renderer which repository inputs can change the artifact."""
    loader = importlib.machinery.SourceFileLoader("triptych_public_alpha", str(PUBLIC_ALPHA))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    if spec is None or spec.loader is None:
        raise BindingError(f"cannot load {PUBLIC_ALPHA.relative_to(ROOT)}")
    module = importlib.util.module_from_spec(spec)
    try:
        spec.loader.exec_module(module)
        module.ROOT = ROOT
        return set(module.site_source_paths())
    except Exception as exc:  # the renderer owns the input set; report it verbatim
        raise BindingError(f"cannot read the recognized site-source set: {exc}")


def recorded_site_sources(authorization: dict) -> dict[str, str]:
    site_sources = authorization.get("site_sources")
    if not isinstance(site_sources, dict) or not site_sources:
        raise BindingError("authorization site_sources must be a non-empty object")
    return site_sources


# A recorded path with no file behind it. A rename produces this, and it is a
# divergence exactly as a changed byte is: the record names something the
# release cannot supply.
ABSENT = "<no such file>"


def site_source_divergences(authorization: dict) -> list[tuple[str, str, str]]:
    """Every recorded site binding whose file is not what the record says.

    The one comparison in this tool. ``status`` reports it and ``refresh``
    rewrites from it; a second copy would drift from this one, and the drift
    would be invisible because both would still print a number.
    """
    recorded = recorded_site_sources(authorization)
    divergences: list[tuple[str, str, str]] = []
    for source in sorted(recorded):
        path = ROOT / source
        actual = sha256_file(path) if path.is_file() else ABSENT
        if actual != recorded[source]:
            divergences.append((source, recorded[source], actual))
    return divergences


def compute_site_hashes(authorization: dict, adopt: bool = False) -> dict[str, str]:
    site_sources = recorded_site_sources(authorization)
    # Refresh re-derives the recorded inputs only; adoption reconciles the
    # record with the set the renderer currently recognizes.
    sources = recognized_site_sources() if adopt else set(site_sources)
    hashes: dict[str, str] = {}
    for source in sorted(sources):
        path = ROOT / source
        if not path.is_file():
            raise BindingError(f"site source missing: {source}")
        hashes[source] = sha256_file(path)
    return hashes


def rewrite_table(text: str, header: str, label: str, rows: list[tuple[str, str]]) -> str:
    pattern = re.compile(
        rf"^{re.escape(header)}\s*$([\s\S]*?)(?=^## |\Z)", flags=re.MULTILINE
    )
    if not pattern.search(text):
        raise BindingError(f"rights record lacks section: {header}")
    body_lines = ["", f"| {label} | SHA-256 |", "| --- | --- |"]
    for key, value in rows:
        body_lines.append(f"| `{key}` | `{value}` |")
    body_lines.append("")
    replacement = header + "\n" + "\n".join(body_lines) + "\n"
    return pattern.sub(lambda _: replacement, text, count=1)


def refresh(manifest: dict, adopt: bool = False) -> list[str]:
    changes: list[str] = []
    authorization = single_authorization(manifest)
    record_path = rights_record_path(authorization)

    # Read the divergences before rewriting the record they are measured
    # against; `status` reports this same list without writing anything.
    diverged = {source for source, _, _ in site_source_divergences(authorization)}
    site_hashes = compute_site_hashes(authorization, adopt)
    recorded = authorization["site_sources"]
    for source in sorted(set(site_hashes) - set(recorded)):
        changes.append(f"adopted site {source}")
    for source in sorted(set(recorded) - set(site_hashes)):
        changes.append(f"retired site {source}")
    for source in sorted(diverged & set(site_hashes) & set(recorded)):
        changes.append(f"site {source}")
    authorization["site_sources"] = dict(sorted(site_hashes.items()))

    text = record_path.read_text(encoding="utf-8")
    site_rows = sorted(site_hashes.items())
    new_text = rewrite_table(text, SITE_HEADER, "Repository path", site_rows)
    if new_text != text:
        record_path.write_text(new_text, encoding="utf-8")
        changes.append(f"rights tables {record_path.relative_to(ROOT)}")

    record_hash = sha256_file(record_path)
    if authorization.get("rights_record_sha256") != record_hash:
        authorization["rights_record_sha256"] = record_hash
        changes.append("rights_record_sha256")

    save_manifest(manifest)
    return changes


def approve(manifest: dict, note: str, timezone_name: str) -> None:
    note = note.strip()
    if not note:
        raise BindingError("approve requires a non-empty operator instruction note")
    authorization = single_authorization(manifest)
    record_path = rights_record_path(authorization)
    zone = zoneinfo.ZoneInfo(timezone_name)
    now = datetime.datetime.now(tz=zone).replace(microsecond=0)
    counts = {"release": 0, "review": 0, "hold": 0}
    for publication in manifest.get("publications", []):
        status = publication.get("status")
        if status in counts:
            counts[status] += 1
    day = now.strftime("%-d %B %Y")
    supplement = (
        f"## Supplemental exact-current-snapshot clearance — {day}\n\n"
        f"At `{now.isoformat()}` in `{timezone_name}`, the maintainer instructed:\n"
        f"“{note}” This is recorded as perpetual worldwide\n"
        "exact-current-snapshot distribution authorization under the existing\n"
        "represented authority in this record. The sole condition remains\n"
        "`no-project-initiated-promotion`.\n\n"
        f"The approval binds all {counts['release']} exact installed release\n"
        f"PDF snapshots, all {counts['review']} conspicuously labelled public-alpha\n"
        "review snapshots, and every exact recognized artifact-affecting\n"
        "reader-site input inventoried below at their current bytes. It is an\n"
        "exact-byte distribution clearance only: it does not represent\n"
        "completion of any outstanding work-specific rights, source,\n"
        "collation, specialist, or ecclesiastical review, and no imprimatur,\n"
        "nihil obstat, or ecclesiastical approval is claimed. Every\n"
        "limitation in the prior supplements, release README, catalogs, and\n"
        "work-specific research records remains operative. This approval does\n"
        "not authorize a push, deployment, tag, history rewrite, public\n"
        "release attachment, announcement, or promotion.\n\n"
    )
    text = record_path.read_text(encoding="utf-8")
    if SNAPSHOT_HEADER not in text:
        raise BindingError(f"rights record lacks section: {SNAPSHOT_HEADER}")
    record_path.write_text(
        text.replace(SNAPSHOT_HEADER, supplement + SNAPSHOT_HEADER, 1),
        encoding="utf-8",
    )
    authorization["approved_on"] = now.date().isoformat()
    authorization["effective_at"] = now.isoformat()
    save_manifest(manifest)
    # Approval re-derives the recorded inventory; widening it stays the
    # separate, explicit adoption step.
    refresh(load_manifest())


def add_publication(
    manifest: dict, provider: str, leaf: str, catalog: str, status: str
) -> str:
    if status not in {"hold", "alpha"}:
        raise BindingError("status must be hold or alpha")
    providers = manifest.get("providers") or [primary_provider(manifest)]
    if provider not in providers:
        raise BindingError(f"provider {provider!r} is not declared in the manifest")
    publication_id = leaf if provider == primary_provider(manifest) else f"{provider}:{leaf}"
    path = ROOT / "pdf" / provider / f"{leaf}.pdf"
    if status == "alpha" and not path.is_file():
        raise BindingError(f"installed PDF missing: {path.relative_to(ROOT)}")
    authorizations = list(manifest.get("authorizations", {}))
    if len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    entry = {
        "schema_version": 1,
        "id": leaf,
        "catalog": catalog,
        "status": status,
        "authorization": authorizations[0] if status == "alpha" else None,
    }
    destination = ROOT / PUBLICATION_RECORD_ROOT / provider / f"{leaf}.json"
    if destination.exists():
        raise BindingError(f"publication record already exists: {destination.relative_to(ROOT)}")
    destination.parent.mkdir(parents=True, exist_ok=True)
    destination.write_text(json.dumps(entry, indent=2) + "\n", encoding="utf-8")
    return publication_id


def migrate_publications(manifest: dict) -> int:
    """Move legacy rows to independent records without touching hash tables."""
    authorizations = list(manifest.get("authorizations", {}))
    if len(authorizations) != 1:
        raise BindingError("expected exactly one manifest authorization")
    migrated = 0
    for publication in manifest.get("publications", []):
        publication_id = publication.get("id")
        provider, leaf = split_id(manifest, publication_id)
        legacy_status = publication.get("status")
        status = "hold" if legacy_status == "hold" else "alpha"
        record = {
            "schema_version": 1,
            "id": leaf,
            "catalog": publication.get("catalog"),
            "status": status,
            "authorization": authorizations[0] if status == "alpha" else None,
        }
        destination = ROOT / PUBLICATION_RECORD_ROOT / provider / f"{leaf}.json"
        destination.parent.mkdir(parents=True, exist_ok=True)
        encoded = json.dumps(record, indent=2) + "\n"
        if destination.exists() and destination.read_text(encoding="utf-8") != encoded:
            raise BindingError(f"conflicting publication record: {destination.relative_to(ROOT)}")
        if not destination.exists():
            destination.write_text(encoded, encoding="utf-8")
            migrated += 1
    manifest.pop("publications", None)
    manifest.pop("expected_counts", None)
    manifest.pop("gates", None)
    save_manifest(manifest)
    return migrated


def report_status(manifest: dict) -> int:
    stale = 0
    authorization = single_authorization(manifest)
    # Site sources are compared here, against their bytes, because nothing else
    # does it. Publication PDF hashes are genuinely generated into the artifact
    # and are not recorded here, but this comment used to say the same of the
    # site sources and drop them from the report. It was wrong twice: the
    # renderer's policy check proves an entry is a well-formed hash naming a
    # file that exists, never that the two correspond, and `refresh` maintains
    # these entries and the artifact publishes them, so they are live records
    # rather than migration history. Between 2026-07-27 and this change the
    # comparison existed only inside `refresh`, which meant the drift could be
    # seen only by performing the write that a lane mid-flight must not do.
    for source, recorded, actual in site_source_divergences(authorization):
        detail = "no such file" if actual == ABSENT else f"actual {actual}"
        label = "missing" if actual == ABSENT else "stale"
        print(f"{label} site source {source}: recorded {recorded}, {detail}")
        stale += 1
    record_path = rights_record_path(authorization)
    if authorization.get("rights_record_sha256") != sha256_file(record_path):
        print("stale rights_record_sha256")
        stale += 1
    print(f"{'stale' if stale else 'exact'}: {stale} stale binding(s)")
    return 1 if stale else 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="release-bindings")
    examples_live_on_the_verbs(parser, "release-bindings")
    subparsers = parser.add_subparsers(dest="command", required=True)
    refresh_parser = with_examples(
        subparsers.add_parser("refresh"),
        EXAMPLES["refresh"],
    )
    refresh_parser.add_argument(
        "--adopt-new-site-sources",
        dest="adopt",
        action="store_true",
        help="reconcile the recorded inputs with the renderer's recognized set",
    )
    with_examples(
        subparsers.add_parser("status"),
        EXAMPLES["status"],
    )
    with_examples(
        subparsers.add_parser("migrate-publications"),
        EXAMPLES["migrate-publications"],
    )
    approve_parser = with_examples(
        subparsers.add_parser("approve"),
        EXAMPLES["approve"],
        unavailable=UNAVAILABLE["approve"],
    )
    approve_parser.add_argument("--note", required=True)
    approve_parser.add_argument("--timezone", default="America/Chicago")
    add_parser = with_examples(
        subparsers.add_parser("add-publication"),
        EXAMPLES["add-publication"],
    )
    add_parser.add_argument("--provider", required=True)
    add_parser.add_argument("--id", dest="leaf", required=True)
    add_parser.add_argument("--catalog", required=True)
    add_parser.add_argument("--status", default="hold")
    args = parser.parse_args(argv)
    try:
        manifest = load_manifest()
        if args.command == "refresh":
            changes = refresh(manifest, args.adopt)
            for change in changes:
                print(f"refreshed {change}")
            print(f"release bindings exact: {len(changes)} change(s)")
        elif args.command == "status":
            return report_status(manifest)
        elif args.command == "migrate-publications":
            migrated = migrate_publications(manifest)
            print(f"migrated {migrated} publication record(s)")
        elif args.command == "approve":
            approve(manifest, args.note, args.timezone)
            print("supplement recorded and bindings refreshed")
        elif args.command == "add-publication":
            publication_id = add_publication(
                manifest, args.provider, args.leaf, args.catalog, args.status
            )
            print(f"added {publication_id} at status {args.status}")
    except BindingError as exc:
        print(f"release-bindings error: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
