def load_calendar(root: Path, calendar: str, effective: bool = True) -> dict:
    """The calendar's document; for a recension, the base with departures applied.

    The derivation lives in `scripts/_calendars.py` and is shared with the
    calendar-mass check and the browser's structure pass, so a recension the
    validator accepts and a recension the site serves cannot come apart. A
    calendar declaring no base is returned exactly as it sits on disk.

    `effective=False` is the census's call, and the distinction is the point: a
    census of the merged document would report the base's mass count under the
    recension's name, and a projection is measured by its diff.
    """
    return _calendars.load_document(root, calendar, effective=effective)


def calendars(root: Path) -> list[str]:
    if not root.is_dir():
        raise ValueError(f"calendar root is missing: {root}")
    return sorted(p.name for p in root.iterdir() if (p / INDEX).is_file())


def masses_of(document: dict) -> list[tuple[str, dict]]:
    """Yield (kind, mass) from the one canonical container, in section order."""
    out: list[tuple[str, dict]] = []
    for _, body in sorted((document.get("sections") or {}).items()):
        if not isinstance(body, dict):
            continue
        kind = str(body.get("kind") or "")
        for mass in body.get("masses") or []:
            if isinstance(mass, dict):
                out.append((kind, mass))
    return out


def propers_of(mass: dict) -> list[tuple[str, dict]]:
    """Yield (form, proper); a mass with seasonal forms labels each one."""
    out = [("", proper) for proper in (mass.get("propers") or []) if isinstance(proper, dict)]
    for form in mass.get("forms") or []:
        if not isinstance(form, dict):
            continue
        label = str(form.get("name") or "form")
        out.extend(
            (label, proper) for proper in (form.get("propers") or []) if isinstance(proper, dict)
        )
    return out


# The reformed Lectionary reads on two courses, and a proper varying by either
# holds its readings under one of these keys: `cycles` for the Sunday course
# lettered A/B/C, `weekday_cycles` for the two-year ferial course of Ordinary
# Time numbered I/II. They are separate keys because they are separate cycles —
# `src/sources/calendars/README.md` owns that rule — and every walk over one of
# them here walks both, so that a course this tool did not know about could not
# be silently dropped from a citation count, a psalm conversion or a page.
CYCLES_KEY = "cycles"
WEEKDAY_CYCLES_KEY = "weekday_cycles"
CYCLE_KEYS = (CYCLES_KEY, WEEKDAY_CYCLES_KEY)


def cycle_owners(proper: dict) -> list[tuple[str, str, dict]]:
    """Every (course key, cycle, owner) one proper's reading courses hold.

    One proper reads on at most one course — the calendar-mass check refuses
    both keys together — so the list is a single course's cycles in practice,
    and reading it as a list is what keeps that fact from being restated here.
    """
    return [
        (key, str(cycle), owner)
        for key in CYCLE_KEYS
        for cycle, owner in (proper.get(key) or {}).items()
        if isinstance(owner, dict)
    ]


def appointed_propers(document: dict, mass: dict) -> list[tuple[str, dict, dict | None]]:
    """The propers a mass actually appoints, references followed.

    `propers_of` reads what the entry *carries*; this reads what the day *uses*.
    They differ wherever the Missal prints a pointer instead of a formulary — a
    feria taking the preceding Sunday, a saint taking a Mass of the Common — and
    keeping the two verbs apart is what lets the census count the file honestly
    while the reader is shown the Mass.

    The derivation lives in `scripts/_calendars.py` and is shared with
    the calendar-mass check, so a reference the browser resolves and a reference
    the gate accepts cannot come apart.
    """
    entries, problems = _calendars.resolve_propers(document, mass)
    if problems:
        raise ValueError("; ".join(dict.fromkeys(problems)))
    return entries


def load_bible(name: str, root: Path) -> dict:
    """Resolve an indexed bible, keyed by the citations-encoded passage."""
    path = root / name / "index.yaml"
    if not path.is_file():
        available = (
            sorted(p.name for p in root.iterdir() if (p / "index.yaml").is_file())
            if root.is_dir()
            else []
        )
        raise ValueError(
            f"no indexed bible {name!r} at {path}"
            + (f"; available: {', '.join(available)}" if available else "; none are indexed yet")
        )
    document = _calendars.read_yaml(path) or {}
    return {
        "numbering": document.get("numbering"),
        "edition": document.get("edition"),
        "passages": {str(k): v for k, v in (document.get("passages") or {}).items()},
    }


def find_mass(root: Path, calendar: str, key: str) -> dict:
    document = load_calendar(root, calendar)
    for kind, mass in masses_of(document):
        if mass.get("key") == key:
            payload = {
                "calendar": calendar,
                "edition": document.get("edition"),
                "psalm_numbering": document.get("psalm_numbering"),
                "kind": mass.get("kind") or kind,
                "mass": mass,
                # The document, so a caller can resolve what the entry only
                # points at. It is popped before the payload is serialised: the
                # entry stays exactly as the file records it, and `--format
                # yaml` stays a view of the source rather than of a resolution.
                "_document": document,
            }
            # Aggregate recension boundaries belong beside every projected
            # formulary.  A per-Mass stamp identifies where this entry came
            # from, while these source-owned records say how much of the target
            # recension has actually been established.
            for field in (
                "advisory",
                _calendars.RECENSION_ACT,
                _calendars.RECENSION_COVERAGE,
            ):
                if field in document:
                    payload[field] = document[field]
            return payload
    raise KeyError(f"{calendar}: no mass with key {key!r}")


# A translation is someone's expression, and tracking one is not the same as
# being allowed to publish it. Only these bases may reach the public artifact;
# `licensed` and `permission` are tracked deliberately, but both are withheld.
# A grant for one surface is not permission for the generated JSON, its public
# Git history, a downloadable artifact, or CLI output.  Those surfaces need a
# separately recorded distribution basis; an acknowledgement cannot widen one.
PUBLISHABLE_RIGHTS = ("public-domain", "project-created")
GOSPEL_PROPER_NAMES = frozenset(
    {"Gospel Acclamation", "Verse before the Gospel", "Verse Before the Gospel"}
)
MISSAL_MUSIC_SOURCE_SCOPE = ".music-for-the-roman-missal."


def translation_is_publishable(proper: dict, translation: dict) -> bool:
    """Whether one translation may reach a public projection.

    A rights token is necessary but not sufficient.  ``Music for the Roman
    Missal`` is not a Lectionary exemplar, so an accidentally loosened token
    must not publish a Gospel verse under that source identity.
    """

    if translation.get("rights") not in PUBLISHABLE_RIGHTS:
        return False
    return not (
        proper.get("name") in GOSPEL_PROPER_NAMES
        and MISSAL_MUSIC_SOURCE_SCOPE
        in str(translation.get("source_id") or "")
    )


def publishable_translations(proper: dict):
    """The translations a proper may carry into the public artifact.

    The structure file feeds the browser and the browser is the published site,
    so a translation that reaches this function reaches the world. Copying every
    translation through regardless of its `rights` would put a licensed text on
    the site as a side effect of an ordinary build, silently and with no step at
    which anyone decided to publish it. A missing basis is treated as withheld
    rather than as permission: an unstated right is not a granted one.
    """
    held = proper.get("translations") or []
    kept = [
        translation
        for translation in held
        if isinstance(translation, dict)
        and translation_is_publishable(proper, translation)
    ]
    return kept or None


def unavailable_translation_states(proper: dict) -> list[dict]:
    """Text-free states for translation languages withheld on rights grounds.

    These records deliberately omit the witness id, rights token and wording.
    They say why a requested language is unavailable without copying either a
    restricted offer or rights metadata that a later public-surface validator
    must interpret correctly.  One row per language is enough: this is an
    availability statement, not a shadow translation manifest.
    """
    languages = {
        str(translation.get("lang") or "und")
        for translation in proper.get("translations") or []
        if isinstance(translation, dict)
        and not translation_is_publishable(proper, translation)
    }
    return [
        {
            "target": str(proper.get("name") or "Proper"),
            "lang": lang,
            "state": "rights-restricted",
        }
        for lang in sorted(languages)
    ]


def public_latin_state(latin: dict, target: str) -> dict:
    """Collapse an unavailable Latin audit to a neutral public state."""

    if not latin.get("withheld") and latin.get("state") != "unavailable":
        return latin
    return {
        "target": target or "Proper",
        "state": "unavailable",
        "held": False,
        "available": False,
        "withheld": bool(latin.get("withheld")),
    }


def rights_safe_copy(value):
    """Recursively remove restricted translation offers from a CLI payload.

    `show` returns both its resolved `appointed` list and the source mass.  A
    top-level filter on the former would therefore leave the same words in the
    latter (and in nested forms).  Sanitising every translations container
    makes the machine forms obey the same rule as the reading view.
    """
    if isinstance(value, list):
        return [rights_safe_copy(item) for item in value]
    if not isinstance(value, dict):
        return value
    copied = {key: rights_safe_copy(item) for key, item in value.items()}
    if isinstance(value.get("translations"), list):
        copied["translations"] = publishable_translations(value)
        unavailable = unavailable_translation_states(value)
        if unavailable:
            copied["unavailable_translations"] = unavailable
    if isinstance(value.get("untranslated"), list):
        copied["untranslated"] = public_untranslated_records(value["untranslated"])
    if isinstance(value.get("text_status"), dict):
        copied["text_status"] = public_text_status(value["text_status"])
    if isinstance(value.get("common_from"), dict):
        copied["common_from"] = public_common_from(value["common_from"])
    if isinstance(value.get("latin"), dict):
        copied["latin"] = public_latin_state(
            value["latin"], str(value.get("name") or "Proper")
        )
    if _calendars.ORDINARY_DISPOSITION in value:
        copied[_calendars.ORDINARY_DISPOSITION] = public_ordinary_disposition(
            value[_calendars.ORDINARY_DISPOSITION]
        )
    return copied


def public_text_status(status: dict) -> dict:
    """Project a typed absence without its source-side rights audit."""

    return {
        key: status.get(key)
        for key in ("state", "scope")
        if status.get(key) is not None
    }


def public_ordinary_frame(value: object) -> dict:
    """Project one explicit Ordinary frame without weakening its identity."""

    if not isinstance(value, dict):
        raise ValueError("ordinary_frame must be an exact mapping")
    unknown = sorted(str(key) for key in value if key not in {"applicability", "basis"})
    if unknown:
        raise ValueError(
            "ordinary_frame carries unknown field(s) " + ", ".join(unknown)
        )
    applicability = value.get("applicability")
    if applicability not in ("full", "none", "unavailable"):
        raise ValueError(
            "ordinary_frame.applicability must be full, none, or unavailable"
        )
    basis = value.get("basis")
    if applicability != "full" and (
        not isinstance(basis, str) or not basis.strip()
    ):
        raise ValueError(
            f"ordinary_frame {applicability!r} must carry a nonempty string basis"
        )
    if "basis" in value and (not isinstance(basis, str) or not basis.strip()):
        raise ValueError("ordinary_frame.basis must be a nonempty string")
    projected = {"applicability": applicability}
    if "basis" in value:
        projected["basis"] = basis
    return projected


def public_ordinary_disposition(value: object) -> dict:
    """Project exact source-authored alternative/out-of-frame row semantics."""

    return _calendars.validate_ordinary_disposition(value)


def public_common_from(common: dict) -> dict:
    """Keep only the structural Common choice, never its protected evidence."""

    scope = common.get("scope")
    if scope != "missal-antiphons":
        raise ValueError(
            "common_from.scope must be 'missal-antiphons'; a Common direction "
            "from the Antiphonary establishes no oration"
        )

    projected = {
        "scope": scope,
        "options": [
            {
                key: option.get(key)
                for key in ("mass", "form_id", "selection")
                if option.get(key) is not None
            }
            for option in (common.get("options") or [])
            if isinstance(option, dict)
        ],
    }
    return {key: value for key, value in projected.items() if value is not None}


def public_common_sets(value: dict) -> dict:
    """Project Common-set definitions or reference dispositions exactly."""

    projected = {}
    for group_id, group in value.items():
        if not isinstance(group_id, str) or not isinstance(group, dict):
            continue
        if "families" in group or "options" in group:
            projected[group_id] = {
                "families": [
                    family
                    for family in (group.get("families") or [])
                    if isinstance(family, str)
                ],
                "options": {
                    option_id: [
                        member for member in members if isinstance(member, str)
                    ]
                    for option_id, members in (group.get("options") or {}).items()
                    if isinstance(option_id, str) and isinstance(members, list)
                },
            }
            continue
        projected[group_id] = {
            key: (
                [candidate for candidate in group[key] if isinstance(candidate, str)]
                if key == "candidates" and isinstance(group.get(key), list)
                else group.get(key)
            )
            for key in ("state", "option", "candidates")
            if key in group
        }
    return projected


def public_reference(reference: object) -> dict | None:
    """Project a source pointer with its typed Common-set disposition."""

    if not isinstance(reference, dict):
        return None
    projected = {
        key: reference.get(key)
        for key in ("mass", "form", "proper", "citation", "note")
        if reference.get(key) is not None
    }
    if isinstance(reference.get(_calendars.COMMON_SETS), dict):
        projected[_calendars.COMMON_SETS] = public_common_sets(
            reference[_calendars.COMMON_SETS]
        )
    return projected


def withheld_translations(mass: dict):
    """Every translation the structure pass refuses to publish, for reporting.

    Withholding silently would be the same defect in a quieter coat: the
    operator needs to see that the corpus holds English the site is not showing.

    The witness is named and not only the language, because a proper may hold
    two English translations: "en withheld" would no longer say which one.
    """
    for proper in mass.get("propers") or []:
        for translation in proper.get("translations") or []:
            if not isinstance(translation, dict):
                continue
            if translation.get("rights") not in PUBLISHABLE_RIGHTS:
                yield (
                    proper.get("name"),
                    translation.get("lang"),
                    translation.get("source_id"),
                    translation.get("rights"),
                )


def witness_of(translation: dict) -> tuple[str, str]:
    """The (language, witness) pair a translation is filed under.

    A translation naming no source is the project's own, and the project speaks
    once per language, so the empty id is a real and unambiguous key rather than
    a missing one.
    """
    lang = str(translation.get("lang") or "")
    source_id = translation.get("source_id")
    return lang, str(source_id) if isinstance(source_id, str) else ""


def public_witness_caution(value: object) -> str | None:
    """Return neutral caution prose, excluding protected-provider study prose."""

    caution = str(value or "").strip()
    if not caution:
        return None
    if (
        "ICEL" in caution
        or "International Commission on English in the Liturgy" in caution
    ):
        return None
    return caution


def translation_manifest(masses: list[dict], witnesses: dict) -> list[dict]:
    """The witnesses a page may offer for this calendar's orations, in order.

    This is the propers' answer to `bibles.json`, and it is here rather than in
    a file of its own because a witness is a property of one missal: the rights
    position differs sharply between the two, the coverage differs with it, and
    a page has already fetched this file by the time it can offer anything. The
    load-bearing property of `bibles.json` is kept exactly — the list is
    *derived from what was actually published*, so it cannot name a translation
    the structure pass withheld, and a page cannot offer what it does not hold.

    Order is `(lang, -held, source_id)`: within a language the witness that
    reaches the most of the missal comes first, and ties break on the id so the
    file is byte-stable. That order is also the documented default. A consumer
    that reads the manifest and one that simply takes the first translation in
    the language it wants land on the same witness, because `calendar_structure`
    sorts every proper's list the same way — so the default is deterministic
    whether or not a page has been taught about the manifest yet.

    Coverage is counted, not assumed. Partial coverage is expected to be
    permanent — 160 of 636 English orations here — and a reader offered a
    choice is owed the figure rather than a control implying completeness.
    """
    units = [
        owner
        for mass in masses
        for proper in mass["propers"]
        for owner in (
            [proper]
            + [
                cycle_owner
                for course in CYCLE_KEYS
                for cycle_owner in (proper.get(course) or {}).values()
                if isinstance(cycle_owner, dict)
            ]
        )
    ]
    composed = sum(
        1
        for owner in units
        # `latin` records a body withheld from this public projection.  It is
        # still a composed slot for translation-coverage arithmetic.
        if owner.get("text") or owner.get("latin")
    )
    held: dict[tuple[str, str], int] = {}
    carried: dict[tuple[str, str], dict] = {}
    for owner in units:
        for translation in owner.get("translations") or []:
            key = witness_of(translation)
            held[key] = held.get(key, 0) + 1
            carried.setdefault(key, translation)
    rows = []
    for (lang, source_id), count in held.items():
        witness = witnesses.get(source_id) or {}
        caution = public_witness_caution(witness.get("caution"))
        rows.append(
            {
                "lang": lang,
                # Empty for the project's own work, which names no source; the
                # key is still the pair, so the field is present either way.
                "source_id": source_id,
                # The witness as it should be cited. Taken from the calendar's
                # own record of its sources where there is one, because that is
                # where the label was written; an id with no such record is
                # shown as itself rather than under an invented name.
                "label": str(witness.get("label") or source_id or "This project"),
                "rights": carried[(lang, source_id)].get("rights"),
                # What the reader must be told before weighing the text: a
                # pre-1955 hand missal is not an approved liturgical
                # translation, and the caution travels with the offer.
                "caution": caution,
                # The notice a rightsholder's grant is conditioned on. It rides
                # on the witness row, beside the label and the caution, so it
                # cannot be separated from the words it covers by any renderer
                # that shows one and not the other.
                "acknowledgement": witness.get("acknowledgement"),
                "held": count,
                "composed": composed,
            }
        )
    return sorted(rows, key=lambda row: (row["lang"], -row["held"], row["source_id"]))


# Capability and provenance answer different questions. These rows say only
# what a generated Proper unit can render in a requested language; they never
# say which edition attests the Latin or widen a translation's rights basis.
PROPER_LANGUAGES = ("la", "en")
LANGUAGE_STATUSES = (
    "full-text",
    "withheld",
    "unavailable",
    "rights-withheld",
    "scripture-delegated",
    "fallback-latin",
    "incipit-only",
    "absent",
)


def whole_unit_untranslated(
    proper: dict, lang: str, cycle: str = "all"
) -> list[dict]:
    """Typed untranslated rows that apply to the whole unit, not one cycle."""

    recorded = proper.get("untranslated")
    if recorded is True:
        # Compatibility for callers constructing the pre-typed shape.
        return [{"lang": lang, "availability": "unavailable"}]
    if isinstance(recorded, dict):
        recorded = [recorded]
    return [
        row
        for row in (recorded or [])
        if isinstance(row, dict)
        and row.get("lang", lang) == lang
        and str(
            row.get("cycle")
            or (
                row.get("target", {}).get("cycle")
                if isinstance(row.get("target"), dict)
                else None
            )
            or cycle
        )
        == cycle
    ]


def proper_language_capabilities(
    proper: dict, cycle: str = "all"
) -> list[dict]:
    """The mutually exclusive language state of one generated Proper unit.

    `held` means the requested language's full body is available to this
    assembled corpus. A public typed absence is never held merely because its
    source-side audit retains a fingerprint or a rights finding. `available`
    is narrower for Latin whose source body is held but publication remains
    unresolved. An incipit therefore remains an
    `incipit-only` fragment, and showing Latin after an English request remains
    `fallback-latin`; neither is allowed to masquerade as held English.
    """

    translations = [
        row for row in (proper.get("translations") or []) if isinstance(row, dict)
    ]
    unavailable = [
        row
        for row in (proper.get("unavailable_translations") or [])
        if isinstance(row, dict)
    ]
    sources = proper_sources(proper)
    scripture_only = bool(sources) and sources <= {"scripture"}

    rows = []
    for lang in PROPER_LANGUAGES:
        translated = any(
            row.get("lang") == lang and bool(row.get("text")) for row in translations
        )
        restricted = any(row.get("lang") == lang for row in unavailable)
        source_body = lang == "la" and bool(proper.get("text"))
        latin_withheld = (
            lang == "la"
            and isinstance(proper.get("latin"), dict)
            and bool(proper["latin"].get("withheld"))
        )
        latin_unavailable = (
            lang == "la"
            and isinstance(proper.get("latin"), dict)
            and proper["latin"].get("state") == "unavailable"
            and not bool(proper["latin"].get("held"))
        )

        if proper.get("name") == PLACEHOLDER:
            status, held, available, reason = "absent", False, False, "placeholder"
        elif source_body or translated:
            status, held, available, reason = "full-text", True, True, None
        elif latin_withheld:
            status, held, available, reason = (
                "unavailable",
                False,
                False,
                "text-withheld",
            )
        elif latin_unavailable:
            status, held, available, reason = (
                "unavailable",
                False,
                False,
                None,
            )
        elif restricted:
            status, held, available, reason = (
                "rights-withheld",
                False,
                False,
                "rights-restricted",
            )
        elif scripture_only:
            status, held, available, reason = (
                "scripture-delegated",
                False,
                False,
                "delegated-to-scripture",
            )
        elif lang != "la" and proper.get("text"):
            untranslated = whole_unit_untranslated(proper, lang, cycle)
            status, held, available, reason = (
                "fallback-latin",
                False,
                False,
                (
                    {"kind": "ledgered-untranslated", "records": untranslated}
                    if untranslated
                    else {"kind": "no-translation-recorded"}
                ),
            )
        elif proper.get("incipit"):
            status, held, available, reason = (
                "incipit-only",
                False,
                False,
                "incipit-only",
            )
        else:
            status, held, available, reason = (
                "absent",
                False,
                False,
                "no-text-recorded",
            )
        rows.append(
            {
                "lang": lang,
                "status": status,
                "held": held,
                "available": available,
                "reason": reason,
            }
        )
    return rows


def language_capability(masses: list[dict]) -> list[dict]:
    """Aggregate per-Proper states without turning fallback into coverage."""

    rows = []
    for lang in PROPER_LANGUAGES:
        counts = {status.replace("-", "_"): 0 for status in LANGUAGE_STATUSES}
        for mass in masses:
            for proper in mass.get("propers") or []:
                state = next(
                    row
                    for row in (proper.get("languages") or [])
                    if row.get("lang") == lang
                )
                counts[str(state["status"]).replace("-", "_")] += 1
        rows.append(
            {
                "lang": lang,
                "units": sum(counts.values()),
                # Held and public-available are different: a restricted body is
                # present in the source library but absent from this artifact.
                "held": counts["full_text"] + counts["withheld"],
                "available": counts["full_text"],
                **counts,
            }
        )
    return rows


def numbered_proper_entries(proper: dict, default: str | None):
    """Yield (entry, numbering) for every citation one Proper makes.

    A calendar declares one psalm numbering, but a single book need not keep to
    it: the postconciliar Missal's antiphons reproduce the number printed in the
    Missal while its responsorial psalms take the Lectionary's, which is what
    the recovered citation_convention says and why eleven antiphons resolved to
    verses that do not exist. A proper may therefore declare its own, and its
    cycles may differ again; what it does not declare it inherits. Both reading
    courses inherit alike: a weekday-cycle reading is as much a Lectionary
    citation as a Sunday-cycle one, and the numbering it is read under is the
    proper's unless the cycle itself says otherwise.
    """
    inherited = proper.get("psalm_numbering") or default
    owners = [(proper, inherited)] + [
        (owner, owner.get("psalm_numbering") or inherited)
        for _, _, owner in cycle_owners(proper)
    ]
    for owner, numbering in owners:
        for entry in owner.get("verses") or []:
            if isinstance(entry, dict) and entry.get("ref"):
                yield entry, numbering


def numbered_entries(mass: dict, default: str | None):
    """Yield numbered citations for every Proper the mass directly carries."""
    for _, proper in propers_of(mass):
        yield from numbered_proper_entries(proper, default)


def locus_of(entry: dict) -> tuple[int | None, int | None]:
    """The first chapter and verse a reference names, taken from its ranges."""
    for span in entry.get("ranges") or []:
        begin = span.get("begin") if isinstance(span, dict) else None
        if isinstance(begin, dict) and begin.get("chapter") is not None:
            verse = begin.get("verse")
            return int(begin["chapter"]), (None if verse is None else int(verse))
    return None, None


def renumber(ref: str, chapter: int) -> str:
    """Rewrite a citation onto another chapter, keeping its verses."""
    return CHAPTER.sub(lambda match: f"{match.group(1)}{chapter}", ref, count=1)


def resolve_entry(entry: dict, passages: dict, source: str, target: str) -> dict:
    """Look one reference up, converting its psalm chapter when systems differ."""
    ref = str(entry["ref"])
    book = str(entry.get("book") or "")
    chapter, verse = locus_of(entry)
    if source == target or book != PSALMS or chapter is None:
        return {"text": passages.get(ref), "note": ""}
    try:
        converted, caveat = convert_reference(book, chapter, source, target, verse)
    except NumberingError as error:
        # A split psalm without a verse has no one answer; say so, guess nothing.
        return {"text": None, "note": f"not resolved: {error}"}
    if converted == chapter:
        return {"text": passages.get(ref), "note": caveat}
    key = renumber(ref, converted)
    note = f"{target}: {key}" + (f"; {caveat}" if caveat else "")
    return {"text": passages.get(key), "note": note}


def resolve_passages(
    payload: dict,
    bible: dict,
    appointed: list[tuple[str, dict, dict | None]],
) -> dict:
    """Map every appointed citation to the bible's text and any caveat."""
    source, target = payload.get("psalm_numbering"), bible.get("numbering")
    rows = [
        numbered
        for _, proper, _ in appointed
        for numbered in numbered_proper_entries(proper, source)
    ]
    for system, whose in (
        (source, "calendar"),
        (target, "bible"),
        *((numbering, f"citation {entry['ref']!r}") for entry, numbering in rows),
    ):
        if system not in SYSTEMS:
            raise ValueError(
                f"the {whose} declares unknown psalm numbering {system!r}; "
                f"expected one of {', '.join(SYSTEMS)}"
            )

    resolved: dict[str, dict] = {}
    for entry, numbering in rows:
        ref = str(entry["ref"])
        answer = resolve_entry(entry, bible["passages"], numbering, target)
        if ref in resolved and resolved[ref] != answer:
            raise ValueError(
                f"citation {ref!r} is appointed under incompatible psalm numbering"
            )
        resolved[ref] = answer
    return resolved


BOOK_INDEX = (
    ROOT / "src/sources/works/english-college-of-douay/douay-rheims-bible/editions"
    "/challoner-gutenberg-1581/artifacts"
)


def book_tokens() -> dict[str, str]:
    """Canonical book name to the token the chapter fragments are filed under.

    Every edition in this library addresses a book by the same token, because
    each one's book index is built from the Douay-Rheims's. A structure file is
    therefore edition-independent; an edition that chose its own tokens would
    break that and would need its own loci.
    """
    import csv

    found = sorted(BOOK_INDEX.glob("book-index-*/book-index.tsv"))
    if len(found) != 1:
        raise ValueError(f"expected one book index under {BOOK_INDEX}, found {len(found)}")
    with found[0].open(encoding="utf-8", newline="") as handle:
        return {row["modern_name"]: row["token"] for row in csv.DictReader(handle, delimiter="\t")}


def spans_in(entry: dict, source: str, target: str) -> list[dict]:
    """One citation's ranges as explicit loci in `target` numbering."""
    book = str(entry.get("book") or "")
    loci: list[dict] = []
    for span in entry.get("ranges") or []:
        if not isinstance(span, dict):
            continue
        converted, _ = convert_range(book, span.get("begin") or {}, span.get("end"), source, target)
        for piece in converted:
            loci.extend(range_to_loci(piece.get("begin") or {}, piece.get("end") or {}))
    return loci


def citation_structure(entry: dict, source: str, tokens: dict[str, str]) -> dict:
    """A citation with its verses resolved in both numbering systems.

    Resolved here rather than in the browser so that no numbering logic ships
    to the page: a reader picks a translation, reads its numbering, and takes
    the loci already computed for it. A citation that cannot be converted
    carries the reason and no loci, because a page that renders nothing is
    better than one that renders the wrong psalm.
    """
    book = str(entry.get("book") or "")
    structure = {
        "ref": str(entry["ref"]),
        "book": book,
        "token": tokens.get(book),
        "loci": {},
        "unresolved": None,
    }
    if structure["token"] is None:
        structure["unresolved"] = f"no book named {book!r} in this library"
        return structure
    for target in SYSTEMS:
        try:
            structure["loci"][target] = spans_in(entry, source, target)
        except NumberingError as error:
            structure["loci"] = {}
            structure["unresolved"] = str(error)
            return structure
    return structure


