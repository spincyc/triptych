#!/usr/bin/env python3
"""Print one mass's propers as YAML, JSON, or a reading view.

Reads the canonical `sections` container in a calendar's `propers.yaml`; the
mass list is not duplicated elsewhere.
"""
from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

from _psalms import (  # noqa: E402
    PSALMS,
    SYSTEMS,
    NumberingError,
    convert_range,
    convert_reference,
)
from _loci import range_to_loci  # noqa: E402
from _tooling import print_json, run_verb_cli  # noqa: E402

DEFAULT_ROOT = ROOT / "src" / "sources" / "calendars"
BIBLE_ROOT = ROOT / "src" / "sources" / "bibles"
INDEX = "propers.yaml"
WIDTH = 78
# The chapter of a reference is its first number: "Psalm 25:1-3" is chapter 25.
CHAPTER = re.compile(r"^(\D*?)(\d+)")


def load_calendar(root: Path, calendar: str) -> dict:
    import yaml

    path = root / calendar / INDEX
    if not path.is_file():
        raise ValueError(f"no calendar index at {path}")
    document = yaml.safe_load(path.read_text(encoding="utf-8"))
    if not isinstance(document, dict):
        raise ValueError(f"{path}: top level must be a mapping")
    return document


def calendars(root: Path) -> list[str]:
    if not root.is_dir():
        raise ValueError(f"calendar root is missing: {root}")
    return sorted(p.name for p in root.iterdir() if (p / INDEX).is_file())


def masses_of(document: dict) -> list[tuple[str, dict]]:
    """Yield (kind, mass) from the one canonical container, in section order."""
    out: list[tuple[str, dict]] = []
    for _, body in sorted((document.get("sections") or {}).items()):
        if not isinstance(body, dict):
            continue
        kind = str(body.get("kind") or "")
        for mass in body.get("masses") or []:
            if isinstance(mass, dict):
                out.append((kind, mass))
    return out


def propers_of(mass: dict) -> list[tuple[str, dict]]:
    """Yield (form, proper); a mass with seasonal forms labels each one."""
    out = [("", proper) for proper in (mass.get("propers") or []) if isinstance(proper, dict)]
    for form in mass.get("forms") or []:
        if not isinstance(form, dict):
            continue
        label = str(form.get("name") or "form")
        out.extend(
            (label, proper) for proper in (form.get("propers") or []) if isinstance(proper, dict)
        )
    return out


def load_bible(name: str, root: Path) -> dict:
    """Resolve an indexed bible, keyed by the citations-encoded passage."""
    import yaml

    path = root / name / "index.yaml"
    if not path.is_file():
        available = (
            sorted(p.name for p in root.iterdir() if (p / "index.yaml").is_file())
            if root.is_dir()
            else []
        )
        raise ValueError(
            f"no indexed bible {name!r} at {path}"
            + (f"; available: {', '.join(available)}" if available else "; none are indexed yet")
        )
    document = yaml.safe_load(path.read_text(encoding="utf-8")) or {}
    return {
        "numbering": document.get("numbering"),
        "edition": document.get("edition"),
        "passages": {str(k): v for k, v in (document.get("passages") or {}).items()},
    }


def find_mass(root: Path, calendar: str, key: str) -> dict:
    document = load_calendar(root, calendar)
    for kind, mass in masses_of(document):
        if mass.get("key") == key:
            return {
                "calendar": calendar,
                "edition": document.get("edition"),
                "psalm_numbering": document.get("psalm_numbering"),
                "kind": mass.get("kind") or kind,
                "mass": mass,
            }
    raise KeyError(f"{calendar}: no mass with key {key!r}")


def scripture_entries(mass: dict):
    """Yield every verse entry a mass carries, cycle readings included."""
    for entry, _ in numbered_entries(mass, None):
        yield entry


def numbered_entries(mass: dict, default: str | None):
    """Yield (entry, numbering) for every citation the mass makes.

    A calendar declares one psalm numbering, but a single book need not keep to
    it: the postconciliar Missal's antiphons reproduce the number printed in the
    Missal while its responsorial psalms take the Lectionary's, which is what
    the recovered citation_convention says and why eleven antiphons resolved to
    verses that do not exist. A proper may therefore declare its own, and its
    cycles may differ again; what it does not declare it inherits.
    """
    for _, proper in propers_of(mass):
        inherited = proper.get("psalm_numbering") or default
        owners = [(proper, inherited)] + [
            (owner, owner.get("psalm_numbering") or inherited)
            for owner in (proper.get("cycles") or {}).values()
            if isinstance(owner, dict)
        ]
        for owner, numbering in owners:
            for entry in owner.get("verses") or []:
                if isinstance(entry, dict) and entry.get("ref"):
                    yield entry, numbering


def locus_of(entry: dict) -> tuple[int | None, int | None]:
    """The first chapter and verse a reference names, taken from its ranges."""
    for span in entry.get("ranges") or []:
        begin = span.get("begin") if isinstance(span, dict) else None
        if isinstance(begin, dict) and begin.get("chapter") is not None:
            verse = begin.get("verse")
            return int(begin["chapter"]), (None if verse is None else int(verse))
    return None, None


def renumber(ref: str, chapter: int) -> str:
    """Rewrite a citation onto another chapter, keeping its verses."""
    return CHAPTER.sub(lambda match: f"{match.group(1)}{chapter}", ref, count=1)


def resolve_entry(entry: dict, passages: dict, source: str, target: str) -> dict:
    """Look one reference up, converting its psalm chapter when systems differ."""
    ref = str(entry["ref"])
    book = str(entry.get("book") or "")
    chapter, verse = locus_of(entry)
    if source == target or book != PSALMS or chapter is None:
        return {"text": passages.get(ref), "note": ""}
    try:
        converted, caveat = convert_reference(book, chapter, source, target, verse)
    except NumberingError as error:
        # A split psalm without a verse has no one answer; say so, guess nothing.
        return {"text": None, "note": f"not resolved: {error}"}
    if converted == chapter:
        return {"text": passages.get(ref), "note": caveat}
    key = renumber(ref, converted)
    note = f"{target}: {key}" + (f"; {caveat}" if caveat else "")
    return {"text": passages.get(key), "note": note}


def resolve_passages(payload: dict, bible: dict) -> dict:
    """Map each citation the mass makes to the bible's text and any caveat."""
    source, target = payload.get("psalm_numbering"), bible.get("numbering")
    if source != target:
        for system, whose in ((source, "calendar"), (target, "bible")):
            if system not in SYSTEMS:
                raise ValueError(
                    f"the {whose} declares unknown psalm numbering {system!r}; "
                    f"expected one of {', '.join(SYSTEMS)}"
                )
    return {
        str(entry["ref"]): resolve_entry(entry, bible["passages"], source, target)
        for entry in scripture_entries(payload["mass"])
    }


BOOK_INDEX = (
    ROOT / "src/sources/works/english-college-of-douay/douay-rheims-bible/editions"
    "/challoner-gutenberg-1581/artifacts"
)


def book_tokens() -> dict[str, str]:
    """Canonical book name to the token the chapter fragments are filed under.

    Every edition in this library addresses a book by the same token, because
    each one's book index is built from the Douay-Rheims's. A structure file is
    therefore edition-independent; an edition that chose its own tokens would
    break that and would need its own loci.
    """
    import csv

    found = sorted(BOOK_INDEX.glob("book-index-*/book-index.tsv"))
    if len(found) != 1:
        raise ValueError(f"expected one book index under {BOOK_INDEX}, found {len(found)}")
    with found[0].open(encoding="utf-8", newline="") as handle:
        return {row["modern_name"]: row["token"] for row in csv.DictReader(handle, delimiter="\t")}


def spans_in(entry: dict, source: str, target: str) -> list[dict]:
    """One citation's ranges as explicit loci in `target` numbering."""
    book = str(entry.get("book") or "")
    loci: list[dict] = []
    for span in entry.get("ranges") or []:
        if not isinstance(span, dict):
            continue
        converted, _ = convert_range(book, span.get("begin") or {}, span.get("end"), source, target)
        for piece in converted:
            loci.extend(range_to_loci(piece.get("begin") or {}, piece.get("end") or {}))
    return loci


def citation_structure(entry: dict, source: str, tokens: dict[str, str]) -> dict:
    """A citation with its verses resolved in both numbering systems.

    Resolved here rather than in the browser so that no numbering logic ships
    to the page: a reader picks a translation, reads its numbering, and takes
    the loci already computed for it. A citation that cannot be converted
    carries the reason and no loci, because a page that renders nothing is
    better than one that renders the wrong psalm.
    """
    book = str(entry.get("book") or "")
    structure = {
        "ref": str(entry["ref"]),
        "book": book,
        "token": tokens.get(book),
        "loci": {},
        "unresolved": None,
    }
    if structure["token"] is None:
        structure["unresolved"] = f"no book named {book!r} in this library"
        return structure
    for target in SYSTEMS:
        try:
            structure["loci"][target] = spans_in(entry, source, target)
        except NumberingError as error:
            structure["loci"] = {}
            structure["unresolved"] = str(error)
            return structure
    return structure


def calendar_structure(root: Path, calendar: str, tokens: dict[str, str]) -> dict:
    document = load_calendar(root, calendar)
    source = document.get("psalm_numbering")
    if source not in SYSTEMS:
        raise ValueError(f"{calendar} declares unknown psalm numbering {source!r}")
    masses = []
    for kind, mass in masses_of(document):
        propers = []
        for form, proper in propers_of(mass):

            def cited(owner: dict) -> list[dict]:
                return [
                    citation_structure(entry, source, tokens)
                    for entry in (owner.get("verses") or [])
                    if isinstance(entry, dict) and entry.get("ref")
                ]

            # A cycle-varying proper reads differently in years A, B and C, so
            # each year's citations are kept apart rather than merged into one
            # list the browser could not tell apart.
            # A cycle may vary in kind as well as in text: an acclamation
            # composed one year and scriptural the next, so each year carries
            # both its citations and its own words.
            cycles = {
                year: (cited(owner), owner)
                for year, owner in (proper.get("cycles") or {}).items()
                if isinstance(owner, dict)
            }
            propers.append(
                {
                    "name": proper.get("name"),
                    # A mass with several formularies labels each one; an
                    # ordinary mass has no form and carries an empty label.
                    "form": form,
                    "incipit": proper.get("incipit"),
                    "source": proper.get("source"),
                    # A composed proper is an oration, not a citation: its words
                    # are the proper. Carrying only the incipit left the page
                    # naming a Collect it could not show.
                    "text": proper.get("text"),
                    "translations": proper.get("translations"),
                    "citations": cited(proper),
                    "cycles": {
                        year: {"citations": rows, "text": owner.get("text")}
                        for year, (rows, owner) in cycles.items()
                        if rows or owner.get("text")
                    },
                }
            )
        masses.append(
            {
                "key": mass.get("key"),
                "name": mass.get("name"),
                "season": mass.get("season"),
                "kind": kind,
                "registry": mass.get("registry"),
                "propers": propers,
            }
        )
    return {
        "schema": "triptych-propers-structure/v1",
        "calendar": calendar,
        "edition": document.get("edition"),
        "numbering": source,
        "masses": masses,
    }


def run_structure(arguments: argparse.Namespace) -> dict:
    """Write one structure file per calendar for the browser to assemble from."""
    root = Path(arguments.root)
    tokens = book_tokens()
    names = [arguments.calendar] if arguments.calendar else calendars(root)
    out = Path(arguments.out)
    written, counts, refused = [], {}, []
    for name in names:
        built = calendar_structure(root, name, tokens)
        # `--out` is the data root the page is served from, so both generators
        # take the same one: the manifest lands at its head and the structure
        # files under `structure/`.
        path = out / "structure" / "propers" / f"{name}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(built, ensure_ascii=False, sort_keys=True, indent=1) + "\n",
            encoding="utf-8",
        )
        written.append(str(path))
        cited = [
            citation
            for mass in built["masses"]
            for proper in mass["propers"]
            for rows in [
                proper["citations"],
                *(cycle["citations"] for cycle in proper["cycles"].values()),
            ]
            for citation in rows
        ]
        counts[name] = {"masses": len(built["masses"]), "citations": len(cited)}
        refused.extend(
            f"{name} {c['ref']}: {c['unresolved']}" for c in cited if c["unresolved"]
        )
    return {
        "written": written,
        "calendars": counts,
        "refused": refused if arguments.verbose else len(refused),
        "status": "ok",
    }


def run_show(arguments: argparse.Namespace) -> dict:
    if not arguments.calendar:
        raise ValueError("--calendar is required")
    if not arguments.mass:
        raise ValueError("--mass is required")
    payload = find_mass(Path(arguments.root), arguments.calendar, arguments.mass)
    # Resolve here so a missing bible or an unusable numbering fails before rendering.
    arguments.resolved_bible = (
        resolve_passages(payload, load_bible(arguments.bible, Path(arguments.bible_root)))
        if arguments.bible
        else {}
    )
    return payload


def run_list(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    wanted = [arguments.calendar] if arguments.calendar else calendars(root)
    listing = {}
    for calendar in wanted:
        rows = []
        for kind, mass in masses_of(load_calendar(root, calendar)):
            rows.append(
                {
                    "key": mass.get("key"),
                    "name": mass.get("name"),
                    "kind": mass.get("kind") or kind,
                    "registry": mass.get("registry"),
                    "propers": len(propers_of(mass)),
                }
            )
        listing[calendar] = rows
    return {"calendars": listing}


def wrap(text: str, indent: str) -> list[str]:
    import textwrap

    lines: list[str] = []
    for paragraph in text.strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if not block:
            continue
        lines.extend(textwrap.wrap(block, WIDTH - len(indent)) or [""])
        lines.append("")
    return [indent + line if line else "" for line in lines[:-1] or lines]


def render_reading(payload: dict, lang: str, resolved: dict) -> int:
    mass = payload["mass"]
    print(mass.get("name") or mass.get("key") or "(unnamed)")
    subtitle = " · ".join(
        str(part)
        for part in (payload.get("edition"), payload.get("kind"), mass.get("registry"))
        if part
    )
    if subtitle:
        print(subtitle)
    print("=" * WIDTH)
    for form, proper in propers_of(mass):
        heading = str(proper.get("name") or "(unnamed proper)")
        if form:
            heading = f"{heading} [{form}]"
        print(f"\n{heading}")
        print("-" * len(heading))
        for entry in proper.get("verses") or []:
            if isinstance(entry, dict) and entry.get("ref"):
                # The missal's own citation stands; a conversion is shown beside it.
                found = resolved.get(str(entry["ref"])) or {}
                note = found.get("note")
                print(f"  {entry['ref']}" + (f"  ({note})" if note else ""))
                if found.get("text"):
                    print("\n".join(wrap(str(found["text"]), "    ")))
        for cycle, owner in sorted((proper.get("cycles") or {}).items()):
            refs = [
                v["ref"]
                for v in (owner.get("verses") or [])
                if isinstance(v, dict) and v.get("ref")
            ]
            if refs:
                print(f"  {cycle}: {', '.join(refs)}")
        body, note = select_text(proper, lang)
        if body:
            print()
            print("\n".join(wrap(body, "  ")))
        if note:
            print(f"\n  ({note})")
    return 0


def select_text(proper: dict, lang: str) -> tuple[str, str]:
    """Latin is the tracked text; any other language is a carried translation."""
    if lang == "la":
        return str(proper.get("text") or ""), ""
    for translation in proper.get("translations") or []:
        if isinstance(translation, dict) and translation.get("lang") == lang:
            return str(translation.get("text") or ""), ""
    if proper.get("text"):
        return str(proper["text"]), f"no {lang} translation recorded; showing Latin"
    return "", ""


def render_listing(payload: dict) -> int:
    for calendar, rows in payload["calendars"].items():
        for row in rows:
            print(
                f"{calendar}\t{row['registry'] or ''}\t{row['kind']}\t"
                f"{row['propers']}\t{row['key']}\t{row['name'] or ''}"
            )
        print(f"# {calendar}: {len(rows)} masses", file=sys.stderr)
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_ROOT), help="calendar root directory")
    shared.add_argument("--calendar", help="calendar directory name, e.g. roman-1962")
    shared.add_argument("--mass", help="mass key, e.g. advent-1")
    shared.add_argument(
        "--format", choices=("text", "yaml", "json"), default="text", help="output form"
    )
    shared.add_argument(
        "--bible", help="indexed bible to resolve scripture refs against, e.g. douay-rheims"
    )
    shared.add_argument(
        "--lang", default="la", help="language for composed propers (default: la)"
    )
    shared.add_argument(
        "--bible-root",
        default=str(BIBLE_ROOT),
        help="where indexed bibles live; point outside the repo to keep a "
        "licensed text unpublished",
    )
    shared.add_argument(
        "--out", default="src/web/data", help="where `structure` writes its files"
    )
    shared.add_argument(
        "--verbose", action="store_true", help="list every citation that refused to resolve"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="mass-propers",
        description="Print one mass's propers as YAML, JSON, or a reading view.",
        parents=[shared],
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("show", help="print one mass's propers", parents=[shared])
    sub.add_parser("list", help="list the masses a calendar carries", parents=[shared])
    sub.add_parser(
        "structure",
        help="write the browser's structure files, citations resolved to loci",
        parents=[shared],
    )

    def render(payload: object, arguments: argparse.Namespace) -> int:
        if not isinstance(payload, dict):
            print("mass-propers error: invalid payload", file=sys.stderr)
            return 70
        if arguments.json or arguments.format == "json":
            print_json(payload)
            return 0
        if arguments.format == "yaml":
            import yaml

            print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
            return 0
        if "written" in payload:
            for calendar, counts in payload["calendars"].items():
                print(f"{calendar}: {counts['masses']} masses, {counts['citations']} citations")
            for path in payload["written"]:
                print(f"  -> {path}")
            refused = payload["refused"]
            if isinstance(refused, list):
                for row in refused:
                    print(f"  refused {row}")
            else:
                print(f"  refused: {refused}")
            return 0
        if "calendars" in payload:
            return render_listing(payload)
        return render_reading(
            payload, arguments.lang, getattr(arguments, "resolved_bible", {})
        )

    return run_verb_cli(
        parser=parser,
        handlers={"show": run_show, "list": run_list, "structure": run_structure},
        renderer=render,
        prefix="mass-propers",
        argv=argv,
        default_verb="show",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
