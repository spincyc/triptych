def translation_record_identity(
    entry: dict, document: dict | None = None
) -> tuple[str, str, str, str, int]:
    """Canonical nontext identity shared by inherited ledger records.

    Tracked typed rows author ``form_id``.  Positive translation rows predate
    that field, so the v1 compatibility path resolves their display label
    against the owning raw calendar.  It is deliberately unavailable without
    that document: silently treating a named form as ``main`` collapses
    Nativity and All Souls formularies onto one another.
    """

    for field in ("mass", "proper"):
        value = entry.get(field)
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"translation target {field} must be nonempty")

    exact_fields = ("form_id", "cycle", "occurrence")
    explicit = any(field in entry for field in exact_fields)
    if explicit and not all(field in entry for field in exact_fields):
        raise ValueError(
            "stable translation identity requires form_id, cycle, and occurrence together"
        )

    form_id = entry.get("form_id")
    if explicit:
        if not isinstance(form_id, str) or not form_id.strip():
            raise ValueError("translation target form_id must be nonempty")
        cycle = entry.get("cycle")
        if cycle not in TRANSLATION_ABSENCE_CYCLES:
            raise ValueError(
                "translation target cycle must be one of "
                f"{sorted(TRANSLATION_ABSENCE_CYCLES)!r}"
            )
        occurrence = entry.get("occurrence")
        if (
            isinstance(occurrence, bool)
            or not isinstance(occurrence, int)
            or occurrence < 1
        ):
            raise ValueError(
                "translation target occurrence must be a positive integer"
            )

        # Exact identity does not need the historical display label, but a row
        # which retains one must not let it drift away from the id it annotates.
        # Otherwise a source label change silently files the translation under
        # a label no current Proper will request.
        if "form" in entry:
            label = entry.get("form")
            if not isinstance(label, str):
                raise ValueError("translation target form must be a string")
            display_form_id = FORM_ID_MAIN
            if label:
                if document is None:
                    raise ValueError(
                        f"translation target form {label!r} requires its owning calendar"
                    )
                owner_mass = _calendars.mass_index(document).get(entry["mass"])
                if owner_mass is None:
                    raise ValueError(
                        f"translation target names no source mass {entry['mass']!r}"
                    )
                display_form_id = form_id_for_label(owner_mass, label)
            if display_form_id != form_id:
                raise ValueError(
                    f"translation target display form {label!r} resolves to "
                    f"{display_form_id!r}, not form_id {form_id!r}"
                )
    else:
        raw_label = entry.get("form", "")
        if not isinstance(raw_label, str):
            raise ValueError("legacy translation target form must be a string")
        label = raw_label
        if not label:
            form_id = FORM_ID_MAIN
        elif document is not None:
            owner_mass = _calendars.mass_index(document).get(str(entry.get("mass") or ""))
            if owner_mass is None:
                raise ValueError(
                    f"translation target names no source mass {entry.get('mass')!r}"
                )
            form_id = form_id_for_label(owner_mass, label)
        else:
            raise ValueError(
                f"translation target form {label!r} requires its owning calendar"
            )
        cycle = CYCLE_ALL
        occurrence = 1

    return (entry["mass"], str(form_id), entry["proper"], str(cycle), occurrence)


def untranslated_record_identity(
    entry: dict, path: Path | None = None
) -> tuple[str, str, str, str, int]:
    """Validate and return one authoritative typed absence identity.

    Unlike positive v1 translation rows, absence rows have no legacy identity
    path.  A missing field must not quietly become ``main``, ``all`` or the
    first same-named Proper: each of those defaults previously let a prose-only
    finding-aid row close a different source-owned body.
    """

    label = f"{path}: " if path is not None else ""
    required = {
        "mass",
        "form_id",
        "proper",
        "cycle",
        "occurrence",
        "extent",
        "lang",
        "availability",
        "reason",
        "note",
    }
    missing = sorted(required - set(entry))
    if missing:
        raise ValueError(
            f"{label}untranslated row lacks exact typed fields {missing!r}"
        )
    unknown = sorted(set(entry) - TRANSLATION_UNAVAILABLE_FIELDS, key=repr)
    if unknown:
        raise ValueError(f"{label}untranslated row has unknown fields {unknown!r}")
    if "form" in entry:
        raise ValueError(
            f"{label}untranslated row must use stable form_id, not display form"
        )
    if "text" in entry:
        raise ValueError(f"{label}untranslated row must not carry text")
    antecedent_fields = set(entry) & TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS
    if antecedent_fields and (
        antecedent_fields != TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS
    ):
        missing_antecedent = sorted(
            TRANSLATION_UNAVAILABLE_ANTECEDENT_FIELDS - antecedent_fields
        )
        raise ValueError(
            f"{label}untranslated antecedent metadata is an all-or-none bundle; "
            f"missing {missing_antecedent!r}"
        )
    if antecedent_fields:
        for field in ("antecedent_calendar", "antecedent_mass", "antecedent_proper"):
            value = entry.get(field)
            if not isinstance(value, str) or not value.strip():
                raise ValueError(
                    f"{label}untranslated {field} must be a nonempty string"
                )
        if entry.get("relation") != "revised":
            raise ValueError(
                f"{label}untranslated antecedent relation must be 'revised'"
            )
    for field in ("mass", "form_id", "proper", "cycle", "extent", "lang", "note"):
        value = entry.get(field)
        if not isinstance(value, str) or not value.strip():
            raise ValueError(f"{label}untranslated {field} must be nonempty")
    if entry.get("form_id") == "default":
        raise ValueError(f"{label}untranslated form_id 'default' is forbidden")
    if entry.get("cycle") not in TRANSLATION_ABSENCE_CYCLES:
        raise ValueError(
            f"{label}untranslated cycle must be one of "
            f"{sorted(TRANSLATION_ABSENCE_CYCLES)!r}"
        )
    if entry.get("extent") not in TRANSLATION_ABSENCE_EXTENTS:
        raise ValueError(
            f"{label}untranslated extent must be one of "
            f"{sorted(TRANSLATION_ABSENCE_EXTENTS)!r}"
        )
    occurrence = entry.get("occurrence")
    if isinstance(occurrence, bool) or not isinstance(occurrence, int) or occurrence < 1:
        raise ValueError(
            f"{label}untranslated occurrence must be a positive integer"
        )
    if entry.get("lang") != "en":
        raise ValueError(f"{label}untranslated row must use lang 'en'")
    if entry.get("availability") != "unavailable":
        raise ValueError(
            f"{label}untranslated availability must be 'unavailable'"
        )
    reason = entry.get("reason")
    kind = reason.get("kind") if isinstance(reason, dict) else None
    if isinstance(reason, dict):
        unknown_reason = sorted(
            set(reason) - TRANSLATION_ABSENCE_REASON_FIELDS, key=repr
        )
        if unknown_reason:
            raise ValueError(
                f"{label}untranslated reason has unknown fields {unknown_reason!r}"
            )
    if kind not in TRANSLATION_ABSENCE_KINDS:
        raise ValueError(
            f"{label}untranslated reason.kind must be one of "
            f"{sorted(TRANSLATION_ABSENCE_KINDS)!r}"
        )
    source_id = reason.get("source_id") if isinstance(reason, dict) else None
    if kind in {"rights-withheld", "witness-gap"}:
        if not isinstance(source_id, str) or not source_id.strip():
            raise ValueError(
                f"{label}untranslated reason.kind {kind!r} requires source_id"
            )
    elif source_id is not None:
        raise ValueError(
            f"{label}untranslated reason.kind 'no-exemplar' cannot name source_id"
        )
    surfaces = reason.get("surfaces") if isinstance(reason, dict) else None
    if kind == "rights-withheld":
        if (
            not isinstance(surfaces, list)
            or not surfaces
            or any(not isinstance(surface, str) for surface in surfaces)
        ):
            raise ValueError(
                f"{label}untranslated rights-withheld reason requires surfaces"
            )
        unknown_surfaces = sorted(set(surfaces) - TRANSLATION_ABSENCE_SURFACES)
        if unknown_surfaces:
            raise ValueError(
                f"{label}untranslated reason surfaces are unknown "
                f"{unknown_surfaces!r}"
            )
        if len(surfaces) != len(set(surfaces)):
            raise ValueError(f"{label}untranslated reason surfaces repeat a value")
    elif surfaces is not None:
        raise ValueError(
            f"{label}untranslated reason surfaces apply only to rights-withheld"
        )
    extent = str(entry["extent"])
    if extent == "body" and "incipit" in entry:
        raise ValueError(
            f"{label}untranslated body extent must not carry incipit"
        )
    if extent == "incipit":
        incipit = entry.get("incipit")
        if not isinstance(incipit, str) or not incipit.strip():
            raise ValueError(
                f"{label}untranslated incipit extent requires incipit"
            )
    witness_fields = ("witness_artifact_id", "witness_passage_id")
    if "witness_passage_id" in entry:
        missing_witness = [field for field in witness_fields if field not in entry]
        if missing_witness:
            raise ValueError(
                f"{label}exact untranslated witness lacks {missing_witness!r}"
            )
        for field in witness_fields:
            value = entry.get(field)
            if not isinstance(value, str) or not value.strip():
                raise ValueError(
                    f"{label}untranslated {field} must be a nonempty string"
                )
    return (
        str(entry["mass"]),
        str(entry["form_id"]),
        str(entry["proper"]),
        str(entry["cycle"]),
        occurrence,
    )


PUBLICATION_BINDING_FIELDS = frozenset(
    {
        "publication_artifact_id",
        "publication_artifact_sha256",
        "publication_passage_id",
    }
)


def validate_translation_publication_binding(
    entry: dict, calendar_root: Path, path: Path
) -> None:
    """Fail closed on a source-backed publishable translation payload.

    The page-image passage proves what a human read; the separate tracked
    artifact is the only byte source the public projection may carry.  A
    partial or stale join must therefore stop the CLI itself, not merely rely
    on a separate checker having run in another process.
    """

    present = PUBLICATION_BINDING_FIELDS & set(entry)
    if not present:
        translations = entry.get("translations")
        if (
            entry.get("witness_relation") == "antecedent"
            and isinstance(translations, list)
            and any(
                isinstance(translation, dict)
                and translation.get("rights") == "public-domain"
                and isinstance(translation.get("text"), str)
                and bool(translation["text"].strip())
                for translation in translations
            )
        ):
            raise ValueError(
                f"{path}: positive public-domain antecedent body requires an "
                "exact publication binding"
            )
        return
    if present != PUBLICATION_BINDING_FIELDS:
        missing = sorted(PUBLICATION_BINDING_FIELDS - present)
        raise ValueError(
            f"{path}: partial translation publication binding; missing {missing!r}"
        )
    artifact_id = entry.get("publication_artifact_id")
    expected_sha = entry.get("publication_artifact_sha256")
    passage_id = entry.get("publication_passage_id")
    verification_artifact_id = entry.get("artifact_id")
    verification_passage_id = entry.get("passage_id")
    for field, value in (
        ("publication_artifact_id", artifact_id),
        ("publication_artifact_sha256", expected_sha),
        ("publication_passage_id", passage_id),
        ("artifact_id", verification_artifact_id),
        ("passage_id", verification_passage_id),
    ):
        if not isinstance(value, str) or not value.strip():
            raise ValueError(
                f"{path}: bound translation {field} must be a nonempty string"
            )

    records, _ = _source_library_records(calendar_root)
    artifact = records.get(str(artifact_id))
    passage = records.get(str(passage_id))
    verification_artifact = records.get(str(verification_artifact_id))
    verification_passage = records.get(str(verification_passage_id))
    if not isinstance(artifact, dict) or artifact.get("record_type") != "artifact":
        raise ValueError(
            f"{path}: publication_artifact_id {artifact_id!r} is not registered"
        )
    if not isinstance(passage, dict) or passage.get("record_type") != "passage":
        raise ValueError(
            f"{path}: publication_passage_id {passage_id!r} is not registered"
        )
    if (
        not isinstance(verification_artifact, dict)
        or verification_artifact.get("record_type") != "artifact"
    ):
        raise ValueError(
            f"{path}: artifact_id {verification_artifact_id!r} is not registered"
        )
    if (
        not isinstance(verification_passage, dict)
        or verification_passage.get("record_type") != "passage"
    ):
        raise ValueError(
            f"{path}: passage_id {verification_passage_id!r} is not registered"
        )

    actual_record_sha = str(artifact.get("sha256") or "")
    if expected_sha != actual_record_sha:
        raise ValueError(
            f"{path}: publication artifact hash is stale: inventory "
            f"{expected_sha!r}, source record {actual_record_sha!r}"
        )
    if artifact.get("storage") != "tracked" or artifact.get("indexable") is not True:
        raise ValueError(
            f"{path}: publication artifact must be tracked and indexable"
        )
    if artifact.get("rights_status") != "public-domain":
        raise ValueError(
            f"{path}: publication artifact must have public-domain rights"
        )
    if artifact.get("rights_jurisdiction") != "United States":
        raise ValueError(
            f"{path}: publication artifact must state United States jurisdiction"
        )
    media_type = str(artifact.get("media_type") or "").lower()
    if (
        artifact.get("encoding") != "utf-8"
        or not media_type.startswith("text/")
        or "charset=utf-8" not in media_type
    ):
        raise ValueError(f"{path}: publication artifact must be searchable UTF-8 text")
    if artifact.get("derived_from") != verification_artifact_id:
        raise ValueError(
            f"{path}: publication artifact is not derived from the verification artifact"
        )
    repository_root = calendar_root.resolve().parents[2]
    relative_payload = artifact.get("path")
    if not isinstance(relative_payload, str) or not relative_payload:
        raise ValueError(f"{path}: publication artifact has no tracked payload path")
    payload_path = repository_root / relative_payload
    if not payload_path.is_file():
        raise ValueError(f"{path}: publication artifact payload is missing")
    actual_sha = hashlib.sha256(payload_path.read_bytes()).hexdigest()
    if actual_sha != expected_sha:
        raise ValueError(
            f"{path}: publication artifact bytes have sha256 {actual_sha}, "
            f"not {expected_sha}"
        )

    edition_id = artifact.get("edition_id")
    edition = records.get(str(edition_id or ""))
    edition_date = edition.get("date") if isinstance(edition, dict) else None
    if (
        not isinstance(edition, dict)
        or edition.get("record_type") != "edition"
        or not isinstance(edition_date, str)
        or not edition_date.isdigit()
        or int(edition_date) >= 1931
    ):
        raise ValueError(
            f"{path}: publication artifact must belong to a pre-1931 edition"
        )
    if artifact_id == verification_artifact_id:
        raise ValueError(
            f"{path}: publication artifact must be independent of page-image proof"
        )
    for label, record, controlling_artifact in (
        ("publication passage", passage, artifact),
        ("verification passage", verification_passage, verification_artifact),
    ):
        if record.get("artifact_id") != controlling_artifact.get("id"):
            raise ValueError(f"{path}: {label} does not bind its named artifact")
        if record.get("artifact_sha256") != controlling_artifact.get("sha256"):
            raise ValueError(f"{path}: {label} artifact hash is stale")
        if record.get("edition_id") != edition_id:
            raise ValueError(f"{path}: {label} belongs to a different edition")
        states = set(record.get("states") or [])
        if not {"inspected", "verified"} <= states or not record.get("verified_on"):
            raise ValueError(f"{path}: {label} is not inspected and dated verified")
    if passage.get("artifact_id") != artifact_id:
        raise ValueError(f"{path}: publication passage names another artifact")
    if passage.get("artifact_sha256") != expected_sha:
        raise ValueError(f"{path}: publication passage carries a stale hash")
    if passage.get("locus") != verification_passage.get("locus"):
        raise ValueError(
            f"{path}: publication and verification passages name different targets"
        )
    leaf_range = entry.get("ia_leaf_range")
    if (
        not isinstance(leaf_range, list)
        or len(leaf_range) != 2
        or any(
            isinstance(value, bool) or not isinstance(value, int)
            for value in leaf_range
        )
        or leaf_range[0] > leaf_range[1]
        or verification_passage.get("artifact_page_ranges")
        != [[leaf_range[0] + 1, leaf_range[1] + 1]]
    ):
        raise ValueError(
            f"{path}: verification passage does not match the exact IA leaf range"
        )

    ranges = passage.get("physical_line_ranges")
    if (
        not isinstance(ranges, list)
        or len(ranges) != 1
        or not isinstance(ranges[0], list)
        or len(ranges[0]) != 2
        or ranges[0][0] != ranges[0][1]
        or not isinstance(ranges[0][0], int)
        or ranges[0][0] < 2
    ):
        raise ValueError(
            f"{path}: publication passage must bind exactly one TSV body line"
        )
    lines = payload_path.read_text(encoding="utf-8").splitlines()
    line_number = ranges[0][0]
    if line_number > len(lines):
        raise ValueError(f"{path}: publication passage line is outside its artifact")
    parsed = list(csv.DictReader([lines[0], lines[line_number - 1]], delimiter="\t"))
    if len(parsed) != 1:
        raise ValueError(f"{path}: publication passage is not one parseable TSV row")
    published = parsed[0]
    raw_english = published.get("english")
    encoded_english = published.get("english_json")
    if (raw_english is None) == (encoded_english is None):
        raise ValueError(
            f"{path}: publication TSV row must carry exactly one of english "
            "or english_json"
        )
    if encoded_english is not None:
        try:
            publication_text = json.loads(encoded_english)
        except (TypeError, json.JSONDecodeError) as exc:
            raise ValueError(
                f"{path}: publication TSV english_json is not valid JSON"
            ) from exc
        if not isinstance(publication_text, str):
            raise ValueError(
                f"{path}: publication TSV english_json must decode to a string"
            )
    else:
        publication_text = raw_english
    for field in ("mass", "form_id", "proper"):
        if published.get(field) != str(entry.get(field) or ""):
            raise ValueError(
                f"{path}: publication passage {field} does not match translation target"
            )
    translations = [
        row for row in entry.get("translations") or [] if isinstance(row, dict)
    ]
    if len(translations) != 1 or translations[0].get("lang") != "en":
        raise ValueError(
            f"{path}: publication-bound entry must carry one English translation"
        )
    if translations[0].get("rights") != "public-domain":
        raise ValueError(
            f"{path}: publication-bound translation must state public-domain rights"
        )
    if translations[0].get("source_id") != edition_id:
        raise ValueError(
            f"{path}: publication-bound translation must name its edition source_id"
        )
    published_cycle = published.get("cycle") or CYCLE_ALL
    published_occurrence_raw = published.get("occurrence") or "1"
    try:
        published_occurrence = int(published_occurrence_raw)
    except (TypeError, ValueError) as exc:
        raise ValueError(
            f"{path}: publication TSV occurrence must be a positive integer"
        ) from exc
    if published_occurrence < 1:
        raise ValueError(
            f"{path}: publication TSV occurrence must be a positive integer"
        )
    if (
        entry.get("cycle") != published_cycle
        or entry.get("occurrence") != published_occurrence
    ):
        raise ValueError(
            f"{path}: publication passage cycle/occurrence does not match "
            "translation target"
        )
    translation_text = translations[0].get("text")
    # A TOML multiline delimiter contributes one structural terminal LF.
    # Remove exactly that byte; all other whitespace remains authoritative.
    if isinstance(translation_text, str) and translation_text.endswith("\n"):
        translation_text = translation_text[:-1]
    if translation_text != publication_text:
        raise ValueError(
            f"{path}: translation body differs from its exact publication passage"
        )


def inherited_inapplicable_identity(
    row: object, path: Path
) -> tuple[str, tuple[str, str, str, str, int]]:
    """Validate one exact child-recension suppression declaration."""

    if not isinstance(row, dict):
        raise ValueError(f"{path}: inherited_inapplicable row must be a table")
    unknown = sorted(set(row) - INHERITED_INAPPLICABLE_FIELDS, key=repr)
    missing = sorted(INHERITED_INAPPLICABLE_FIELDS - set(row))
    if unknown or missing:
        details = []
        if unknown:
            details.append(f"unknown fields {unknown!r}")
        if missing:
            details.append(f"missing fields {missing!r}")
        raise ValueError(f"{path}: inherited_inapplicable {'; '.join(details)}")
    record = row.get("record")
    if record not in INHERITED_INAPPLICABLE_RECORDS:
        raise ValueError(
            f"{path}: inherited_inapplicable record must be one of "
            f"{sorted(INHERITED_INAPPLICABLE_RECORDS)!r}"
        )
    if row.get("reason") not in INHERITED_INAPPLICABLE_REASONS:
        raise ValueError(
            f"{path}: inherited_inapplicable reason must be one of "
            f"{sorted(INHERITED_INAPPLICABLE_REASONS)!r}"
        )
    if row.get("basis") != "calendar-departure":
        raise ValueError(
            f"{path}: inherited_inapplicable basis must be 'calendar-departure'"
        )
    for field in ("mass", "form_id", "proper", "cycle"):
        if not isinstance(row.get(field), str) or not row[field]:
            raise ValueError(
                f"{path}: inherited_inapplicable {field} must be nonempty"
            )
    occurrence = row.get("occurrence")
    if isinstance(occurrence, bool) or not isinstance(occurrence, int) or occurrence < 1:
        raise ValueError(
            f"{path}: inherited_inapplicable occurrence must be a positive integer"
        )
    return str(record), translation_record_identity(row)


def effective_translation_identities(
    calendar: str, root: Path
) -> set[tuple[str, str, str, str, int]]:
    """Exact Proper identities still appointed by one effective recension."""

    document = load_calendar(root, calendar)
    owner_masses = _calendars.mass_index(document)
    identities: set[tuple[str, str, str, str, int]] = set()
    for _, mass in masses_of(document):
        for form, proper, taken_from in appointed_propers(document, mass):
            if proper.get("name") == PLACEHOLDER:
                continue
            identity = source_slot_identity(
                document,
                mass,
                form,
                proper,
                taken_from,
                owner_masses=owner_masses,
            )
            identities.add((*identity[:3], CYCLE_ALL, identity[3]))
            for _, cycle, _ in cycle_owners(proper):
                identities.add((*identity[:3], str(cycle), identity[3]))
    return identities


def inherited_inapplicable_count(calendar: str, root: Path) -> int:
    """Number of exact ancestor records a recension declares inapplicable."""

    import tomllib

    return sum(
        len(
            tomllib.loads(
                (
                    inventory_root(root)
                    / f"{owner}-proper-translations-v1.toml"
                ).read_text(encoding="utf-8")
            ).get("inherited_inapplicable")
            or []
        )
        for owner in translation_ledger_calendars(calendar, root)
    )


def translation_overlay(
    calendar: str, root: Path = DEFAULT_ROOT
) -> tuple[dict, dict, list, dict]:
    """Translations recorded for a calendar's propers, keyed by proper.

    The contract in `src/sources/calendars/README.md` puts `translations` inside
    each proper, and that is still where they belong. They were recorded in a
    sidecar because at the time nothing else under `src/sources` would accept
    them — every yaml beside a calendar was read as a mass index, and the source
    library rejected any file outside its own schema list. That constraint has
    since been lifted by the shared schema partition in `scripts/_calendars.py`,
    so the sidecar may move beside its calendar.

    Reading it rather than merging it into `propers.yaml` is worth keeping
    either way: it holds one copy of each translation instead of two, which is
    the rule the verse fragments already follow.

    Returns the positive overlay keyed by canonical
    ``(mass, form_id, proper, cycle, occurrence)`` identity, the propers
    deliberately left untranslated (keyed to their complete typed records), the
    entries that no longer answer their target, and the file's own record of the
    witnesses it quotes, keyed by `source_id`. Either kind of record may name
    one cycle only; reducing it to a three-part display key would collapse
    distinct cycles and repeated source owners.
    """
    import tomllib

    owners = translation_ledger_calendars(calendar, root)
    if not owners:
        return {}, {}, [], {}
    overlay: dict[tuple[str, str, str, str, int], dict] = {}
    stale = []
    untranslated: dict[tuple[str, str, str], list[dict]] = {}
    entry_owners: dict[tuple[str, str, str, str, int], str] = {}
    entry_languages: dict[tuple[str, str, str, str, int], set[str]] = {}
    untranslated_owners: dict[tuple[str, str, str, str, int], str] = {}
    # Read rather than restated: the label and the caution are already written
    # here, beside the rights basis they qualify, and a second copy in this tool
    # would be free to disagree with them.
    #
    # A row keyed to the empty id is the project's own work, which names no
    # source because it is its own witness. That row has to be reachable: a
    # project-created translation is *published*, and until it could carry a
    # caution the one witness a reader most needs warning about -- new English
    # for a prayer whose approved English is someone else's -- was the only one
    # served with no warning at all. Requiring the key to be present rather than
    # truthy is what admits it.
    witnesses = {}
    local_witness_ids: set[str] = set()
    for owner_index, owner in enumerate(owners):
        path = inventory_root(root) / f"{owner}-proper-translations-v1.toml"
        document = tomllib.loads(path.read_text(encoding="utf-8"))
        owner_document = _calendars.load_document(root, owner, effective=False)

        # A translation may cite either the conceptual edition or the exact
        # expression artifact whose bytes were transcribed. Both identifiers
        # belong to the same rights/caution row and therefore resolve to the
        # same public witness metadata.
        for row in ledger_rows(document, "sources", path):
            if not isinstance(row, dict):
                raise ValueError(f"{path}: every sources row must be a table")
            local_id = str(row.get("id") or "")
            if local_id in local_witness_ids:
                raise ValueError(f"{path}: duplicate translation source id {local_id!r}")
            local_witness_ids.add(local_id)
            for field in ("source_id", "artifact_id"):
                if field not in row:
                    continue
                alias = row.get(field)
                if not isinstance(alias, str):
                    raise ValueError(
                        f"{path}: translation source {local_id!r} {field} must be a string"
                    )
                if field == "artifact_id" and not alias.strip():
                    raise ValueError(
                        f"{path}: translation source {local_id!r} artifact_id "
                        "must be nonempty"
                    )
                if alias in witnesses and witnesses[alias] is not row:
                    raise ValueError(
                        f"{path}: duplicate translation source alias {alias!r}"
                    )
                witnesses[alias] = row

        exclusions = ledger_rows(document, "inherited_inapplicable", path)
        if exclusions and owner_index == 0:
            raise ValueError(
                f"{path}: inherited_inapplicable requires an inherited sidecar"
            )
        raw_owner_mass_index = _calendars.mass_index(owner_document)
        effective_identities = (
            effective_translation_identities(owner, root) if exclusions else set()
        )
        seen_exclusions: set[tuple[str, tuple[str, str, str, str, int]]] = set()
        for row in exclusions:
            record, identity = inherited_inapplicable_identity(row, path)
            target = (record, identity)
            if target in seen_exclusions:
                raise ValueError(
                    f"{path}: duplicate inherited_inapplicable target {target!r}"
                )
            seen_exclusions.add(target)
            departure = raw_owner_mass_index.get(identity[0])
            expected_departure = INHERITED_INAPPLICABLE_REASONS[str(row["reason"])]
            if (
                not isinstance(departure, dict)
                or departure.get("departure") != expected_departure
            ):
                raise ValueError(
                    f"{path}: inherited_inapplicable target {identity!r} is not "
                    f"owned by a calendar departure {expected_departure!r} as "
                    f"required by reason {row['reason']!r}"
                )
            if identity in effective_identities:
                raise ValueError(
                    f"{path}: inherited_inapplicable target {identity!r} remains "
                    "appointed by the effective child calendar"
                )
            if record == "entry":
                inherited = entry_owners.get(identity)
                if inherited is None or inherited == owner:
                    raise ValueError(
                        f"{path}: inherited_inapplicable has no inherited entry "
                        f"target {identity!r}"
                    )
                entry_owners.pop(identity)
                entry_languages.pop(identity, None)
                overlay.pop(identity, None)
            else:
                inherited_owner = untranslated_owners.get(identity)
                if inherited_owner is None or inherited_owner == owner:
                    raise ValueError(
                        f"{path}: inherited_inapplicable has no inherited "
                        f"untranslated target {identity!r}"
                    )
                untranslated_owners.pop(identity)
                key = identity[:3]
                untranslated[key] = [
                    candidate
                    for candidate in untranslated.get(key) or []
                    if untranslated_record_identity(candidate) != identity
                ]
                if not untranslated[key]:
                    untranslated.pop(key)

        for entry in ledger_rows(document, "entries", path):
            if not isinstance(entry, dict):
                raise ValueError(f"{path}: every entries row must be a table")
            validate_translation_payload(entry, path, witnesses)
            validate_translation_publication_binding(entry, root, path)
            identity = translation_record_identity(entry, owner_document)
            if identity in entry_owners:
                raise ValueError(f"{path}: duplicate translation entry target {identity!r}")
            languages = {
                str(row.get("lang") or "")
                for row in entry.get("translations") or []
                if isinstance(row, dict) and row.get("lang")
            }
            if identity in untranslated_owners and languages:
                absent_languages = {
                    str(candidate.get("lang") or "")
                    for candidate in untranslated.get(identity[:3]) or []
                    if untranslated_record_identity(candidate) == identity
                }
                overlap = sorted(languages & absent_languages)
                if overlap:
                    raise ValueError(
                        f"{path}: translation and untranslated target collide for "
                        f"{identity!r} languages {overlap!r}"
                    )
            overlay[identity] = entry
            entry_owners[identity] = owner
            entry_languages[identity] = languages
        for entry in ledger_rows(document, "untranslated", path):
            if not isinstance(entry, dict):
                raise ValueError(f"{path}: every untranslated row must be a table")
            # Absence rows deliberately have no v1 defaulting path.  They are
            # authoritative negative claims and therefore carry their exact
            # stable identity in the source ledger itself.
            carried = dict(entry)
            identity = untranslated_record_identity(carried, path)
            if identity in untranslated_owners:
                raise ValueError(
                    f"{path}: duplicate untranslated target {identity!r}"
                )
            language = str(carried["lang"])
            if language in entry_languages.get(identity, set()):
                raise ValueError(
                    f"{path}: translation and untranslated target collide for "
                    f"{identity!r} language {language!r}"
                )
            key = identity[:3]
            untranslated.setdefault(key, []).append(carried)
            untranslated_owners[identity] = owner

    return overlay, untranslated, stale, witnesses


def overlay_key(
    mass: dict, form: str, proper: dict, taken_from: dict | None
) -> tuple[str, str, str]:
    """The historical display address of a resolved source Proper.

    A borrowed proper is addressed under the mass that PRINTS it. The English of
    a Collect belongs to the Collect, not to each day the Missal appoints it on,
    so keying on the borrowing day would want the same oration recorded once per
    day — the hand-typed restatement `takes_from` exists to remove.

    Canonical translation storage adds stable form id, cycle, and occurrence;
    this display address remains useful for source provenance, diagnostics, and
    transitional callers constructing the former three-part mapping directly.
    """
    if taken_from:
        return (taken_from["mass"], taken_from["form"] or "", taken_from["proper"])
    return (mass.get("key"), form or "", proper.get("name"))


def form_id_for_label(mass: dict, label: str) -> str:
    """Return the source-authored stable id for a displayed formulary label."""

    if not label:
        return FORM_ID_MAIN
    for form in mass.get("forms") or []:
        if isinstance(form, dict) and str(form.get("name") or "") == label:
            identifier = form.get("id")
            if not isinstance(identifier, str) or not identifier:
                raise ValueError(
                    f"mass {mass.get('key')!r} form {label!r} has no stable id"
                )
            if identifier == FORM_ID_MAIN:
                raise ValueError(
                    f"mass {mass.get('key')!r} form {label!r} uses reserved id "
                    f"{FORM_ID_MAIN!r}"
                )
            return identifier
    raise ValueError(f"mass {mass.get('key')!r} has no form labelled {label!r}")


def source_slot_identity(
    document: dict,
    mass: dict,
    form: str,
    proper: dict,
    taken_from: dict | None,
    *,
    owner_masses: dict[str, dict] | None = None,
) -> tuple[str, str, str, int]:
    """Canonical owner identity, including the source-order occurrence."""

    owner_key = str((taken_from or {}).get("mass") or mass.get("key") or "")
    owner_form = (
        str(taken_from.get("form") or "")
        if taken_from is not None
        else str(form or "")
    )
    owner_name = str(
        (taken_from or {}).get("proper") or proper.get("name") or ""
    )
    if owner_masses is None:
        owner_masses = _calendars.mass_index(document)
    owner_mass = owner_masses.get(owner_key)
    if owner_mass is None:
        raise ValueError(f"no source mass {owner_key!r} for resolved Proper identity")
    form_id = form_id_for_label(owner_mass, owner_form)
    source_rows, trouble = _calendars._form_propers(owner_mass, owner_form)
    if trouble:
        raise ValueError(f"mass {owner_key}: {trouble}")
    matches = [
        row
        for row in source_rows
        if not row.get(_calendars.TAKES_FROM)
        and str(row.get("name") or "") == owner_name
    ]
    if not matches:
        # A qualified local wrapper may rename a referenced Proper.  Its
        # provenance still names the target's source name; if that route has
        # already been normalized away, fail rather than invent an ordinal.
        raise ValueError(
            f"mass {owner_key!r} form {owner_form!r} has no Proper {owner_name!r}"
        )
    occurrence = next(
        (index for index, candidate in enumerate(matches, 1) if candidate is proper),
        1 if len(matches) == 1 else 0,
    )
    if occurrence < 1:
        raise ValueError(
            f"mass {owner_key!r} form {owner_form!r} has ambiguous Proper "
            f"{owner_name!r}; occurrence must be source-derived"
        )
    return owner_key, form_id, owner_name, occurrence


def untranslated_key(
    identity: tuple[str, str, str, int] | tuple[str, str, str, str, int]
) -> tuple[str, str, str]:
    return identity[:3]


def untranslated_record_matches(
    proper: dict,
    record: dict,
    occurrence: int = 1,
    *,
    cycle: str | None = None,
    extent: str | None = None,
) -> bool:
    """Whether a typed absence still answers this exact unit or cycle."""

    try:
        untranslated_record_identity(record)
    except (TypeError, ValueError):
        return False
    if int(record["occurrence"]) != occurrence:
        return False
    record_cycle = str(record["cycle"])
    if cycle is not None and record_cycle != cycle:
        return False
    owner = proper
    if record_cycle != CYCLE_ALL:
        owners = [
            candidate
            for _, name, candidate in cycle_owners(proper)
            if name == record_cycle
        ]
        if not owners:
            return False
        owner = owners[0]
    record_extent = str(record["extent"])
    if extent is not None and record_extent != extent:
        return False
    recorded_incipit = str(record.get("incipit") or "").strip()
    if record_extent == "incipit":
        if not recorded_incipit:
            return False
        live_incipit = str(owner.get("incipit") or proper.get("incipit") or "").strip()
        if recorded_incipit != live_incipit:
            return False
    return True


def matching_untranslated_records(
    proper: dict,
    records: list[dict],
    occurrence: int = 1,
    *,
    cycle: str | None = None,
    extent: str | None = None,
) -> list[dict]:
    """Complete typed absences that have not drifted from their target."""

    return [
        dict(record)
        for record in records
        if isinstance(record, dict)
        and untranslated_record_matches(
            proper,
            record,
            occurrence,
            cycle=cycle,
            extent=extent,
        )
    ]


def public_untranslated_record(record: dict) -> dict:
    """The safe, text-free public projection of one source audit row."""

    reason = record.get("reason")
    kind = str(reason.get("kind") or "unavailable") if isinstance(reason, dict) else "unavailable"
    return {
        "target": {
            "mass": str(record.get("mass") or ""),
            "form_id": str(record.get("form_id") or FORM_ID_MAIN),
            "proper": str(record.get("proper") or ""),
            "cycle": str(record.get("cycle") or CYCLE_ALL),
            "occurrence": int(record.get("occurrence") or 1),
            "extent": str(record.get("extent") or "body"),
        },
        "lang": str(record.get("lang") or "und"),
        "state": "rights-restricted" if kind == "rights-withheld" else "unavailable",
    }


def public_untranslated_records(records: list[dict]) -> list[dict] | None:
    """Strip source, artifact, locator, rights and quarantine audit metadata."""

    projected = [
        public_untranslated_record(record)
        for record in records
        if isinstance(record, dict)
    ]
    return projected or None


def unavailable_states_from_records(records: list[dict], cycle: str = CYCLE_ALL) -> list[dict]:
    """Rights-withheld language states scoped by their containing owner."""

    return [
        {
            "target": public_untranslated_record(record)["target"],
            "lang": str(record.get("lang") or "und"),
            "state": "rights-restricted",
        }
        for record in records
        if isinstance(record, dict)
        and str(record.get("cycle") or CYCLE_ALL) == cycle
        and isinstance(record.get("reason"), dict)
        and record["reason"].get("kind") == "rights-withheld"
    ]


def translation_answers(entry: dict, proper: dict, language: str) -> bool:
    """A language body whose recorded incipit still matches the live slot."""

    recorded = str(entry.get("incipit") or "").strip()
    live = str(proper.get("incipit") or "").strip()
    # A recorded nonempty incipit can be compared only where the resolved
    # Proper also records one. Absence of a live incipit is not disagreement.
    return (not recorded or not live or recorded == live) and has_translation(
        entry, language
    )


def translation_entry_for(
    overlay: dict,
    key: tuple[str, str, str],
    identity: tuple[str, str, str, int] | tuple[str, str, str, str, int] | None,
) -> dict | None:
    """Resolve a positive translation without collapsing repeated source slots."""

    if identity is None:
        # Compatibility for callers holding a hand-built legacy overlay. Every
        # overlay loaded from a sidecar is keyed by its canonical identity.
        entry = overlay.get(key)
        return entry if isinstance(entry, dict) else None
    if len(identity) == 5:
        target = (
            str(identity[0]),
            str(identity[1]),
            str(identity[2]),
            str(identity[3]),
            int(identity[4]),
        )
    else:
        target = (
            str(identity[0]),
            str(identity[1]),
            str(identity[2]),
            CYCLE_ALL,
            int(identity[3]),
        )
    entry = overlay.get(target)
    if isinstance(entry, dict):
        return entry

    # Transitional compatibility for tests and callers which construct the old
    # three-part mapping directly. The source loader above never produces it.
    entry = overlay.get(key)
    if not isinstance(entry, dict):
        return None
    identity_cycle = target[3]
    identity_occurrence = target[4]
    expected_form = entry.get("form_id")
    expected_occurrence = entry.get("occurrence")
    expected_cycle = entry.get("cycle")
    if expected_form is not None and str(expected_form) != identity[1]:
        return None
    if expected_occurrence is not None and int(expected_occurrence) != identity_occurrence:
        return None
    # A legacy positive row means the whole source-owned slot.  It must never
    # leak into a cycle-specific unit merely because its human display key is
    # the same.
    if str(expected_cycle or CYCLE_ALL) != identity_cycle:
        return None
    return entry


def carry_translations(
    calendar: str,
    key: tuple[str, str, str],
    proper: dict,
    overlay: dict,
    stale: list,
    identity: tuple[str, str, str, int] | None = None,
    witnesses: dict | None = None,
) -> dict:
    """A copy of `proper` carrying the translations recorded for it.

    It is a function because two verbs merge the overlay — `structure`, which
    writes what the browser serves, and `show`, which is how a maintainer reads
    a Mass and checks a harvested translation. They were not one function, and
    only `structure` merged: every one of the recorded English translations
    reached the site and none of them reached the terminal, which answered
    `no en translation recorded; showing Latin` over an oration whose English
    the same repository was publishing. Two readers of one file must not
    disagree about what is in it.

    An entry whose proper no longer opens with the incipit it was derived
    against is stale, and merging it on the strength of the mass key alone
    would attach one prayer's English to another's Latin. Refuse it and report
    it: a missing translation is visible, a misattached one is not.
    """
    def carry_owner(
        owner: dict,
        target_identity: tuple[str, str, str, int]
        | tuple[str, str, str, str, int]
        | None,
        *,
        inherited_incipit: object = None,
    ) -> dict:
        recorded = translation_entry_for(overlay, key, target_identity)
        live_incipit = str(owner.get("incipit") or inherited_incipit or "")
        if recorded and recorded.get("incipit") and live_incipit:
            if recorded["incipit"].strip() != live_incipit.strip():
                cycle = (
                    f" cycle {target_identity[3]}"
                    if target_identity is not None and len(target_identity) == 5
                    else ""
                )
                stale.append(
                    f"{calendar} {key[0]}/{key[2]}{cycle}: recorded incipit "
                    f"{recorded['incipit']!r} does not match {live_incipit!r}"
                )
                recorded = None
        carried_owner = dict(owner)
        if not recorded:
            return carried_owner

        carried_translations = []
        for translation in recorded.get("translations") or []:
            if not isinstance(translation, dict):
                continue
            item = dict(translation)
            source_id = str(item.get("source_id") or "")
            witness = (witnesses or {}).get(source_id) or {}
            if source_id:
                item["source_label"] = str(witness.get("label") or source_id)
            cautions = []
            for caution in (
                witness.get("caution"),
                recorded.get("witness_note") or recorded.get("harvest_note"),
            ):
                text = public_witness_caution(caution)
                if text and text not in cautions:
                    cautions.append(text)
            if cautions:
                item["caution"] = "\n\n".join(cautions)
            carried_translations.append(item)
        carried_owner["translations"] = carried_translations
        return carried_owner

    carried = carry_owner(proper, identity)
    if identity is not None:
        for course in CYCLE_KEYS:
            owners = proper.get(course)
            if not isinstance(owners, dict):
                continue
            carried[course] = {
                cycle: carry_owner(
                    owner,
                    (*identity[:3], str(cycle), identity[3]),
                    inherited_incipit=proper.get("incipit"),
                )
                if isinstance(owner, dict)
                else owner
                for cycle, owner in owners.items()
            }
    return carried


def calendar_structure(root: Path, calendar: str, tokens: dict[str, str]) -> dict:
    document = load_calendar(root, calendar)
    overlay, untranslated, stale, witnesses = translation_overlay(calendar, root)
    latin_records, _ = publication_records(root, calendar)
    source = document.get("psalm_numbering")
    if source not in SYSTEMS:
        raise ValueError(f"{calendar} declares unknown psalm numbering {source!r}")
    masses = []
    for kind, mass in masses_of(document):
        propers = []
        for form, proper, taken_from in appointed_propers(document, mass):
            # A borrowed proper is looked up under the mass that prints it; the
            # rule and its reason live on `overlay_key`. Twelve such rows sat in
            # the 1962 sidecar for the four resumed Sundays after the Epiphany,
            # and one of them had already drifted from its twin.
            key = overlay_key(mass, form, proper, taken_from)
            identity = source_slot_identity(
                document, mass, form, proper, taken_from
            )
            absence_records = matching_untranslated_records(
                proper,
                untranslated.get(untranslated_key(identity)) or [],
                identity[3],
            )
            current_form_id = form_id_for_label(mass, form)
            carried = carry_translations(
                calendar, key, proper, overlay, stale, identity, witnesses
            )
            carried = sanitize_proper(
                carried,
                LatinKey(str(key[0] or ""), str(key[1] or ""), str(key[2] or "")),
                latin_records,
                STRUCTURE_SURFACES,
            )

            def cited(owner: dict) -> list[dict]:
                return [
                    citation_structure(entry, source, tokens)
                    for entry in (owner.get("verses") or [])
                    if isinstance(entry, dict) and entry.get("ref")
                ]

            # A cycle-varying proper reads differently in years A, B and C, so
            # each year's citations are kept apart rather than merged into one
            # list the browser could not tell apart.
            # A cycle may vary in kind as well as in text: an acclamation
            # composed one year and scriptural the next, so each year carries
            # both its citations and its own words.
            def course(wanted: str) -> dict:
                """One reading course's cycles, citations and own words kept."""
                built = {}
                for name, cycle, owner in cycle_owners(carried):
                    if name != wanted:
                        continue
                    rows = cited(owner)
                    cycle_absences = [
                        record
                        for record in absence_records
                        if str(record.get("cycle") or CYCLE_ALL) == cycle
                    ]
                    if (
                        rows
                        or owner.get("text")
                        or owner.get("latin")
                        or owner.get("text_status")
                        or cycle_absences
                    ):
                        cycle_proper = {
                            "name": carried.get("name"),
                            "citations": rows,
                            "source": owner.get("source"),
                            "text": owner.get("text"),
                            "latin": (
                                public_latin_state(
                                    owner["latin"], str(carried.get("name") or "Proper")
                                )
                                if isinstance(owner.get("latin"), dict)
                                else None
                            ),
                            "text_status": (
                                public_text_status(owner["text_status"])
                                if isinstance(owner.get("text_status"), dict)
                                else None
                            ),
                            "translations": publishable_translations(owner),
                            "unavailable_translations": (
                                unavailable_states_from_records(
                                    cycle_absences, cycle
                                )
                                or None
                            ),
                            "untranslated": public_untranslated_records(
                                cycle_absences
                            ),
                        }
                        cycle_proper["languages"] = proper_language_capabilities(
                            cycle_proper, cycle
                        )
                        built[cycle] = cycle_proper
                return built

            # The Sunday course is emitted always, empty mapping and all,
            # because the browser has read that key since the first structure
            # file. The weekday course is emitted only where a proper carries
            # one: an empty mapping on every proper of every calendar would
            # rewrite three tracked structure files to say that nothing varies
            # by a course nothing yet reads, and `structure --check` measures
            # those bytes. The key appears with the first entry that carries it.
            weekday_cycles = course(WEEKDAY_CYCLES_KEY)
            built_proper = {
                    "name": carried.get("name"),
                    # A mass with several formularies labels each one; an
                    # ordinary mass has no form and carries an empty label.
                    "form": form,
                    "form_id": current_form_id,
                    "incipit": carried.get("incipit"),
                    "source": carried.get("source"),
                    # A composed proper is an oration, not a citation: its words
                    # are the proper. Carrying only the incipit left the page
                    # naming a Collect it could not show.
                    # Placeholder prose is repository apparatus, never
                    # appointed liturgical wording for a public reader.
                    "text": (
                        None
                        if carried.get("name") == PLACEHOLDER
                        else carried.get("text")
                    ),
                    # Provenance identifies a witness; publication independently
                    # decides whether its words may reach this public artifact.
                    "latin": (
                        public_latin_state(
                            carried["latin"], str(carried.get("name") or "Proper")
                        )
                        if isinstance(carried.get("latin"), dict)
                        else None
                    ),
                    "text_status": (
                        public_text_status(carried["text_status"])
                        if isinstance(carried.get("text_status"), dict)
                        else None
                    ),
                    "translations": publishable_translations(carried),
                    # A restricted translation is absent as WORDING, not absent
                    # from the model.  This text-free state prevents consumers
                    # from turning a rights decision into a false corpus gap.
                    "unavailable_translations": (
                        (
                            unavailable_translation_states(carried)
                            + unavailable_states_from_records(
                                absence_records, CYCLE_ALL
                            )
                        )
                        or None
                    ),
                    # Distinguishes a proper nobody has looked at from one
                    # deliberately left without English.
                    "untranslated": (
                        public_untranslated_records(
                            [
                                record
                                for record in absence_records
                                if str(record.get("cycle") or CYCLE_ALL)
                                == CYCLE_ALL
                            ]
                        )
                    ),
                    "citations": cited(carried),
                    "cycles": course(CYCLES_KEY),
                    **({WEEKDAY_CYCLES_KEY: weekday_cycles} if weekday_cycles else {}),
                    # Where the Missal prints this text, when it is not printed
                    # here. A page that showed a borrowed Collect as though the
                    # day printed it would be asserting something the book does
                    # not, so the provenance travels with the text and a reader
                    # can see that the words are the Common's.
                    "taken_from": taken_from or None,
                }
            if _calendars.ORDINARY_DISPOSITION in carried:
                built_proper[_calendars.ORDINARY_DISPOSITION] = (
                    public_ordinary_disposition(
                        carried[_calendars.ORDINARY_DISPOSITION]
                    )
                )
            built_proper["languages"] = proper_language_capabilities(built_proper)
            propers.append(built_proper)
        built = {
            "key": mass.get("key"),
            "name": mass.get("name"),
            "season": mass.get("season"),
            "kind": kind,
            # The calendar date the mass is kept on, "MM-DD", exactly as the
            # source records it, and absent where the source records none.
            # It is carried rather than left to be read back out of the
            # registry id: the registry conventions are the calendar's, a
            # date-shaped id is not always a date ("1962-12-29" is a day of
            # the temporal cycle) and a dated entry does not always end in
            # one ("1962-03-07-comm"), so a reader that parses ids is a
            # second derivation standing beside this one, free to disagree.
            "date": mass.get("date"),
            "registry": mass.get("registry"),
            # The formulary this mass takes whole, where it takes one. The
            # per-proper `taken_from` says the same thing slot by slot; this
            # says it once, which is what a heading needs.
            "takes_from": public_reference(mass.get(_calendars.TAKES_FROM)),
            "common_sets": (
                public_common_sets(mass[_calendars.COMMON_SETS])
                if isinstance(mass.get(_calendars.COMMON_SETS), dict)
                else None
            ),
            "common_from": (
                public_common_from(mass["common_from"])
                if isinstance(mass.get("common_from"), dict)
                else None
            ),
            "text_status": (
                public_text_status(mass["text_status"])
                if isinstance(mass.get("text_status"), dict)
                else None
            ),
            "propers": propers,
        }
        # Absence means the normal full Mass frame.  Keep that default implicit:
        # browser adapters deliberately distinguish an omitted field from an
        # invalid explicit null.  Exceptional rites carry their source mapping
        # unchanged so the adapter can fail closed on its applicability.
        if "ordinary_frame" in mass:
            built["ordinary_frame"] = public_ordinary_frame(mass["ordinary_frame"])
        source_forms = [
            form for form in (mass.get("forms") or []) if isinstance(form, dict)
        ]
        if source_forms:
            built["forms"] = []
            for ordinal, form in enumerate(source_forms, 1):
                built_form = {
                    "id": str(form.get("id") or ""),
                    "name": str(form.get("name") or ""),
                    "ordinal": ordinal,
                    "propers": [
                        proper
                        for proper in propers
                        if proper.get("form_id") == form.get("id")
                    ],
                }
                if "ordinary_frame" in form:
                    built_form["ordinary_frame"] = public_ordinary_frame(
                        form["ordinary_frame"]
                    )
                built["forms"].append(built_form)
        # How the recension reached this mass, where the calendar is one.
        # `_calendars._stamp` puts this on every entry of a recension precisely
        # so a page can say so, and rebuilding the mass from the whitelist above
        # dropped it: the pre-1955 structure file carried 490 masses, no
        # `text_from` anywhere in it, and a heading naming the 1920 typical
        # edition over text every word of which was transcribed from a 1962
        # printing. Absent rather than null on the other two calendars, because
        # that stamp's own rule is that a renderer finding no stamp is reading a
        # calendar that is nobody's recension -- a null would be a third state to
        # interpret.
        if isinstance(mass.get(RECENSION), dict):
            built[RECENSION] = mass[RECENSION]
        masses.append(built)
    manifest = translation_manifest(masses, witnesses)
    # Every proper's list is put into the manifest's order, so that the choice
    # of which English a reader sees is made once, here, and is the same choice
    # whether a consumer reads the manifest or simply takes the first entry in
    # the language it wants. Left in source order it would be neither stated nor
    # stable: two witnesses would be ranked by which happened to be typed first.
    order = {(row["lang"], row["source_id"]): index for index, row in enumerate(manifest)}
    for mass in masses:
        for proper in mass["propers"]:
            owners = [proper] + [
                cycle_owner
                for course in CYCLE_KEYS
                for cycle_owner in (proper.get(course) or {}).values()
                if isinstance(cycle_owner, dict)
            ]
            for owner in owners:
                if owner.get("translations"):
                    owner["translations"] = sorted(
                        owner["translations"], key=lambda t: order[witness_of(t)]
                    )
    structure = {
        "schema": "triptych-propers-structure/v1",
        "calendar": calendar,
        "edition": document.get("edition"),
        # The name a reader would say, for the control; `edition` stays the
        # bibliographic identification and is what the page prints against the
        # texts themselves. Carried from the source rather than shortened here,
        # so that no tool and no page holds a second opinion about what the two
        # books are called.
        "edition_short": document.get("edition_short"),
        "numbering": source,
        # The witnesses this missal's orations may be read in, in the order a
        # control should offer them; the first row of a language is its default.
        "translations": manifest,
        # Declared for both languages even where one is wholly unavailable.
        # These counts do not make a provenance or edition-attestation claim.
        "languages": language_capability(masses),
        "masses": masses,
    }
    # A recension's aggregate limitation is part of the public structure, not
    # UI copy. Without these source-owned fields an inherited base formulary can
    # look complete merely because that one mass contains no placeholder.
    for field in (
        "advisory",
        _calendars.RECENSION_ACT,
        _calendars.RECENSION_COVERAGE,
    ):
        if field in document:
            structure[field] = document[field]
    return structure


def _serialise(payload: object) -> str:
    return json.dumps(payload, ensure_ascii=False, sort_keys=True, indent=1) + "\n"


def refuse_symlink_output(root: Path, target: Path) -> None:
    """Never follow an owned output component outside the requested tree."""

    current = root
    if current.is_symlink():
        raise ValueError(f"output root is a symlink: {current}")
    for part in target.relative_to(root).parts:
        current = current / part
        if current.is_symlink():
            raise ValueError(f"propers output path is a symlink: {current}")


def run_structure(arguments: argparse.Namespace) -> dict:
    """Write one structure file per calendar for the browser to assemble from.

    Every file is built in memory first, so `--check` can compare the tracked
    bytes against what the sources produce NOW without writing anything. That
    verb exists because `make check` proved tracked `web/**/*.md` current and
    proved nothing at all about this directory: on 2026-08-07 regenerating with
    unchanged tools rewrote 4,269 lines of `roman-pre-1955.json` that no source
    change of that day accounts for. The served recension had drifted that far
    with nothing reporting it, which is the failure that looks like success —
    the page renders, and renders a missal the sources stopped describing.
    """
    out = Path(arguments.out)
    propers_dir = out / "structure" / "propers"
    refuse_symlink_output(out, propers_dir)
    root = Path(arguments.root)
    tokens = book_tokens()
    names = [arguments.calendar] if arguments.calendar else calendars(root)
    written, counts, refused, withheld, withheld_latin = [], {}, [], [], []
    files: dict[Path, str] = {}
    for name in names:
        built = calendar_structure(root, name, tokens)
        for mass in built["masses"]:
            for proper in mass["propers"]:
                latin = proper.get("latin")
                if isinstance(latin, dict) and latin.get("withheld"):
                    withheld_latin.append(
                        f"{name} {mass.get('key')}/{proper.get('name')}: "
                        f"{latin.get('reason') or 'publication unresolved'}"
                    )
                for course in CYCLE_KEYS:
                    for cycle, owner in (proper.get(course) or {}).items():
                        latin = owner.get("latin") if isinstance(owner, dict) else None
                        if isinstance(latin, dict) and latin.get("withheld"):
                            withheld_latin.append(
                                f"{name} {mass.get('key')}/{proper.get('name')} "
                                f"{course}:{cycle}: "
                                f"{latin.get('reason') or 'publication unresolved'}"
                            )
        # Counted from the source, before the structure pass drops them: the
        # structure file is what the site serves, so anything filtered out of it
        # cannot be counted from it afterwards.
        document = load_calendar(root, name)
        for section in (document.get("sections") or {}).values():
            for mass in section.get("masses") or []:
                for proper_name, lang, source_id, rights in withheld_translations(mass):
                    withheld.append(
                        f"{name} {mass.get('key')}/{proper_name}: {lang} from "
                        f"{source_id or 'no source'} withheld "
                        f"({rights or 'no rights basis stated'})"
                    )
        # `--out` is the data root the page is served from, so both generators
        # take the same one: the manifest lands at its head and the structure
        # files under `structure/`.
        path = propers_dir / f"{name}.json"
        refuse_symlink_output(out, path)
        files[path] = _serialise(built)
        written.append(str(path))
        cited = [
            citation
            for mass in built["masses"]
            for proper in mass["propers"]
            for rows in [
                proper["citations"],
                *(
                    cycle["citations"]
                    for key in CYCLE_KEYS
                    for cycle in (proper.get(key) or {}).values()
                ),
            ]
            for citation in rows
        ]
        counts[name] = {"masses": len(built["masses"]), "citations": len(cited)}
        refused.extend(
            f"{name} {c['ref']}: {c['unresolved']}" for c in cited if c["unresolved"]
        )

    # The manifest lists what is THERE, not what was built this run. A run
    # scoped by `--calendar` into the site's own data root must still name every
    # missal the reader can open, and the same run into an empty directory must
    # name only the one it wrote -- otherwise the file whose whole purpose is to
    # stop the page probing for missals would itself advertise a 404.
    listed = []
    for name in calendars(root):
        where = propers_dir / f"{name}.json"
        refuse_symlink_output(out, where)
        # Built this run OR already there: `files` holds what this run produced
        # and has not yet written, which under `--check` it never will.
        if where not in files and not where.exists():
            continue
        document = load_calendar(root, name)
        listed.append(
            {
                "id": name,
                "edition": document.get("edition"),
                "edition_short": document.get("edition_short"),
            }
        )
    listed.sort(key=lambda entry: (entry["id"] != LANDING_MISSAL, entry["id"]))
    manifest = out.joinpath(*MISSAL_MANIFEST)
    refuse_symlink_output(out, manifest)
    if listed:
        files[manifest] = _serialise(
            {
                # Named, and not merely first. A reader of this file should
                # not have to infer the landing missal from row order, and a
                # page that reads it should not have to trust that order.
                "default": (
                    LANDING_MISSAL
                    if any(entry["id"] == LANDING_MISSAL for entry in listed)
                    else listed[0]["id"]
                ),
                "missals": listed,
            }
        )
        written.append(str(manifest))

    # Only an unscoped run owns the complete directory. A scoped regeneration
    # must neither diagnose nor prune another calendar's file, while a full
    # run must not leave an orphan JSON for public-alpha to copy and serve.
    orphaned: list[Path] = []
    if not arguments.calendar:
        expected = {path for path in files if path.parent == propers_dir}
        if propers_dir.is_dir():
            orphaned = sorted(
                path
                for path in propers_dir.glob("*.json")
                if path not in expected
            )

    if arguments.check:
        # Named individually, not counted. "3 files have drifted" sends a reader
        # to regenerate and diff; a path sends them to the one file, and the
        # first line of its diff usually says which source moved.
        drifted = sorted(
            str(path)
            for path, body in files.items()
            if not path.is_file() or path.read_text(encoding="utf-8") != body
        )
        drifted.extend(str(path) for path in orphaned)
        drifted.sort()
        return {
            "checked": sorted(
                [*(str(path) for path in files), *(str(path) for path in orphaned)]
            ),
            "drifted": drifted,
            "calendars": counts,
            "refused": refused if arguments.verbose else len(refused),
            "withheld": withheld if arguments.verbose else len(withheld),
            "withheld_latin": (
                withheld_latin if arguments.verbose else len(withheld_latin)
            ),
            "status": "stale" if drifted else "ok",
        }

    for path, body in files.items():
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(body, encoding="utf-8")
    for path in orphaned:
        path.unlink()

    return {
        "written": written,
        "calendars": counts,
        "refused": refused if arguments.verbose else len(refused),
        # A translation the corpus holds and the site does not show. Reported
        # every time, not only when verbose: withholding text silently is the
        # same defect as publishing it silently, read from the other side.
        "withheld": withheld if arguments.verbose else len(withheld),
        "withheld_latin": withheld_latin if arguments.verbose else len(withheld_latin),
        "pruned": [str(path) for path in orphaned],
        "status": "ok",
    }


# --- The census -------------------------------------------------------------
#
# One count of this corpus existed in three hand-typed copies — docs/the-mass.md,
# guidance/propers-for-agents.md, and the table in src/sources/calendars/README.md
# — and all three disagreed, because each was retyped at a different hour and
# none was rederived when the calendars moved. The 1962 sanctoral section alone
# read 247 in one document and 307 in the file. So the count is derived here,
# once, and the documents carry the derivation rather than a transcription of it.
#
# Every figure below is a decision about what to count, not a fact about the
# corpus, and two honest counters differ by hundreds if they key differently.
# CENSUS_KEYS states each key in the emitted block, so a reader never has to
# guess whether a placeholder was in the total.
PLACEHOLDER = "Placeholder"
SCRIPTURE_BEARING = frozenset({"scripture", "mixed"})
# Section order in the emitted table. The two files list their sections in
# different orders, and a table that followed file order would reshuffle when a
# section moved; this order is the one the prose already reads in.
KIND_ORDER = ("seasonal", "christological", "marian", "sanctoral")
# Calendar order, oldest book first, matching how every document introduces
# them. Anything unlisted follows, sorted, so a third calendar still lands
# somewhere deterministic.
CALENDAR_ORDER = ("roman-pre-1955", "roman-1962", "postconciliar")

# The markers name no command. A marker is a delimiter, and one carrying the
# invocation would have to be rewritten in every document the day the verb is
# renamed — with every document that had not yet been rewritten refused as
# markerless. The regeneration command is in the emitted prose instead, which
# is where a reader is actually reading.
CENSUS_BEGIN = "<!-- census:begin — derived; edit nothing between these markers -->"
CENSUS_END = "<!-- census:end -->"
# Every document that carries the derived block. A document not listed here
# carries no census figures at all; that is the point of the list.
CENSUS_DOCUMENTS = (
    "docs/the-mass.md",
    "guidance/propers-for-agents.md",
    "src/sources/calendars/README.md",
)

# The emitted prose names the direct paths, `tools/mass-propers` and
# `tools/citations`, not the launcher. That is not a style choice: tmt reads a
# bare sibling id in a tool body as an undeclared dependency, so naming the
# launcher here fails `tmt check` with
#     FAIL mass-propers: uses sibling 'tpt' without declaring it in requires
# Both forms run. Do not "fix" these to the launcher form.
CENSUS_KEYS = (
    "Counted from `src/sources/calendars/*/propers.yaml` and written here by "
    "`tools/mass-propers census --write`, which is the only thing that writes "
    "the block above; `make check-propers-census` refuses a copy that has "
    "drifted. What each row counts, because two honest counts of “propers” "
    "differ by hundreds when they key differently: a **mass** is one entry under "
    "`sections[*].masses`. A **proper** is one entry in a mass's `propers`, or in "
    "the `propers` of one of its `forms`; a proper carrying `cycles` counts once, "
    "not three times. Placeholders are **inside** the proper and mass totals, and "
    "are also given their own rows. A mass **holds only placeholders** when every "
    "proper it holds, those inside `forms` included, is named `Placeholder` — "
    "keying on the mass's own `propers` alone undercounts, because it misses the "
    "masses whose placeholders sit inside a `forms` block. **Scripture-bearing** "
    "means a `source` of `scripture` or `mixed`, or a `cycles` entry that is. "
    "**Encoded passages** and **distinct books** are `tools/citations check`'s "
    "own counts, one passage per encoded citation entry and books counted distinct "
    "within a file. **Distinct slot names** counts distinct proper `name` values, "
    "with `Placeholder` among them. The two **taking** rows count the entries "
    "that name where their text is printed instead of printing it — a feria "
    "taking the preceding Sunday, a saint taking a Mass of the Common. Such an "
    "entry holds few propers or none, so it lowers the proper count while "
    "raising what the calendar can actually show: every row above counts what a "
    "file **carries**, and these two count what it **appoints** from elsewhere. "
    "Neither is a placeholder."
)

# The rank table's own keys. Kept a separate paragraph so that adding it did not
# re-wrap a word of the paragraph above; see `render_census`.
#
# It states keys and names no figure, exactly as CENSUS_KEYS does. A sentence
# here saying how many joined entries there are would be a hand-typed count
# sitting inside the derived block — the defect the block exists to end, smuggled
# back in as prose.
CENSUS_RANK_KEYS = (
    "The rank rows count **entries**, and a calendar's rank rows sum to its "
    "`Masses` above. `(no rank)` is a row and not an omission: the temporal "
    "cycle prints no rank at all, so unranked entries are a large group in both "
    "indexes, and a table that dropped them would invite the ranks it does show "
    "to be read as the whole book. **Celebrations** counts what those "
    "entries name. One entry can print more than one celebration — a pair of "
    "optional memorials falling on the same day, or the Greater Litanies kept "
    "with Saint Mark — and the index records the join only in the entry's "
    "`name`, joined with `;`, so that is where it is read from; the plural rank "
    "word marks some such entries and not others, and it never says how many. "
    "Where the two columns differ the index is keeping more celebrations than it "
    "holds entries: reading the entry count as a count of celebrations "
    "understates the calendar, and folding the celebrations into the entry "
    "count would break the sum against `Masses`, so both are given and neither "
    "replaces the other. A **rank** is reproduced exactly as the file prints it. "
    "`Optional memorial` and `Optional memorials` are two rows because they are "
    "two different words in the index, and the two Missals' rank vocabularies "
    "are not one scale — no row of this table is comparable across calendars, "
    "which is why rank is tabulated down the page and not across it. This table "
    "answers what an index is scoped to; it does not answer which entries are "
    "Sundays, because no entry states that and it is not derived here."
)


def ordered(names: list[str], preferred: tuple[str, ...]) -> list[str]:
    """Declared order first, then anything else sorted. Deterministic either way."""
    known = [name for name in preferred if name in names]
    return known + sorted(set(names) - set(known))


def proper_sources(proper: dict) -> set[str]:
    """A proper's `source`, or its cycles' where the kind varies by year.

    Either course: a weekday reading is scripture-bearing on the same terms a
    Sunday reading is, and a course this function did not look at would have its
    propers counted as carrying no source at all.
    """
    sources = ({str(proper["source"])} if proper.get("source") else set())
    sources.update({
        str(owner["source"])
        for _, _, owner in cycle_owners(proper)
        if owner.get("source")
    })
    return sources


# The label a rank row carries when the entry printed no rank. It is a row and
# not an omission: the temporal cycle prints no rank at all, so unranked entries
# are a large group in both indexes, and a rank table that simply left them out
# would invite the reader to take the ranks it does show as the whole book.
NO_RANK = "(no rank)"
# One entry can print more than one celebration, and the index joins them in the
# entry's own `name` with a semicolon: a pair of optional memorials falling on
# the same day, or the Greater Litanies kept with Saint Mark. Splitting the name
# is a reading of prose and is stated as such in CENSUS_RANK_KEYS, but it is the
# only place the file records the join at all — the plural rank word marks some
# of these entries and not others, and it does not say how many.
CELEBRATION_JOIN = ";"


def celebrations_in(mass: dict) -> int:
    """How many celebrations one entry prints, read from its own name.

    An entry with no name at all still keeps one Mass, so the floor is one and
    never zero: a nameless entry is a naming defect, not an empty day.
    """
    named = [part for part in str(mass.get("name") or "").split(CELEBRATION_JOIN) if part.strip()]
    return len(named) or 1


def rank_census(document: dict) -> list[dict]:
    """Entries and celebrations per printed rank, unranked entries first.

    Counted by the rank string EXACTLY as the file prints it. Normalising here
    would be this tool inventing a rank vocabulary: `Optional memorial` and
    `Optional memorials` are two different words in the postconciliar index and
    mean two different things, and the 1962 index's `I`/`II`/`III`/`Comm.` are
    not the same scale as the postconciliar's names at all.

    Ordered by the rank string rather than by count, so that a row moves only
    when a rank appears or disappears. Ordering by size would reshuffle the
    table every time a mass landed, which is the reflow the block exists to
    avoid.
    """
    counted: dict[str, dict] = {}
    for _, mass in masses_of(document):
        rank = mass.get("rank")
        label = NO_RANK if rank is None or str(rank) == "" else str(rank)
        row = counted.setdefault(label, {"rank": label, "entries": 0, "celebrations": 0})
        row["entries"] += 1
        row["celebrations"] += celebrations_in(mass)
    return sorted(counted.values(), key=lambda row: (row["rank"] != NO_RANK, row["rank"]))


def census_of(document: dict) -> dict:
    """Count one calendar file. Sections first, then the file's own totals."""
    rows = []
    for name, body in (document.get("sections") or {}).items():
        if not isinstance(body, dict):
            continue
        masses = [mass for mass in (body.get("masses") or []) if isinstance(mass, dict)]
        propers = [proper for mass in masses for _, proper in propers_of(mass)]
        rows.append(
            {
                "section": str(name),
                "kind": str(body.get("kind") or ""),
                "masses": len(masses),
                "propers": len(propers),
                "placeholder_only_masses": sum(
                    1 for mass in masses if placeholder_only(mass)
                ),
            }
        )
    rows.sort(
        key=lambda row: (
            KIND_ORDER.index(row["kind"]) if row["kind"] in KIND_ORDER else len(KIND_ORDER),
            row["section"],
        )
    )
    every = [
        (form, proper)
        for _, mass in masses_of(document)
        for form, proper in propers_of(mass)
    ]
    substantive = [proper for _, proper in every if proper.get("name") != PLACEHOLDER]
    return {
        "sections": rows,
        "ranks": rank_census(document),
        "masses": sum(row["masses"] for row in rows),
        "propers": len(every),
        "placeholder_propers": sum(
            1 for _, proper in every if proper.get("name") == PLACEHOLDER
        ),
        "propers_in_forms": sum(1 for form, _ in every if form),
        # A proper varying by cycle is ONE proper, not three or two: it is one
        # slot of one Mass, and only one of its cycles is ever said. The two
        # courses are counted apart because they are two different cycles, and a
        # single row would answer neither "how much of this file varies by the
        # Sunday year" nor "how much by the weekday year".
        "cycle_propers": sum(1 for _, proper in every if proper.get(CYCLES_KEY)),
        "weekday_cycle_propers": sum(
            1 for _, proper in every if proper.get(WEEKDAY_CYCLES_KEY)
        ),
        "placeholder_only_masses": sum(row["placeholder_only_masses"] for row in rows),
        "substantive_propers": len(substantive),
        "scripture_bearing_propers": sum(
            1 for proper in substantive if proper_sources(proper) & SCRIPTURE_BEARING
        ),
        "slot_names": len({str(proper.get("name") or "") for _, proper in every}),
        # A mass that names the formulary it takes carries few propers or none,
        # so the rows above would report it as emptier than a placeholder. It is
        # the opposite: it is the one shape in this file that resolves to a
        # whole Mass. Counted separately so neither reading can be taken for the
        # other.
        "masses_taking_a_formulary": sum(
            1 for _, mass in masses_of(document) if mass.get(_calendars.TAKES_FROM)
        ),
        "propers_taken_by_reference": sum(
            1
            for _, mass in masses_of(document)
            for _, proper in propers_of(mass)
            if _calendars.TAKES_FROM in proper
        ),
    }


def placeholder_only(mass: dict) -> bool:
    """Every proper it holds, forms included, is a placeholder.

    Reading the mass's own `propers` alone is the wrong key and was the one in
    use: it reports False for a mass that holds nothing but `forms`, so the
    Christmas octave and four postconciliar vigil-and-day pairs counted as
    substantive when they hold nothing but placeholders.
    """
    names = [str(proper.get("name") or "") for _, proper in propers_of(mass)]
    return bool(names) and set(names) == {PLACEHOLDER}


def passage_counts(root: Path) -> dict[str, dict[str, int]]:
    """Passages and distinct books, from the tool that owns citations.

    Re-deriving these here is exactly how the three copies came to disagree, so
    they are read from `citations check` rather than recounted.
    """
    loader = SourceFileLoader("_citations", str(Path(__file__).resolve().parent / "citations"))
    spec = spec_from_loader(loader.name, loader)
    module = module_from_spec(spec)
    loader.exec_module(module)
    counted = module.check(root)["files"]
    return {
        Path(path).parent.name: {"passages": row["passages"], "books": row["books"]}
        for path, row in counted.items()
    }


# --- The English coverage census, derived and reported, written nowhere ------
#
# `english_oration_census` in `src/sources/inventories/roman-1962-proper-
# translations-v1.toml` states this coverage in hand-typed prose, and it is the
# same defect the census above exists to end, one layer over: a slot total, a
# covered total and a ledgered total, all retyped, all beside a corpus that
# moves every day. That block is not this tool's to write — it is prose with an
# argument in it, and only its owner can rewrite it — so these figures are
# DERIVED AND REPORTED and nothing here writes them anywhere.
#
# Reporting them without being asked is the point. Behind a flag they would be
# seen only by someone who already suspected drift; printed by the verb an
# operator runs after every wave, the drift announces itself. They go to stderr
# because stdout is the block, and the block has to stay byte-identical to what
# `--write` puts in the documents — and not under `--check`, for the reason
# given where they are printed.

# A slot name without its rubrical qualifier: `Secret (Pro Martyre tantum)` is a
# Secret. The ledger records the qualified name, the calendar prints it, and the
# family is what says whether a slot is the KIND of thing the ledger addresses.
SLOT_QUALIFIER = " ("


def slot_family(name: object) -> str:
    return str(name or "").split(SLOT_QUALIFIER)[0]


def has_translation(entry: dict, language: str) -> bool:
    """Whether an overlay entry actually carries ``language``.

    Coverage is language-specific. A nonempty translations array is not an
    English rendering merely because English is the only language held today.
    """
    return any(
        isinstance(translation, dict) and translation.get("lang") == language
        for translation in entry.get("translations") or []
    )


def coverage_slot_units(
    proper: dict, identity: tuple[str, str, str, int]
) -> list[tuple[tuple[str, str, str, str, int], dict]]:
    """Composed body units owned by one appointed Proper.

    A cycle-bearing Lectionary Proper is not one undifferentiated body.  Only
    its composed cycle owners belong to this translation ledger; scripture
    cycles remain delegated to the Bible.  A cycle-specific absence can then
    close only that unit, while an ``all`` row remains the identity of a real
    top-level, non-cycle body.
    """

    owners = cycle_owners(proper)
    if not owners:
        if proper_sources(proper) <= {"scripture"}:
            return []
        return [((*identity[:3], CYCLE_ALL, identity[3]), proper)]

    top_source = str(proper.get("source") or "")
    units: list[tuple[tuple[str, str, str, str, int], dict]] = []
    for _, cycle, owner in owners:
        source = str(owner.get("source") or top_source)
        # An owner with neither source nor retained body is not a Missal body
        # to translate.  It may still carry scripture ranges inherited from a
        # top-level scripture declaration.
        if source == "scripture" or (
            not source and not owner.get("text") and not proper.get("text")
        ):
            continue
        units.append(((*identity[:3], cycle, identity[3]), owner))
    return units


def english_coverage(root: Path, calendar: str) -> dict | None:
    """How far a calendar's recorded English reaches, once `takes_from` resolves.

    Returns None for a calendar with no translation ledger; there is nothing to
    be covered or uncovered against.

    Three decisions, because two honest counts differ here as sharply as they do
    over "propers":

    * A slot is counted ONCE however many days appoint it, keyed by
      `overlay_key` — the same key the structure pass merges on, so this counts
      what the browser would actually serve rather than a second resolution.
    * The denominator is the ledger's OWN slot vocabulary: the families it has
      an opinion about, whether that opinion is a translation or a recorded
      reason for having none. A ledger that has never addressed Sequences is not
      silently failing to translate them. What that leaves out is counted too,
      as `outside_the_ledger`, so the narrower denominator cannot hide behind
      itself.
    * Propers whose words are WHOLLY a bible's are excluded, and only those.
      `source: scripture` carries citations and no text of its own, so its
      English is the bible's and no ledger owes it one. `source: mixed` carries
      both, and the text half is the Missal's own words which no bible renders:
      the nineteenth Sunday after Pentecost prints `Salus populi ego sum` above
      its psalm verse, and a reader with a bible attached still saw that
      antiphon in Latin. Excluding `mixed` counted a real gap as out of scope
      and then hid the rows that closed it under `unmatched_records`, which
      reads as ledger rot and is the opposite of it.

    `unmatched_records` is the ledger's own rot: rows keyed to a slot no mass
    appoints any more. It is reported because such a row is invisible from the
    other side — it translates nothing and it lowers nothing.
    """
    overlay, untranslated, _, _ = translation_overlay(calendar, root)
    if not overlay and not untranslated:
        return None
    ledger_calendars = translation_ledger_calendars(calendar, root)
    if not ledger_calendars:
        return None
    ledger_calendar = ledger_calendars[-1]
    document = load_calendar(root, calendar)
    families = {slot_family(key[2]) for key in overlay} | {
        slot_family(key[2]) for key in untranslated
    }
    slots: dict[
        tuple[str, str, str, str, int],
        tuple[dict, dict, tuple[str, str, str]],
    ] = {}
    composed: set[tuple[str, str, str, str, int]] = set()
    for _, mass in masses_of(document):
        for form, proper, taken_from in appointed_propers(document, mass):
            if proper.get("name") == PLACEHOLDER:
                continue
            legacy_key = overlay_key(mass, form, proper, taken_from)
            source_identity = source_slot_identity(
                document, mass, form, proper, taken_from
            )
            units = coverage_slot_units(proper, source_identity)
            for identity, owner in units:
                composed.add(identity)
                if slot_family(proper.get("name")) in families:
                    slots[identity] = (proper, owner, legacy_key)
    held = {
        identity
        for identity, (_, owner, legacy_key) in slots.items()
        if translation_answers(
            translation_entry_for(overlay, legacy_key, identity) or {},
            owner,
            "en",
        )
    }
    available = {
        identity
        for identity in held
        for _, owner, legacy_key in [slots[identity]]
        if any(
            isinstance(translation, dict)
            and translation.get("lang") == "en"
            and translation_is_publishable(owner, translation)
            for translation in (
                translation_entry_for(overlay, legacy_key, identity) or {}
            ).get("translations") or []
        )
    }
    matched_any_untranslated: dict[
        tuple[str, str, str, str, int], list[dict]
    ] = {
        identity: matching_untranslated_records(
            proper,
            untranslated.get(untranslated_key(identity)) or [],
            identity[4],
            cycle=identity[3],
        )
        for identity, (proper, _, _) in slots.items()
    }
    matched_untranslated: dict[tuple[str, str, str, str, int], list[dict]] = {
        identity: matching_untranslated_records(
            proper,
            matched_any_untranslated[identity],
            identity[4],
            cycle=identity[3],
            extent="body",
        )
        for identity, (proper, _, _) in slots.items()
    }
    ledgered_slots = {
        identity for identity, records in matched_untranslated.items() if records
    }
    cycle_unavailable_records = sum(
        1
        for records in matched_untranslated.values()
        for record in records
        if str(record.get("cycle") or CYCLE_ALL) != CYCLE_ALL
    )
    ledgered = ledgered_slots - held
    matched_record_ids = {
        (
            identity[0],
            identity[1],
            identity[2],
            str(record["cycle"]),
            identity[4],
            str(record["extent"]),
        )
        for identity, records in matched_any_untranslated.items()
        for record in records
    }
    all_record_ids = {
        (
            str(record.get("mass") or ""),
            str(record["form_id"]),
            str(record.get("proper") or ""),
            str(record["cycle"]),
            int(record["occurrence"]),
            str(record["extent"]),
        )
        for records in untranslated.values()
        for record in records
        if isinstance(record, dict)
    }
    return {
        "calendar": calendar,
        # A coverage total can equal its base's because the same ledger was
        # inherited, not because this recension was independently translated.
        # Keep that provenance in the machine report even though the familiar
        # human summary remains one terse line.
        "translation_ledger_calendar": ledger_calendar,
        "translation_ledger_calendars": ledger_calendars,
        "translation_ledger_inherited": any(
            owner != calendar for owner in ledger_calendars
        ),
        "inherited_inapplicable_records": inherited_inapplicable_count(
            calendar, root
        ),
        "slots": len(slots),
        # `with_english` is retained as the public-available compatibility
        # field. Held-but-restricted slots are named separately and never
        # disappear into `unaccounted`.
        "with_english": len(available),
        "with_english_held": len(held),
        "rights_restricted": len(held - available),
        "ledgered_untranslated": len(ledgered),
        "cycle_unavailable_records": cycle_unavailable_records,
        "incipit_only_records": sum(
            1
            for records in matched_any_untranslated.values()
            for record in records
            if record["extent"] == "incipit"
        ),
        "unaccounted": len(slots) - len(held) - len(ledgered),
        "outside_the_ledger": len(composed - set(slots)),
        "unmatched_records": len(set(overlay) - set(slots))
        + len(all_record_ids - matched_record_ids),
        "stale_translation_records": sum(
            1
            for identity, (_, owner, legacy_key) in slots.items()
            for entry in [translation_entry_for(overlay, legacy_key, identity)]
            if entry is not None
            and has_translation(entry, "en")
            and not translation_answers(entry, owner, "en")
        ),
    }


# --- Structural, language and Latin-recension accounting -------------------
#
# These are intentionally separate dimensions. A resolved Proper is not proof
# that its complete body is held; a held body is not necessarily publishable;
# and a Latin body resident under a calendar headed 2008 is not thereby a
# transcription collated against the 2008 target edition.

LATIN_ANTECEDENT_WITNESS_FIELDS = (
    "ancient_witness",
    "witness_edition_id",
    "witness_artifact_id",
    "relation",
)
LATIN_ANTECEDENT_CALENDAR_FIELDS = (
    "antecedent_calendar",
    "antecedent_mass",
    "antecedent_proper",
    "relation",
)


def has_latin_antecedent_relation(entry: dict) -> bool:
    """Whether a sidecar row records one complete antecedent relation bundle."""

    return all(entry.get(field) for field in LATIN_ANTECEDENT_WITNESS_FIELDS) or all(
        entry.get(field) for field in LATIN_ANTECEDENT_CALENDAR_FIELDS
    )


def latin_recension_coverage(
    document: dict, overlay: dict, calendar: str = "postconciliar"
) -> dict:
    """Account for resident Latin without promoting residence to attestation.

    The postconciliar translations overlay also records some Latin antecedent
    relationships. Those relationships are useful but limited: an older
    witness can support a relation to ancient wording, while only a target-
    edition artifact could attest the target recension itself. The present
    sidecar schema has no such target-artifact field, which is therefore a
    reported model boundary rather than a fabricated zero-coverage claim.
    """

    slots: dict[
        tuple[str, str, str], tuple[dict, tuple[str, str, str, int]]
    ] = {}
    owner_masses = _calendars.mass_index(document)
    for _, mass in masses_of(document):
        for form, proper, taken_from in appointed_propers(document, mass):
            if proper.get("name") == PLACEHOLDER:
                continue
            if proper_sources(proper) <= {"scripture"}:
                continue
            key = overlay_key(mass, form, proper, taken_from)
            identity = source_slot_identity(
                document,
                mass,
                form,
                proper,
                taken_from,
                owner_masses=owner_masses,
            )
            slots[key] = (proper, identity)

    counted = {
        "antecedent_substitute_bodies": 0,
        "resident_bodies_with_antecedent_relation": 0,
        "resident_bodies_without_slot_relation": 0,
        "incipit_only": 0,
        "absent": 0,
    }
    for key, (proper, identity) in slots.items():
        entry = translation_entry_for(overlay, key, identity) or {}
        has_body = bool(proper.get("text")) or any(
            owner.get("text") for _, _, owner in cycle_owners(proper)
        )
        if not has_body:
            counted["incipit_only" if proper.get("incipit") else "absent"] += 1
        elif entry.get("antecedent_latin_here"):
            # This flag explicitly says the body here is an older printing,
            # not wording transcribed from the target postconciliar edition.
            counted["antecedent_substitute_bodies"] += 1
        elif has_latin_antecedent_relation(entry):
            counted["resident_bodies_with_antecedent_relation"] += 1
        else:
            counted["resident_bodies_without_slot_relation"] += 1

    resident = (
        counted["antecedent_substitute_bodies"]
        + counted["resident_bodies_with_antecedent_relation"]
        + counted["resident_bodies_without_slot_relation"]
    )
    canonical_slots = {
        (identity[0], identity[1], identity[2], CYCLE_ALL, identity[3])
        for _, identity in slots.values()
    }
    return {
        "calendar": calendar,
        "slots": len(slots),
        "resident_bodies": resident,
        **counted,
        "overlay_records_matching_slots": len(set(overlay) & canonical_slots),
        "unmatched_overlay_records": len(set(overlay) - canonical_slots),
        # A schema boundary, not a source claim. No current field can honestly
        # be counted as direct target-edition artifact attestation.
        "target_edition_artifact_attestation": "not-represented",
    }


def postconciliar_latin_coverage(root: Path) -> dict | None:
    """The one Latin recension row whose relationship metadata exists here."""

    if "postconciliar" not in calendars(root):
        return None
    document = load_calendar(root, "postconciliar")
    overlay, _, _, _ = translation_overlay("postconciliar", root)
    return latin_recension_coverage(document, overlay)


def finding_aid_coverage(
    document: dict,
    effective_document: dict | None = None,
    calendar: str | None = None,
) -> dict:
    """Structural representation and resolution, with no completeness claim.

    `document` is the on-disk representation; `effective_document` is the
    recension projection used by readers. Keeping both is what lets a six-row
    recension diff honestly report six represented masses and hundreds of
    effective resolved occurrences without calling either figure a whole book.
    """

    effective = effective_document or document
    effective_celebrations = sum(
        row["celebrations"] for row in rank_census(effective)
    )
    represented_masses = [mass for _, mass in masses_of(document)]
    represented_propers = [
        proper for mass in represented_masses for _, proper in propers_of(mass)
    ]
    resolved = direct = referenced = empty = 0
    errors = []
    unresolved_common_sets = []
    for _, mass in masses_of(effective):
        entries, problems = _calendars.resolve_propers(effective, mass)
        resolved += len(entries)
        direct += sum(provenance is None for _, _, provenance in entries)
        referenced += sum(provenance is not None for _, _, provenance in entries)
        if not entries:
            empty += 1
        if problems:
            errors.append(
                {
                    "mass": str(mass.get("key") or ""),
                    "problems": list(dict.fromkeys(problems)),
                }
            )
        reference = _calendars.reference_of(mass)
        selections = (
            reference.get(_calendars.COMMON_SETS)
            if isinstance(reference, dict)
            else None
        )
        if isinstance(selections, dict):
            for group_id, disposition in selections.items():
                if (
                    isinstance(group_id, str)
                    and isinstance(disposition, dict)
                    and disposition.get("state") == "unresolved"
                ):
                    unresolved_common_sets.append(
                        {
                            "mass": str(mass.get("key") or ""),
                            "target": str(reference.get("mass") or ""),
                            "group": group_id,
                            "candidates": list(disposition.get("candidates") or []),
                        }
                    )

    return {
        "calendar": str(calendar or document.get("calendar") or ""),
        "represented_masses": len(represented_masses),
        "represented_proper_records": len(represented_propers),
        "direct_proper_records": sum(
            proper.get("name") != PLACEHOLDER
            and _calendars.reference_of(proper) is None
            for proper in represented_propers
        ),
        "placeholder_proper_records": sum(
            proper.get("name") == PLACEHOLDER for proper in represented_propers
        ),
        "mass_reference_records": sum(
            _calendars.reference_of(mass) is not None for mass in represented_masses
        ),
        "proper_reference_records": sum(
            _calendars.reference_of(proper) is not None
            for proper in represented_propers
        ),
        "resolved_proper_occurrences": resolved,
        "direct_resolved_occurrences": direct,
        "referenced_resolved_occurrences": referenced,
        "effective_celebrations": effective_celebrations,
        "masses_resolving_no_propers": empty,
        "resolution_errors": errors,
        "unresolved_common_set_selections": unresolved_common_sets,
    }


def finding_aid_coverages(root: Path) -> list[dict]:
    """Every calendar's raw representation beside its effective resolution."""

    return [
        finding_aid_coverage(
            load_calendar(root, name, effective=False),
            load_calendar(root, name),
            name,
        )
        for name in ordered(calendars(root), CALENDAR_ORDER)
    ]


def coverage(root: Path) -> list[dict]:
    """Every calendar's coverage row, in the census's order.

    A calendar whose references do not resolve is REPORTED, not raised: the
    census is gated by `make check-propers-census`, and a broken reference
    turning that gate red would be this addition failing a check about something
    else entirely.
    """
    rows = []
    for name in ordered(calendars(root), CALENDAR_ORDER):
        try:
            row = english_coverage(root, name)
        except (ValueError, KeyError) as error:
            rows.append({"calendar": name, "error": str(error)})
            continue
        if row:
            rows.append(row)
    return rows


def render_coverage(rows: list[dict]) -> list[str]:
    """One line a calendar, for stderr. Never part of the block."""
    lines = []
    for row in rows:
        if "error" in row:
            lines.append(f"# {row['calendar']} English: not derived: {row['error']}")
            continue
        lines.append(
            f"# {row['calendar']} English orations: {row['slots']} slots appointed, "
            f"{row['with_english']} public-available, {row['rights_restricted']} "
            f"held rights-restricted, {row['ledgered_untranslated']} "
            f"ledgered untranslated, {row['unaccounted']} unaccounted; "
            f"{row['cycle_unavailable_records']} cycle-specific unavailable records, "
            f"{row['outside_the_ledger']} composed propers outside the ledger's "
            f"slots, {row['unmatched_records']} ledger rows matching no slot, "
            f"{row['stale_translation_records']} translation rows with stale incipits"
        )
    return lines


def render_latin_recension_coverage(row: dict | None) -> list[str]:
    """One provenance-qualified line for stderr, never for the census block."""

    if not row:
        return []
    return [
        f"# {row['calendar']} Latin recension: {row['slots']} unique "
        f"non-scriptural slots, {row['resident_bodies']} bodies resident; "
        f"{row['antecedent_substitute_bodies']} explicitly antecedent substitutes, "
        f"{row['resident_bodies_with_antecedent_relation']} other bodies with "
        f"antecedent-relation metadata, "
        f"{row['resident_bodies_without_slot_relation']} without per-slot Latin "
        f"relation; direct target-edition artifact attestation "
        f"{row['target_edition_artifact_attestation']}"
    ]


def census(root: Path) -> dict[str, dict]:
    cited = passage_counts(root)
    found = {}
    for name in ordered(calendars(root), CALENDAR_ORDER):
        # The file as written, not the merged document: a recension's size is the
        # size of its diff, and counting the base's masses under the recension's
        # name would report a projection as though it were a second whole book.
        counted = census_of(load_calendar(root, name, effective=False))
        counted.update(cited.get(name) or {"passages": 0, "books": 0})
        found[name] = counted
    return found


CENSUS_MEASURES = (
    ("Masses", "masses"),
    ("Propers", "propers"),
    ("— named `Placeholder`", "placeholder_propers"),
    ("— inside a `forms` block", "propers_in_forms"),
    ("— carrying a `cycles` mapping", "cycle_propers"),
    ("— carrying a `weekday_cycles` mapping", "weekday_cycle_propers"),
    ("Masses holding only placeholders", "placeholder_only_masses"),
    ("Masses taking a formulary from another entry", "masses_taking_a_formulary"),
    ("Propers taking their text from another entry", "propers_taken_by_reference"),
    ("Propers that are not placeholders", "substantive_propers"),
    ("— of those, scripture-bearing", "scripture_bearing_propers"),
    ("Encoded passages", "passages"),
    ("Distinct books cited", "books"),
    ("Distinct slot names", "slot_names"),
)
# Measures printed only where some calendar carries one. The block is tracked in
# two documents and compared byte for byte by `census --check`, so a row for a
# measure no file yet holds would put both documents into a stale state on the
# day the KEY was added rather than on the day the first DATA arrives — a red
# gate reporting nothing but zeroes, cleared by a `--write` that says nothing.
# Every row of the table as it stands is nonzero in at least one calendar, so
# this omits nothing a reader can see today; the row appears with the first
# entry that carries the key, in the wave that runs `--write` anyway.
CENSUS_MEASURES_WHEN_CARRIED = frozenset({"weekday_cycle_propers"})


def render_census(counted: dict[str, dict]) -> str:
    """The block both documents carry, byte-identical in each."""
    names = list(counted)
    lines = [CENSUS_BEGIN, ""]
    lines.append("| Calendar | Section | Masses | Propers | Masses holding only placeholders |")
    lines.append("| --- | --- | ---: | ---: | ---: |")
    for name in names:
        for row in counted[name]["sections"]:
            lines.append(
                f"| {name} | {row['kind'] or row['section']} | {row['masses']} | "
                f"{row['propers']} | {row['placeholder_only_masses']} |"
            )
    lines.append("")
    lines.append("| Calendar | Rank | Entries | Celebrations |")
    lines.append("| --- | --- | ---: | ---: |")
    for name in names:
        for row in counted[name]["ranks"]:
            lines.append(
                f"| {name} | {row['rank']} | {row['entries']} | {row['celebrations']} |"
            )
    lines.append("")
    lines.append("| Measure | " + " | ".join(names) + " |")
    lines.append("| --- |" + " ---: |" * len(names))
    for label, key in CENSUS_MEASURES:
        values = [counted[name].get(key, 0) for name in names]
        if key in CENSUS_MEASURES_WHEN_CARRIED and not any(values):
            continue
        lines.append(
            f"| {label} | " + " | ".join(str(value) for value in values) + " |"
        )
    lines.append("")
    lines.extend(textwrap.wrap(CENSUS_KEYS, WIDTH))
    # Wrapped as its own paragraph rather than appended to CENSUS_KEYS. Appending
    # would re-flow every line of a paragraph that has not changed, and the whole
    # value of a derived block is that a diff of it shows only what moved.
    lines.append("")
    lines.extend(textwrap.wrap(CENSUS_RANK_KEYS, WIDTH))
    lines.append("")
    lines.append(CENSUS_END)
    return "\n".join(lines) + "\n"


def replace_census(text: str, block: str) -> str:
    """Swap the delimited region for ``block``; refuse anything else."""
    begin, end = text.find(CENSUS_BEGIN), text.find(CENSUS_END)
    if begin < 0 or end < 0:
        raise ValueError(f"no census region: expected {CENSUS_BEGIN} and {CENSUS_END}")
    if end < begin:
        raise ValueError("census region is inverted: the end marker precedes the begin")
    return text[:begin] + block + text[end + len(CENSUS_END) + 1 :]


def run_census(arguments: argparse.Namespace) -> dict:
    """Derive the census; optionally rewrite or check the documents carrying it."""
    counted = census(Path(arguments.root))
    block = render_census(counted)
    root = Path(arguments.root)
    payload: dict[str, object] = {
        "calendars": counted,
        "block": block,
        # Derived every run and written into no document; see the comment above
        # `english_coverage` for why it is reported rather than written.
        "english_coverage": coverage(root),
        # Three deliberately independent questions: structural representation
        # and resolution, Latin residence/antecedence, and English coverage.
        "finding_aid_coverage": finding_aid_coverages(root),
        "latin_recension_coverage": postconciliar_latin_coverage(root),
        "status": "ok",
    }
    if not (arguments.write or arguments.check):
        return payload
    documents, stale = [], False
    for relative in CENSUS_DOCUMENTS:
        path = Path(arguments.doc_root) / relative
        if not path.is_file():
            raise ValueError(f"no document at {path}")
        before = path.read_text(encoding="utf-8")
        after = replace_census(before, block)
        if after == before:
            state = "current"
        elif arguments.write:
            path.write_text(after, encoding="utf-8")
            state = "rewritten"
        else:
            state = "stale"
            stale = True
        documents.append({"path": relative, "state": state})
    payload["documents"] = documents
    payload["status"] = "stale" if stale else "ok"
    return payload


def run_show_one(arguments: argparse.Namespace) -> dict:
    if not arguments.calendar:
        raise ValueError("--calendar is required")
    if not arguments.mass:
        raise ValueError("--mass is required")
    payload = find_mass(Path(arguments.root), arguments.calendar, arguments.mass)
    document = payload.pop("_document")
    arguments.appointed = appointed_propers(document, payload["mass"])
    # The recorded translations are merged through the same path the browser
    # gets and then filtered through the same rights rule.
    #
    # `propers.yaml` carries no `translations` key — they live in the sidecar
    # overlay this tool already reads for `structure`. Reading the raw entry
    # here meant this verb reported `no en translation recorded` over every one
    # of the translations the sidecar holds and the site serves, which is the
    # answer a maintainer would act on when checking whether a proper still
    # needs harvesting. Merged through `carry_translations` so the two verbs
    # cannot disagree about which entry answers which proper.
    #
    # A CLI is a distribution surface too.  It may report that a translation is
    # rights-restricted, but it must not become an alternate way to extract the
    # wording excluded from structure, downloads and the browser.
    overlay, untranslated, stale, witnesses = translation_overlay(
        arguments.calendar, Path(arguments.root)
    )
    latin_records, _ = publication_records(Path(arguments.root), arguments.calendar)
    merged = []
    for form, proper, taken_from in arguments.appointed:
        key = overlay_key(payload["mass"], form, proper, taken_from)
        identity = source_slot_identity(
            document, payload["mass"], form, proper, taken_from
        )
        carried = carry_translations(
            arguments.calendar,
            key,
            proper,
            overlay,
            stale,
            identity,
            witnesses,
        )
        carried = sanitize_proper(
            carried,
            LatinKey(str(key[0] or ""), str(key[1] or ""), str(key[2] or "")),
            latin_records,
            CLI_SURFACES,
        )
        # Distinguishes a proper nobody has looked at from one deliberately
        # left without English, which is the distinction the `untranslated`
        # ledger exists to record; the structure pass writes the same key.
        records = matching_untranslated_records(
            carried,
            untranslated.get(untranslated_key(identity)) or [],
            identity[3],
        )
        whole_records = [
            record
            for record in records
            if str(record.get("cycle") or CYCLE_ALL) == CYCLE_ALL
        ]
        if whole_records:
            carried["untranslated"] = whole_records
            carried["unavailable_translations"] = (
                (carried.get("unavailable_translations") or [])
                + unavailable_states_from_records(whole_records, CYCLE_ALL)
            )
        for course in CYCLE_KEYS:
            owners = carried.get(course)
            if not isinstance(owners, dict):
                continue
            for cycle, owner in owners.items():
                if not isinstance(owner, dict):
                    continue
                cycle_records = [
                    record
                    for record in records
                    if str(record.get("cycle") or CYCLE_ALL) == str(cycle)
                ]
                if not cycle_records:
                    continue
                owner["untranslated"] = cycle_records
                owner["unavailable_translations"] = (
                    (owner.get("unavailable_translations") or [])
                    + unavailable_states_from_records(cycle_records, str(cycle))
                )
        carried = rights_safe_copy(carried)
        merged.append((form, carried, taken_from))
    arguments.appointed = merged
    # `show --format json|yaml` carries the raw source mass as well as the
    # resolved appointed list.  Redact that copy recursively so nested forms or
    # source-local translations cannot bypass the appointed-list filter.
    payload["mass"] = rights_safe_copy(
        sanitize_mass(payload["mass"], latin_records, CLI_SURFACES)
    )
    if stale:
        payload["stale_translations"] = stale
    # Resolve here so a missing bible or an unusable numbering fails before rendering.
    bible = load_bible(arguments.bible, Path(arguments.bible_root)) if arguments.bible else None
    arguments.resolved_bible = (
        resolve_passages(payload, bible, arguments.appointed) if bible else {}
    )

    # What the day USES, in the payload and not only in the reading view.
    #
    # `mass.propers` is what the entry CARRIES, and for a great many masses
    # that is not the Mass: a third-class saint carries three orations and
    # points at a Common for everything else, and Christmas carries no flat
    # list at all but four `forms`. A caller reading `mass.propers` from the
    # JSON therefore saw a Sunday correctly, a saint with no Epistle and no
    # Gospel, and Christmas as an empty Mass — an absence with no reason,
    # printed by `mass-today` for months. The resolution already existed and
    # was reachable from the text renderer alone; this is the same one
    # derivation, `_calendars.resolve_propers`, serialised.
    payload["appointed"] = [
        {
            "form": form or None,
            "form_id": form_id_for_label(payload["mass"], form),
            "name": proper.get("name"),
            "taken_from": taken_from,
            "proper": proper,
        }
        for form, proper, taken_from in arguments.appointed
    ]
    # And the words behind the citations, when a bible was named. `--bible`
    # resolved them and printed them and never put them in the payload, so
    # `mass-today --bible` passed the flag through and showed no scripture at
    # all: the flag was inert everywhere except this tool's own text view.
    #
    # The key is present only where a bible was named. `--bible` is a rendering
    # option and an option may not sit in a record — the smoke test says so and
    # is right — so what appears here is not the flag but what the flag
    # RESOLVED, and where nothing was resolved there is nothing to carry.
    if bible:
        payload["bible"] = {
            "id": arguments.bible,
            "edition": bible.get("edition"),
            "numbering": bible.get("numbering"),
            "passages": arguments.resolved_bible,
        }
    return payload


def run_show(arguments: argparse.Namespace) -> dict:
    """Show one mass unchanged, or several through one validated source load."""

    requested = arguments.mass
    masses = requested if isinstance(requested, list) else [requested]
    if len(masses) <= 1:
        # The text renderer consumes the resolved Bible passages and appointed
        # propers from the parsed namespace.  Keep the single-Mass path on that
        # namespace; mutating an unobserved copy leaves the machine payload
        # correct while silently dropping both values from the reading view.
        arguments.mass = masses[0]
        return run_show_one(arguments)

    payloads = []
    for mass in masses:
        one = argparse.Namespace(**vars(arguments))
        one.mass = mass
        payloads.append(run_show_one(one))
    return {"masses": payloads}


def run_list(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    wanted = [arguments.calendar] if arguments.calendar else calendars(root)
    listing = {}
    for calendar in wanted:
        rows = []
        for kind, mass in masses_of(load_calendar(root, calendar)):
            rows.append(
                {
                    "key": mass.get("key"),
                    "name": mass.get("name"),
                    "kind": mass.get("kind") or kind,
                    "registry": mass.get("registry"),
                    "propers": len(propers_of(mass)),
                }
            )
        listing[calendar] = rows
    return {"calendars": listing}


def wrap(text: str, indent: str) -> list[str]:
    lines: list[str] = []
    for paragraph in text.strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if not block:
            continue
        lines.extend(textwrap.wrap(block, WIDTH - len(indent)) or [""])
        lines.append("")
    return [indent + line if line else "" for line in lines[:-1] or lines]


def recension_reading_lines(payload: dict, mass: dict) -> list[str]:
    """Public source and coverage context for one projected recension Mass."""

    coverage = payload.get(_calendars.RECENSION_COVERAGE)
    stamp = mass.get(RECENSION)
    advisory = str(payload.get("advisory") or "").strip()
    if not isinstance(coverage, dict) and not isinstance(stamp, dict) and not advisory:
        return []
    lines = [""]
    boundaries = payload.get(_calendars.RECENSION_ACT)
    if isinstance(boundaries, list) and boundaries:
        lines.append("Historical boundary — stands before: " + "; ".join(boundaries))
    if isinstance(coverage, dict) and coverage.get("status"):
        lines.append(f"Recension coverage: {coverage['status']}")
    if isinstance(stamp, dict):
        source = stamp.get("text_from") or stamp.get("calendar")
        if source:
            qualifier = "stated for this recension"
            if stamp.get("stated") is not True:
                inheritance = coverage.get("inheritance") if isinstance(coverage, dict) else {}
                collation = (
                    inheritance.get("status")
                    if isinstance(inheritance, dict)
                    else None
                ) or "uncollated"
                qualifier = f"inherited, {collation}"
            lines.append(f"Proper text source: {source} ({qualifier})")
        if stamp.get(_calendars.DEPARTURE_ACT):
            lines.append(f"Departure act: {stamp[_calendars.DEPARTURE_ACT]}")
        for row in stamp.get("also") or []:
            if isinstance(row, dict) and row.get(_calendars.DEPARTURE_ACT):
                lines.append(
                    "Additional departure act"
                    + (f" ({row.get('kind')})" if row.get("kind") else "")
                    + f": {row[_calendars.DEPARTURE_ACT]}"
                )
    if advisory:
        lines.extend(wrap(advisory, ""))
    return lines


def render_reading(
    payload: dict,
    lang: str,
    resolved: dict,
    witness: str | None = None,
    appointed: list[tuple[str, dict, dict | None]] | None = None,
) -> int:
    mass = payload["mass"]
    if appointed is None:
        appointed = [(form, proper, None) for form, proper in propers_of(mass)]
    print(mass.get("name") or mass.get("key") or "(unnamed)")
    subtitle = " · ".join(
        str(part)
        for part in (payload.get("edition"), payload.get("kind"), mass.get("registry"))
        if part
    )
    if subtitle:
        print(subtitle)
    print("=" * WIDTH)
    for line in recension_reading_lines(payload, mass):
        print(line)
    reference = mass.get(_calendars.TAKES_FROM)
    if reference:
        printed = str(reference.get("citation") or "").strip()
        print(
            f"Takes the Mass of {reference.get('mass')}"
            + (f", form {reference['form']}" if reference.get("form") else "")
            + (f" ({printed})" if printed else "")
        )
    for form, proper, taken_from in appointed:
        heading = str(proper.get("name") or "(unnamed proper)")
        if form:
            heading = f"{heading} [{form}]"
        print(f"\n{heading}")
        print("-" * len(heading))
        if taken_from:
            print(f"  (from {taken_from['mass']}"
                  + (f", {taken_from['proper']}" if taken_from.get("proper") else "")
                  + ")")
        for entry in proper.get("verses") or []:
            if isinstance(entry, dict) and entry.get("ref"):
                # The missal's own citation stands; a conversion is shown beside it.
                found = resolved.get(str(entry["ref"])) or {}
                note = found.get("note")
                print(f"  {entry['ref']}" + (f"  ({note})" if note else ""))
                if found.get("text"):
                    print("\n".join(wrap(str(found["text"]), "    ")))
        # Both reading courses, each labelled by its own cycle key, so a reader
        # sees `A:`/`B:`/`C:` where the Sunday year decides and `I:`/`II:` where
        # the weekday year does. Sorted within a course and the courses in their
        # declared order: what must never happen is the two being merged into
        # one list, where a letter and a numeral would read as alternatives of
        # the same kind.
        for _, cycle, owner in sorted(cycle_owners(proper), key=lambda row: row[:2]):
            refs = [
                v["ref"]
                for v in (owner.get("verses") or [])
                if isinstance(v, dict) and v.get("ref")
            ]
            if refs:
                print(f"  {cycle}: {', '.join(refs)}")
        for body, attribution, note in select_texts(proper, lang, witness):
            if body:
                print()
                if attribution:
                    print(f"  [{attribution}]")
                print("\n".join(wrap(body, "  ")))
            if note:
                print(f"\n  ({note})")
    return 0


def select_texts(
    proper: dict, lang: str, witness: str | None = None
) -> list[tuple[str, str, str]]:
    """Which texts of a proper to print. The rule lives in `_calendars`.

    It was here, and the expanded daily-Mass renderer prints propers too; a second copy
    would have been a second answer to which text a Mass is said in.
    """
    latin = proper.get("latin")
    latin_unavailable = isinstance(latin, dict) and (
        latin.get("withheld") or latin.get("state") == "unavailable"
    )
    if lang == "la" and latin_unavailable:
        return [("", "", "Latin text unavailable")]
    available = [
        translation
        for translation in proper.get("translations") or []
        if isinstance(translation, dict) and translation.get("lang") == lang
        and (witness is None or translation.get("source_id") == witness)
    ]
    restricted = any(
        isinstance(state, dict)
        and state.get("lang") == lang
        and state.get("state") == "rights-restricted"
        for state in proper.get("unavailable_translations") or []
    )
    if available:
        return [
            (
                str(translation.get("text") or ""),
                str(
                    translation.get("source_label")
                    or translation.get("source_id")
                    or ""
                ),
                str(translation.get("caution") or ""),
            )
            for translation in available
        ]
    # A typed restriction remains the controlling explanation in the reading
    # view.  When Latin is unavailable too, say both facts: calling the
    # translation merely "not recorded" would contradict the machine state,
    # while mentioning only the restriction would imply a usable Latin fallback.
    if restricted and not available:
        note = f"{lang} translation unavailable: rights restricted"
        if latin_unavailable:
            note += "; Latin text unavailable"
        return [("", "", note)]
    # When neither requested wording nor the Latin body is distributable and
    # there is no more specific typed reason, report the combined absence.
    if latin_unavailable and witness is None:
        return [
            (
                "",
                "",
                f"no {lang} translation recorded; Latin text unavailable",
            )
        ]
    unavailable = any(
        isinstance(state, dict)
        and state.get("lang") == lang
        and state.get("state") == "unavailable"
        for state in proper.get("untranslated") or []
    )
    if unavailable and not available:
        return [("", "", f"no {lang} recorded, deliberately")]
    if witness is not None and not available:
        return [("", "", f"no {lang} translation from {witness} recorded")]
    return _calendars.texts_of(proper, lang, witness)


def render_listing(payload: dict) -> int:
    for calendar, rows in payload["calendars"].items():
        for row in rows:
            print(
                f"{calendar}\t{row['registry'] or ''}\t{row['kind']}\t"
                f"{row['propers']}\t{row['key']}\t{row['name'] or ''}"
            )
        print(f"# {calendar}: {len(rows)} masses", file=sys.stderr)
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_ROOT), help="calendar root directory")
    shared.add_argument("--calendar", help="calendar directory name, e.g. roman-1962")
    shared.add_argument(
        "--mass",
        action="append",
        help="mass key, e.g. advent-1; repeat to resolve several in one process",
    )
    shared.add_argument(
        "--format", choices=("text", "yaml", "json"), default="text", help="output form"
    )
    shared.add_argument(
        "--bible", help="indexed bible to resolve scripture refs against, e.g. douay-rheims"
    )
    shared.add_argument(
        "--lang", default="la", help="language for composed propers (default: la)"
    )
    shared.add_argument(
        "--witness",
        help="show only this translation's source_id; without it every "
        "translation in --lang is shown, each one named",
    )
    shared.add_argument(
        "--bible-root",
        default=str(BIBLE_ROOT),
        help="where indexed bibles live; point outside the repo to keep a "
        "licensed text unpublished",
    )
    shared.add_argument(
        "--out", default="src/web/data", help="where `structure` writes its files"
    )
    shared.add_argument(
        "--doc-root",
        default=str(ROOT),
        help="repository root holding the documents `census` writes into",
    )
    shared.add_argument(
        "--write",
        action="store_true",
        help="`census`: rewrite the derived block in every document carrying it",
    )
    shared.add_argument(
        "--check",
        action="store_true",
        help="`census`: exit 1 naming any document whose block is stale, writing nothing. "
        "`structure`: exit 1 naming any tracked structure file the sources no "
        "longer produce, writing nothing",
    )
    shared.add_argument(
        "--verbose", action="store_true", help="list every citation that refused to resolve"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="mass-propers",
        description="Print one mass's propers as YAML, JSON, or a reading view.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "mass-propers")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("show", help="print one mass's propers", parents=[shared]),
        EXAMPLES["show"],
    )
    with_examples(
        sub.add_parser("list", help="list the masses a calendar carries", parents=[shared]),
        EXAMPLES["list"],
    )
    with_examples(
        sub.add_parser(
            "structure",
            help="write the browser's structure files, citations resolved to loci",
            parents=[shared],
        ),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser(
            "census",
            help="derive the count of both calendars, and write it into the documents",
            parents=[shared],
        ),
        EXAMPLES["census"],
    )

    def render(payload: object, arguments: argparse.Namespace) -> int:
        if not isinstance(payload, dict):
            print("mass-propers error: invalid payload", file=sys.stderr)
            return 70
        status_rc = 1 if payload.get("status") == "stale" else 0
        if arguments.json or arguments.format == "json":
            print_json(payload)
            return status_rc
        if arguments.format == "yaml":
            import yaml

            print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
            return status_rc
        if "block" in payload:
            # To stderr, so that redirecting the block to a file still leaves the
            # block alone and still shows the operator the coverage. The
            # hand-typed copy of these figures lives in a file this tool does not
            # own, so reporting them is the whole of what can be done from here.
            #
            # Not under `--check`. That verb answers one yes/no question for
            # `make check-propers-census`, and a gate that prints figures it does
            # not gate teaches its operators to skim past its output.
            if not arguments.check:
                reported = payload.get("english_coverage") or []
                for line in render_coverage(reported):  # type: ignore[arg-type]
                    print(line, file=sys.stderr)
                latin = payload.get("latin_recension_coverage")
                for line in render_latin_recension_coverage(latin):  # type: ignore[arg-type]
                    print(line, file=sys.stderr)
            rows = payload.get("documents")
            if rows is None:
                print(str(payload["block"]), end="")
                return 0
            for row in rows:  # type: ignore[union-attr]
                print(f"{row['state']}\t{row['path']}")
            if payload["status"] == "stale":
                print(
                    "mass-propers census: stale; rerun with --write",
                    file=sys.stderr,
                )
                return 1
            return 0
        if "checked" in payload:
            for calendar, counts in payload["calendars"].items():
                print(f"{calendar}: {counts['masses']} masses, {counts['citations']} citations")
            for path in payload["drifted"]:
                print(f"  stale {path}")
            if payload["status"] == "stale":
                print(
                    "mass-propers structure: "
                    f"{len(payload['drifted'])} of {len(payload['checked'])} "
                    "tracked file(s) are not what the sources produce; rerun "
                    "`mass-propers structure` and commit the result",
                    file=sys.stderr,
                )
                return 1
            print(f"  {len(payload['checked'])} tracked file(s) are current")
            return 0
        if "written" in payload:
            for calendar, counts in payload["calendars"].items():
                print(f"{calendar}: {counts['masses']} masses, {counts['citations']} citations")
            for path in payload["written"]:
                print(f"  -> {path}")
            held = payload["withheld"]
            if isinstance(held, list):
                for row in held:
                    print(f"  {row}")
            elif held:
                print(f"  withheld from publication: {held}")
            latin = payload["withheld_latin"]
            if isinstance(latin, list):
                for row in latin:
                    print(f"  Latin withheld: {row}")
            elif latin:
                print(f"  Latin withheld from publication: {latin}")
            refused = payload["refused"]
            if isinstance(refused, list):
                for row in refused:
                    print(f"  refused {row}")
            else:
                print(f"  refused: {refused}")
            return 0
        if "calendars" in payload:
            return render_listing(payload)
        return render_reading(
            payload,
            arguments.lang,
            getattr(arguments, "resolved_bible", {}),
            arguments.witness,
            getattr(arguments, "appointed", None),
        )

    return run_verb_cli(
        parser=parser,
        handlers={
            "show": run_show,
            "list": run_list,
            "structure": run_structure,
            "census": run_census,
        },
        renderer=render,
        prefix="mass-propers",
        argv=argv,
        default_verb="show",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
