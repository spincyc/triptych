def book_tokens() -> dict[str, str]:
    """Canonical book name to the token the chapter fragments are filed under.

    Every edition in this library addresses a book by the same token, because
    each one's book index is built from the Douay-Rheims's. A structure file is
    therefore edition-independent; an edition that chose its own tokens would
    break that and would need its own loci.
    """
    import csv

    found = sorted(BOOK_INDEX.glob("book-index-*/book-index.tsv"))
    if len(found) != 1:
        raise ValueError(f"expected one book index under {BOOK_INDEX}, found {len(found)}")
    with found[0].open(encoding="utf-8", newline="") as handle:
        return {row["modern_name"]: row["token"] for row in csv.DictReader(handle, delimiter="\t")}


def spans_in(entry: dict, source: str, target: str) -> list[dict]:
    """One citation's ranges as explicit loci in `target` numbering."""
    book = str(entry.get("book") or "")
    loci: list[dict] = []
    for span in entry.get("ranges") or []:
        if not isinstance(span, dict):
            continue
        converted, _ = convert_range(book, span.get("begin") or {}, span.get("end"), source, target)
        for piece in converted:
            loci.extend(range_to_loci(piece.get("begin") or {}, piece.get("end") or {}))
    return loci


def citation_structure(entry: dict, source: str, tokens: dict[str, str]) -> dict:
    """A citation with its verses resolved in both numbering systems.

    Resolved here rather than in the browser so that no numbering logic ships
    to the page: a reader picks a translation, reads its numbering, and takes
    the loci already computed for it. A citation that cannot be converted
    carries the reason and no loci, because a page that renders nothing is
    better than one that renders the wrong psalm.
    """
    book = str(entry.get("book") or "")
    structure = {
        "ref": str(entry["ref"]),
        "book": book,
        "token": tokens.get(book),
        "loci": {},
        "unresolved": None,
    }
    if structure["token"] is None:
        structure["unresolved"] = f"no book named {book!r} in this library"
        return structure
    for target in SYSTEMS:
        try:
            structure["loci"][target] = spans_in(entry, source, target)
        except NumberingError as error:
            structure["loci"] = {}
            structure["unresolved"] = str(error)
            return structure
    return structure


TRANSLATIONS_DIR = "inventories"


def translation_overlay(calendar: str) -> tuple[dict, set, list]:
    """Translations recorded for a calendar's propers, keyed by proper.

    The contract in `src/sources/calendars/README.md` puts `translations` inside
    each proper, and that is still where they belong. They were recorded in a
    sidecar because at the time nothing else under `src/sources` would accept
    them — every yaml beside a calendar was read as a mass index, and the source
    library rejected any file outside its own schema list. That constraint has
    since been lifted by the shared schema partition in `scripts/_calendars.py`,
    so the sidecar may move beside its calendar.

    Reading it rather than merging it into `propers.yaml` is worth keeping
    either way: it holds one copy of each translation instead of two, which is
    the rule the verse fragments already follow.

    Returns the overlay, the propers deliberately left untranslated, the entries
    that no longer answer their target, and the file's own record of the
    witnesses it quotes, keyed by `source_id`.
    """
    import tomllib

    path = (
        ROOT
        / "src"
        / "sources"
        / TRANSLATIONS_DIR
        / f"{calendar}-proper-translations-v1.toml"
    )
    if not path.is_file():
        return {}, set(), [], {}
    document = tomllib.loads(path.read_text(encoding="utf-8"))
    overlay, stale = {}, []
    for entry in document.get("entries") or []:
        key = (entry.get("mass"), entry.get("form") or "", entry.get("proper"))
        overlay[key] = entry
    untranslated = {
        (entry.get("mass"), entry.get("form") or "", entry.get("proper"))
        for entry in document.get("untranslated") or []
    }
    # Read rather than restated: the label and the caution are already written
    # here, beside the rights basis they qualify, and a second copy in this tool
    # would be free to disagree with them.
    #
    # A row keyed to the empty id is the project's own work, which names no
    # source because it is its own witness. That row has to be reachable: a
    # project-created translation is *published*, and until it could carry a
    # caution the one witness a reader most needs warning about -- new English
    # for a prayer whose approved English is someone else's -- was the only one
    # served with no warning at all. Requiring the key to be present rather than
    # truthy is what admits it.
    witnesses = {
        str(row.get("source_id") or ""): row
        for row in document.get("sources") or []
        if isinstance(row, dict) and "source_id" in row
    }
    return overlay, untranslated, stale, witnesses


def overlay_key(
    mass: dict, form: str, proper: dict, taken_from: dict | None
) -> tuple[str, str, str]:
    """Where a proper's recorded translation is filed.

    A borrowed proper is filed under the mass that PRINTS it. The English of a
    Collect belongs to the Collect, not to each day the Missal appoints it on,
    so keying on the borrowing day would want the same oration recorded once per
    day — the hand-typed restatement `takes_from` exists to remove.

    It is a function because two callers need the same answer: the structure
    pass, which merges the translation, and the coverage census, which counts
    how many slots one was found for. Keyed differently they would disagree
    about which propers are covered, and the census would be measuring a
    resolution the browser does not perform.
    """
    if taken_from:
        return (taken_from["mass"], taken_from["form"] or "", taken_from["proper"])
    return (mass.get("key"), form or "", proper.get("name"))


def carry_translations(
    calendar: str,
    key: tuple[str, str, str],
    proper: dict,
    overlay: dict,
    stale: list,
) -> dict:
    """A copy of `proper` carrying the translations recorded for it.

    It is a function because two verbs merge the overlay — `structure`, which
    writes what the browser serves, and `show`, which is how a maintainer reads
    a Mass and checks a harvested translation. They were not one function, and
    only `structure` merged: every one of the recorded English translations
    reached the site and none of them reached the terminal, which answered
    `no en translation recorded; showing Latin` over an oration whose English
    the same repository was publishing. Two readers of one file must not
    disagree about what is in it.

    An entry whose proper no longer opens with the incipit it was derived
    against is stale, and merging it on the strength of the mass key alone
    would attach one prayer's English to another's Latin. Refuse it and report
    it: a missing translation is visible, a misattached one is not.
    """
    recorded = overlay.get(key)
    if recorded and recorded.get("incipit") and proper.get("incipit"):
        if recorded["incipit"].strip() != str(proper["incipit"]).strip():
            stale.append(
                f"{calendar} {key[0]}/{key[2]}: recorded incipit "
                f"{recorded['incipit']!r} does not match "
                f"{proper['incipit']!r}"
            )
            recorded = None
    carried = dict(proper)
    if recorded:
        carried["translations"] = recorded.get("translations")
    return carried


def calendar_structure(root: Path, calendar: str, tokens: dict[str, str]) -> dict:
    document = load_calendar(root, calendar)
    overlay, untranslated, stale, witnesses = translation_overlay(calendar)
    source = document.get("psalm_numbering")
    if source not in SYSTEMS:
        raise ValueError(f"{calendar} declares unknown psalm numbering {source!r}")
    masses = []
    for kind, mass in masses_of(document):
        propers = []
        for form, proper, taken_from in appointed_propers(document, mass):
            # A borrowed proper is looked up under the mass that prints it; the
            # rule and its reason live on `overlay_key`. Twelve such rows sat in
            # the 1962 sidecar for the four resumed Sundays after the Epiphany,
            # and one of them had already drifted from its twin.
            key = overlay_key(mass, form, proper, taken_from)
            carried = carry_translations(calendar, key, proper, overlay, stale)

            def cited(owner: dict) -> list[dict]:
                return [
                    citation_structure(entry, source, tokens)
                    for entry in (owner.get("verses") or [])
                    if isinstance(entry, dict) and entry.get("ref")
                ]

            # A cycle-varying proper reads differently in years A, B and C, so
            # each year's citations are kept apart rather than merged into one
            # list the browser could not tell apart.
            # A cycle may vary in kind as well as in text: an acclamation
            # composed one year and scriptural the next, so each year carries
            # both its citations and its own words.
            cycles = {
                year: (cited(owner), owner)
                for year, owner in (proper.get("cycles") or {}).items()
                if isinstance(owner, dict)
            }
            propers.append(
                {
                    "name": proper.get("name"),
                    # A mass with several formularies labels each one; an
                    # ordinary mass has no form and carries an empty label.
                    "form": form,
                    "incipit": proper.get("incipit"),
                    "source": proper.get("source"),
                    # A composed proper is an oration, not a citation: its words
                    # are the proper. Carrying only the incipit left the page
                    # naming a Collect it could not show.
                    "text": proper.get("text"),
                    "translations": publishable_translations(carried),
                    # Distinguishes a proper nobody has looked at from one
                    # deliberately left without English.
                    "untranslated": key in untranslated or None,
                    "citations": cited(proper),
                    "cycles": {
                        year: {"citations": rows, "text": owner.get("text")}
                        for year, (rows, owner) in cycles.items()
                        if rows or owner.get("text")
                    },
                    # Where the Missal prints this text, when it is not printed
                    # here. A page that showed a borrowed Collect as though the
                    # day printed it would be asserting something the book does
                    # not, so the provenance travels with the text and a reader
                    # can see that the words are the Common's.
                    "taken_from": taken_from or None,
                }
            )
        built = {
            "key": mass.get("key"),
            "name": mass.get("name"),
            "season": mass.get("season"),
            "kind": kind,
            # The calendar date the mass is kept on, "MM-DD", exactly as the
            # source records it, and absent where the source records none.
            # It is carried rather than left to be read back out of the
            # registry id: the registry conventions are the calendar's, a
            # date-shaped id is not always a date ("1962-12-29" is a day of
            # the temporal cycle) and a dated entry does not always end in
            # one ("1962-03-07-comm"), so a reader that parses ids is a
            # second derivation standing beside this one, free to disagree.
            "date": mass.get("date"),
            "registry": mass.get("registry"),
            # The formulary this mass takes whole, where it takes one. The
            # per-proper `taken_from` says the same thing slot by slot; this
            # says it once, which is what a heading needs.
            "takes_from": mass.get(_calendars.TAKES_FROM) or None,
            "propers": propers,
        }
        # How the recension reached this mass, where the calendar is one.
        # `_calendars._stamp` puts this on every entry of a recension precisely
        # so a page can say so, and rebuilding the mass from the whitelist above
        # dropped it: the pre-1955 structure file carried 490 masses, no
        # `text_from` anywhere in it, and a heading naming the 1920 typical
        # edition over text every word of which was transcribed from a 1962
        # printing. Absent rather than null on the other two calendars, because
        # that stamp's own rule is that a renderer finding no stamp is reading a
        # calendar that is nobody's recension -- a null would be a third state to
        # interpret.
        if isinstance(mass.get(RECENSION), dict):
            built[RECENSION] = mass[RECENSION]
        masses.append(built)
    manifest = translation_manifest(masses, witnesses)
    # Every proper's list is put into the manifest's order, so that the choice
    # of which English a reader sees is made once, here, and is the same choice
    # whether a consumer reads the manifest or simply takes the first entry in
    # the language it wants. Left in source order it would be neither stated nor
    # stable: two witnesses would be ranked by which happened to be typed first.
    order = {(row["lang"], row["source_id"]): index for index, row in enumerate(manifest)}
    for mass in masses:
        for proper in mass["propers"]:
            if proper.get("translations"):
                proper["translations"] = sorted(
                    proper["translations"], key=lambda t: order[witness_of(t)]
                )
    return {
        "schema": "triptych-propers-structure/v1",
        "calendar": calendar,
        "edition": document.get("edition"),
        # The name a reader would say, for the control; `edition` stays the
        # bibliographic identification and is what the page prints against the
        # texts themselves. Carried from the source rather than shortened here,
        # so that no tool and no page holds a second opinion about what the two
        # books are called.
        "edition_short": document.get("edition_short"),
        "numbering": source,
        # The witnesses this missal's orations may be read in, in the order a
        # control should offer them; the first row of a language is its default.
        "translations": manifest,
        "masses": masses,
    }


def run_structure(arguments: argparse.Namespace) -> dict:
    """Write one structure file per calendar for the browser to assemble from."""
    root = Path(arguments.root)
    tokens = book_tokens()
    names = [arguments.calendar] if arguments.calendar else calendars(root)
    out = Path(arguments.out)
    written, counts, refused, withheld = [], {}, [], []
    for name in names:
        built = calendar_structure(root, name, tokens)
        # Counted from the source, before the structure pass drops them: the
        # structure file is what the site serves, so anything filtered out of it
        # cannot be counted from it afterwards.
        document = load_calendar(root, name)
        for section in (document.get("sections") or {}).values():
            for mass in section.get("masses") or []:
                for proper_name, lang, source_id, rights in withheld_translations(mass):
                    withheld.append(
                        f"{name} {mass.get('key')}/{proper_name}: {lang} from "
                        f"{source_id or 'no source'} withheld "
                        f"({rights or 'no rights basis stated'})"
                    )
        # `--out` is the data root the page is served from, so both generators
        # take the same one: the manifest lands at its head and the structure
        # files under `structure/`.
        path = out / "structure" / "propers" / f"{name}.json"
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(
            json.dumps(built, ensure_ascii=False, sort_keys=True, indent=1) + "\n",
            encoding="utf-8",
        )
        written.append(str(path))
        cited = [
            citation
            for mass in built["masses"]
            for proper in mass["propers"]
            for rows in [
                proper["citations"],
                *(cycle["citations"] for cycle in proper["cycles"].values()),
            ]
            for citation in rows
        ]
        counts[name] = {"masses": len(built["masses"]), "citations": len(cited)}
        refused.extend(
            f"{name} {c['ref']}: {c['unresolved']}" for c in cited if c["unresolved"]
        )

    # The manifest lists what is THERE, not what was built this run. A run
    # scoped by `--calendar` into the site's own data root must still name every
    # missal the reader can open, and the same run into an empty directory must
    # name only the one it wrote -- otherwise the file whose whole purpose is to
    # stop the page probing for missals would itself advertise a 404.
    listed = []
    for name in calendars(root):
        if not (out / "structure" / "propers" / f"{name}.json").exists():
            continue
        document = load_calendar(root, name)
        listed.append(
            {
                "id": name,
                "edition": document.get("edition"),
                "edition_short": document.get("edition_short"),
            }
        )
    listed.sort(key=lambda entry: (entry["id"] != LANDING_MISSAL, entry["id"]))
    manifest = out.joinpath(*MISSAL_MANIFEST)
    if listed:
        manifest.parent.mkdir(parents=True, exist_ok=True)
        manifest.write_text(
            json.dumps(
                {
                    # Named, and not merely first. A reader of this file should
                    # not have to infer the landing missal from row order, and a
                    # page that reads it should not have to trust that order.
                    "default": (
                        LANDING_MISSAL
                        if any(entry["id"] == LANDING_MISSAL for entry in listed)
                        else listed[0]["id"]
                    ),
                    "missals": listed,
                },
                ensure_ascii=False,
                sort_keys=True,
                indent=1,
            )
            + "\n",
            encoding="utf-8",
        )
        written.append(str(manifest))

    return {
        "written": written,
        "calendars": counts,
        "refused": refused if arguments.verbose else len(refused),
        # A translation the corpus holds and the site does not show. Reported
        # every time, not only when verbose: withholding text silently is the
        # same defect as publishing it silently, read from the other side.
        "withheld": withheld if arguments.verbose else len(withheld),
        "status": "ok",
    }


# --- The census -------------------------------------------------------------
#
# One count of this corpus existed in three hand-typed copies — docs/the-mass.md,
# guidance/propers-for-agents.md, and the table in src/sources/calendars/README.md
# — and all three disagreed, because each was retyped at a different hour and
# none was rederived when the calendars moved. The 1962 sanctoral section alone
# read 247 in one document and 307 in the file. So the count is derived here,
# once, and the documents carry the derivation rather than a transcription of it.
#
# Every figure below is a decision about what to count, not a fact about the
# corpus, and two honest counters differ by hundreds if they key differently.
# CENSUS_KEYS states each key in the emitted block, so a reader never has to
# guess whether a placeholder was in the total.
PLACEHOLDER = "Placeholder"
SCRIPTURE_BEARING = frozenset({"scripture", "mixed"})
# Section order in the emitted table. The two files list their sections in
# different orders, and a table that followed file order would reshuffle when a
# section moved; this order is the one the prose already reads in.
KIND_ORDER = ("seasonal", "christological", "marian", "sanctoral")
# Calendar order, oldest book first, matching how every document introduces
# them. Anything unlisted follows, sorted, so a third calendar still lands
# somewhere deterministic.
CALENDAR_ORDER = ("roman-pre-1955", "roman-1962", "postconciliar")

# The markers name no command. A marker is a delimiter, and one carrying the
# invocation would have to be rewritten in every document the day the verb is
# renamed — with every document that had not yet been rewritten refused as
# markerless. The regeneration command is in the emitted prose instead, which
# is where a reader is actually reading.
CENSUS_BEGIN = "<!-- census:begin — derived; edit nothing between these markers -->"
CENSUS_END = "<!-- census:end -->"
# Every document that carries the derived block. A document not listed here
# carries no census figures at all; that is the point of the list.
CENSUS_DOCUMENTS = ("docs/the-mass.md", "guidance/propers-for-agents.md")

# The emitted prose names the direct paths, `tools/mass-propers` and
# `tools/citations`, not the launcher. That is not a style choice: tmt reads a
# bare sibling id in a tool body as an undeclared dependency, so naming the
# launcher here fails `tmt check` with
#     FAIL mass-propers: uses sibling 'tpt' without declaring it in requires
# Both forms run. Do not "fix" these to the launcher form.
CENSUS_KEYS = (
    "Counted from `src/sources/calendars/*/propers.yaml` and written here by "
    "`tools/mass-propers census --write`, which is the only thing that writes "
    "the block above; `make check-propers-census` refuses a copy that has "
    "drifted. What each row counts, because two honest counts of “propers” "
    "differ by hundreds when they key differently: a **mass** is one entry under "
    "`sections[*].masses`. A **proper** is one entry in a mass's `propers`, or in "
    "the `propers` of one of its `forms`; a proper carrying `cycles` counts once, "
    "not three times. Placeholders are **inside** the proper and mass totals, and "
    "are also given their own rows. A mass **holds only placeholders** when every "
    "proper it holds, those inside `forms` included, is named `Placeholder` — "
    "keying on the mass's own `propers` alone undercounts, because it misses the "
    "masses whose placeholders sit inside a `forms` block. **Scripture-bearing** "
    "means a `source` of `scripture` or `mixed`, or a `cycles` entry that is. "
    "**Encoded passages** and **distinct books** are `tools/citations check`'s "
    "own counts, one passage per encoded citation entry and books counted distinct "
    "within a file. **Distinct slot names** counts distinct proper `name` values, "
    "with `Placeholder` among them. The two **taking** rows count the entries "
    "that name where their text is printed instead of printing it — a feria "
    "taking the preceding Sunday, a saint taking a Mass of the Common. Such an "
    "entry holds few propers or none, so it lowers the proper count while "
    "raising what the calendar can actually show: every row above counts what a "
    "file **carries**, and these two count what it **appoints** from elsewhere. "
    "Neither is a placeholder."
)

# The rank table's own keys. Kept a separate paragraph so that adding it did not
# re-wrap a word of the paragraph above; see `render_census`.
#
# It states keys and names no figure, exactly as CENSUS_KEYS does. A sentence
# here saying how many joined entries there are would be a hand-typed count
# sitting inside the derived block — the defect the block exists to end, smuggled
# back in as prose.
CENSUS_RANK_KEYS = (
    "The rank rows count **entries**, and a calendar's rank rows sum to its "
    "`Masses` above. `(no rank)` is a row and not an omission: the temporal "
    "cycle prints no rank at all, so unranked entries are a large group in both "
    "indexes, and a table that dropped them would invite the ranks it does show "
    "to be read as the whole book. **Celebrations** counts what those "
    "entries name. One entry can print more than one celebration — a pair of "
    "optional memorials falling on the same day, or the Greater Litanies kept "
    "with Saint Mark — and the index records the join only in the entry's "
    "`name`, joined with `;`, so that is where it is read from; the plural rank "
    "word marks some such entries and not others, and it never says how many. "
    "Where the two columns differ the index is keeping more celebrations than it "
    "holds entries: reading the entry count as a count of celebrations "
    "understates the calendar, and folding the celebrations into the entry "
    "count would break the sum against `Masses`, so both are given and neither "
    "replaces the other. A **rank** is reproduced exactly as the file prints it. "
    "`Optional memorial` and `Optional memorials` are two rows because they are "
    "two different words in the index, and the two Missals' rank vocabularies "
    "are not one scale — no row of this table is comparable across calendars, "
    "which is why rank is tabulated down the page and not across it. This table "
    "answers what an index is scoped to; it does not answer which entries are "
    "Sundays, because no entry states that and it is not derived here."
)


def ordered(names: list[str], preferred: tuple[str, ...]) -> list[str]:
    """Declared order first, then anything else sorted. Deterministic either way."""
    known = [name for name in preferred if name in names]
    return known + sorted(set(names) - set(known))


def proper_sources(proper: dict) -> set[str]:
    """A proper's `source`, or its cycles' where the kind varies by year."""
    declared = proper.get("source")
    if declared:
        return {str(declared)}
    return {
        str(cycle["source"])
        for cycle in (proper.get("cycles") or {}).values()
        if isinstance(cycle, dict) and cycle.get("source")
    }


# The label a rank row carries when the entry printed no rank. It is a row and
# not an omission: the temporal cycle prints no rank at all, so unranked entries
# are a large group in both indexes, and a rank table that simply left them out
# would invite the reader to take the ranks it does show as the whole book.
NO_RANK = "(no rank)"
# One entry can print more than one celebration, and the index joins them in the
# entry's own `name` with a semicolon: a pair of optional memorials falling on
# the same day, or the Greater Litanies kept with Saint Mark. Splitting the name
# is a reading of prose and is stated as such in CENSUS_RANK_KEYS, but it is the
# only place the file records the join at all — the plural rank word marks some
# of these entries and not others, and it does not say how many.
CELEBRATION_JOIN = ";"


def celebrations_in(mass: dict) -> int:
    """How many celebrations one entry prints, read from its own name.

    An entry with no name at all still keeps one Mass, so the floor is one and
    never zero: a nameless entry is a naming defect, not an empty day.
    """
    named = [part for part in str(mass.get("name") or "").split(CELEBRATION_JOIN) if part.strip()]
    return len(named) or 1


def rank_census(document: dict) -> list[dict]:
    """Entries and celebrations per printed rank, unranked entries first.

    Counted by the rank string EXACTLY as the file prints it. Normalising here
    would be this tool inventing a rank vocabulary: `Optional memorial` and
    `Optional memorials` are two different words in the postconciliar index and
    mean two different things, and the 1962 index's `I`/`II`/`III`/`Comm.` are
    not the same scale as the postconciliar's names at all.

    Ordered by the rank string rather than by count, so that a row moves only
    when a rank appears or disappears. Ordering by size would reshuffle the
    table every time a mass landed, which is the reflow the block exists to
    avoid.
    """
    counted: dict[str, dict] = {}
    for _, mass in masses_of(document):
        rank = mass.get("rank")
        label = NO_RANK if rank is None or str(rank) == "" else str(rank)
        row = counted.setdefault(label, {"rank": label, "entries": 0, "celebrations": 0})
        row["entries"] += 1
        row["celebrations"] += celebrations_in(mass)
    return sorted(counted.values(), key=lambda row: (row["rank"] != NO_RANK, row["rank"]))


def census_of(document: dict) -> dict:
    """Count one calendar file. Sections first, then the file's own totals."""
    rows = []
    for name, body in (document.get("sections") or {}).items():
        if not isinstance(body, dict):
            continue
        masses = [mass for mass in (body.get("masses") or []) if isinstance(mass, dict)]
        propers = [proper for mass in masses for _, proper in propers_of(mass)]
        rows.append(
            {
                "section": str(name),
                "kind": str(body.get("kind") or ""),
                "masses": len(masses),
                "propers": len(propers),
                "placeholder_only_masses": sum(
                    1 for mass in masses if placeholder_only(mass)
                ),
            }
        )
    rows.sort(
        key=lambda row: (
            KIND_ORDER.index(row["kind"]) if row["kind"] in KIND_ORDER else len(KIND_ORDER),
            row["section"],
        )
    )
    every = [
        (form, proper)
        for _, mass in masses_of(document)
        for form, proper in propers_of(mass)
    ]
    substantive = [proper for _, proper in every if proper.get("name") != PLACEHOLDER]
    return {
        "sections": rows,
        "ranks": rank_census(document),
        "masses": sum(row["masses"] for row in rows),
        "propers": len(every),
        "placeholder_propers": sum(
            1 for _, proper in every if proper.get("name") == PLACEHOLDER
        ),
        "propers_in_forms": sum(1 for form, _ in every if form),
        "cycle_propers": sum(1 for _, proper in every if proper.get("cycles")),
        "placeholder_only_masses": sum(row["placeholder_only_masses"] for row in rows),
        "substantive_propers": len(substantive),
        "scripture_bearing_propers": sum(
            1 for proper in substantive if proper_sources(proper) & SCRIPTURE_BEARING
        ),
        "slot_names": len({str(proper.get("name") or "") for _, proper in every}),
        # A mass that names the formulary it takes carries few propers or none,
        # so the rows above would report it as emptier than a placeholder. It is
        # the opposite: it is the one shape in this file that resolves to a
        # whole Mass. Counted separately so neither reading can be taken for the
        # other.
        "masses_taking_a_formulary": sum(
            1 for _, mass in masses_of(document) if mass.get(_calendars.TAKES_FROM)
        ),
        "propers_taken_by_reference": sum(
            1
            for _, mass in masses_of(document)
            for _, proper in propers_of(mass)
            if _calendars.TAKES_FROM in proper
        ),
    }


def placeholder_only(mass: dict) -> bool:
    """Every proper it holds, forms included, is a placeholder.

    Reading the mass's own `propers` alone is the wrong key and was the one in
    use: it reports False for a mass that holds nothing but `forms`, so the
    Christmas octave and four postconciliar vigil-and-day pairs counted as
    substantive when they hold nothing but placeholders.
    """
    names = [str(proper.get("name") or "") for _, proper in propers_of(mass)]
    return bool(names) and set(names) == {PLACEHOLDER}


def passage_counts(root: Path) -> dict[str, dict[str, int]]:
    """Passages and distinct books, from the tool that owns citations.

    Re-deriving these here is exactly how the three copies came to disagree, so
    they are read from `citations check` rather than recounted.
    """
    loader = SourceFileLoader("_citations", str(Path(__file__).resolve().parent / "citations"))
    spec = spec_from_loader(loader.name, loader)
    module = module_from_spec(spec)
    loader.exec_module(module)
    counted = module.check(root)["files"]
    return {
        Path(path).parent.name: {"passages": row["passages"], "books": row["books"]}
        for path, row in counted.items()
    }


# --- The English coverage census, derived and reported, written nowhere ------
#
# `english_oration_census` in `src/sources/inventories/roman-1962-proper-
# translations-v1.toml` states this coverage in hand-typed prose, and it is the
# same defect the census above exists to end, one layer over: a slot total, a
# covered total and a ledgered total, all retyped, all beside a corpus that
# moves every day. That block is not this tool's to write — it is prose with an
# argument in it, and only its owner can rewrite it — so these figures are
# DERIVED AND REPORTED and nothing here writes them anywhere.
#
# Reporting them without being asked is the point. Behind a flag they would be
# seen only by someone who already suspected drift; printed by the verb an
# operator runs after every wave, the drift announces itself. They go to stderr
# because stdout is the block, and the block has to stay byte-identical to what
# `--write` puts in the documents — and not under `--check`, for the reason
# given where they are printed.

# A slot name without its rubrical qualifier: `Secret (Pro Martyre tantum)` is a
# Secret. The ledger records the qualified name, the calendar prints it, and the
# family is what says whether a slot is the KIND of thing the ledger addresses.
SLOT_QUALIFIER = " ("


def slot_family(name: object) -> str:
    return str(name or "").split(SLOT_QUALIFIER)[0]


def english_coverage(root: Path, calendar: str) -> dict | None:
    """How far a calendar's recorded English reaches, once `takes_from` resolves.

    Returns None for a calendar with no translation ledger; there is nothing to
    be covered or uncovered against.

    Three decisions, because two honest counts differ here as sharply as they do
    over "propers":

    * A slot is counted ONCE however many days appoint it, keyed by
      `overlay_key` — the same key the structure pass merges on, so this counts
      what the browser would actually serve rather than a second resolution.
    * The denominator is the ledger's OWN slot vocabulary: the families it has
      an opinion about, whether that opinion is a translation or a recorded
      reason for having none. A ledger that has never addressed Sequences is not
      silently failing to translate them. What that leaves out is counted too,
      as `outside_the_ledger`, so the narrower denominator cannot hide behind
      itself.
    * Propers whose words are WHOLLY a bible's are excluded, and only those.
      `source: scripture` carries citations and no text of its own, so its
      English is the bible's and no ledger owes it one. `source: mixed` carries
      both, and the text half is the Missal's own words which no bible renders:
      the nineteenth Sunday after Pentecost prints `Salus populi ego sum` above
      its psalm verse, and a reader with a bible attached still saw that
      antiphon in Latin. Excluding `mixed` counted a real gap as out of scope
      and then hid the rows that closed it under `unmatched_records`, which
      reads as ledger rot and is the opposite of it.

    `unmatched_records` is the ledger's own rot: rows keyed to a slot no mass
    appoints any more. It is reported because such a row is invisible from the
    other side — it translates nothing and it lowers nothing.
    """
    overlay, untranslated, _, _ = translation_overlay(calendar)
    if not overlay and not untranslated:
        return None
    document = load_calendar(root, calendar)
    families = {slot_family(key[2]) for key in overlay} | {
        slot_family(key[2]) for key in untranslated
    }
    slots: set[tuple] = set()
    composed: set[tuple] = set()
    for _, mass in masses_of(document):
        for form, proper, taken_from in appointed_propers(document, mass):
            if proper.get("name") == PLACEHOLDER:
                continue
            if proper_sources(proper) <= {"scripture"}:
                continue
            key = overlay_key(mass, form, proper, taken_from)
            composed.add(key)
            if slot_family(proper.get("name")) in families:
                slots.add(key)
    covered = {key for key in slots if (overlay.get(key) or {}).get("translations")}
    ledgered = (slots & untranslated) - covered
    return {
        "calendar": calendar,
        "slots": len(slots),
        "with_english": len(covered),
        "ledgered_untranslated": len(ledgered),
        "unaccounted": len(slots) - len(covered) - len(ledgered),
        "outside_the_ledger": len(composed - slots),
        "unmatched_records": len((set(overlay) | untranslated) - slots),
    }


def coverage(root: Path) -> list[dict]:
    """Every calendar's coverage row, in the census's order.

    A calendar whose references do not resolve is REPORTED, not raised: the
    census is gated by `make check-propers-census`, and a broken reference
    turning that gate red would be this addition failing a check about something
    else entirely.
    """
    rows = []
    for name in ordered(calendars(root), CALENDAR_ORDER):
        try:
            row = english_coverage(root, name)
        except (ValueError, KeyError) as error:
            rows.append({"calendar": name, "error": str(error)})
            continue
        if row:
            rows.append(row)
    return rows


def render_coverage(rows: list[dict]) -> list[str]:
    """One line a calendar, for stderr. Never part of the block."""
    lines = []
    for row in rows:
        if "error" in row:
            lines.append(f"# {row['calendar']} English: not derived: {row['error']}")
            continue
        lines.append(
            f"# {row['calendar']} English orations: {row['slots']} slots appointed, "
            f"{row['with_english']} with English, {row['ledgered_untranslated']} "
            f"ledgered untranslated, {row['unaccounted']} unaccounted; "
            f"{row['outside_the_ledger']} composed propers outside the ledger's "
            f"slots, {row['unmatched_records']} ledger rows matching no slot"
        )
    return lines


def census(root: Path) -> dict[str, dict]:
    cited = passage_counts(root)
    found = {}
    for name in ordered(calendars(root), CALENDAR_ORDER):
        # The file as written, not the merged document: a recension's size is the
        # size of its diff, and counting the base's masses under the recension's
        # name would report a projection as though it were a second whole book.
        counted = census_of(load_calendar(root, name, effective=False))
        counted.update(cited.get(name) or {"passages": 0, "books": 0})
        found[name] = counted
    return found


CENSUS_MEASURES = (
    ("Masses", "masses"),
    ("Propers", "propers"),
    ("— named `Placeholder`", "placeholder_propers"),
    ("— inside a `forms` block", "propers_in_forms"),
    ("— carrying a `cycles` mapping", "cycle_propers"),
    ("Masses holding only placeholders", "placeholder_only_masses"),
    ("Masses taking a formulary from another entry", "masses_taking_a_formulary"),
    ("Propers taking their text from another entry", "propers_taken_by_reference"),
    ("Propers that are not placeholders", "substantive_propers"),
    ("— of those, scripture-bearing", "scripture_bearing_propers"),
    ("Encoded passages", "passages"),
    ("Distinct books cited", "books"),
    ("Distinct slot names", "slot_names"),
)


def render_census(counted: dict[str, dict]) -> str:
    """The block both documents carry, byte-identical in each."""
    names = list(counted)
    lines = [CENSUS_BEGIN, ""]
    lines.append("| Calendar | Section | Masses | Propers | Masses holding only placeholders |")
    lines.append("| --- | --- | ---: | ---: | ---: |")
    for name in names:
        for row in counted[name]["sections"]:
            lines.append(
                f"| {name} | {row['kind'] or row['section']} | {row['masses']} | "
                f"{row['propers']} | {row['placeholder_only_masses']} |"
            )
    lines.append("")
    lines.append("| Calendar | Rank | Entries | Celebrations |")
    lines.append("| --- | --- | ---: | ---: |")
    for name in names:
        for row in counted[name]["ranks"]:
            lines.append(
                f"| {name} | {row['rank']} | {row['entries']} | {row['celebrations']} |"
            )
    lines.append("")
    lines.append("| Measure | " + " | ".join(names) + " |")
    lines.append("| --- |" + " ---: |" * len(names))
    for label, key in CENSUS_MEASURES:
        lines.append(
            f"| {label} | " + " | ".join(str(counted[name][key]) for name in names) + " |"
        )
    lines.append("")
    lines.extend(textwrap.wrap(CENSUS_KEYS, WIDTH))
    # Wrapped as its own paragraph rather than appended to CENSUS_KEYS. Appending
    # would re-flow every line of a paragraph that has not changed, and the whole
    # value of a derived block is that a diff of it shows only what moved.
    lines.append("")
    lines.extend(textwrap.wrap(CENSUS_RANK_KEYS, WIDTH))
    lines.append("")
    lines.append(CENSUS_END)
    return "\n".join(lines) + "\n"


def replace_census(text: str, block: str) -> str:
    """Swap the delimited region for ``block``; refuse anything else."""
    begin, end = text.find(CENSUS_BEGIN), text.find(CENSUS_END)
    if begin < 0 or end < 0:
        raise ValueError(f"no census region: expected {CENSUS_BEGIN} and {CENSUS_END}")
    if end < begin:
        raise ValueError("census region is inverted: the end marker precedes the begin")
    return text[:begin] + block + text[end + len(CENSUS_END) + 1 :]


def run_census(arguments: argparse.Namespace) -> dict:
    """Derive the census; optionally rewrite or check the documents carrying it."""
    counted = census(Path(arguments.root))
    block = render_census(counted)
    payload: dict[str, object] = {
        "calendars": counted,
        "block": block,
        # Derived every run and written into no document; see the comment above
        # `english_coverage` for why it is reported rather than written.
        "english_coverage": coverage(Path(arguments.root)),
        "status": "ok",
    }
    if not (arguments.write or arguments.check):
        return payload
    documents, stale = [], False
    for relative in CENSUS_DOCUMENTS:
        path = Path(arguments.doc_root) / relative
        if not path.is_file():
            raise ValueError(f"no document at {path}")
        before = path.read_text(encoding="utf-8")
        after = replace_census(before, block)
        if after == before:
            state = "current"
        elif arguments.write:
            path.write_text(after, encoding="utf-8")
            state = "rewritten"
        else:
            state = "stale"
            stale = True
        documents.append({"path": relative, "state": state})
    payload["documents"] = documents
    payload["status"] = "stale" if stale else "ok"
    return payload


def run_show(arguments: argparse.Namespace) -> dict:
    if not arguments.calendar:
        raise ValueError("--calendar is required")
    if not arguments.mass:
        raise ValueError("--mass is required")
    payload = find_mass(Path(arguments.root), arguments.calendar, arguments.mass)
    arguments.appointed = appointed_propers(payload.pop("_document"), payload["mass"])
    # The recorded English, by the same merge the browser gets.
    #
    # `propers.yaml` carries no `translations` key — they live in the sidecar
    # overlay this tool already reads for `structure`. Reading the raw entry
    # here meant this verb reported `no en translation recorded` over every one
    # of the translations the sidecar holds and the site serves, which is the
    # answer a maintainer would act on when checking whether a proper still
    # needs harvesting. Merged through `carry_translations` so the two verbs
    # cannot disagree about which entry answers which proper.
    #
    # No rights filter here, unlike `structure`. That filter exists because the
    # structure file is the published artifact; this verb prints to a terminal
    # over tracked sources, and an operator checking the corpus needs to see
    # the English the site is withholding as much as the English it shows.
    overlay, untranslated, stale, _ = translation_overlay(arguments.calendar)
    merged = []
    for form, proper, taken_from in arguments.appointed:
        key = overlay_key(payload["mass"], form, proper, taken_from)
        carried = carry_translations(arguments.calendar, key, proper, overlay, stale)
        # Distinguishes a proper nobody has looked at from one deliberately
        # left without English, which is the distinction the `untranslated`
        # ledger exists to record; the structure pass writes the same key.
        if key in untranslated:
            carried["untranslated"] = True
        merged.append((form, carried, taken_from))
    arguments.appointed = merged
    if stale:
        payload["stale_translations"] = stale
    # Resolve here so a missing bible or an unusable numbering fails before rendering.
    bible = load_bible(arguments.bible, Path(arguments.bible_root)) if arguments.bible else None
    arguments.resolved_bible = resolve_passages(payload, bible) if bible else {}

    # What the day USES, in the payload and not only in the reading view.
    #
    # `mass.propers` is what the entry CARRIES, and for a great many masses
    # that is not the Mass: a third-class saint carries three orations and
    # points at a Common for everything else, and Christmas carries no flat
    # list at all but four `forms`. A caller reading `mass.propers` from the
    # JSON therefore saw a Sunday correctly, a saint with no Epistle and no
    # Gospel, and Christmas as an empty Mass — an absence with no reason,
    # printed by `mass-today` for months. The resolution already existed and
    # was reachable from the text renderer alone; this is the same one
    # derivation, `_calendars.resolve_propers`, serialised.
    payload["appointed"] = [
        {
            "form": form or None,
            "name": proper.get("name"),
            "taken_from": taken_from,
            "proper": proper,
        }
        for form, proper, taken_from in arguments.appointed
    ]
    # And the words behind the citations, when a bible was named. `--bible`
    # resolved them and printed them and never put them in the payload, so
    # `mass-today --bible` passed the flag through and showed no scripture at
    # all: the flag was inert everywhere except this tool's own text view.
    #
    # The key is present only where a bible was named. `--bible` is a rendering
    # option and an option may not sit in a record — the smoke test says so and
    # is right — so what appears here is not the flag but what the flag
    # RESOLVED, and where nothing was resolved there is nothing to carry.
    if bible:
        payload["bible"] = {
            "id": arguments.bible,
            "edition": bible.get("edition"),
            "numbering": bible.get("numbering"),
            "passages": arguments.resolved_bible,
        }
    return payload


def run_list(arguments: argparse.Namespace) -> dict:
    root = Path(arguments.root)
    wanted = [arguments.calendar] if arguments.calendar else calendars(root)
    listing = {}
    for calendar in wanted:
        rows = []
        for kind, mass in masses_of(load_calendar(root, calendar)):
            rows.append(
                {
                    "key": mass.get("key"),
                    "name": mass.get("name"),
                    "kind": mass.get("kind") or kind,
                    "registry": mass.get("registry"),
                    "propers": len(propers_of(mass)),
                }
            )
        listing[calendar] = rows
    return {"calendars": listing}


def wrap(text: str, indent: str) -> list[str]:
    lines: list[str] = []
    for paragraph in text.strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if not block:
            continue
        lines.extend(textwrap.wrap(block, WIDTH - len(indent)) or [""])
        lines.append("")
    return [indent + line if line else "" for line in lines[:-1] or lines]


def render_reading(
    payload: dict,
    lang: str,
    resolved: dict,
    witness: str | None = None,
    appointed: list[tuple[str, dict, dict | None]] | None = None,
) -> int:
    mass = payload["mass"]
    if appointed is None:
        appointed = [(form, proper, None) for form, proper in propers_of(mass)]
    print(mass.get("name") or mass.get("key") or "(unnamed)")
    subtitle = " · ".join(
        str(part)
        for part in (payload.get("edition"), payload.get("kind"), mass.get("registry"))
        if part
    )
    if subtitle:
        print(subtitle)
    print("=" * WIDTH)
    reference = mass.get(_calendars.TAKES_FROM)
    if reference:
        printed = str(reference.get("citation") or "").strip()
        print(
            f"Takes the Mass of {reference.get('mass')}"
            + (f", form {reference['form']}" if reference.get("form") else "")
            + (f" ({printed})" if printed else "")
        )
    for form, proper, taken_from in appointed:
        heading = str(proper.get("name") or "(unnamed proper)")
        if form:
            heading = f"{heading} [{form}]"
        print(f"\n{heading}")
        print("-" * len(heading))
        if taken_from:
            print(f"  (from {taken_from['mass']}"
                  + (f", {taken_from['proper']}" if taken_from.get("proper") else "")
                  + ")")
        for entry in proper.get("verses") or []:
            if isinstance(entry, dict) and entry.get("ref"):
                # The missal's own citation stands; a conversion is shown beside it.
                found = resolved.get(str(entry["ref"])) or {}
                note = found.get("note")
                print(f"  {entry['ref']}" + (f"  ({note})" if note else ""))
                if found.get("text"):
                    print("\n".join(wrap(str(found["text"]), "    ")))
        for cycle, owner in sorted((proper.get("cycles") or {}).items()):
            refs = [
                v["ref"]
                for v in (owner.get("verses") or [])
                if isinstance(v, dict) and v.get("ref")
            ]
            if refs:
                print(f"  {cycle}: {', '.join(refs)}")
        for body, attribution, note in select_texts(proper, lang, witness):
            if body:
                print()
                if attribution:
                    print(f"  [{attribution}]")
                print("\n".join(wrap(body, "  ")))
            if note:
                print(f"\n  ({note})")
    return 0


def select_texts(
    proper: dict, lang: str, witness: str | None = None
) -> list[tuple[str, str, str]]:
    """Which texts of a proper to print. The rule lives in `_calendars`.

    It was here, and `mass-today --expanded` prints propers too; a second copy
    would have been a second answer to which text a Mass is said in.
    """
    return _calendars.texts_of(proper, lang, witness)


def render_listing(payload: dict) -> int:
    for calendar, rows in payload["calendars"].items():
        for row in rows:
            print(
                f"{calendar}\t{row['registry'] or ''}\t{row['kind']}\t"
                f"{row['propers']}\t{row['key']}\t{row['name'] or ''}"
            )
        print(f"# {calendar}: {len(rows)} masses", file=sys.stderr)
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_ROOT), help="calendar root directory")
    shared.add_argument("--calendar", help="calendar directory name, e.g. roman-1962")
    shared.add_argument("--mass", help="mass key, e.g. advent-1")
    shared.add_argument(
        "--format", choices=("text", "yaml", "json"), default="text", help="output form"
    )
    shared.add_argument(
        "--bible", help="indexed bible to resolve scripture refs against, e.g. douay-rheims"
    )
    shared.add_argument(
        "--lang", default="la", help="language for composed propers (default: la)"
    )
    shared.add_argument(
        "--witness",
        help="show only this translation's source_id; without it every "
        "translation in --lang is shown, each one named",
    )
    shared.add_argument(
        "--bible-root",
        default=str(BIBLE_ROOT),
        help="where indexed bibles live; point outside the repo to keep a "
        "licensed text unpublished",
    )
    shared.add_argument(
        "--out", default="src/web/data", help="where `structure` writes its files"
    )
    shared.add_argument(
        "--doc-root",
        default=str(ROOT),
        help="repository root holding the documents `census` writes into",
    )
    shared.add_argument(
        "--write",
        action="store_true",
        help="`census`: rewrite the derived block in every document carrying it",
    )
    shared.add_argument(
        "--check",
        action="store_true",
        help="`census`: exit 1 naming any document whose block is stale, writing nothing",
    )
    shared.add_argument(
        "--verbose", action="store_true", help="list every citation that refused to resolve"
    )
    shared.add_argument(
        "--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)"
    )
    parser = argparse.ArgumentParser(
        prog="mass-propers",
        description="Print one mass's propers as YAML, JSON, or a reading view.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "mass-propers")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("show", help="print one mass's propers", parents=[shared]),
        EXAMPLES["show"],
    )
    with_examples(
        sub.add_parser("list", help="list the masses a calendar carries", parents=[shared]),
        EXAMPLES["list"],
    )
    with_examples(
        sub.add_parser(
            "structure",
            help="write the browser's structure files, citations resolved to loci",
            parents=[shared],
        ),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser(
            "census",
            help="derive the count of both calendars, and write it into the documents",
            parents=[shared],
        ),
        EXAMPLES["census"],
    )

    def render(payload: object, arguments: argparse.Namespace) -> int:
        if not isinstance(payload, dict):
            print("mass-propers error: invalid payload", file=sys.stderr)
            return 70
        if arguments.json or arguments.format == "json":
            print_json(payload)
            return 0
        if arguments.format == "yaml":
            import yaml

            print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
            return 0
        if "block" in payload:
            # To stderr, so that redirecting the block to a file still leaves the
            # block alone and still shows the operator the coverage. The
            # hand-typed copy of these figures lives in a file this tool does not
            # own, so reporting them is the whole of what can be done from here.
            #
            # Not under `--check`. That verb answers one yes/no question for
            # `make check-propers-census`, and a gate that prints figures it does
            # not gate teaches its operators to skim past its output.
            if not arguments.check:
                reported = payload.get("english_coverage") or []
                for line in render_coverage(reported):  # type: ignore[arg-type]
                    print(line, file=sys.stderr)
            rows = payload.get("documents")
            if rows is None:
                print(str(payload["block"]), end="")
                return 0
            for row in rows:  # type: ignore[union-attr]
                print(f"{row['state']}\t{row['path']}")
            if payload["status"] == "stale":
                print(
                    "mass-propers census: stale; rerun with --write",
                    file=sys.stderr,
                )
                return 1
            return 0
        if "written" in payload:
            for calendar, counts in payload["calendars"].items():
                print(f"{calendar}: {counts['masses']} masses, {counts['citations']} citations")
            for path in payload["written"]:
                print(f"  -> {path}")
            held = payload["withheld"]
            if isinstance(held, list):
                for row in held:
                    print(f"  {row}")
            elif held:
                print(f"  withheld from publication: {held}")
            refused = payload["refused"]
            if isinstance(refused, list):
                for row in refused:
                    print(f"  refused {row}")
            else:
                print(f"  refused: {refused}")
            return 0
        if "calendars" in payload:
            return render_listing(payload)
        return render_reading(
            payload,
            arguments.lang,
            getattr(arguments, "resolved_bible", {}),
            arguments.witness,
            getattr(arguments, "appointed", None),
        )

    return run_verb_cli(
        parser=parser,
        handlers={
            "show": run_show,
            "list": run_list,
            "structure": run_structure,
            "census": run_census,
        },
        renderer=render,
        prefix="mass-propers",
        argv=argv,
        default_verb="show",
        dependency_message="install PyYAML (requirements-tools.txt)",
        mapped_errors={KeyError: ("not-found", 3), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
