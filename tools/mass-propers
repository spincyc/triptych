def inventory_root(calendar_root: Path) -> Path:
    """The inventory directory belonging to a passed calendar root."""

    return calendar_root.parent / TRANSLATIONS_DIR


def validate_translation_payload(
    entry: dict, path: Path, witnesses: dict[str, dict] | None = None
) -> None:
    """Reject malformed or unowned language bodies before public projection."""

    incipit = entry.get("incipit")
    if "incipit" in entry and (
        not isinstance(incipit, str) or not incipit.strip()
    ):
        raise ValueError(f"{path}: translation entry incipit must be nonempty")
    payload = entry.get("translations")
    if not isinstance(payload, list) or not payload:
        raise ValueError(f"{path}: translation entry must carry translations")
    seen: set[tuple[str, str | None]] = set()
    for index, translation in enumerate(payload):
        where = f"{path}: translation[{index}]"
        if not isinstance(translation, dict):
            raise ValueError(f"{where} must be a table")
        unknown = sorted(set(translation) - LEDGER_TRANSLATION_FIELDS, key=repr)
        if unknown:
            raise ValueError(f"{where} has unknown fields {unknown!r}")
        for field in ("lang", "text", "rights"):
            value = translation.get(field)
            if not isinstance(value, str) or not value.strip():
                raise ValueError(f"{where} {field} must be a nonempty string")
        rights = str(translation["rights"])
        if rights not in LEDGER_TRANSLATION_RIGHTS:
            raise ValueError(
                f"{where} rights must be one of "
                f"{sorted(LEDGER_TRANSLATION_RIGHTS)!r}"
            )
        source_id = translation.get("source_id")
        if source_id is not None and (
            not isinstance(source_id, str) or not source_id.strip()
        ):
            raise ValueError(f"{where} source_id must be a nonempty string")
        if rights in {"public-domain", "licensed", "permission"} and not source_id:
            raise ValueError(f"{where} {rights} translation requires source_id")
        witness_key = str(source_id) if isinstance(source_id, str) else ""
        witness = (witnesses or {}).get(witness_key)
        if rights != "project-created" and witnesses is not None and witness is None:
            raise ValueError(
                f"{where} source_id {witness_key!r} has no translation source row"
            )
        if witness is not None and rights != witness.get("rights"):
            raise ValueError(
                f"{where} rights {rights!r} do not match translation source "
                f"{witness_key!r} rights {witness.get('rights')!r}"
            )
        notice = translation.get("notice")
        if rights in {"licensed", "permission"} and (
            not isinstance(notice, str) or not notice.strip()
        ):
            raise ValueError(f"{where} {rights} translation requires notice")
        if notice is not None and (
            not isinstance(notice, str) or not notice.strip()
        ):
            raise ValueError(f"{where} notice must be a nonempty string")
        identity = (
            str(translation["lang"]),
            str(source_id) if isinstance(source_id, str) else None,
        )
        if identity in seen:
            raise ValueError(f"{where} duplicates language/source {identity!r}")
        seen.add(identity)


def ledger_rows(document: dict, field: str, path: Path) -> list:
    """One TOML array-of-tables, never truthy scalar iteration."""

    value = document.get(field) or []
    if not isinstance(value, list):
        raise ValueError(f"{path}: {field} must be an array of tables")
    return value


def translation_ledger_calendar(
    calendar: str, root: Path = DEFAULT_ROOT
) -> str | None:
    """The calendar whose sidecar supplies ``calendar``'s translations.

    A recension inherits its text through ``text_from`` and, in the absence of
    a sidecar of its own, inherits the same translation ledger. Follow the
    whole chain rather than only its first edge: a future middle recension
    must not lose translations merely because its own base is also a
    recension. The recension validator owns missing bases and cycles; this
    reader stops defensively if it encounters one.
    """
    owner = calendar
    seen: set[str] = set()
    while owner not in seen:
        path = inventory_root(root) / f"{owner}-proper-translations-v1.toml"
        if path.is_file():
            return owner
        seen.add(owner)
        document = _calendars.load_document(root, owner, effective=False)
        base = document.get(_calendars.RECENSION_BASE)
        if not isinstance(base, str) or not base or base == owner:
            return None
        owner = base
    return None


def translation_ledger_calendars(
    calendar: str, root: Path = DEFAULT_ROOT
) -> list[str]:
    """Every translation sidecar inherited by ``calendar``, base first.

    A child recension may add exact translations or absences without copying
    its parent's ledger.  Reading only the nearest sidecar makes that addition
    replace the parent wholesale; reading only the first ancestor makes it
    impossible to state a child-only gap.  The ordered chain is therefore the
    same additive inheritance the calendar itself uses.
    """

    chain: list[str] = []
    owner = calendar
    seen: set[str] = set()
    while owner not in seen:
        seen.add(owner)
        chain.append(owner)
        document = _calendars.load_document(root, owner, effective=False)
        base = document.get(_calendars.RECENSION_BASE)
        if not isinstance(base, str) or not base or base == owner:
            break
        owner = base
    return [
        name
        for name in reversed(chain)
        if (inventory_root(root) / f"{name}-proper-translations-v1.toml").is_file()
    ]


