#!/usr/bin/env python3
"""Derive the date-ordered sanctoral spine from the repo's calendar references.

Usage: calendar-spine [derive] [--calendar NAME] [--kind KIND]

Parses the verified calendar-reference publications — the 1962 sanctorale
sections and the postconciliar general-calendar section — into one date-ordered
list per calendar, each entry classified as marian, christological, seasonal, or
sanctoral.
The spine is the identity and ordering source for the sanctoral mass indexes
under src/sources/calendars; it carries no propers.

Classification follows the edition's own printed title. The 1962 books title
February 2 and March 25 as feasts of Our Lady (In Purificatione, Annuntiatio
Beatae Mariae Virginis) while the postconciliar books title them of the Lord,
and this tool reproduces that difference rather than harmonizing it.

`--calendar` offers every calendar the repository holds, including ones this
tool derives no spine for, so that asking gets the REASON instead of an invalid
choice. A recension has no spine of its own -- see the note on SOURCES.
"""
from __future__ import annotations

import argparse
import re
import sys
import unicodedata
from functools import lru_cache
from pathlib import Path
# Shared CLI helpers live outside tools/ so that tmt's registry scan,
# which requires every file in tools/ to be a registered tool, stays clean.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

import _calendars
from _tooling import (
    Example,
    examples_live_on_the_verbs,
    print_json,
    run_verb_cli,
    with_examples,
)

# Captured transcripts, never composed; see scripts/_tooling.py.
EXAMPLES = {
    "derive": (
        Example(
            "tools/calendar-spine derive --calendar roman-1962 --kind marian",
            (
                "roman-1962\t02-02\tmarian\t1962-02-02\tII\tpurificatione-beatae-mariae-virginis\tIn Purificatione Beatae Mariae Virginis",
                "roman-1962\t02-11\tmarian\t1962-02-11\tIII\tapparitione-beatae-mariae-virginis-immaculatae\tIn Apparit... [+39 chars]",
                "roman-1962\t03-25\tmarian\t1962-03-25\tI\tannuntiatio-beatae-mariae-virginis\tAnnuntiatio Beatae Maria... [+10 chars]",
                "roman-1962\t05-31\tmarian\t1962-05-31\tII\tbeatae-mariae-virginis-reginae\tBeatae Mariae Virginis Regi... [+34 chars]",
                "... 14 more lines",
            ),
        ),
        Example(
            "tools/calendar-spine derive --calendar postconciliar --kind christological --json",
            (
                "{\"calendars\":{\"postconciliar\":[{\"date\":\"01-03\",\"day\":3,\"key\":\"most-holy-name-jesus\",\"kind\":\"chri... [+1160 chars]",
            ),
        ),
    ),
}

ROOT = Path(__file__).resolve().parents[1]
CALENDAR_ROOT = ROOT / "src" / "sources" / "calendars"

# A spine is derived from a calendar's own REFERENCE PUBLICATION -- the verified
# TeX sections below -- and from nothing else. This dict is therefore closed on
# purpose, and its being closed is a statement rather than an oversight; a
# refusal nobody explained is indistinguishable from one, so `no_spine` gives
# the reason and `--calendar` accepts every calendar the repository holds in
# order that the reason can be reached at all.
#
# THE PRE-1955 RECENSION IS THE CASE THIS WAS WRITTEN FOR, and its absence here
# is correct. A recension is held as its DEPARTURES from a base and never as a
# second copy of it (guidance/recensions.md Rule 2). `roman-pre-1955` states six
# departures, every one of them in Holy Week, and states NO SANCTORAL AT ALL:
# its sanctoral is its base's, and its base's is already derived under the
# base's name. Deriving it again under the recension's name would write exactly
# the second copy Rule 2 refuses -- and would key and number it as though it had
# been read from a pre-1955 book, which nobody here has read. There is also no
# such publication to read: src/gpt/liturgy/roman-rite holds 1962, postconciliar
# and comparative, and nothing standing before 1955.
#
# So a recension gets no row here even once it grows a sanctoral departure. What
# it would want then is the base's spine with its departures applied, which is
# `_calendars.load_document`'s job and not a second parse of a TeX file.
SOURCES = {
    "roman-1962": (
        ROOT / "src/gpt/liturgy/roman-rite/1962/reference/liturgical-calendar/sections",
        ("50-sanctorale-jan-jun.tex", "60-sanctorale-jul-dec.tex"),
    ),
    "postconciliar": (
        ROOT
        / "src/gpt/liturgy/roman-rite/postconciliar"
        / "roman-missal-third-edition-en-us-2011/reference/liturgical-calendar/sections",
        ("50-general-calendar.tex",),
    ),
}
KINDS = ("christological", "marian", "sanctoral", "seasonal")

MONTHS = (
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
)
MONTH_NUMBER = {name: number for number, name in enumerate(MONTHS, start=1)}
ABBREVIATED = {
    "Jan.": 1, "Feb.": 2, "March": 3, "Mar.": 3, "April": 4, "Apr.": 4,
    "May": 5, "June": 6, "Jun.": 6, "July": 7, "Jul.": 7, "Aug.": 8,
    "Sept.": 9, "Sep.": 9, "Oct.": 10, "Nov.": 11, "Dec.": 12,
}

CALENTRY = re.compile(r"\\calentry\{([^}]*)\}\{(.*?)\}\{([^}]*)\}\s*$")
CALMONTH = re.compile(r"\\calmonth\{([^}]*)\}")
TABLE_MONTH = re.compile(r"\\bfseries\s+([A-Z][a-z]+)\}")
TABLE_ROW = re.compile(r"^(\d{1,2})\s*&\s*(.+?)\s*&\s*\\calrank\{([^}]*)\}")

LORD = (
    "domini", "iesu christi", "jesu christi", "of the lord", "name of jesus",
    "transfiguration", "transfiguratione", "sacred heart", "sacratissimi cordis",
    "christ the king", "christi regis", "precious blood", "pretiosissimi sanguinis",
    "corpus christi", "corporis christi", "sanctissimi", "crucis", "cross",
)
MARIAN = (
    "beatae mariae virginis", "mariae virginis", "blessed virgin mary",
    "virgin mary", "our lady", "mother of god", "annuntiatione", "purificatione",
    "assumptione", "immaculata", "immaculate", "rosarii", "carmelo", "guadalupe",
    "lourdes", "fatima", "loreto", "maternitatis", "visitatione", "septem dolorum",
    "sorrows", "queenship", "assumption",
)
# A day within the octave is a seasonal celebration for the fixed-calendar spine
# unless the edition prints a celebration of its own after a colon.
OCTAVE_DAY = re.compile(r"^\w+\s+day\s+within\s+the\s+octave\b", re.IGNORECASE)
VIGIL_OF = re.compile(r"^vigil\s+of\s+(?:the\s+)?(.*)$", re.IGNORECASE)
# A word boundary after a literal period never matches before a space, so these
# head patterns require the following whitespace explicitly.
PERSON_HEAD = re.compile(r"^(ss?\.\s|saints?\s|beati\s|beatae\s(?!mariae))", re.IGNORECASE)
DROP_FROM_SLUG = re.compile(r"\b(ss?\.|comm\.|in|the|of|and|et|de|with|at)\b")


def strip_tex(text: str) -> str:
    for _ in range(3):
        text = re.sub(r"\\[a-zA-Z]+\{(.*?)\}", r"\1", text)
    text = text.replace("``", '"').replace("''", '"').replace("~", " ")
    text = text.replace(r"\&", "&").replace("--", "-")
    return re.sub(r"\s+", " ", text).strip()


def fold(text: str) -> str:
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(c for c in decomposed if not unicodedata.combining(c)).lower()


def classify(title: str) -> str:
    """Classify by the head of the edition's printed title.

    A title headed by a person is that person's feast even when it names Our
    Lady, so Saint Joachim and Saint Joseph, Spouse of the Blessed Virgin Mary
    are saints' feasts. Matching is whole-word, so "S. Dominici" is not read as
    a feast of the Lord.

    Within an octave the edition's punctuation carries the distinction: a colon
    introduces the day's own celebration, a semicolon a mere commemoration.
    """
    head = re.sub(r"^comm\.\s*", "", title.strip(), flags=re.IGNORECASE)
    if OCTAVE_DAY.match(head):
        # "Second day within the octave: S. Stephani" is St Stephen's feast set
        # within the octave; "Fifth day within the octave; comm. S. Thomae" is
        # the octave day itself, so the semicolon clause is cut away first.
        principal = head.split(";")[0]
        _, colon, celebration = principal.partition(":")
        if colon and celebration.strip():
            return classify(celebration.strip())
        return "seasonal"
    # A vigil belongs to the celebration it precedes.
    vigil = VIGIL_OF.match(head.split(";")[0])
    if vigil and vigil.group(1).strip():
        return classify(vigil.group(1).strip())
    if PERSON_HEAD.match(head):
        return "sanctoral"
    folded = fold(head)

    def has(tokens: tuple[str, ...]) -> bool:
        return any(
            re.search(rf"(?<![a-z]){re.escape(token)}(?![a-z])", folded)
            for token in tokens
        )

    if has(MARIAN):
        return "marian"
    if has(LORD):
        return "christological"
    return "sanctoral"


def make_key(title: str, used: set[str]) -> str:
    """Key an entry by its principal celebration, not by its commemorations."""
    base = DROP_FROM_SLUG.sub(" ", fold(title.split(";")[0]))
    base = re.sub(r"[^a-z0-9]+", "-", base).strip("-")
    base = "-".join([part for part in base.split("-") if part][:6]) or "celebration"
    candidate, suffix = base, 2
    while candidate in used:
        candidate = f"{base}-{suffix}"
        suffix += 1
    used.add(candidate)
    return candidate


def parse_calentries(directory: Path, names: tuple[str, ...]) -> list[dict]:
    entries: list[dict] = []
    for name in names:
        path = directory / name
        if not path.is_file():
            raise ValueError(f"missing calendar section: {path}")
        month = None
        for line in path.read_text(encoding="utf-8").splitlines():
            found_month = CALMONTH.search(line)
            if found_month:
                month = MONTH_NUMBER.get(strip_tex(found_month.group(1)))
                continue
            found = CALENTRY.search(line.strip())
            if not found:
                continue
            date_text = strip_tex(found.group(1))
            bits = date_text.split()
            if len(bits) != 2 or bits[0] not in ABBREVIATED or not bits[1].isdigit():
                raise ValueError(f"{path.name}: unreadable date {date_text!r}")
            entries.append(
                {
                    "month": ABBREVIATED[bits[0]],
                    "day": int(bits[1]),
                    "title": strip_tex(found.group(2)),
                    "rank": strip_tex(found.group(3)),
                }
            )
    return entries


def parse_table(directory: Path, names: tuple[str, ...]) -> list[dict]:
    entries: list[dict] = []
    month = None
    for name in names:
        path = directory / name
        if not path.is_file():
            raise ValueError(f"missing calendar section: {path}")
        for line in path.read_text(encoding="utf-8").splitlines():
            found_month = TABLE_MONTH.search(line)
            if found_month:
                month = MONTH_NUMBER.get(found_month.group(1))
                continue
            found = TABLE_ROW.match(line.strip())
            if not found:
                continue
            if month is None:
                raise ValueError(f"{path.name}: a row precedes its month heading")
            entries.append(
                {
                    "month": month,
                    "day": int(found.group(1)),
                    "title": strip_tex(found.group(2)),
                    "rank": strip_tex(found.group(3)),
                }
            )
    return entries


PARSERS = {"roman-1962": parse_calentries, "postconciliar": parse_table}
PREFIX = {"roman-1962": "1962", "postconciliar": "pc"}


def spine(calendar: str) -> list[dict]:
    directory, names = SOURCES[calendar]
    entries = PARSERS[calendar](directory, names)
    if not entries:
        raise ValueError(f"{calendar}: no calendar entries found")
    entries.sort(key=lambda entry: (entry["month"], entry["day"]))
    used: set[str] = set()
    for entry in entries:
        entry["kind"] = classify(entry["title"])
        entry["key"] = make_key(entry["title"], used)
        entry["date"] = f"{entry['month']:02d}-{entry['day']:02d}"
        entry["registry"] = f"{PREFIX[calendar]}-{entry['date']}"
    return entries


@lru_cache(maxsize=1)
def held_calendars() -> tuple[str, ...]:
    """Every calendar this repository holds a mass index for.

    Walked rather than typed, and walked with the shared walker: nothing about
    the calendar directory is fixed at two here, so a calendar this tool has no
    spine for can still be told apart from a name nobody holds.
    """
    try:
        indexes, _, _ = _calendars.partition(CALENDAR_ROOT)
    except ValueError:
        return ()
    return tuple(sorted({path.parent.name for path in indexes}))


def no_spine(calendar: str) -> str:
    """Why this tool derives no spine for a calendar it holds no source for.

    Three different facts, and answering `unknown calendar` to all three is how
    a considered refusal reads as a gap. The recension case is the one the note
    on SOURCES sets out, and it is READ -- `base_of` is the calendar's own
    `text_from` header -- rather than inferred from the name.
    """
    held = held_calendars()
    if calendar not in held:
        return (
            f"unknown calendar: {calendar}. This repository holds "
            f"{', '.join(held) or 'no calendar sources'}."
        )
    base = _calendars.base_of(CALENDAR_ROOT, calendar)
    if base:
        return (
            f"{calendar} is a recension of {base} and has no spine of its own. "
            "It is held as its departures from that calendar and states no "
            f"sanctoral, so its sanctoral is {base}'s, already derived under "
            f"that name: ask for --calendar {base}. Deriving it again here "
            "would write a second copy of the base's spine under the "
            "recension's name, which guidance/recensions.md Rule 2 refuses."
        )
    return (
        f"{calendar} states a calendar of its own, but this repository holds no "
        "verified reference publication for it to be derived from. Land one "
        "under src/gpt and name its sections in SOURCES."
    )


def run(calendar: str | None, kind: str | None) -> dict[str, object]:
    if calendar is not None and calendar not in SOURCES:
        raise ValueError(no_spine(calendar))
    if kind is not None and kind not in KINDS:
        raise ValueError(f"unknown kind: {kind}")
    calendars = [calendar] if calendar else sorted(SOURCES)
    result: dict[str, object] = {}
    counts: dict[str, dict[str, int]] = {}
    for name in calendars:
        entries = spine(name)
        if kind:
            entries = [entry for entry in entries if entry["kind"] == kind]
        result[name] = entries
        tally: dict[str, int] = {}
        for entry in entries:
            tally[entry["kind"]] = tally.get(entry["kind"], 0) + 1
        counts[name] = dict(sorted(tally.items()))
    return {"calendars": result, "counts": counts, "status": "ok"}


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    # Every calendar the repository holds, not only the ones with a spine: a
    # calendar refused by argparse as an invalid choice never reaches the
    # sentence that says why it has none.
    shared.add_argument("--calendar", choices=sorted(set(SOURCES) | set(held_calendars())))
    shared.add_argument("--kind", choices=KINDS)
    shared.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )
    parser = argparse.ArgumentParser(
        prog="calendar-spine",
        description=(
            "Derive the date-ordered sanctoral spine from the repo's "
            "calendar references."
        ),
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "calendar-spine")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("derive", help="derive the date-ordered sanctoral spine", parents=[shared]),
        EXAMPLES["derive"],
    )

    def dispatch(arguments):
        return run(arguments.calendar, arguments.kind)

    def render(payload: object, arguments: argparse.Namespace) -> int:
        as_json = bool(getattr(arguments, "json", False))
        if as_json:
            print_json(payload if isinstance(payload, dict) else {})
            return 0
        if not isinstance(payload, dict):
            print("calendar-spine error: invalid payload", file=sys.stderr)
            return 70
        for name, entries in payload["calendars"].items():
            for entry in entries:
                print(
                    f"{name}\t{entry['date']}\t{entry['kind']}\t{entry['registry']}"
                    f"\t{entry['rank']}\t{entry['key']}\t{entry['title']}"
                )
        for name, tally in payload["counts"].items():
            detail = ", ".join(f"{count} {kind}" for kind, count in tally.items())
            print(f"# {name}: {sum(tally.values())} entries ({detail})", file=sys.stderr)
        return 0

    return run_verb_cli(
        parser=parser,
        handlers={"derive": dispatch},
        renderer=render,
        prefix="calendar-spine",
        argv=argv,
        default_verb="derive",
    )


if __name__ == "__main__":
    raise SystemExit(main())
