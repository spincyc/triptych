def calendar_structure(sources: Path, path: Path, library: dict[str, dict]) -> dict:
    name = path.name
    source = read_toml(path)
    for field in REQUIRED_TOP:
        if field not in source:
            raise SourceError(f"{name}: missing required field {field!r}")
    if source["schema"] != SCHEMA:
        raise SourceError(f"{name}: schema is {source['schema']!r}, expected {SCHEMA!r}")
    calendar = source["calendar"]
    if name != calendar + INVENTORY_SUFFIX:
        raise SourceError(f"{name}: declares calendar {calendar!r}, which its filename does not match")

    # The book's identity belongs to the mass index that transcribes it, and is
    # read from there rather than retyped here --- the same rule the rubrics
    # sources are held to, for the same reason.
    for field in _calendars.INDEX_OWNED:
        if field in source:
            raise SourceError(
                f"{name}: {field} belongs to the calendar's mass index and must not be restated here"
            )

    restricted = restricted_witness_table(source, library, name)
    witnesses = witness_table(source, library, name)
    overlap = set(restricted) & set(witnesses)
    if overlap:
        identifier, language = sorted(overlap)[0]
        raise SourceError(
            f"{name}: witness {identifier} for {language} is both publishable "
            "and rights-restricted"
        )
    absences = absence_table(source, name)
    variants, options = variant_table(source, name)

    sections = []
    exclusions = []
    seen: set[str] = set()
    seen_exclusions: set[str] = set()
    for section in source["sections"]:
        key = section.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: a section has no key")
        if "artifact" in section and "elements" in section:
            raise SourceError(f"{name}: section {key} names both an artifact and inline elements")
        if "artifact" in section:
            elements, section_exclusions = from_artifact(
                section, witnesses, restricted, absences, library, name
            )
        elif "elements" in section:
            for field in (
                "exclusions", "turn_partitions", "absent_latin_by_element",
            ):
                if field in section:
                    raise SourceError(
                        f"{name}: inline section {key} declares artifact-only {field}"
                    )
            elements = from_inventory(
                section, witnesses, restricted, absences, options, library, name
            )
            section_exclusions = []
        else:
            raise SourceError(f"{name}: section {key} carries neither an artifact nor elements")
        for element in elements:
            if element["key"] in seen:
                raise SourceError(f"{name}: element key {element['key']} occurs twice")
            seen.add(element["key"])
        for exclusion in section_exclusions:
            if exclusion["key"] in seen_exclusions:
                raise SourceError(
                    f"{name}: exclusion key {exclusion['key']} occurs twice"
                )
            seen_exclusions.add(exclusion["key"])
            exclusions.append(exclusion)
        sections.append({"key": key, "name": section.get("name") or key, "elements": elements})

    slots = slot_table(source, sections, name)

    offered = {
        (entry["group"], option["id"])
        for entry in variants
        for option in entry["options"]
    }
    used = {
        (alternative["group"], alternative["option"])
        for section in sections
        for element in section["elements"]
        for alternative in element["alternatives"]
    }
    unused = offered - used
    if unused:
        group, option = sorted(unused)[0]
        raise SourceError(
            f"{name}: variant group {group} offers unused option {option}; a choice "
            "with no elements would select an empty rite"
        )

    total = sum(len(section["elements"]) for section in sections)
    held: dict[tuple[str, str], int] = {}
    by_lang: dict[str, int] = {}
    absent_counts: dict[str, int] = {}
    absent_by_lang: dict[str, dict[str, int]] = {}
    relation_counts: dict[tuple[str, str, str], int] = {}
    for section in sections:
        for element in section["elements"]:
            for translation in element["translations"] or []:
                reach = (translation["source_id"], translation["lang"])
                held[reach] = held.get(reach, 0) + 1
                by_lang[translation["lang"]] = by_lang.get(translation["lang"], 0) + 1
                relation = translation.get("relation")
                if relation not in RELATIONS:
                    raise SourceError(
                        f"{name}: element {element['key']} has untyped relation "
                        f"{relation!r} for {translation['lang']}"
                    )
                collation = (
                    translation.get("collation")
                    if relation == "antecedent"
                    else "not-applicable"
                )
                bucket = (translation["lang"], relation, collation)
                relation_counts[bucket] = relation_counts.get(bucket, 0) + 1
            for language in LANGUAGES:
                reason = element["absent"][language["absent"]]
                if reason:
                    absent_counts[reason] = absent_counts.get(reason, 0) + 1
                    by_reason = absent_by_lang.setdefault(reason, {})
                    by_reason[language["lang"]] = by_reason.get(language["lang"], 0) + 1

    manifest = sorted(
        (
            {
                "lang": entry["lang"],
                "source_id": identifier,
                "label": entry.get("label") or identifier,
                "rights": entry["rights"],
                "acknowledgement": entry.get("acknowledgement") or None,
                "caution": entry.get("caution") or None,
                "held": held.get((identifier, entry["lang"]), 0),
            }
            for (identifier, _), entry in witnesses.items()
        ),
        key=lambda row: (row["lang"], -row["held"], row["source_id"]),
    )

    absence_rows = [
        {
            "key": key,
            "count": absent_counts.get(key, 0),
            "state": absence_state(absences[key]["kind"]),
            "kind": absences[key]["kind"],
        }
        for key in sorted(absences)
    ]
    language_absences = [
        {
            "key": key,
            "lang": language["lang"],
            "count": absent_by_lang.get(key, {}).get(language["lang"], 0),
            "state": absence_state(absences[key]["kind"]),
            "kind": absences[key]["kind"],
        }
        for key in sorted(absences)
        for language in LANGUAGES
        if absent_by_lang.get(key, {}).get(language["lang"], 0) > 0
    ]
    language_coverage = [
        {
            "lang": language["lang"],
            "elements": total,
            "held": by_lang.get(language["lang"], 0),
            "missing": total - by_lang.get(language["lang"], 0),
            "absent": total - by_lang.get(language["lang"], 0),
        }
        for language in LANGUAGES
    ]
    relation_coverage = [
        {"lang": lang, "relation": relation, "collation": collation, "count": count}
        for (lang, relation, collation), count in sorted(relation_counts.items())
    ]
    for language in language_coverage:
        relation_total = sum(
            row["count"] for row in relation_coverage
            if row["lang"] == language["lang"]
        )
        absence_total = sum(
            row["count"] for row in language_absences
            if row["lang"] == language["lang"]
        )
        if relation_total != language["held"] or absence_total != language["missing"]:
            raise SourceError(
                f"{name}: {language['lang']} coverage does not partition its "
                "held and missing elements"
            )
    for absence in absence_rows:
        partitioned = sum(
            row["count"] for row in language_absences
            if row["key"] == absence["key"]
        )
        if partitioned != absence["count"]:
            raise SourceError(
                f"{name}: absence {absence['key']} count does not equal its "
                "language partition"
            )

    return {
        "schema": OUT_SCHEMA,
        "calendar": calendar,
        "edition": _calendars.index_header(CALENDARS, calendar, "edition"),
        "edition_short": _calendars.index_header(CALENDARS, calendar, "edition_short"),
        "title": source["title"],
        "advisory": source["advisory"],
        "derived_from": source["derived_from"],
        "slots_derived_from": source.get("slots_derived_from") or None,
        "absences": absence_rows,
        "language_absences": language_absences,
        "exclusions": sorted(exclusions, key=lambda row: row["key"]),
        # Every language this layer speaks of, whether or not this missal holds
        # a word of it, each carrying how many of its elements are reached and
        # which side of `absent` says why the rest are not. A page offering a
        # choice of language reads this: it is how the choice can include a
        # language that is entirely withheld and still say, at every element,
        # under what recorded reason.
        "languages": [
            one | {
                "held": by_lang.get(one["lang"], 0),
                "elements": total,
                "missing": total - by_lang.get(one["lang"], 0),
            }
            for one in LANGUAGES
        ],
        "language_coverage": language_coverage,
        "relation_coverage": relation_coverage,
        "variants": variants,
        "slots": slots,
        "translations": manifest,
        "sections": sections,
    }


def index_file(built: list[dict]) -> dict:
    return {
        "schema": OUT_SCHEMA,
        "path": "structure/ordinary/{calendar}.json",
        "calendars": [
            {
                "calendar": one["calendar"],
                "edition": one["edition"],
                "edition_short": one["edition_short"],
                "title": one["title"],
                "elements": sum(len(section["elements"]) for section in one["sections"]),
                "variants": [entry["group"] for entry in one["variants"]],
                "slots": len(one["slots"]),
            }
            for one in built
        ],
    }


def relative_paths(built: list[dict], whole: bool) -> dict[str, dict]:
    """The files a build would write.

    The index names every calendar, so it is written only when every calendar
    was built. A `--calendar` run that rewrote it would silently drop the
    calendars it did not look at, and a page discovering the set from one fetch
    would then be told they do not exist.
    """
    files = {"structure/ordinary/index.json": index_file(built)} if whole else {}
    for one in built:
        files["structure/ordinary/" + one["calendar"] + ".json"] = one
    return files


def refuse_symlink_output(root: Path, target: Path) -> None:
    """Never follow an owned output component outside the requested tree."""

    current = root
    if current.is_symlink():
        raise SourceError(f"output root is a symlink: {current}")
    for part in target.relative_to(root).parts:
        current = current / part
        if current.is_symlink():
            raise SourceError(f"Ordinary output path is a symlink: {current}")


def owned_orphans(out: Path, expected: set[str]) -> list[str]:
    """Unexpected generated Ordinary JSON, bounded to this tool's directory."""
    directory = out / "structure" / "ordinary"
    refuse_symlink_output(out, directory)
    if not directory.is_dir():
        return []
    found = []
    for path in directory.iterdir():
        if path.suffix != ".json" or not (path.is_file() or path.is_symlink()):
            continue
        relative = "structure/ordinary/" + path.name
        if relative not in expected:
            found.append(relative)
    return sorted(found)


def serialise(payload: dict) -> str:
    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"


def build(arguments: argparse.Namespace) -> list[dict]:
    sources = Path(arguments.root)
    library = artifact_records(sources)
    return [
        calendar_structure(sources, path, library)
        for path in inventories(sources, arguments.calendar)
    ]


def summarise(one: dict, stale: bool | None) -> dict:
    translated = sum(
        1 for section in one["sections"] for element in section["elements"] if element["translations"]
    )
    absent = sum(
        1
        for section in one["sections"]
        for element in section["elements"]
        if element["absent"]["english"]
    )
    return {
        "calendar": one["calendar"],
        "sections": len(one["sections"]),
        "elements": sum(len(section["elements"]) for section in one["sections"]),
        "witnesses": len(one["translations"]),
        "variants": len(one["variants"]),
        "slots": len(one["slots"]),
        "translated": translated,
        "absent": absent,
        "language_coverage": one["language_coverage"],
        "relation_coverage": one["relation_coverage"],
        "exclusions": len(one["exclusions"]),
        "stale": stale,
    }


QUALIFIED_PROPER = re.compile(r"^(.+?) \(.+\)$")


def proper_slot(slots: list[dict], name: str) -> int:
    """The browser's exact/explicitly-qualified slot lookup, in Python."""

    for ordinal, slot in enumerate(slots):
        if name in slot["propers"]:
            return ordinal
    qualified = QUALIFIED_PROPER.fullmatch(name)
    if qualified:
        family = qualified.group(1)
        for ordinal, slot in enumerate(slots):
            if slot.get("qualified") and family in slot["propers"]:
                return ordinal
    return -1


def effective_ordinary_frame(mass: dict, form: dict | None, where: str) -> dict:
    """One form's exact frame declaration; omission alone means full."""

    value = (
        form["ordinary_frame"]
        if form is not None and "ordinary_frame" in form
        else mass.get("ordinary_frame", {"applicability": "full"})
    )
    if not isinstance(value, dict):
        raise SourceError(f"{where}: ordinary_frame is not a mapping")
    unknown = sorted(set(value) - {"applicability", "basis"})
    if unknown:
        raise SourceError(
            f"{where}: ordinary_frame carries unknown fields {', '.join(unknown)}"
        )
    applicability = value.get("applicability")
    if applicability not in ("full", "none", "unavailable"):
        raise SourceError(
            f"{where}: ordinary_frame applicability must be full, none, or unavailable"
        )
    basis = value.get("basis")
    if applicability != "full" and (
        not isinstance(basis, str) or not basis.strip()
    ):
        raise SourceError(
            f"{where}: non-full ordinary_frame must carry a nonempty basis"
        )
    if "basis" in value and (not isinstance(basis, str) or not basis.strip()):
        raise SourceError(f"{where}: ordinary_frame basis must be a nonempty string")
    return value


def check_form_seating(
    ordinary: dict, propers: list[dict], where: str, *, full: bool
) -> None:
    """Refuse every row the browser could silently mis-seat or leave unseated.

    This intentionally repeats the small, closed seating derivation used by
    `ordinary-seating.js`.  It is a producer gate: generated Propers are checked
    against the newly built Ordinary even when the tracked Ordinary output is
    stale, so changing a slot cannot leave an old disposition looking current.
    """

    if not isinstance(propers, list) or any(not isinstance(row, dict) for row in propers):
        raise SourceError(f"{where}: propers must be an array of mappings")
    rows = [row for row in propers if row.get("name") != "Placeholder"]
    for row in rows:
        if not isinstance(row.get("name"), str) or not row["name"]:
            raise SourceError(f"{where}: a Proper has no nonempty name")

    source_problems = _calendars.ordinary_disposition_source_problems(
        where, "", rows
    )
    if source_problems:
        raise SourceError(source_problems[0])

    slots = ordinary["slots"]
    reached = -1
    seen_alternatives: set[str] = set()
    seen_unplaced: set[str] = set()
    index = 0
    while index < len(rows):
        proper = rows[index]
        disposition = proper.get(_calendars.ORDINARY_DISPOSITION)
        if disposition is None:
            if full:
                ordinal = proper_slot(slots, proper["name"])
                if ordinal < 0:
                    raise SourceError(
                        f"{where}: Proper {proper['name']!r} has no Ordinary seat "
                        "and no ordinary_disposition"
                    )
                if ordinal < reached:
                    raise SourceError(
                        f"{where}: Proper {proper['name']!r} runs backward from "
                        f"slot {reached} to slot {ordinal}"
                    )
                reached = ordinal
            index += 1
            continue

        try:
            disposition = _calendars.validate_ordinary_disposition(disposition)
        except ValueError as error:
            raise SourceError(f"{where}: Proper {proper['name']!r}: {error}") from error
        group = disposition["group"]
        if disposition["kind"] == "unplaced":
            if group in seen_alternatives:
                raise SourceError(
                    f"{where}: ordinary_disposition group {group!r} mixes kinds"
                )
            seen_unplaced.add(group)
            if full and proper_slot(slots, proper["name"]) >= 0:
                raise SourceError(
                    f"{where}: unplaced Proper {proper['name']!r} is stale because "
                    "a usable Ordinary slot now claims it"
                )
            index += 1
            continue

        if group in seen_alternatives or group in seen_unplaced:
            raise SourceError(
                f"{where}: alternative group {group!r} is not one contiguous source unit"
            )
        seen_alternatives.add(group)
        basis = disposition["basis"]
        options: set[str] = set()
        ordinals: set[int] = set()
        while index < len(rows):
            member = rows[index]
            held = member.get(_calendars.ORDINARY_DISPOSITION)
            if not isinstance(held, dict) or held.get("kind") != "alternative" \
                    or held.get("group") != group:
                break
            try:
                held = _calendars.validate_ordinary_disposition(held)
            except ValueError as error:
                raise SourceError(
                    f"{where}: Proper {member['name']!r}: {error}"
                ) from error
            if held["basis"] != basis:
                raise SourceError(
                    f"{where}: alternative group {group!r} does not retain one basis"
                )
            options.add(held["option"])
            if full:
                ordinal = proper_slot(slots, member["name"])
                if ordinal < 0:
                    raise SourceError(
                        f"{where}: alternative Proper {member['name']!r} has no "
                        "usable Ordinary seat"
                    )
                ordinals.add(ordinal)
            index += 1
        if len(options) < 2:
            raise SourceError(
                f"{where}: alternative group {group!r} has fewer than two options"
            )
        if full:
            if len(ordinals) != 1:
                raise SourceError(
                    f"{where}: alternative group {group!r} spans Ordinary slots "
                    f"{sorted(ordinals)}"
                )
            ordinal = next(iter(ordinals))
            if ordinal < reached:
                raise SourceError(
                    f"{where}: alternative group {group!r} runs backward from "
                    f"slot {reached} to slot {ordinal}"
                )
            reached = ordinal


def read_propers_structure(out: Path, calendar: str) -> dict:
    """Read one generated Propers file as a closed cross-layer input."""

    target = out / "structure" / "propers" / f"{calendar}.json"
    refuse_symlink_output(out, target)
    if not target.is_file():
        raise SourceError(f"missing generated Propers structure: {target}")
    try:
        payload = json.loads(target.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError) as error:
        raise SourceError(f"malformed generated Propers structure {target}: {error}") from error
    if not isinstance(payload, dict):
        raise SourceError(f"malformed generated Propers structure {target}: not an object")
    if payload.get("schema") != PROPERS_OUT_SCHEMA:
        raise SourceError(
            f"stale generated Propers structure {target}: expected schema "
            f"{PROPERS_OUT_SCHEMA!r}"
        )
    if payload.get("calendar") != calendar:
        raise SourceError(
            f"stale generated Propers structure {target}: calendar is "
            f"{payload.get('calendar')!r}"
        )
    if not isinstance(payload.get("masses"), list):
        raise SourceError(f"malformed generated Propers structure {target}: masses is not an array")
    return payload


def check_calendar_seating(ordinary: dict, propers_file: dict) -> dict:
    """Check every exact public formulary and report the checked partition."""

    calendar = ordinary["calendar"]
    full_forms = 0
    nonfull_forms = 0
    seen_masses: set[str] = set()
    for mass in propers_file["masses"]:
        if not isinstance(mass, dict):
            raise SourceError(f"{calendar}: a generated mass is not a mapping")
        key = mass.get("key")
        if not isinstance(key, str) or not key or key in seen_masses:
            raise SourceError(f"{calendar}: generated mass key {key!r} is empty or repeated")
        seen_masses.add(key)
        forms = mass.get("forms")
        if forms is not None and (
            not isinstance(forms, list) or any(not isinstance(form, dict) for form in forms)
        ):
            raise SourceError(f"{calendar}/{key}: forms is not an array of mappings")
        units = [(form, form.get("propers")) for form in forms] if forms else [
            (None, mass.get("propers"))
        ]
        seen_forms: set[str] = set()
        for form, propers in units:
            form_id = "main" if form is None else form.get("id")
            if not isinstance(form_id, str) or not form_id or form_id in seen_forms:
                raise SourceError(
                    f"{calendar}/{key}: generated form id {form_id!r} is empty or repeated"
                )
            seen_forms.add(form_id)
            where = f"{calendar}/{key}/{form_id}"
            frame = effective_ordinary_frame(mass, form, where)
            full = frame["applicability"] == "full"
            check_form_seating(ordinary, propers, where, full=full)
            if full:
                full_forms += 1
            else:
                nonfull_forms += 1
    return {
        "calendar": calendar,
        "full_forms": full_forms,
        "nonfull_forms": nonfull_forms,
        "failures": 0,
    }


# --------------------------------------------------------------- verbs


def run_check(arguments: argparse.Namespace) -> dict:
    out = Path(arguments.out)
    refuse_symlink_output(out, out / "structure" / "ordinary")
    built = build(arguments)
    files = relative_paths(built, arguments.calendar is None)
    stale = []
    for relative, payload in files.items():
        target = out / relative
        refuse_symlink_output(out, target)
        current = target.read_text(encoding="utf-8") if target.is_file() else None
        if current != serialise(payload):
            stale.append(relative)
    if arguments.calendar is None:
        stale.extend(owned_orphans(out, set(files)))
    seating = [
        check_calendar_seating(one, read_propers_structure(out, one["calendar"]))
        for one in built
    ]
    return {
        "calendars": [
            summarise(one, "structure/ordinary/" + one["calendar"] + ".json" in stale)
            for one in built
        ],
        "stale": sorted(stale),
        "seating": {
            "calendars": seating,
            "full_forms": sum(row["full_forms"] for row in seating),
            "nonfull_forms": sum(row["nonfull_forms"] for row in seating),
            "failures": 0,
        },
    }


def run_structure(arguments: argparse.Namespace) -> dict:
    out = Path(arguments.out)
    refuse_symlink_output(out, out / "structure" / "ordinary")
    built = build(arguments)
    files = relative_paths(built, arguments.calendar is None)
    written = []
    for relative, payload in sorted(files.items()):
        target = out / relative
        refuse_symlink_output(out, target)
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(serialise(payload), encoding="utf-8")
        written.append(str(target))
    removed = []
    if arguments.calendar is None:
        for relative in owned_orphans(out, set(files)):
            target = out / relative
            target.unlink()
            removed.append(str(target))
    return {
        "calendars": [summarise(one, False) for one in built],
        "written": written,
        "removed": removed,
    }


def run_show(arguments: argparse.Namespace) -> dict:
    """The assembled Ordinary itself, for reading rather than for the browser.

    `structure` writes this same assembly to disk and `check` counts it; this
    verb is the one that prints it, so that the text a reader sees at a
    terminal and the text the browser renders come from one derivation.
    An element the sources do not reach is still listed, carrying the reason
    it is absent: a silent gap would read as a Mass that omits the prayer.
    """
    return {"ordinary": build(arguments)}


def selected_variants(built: list[dict], requested: list[str]) -> dict[str, dict[str, str]]:
    """One selected option per group, with source order supplying defaults."""
    offered: dict[str, str] = {}
    for ordinary in built:
        for group in ordinary["variants"]:
            for option in group["options"]:
                identifier = option["id"]
                if identifier in offered and offered[identifier] != group["group"]:
                    raise SourceError(
                        f"variant option {identifier} belongs to more than one group"
                    )
                offered[identifier] = group["group"]
    overrides = {}
    for option in requested:
        group = offered.get(option)
        if group is None:
            raise SourceError(f"no variant option {option!r} in the selected Ordinary")
        if group in overrides and overrides[group] != option:
            raise SourceError(
                f"variant group {group} was given both {overrides[group]!r} and {option!r}"
            )
        overrides[group] = option

    selections = {}
    for ordinary in built:
        selected = {
            group["group"]: next(
                option["id"] for option in group["options"] if option["default"]
            )
            for group in ordinary["variants"]
        }
        for group, option in overrides.items():
            if group in selected:
                selected[group] = option
        selections[ordinary["calendar"]] = selected
    return selections


def element_applicability(element: dict, selected: dict[str, str]) -> tuple[bool, list[dict]]:
    """Filter closed choices and retain unknown context as visible state."""
    if any(
        selected.get(alternative["group"]) != alternative["option"]
        for alternative in element.get("alternatives") or []
    ):
        return False, []
    unresolved = []
    for condition in element.get("conditions") or []:
        if condition["kind"] == "omit-when-option":
            if selected.get(condition["group"]) in condition["options"]:
                return False, []
        elif condition["kind"] == "include-when-any":
            # `show` has no day/rank/preface context.  Unknown applicability is
            # a first-class result, never a reason to include or omit silently.
            unresolved.append(condition)
        else:  # generated input should make this unreachable; stay fail-closed.
            raise SourceError(
                f"element {element['key']} has unknown generated condition "
                f"{condition['kind']!r}"
            )
    return not unresolved, unresolved


def render_ordinary(
    built: list[dict],
    lang: str,
    verbose: bool,
    style: Style,
    show_rubrics: bool = True,
    requested_variants: list[str] | None = None,
) -> int:
    """The Ordinary, with every element set as what its kind says it is.

    It was set as one undifferentiated column, and the maintainer found what
    that costs at the Placeat: two rubrics — "Bowing before the Altar, the
    Priest says" and "Turning himself towards the People, he gives them his
    Blessing" — sat at the same indent in the same face as the prayer between
    them, and read as its first and last lines. Nothing was wrong with the
    data; every one of those is its own element correctly carrying `kind:
    rubric`. The distinction is drawn in `scripts/_ordinary_text.py`, once, for
    this tool and for the expanded daily-Mass renderer alike.
    """
    selections = selected_variants(built, requested_variants or [])
    for one in built:
        selected = selections[one["calendar"]]
        for line in style.heading(one["title"], rule="="):
            print(line)
        if one.get("edition"):
            print(f"  {one['edition']}")
        for section in one["sections"]:
            print("")
            for line in style.heading(str(section["name"]), rule="-"):
                print(line)
            for element in section["elements"]:
                visible, unresolved = element_applicability(element, selected)
                for condition in unresolved:
                    predicates = ", ".join(condition["predicates"])
                    print(
                        f"  [{element.get('name') or element['key']}: "
                        f"applicability unresolved: {predicates}; "
                        f"{condition['basis']}]"
                    )
                if not visible:
                    continue
                for line in element_lines(
                    element, lang, style, indent="  ",
                    show_rubrics=show_rubrics, why=verbose,
                ):
                    print(line)
        if verbose:
            print(f"\n  {one['advisory']}")
    return 0


def wrap_text(text: str, indent: str) -> list[str]:
    out: list[str] = []
    for paragraph in str(text).strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if block:
            out.extend(textwrap.wrap(block, 88 - len(indent)))
            out.append("")
    return [indent + line if line else "" for line in (out[:-1] or out)]


def run_coverage(arguments: argparse.Namespace) -> dict:
    built = build(arguments)
    rows = []
    for one in built:
        rows.append(
            {
                "calendar": one["calendar"],
                "elements": sum(len(section["elements"]) for section in one["sections"]),
                "witnesses": one["translations"],
                "language_coverage": one["language_coverage"],
                "relation_coverage": one["relation_coverage"],
                "absent": one["absences"],
                "language_absences": one["language_absences"],
                "exclusions": one["exclusions"],
            }
        )
    return {"coverage": rows}


def render(payload: dict, arguments: argparse.Namespace) -> int:
    if getattr(arguments, "json", False) or arguments.format == "json":
        print_json(payload)
        return 1 if payload.get("stale") else 0
    if arguments.format == "yaml":
        import yaml

        print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
        return 1 if payload.get("stale") else 0
    if "ordinary" in payload:
        return render_ordinary(
            payload["ordinary"],
            arguments.lang,
            arguments.verbose,
            getattr(arguments, "style_resolved", None) or Style(),
            getattr(arguments, "rubrics", True),
            getattr(arguments, "variant", None),
        )
    if "coverage" in payload:
        for row in payload["coverage"]:
            print(f"{row['calendar']}: {row['elements']} elements")
            for language in row["language_coverage"]:
                print(
                    f"  {language['lang']} coverage: {language['held']} held, "
                    f"{language['missing']} missing"
                )
            for relation in row["relation_coverage"]:
                print(
                    f"  {relation['lang']} provenance: {relation['relation']}/"
                    f"{relation['collation']} {relation['count']}"
                )
            for witness in row["witnesses"]:
                print(
                    f"  {witness['lang']}  {witness['source_id']}  "
                    f"{witness['held']} elements  {witness['rights']}"
                )
            if row["absent"]:
                named = ", ".join(
                    f"{one['key']} {one['count']} {one['state']}/{one['kind']}"
                    for one in row["absent"]
                )
                print(f"  absent: {named}")
            if row["exclusions"]:
                named = ", ".join(one["key"] for one in row["exclusions"])
                print(f"  target-recension exclusions: {named}")
        return 0
    for row in payload["calendars"]:
        languages = ", ".join(
            f"{one['lang']} {one['held']} held/{one['missing']} missing"
            for one in row["language_coverage"]
        )
        relations = ", ".join(
            f"{one['lang']} {one['relation']}/{one['collation']} {one['count']}"
            for one in row["relation_coverage"]
        ) or "none"
        print(
            f"{row['calendar']}: {row['sections']} sections, {row['elements']} elements, "
            f"{row['witnesses']} witness{'' if row['witnesses'] == 1 else 'es'}, "
            f"{row['variants']} variants, {row['slots']} slots; {languages}; "
            f"relations {relations}; {row['exclusions']} target-recension exclusions"
        )
    if "written" in payload:
        print(f"wrote {len(payload['written'])} files")
        if arguments.verbose:
            for path in payload["written"]:
                print(f"  -> {path}")
        else:
            print(f"  -> {payload['written'][0]}")
        return 0
    stale = payload["stale"]
    print(f"{len(stale)} files would be rewritten" if stale else "the written files are current")
    return 1 if stale else 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_SOURCES), help="the source library root")
    shared.add_argument("--out", default=str(DEFAULT_DATA), help="the browser's data root")
    shared.add_argument("--calendar", default=None, help="limit to one calendar")
    shared.add_argument("--format", choices=("text", "yaml", "json"), default="text")
    shared.add_argument(
        "--lang",
        default="en",
        choices=[one["lang"] for one in LANGUAGES],
        help="`show`: which language to print (default: en)",
    )
    shared.add_argument("--verbose", action="store_true", help="list every file written")
    shared.add_argument(
        "--no-rubrics",
        dest="rubrics",
        action="store_false",
        default=True,
        help="`show`: hide the priest's actions, printing only what is said",
    )
    shared.add_argument(
        "--variant",
        action="append",
        default=[],
        metavar="OPTION",
        help="`show`: select a nondefault option; repeat for independent groups",
    )
    shared.add_argument("--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)")
    parser = argparse.ArgumentParser(
        prog="mass-ordinary",
        description="Assemble the Ordinary of the Mass for the browser, under its rights.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "mass-ordinary")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="validate the inventories and report a stale --out", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("structure", help="write the browser's ordinary files", parents=[shared]),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser("coverage", help="report what each witness reaches and what is absent", parents=[shared]),
        EXAMPLES["coverage"],
    )
    with_examples(
        sub.add_parser("show", help="print the Ordinary itself", parents=[shared]),
        EXAMPLES["show"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={
            "check": run_check,
            "structure": run_structure,
            "coverage": run_coverage,
            "show": run_show,
        },
        renderer=render,
        prefix="mass-ordinary",
        argv=argv,
        default_verb="check",
        mapped_errors={SourceError: ("input", 2), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
