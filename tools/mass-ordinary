RELATIONS = ("own", "antecedent")
COLLATIONS = ("collated", "uncollated")
NEEDS_RELATION_NOTE = ("antecedent",)


class SourceError(ValueError):
    """An ordinary source that cannot be trusted to emit anything."""


def language_row(lang: str) -> dict:
    """The declared language `lang`, or a refusal naming what is on offer."""
    for one in LANGUAGES:
        if one["lang"] == lang:
            return one
    offered = ", ".join(one["lang"] for one in LANGUAGES)
    raise SourceError(f"no language {lang!r} in this layer; it holds {offered}")


# --------------------------------------------------------------- reading


def inventories(root: Path, calendar: str | None) -> list[Path]:
    found = sorted((root / "inventories").glob("*" + INVENTORY_SUFFIX))
    if calendar:
        found = [one for one in found if one.name == calendar + INVENTORY_SUFFIX]
        if not found:
            raise SourceError(f"no ordo-missae inventory for calendar {calendar!r}")
    if not found:
        raise SourceError(f"no ordo-missae inventory under {root / 'inventories'}")
    return found


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except tomllib.TOMLDecodeError as error:
        raise SourceError(f"{path.name}: cannot parse TOML: {error}") from error


def artifact_records(root: Path) -> dict[str, dict]:
    """Every artifact manifest in the library, by id.

    Read whole rather than by guessed path: an artifact's id does not encode
    where it lives, and a lookup that reconstructed the path would silently
    stop finding a record that moved.
    """
    held: dict[str, dict] = {}
    for path in (root / "works").rglob("artifact.toml"):
        data = read_toml(path)
        identifier = data.get("id")
        if isinstance(identifier, str):
            data["_path"] = path
            held[identifier] = data
    return held


def payload_rows(record: dict) -> list[dict]:
    """The TSV an artifact manifest declares, as rows keyed by column name."""
    relative = record.get("path")
    if not isinstance(relative, str):
        raise SourceError(f"{record['id']}: artifact declares no payload path")
    path = ROOT / relative
    if not path.is_file():
        raise SourceError(f"{record['id']}: payload missing at {relative}")
    with path.open(encoding="utf-8", newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    if not rows:
        raise SourceError(f"{record['id']}: payload has no data rows")
    return rows


# --------------------------------------------------------------- witnesses


def witness_table(source: dict, library: dict[str, dict], name: str) -> dict[str, dict]:
    """The witnesses this inventory may draw text from, checked against the library.

    A witness is declared here and recorded there, and the two must agree. The
    check is not ceremony: `rights` is what decides whether a text reaches the
    world, and a value typed into an inventory beside the text it licenses is
    exactly the copy that drifts.
    """
    held: dict[tuple[str, str], dict] = {}
    for entry in source.get("witnesses") or []:
        identifier = entry.get("id")
        if not isinstance(identifier, str) or not identifier:
            raise SourceError(f"{name}: a witness has no id")
        # Keyed by (id, lang), because one printing may witness two languages:
        # the 1861 Cummiskey sets Latin and English in facing columns and both
        # are that edition's own text. `source_id` reaches the page as
        # attribution and must name the real edition record, so minting a
        # second id for the Latin would misattribute it.
        language = entry.get("lang")
        if not isinstance(language, str) or not language:
            raise SourceError(f"{name}: witness {identifier} declares no lang")
        if (identifier, language) in held:
            raise SourceError(
                f"{name}: witness {identifier} is declared twice for {language}"
            )
        rights = entry.get("rights")
        if rights not in PUBLISHABLE_RIGHTS:
            raise SourceError(
                f"{name}: witness {identifier} declares rights {rights!r}; "
                f"this tool publishes only {', '.join(PUBLISHABLE_RIGHTS)}"
            )
        if rights in NEEDS_ACKNOWLEDGEMENT and not entry.get("acknowledgement"):
            raise SourceError(
                f"{name}: witness {identifier} is {rights} and carries no "
                "acknowledgement; the licence that makes it free requires one"
            )
        for artifact_id in entry.get("artifacts") or []:
            record = library.get(artifact_id)
            if record is None:
                raise SourceError(f"{name}: witness {identifier} names unknown artifact {artifact_id}")
            recorded = record.get("rights_status")
            if recorded not in LIBRARY_RIGHTS[rights]:
                raise SourceError(
                    f"{name}: witness {identifier} declares {rights!r} but "
                    f"{artifact_id} is recorded as {recorded!r} in the source library"
                )
        held[(identifier, language)] = dict(entry)
    if not held:
        raise SourceError(f"{name}: no witness is declared")
    return held


# Why a text is not here, as a value a renderer can read rather than prose it
# would have to parse. The three are genuinely different states and a reader
# owes the difference to whoever is looking at the empty place:
#   witness-gap     the source this project holds does not print it
#   rights-withheld a rightsholder has reserved this use
#   no-exemplar     the use is permitted and no exact copy of the words is
#                   reachable, so the gap is an acquisition and not a refusal
# The distinction is not academic. This inventory said for a year that ICEL's
# licence forbade the use; it does not, and the true reason was always that
# nobody here has the book. One of those is answered by asking permission and
# the other by finding a copy.
ABSENCE_KINDS = ("witness-gap", "rights-withheld", "no-exemplar")


def absence_table(source: dict, name: str) -> dict[str, dict]:
    held: dict[str, dict] = {}
    for entry in source.get("absences") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an absence has no key")
        if not entry.get("what"):
            raise SourceError(f"{name}: absence {key} says nothing about why")
        kind = entry.get("kind")
        if kind not in ABSENCE_KINDS:
            raise SourceError(
                f"{name}: absence {key} declares kind {kind!r}; "
                f"one of {', '.join(ABSENCE_KINDS)} is required"
            )
        held[key] = dict(entry)
    return held


def variant_table(source: dict, name: str) -> tuple[list[dict], dict[str, str]]:
    """The choices the celebrant makes, and which option each variant element sits under.

    Returned flat as well as nested, because an element names its option and the
    join has to refuse an option no group offers rather than emit an element the
    browser can never show.
    """
    groups = []
    options: dict[str, str] = {}
    for entry in source.get("variants") or []:
        group = entry.get("group")
        if not isinstance(group, str) or not group:
            raise SourceError(f"{name}: a variant group has no id")
        listed = entry.get("options") or []
        if len(listed) < 2:
            raise SourceError(f"{name}: variant group {group} offers fewer than two options")
        defaults = [one for one in listed if one.get("default")]
        if len(defaults) != 1:
            raise SourceError(
                f"{name}: variant group {group} must mark exactly one option default, not {len(defaults)}"
            )
        for option in listed:
            identifier = option.get("id")
            if not isinstance(identifier, str) or not identifier:
                raise SourceError(f"{name}: an option of {group} has no id")
            if identifier in options:
                raise SourceError(f"{name}: option {identifier} is declared twice")
            options[identifier] = group
        groups.append(dict(entry))
    return groups, options


def slot_table(source: dict, sections: list[dict], name: str) -> list[dict]:
    """Where the day's propers sit in this frame, checked against the elements.

    Every check below exists because the failure it catches is silent. An
    anchor that no longer names an element would drop a proper off the page
    with nothing raised; two slots claiming one proper name would leave a page
    to choose, and it would choose consistently and possibly wrongly; and slots
    that run backwards against the elements would put the Gospel before the
    Epistle while every file still validated.
    """
    order = {}
    variant_of = {}
    for section in sections:
        for element in section["elements"]:
            order[element["key"]] = len(order)
            variant_of[element["key"]] = element["variant"]

    held: list[dict] = []
    claimed: dict[str, str] = {}
    seen: set[str] = set()
    reached = -1
    for entry in source.get("slots") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: a slot has no key")
        if key in seen:
            raise SourceError(f"{name}: slot {key} is declared twice")
        seen.add(key)
        sides = [one for one in SLOT_SIDES if entry.get(one)]
        if len(sides) != 1:
            raise SourceError(
                f"{name}: slot {key} must name exactly one of "
                f"{' or '.join(SLOT_SIDES)}, not {len(sides)}"
            )
        side = sides[0]
        anchor = entry[side]
        if anchor not in order:
            raise SourceError(f"{name}: slot {key} anchors to {anchor!r}, which is no element of this file")
        if variant_of[anchor] is not None:
            raise SourceError(
                f"{name}: slot {key} anchors to {anchor!r}, which shows only under "
                f"option {variant_of[anchor]!r}; a seat that disappears with a choice "
                "of prayer would drop the proper it holds"
            )
        propers = entry.get("propers") or []
        if not propers:
            raise SourceError(f"{name}: slot {key} receives no proper")
        for proper in propers:
            if not isinstance(proper, str) or not proper:
                raise SourceError(f"{name}: slot {key} names an empty proper")
            if proper in claimed:
                raise SourceError(
                    f"{name}: slots {claimed[proper]} and {key} both claim the "
                    f"proper {proper!r}; one proper has one seat"
                )
            claimed[proper] = key
        if not entry.get("locus"):
            raise SourceError(
                f"{name}: slot {key} cites no locus; a placement nobody can look up "
                "is a placement nobody can refute"
            )
        # An `after` seats the proper one place further on than a `before` on
        # the same element, which is what makes two slots on neighbouring
        # elements resolve to one position without either being ambiguous.
        at = order[anchor] + (1 if side == "after" else 0)
        if at < reached:
            raise SourceError(
                f"{name}: slot {key} sits before the slot declared above it; "
                "the slots are the order of the rite and must run forward"
            )
        reached = at
        held.append(
            {
                "key": key,
                "anchor": anchor,
                "where": side,
                "propers": list(propers),
                "qualified": bool(entry.get("qualified")),
                "locus": entry["locus"],
            }
        )
    if held and not source.get("slots_derived_from"):
        raise SourceError(
            f"{name}: slots are declared and slots_derived_from is not; a placement "
            "must say which book it was read from"
        )
    return held


# --------------------------------------------------------------- elements


def absent_pair(holder: dict, fallback: dict, absences: dict, key: str, name: str) -> dict:
    """Which of an element's two texts is missing, and under which recorded reason.

    Two texts, two reasons, and the difference is the whole point: a reader must
    be able to tell English that is absent because a licence withholds it from
    English that is absent because nobody has transcribed it yet. Collapsing
    both into one "missing" would hide exactly the distinction this layer exists
    to make visible.
    """
    out = {}
    for side in ABSENT_SIDES:
        field = "absent_" + side
        reason = holder.get(field, fallback.get(field))
        if reason is not None and reason not in absences:
            raise SourceError(f"{name}: {key} names absence {reason!r}, which the file does not state")
        out[side] = reason
    return out



def latin_side(
    section: dict, witnesses: dict, library: dict, name: str
) -> tuple[dict[str, dict], dict | None, str | None]:
    """The section's Latin rows, keyed by element, or nothing where it has none.

    The 1861 printing sets Latin and English in facing columns, and until this
    existed only the English column could reach a page: `from_artifact` built an
    element's text from one column and `absent["latin"]` was always the
    section's reason, so `--lang la` could print nothing but the absence however
    much Latin the project held.

    A row with an empty `latin` field is refused rather than skipped. Absence is
    carried by NOT having a row, so an empty one is a row that should not exist,
    and letting it pass would turn a transcription gap into a silent blank.
    """
    artifact_id = section.get("artifact_latin")
    if not artifact_id:
        return {}, None, None
    witness_id = section.get("witness_latin") or section.get("witness")
    witness = witnesses.get((witness_id, "la"))
    if witness is None:
        raise SourceError(
            f"{name}: section {section['key']} draws Latin from {witness_id!r}, "
            "which is not declared as a witness for la"
        )
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for la; the rights check would not have covered it"
        )
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    rows: dict[str, dict] = {}
    for row in payload_rows(record):
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        if key in rows:
            raise SourceError(f"{artifact_id}: element {key} appears twice")
        if not (row.get("latin") or "").strip():
            raise SourceError(
                f"{artifact_id}: row {key} carries no Latin; a section states an "
                "absence once and an empty row states it nowhere"
            )
        rows[key] = {"latin": (row.get("latin") or "").strip()}
    return rows, witness, witness_id


def from_artifact(section: dict, witnesses: dict, absences: dict, library: dict, name: str) -> list[dict]:
    """The elements of a section whose text an artifact holds.

    Nothing about order, part, kind, speaker or wording is restated in the
    inventory: every one of them is read from the artifact's own row, which is
    the row that carries the hash.
    """
    artifact_id = section["artifact"]
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    witness_id = section.get("witness")
    witness = witnesses.get((witness_id, "en"))
    if witness is None:
        raise SourceError(f"{name}: section {section['key']} names undeclared witness {witness_id!r}")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list; the rights check would not have covered it"
        )
    latin_rows, latin_witness, latin_id = latin_side(section, witnesses, library, name)

    elements = []
    for row in payload_rows(record):
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        kind = (row.get("kind") or "").strip()
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{artifact_id}: row {key} has kind {kind!r}")
        english = (row.get("english") or "").strip()
        incipit = (row.get("latin_incipit") or "").strip()
        latin = (latin_rows.pop(key, {}) or {}).get("latin", "")
        absent = absent_pair({}, section, absences, key, name)
        if english:
            absent["english"] = None
        elif absent["english"] is None:
            raise SourceError(
                f"{artifact_id}: row {key} has no English and its section names no "
                "reason; a silent gap is the one thing this layer must never emit"
            )
        if latin:
            absent["latin"] = None
        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": (row.get("speaker") or "").strip() or None,
                "name": incipit or None,
                "latin_incipit": incipit or None,
                "locus": (row.get("printed_page") or "").strip() or None,
                "note": (row.get("notes") or "").strip() or None,
                "variant": None,
                "absent": absent,
                "translations": (
                    [
                        {
                            "lang": witness["lang"],
                            "source_id": witness_id,
                            "rights": witness["rights"],
                            "text": english,
                        }
                    ]
                    if english
                    else []
                )
                + (
                    [
                        {
                            "lang": latin_witness["lang"],
                            "source_id": latin_id,
                            "rights": latin_witness["rights"],
                            "text": latin,
                        }
                    ]
                    if latin
                    else []
                )
                or None,
            }
        )
    if latin_rows:
        raise SourceError(
            f"{name}: section {section['key']} carries Latin for "
            f"{', '.join(sorted(latin_rows))}, which its English artifact does not hold"
        )
    return elements


def artifact_text(library: dict, artifact_id: str, element: str, name: str,
                  column: str = "text") -> str:
    """One artifact element's words, out of the column that holds them.

    The column is named because the library does not use one name. The ELLC
    common texts carry `text`; the 1861 facing-column artifacts carry `latin`,
    beside the `seq`, `part`, `printed_page`, `ia_leaf` and `notes` that make
    the row checkable against the leaf. Guessing `text` on those raised nothing
    useful --- it raised KeyError from inside a dict comprehension --- so the
    column is declared by the block that draws on the artifact and refused here
    when the artifact does not have it.

    An empty cell is refused rather than joined. Absence is carried by NOT
    having a row, so an empty one is a row that should not exist, and letting it
    through would turn a transcription gap into a silent blank under a heading
    that names a missal.
    """
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: unknown artifact {artifact_id}")
    lines = []
    for row in payload_rows(record):
        if (row.get("element_key") or "").strip() != element:
            continue
        if column not in row:
            raise SourceError(
                f"{name}: {artifact_id} has no column {column!r}; it carries "
                f"{', '.join(sorted(one for one in row if one))}"
            )
        line = (row[column] or "").strip()
        if not line:
            raise SourceError(
                f"{name}: {artifact_id} row {element!r} carries nothing in "
                f"{column!r}; an absence is stated once and an empty cell states it nowhere"
            )
        lines.append(line)
    if not lines:
        raise SourceError(f"{name}: {artifact_id} holds no element {element!r}")
    return "\n".join(lines)


def relation_of(block: dict, key: str, lang: str, name: str) -> dict:
    """What this element is doing with that book, and what has been established.

    Declared per element and never on the witness, because it is a relation
    between two texts and not a property of a printing --- there is no
    antecedent edition of anything. The propers file records what happened when
    the two were run together into one invented witness id: it resolved nowhere,
    and 63 translations served under a bare dotted id with no label and no
    caution.
    """
    relation = block.get("relation")
    if relation is None:
        return {}
    if relation not in RELATIONS:
        raise SourceError(
            f"{name}: element {key} declares relation {relation!r} for {lang}; "
            f"one of {', '.join(RELATIONS)} is required"
        )
    if relation not in NEEDS_RELATION_NOTE:
        return {"relation": relation}
    collation = block.get("collation")
    if collation not in COLLATIONS:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and declares "
            f"collation {collation!r}; one of {', '.join(COLLATIONS)} is required, "
            "because an established identity and an unestablished one must not look the same"
        )
    note = (block.get("note") or "").strip()
    if not note:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and states no note; "
            "a relation nobody can check is a claim nobody made"
        )
    out = {"relation": relation, "collation": collation, "note": note}
    finding = (block.get("collation_finding") or "").strip()
    if collation == "collated":
        if not finding:
            raise SourceError(
                f"{name}: element {key} claims a collated identity for {lang} and "
                "cites no finding; the grade would be an assertion, which is the "
                "one thing the other grade exists to be distinguished from"
            )
        out["collation_finding"] = finding
    elif finding:
        raise SourceError(
            f"{name}: element {key} is uncollated for {lang} and cites "
            f"{finding!r}; a citation on an uncollated row invites the reader to "
            "read it as the collation that was not made"
        )
    return out


def side_text(entry: dict, lang: str, witnesses: dict, library: dict,
              key: str, name: str) -> dict | None:
    """One element's text in one language, from whichever edition holds it.

    Resolved identically for both languages. What differs between them is
    declared in the block --- the witness, the artifact, which of its elements,
    and the column --- and never inferred from which language is being asked
    for, so that adding the Latin could not quietly change what the English did.
    """
    block = entry.get(SIDE_BLOCKS[lang])
    if not block:
        return None
    witness_id = block.get("witness")
    witness = witnesses.get((witness_id, lang))
    if witness is None:
        raise SourceError(
            f"{name}: element {key} names undeclared witness {witness_id!r} for {lang}"
        )
    artifact_id = block.get("artifact")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: element {key} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for {lang}; the rights check would not "
            "have covered it"
        )
    # A list, because the granularity of a book is not the granularity of an
    # element. The Missal sets the Creed as one text where the 1861 sets it as
    # three, and the join has to be stated in the file rather than worked out by
    # anything downstream.
    named = block.get("elements") or ([block["element"]] if block.get("element") else [])
    if not named:
        raise SourceError(f"{name}: element {key} names no artifact element for {lang}")
    column = block.get("column") or "text"
    return {
        "lang": lang,
        "source_id": witness_id,
        "rights": witness["rights"],
        "text": "\n".join(
            artifact_text(library, artifact_id, one, name, column) for one in named
        ),
    } | relation_of(block, key, lang, name)


def from_inventory(section: dict, witnesses: dict, absences: dict, options: dict,
                   library: dict, name: str) -> list[dict]:
    """The elements of a section the inventory states itself.

    Used where no artifact of the rite's own text exists to draw on. The
    inventory may still not hold a prayer: it holds the element's identity, its
    received Latin incipit, and either a licensed text drawn from an artifact or
    a named reason for the absence.
    """
    elements = []
    for entry in section.get("elements") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an element of {section['key']} has no key")
        kind = entry.get("kind")
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{name}: element {key} has kind {kind!r}")
        variant = entry.get("variant")
        if variant is not None and variant not in options:
            raise SourceError(f"{name}: element {key} names option {variant!r}, which no variant group offers")

        held = [
            row
            for row in (
                side_text(entry, language["lang"], witnesses, library, key, name)
                for language in LANGUAGES
            )
            if row
        ]
        translations = held or None

        absent = absent_pair(entry, section, absences, key, name)
        # Per language, not per element. The refusal below used to be checked
        # for English alone, which was right while English was the only side an
        # element could carry: an element with a Latin text and no English and
        # no reason would have passed it silently, and a silent gap under a
        # heading naming a missal reads as a rite that omits the prayer.
        for language in LANGUAGES:
            reached = any(row["lang"] == language["lang"] for row in held)
            if reached:
                absent[language["absent"]] = None
            elif absent[language["absent"]] is None:
                raise SourceError(
                    f"{name}: element {key} carries no {language['lang']} text and "
                    "names no absence; a silent gap is the one thing this layer "
                    "must never emit"
                )

        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": entry.get("speaker") or None,
                "name": entry.get("name") or entry.get("latin_incipit") or None,
                "latin_incipit": entry.get("latin_incipit") or None,
                "locus": entry.get("missal_number") or None,
                "note": entry.get("note") or None,
                "variant": variant,
                "absent": absent,
                "translations": translations,
            }
        )
    return elements


# --------------------------------------------------------------- assembly


def calendar_structure(sources: Path, path: Path, library: dict[str, dict]) -> dict:
    name = path.name
    source = read_toml(path)
    for field in REQUIRED_TOP:
        if field not in source:
            raise SourceError(f"{name}: missing required field {field!r}")
    if source["schema"] != SCHEMA:
        raise SourceError(f"{name}: schema is {source['schema']!r}, expected {SCHEMA!r}")
    calendar = source["calendar"]
    if name != calendar + INVENTORY_SUFFIX:
        raise SourceError(f"{name}: declares calendar {calendar!r}, which its filename does not match")

    # The book's identity belongs to the mass index that transcribes it, and is
    # read from there rather than retyped here --- the same rule the rubrics
    # sources are held to, for the same reason.
    for field in _calendars.INDEX_OWNED:
        if field in source:
            raise SourceError(
                f"{name}: {field} belongs to the calendar's mass index and must not be restated here"
            )

    witnesses = witness_table(source, library, name)
    absences = absence_table(source, name)
    variants, options = variant_table(source, name)

    sections = []
    seen: set[str] = set()
    for section in source["sections"]:
        key = section.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: a section has no key")
        if "artifact" in section and "elements" in section:
            raise SourceError(f"{name}: section {key} names both an artifact and inline elements")
        if "artifact" in section:
            elements = from_artifact(section, witnesses, absences, library, name)
        elif "elements" in section:
            elements = from_inventory(section, witnesses, absences, options, library, name)
        else:
            raise SourceError(f"{name}: section {key} carries neither an artifact nor elements")
        for element in elements:
            if element["key"] in seen:
                raise SourceError(f"{name}: element key {element['key']} occurs twice")
            seen.add(element["key"])
        sections.append({"key": key, "name": section.get("name") or key, "elements": elements})

    slots = slot_table(source, sections, name)

    total = sum(len(section["elements"]) for section in sections)
    held: dict[tuple[str, str], int] = {}
    by_lang: dict[str, int] = {}
    absent_counts: dict[str, int] = {}
    for section in sections:
        for element in section["elements"]:
            for translation in element["translations"] or []:
                reach = (translation["source_id"], translation["lang"])
                held[reach] = held.get(reach, 0) + 1
                by_lang[translation["lang"]] = by_lang.get(translation["lang"], 0) + 1
            for reason in element["absent"].values():
                if reason:
                    absent_counts[reason] = absent_counts.get(reason, 0) + 1

    manifest = sorted(
        (
            {
                "lang": entry["lang"],
                "source_id": identifier,
                "label": entry.get("label") or identifier,
                "rights": entry["rights"],
                "acknowledgement": entry.get("acknowledgement") or None,
                "caution": entry.get("caution") or None,
                "held": held.get((identifier, entry["lang"]), 0),
            }
            for (identifier, _), entry in witnesses.items()
        ),
        key=lambda row: (row["lang"], -row["held"], row["source_id"]),
    )

    return {
        "schema": OUT_SCHEMA,
        "calendar": calendar,
        "edition": _calendars.index_header(CALENDARS, calendar, "edition"),
        "edition_short": _calendars.index_header(CALENDARS, calendar, "edition_short"),
        "title": source["title"],
        "advisory": source["advisory"],
        "derived_from": source["derived_from"],
        "slots_derived_from": source.get("slots_derived_from") or None,
        "absences": [absences[key] | {"count": absent_counts.get(key, 0)} for key in sorted(absences)],
        # Every language this layer speaks of, whether or not this missal holds
        # a word of it, each carrying how many of its elements are reached and
        # which side of `absent` says why the rest are not. A page offering a
        # choice of language reads this: it is how the choice can include a
        # language that is entirely withheld and still say, at every element,
        # under what recorded reason.
        "languages": [
            one | {"held": by_lang.get(one["lang"], 0), "elements": total}
            for one in LANGUAGES
        ],
        "variants": variants,
        "slots": slots,
        "translations": manifest,
        "sections": sections,
    }


def index_file(built: list[dict]) -> dict:
    return {
        "schema": OUT_SCHEMA,
        "path": "structure/ordinary/{calendar}.json",
        "calendars": [
            {
                "calendar": one["calendar"],
                "edition": one["edition"],
                "edition_short": one["edition_short"],
                "title": one["title"],
                "elements": sum(len(section["elements"]) for section in one["sections"]),
                "variants": [entry["group"] for entry in one["variants"]],
                "slots": len(one["slots"]),
            }
            for one in built
        ],
    }


def relative_paths(built: list[dict], whole: bool) -> dict[str, dict]:
    """The files a build would write.

    The index names every calendar, so it is written only when every calendar
    was built. A `--calendar` run that rewrote it would silently drop the
    calendars it did not look at, and a page discovering the set from one fetch
    would then be told they do not exist.
    """
    files = {"structure/ordinary/index.json": index_file(built)} if whole else {}
    for one in built:
        files["structure/ordinary/" + one["calendar"] + ".json"] = one
    return files


def serialise(payload: dict) -> str:
    return json.dumps(payload, ensure_ascii=False, sort_keys=True, separators=(",", ":")) + "\n"


def build(arguments: argparse.Namespace) -> list[dict]:
    sources = Path(arguments.root)
    library = artifact_records(sources)
    return [
        calendar_structure(sources, path, library)
        for path in inventories(sources, arguments.calendar)
    ]


def summarise(one: dict, stale: bool | None) -> dict:
    translated = sum(
        1 for section in one["sections"] for element in section["elements"] if element["translations"]
    )
    absent = sum(
        1
        for section in one["sections"]
        for element in section["elements"]
        if element["absent"]["english"]
    )
    return {
        "calendar": one["calendar"],
        "sections": len(one["sections"]),
        "elements": sum(len(section["elements"]) for section in one["sections"]),
        "witnesses": len(one["translations"]),
        "variants": len(one["variants"]),
        "slots": len(one["slots"]),
        "translated": translated,
        "absent": absent,
        "stale": stale,
    }


# --------------------------------------------------------------- verbs


def run_check(arguments: argparse.Namespace) -> dict:
    built = build(arguments)
    out = Path(arguments.out)
    stale = []
    for relative, payload in relative_paths(built, arguments.calendar is None).items():
        target = out / relative
        current = target.read_text(encoding="utf-8") if target.is_file() else None
        if current != serialise(payload):
            stale.append(relative)
    return {
        "calendars": [
            summarise(one, "structure/ordinary/" + one["calendar"] + ".json" in stale)
            for one in built
        ],
        "stale": sorted(stale),
    }


def run_structure(arguments: argparse.Namespace) -> dict:
    built = build(arguments)
    out = Path(arguments.out)
    written = []
    for relative, payload in sorted(relative_paths(built, arguments.calendar is None).items()):
        target = out / relative
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(serialise(payload), encoding="utf-8")
        written.append(str(target))
    return {"calendars": [summarise(one, False) for one in built], "written": written}


def run_show(arguments: argparse.Namespace) -> dict:
    """The assembled Ordinary itself, for reading rather than for the browser.

    `structure` writes this same assembly to disk and `check` counts it; this
    verb is the one that prints it, so that the text a reader sees at a
    terminal and the text the browser renders come from one derivation.
    An element the sources do not reach is still listed, carrying the reason
    it is absent: a silent gap would read as a Mass that omits the prayer.
    """
    return {"ordinary": build(arguments)}


def render_ordinary(
    built: list[dict],
    lang: str,
    verbose: bool,
    style: Style,
    show_rubrics: bool = True,
) -> int:
    """The Ordinary, with every element set as what its kind says it is.

    It was set as one undifferentiated column, and the maintainer found what
    that costs at the Placeat: two rubrics — "Bowing before the Altar, the
    Priest says" and "Turning himself towards the People, he gives them his
    Blessing" — sat at the same indent in the same face as the prayer between
    them, and read as its first and last lines. Nothing was wrong with the
    data; every one of those is its own element correctly carrying `kind:
    rubric`. The distinction is drawn in `scripts/_ordinary_text.py`, once, for
    this tool and for `mass-today --expanded` alike.
    """
    for one in built:
        for line in style.heading(one["title"], rule="="):
            print(line)
        if one.get("edition"):
            print(f"  {one['edition']}")
        for section in one["sections"]:
            print("")
            for line in style.heading(str(section["name"]), rule="-"):
                print(line)
            for element in section["elements"]:
                for line in element_lines(
                    element, lang, style, indent="  ",
                    show_rubrics=show_rubrics, why=verbose,
                ):
                    print(line)
        if verbose:
            print(f"\n  {one['advisory']}")
    return 0


def wrap_text(text: str, indent: str) -> list[str]:
    out: list[str] = []
    for paragraph in str(text).strip().split("\n\n"):
        block = " ".join(paragraph.split())
        if block:
            out.extend(textwrap.wrap(block, 88 - len(indent)))
            out.append("")
    return [indent + line if line else "" for line in (out[:-1] or out)]


def run_coverage(arguments: argparse.Namespace) -> dict:
    built = build(arguments)
    rows = []
    for one in built:
        absent: dict[str, int] = {}
        for section in one["sections"]:
            for element in section["elements"]:
                for reason in element["absent"].values():
                    if reason:
                        absent[reason] = absent.get(reason, 0) + 1
        rows.append(
            {
                "calendar": one["calendar"],
                "elements": sum(len(section["elements"]) for section in one["sections"]),
                "witnesses": one["translations"],
                "absent": [{"key": key, "count": absent[key]} for key in sorted(absent)],
            }
        )
    return {"coverage": rows}


def render(payload: dict, arguments: argparse.Namespace) -> int:
    if getattr(arguments, "json", False) or arguments.format == "json":
        print_json(payload)
        return 0
    if arguments.format == "yaml":
        import yaml

        print(yaml.safe_dump(payload, sort_keys=False, allow_unicode=True).rstrip())
        return 0
    if "ordinary" in payload:
        return render_ordinary(
            payload["ordinary"],
            arguments.lang,
            arguments.verbose,
            getattr(arguments, "style_resolved", None) or Style(),
            getattr(arguments, "rubrics", True),
        )
    if "coverage" in payload:
        for row in payload["coverage"]:
            print(f"{row['calendar']}: {row['elements']} elements")
            for witness in row["witnesses"]:
                print(
                    f"  {witness['lang']}  {witness['source_id']}  "
                    f"{witness['held']} elements  {witness['rights']}"
                )
            if row["absent"]:
                named = ", ".join(f"{one['key']} {one['count']}" for one in row["absent"])
                print(f"  absent: {named}")
        return 0
    for row in payload["calendars"]:
        print(
            f"{row['calendar']}: {row['sections']} sections, {row['elements']} elements, "
            f"{row['witnesses']} witness{'' if row['witnesses'] == 1 else 'es'}, "
            f"{row['variants']} variants, {row['slots']} slots; "
            f"{row['translated']} elements translated, {row['absent']} absent"
        )
    if "written" in payload:
        print(f"wrote {len(payload['written'])} files")
        if arguments.verbose:
            for path in payload["written"]:
                print(f"  -> {path}")
        else:
            print(f"  -> {payload['written'][0]}")
        return 0
    stale = payload["stale"]
    print(f"{len(stale)} files would be rewritten" if stale else "the written files are current")
    return 0


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--root", default=str(DEFAULT_SOURCES), help="the source library root")
    shared.add_argument("--out", default=str(DEFAULT_DATA), help="the browser's data root")
    shared.add_argument("--calendar", default=None, help="limit to one calendar")
    shared.add_argument("--format", choices=("text", "yaml", "json"), default="text")
    shared.add_argument(
        "--lang",
        default="en",
        choices=[one["lang"] for one in LANGUAGES],
        help="`show`: which language to print (default: en)",
    )
    shared.add_argument("--verbose", action="store_true", help="list every file written")
    shared.add_argument(
        "--no-rubrics",
        dest="rubrics",
        action="store_false",
        default=True,
        help="`show`: hide the priest's actions, printing only what is said",
    )
    shared.add_argument("--json", action="store_true", help="emit one compact key-sorted JSON object (cli-v1)")
    parser = argparse.ArgumentParser(
        prog="mass-ordinary",
        description="Assemble the Ordinary of the Mass for the browser, under its rights.",
        parents=[shared],
    )
    examples_live_on_the_verbs(parser, "mass-ordinary")
    sub = parser.add_subparsers(dest="command")
    with_examples(
        sub.add_parser("check", help="validate the inventories and report a stale --out", parents=[shared]),
        EXAMPLES["check"],
    )
    with_examples(
        sub.add_parser("structure", help="write the browser's ordinary files", parents=[shared]),
        EXAMPLES["structure"],
    )
    with_examples(
        sub.add_parser("coverage", help="report what each witness reaches and what is absent", parents=[shared]),
        EXAMPLES["coverage"],
    )
    with_examples(
        sub.add_parser("show", help="print the Ordinary itself", parents=[shared]),
        EXAMPLES["show"],
    )

    return run_verb_cli(
        parser=parser,
        handlers={
            "check": run_check,
            "structure": run_structure,
            "coverage": run_coverage,
            "show": run_show,
        },
        renderer=render,
        prefix="mass-ordinary",
        argv=argv,
        default_verb="check",
        mapped_errors={SourceError: ("input", 2), ValueError: ("input", 2)},
    )


if __name__ == "__main__":
    raise SystemExit(main())
