class SourceError(ValueError):
    """An ordinary source that cannot be trusted to emit anything."""


def language_row(lang: str) -> dict:
    """The declared language `lang`, or a refusal naming what is on offer."""
    for one in LANGUAGES:
        if one["lang"] == lang:
            return one
    offered = ", ".join(one["lang"] for one in LANGUAGES)
    raise SourceError(f"no language {lang!r} in this layer; it holds {offered}")


# --------------------------------------------------------------- reading


def inventories(root: Path, calendar: str | None) -> list[Path]:
    found = sorted((root / "inventories").glob("*" + INVENTORY_SUFFIX))
    if calendar:
        found = [one for one in found if one.name == calendar + INVENTORY_SUFFIX]
        if not found:
            raise SourceError(f"no ordo-missae inventory for calendar {calendar!r}")
    if not found:
        raise SourceError(f"no ordo-missae inventory under {root / 'inventories'}")
    return found


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except tomllib.TOMLDecodeError as error:
        raise SourceError(f"{path.name}: cannot parse TOML: {error}") from error


def artifact_records(root: Path) -> dict[str, dict]:
    """Every artifact manifest in the library, by id.

    Read whole rather than by guessed path: an artifact's id does not encode
    where it lives, and a lookup that reconstructed the path would silently
    stop finding a record that moved.
    """
    held: dict[str, dict] = {}
    for path in (root / "works").rglob("artifact.toml"):
        data = read_toml(path)
        identifier = data.get("id")
        if isinstance(identifier, str):
            data["_path"] = path
            data["_source_root"] = root.resolve()
            held[identifier] = data
    return held


def payload_rows(record: dict) -> list[dict]:
    """The TSV an artifact manifest declares, as rows keyed by column name."""
    relative = record.get("path")
    if not isinstance(relative, str):
        raise SourceError(f"{record['id']}: artifact declares no payload path")
    source_root = record.get("_source_root")
    if not isinstance(source_root, Path):
        raise SourceError(
            f"{record['id']}: artifact record has no source-library root"
        )
    relative_path = Path(relative)
    if relative_path.is_absolute():
        raise SourceError(f"{record['id']}: payload path must be relative: {relative}")
    parts = relative_path.parts
    if parts[:2] == ("src", "sources"):
        parts = parts[2:]
    path = source_root.joinpath(*parts).resolve()
    if not path.is_relative_to(source_root):
        raise SourceError(f"{record['id']}: payload path escapes the source library: {relative}")
    if not path.is_file():
        raise SourceError(f"{record['id']}: payload missing at {relative}")
    with path.open(encoding="utf-8", newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    if not rows:
        raise SourceError(f"{record['id']}: payload has no data rows")
    return rows


# --------------------------------------------------------------- witnesses


def restricted_witness_table(
    source: dict, library: dict[str, dict], name: str
) -> dict[tuple[str, str], dict]:
    """Validate text-free source metadata this generator must never publish.

    A restricted witness is intentionally kept outside `witness_table`: it is
    neither eligible for a text join nor copied into the generated translation
    manifest.  Its artifacts must already be quarantined in the source library
    so an inventory cannot get ahead of the payload removal it claims.
    """
    held: dict[tuple[str, str], dict] = {}
    for entry in source.get("restricted_witnesses") or []:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: a restricted witness is not a table")
        unknown = set(entry) - RESTRICTED_WITNESS_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: a restricted witness declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        identifier = entry.get("id")
        if not isinstance(identifier, str) or not identifier:
            raise SourceError(f"{name}: a restricted witness has no id")
        language = entry.get("lang")
        if not isinstance(language, str) or not language:
            raise SourceError(
                f"{name}: restricted witness {identifier} declares no lang"
            )
        language_row(language)
        reach = (identifier, language)
        if reach in held:
            raise SourceError(
                f"{name}: restricted witness {identifier} is declared twice for {language}"
            )
        if entry.get("state") != RESTRICTED_WITNESS_STATE:
            raise SourceError(
                f"{name}: restricted witness {identifier} must declare "
                f"state = {RESTRICTED_WITNESS_STATE!r}"
            )
        if entry.get("acknowledgement") != ICEL_EXCERPT_ACKNOWLEDGEMENT:
            raise SourceError(
                f"{name}: restricted witness {identifier} does not carry ICEL's "
                "exact prescribed excerpt acknowledgement"
            )
        artifacts = entry.get("artifacts")
        if (
            not isinstance(artifacts, list)
            or not artifacts
            or any(not isinstance(one, str) or not one for one in artifacts)
            or len(artifacts) != len(set(artifacts))
        ):
            raise SourceError(
                f"{name}: restricted witness {identifier} needs a nonempty, "
                "duplicate-free artifact id array"
            )
        for artifact_id in artifacts:
            record = library.get(artifact_id)
            if record is None:
                raise SourceError(
                    f"{name}: restricted witness {identifier} names unknown "
                    f"artifact {artifact_id}"
                )
            if record.get("rights_status") not in RESTRICTED_ARTIFACT_RIGHTS:
                raise SourceError(
                    f"{name}: restricted witness {identifier} is rights-restricted "
                    f"but {artifact_id} has rights_status "
                    f"{record.get('rights_status')!r}; one of "
                    f"{', '.join(RESTRICTED_ARTIFACT_RIGHTS)} is required"
                )
            if (
                record.get("storage") != RESTRICTED_ARTIFACT_STORAGE
                or "path" in record
                or record.get("indexable") is not False
            ):
                raise SourceError(
                    f"{name}: restricted witness {identifier} names {artifact_id}, "
                    "whose artifact record is not text-free restricted storage"
                )
        held[reach] = dict(entry)
    return held


def witness_table(source: dict, library: dict[str, dict], name: str) -> dict[str, dict]:
    """The witnesses this inventory may draw text from, checked against the library.

    A witness is declared here and recorded there, and the two must agree. The
    check is not ceremony: `rights` is what decides whether a text reaches the
    world, and a value typed into an inventory beside the text it licenses is
    exactly the copy that drifts.
    """
    held: dict[tuple[str, str], dict] = {}
    for entry in source.get("witnesses") or []:
        identifier = entry.get("id")
        if not isinstance(identifier, str) or not identifier:
            raise SourceError(f"{name}: a witness has no id")
        # Keyed by (id, lang), because one printing may witness two languages:
        # the 1861 Cummiskey sets Latin and English in facing columns and both
        # are that edition's own text. `source_id` reaches the page as
        # attribution and must name the real edition record, so minting a
        # second id for the Latin would misattribute it.
        language = entry.get("lang")
        if not isinstance(language, str) or not language:
            raise SourceError(f"{name}: witness {identifier} declares no lang")
        if (identifier, language) in held:
            raise SourceError(
                f"{name}: witness {identifier} is declared twice for {language}"
            )
        rights = entry.get("rights")
        if rights not in PUBLISHABLE_RIGHTS:
            raise SourceError(
                f"{name}: witness {identifier} declares rights {rights!r}; "
                f"this tool publishes only {', '.join(PUBLISHABLE_RIGHTS)}"
            )
        for artifact_id in entry.get("artifacts") or []:
            record = library.get(artifact_id)
            if record is None:
                raise SourceError(f"{name}: witness {identifier} names unknown artifact {artifact_id}")
            recorded = record.get("rights_status")
            if recorded not in LIBRARY_RIGHTS[rights]:
                raise SourceError(
                    f"{name}: witness {identifier} declares {rights!r} but "
                    f"{artifact_id} is recorded as {recorded!r} in the source library"
                )
        held[(identifier, language)] = dict(entry)
    if not held:
        raise SourceError(f"{name}: no witness is declared")
    return held


# Why a text is not here, as a value a renderer can read rather than prose it
# would have to parse. The acquisition, publication, and modelling states are
# deliberately disjoint:
#   witness-gap     a held or registered source has no joined usable payload
#   rights-withheld this distribution surface has no recorded authorization
#   rights-unresolved whether this surface may publish has not been established
#   no-exemplar     no exact authoritative exemplar is registered
#   model-gap       the element spans independently sourceable matter
#   outside-layer   the assigned text belongs to another data layer
#   not-applicable  the element has no fixed text at this layer
# A proper assigned in another layer and an action with no fixed text are not
# missing witnesses, while a composite span cannot be repaired merely by
# acquiring another page.
ABSENCE_KINDS = (
    "witness-gap",
    "rights-withheld",
    "rights-unresolved",
    "no-exemplar",
    "model-gap",
    "outside-layer",
    "not-applicable",
)

ABSENCE_STATES = {
    "rights-withheld": "rights-restricted",
    "rights-unresolved": "unresolved",
}


def absence_state(kind: str) -> str:
    """Public capability state for one closed absence kind."""
    return ABSENCE_STATES.get(kind, "unavailable")


def absence_table(source: dict, name: str) -> dict[str, dict]:
    held: dict[str, dict] = {}
    for entry in source.get("absences") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an absence has no key")
        if key in held:
            raise SourceError(f"{name}: absence {key} is declared twice")
        if not entry.get("what"):
            raise SourceError(f"{name}: absence {key} says nothing about why")
        kind = entry.get("kind")
        if kind not in ABSENCE_KINDS:
            raise SourceError(
                f"{name}: absence {key} declares kind {kind!r}; "
                f"one of {', '.join(ABSENCE_KINDS)} is required"
            )
        held[key] = dict(entry)
    return held


def variant_table(source: dict, name: str) -> tuple[list[dict], dict[str, str]]:
    """The choices the celebrant makes, and which option each variant element sits under.

    Returned flat as well as nested, because an element names its option and the
    join has to refuse an option no group offers rather than emit an element the
    browser can never show.
    """
    groups = []
    options: dict[str, str] = {}
    seen_groups: set[str] = set()
    for entry in source.get("variants") or []:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: a variant group is not a table")
        unknown = set(entry) - VARIANT_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: a variant group declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        group = entry.get("group")
        if not isinstance(group, str) or not group:
            raise SourceError(f"{name}: a variant group has no id")
        if group in seen_groups:
            raise SourceError(f"{name}: variant group {group} is declared twice")
        seen_groups.add(group)
        if not isinstance(entry.get("name"), str) or not entry["name"].strip():
            raise SourceError(f"{name}: variant group {group} has no name")
        if not isinstance(entry.get("what"), str) or not entry["what"].strip():
            raise SourceError(f"{name}: variant group {group} says nothing about the choice")
        listed = entry.get("options") or []
        if not isinstance(listed, list):
            raise SourceError(f"{name}: variant group {group} options are not an array")
        if len(listed) < 2:
            raise SourceError(f"{name}: variant group {group} offers fewer than two options")
        for option in listed:
            if not isinstance(option, dict):
                raise SourceError(f"{name}: an option of {group} is not a table")
            unknown = set(option) - VARIANT_OPTION_FIELDS
            if unknown:
                raise SourceError(
                    f"{name}: an option of {group} declares unknown fields "
                    f"{', '.join(sorted(unknown))}"
                )
            if not isinstance(option.get("default"), bool):
                raise SourceError(
                    f"{name}: an option of {group} must declare boolean default"
                )
            if not isinstance(option.get("name"), str) or not option["name"].strip():
                raise SourceError(f"{name}: an option of {group} has no name")
        defaults = [one for one in listed if one["default"]]
        if len(defaults) != 1:
            raise SourceError(
                f"{name}: variant group {group} must mark exactly one option default, not {len(defaults)}"
            )
        for option in listed:
            identifier = option.get("id")
            if not isinstance(identifier, str) or not identifier:
                raise SourceError(f"{name}: an option of {group} has no id")
            if identifier in options:
                raise SourceError(f"{name}: option {identifier} is declared twice")
            options[identifier] = group
        groups.append(dict(entry) | {"mode": "one-of"})
    return groups, options


def element_alternatives(entry: dict, options: dict[str, str], key: str,
                         name: str) -> tuple[str | None, list[dict]]:
    """One element's exact memberships in independently selected groups."""
    legacy = entry.get("variant")
    declared = entry.get("alternatives")
    if legacy is not None and declared is not None:
        raise SourceError(
            f"{name}: element {key} declares both legacy variant and alternatives"
        )
    if legacy is not None:
        if legacy not in options:
            raise SourceError(
                f"{name}: element {key} names option {legacy!r}, which no "
                "variant group offers"
            )
        return legacy, [{"group": options[legacy], "option": legacy}]
    if declared is None:
        return None, []
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: element {key} has empty or malformed alternatives")
    held = []
    groups = set()
    for alternative in declared:
        if not isinstance(alternative, dict):
            raise SourceError(f"{name}: element {key} has a non-table alternative")
        unknown = set(alternative) - ALTERNATIVE_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: element {key} alternative declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        group = alternative.get("group")
        option = alternative.get("option")
        if not isinstance(group, str) or not group:
            raise SourceError(f"{name}: element {key} alternative has no group")
        if not isinstance(option, str) or not option:
            raise SourceError(f"{name}: element {key} alternative has no option")
        if options.get(option) != group:
            raise SourceError(
                f"{name}: element {key} puts option {option!r} under group "
                f"{group!r}, but that group does not offer it"
            )
        if group in groups:
            raise SourceError(
                f"{name}: element {key} belongs to variant group {group} more than once"
            )
        groups.add(group)
        held.append({"group": group, "option": option})
    return None, held


def element_conditions(entry: dict, options: dict[str, str], key: str,
                       name: str) -> list[dict]:
    """Closed positive/context conditions; never executable inventory prose."""
    declared = entry.get("conditions")
    if declared is None:
        return []
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: element {key} has empty or malformed conditions")
    held = []
    for condition in declared:
        if not isinstance(condition, dict):
            raise SourceError(f"{name}: element {key} has a non-table condition")
        kind = condition.get("kind")
        fields = CONDITION_FIELDS.get(kind)
        if fields is None:
            raise SourceError(
                f"{name}: element {key} condition has kind {kind!r}; one of "
                f"{', '.join(CONDITION_FIELDS)} is required"
            )
        unknown = set(condition) - fields
        missing = fields - set(condition)
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: element {key} {kind} condition has {'; '.join(detail)}"
            )
        basis = condition.get("basis")
        if not isinstance(basis, str) or not basis.strip():
            raise SourceError(f"{name}: element {key} {kind} condition has no basis")
        if kind == "include-when-any":
            predicates = condition["predicates"]
            if (
                not isinstance(predicates, list)
                or not predicates
                or any(one not in CONDITION_PREDICATES for one in predicates)
                or len(predicates) != len(set(predicates))
            ):
                raise SourceError(
                    f"{name}: element {key} include-when-any predicates must be a "
                    "nonempty duplicate-free subset of the closed predicate table"
                )
        else:
            group = condition["group"]
            selected = condition["options"]
            if not isinstance(group, str) or not group:
                raise SourceError(
                    f"{name}: element {key} omit-when-option condition has no group"
                )
            if (
                not isinstance(selected, list)
                or not selected
                or any(options.get(one) != group for one in selected)
                or len(selected) != len(set(selected))
            ):
                raise SourceError(
                    f"{name}: element {key} omit-when-option options must be a "
                    "nonempty duplicate-free subset of the named group's options"
                )
        held.append(dict(condition) | {"unknown": "unresolved"})
    return held


def slot_table(source: dict, sections: list[dict], name: str) -> list[dict]:
    """Where the day's propers sit in this frame, checked against the elements.

    Every check below exists because the failure it catches is silent. An
    anchor that no longer names an element would drop a proper off the page
    with nothing raised; two slots claiming one proper name would leave a page
    to choose, and it would choose consistently and possibly wrongly; and slots
    that run backwards against the elements would put the Gospel before the
    Epistle while every file still validated.
    """
    order = {}
    alternatives_of = {}
    for section in sections:
        for element in section["elements"]:
            order[element["key"]] = len(order)
            alternatives_of[element["key"]] = element.get("alternatives") or []

    held: list[dict] = []
    claimed: dict[str, str] = {}
    seen: set[str] = set()
    reached = -1
    for entry in source.get("slots") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: a slot has no key")
        if key in seen:
            raise SourceError(f"{name}: slot {key} is declared twice")
        seen.add(key)
        sides = [one for one in SLOT_SIDES if entry.get(one)]
        if len(sides) != 1:
            raise SourceError(
                f"{name}: slot {key} must name exactly one of "
                f"{' or '.join(SLOT_SIDES)}, not {len(sides)}"
            )
        side = sides[0]
        anchor = entry[side]
        if anchor not in order:
            raise SourceError(f"{name}: slot {key} anchors to {anchor!r}, which is no element of this file")
        if alternatives_of[anchor]:
            choices = ", ".join(
                f"{one['group']}={one['option']}" for one in alternatives_of[anchor]
            )
            raise SourceError(
                f"{name}: slot {key} anchors to {anchor!r}, which shows only under "
                f"choice {choices}; a seat that disappears with a choice "
                "of prayer would drop the proper it holds"
            )
        propers = entry.get("propers") or []
        if not propers:
            raise SourceError(f"{name}: slot {key} receives no proper")
        for proper in propers:
            if not isinstance(proper, str) or not proper:
                raise SourceError(f"{name}: slot {key} names an empty proper")
            if proper in claimed:
                raise SourceError(
                    f"{name}: slots {claimed[proper]} and {key} both claim the "
                    f"proper {proper!r}; one proper has one seat"
                )
            claimed[proper] = key
        if not entry.get("locus"):
            raise SourceError(
                f"{name}: slot {key} cites no locus; a placement nobody can look up "
                "is a placement nobody can refute"
            )
        # An `after` seats the proper one place further on than a `before` on
        # the same element, which is what makes two slots on neighbouring
        # elements resolve to one position without either being ambiguous.
        at = order[anchor] + (1 if side == "after" else 0)
        if at < reached:
            raise SourceError(
                f"{name}: slot {key} sits before the slot declared above it; "
                "the slots are the order of the rite and must run forward"
            )
        reached = at
        held.append(
            {
                "key": key,
                "anchor": anchor,
                "where": side,
                "propers": list(propers),
                "qualified": bool(entry.get("qualified")),
                "locus": entry["locus"],
            }
        )
    if held and not source.get("slots_derived_from"):
        raise SourceError(
            f"{name}: slots are declared and slots_derived_from is not; a placement "
            "must say which book it was read from"
        )
    return held


# --------------------------------------------------------------- elements


def absent_pair(holder: dict, fallback: dict, absences: dict, key: str, name: str) -> dict:
    """Which of an element's two texts is missing, and under which recorded reason.

    Two texts, two reasons, and the difference is the whole point: a reader must
    be able to tell English that is absent because a licence withholds it from
    English that is absent because nobody has transcribed it yet. Collapsing
    both into one "missing" would hide exactly the distinction this layer exists
    to make visible.
    """
    out = {}
    for side in ABSENT_SIDES:
        field = "absent_" + side
        reason = holder.get(field, fallback.get(field))
        if reason is not None and reason not in absences:
            raise SourceError(f"{name}: {key} names absence {reason!r}, which the file does not state")
        out[side] = reason
    return out



def latin_side(
    section: dict, witnesses: dict, restricted: dict, library: dict, name: str
) -> tuple[dict[str, dict], dict | None, str | None]:
    """The section's Latin rows, keyed by element, or nothing where it has none.

    The 1861 printing sets Latin and English in facing columns, and until this
    existed only the English column could reach a page: `from_artifact` built an
    element's text from one column and `absent["latin"]` was always the
    section's reason, so `--lang la` could print nothing but the absence however
    much Latin the project held.

    A row with an empty `latin` field is refused rather than skipped. Absence is
    carried by NOT having a row, so an empty one is a row that should not exist,
    and letting it pass would turn a transcription gap into a silent blank.
    """
    artifact_id = section.get("artifact_latin")
    if not artifact_id:
        return {}, None, None
    witness_id = section.get("witness_latin") or section.get("witness")
    if (witness_id, "la") in restricted:
        raise SourceError(
            f"{name}: section {section['key']} attempts a Latin text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, "la"))
    if witness is None:
        raise SourceError(
            f"{name}: section {section['key']} draws Latin from {witness_id!r}, "
            "which is not declared as a witness for la"
        )
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for la; the rights check would not have covered it"
        )
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    grouped: dict[str, list[str]] = {}
    for row in payload_rows(record):
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        if not (row.get("latin") or "").strip():
            raise SourceError(
                f"{artifact_id}: row {key} carries no Latin; a section states an "
                "absence once and an empty row states it nowhere"
            )
        grouped.setdefault(key, []).append((row.get("latin") or "").strip())
    rows = {key: {"latin": "\n".join(lines)} for key, lines in grouped.items()}
    return rows, witness, witness_id


def artifact_provenance(section: dict, lang: str, key: str, name: str) -> dict:
    """The explicit text-to-edition relation for one artifact-backed side.

    Artifact-backed sections select their text at section granularity, so their
    provenance declaration lives there too.  It remains language-local: facing
    columns share row keys, not necessarily a relationship to the edition named
    by the calendar.  Requiring even `own` to be written prevents a missing
    declaration from silently becoming an identity claim.
    """
    side = SIDE_BLOCKS[lang]
    block = section.get(side)
    if not isinstance(block, dict):
        raise SourceError(
            f"{name}: section {section['key']} carries {lang} artifact text but "
            f"declares no [{side}] provenance block"
        )
    unknown = set(block) - ARTIFACT_PROVENANCE_FIELDS
    if unknown:
        raise SourceError(
            f"{name}: section {section['key']} [{side}] provenance declares "
            f"unknown fields {', '.join(sorted(unknown))}"
        )
    if block.get("relation") is None:
        raise SourceError(
            f"{name}: section {section['key']} [{side}] provenance declares no "
            "relation; artifact-backed text must state own or antecedent explicitly"
        )
    relation = relation_of(block, key, lang, name)
    if block["relation"] == "own":
        extras = set(block) - {"relation"}
        if extras:
            raise SourceError(
                f"{name}: section {section['key']} [{side}] relation is own but "
                f"also declares {', '.join(sorted(extras))}"
            )
    return relation


def artifact_exclusion_table(section: dict, source_keys: set[str],
                             name: str) -> dict[str, str]:
    """Target-recension nonmembers explicitly named from artifact row ids."""
    declared = section.get("exclusions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed exclusions"
        )
    held = {}
    for exclusion in declared:
        if not isinstance(exclusion, dict):
            raise SourceError(
                f"{name}: section {section['key']} has a non-table exclusion"
            )
        unknown = set(exclusion) - EXCLUSION_FIELDS
        missing = EXCLUSION_FIELDS - set(exclusion)
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: section {section['key']} exclusion has {'; '.join(detail)}"
            )
        element = exclusion["element"]
        basis = exclusion["basis"]
        if not isinstance(element, str) or not element:
            raise SourceError(f"{name}: section {section['key']} exclusion has no element")
        if element in held:
            raise SourceError(
                f"{name}: section {section['key']} excludes {element} twice"
            )
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} excludes {element!r}, which its "
                "English artifact does not hold"
            )
        if not isinstance(basis, str) or not basis.strip():
            raise SourceError(
                f"{name}: section {section['key']} exclusion {element} has no basis"
            )
        held[element] = basis
    return held


def artifact_latin_absence_overrides(
    section: dict, source_keys: set[str], latin_keys: set[str],
    absences: dict, name: str,
) -> dict[str, str]:
    """Inventory-owned absence classifications for English artifact rows.

    The source artifacts own the blocks they print.  Why one of those blocks
    has no facing Latin is a later finding and therefore stays in the inventory.
    Excluded target-recension rows may still be classified here: the override
    accounts for the source witness, while the exclusion separately prevents
    that source row from being emitted as target text.
    """
    declared = section.get("absent_latin_by_element")
    if declared is None:
        return {}
    if not isinstance(declared, dict) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed "
            "absent_latin_by_element"
        )
    held: dict[str, str] = {}
    for element, reason in declared.items():
        if not isinstance(element, str) or not element:
            raise SourceError(
                f"{name}: section {section['key']} has an empty Latin absence "
                "override key"
            )
        if not isinstance(reason, str) or not reason.strip():
            raise SourceError(
                f"{name}: section {section['key']} Latin absence override for "
                f"{element} has no reason"
            )
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} overrides Latin absence for "
                f"{element!r}, which its English artifact does not hold"
            )
        if element in latin_keys:
            raise SourceError(
                f"{name}: section {section['key']} overrides Latin absence for "
                f"{element!r}, whose Latin artifact already holds text"
            )
        if reason not in absences:
            raise SourceError(
                f"{name}: section {section['key']} Latin absence override for "
                f"{element} names {reason!r}, which the file does not state"
            )
        held[element] = reason
    return held


def artifact_turn_partition_table(section: dict, name: str) -> dict[tuple[str, str], list]:
    """Optional language-local partitions, addressed only by source row seq."""
    declared = section.get("turn_partitions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed turn_partitions"
        )
    held = {}
    for partition in declared:
        if not isinstance(partition, dict):
            raise SourceError(
                f"{name}: section {section['key']} has a non-table turn partition"
            )
        unknown = set(partition) - TURN_PARTITION_FIELDS
        missing = TURN_PARTITION_FIELDS - set(partition)
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: section {section['key']} turn partition has "
                f"{'; '.join(detail)}"
            )
        element = partition["element"]
        lang = partition["lang"]
        if not isinstance(element, str) or not element:
            raise SourceError(
                f"{name}: section {section['key']} turn partition has no element"
            )
        language_row(lang)
        reach = (element, lang)
        if reach in held:
            raise SourceError(
                f"{name}: section {section['key']} repeats turn partition for "
                f"{element} in {lang}"
            )
        parts = partition["parts"]
        if not isinstance(parts, list) or not parts:
            raise SourceError(
                f"{name}: section {section['key']} turn partition for {element} "
                f"in {lang} has empty or malformed parts"
            )
        held[reach] = parts
    return held


def artifact_translation(
    section: dict, row_key: str, lang: str, text: str, witness: dict,
    witness_id: str, artifact_id: str, column: str, partitions: dict,
    library: dict, name: str,
) -> dict:
    """One artifact-backed translation plus any exact source-row partition."""
    translation = {
        "lang": witness["lang"],
        "source_id": witness_id,
        "rights": witness["rights"],
        "text": text,
    } | artifact_provenance(section, lang, row_key, name)
    parts = partitions.pop((row_key, lang), None)
    if parts is not None:
        side = SIDE_BLOCKS[lang]
        turns = structured_turns(
            {side + "_turns": parts}, side, library, artifact_id, [row_key],
            column, section["key"] + "/" + row_key, name, text,
        )
        translation["turns"] = turns
    return translation


def consistent_artifact_field(rows: list[dict], field: str, artifact_id: str,
                              key: str) -> str:
    """One element-level value across source rows, or an explicit refusal."""
    values = {
        (row.get(field) or "").strip()
        for row in rows
        if (row.get(field) or "").strip()
    }
    if len(values) > 1:
        raise SourceError(
            f"{artifact_id}: rows for {key} disagree on element-level {field}"
        )
    return next(iter(values), "")


def from_artifact(
    section: dict, witnesses: dict, restricted: dict, absences: dict,
    library: dict, name: str
) -> tuple[list[dict], list[dict]]:
    """The elements of a section whose text an artifact holds.

    Nothing about order, part, kind, speaker or wording is restated in the
    inventory: every one of them is read from the artifact's own row, which is
    the row that carries the hash.
    """
    artifact_id = section["artifact"]
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    witness_id = section.get("witness")
    if (witness_id, "en") in restricted:
        raise SourceError(
            f"{name}: section {section['key']} attempts an English text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, "en"))
    if witness is None:
        raise SourceError(f"{name}: section {section['key']} names undeclared witness {witness_id!r}")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list; the rights check would not have covered it"
        )
    latin_rows, latin_witness, latin_id = latin_side(
        section, witnesses, restricted, library, name
    )

    source_rows = payload_rows(record)
    source_order = []
    source_groups: dict[str, list[dict]] = {}
    for row in source_rows:
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        if key not in source_groups:
            source_order.append(key)
            source_groups[key] = []
        source_groups[key].append(row)
    excluded = artifact_exclusion_table(section, set(source_groups), name)
    latin_absence_overrides = artifact_latin_absence_overrides(
        section, set(source_groups), set(latin_rows), absences, name
    )
    partitions = artifact_turn_partition_table(section, name)

    elements = []
    exclusions = []
    for key in source_order:
        rows = source_groups[key]
        if key in excluded:
            if (key, "en") in partitions or (key, "la") in partitions:
                raise SourceError(
                    f"{name}: section {section['key']} declares turns for excluded "
                    f"element {key}"
                )
            sources = [
                {
                    "lang": "en",
                    "source_id": witness_id,
                    "artifact_id": artifact_id,
                    "element": key,
                }
                | artifact_provenance(section, "en", key, name)
            ]
            if key in latin_rows:
                sources.append(
                    {
                        "lang": "la",
                        "source_id": latin_id,
                        "artifact_id": section["artifact_latin"],
                        "element": key,
                    }
                    | artifact_provenance(section, "la", key, name)
                )
                latin_rows.pop(key)
            exclusions.append(
                {
                    "key": section["key"] + "/" + key,
                    "state": EXCLUSION_STATE,
                    "basis": excluded[key],
                    "sources": sorted({source["source_id"] for source in sources}),
                    "evidence": sources,
                }
            )
            continue
        kind = consistent_artifact_field(rows, "kind", artifact_id, key)
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{artifact_id}: row {key} has kind {kind!r}")
        english_lines = [(row.get("english") or "").strip() for row in rows]
        if any(english_lines) and not all(english_lines):
            raise SourceError(
                f"{artifact_id}: rows for {key} mix English text with empty rows; "
                "the section must state absence once, not between source turns"
            )
        english = "\n".join(english_lines) if all(english_lines) else ""
        incipit = consistent_artifact_field(rows, "latin_incipit", artifact_id, key)
        latin = (latin_rows.pop(key, {}) or {}).get("latin", "")
        absence_holder = {}
        if key in latin_absence_overrides:
            absence_holder["absent_latin"] = latin_absence_overrides[key]
        absent = absent_pair(absence_holder, section, absences, key, name)
        if english:
            absent["english"] = None
        elif absent["english"] is None:
            raise SourceError(
                f"{artifact_id}: row {key} has no English and its section names no "
                "reason; a silent gap is the one thing this layer must never emit"
            )
        if latin:
            absent["latin"] = None
        elif absent["latin"] is None:
            raise SourceError(
                f"{artifact_id}: row {key} has no Latin and its section names no "
                "reason; a silent gap is the one thing this layer must never emit"
            )
        translations = []
        if english:
            translations.append(
                artifact_translation(
                    section, key, "en", english, witness, witness_id, artifact_id,
                    "english", partitions, library, name,
                )
            )
        elif (key, "en") in partitions:
            raise SourceError(
                f"{name}: section {section['key']} declares English turns for {key}, "
                "which carries no English text"
            )
        if latin:
            translations.append(
                artifact_translation(
                    section, key, "la", latin, latin_witness, latin_id,
                    section["artifact_latin"], "latin", partitions, library, name,
                )
            )
        elif (key, "la") in partitions:
            raise SourceError(
                f"{name}: section {section['key']} declares Latin turns for {key}, "
                "which carries no Latin text"
            )
        speakers = {
            (row.get("speaker") or "").strip()
            for row in rows
            if (row.get("speaker") or "").strip()
        }
        if len(speakers) > 1 and not any(
            translation.get("turns") for translation in translations
        ):
            raise SourceError(
                f"{artifact_id}: rows for {key} name multiple speakers but no "
                "source-row turn partition"
            )
        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": next(iter(speakers)) if len(speakers) == 1 else None,
                "name": incipit or None,
                "latin_incipit": incipit or None,
                "locus": consistent_artifact_field(
                    rows, "printed_page", artifact_id, key
                ) or None,
                "note": consistent_artifact_field(
                    rows, "notes", artifact_id, key
                ) or None,
                "variant": None,
                "alternatives": [],
                "conditions": [],
                "absent": absent,
                "translations": translations or None,
            }
        )
    if latin_rows:
        raise SourceError(
            f"{name}: section {section['key']} carries Latin for "
            f"{', '.join(sorted(latin_rows))}, which its English artifact does not hold"
        )
    if partitions:
        element, lang = sorted(partitions)[0]
        raise SourceError(
            f"{name}: section {section['key']} declares a turn partition for "
            f"{element} in {lang}, which its selected artifact text does not hold"
        )
    return elements, exclusions


def artifact_text(library: dict, artifact_id: str, element: str, name: str,
                  column: str = "text") -> str:
    """One artifact element's words, out of the column that holds them.

    The column is named because the library does not use one name. Some
    artifacts carry `text`; the 1861 facing-column artifacts carry `latin`,
    beside the `seq`, `part`, `printed_page`, `ia_leaf` and `notes` that make
    the row checkable against the leaf. Guessing `text` on those raised nothing
    useful --- it raised KeyError from inside a dict comprehension --- so the
    column is declared by the block that draws on the artifact and refused here
    when the artifact does not have it.

    An empty cell is refused rather than joined. Absence is carried by NOT
    having a row, so an empty one is a row that should not exist, and letting it
    through would turn a transcription gap into a silent blank under a heading
    that names a missal.
    """
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: unknown artifact {artifact_id}")
    lines = []
    for row in payload_rows(record):
        if (row.get("element_key") or "").strip() != element:
            continue
        if column not in row:
            raise SourceError(
                f"{name}: {artifact_id} has no column {column!r}; it carries "
                f"{', '.join(sorted(one for one in row if one))}"
            )
        line = (row[column] or "").strip()
        if not line:
            raise SourceError(
                f"{name}: {artifact_id} row {element!r} carries nothing in "
                f"{column!r}; an absence is stated once and an empty cell states it nowhere"
            )
        lines.append(line)
    if not lines:
        raise SourceError(f"{name}: {artifact_id} holds no element {element!r}")
    return "\n".join(lines)


def relation_of(block: dict, key: str, lang: str, name: str) -> dict:
    """What this element is doing with that book, and what has been established.

    Declared per element and never on the witness, because it is a relation
    between two texts and not a property of a printing --- there is no
    antecedent edition of anything. The propers file records what happened when
    the two were run together into one invented witness id: it resolved nowhere,
    and 63 translations served under a bare dotted id with no label and no
    caution.
    """
    relation = block.get("relation")
    if relation is None:
        return {"relation": "own"}
    if relation not in RELATIONS:
        raise SourceError(
            f"{name}: element {key} declares relation {relation!r} for {lang}; "
            f"one of {', '.join(RELATIONS)} is required"
        )
    if relation not in NEEDS_RELATION_NOTE:
        return {"relation": relation}
    collation = block.get("collation")
    if collation not in COLLATIONS:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and declares "
            f"collation {collation!r}; one of {', '.join(COLLATIONS)} is required, "
            "because an established identity and an unestablished one must not look the same"
        )
    note = (block.get("note") or "").strip()
    if not note:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and states no note; "
            "a relation nobody can check is a claim nobody made"
        )
    out = {"relation": relation, "collation": collation, "note": note}
    finding = (block.get("collation_finding") or "").strip()
    if collation == "collated":
        if not finding:
            raise SourceError(
                f"{name}: element {key} claims a collated identity for {lang} and "
                "cites no finding; the grade would be an assertion, which is the "
                "one thing the other grade exists to be distinguished from"
            )
        out["collation_finding"] = finding
    elif finding:
        raise SourceError(
            f"{name}: element {key} is uncollated for {lang} and cites "
            f"{finding!r}; a citation on an uncollated row invites the reader to "
            "read it as the collation that was not made"
        )
    return out


def structured_turns(entry: dict, side: str, library: dict, artifact_id: str,
                     named: list[str], column: str, key: str, name: str,
                     parent_text: str) -> list[dict] | None:
    """Validate and project one side's explicit artifact-row turn partition.

    Turn boundaries are source row identities, never offsets or prose matches.
    The declarations must partition exactly the same rows, in the same order,
    that produced the parent translation.  This makes turns additive metadata:
    joining their text is byte-for-byte the already selected parent text.
    """
    field = side + "_turns"
    declarations = entry.get(field)
    if declarations is None:
        return None
    if not isinstance(declarations, list) or not declarations:
        raise SourceError(f"{name}: element {key} has an empty or malformed {field}")

    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: element {key} names unknown artifact {artifact_id}")
    payload = payload_rows(record)
    selected = []
    for element in named:
        selected.extend(
            row for row in payload
            if (row.get("element_key") or "").strip() == element
        )

    source_sequence = []
    source_rows = {}
    for row in selected:
        raw_seq = (row.get("seq") or "").strip()
        if not raw_seq.isdecimal():
            raise SourceError(
                f"{name}: {artifact_id} row for {key} has non-integer seq {raw_seq!r}"
            )
        seq = int(raw_seq)
        if seq in source_rows:
            raise SourceError(
                f"{name}: {artifact_id} repeats seq {seq}; turn boundaries would be ambiguous"
            )
        if column not in row:
            raise SourceError(
                f"{name}: {artifact_id} has no column {column!r} for turn seq {seq}"
            )
        text = (row[column] or "").strip()
        if not text:
            raise SourceError(
                f"{name}: {artifact_id} turn seq {seq} carries no {column!r} text"
            )
        source_sequence.append(seq)
        source_rows[seq] = text

    turns = []
    declared_sequence = []
    seen_keys = set()
    for declaration in declarations:
        if not isinstance(declaration, dict):
            raise SourceError(f"{name}: element {key} has a non-table turn in {field}")
        unknown = set(declaration) - TURN_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: element {key} turn declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        turn_key = declaration.get("key")
        if not isinstance(turn_key, str) or not turn_key:
            raise SourceError(f"{name}: element {key} has a turn with no key in {field}")
        turn_key_parts = turn_key.split("-")
        if any(
            not part
            or not part.isascii()
            or not part.isalnum()
            or part.lower() != part
            for part in turn_key_parts
        ):
            raise SourceError(
                f"{name}: element {key} turn key {turn_key!r} is not stable kebab-case"
            )
        if turn_key in seen_keys:
            raise SourceError(f"{name}: element {key} repeats turn key {turn_key!r} in {field}")
        seen_keys.add(turn_key)

        sequence = declaration.get("seq")
        if (
            not isinstance(sequence, list)
            or not sequence
            or any(not isinstance(one, int) or isinstance(one, bool) for one in sequence)
        ):
            raise SourceError(
                f"{name}: element {key} turn {turn_key} needs a nonempty integer seq array"
            )
        declared_sequence.extend(sequence)

        speaker = declaration.get("speaker")
        if speaker is not None and speaker not in TURN_SPEAKERS:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} has speaker {speaker!r}; "
                f"one of {', '.join(TURN_SPEAKERS)} is required"
            )
        dialogue_role = declaration.get("dialogue_role")
        if dialogue_role is not None and dialogue_role not in TURN_DIALOGUE_ROLES:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} has dialogue_role "
                f"{dialogue_role!r}; one of {', '.join(TURN_DIALOGUE_ROLES)} is required"
            )
        action = declaration.get("action") if "action" in declaration else None
        if "action" in declaration and action is not True:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} action must be true or omitted"
            )
        if action and (speaker is not None or dialogue_role is not None):
            raise SourceError(
                f"{name}: element {key} turn {turn_key} cannot be both an action "
                "and a spoken turn"
            )
        turns.append(
            {
                "key": turn_key,
                "speaker": speaker,
                "dialogue_role": dialogue_role,
                "action": action,
                "text": None,
            }
        )

    if declared_sequence != source_sequence:
        raise SourceError(
            f"{name}: element {key} {field} seq {declared_sequence} does not exactly "
            f"partition source seq {source_sequence} in order"
        )
    offset = 0
    for turn, declaration in zip(turns, declarations):
        count = len(declaration["seq"])
        sequence = declared_sequence[offset:offset + count]
        turn["text"] = "\n".join(source_rows[one] for one in sequence)
        offset += count
    if "\n".join(turn["text"] for turn in turns) != parent_text:
        raise SourceError(
            f"{name}: element {key} {field} changes the selected parent text"
        )
    return turns


def side_text(entry: dict, lang: str, witnesses: dict, restricted: dict, library: dict,
              key: str, name: str) -> dict | None:
    """One element's text in one language, from whichever edition holds it.

    Resolved identically for both languages. What differs between them is
    declared in the block --- the witness, the artifact, which of its elements,
    and the column --- and never inferred from which language is being asked
    for, so that adding the Latin could not quietly change what the English did.
    """
    side = SIDE_BLOCKS[lang]
    block = entry.get(side)
    if not block:
        if side + "_turns" in entry:
            raise SourceError(
                f"{name}: element {key} declares {side}_turns without a {side} text block"
            )
        return None
    witness_id = block.get("witness")
    if (witness_id, lang) in restricted:
        raise SourceError(
            f"{name}: element {key} attempts a {lang} text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, lang))
    if witness is None:
        raise SourceError(
            f"{name}: element {key} names undeclared witness {witness_id!r} for {lang}"
        )
    artifact_id = block.get("artifact")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: element {key} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for {lang}; the rights check would not "
            "have covered it"
        )
    # A list, because the granularity of a book is not the granularity of an
    # element. The Missal sets the Creed as one text where the 1861 sets it as
    # three, and the join has to be stated in the file rather than worked out by
    # anything downstream.
    named = block.get("elements") or ([block["element"]] if block.get("element") else [])
    if not named:
        raise SourceError(f"{name}: element {key} names no artifact element for {lang}")
    column = block.get("column") or "text"
    text = "\n".join(
        artifact_text(library, artifact_id, one, name, column) for one in named
    )
    translation = {
        "lang": lang,
        "source_id": witness_id,
        "rights": witness["rights"],
        "text": text,
    } | relation_of(block, key, lang, name)
    turns = structured_turns(
        entry, SIDE_BLOCKS[lang], library, artifact_id, named, column, key, name, text
    )
    if turns is not None:
        translation["turns"] = turns
    return translation


def from_inventory(
    section: dict, witnesses: dict, restricted: dict, absences: dict,
    options: dict, library: dict, name: str
) -> list[dict]:
    """The elements of a section the inventory states itself.

    Used where no artifact of the rite's own text exists to draw on. The
    inventory may still not hold a prayer: it holds the element's identity, its
    received Latin incipit, and either a licensed text drawn from an artifact or
    a named reason for the absence.
    """
    elements = []
    for entry in section.get("elements") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an element of {section['key']} has no key")
        kind = entry.get("kind")
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{name}: element {key} has kind {kind!r}")
        variant, alternatives = element_alternatives(entry, options, key, name)
        conditions = element_conditions(entry, options, key, name)

        held = [
            row
            for row in (
                side_text(
                    entry, language["lang"], witnesses, restricted, library, key, name
                )
                for language in LANGUAGES
            )
            if row
        ]
        translations = held or None

        absent = absent_pair(entry, section, absences, key, name)
        # Per language, not per element. The refusal below used to be checked
        # for English alone, which was right while English was the only side an
        # element could carry: an element with a Latin text and no English and
        # no reason would have passed it silently, and a silent gap under a
        # heading naming a missal reads as a rite that omits the prayer.
        for language in LANGUAGES:
            reached = any(row["lang"] == language["lang"] for row in held)
            if reached:
                absent[language["absent"]] = None
            elif absent[language["absent"]] is None:
                raise SourceError(
                    f"{name}: element {key} carries no {language['lang']} text and "
                    "names no absence; a silent gap is the one thing this layer "
                    "must never emit"
                )

        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": entry.get("speaker") or None,
                "name": entry.get("name") or entry.get("latin_incipit") or None,
                "latin_incipit": entry.get("latin_incipit") or None,
                "locus": entry.get("missal_number") or None,
                "note": entry.get("note") or None,
                "variant": variant,
                "alternatives": alternatives,
                "conditions": conditions,
                "absent": absent,
                "translations": translations,
            }
        )
    return elements


