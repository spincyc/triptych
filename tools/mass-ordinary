    # `through` cuts a `text_of` occurrence at a printed junction (below).
    "through",
    # An inserted element may instead carry its own text from any declared,
    # publishable witness, exactly as an inline element does (`side_text`):
    # the 1962 Canon's proper forms are printed by no row of the 1861 book.
    "english", "latin", "english_turns", "latin_turns",
}

# A printed junction: where a target edition continues a witness's row with
# other words, the frame may carry the row only THROUGH a declared marker, one
# per language the row holds.  The marker must occur exactly once and leave a
# nonblank remainder; the emitted text is then an exact prefix of the source
# row, so it stays auditable against the artifact.  Used on a source row
# (`[[sections.junctions]]`, which keeps the row's identity) and on a `text_of`
# occurrence (`through` on the inserted row).  The 1861 book prints the common
# Preface whole and every proper Preface as a clause starting at its asterisk;
# the 1962 prints its common Communicantes continuing with a clause the 1861
# lacks.  Both are joined here, never rewritten.
JUNCTION_FIELDS = {"element", "through", "basis"}

# Element-level provenance.  Artifact sections declare relation and collation
# per section; a collation run for some elements only is declared per element
# and language here, with the same closed fields, and replaces the section's
# block for that element alone.
ELEMENT_PROVENANCE_FIELDS = {"element", "lang", "relation", "collation",
                             "collation_finding", "target_wording", "note"}

# Artifact sections may fill one missing language of an existing source row
# from another explicitly declared artifact. The base artifact and its absence
# finding remain unchanged; this table never replaces an already held side.
ADDITIONAL_TEXT_FIELDS = {"element", "english", "latin", "english_turns",
                          "latin_turns", "turns_basis"}
ADDITIONAL_SIDE_FIELDS = {"witness", "artifact", "element", "elements", "column",
                          "relation", "collation", "collation_finding",
                          "target_wording", "note"}

# Words the book prints as conditional inside a row -- the 1861 and 1962
# Holy Spirit Preface's "hodierna die", said only from the vigil of Pentecost
# through the following Saturday.  The span is declared, never inferred, with
# a structured window (counted from a movable anchor, as appointment spans are)
# and a project-written rubric sentence; the words themselves stay in the row.
CONDITIONAL_SPAN_FIELDS = {"element", "lang", "text", "said", "rubric", "locus"}
CONDITIONAL_SAID_FIELDS = {"anchor", "from", "to"}

# A collated text whose finding establishes that its WORDS are the controlling
# edition's (the 2026-09-03 rule in guidance/propers-for-agents.md: words,
# never strings) may say so.  It then counts as `exact-target` in coverage, as
# a collated word-exact Proper projection does (C2 decision of 2026-10-19).
TARGET_WORDINGS = ("word-exact",)
ELEMENT_CONDITION_FIELDS = {"element", "conditions"}

# An artifact can contain matter which a later target recension does not.  A
# declaration consumes that source row without relabelling it as target text.
# The public projection is text-free but keeps enough typed provenance to make
# the exclusion auditable.
EXCLUSION_FIELDS = {"element", "basis"}
EXCLUSION_STATE = "not-in-target-recension"

# What an element's use of a book is, and what has been established about it.
# Two fields because they are two facts, and collapsing them is how a page comes
# to say `this is the Missal's Latin` on the strength of a resemblance.
#
#   relation  own         the witness IS the edition this frame declares
#             antecedent  the witness prints an older text this frame's book
#                         received; this frame does not carry the target text
#   collation collated    a finding in this repository states the relationship
#                         between this element's text and the controlling
#                         edition, and `collation_finding` cites it
#             uncollated  no such finding; the note must say so in those words
#
# `relation_of` retains an implicit-own result for legacy inline language
# blocks. Artifact-backed sections use `artifact_provenance`, which refuses an
# omission: their wide join would otherwise stamp every row with an identity
# claim nobody declared.
RELATIONS = ("own", "antecedent")
COLLATIONS = ("collated", "uncollated")
NEEDS_RELATION_NOTE = ("antecedent",)
ARTIFACT_PROVENANCE_FIELDS = {
    "relation", "collation", "collation_finding", "note", "target_wording",
}


class SourceError(ValueError):
    """An ordinary source that cannot be trusted to emit anything."""


def language_row(lang: str) -> dict:
    """The declared language `lang`, or a refusal naming what is on offer."""
    for one in LANGUAGES:
        if one["lang"] == lang:
            return one
    offered = ", ".join(one["lang"] for one in LANGUAGES)
    raise SourceError(f"no language {lang!r} in this layer; it holds {offered}")


# --------------------------------------------------------------- reading


def inventories(root: Path, calendar: str | None) -> list[Path]:
    found = sorted((root / "inventories").glob("*" + INVENTORY_SUFFIX))
    if calendar:
        found = [one for one in found if one.name == calendar + INVENTORY_SUFFIX]
        if not found:
            raise SourceError(f"no ordo-missae inventory for calendar {calendar!r}")
    if not found:
        raise SourceError(f"no ordo-missae inventory under {root / 'inventories'}")
    return found


def read_toml(path: Path) -> dict:
    try:
        with path.open("rb") as handle:
            return tomllib.load(handle)
    except tomllib.TOMLDecodeError as error:
        raise SourceError(f"{path.name}: cannot parse TOML: {error}") from error


def artifact_records(root: Path) -> dict[str, dict]:
    """Every artifact manifest in the library, by id.

    Read whole rather than by guessed path: an artifact's id does not encode
    where it lives, and a lookup that reconstructed the path would silently
    stop finding a record that moved.
    """
    held: dict[str, dict] = {}
    for path in (root / "works").rglob("artifact.toml"):
        data = read_toml(path)
        identifier = data.get("id")
        if isinstance(identifier, str):
            data["_path"] = path
            data["_source_root"] = root.resolve()
            held[identifier] = data
    return held


def payload_rows(record: dict) -> list[dict]:
    """The TSV an artifact manifest declares, as rows keyed by column name."""
    relative = record.get("path")
    if not isinstance(relative, str):
        raise SourceError(f"{record['id']}: artifact declares no payload path")
    source_root = record.get("_source_root")
    if not isinstance(source_root, Path):
        raise SourceError(
            f"{record['id']}: artifact record has no source-library root"
        )
    relative_path = Path(relative)
    if relative_path.is_absolute():
        raise SourceError(f"{record['id']}: payload path must be relative: {relative}")
    parts = relative_path.parts
    if parts[:2] == ("src", "sources"):
        parts = parts[2:]
    path = source_root.joinpath(*parts).resolve()
    if not path.is_relative_to(source_root):
        raise SourceError(f"{record['id']}: payload path escapes the source library: {relative}")
    if not path.is_file():
        raise SourceError(f"{record['id']}: payload missing at {relative}")
    with path.open(encoding="utf-8", newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    if not rows:
        raise SourceError(f"{record['id']}: payload has no data rows")
    return rows


# --------------------------------------------------------------- witnesses


def restricted_witness_table(
    source: dict, library: dict[str, dict], name: str
) -> dict[tuple[str, str], dict]:
    """Validate text-free source metadata this generator must never publish.

    A restricted witness is intentionally kept outside `witness_table`: it is
    neither eligible for a text join nor copied into the generated translation
    manifest.  Its artifacts must already be quarantined in the source library
    so an inventory cannot get ahead of the payload removal it claims.
    """
    held: dict[tuple[str, str], dict] = {}
    for entry in source.get("restricted_witnesses") or []:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: a restricted witness is not a table")
        unknown = set(entry) - RESTRICTED_WITNESS_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: a restricted witness declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        identifier = entry.get("id")
        if not isinstance(identifier, str) or not identifier:
            raise SourceError(f"{name}: a restricted witness has no id")
        language = entry.get("lang")
        if not isinstance(language, str) or not language:
            raise SourceError(
                f"{name}: restricted witness {identifier} declares no lang"
            )
        language_row(language)
        reach = (identifier, language)
        if reach in held:
            raise SourceError(
                f"{name}: restricted witness {identifier} is declared twice for {language}"
            )
        if entry.get("state") != RESTRICTED_WITNESS_STATE:
            raise SourceError(
                f"{name}: restricted witness {identifier} must declare "
                f"state = {RESTRICTED_WITNESS_STATE!r}"
            )
        if entry.get("acknowledgement") != ICEL_EXCERPT_ACKNOWLEDGEMENT:
            raise SourceError(
                f"{name}: restricted witness {identifier} does not carry ICEL's "
                "exact prescribed excerpt acknowledgement"
            )
        artifacts = entry.get("artifacts")
        if (
            not isinstance(artifacts, list)
            or not artifacts
            or any(not isinstance(one, str) or not one for one in artifacts)
            or len(artifacts) != len(set(artifacts))
        ):
            raise SourceError(
                f"{name}: restricted witness {identifier} needs a nonempty, "
                "duplicate-free artifact id array"
            )
        for artifact_id in artifacts:
            record = library.get(artifact_id)
            if record is None:
                raise SourceError(
                    f"{name}: restricted witness {identifier} names unknown "
                    f"artifact {artifact_id}"
                )
            if record.get("rights_status") not in RESTRICTED_ARTIFACT_RIGHTS:
                raise SourceError(
                    f"{name}: restricted witness {identifier} is rights-restricted "
                    f"but {artifact_id} has rights_status "
                    f"{record.get('rights_status')!r}; one of "
                    f"{', '.join(RESTRICTED_ARTIFACT_RIGHTS)} is required"
                )
            if (
                record.get("storage") != RESTRICTED_ARTIFACT_STORAGE
                or "path" in record
                or record.get("indexable") is not False
            ):
                raise SourceError(
                    f"{name}: restricted witness {identifier} names {artifact_id}, "
                    "whose artifact record is not text-free restricted storage"
                )
        held[reach] = dict(entry)
    return held


def witness_table(source: dict, library: dict[str, dict], name: str) -> dict[str, dict]:
    """The witnesses this inventory may draw text from, checked against the library.

    A witness is declared here and recorded there, and the two must agree. The
    check is not ceremony: `rights` is what decides whether a text reaches the
    world, and a value typed into an inventory beside the text it licenses is
    exactly the copy that drifts.
    """
    held: dict[tuple[str, str], dict] = {}
    for entry in source.get("witnesses") or []:
        identifier = entry.get("id")
        if not isinstance(identifier, str) or not identifier:
            raise SourceError(f"{name}: a witness has no id")
        # Keyed by (id, lang), because one printing may witness two languages:
        # the 1861 Cummiskey sets Latin and English in facing columns and both
        # are that edition's own text. `source_id` reaches the page as
        # attribution and must name the real edition record, so minting a
        # second id for the Latin would misattribute it.
        language = entry.get("lang")
        if not isinstance(language, str) or not language:
            raise SourceError(f"{name}: witness {identifier} declares no lang")
        if (identifier, language) in held:
            raise SourceError(
                f"{name}: witness {identifier} is declared twice for {language}"
            )
        rights = entry.get("rights")
        if rights not in PUBLISHABLE_RIGHTS:
            raise SourceError(
                f"{name}: witness {identifier} declares rights {rights!r}; "
                f"this tool publishes only {', '.join(PUBLISHABLE_RIGHTS)}"
            )
        for artifact_id in entry.get("artifacts") or []:
            record = library.get(artifact_id)
            if record is None:
                raise SourceError(f"{name}: witness {identifier} names unknown artifact {artifact_id}")
            recorded = record.get("rights_status")
            if recorded not in LIBRARY_RIGHTS[rights]:
                raise SourceError(
                    f"{name}: witness {identifier} declares {rights!r} but "
                    f"{artifact_id} is recorded as {recorded!r} in the source library"
                )
        held[(identifier, language)] = dict(entry)
    if not held:
        raise SourceError(f"{name}: no witness is declared")
    return held


# Why a text is not here, as a value a renderer can read rather than prose it
# would have to parse. The acquisition, publication, and modelling states are
# deliberately disjoint:
#   witness-gap     a held or registered source has no joined usable payload
#   rights-withheld this distribution surface has no recorded authorization
#   rights-unresolved whether this surface may publish has not been established
#   no-exemplar     no exact authoritative exemplar is registered
#   model-gap       the element spans independently sourceable matter
#   outside-layer   the assigned text belongs to another data layer
#   not-applicable  the element has no fixed text at this layer
# A proper assigned in another layer and an action with no fixed text are not
# missing witnesses, while a composite span cannot be repaired merely by
# acquiring another page.
ABSENCE_KINDS = (
    "witness-gap",
    "rights-withheld",
    "rights-unresolved",
    "no-exemplar",
    "model-gap",
    "outside-layer",
    "not-applicable",
)

ABSENCE_STATES = {
    "rights-withheld": "rights-restricted",
    "rights-unresolved": "unresolved",
}


def absence_state(kind: str) -> str:
    """Public capability state for one closed absence kind."""
    return ABSENCE_STATES.get(kind, "unavailable")


def absence_table(source: dict, name: str) -> dict[str, dict]:
    held: dict[str, dict] = {}
    for entry in source.get("absences") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an absence has no key")
        if key in held:
            raise SourceError(f"{name}: absence {key} is declared twice")
        if not entry.get("what"):
            raise SourceError(f"{name}: absence {key} says nothing about why")
        label = entry.get("label")
        if not isinstance(label, str) or not label.strip() or len(label) > 120:
            raise SourceError(f"{name}: absence {key} needs a concise reader label")
        kind = entry.get("kind")
        if kind not in ABSENCE_KINDS:
            raise SourceError(
                f"{name}: absence {key} declares kind {kind!r}; "
                f"one of {', '.join(ABSENCE_KINDS)} is required"
            )
        held[key] = dict(entry)
    return held


def variant_table(source: dict, name: str) -> tuple[list[dict], dict[str, str]]:
    """The choices the celebrant makes, and which option each variant element sits under.

    Returned flat as well as nested, because an element names its option and the
    join has to refuse an option no group offers rather than emit an element the
    browser can never show.
    """
    groups = []
    options: dict[str, str] = {}
    seen_groups: set[str] = set()
    for entry in source.get("variants") or []:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: a variant group is not a table")
        unknown = set(entry) - VARIANT_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: a variant group declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        group = entry.get("group")
        if not isinstance(group, str) or not group:
            raise SourceError(f"{name}: a variant group has no id")
        if group in seen_groups:
            raise SourceError(f"{name}: variant group {group} is declared twice")
        seen_groups.add(group)
        if not isinstance(entry.get("name"), str) or not entry["name"].strip():
            raise SourceError(f"{name}: variant group {group} has no name")
        if not isinstance(entry.get("what"), str) or not entry["what"].strip():
            raise SourceError(f"{name}: variant group {group} says nothing about the choice")
        listed = entry.get("options") or []
        if not isinstance(listed, list):
            raise SourceError(f"{name}: variant group {group} options are not an array")
        if len(listed) < 2:
            raise SourceError(f"{name}: variant group {group} offers fewer than two options")
        for option in listed:
            if not isinstance(option, dict):
                raise SourceError(f"{name}: an option of {group} is not a table")
            unknown = set(option) - VARIANT_OPTION_FIELDS
            if unknown:
                raise SourceError(
                    f"{name}: an option of {group} declares unknown fields "
                    f"{', '.join(sorted(unknown))}"
                )
            if not isinstance(option.get("default"), bool):
                raise SourceError(
                    f"{name}: an option of {group} must declare boolean default"
                )
            if not isinstance(option.get("name"), str) or not option["name"].strip():
                raise SourceError(f"{name}: an option of {group} has no name")
        defaults = [one for one in listed if one["default"]]
        if len(defaults) != 1:
            raise SourceError(
                f"{name}: variant group {group} must mark exactly one option default, not {len(defaults)}"
            )
        for option in listed:
            identifier = option.get("id")
            if not isinstance(identifier, str) or not identifier:
                raise SourceError(f"{name}: an option of {group} has no id")
            if identifier in options:
                raise SourceError(f"{name}: option {identifier} is declared twice")
            options[identifier] = group
        groups.append(dict(entry) | {"mode": "one-of"})
    return groups, options


def element_alternatives(entry: dict, options: dict[str, str], key: str,
                         name: str) -> tuple[str | None, list[dict]]:
    """One element's exact memberships in independently selected groups."""
    legacy = entry.get("variant")
    declared = entry.get("alternatives")
    if legacy is not None and declared is not None:
        raise SourceError(
            f"{name}: element {key} declares both legacy variant and alternatives"
        )
    if legacy is not None:
        if legacy not in options:
            raise SourceError(
                f"{name}: element {key} names option {legacy!r}, which no "
                "variant group offers"
            )
        return legacy, [{"group": options[legacy], "option": legacy}]
    if declared is None:
        return None, []
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: element {key} has empty or malformed alternatives")
    held = []
    groups = set()
    for alternative in declared:
        if not isinstance(alternative, dict):
            raise SourceError(f"{name}: element {key} has a non-table alternative")
        unknown = set(alternative) - ALTERNATIVE_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: element {key} alternative declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        group = alternative.get("group")
        option = alternative.get("option")
        if not isinstance(group, str) or not group:
            raise SourceError(f"{name}: element {key} alternative has no group")
        if not isinstance(option, str) or not option:
            raise SourceError(f"{name}: element {key} alternative has no option")
        if options.get(option) != group:
            raise SourceError(
                f"{name}: element {key} puts option {option!r} under group "
                f"{group!r}, but that group does not offer it"
            )
        if group in groups:
            raise SourceError(
                f"{name}: element {key} belongs to variant group {group} more than once"
            )
        groups.add(group)
        held.append({"group": group, "option": option})
    return None, held


def appointment_table(source: dict, name: str) -> dict[str, dict]:
    """The Ordinary variables a day appoints, with their options and spans.

    A variable is not a celebrant's choice (that is `[[variants]]`) but a
    decision the books make for the day: which Preface, which Communicantes.
    It is declared here, beside the elements that print each option, so that a
    formulary naming an option this frame cannot show is refused at build time
    rather than rendered as nothing.  `default` is the option every Mass takes
    that no formulary or span appoints otherwise, and it needs its own basis:
    without one an unappointed day is UNRESOLVED, never the common form.
    """
    held: dict[str, dict] = {}
    for entry in source.get("appointments") or []:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: an appointment variable is not a table")
        unknown = set(entry) - APPOINTMENT_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: an appointment variable declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        variable = entry.get("variable")
        if not isinstance(variable, str) or not APPOINTMENT_VARIABLE_RE.fullmatch(variable):
            raise SourceError(f"{name}: appointment variable {variable!r} is not a snake_case id")
        if variable in held:
            raise SourceError(f"{name}: appointment variable {variable} is declared twice")
        for field in ("name", "what"):
            if not isinstance(entry.get(field), str) or not entry[field].strip():
                raise SourceError(f"{name}: appointment variable {variable} has no {field}")
        options = entry.get("options")
        if not isinstance(options, list) or not options:
            raise SourceError(f"{name}: appointment variable {variable} offers no option")
        ids: list[str] = []
        for option in options:
            if not isinstance(option, dict) or set(option) != APPOINTMENT_OPTION_FIELDS:
                raise SourceError(
                    f"{name}: an option of appointment variable {variable} must carry "
                    "exactly id and name"
                )
            if not APPOINTMENT_OPTION_RE.fullmatch(str(option["id"])):
                raise SourceError(
                    f"{name}: appointment option {option['id']!r} is not a kebab-case id"
                )
            if not isinstance(option["name"], str) or not option["name"].strip():
                raise SourceError(f"{name}: appointment option {option['id']} has no name")
            if option["id"] in ids:
                raise SourceError(
                    f"{name}: appointment variable {variable} offers {option['id']} twice"
                )
            ids.append(option["id"])
        default = entry.get("default")
        if default is not None:
            if default not in ids:
                raise SourceError(
                    f"{name}: appointment variable {variable} defaults to "
                    f"{default!r}, which it does not offer"
                )
            if not isinstance(entry.get("default_basis"), str) or not entry["default_basis"].strip():
                raise SourceError(
                    f"{name}: appointment variable {variable} declares a default "
                    "without default_basis; an unsourced default is a silent "
                    "substitution"
                )
        elif "default_basis" in entry:
            raise SourceError(
                f"{name}: appointment variable {variable} has default_basis but no default"
            )
        spans = []
        for span in entry.get("spans") or []:
            if not isinstance(span, dict):
                raise SourceError(f"{name}: a span of {variable} is not a table")
            unknown = set(span) - APPOINTMENT_SPAN_FIELDS
            missing = {"from", "to", "locus"} - set(span)
            if unknown or missing:
                raise SourceError(
                    f"{name}: a span of {variable} has unknown fields "
                    f"{sorted(unknown)} or misses {sorted(missing)}"
                )
            # A `withheld` span names dates on which the default must NOT be
            # assumed and nothing has established the appointment: the day is
            # unappointed there.  It appoints no option.
            if ("option" in span) == (span.get("withheld") is True):
                raise SourceError(
                    f"{name}: a span of {variable} must carry exactly one of an "
                    "option or withheld = true"
                )
            if "option" in span and span["option"] not in ids:
                raise SourceError(
                    f"{name}: a span of {variable} appoints {span['option']!r}, "
                    "which the variable does not offer"
                )
            if not isinstance(span["locus"], str) or not span["locus"].strip():
                raise SourceError(f"{name}: a span of {variable} cites no locus")
            if "weekday" in span and span["weekday"] not in APPOINTMENT_WEEKDAYS:
                raise SourceError(
                    f"{name}: a span of {variable} names weekday {span['weekday']!r}; "
                    f"one of {', '.join(APPOINTMENT_WEEKDAYS)} is required"
                )
            anchor = span.get("anchor")
            if anchor is None:
                if not all(
                    isinstance(span[edge], str) and MONTH_DAY_RE.fullmatch(span[edge])
                    for edge in ("from", "to")
                ):
                    raise SourceError(
                        f"{name}: a fixed span of {variable} needs MM-DD from and to"
                    )
            else:
                if anchor not in APPOINTMENT_ANCHORS:
                    raise SourceError(
                        f"{name}: a span of {variable} counts from {anchor!r}; one of "
                        f"{', '.join(APPOINTMENT_ANCHORS)} is required"
                    )
                if not all(
                    isinstance(span[edge], int) and not isinstance(span[edge], bool)
                    for edge in ("from", "to")
                ) or span["from"] > span["to"]:
                    raise SourceError(
                        f"{name}: an anchored span of {variable} needs integer day "
                        "offsets with from <= to"
                    )
            spans.append(dict(span))
        held[variable] = {
            "variable": variable,
            "name": entry["name"],
            "what": entry["what"],
            "options": [dict(option) for option in options],
            "default": default,
            "default_basis": entry.get("default_basis"),
            "spans": spans,
        }
    return held


def appointment_coverage(appointments: dict, sections: list[dict], name: str) -> None:
    """Every appointable option must print SOMETHING, and so must no appointment.

    An option no element answers would let a formulary appoint a text the
    frame then drops in silence; a variable with no default and no
    `unappointed` element would do the same on every day that appoints
    nothing.  Both are refused here, where the inventory is read.
    """
    reached: dict[str, set[str]] = {key: set() for key in appointments}
    unappointed: set[str] = set()
    for section in sections:
        for element in section["elements"]:
            for condition in element.get("conditions") or []:
                if condition.get("kind") == "appointed":
                    reached[condition["variable"]].update(condition["options"])
                elif condition.get("kind") == "unappointed":
                    unappointed.add(condition["variable"])
    for key, variable in appointments.items():
        missing = [
            one["id"] for one in variable["options"] if one["id"] not in reached[key]
        ]
        if missing:
            raise SourceError(
                f"{name}: appointment variable {key} offers {', '.join(missing)}, "
                "which no element prints or stands in for"
            )
        if variable["default"] is None and key not in unappointed:
            raise SourceError(
                f"{name}: appointment variable {key} has no default and no element "
                "for a day that appoints nothing"
            )


def element_conditions(entry: dict, options: dict[str, str], key: str,
                       name: str, appointments: dict | None = None) -> list[dict]:
    """Closed positive/context conditions; never executable inventory prose."""
    declared = entry.get("conditions")
    if declared is None:
        return []
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: element {key} has empty or malformed conditions")
    held = []
    for condition in declared:
        if not isinstance(condition, dict):
            raise SourceError(f"{name}: element {key} has a non-table condition")
        kind = condition.get("kind")
        fields = CONDITION_FIELDS.get(kind)
        if fields is None:
            raise SourceError(
                f"{name}: element {key} condition has kind {kind!r}; one of "
                f"{', '.join(CONDITION_FIELDS)} is required"
            )
        optional = CONDITION_OPTIONAL_FIELDS.get(kind, set())
        unknown = set(condition) - fields - optional
        missing = fields - set(condition)
        if "or_unappointed" in condition and condition["or_unappointed"] is not True:
            raise SourceError(
                f"{name}: element {key} or_unappointed may only be true"
            )
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: element {key} {kind} condition has {'; '.join(detail)}"
            )
        basis = condition.get("basis")
        if not isinstance(basis, str) or not basis.strip():
            raise SourceError(f"{name}: element {key} {kind} condition has no basis")
        if kind in ("appointed", "unappointed"):
            variable = condition["variable"]
            declared_variable = (appointments or {}).get(variable)
            if declared_variable is None:
                raise SourceError(
                    f"{name}: element {key} {kind} condition names undeclared "
                    f"appointment variable {variable!r}"
                )
            if kind == "appointed":
                offered = {one["id"] for one in declared_variable["options"]}
                chosen = condition["options"]
                if (
                    not isinstance(chosen, list)
                    or not chosen
                    or any(one not in offered for one in chosen)
                    or len(chosen) != len(set(chosen))
                ):
                    raise SourceError(
                        f"{name}: element {key} appointed options must be a nonempty "
                        f"duplicate-free subset of {variable}'s declared options"
                    )
        elif kind == "include-when-any":
            predicates = condition["predicates"]
            if (
                not isinstance(predicates, list)
                or not predicates
                or any(one not in CONDITION_PREDICATES for one in predicates)
                or len(predicates) != len(set(predicates))
            ):
                raise SourceError(
                    f"{name}: element {key} include-when-any predicates must be a "
                    "nonempty duplicate-free subset of the closed predicate table"
                )
        else:
            group = condition["group"]
            selected = condition["options"]
            if not isinstance(group, str) or not group:
                raise SourceError(
                    f"{name}: element {key} omit-when-option condition has no group"
                )
            if (
                not isinstance(selected, list)
                or not selected
                or any(options.get(one) != group for one in selected)
                or len(selected) != len(set(selected))
            ):
                raise SourceError(
                    f"{name}: element {key} omit-when-option options must be a "
                    "nonempty duplicate-free subset of the named group's options"
                )
        held.append(dict(condition) | {"unknown": "unresolved"})
    return held


def slot_table(source: dict, sections: list[dict], name: str) -> list[dict]:
    """Where the day's propers sit in this frame, checked against the elements.

    Every check below exists because the failure it catches is silent. An
    anchor that no longer names an element would drop a proper off the page
    with nothing raised; two slots claiming one proper name would leave a page
    to choose, and it would choose consistently and possibly wrongly; and slots
    that run backwards against the elements would put the Gospel before the
    Epistle while every file still validated.
    """
    order = {}
    alternatives_of = {}
    for section in sections:
        for element in section["elements"]:
            order[element["key"]] = len(order)
            alternatives_of[element["key"]] = element.get("alternatives") or []

    held: list[dict] = []
    claimed: dict[str, str] = {}
    seen: set[str] = set()
    reached = -1
    for entry in source.get("slots") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: a slot has no key")
        if key in seen:
            raise SourceError(f"{name}: slot {key} is declared twice")
        seen.add(key)
        sides = [one for one in SLOT_SIDES if entry.get(one)]
        if len(sides) != 1:
            raise SourceError(
                f"{name}: slot {key} must name exactly one of "
                f"{' or '.join(SLOT_SIDES)}, not {len(sides)}"
            )
        side = sides[0]
        anchor = entry[side]
        if anchor not in order:
            raise SourceError(f"{name}: slot {key} anchors to {anchor!r}, which is no element of this file")
        if alternatives_of[anchor]:
            choices = ", ".join(
                f"{one['group']}={one['option']}" for one in alternatives_of[anchor]
            )
            raise SourceError(
                f"{name}: slot {key} anchors to {anchor!r}, which shows only under "
                f"choice {choices}; a seat that disappears with a choice "
                "of prayer would drop the proper it holds"
            )
        propers = entry.get("propers") or []
        if not propers:
            raise SourceError(f"{name}: slot {key} receives no proper")
        for proper in propers:
            if not isinstance(proper, str) or not proper:
                raise SourceError(f"{name}: slot {key} names an empty proper")
            if proper in claimed:
                raise SourceError(
                    f"{name}: slots {claimed[proper]} and {key} both claim the "
                    f"proper {proper!r}; one proper has one seat"
                )
            claimed[proper] = key
        if not entry.get("locus"):
            raise SourceError(
                f"{name}: slot {key} cites no locus; a placement nobody can look up "
                "is a placement nobody can refute"
            )
        # An `after` seats the proper one place further on than a `before` on
        # the same element, which is what makes two slots on neighbouring
        # elements resolve to one position without either being ambiguous.
        at = order[anchor] + (1 if side == "after" else 0)
        if at < reached:
            raise SourceError(
                f"{name}: slot {key} sits before the slot declared above it; "
                "the slots are the order of the rite and must run forward"
            )
        reached = at
        held.append(
            {
                "key": key,
                "anchor": anchor,
                "where": side,
                "propers": list(propers),
                "qualified": bool(entry.get("qualified")),
                "locus": entry["locus"],
            }
        )
    if held and not source.get("slots_derived_from"):
        raise SourceError(
            f"{name}: slots are declared and slots_derived_from is not; a placement "
            "must say which book it was read from"
        )
    return held


# --------------------------------------------------------------- elements


def absent_pair(holder: dict, fallback: dict, absences: dict, key: str, name: str) -> dict:
    """Which of an element's two texts is missing, and under which recorded reason.

    Two texts, two reasons, and the difference is the whole point: a reader must
    be able to tell English that is absent because a licence withholds it from
    English that is absent because nobody has transcribed it yet. Collapsing
    both into one "missing" would hide exactly the distinction this layer exists
    to make visible.
    """
    out = {}
    for side in ABSENT_SIDES:
        field = "absent_" + side
        reason = holder.get(field, fallback.get(field))
        if reason is not None and reason not in absences:
            raise SourceError(f"{name}: {key} names absence {reason!r}, which the file does not state")
        out[side] = reason
    return out



def latin_side(
    section: dict, witnesses: dict, restricted: dict, library: dict, name: str
) -> tuple[dict[str, dict], dict | None, str | None]:
    """The section's Latin rows, keyed by element, or nothing where it has none.

    The 1861 printing sets Latin and English in facing columns, and until this
    existed only the English column could reach a page: `from_artifact` built an
    element's text from one column and `absent["latin"]` was always the
    section's reason, so `--lang la` could print nothing but the absence however
    much Latin the project held.

    A row with an empty `latin` field is refused rather than skipped. Absence is
    carried by NOT having a row, so an empty one is a row that should not exist,
    and letting it pass would turn a transcription gap into a silent blank.
    """
    artifact_id = section.get("artifact_latin")
    if not artifact_id:
        return {}, None, None
    witness_id = section.get("witness_latin") or section.get("witness")
    if (witness_id, "la") in restricted:
        raise SourceError(
            f"{name}: section {section['key']} attempts a Latin text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, "la"))
    if witness is None:
        raise SourceError(
            f"{name}: section {section['key']} draws Latin from {witness_id!r}, "
            "which is not declared as a witness for la"
        )
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for la; the rights check would not have covered it"
        )
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    grouped: dict[str, list[str]] = {}
    for row in payload_rows(record):
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        if not (row.get("latin") or "").strip():
            raise SourceError(
                f"{artifact_id}: row {key} carries no Latin; a section states an "
                "absence once and an empty row states it nowhere"
            )
        grouped.setdefault(key, []).append((row.get("latin") or "").strip())
    rows = {key: {"latin": "\n".join(lines)} for key, lines in grouped.items()}
    return rows, witness, witness_id


def artifact_provenance(section: dict, lang: str, key: str, name: str) -> dict:
    """The explicit text-to-edition relation for one artifact-backed side.

    Artifact-backed sections select their text at section granularity, so their
    provenance declaration lives there too.  It remains language-local: facing
    columns share row keys, not necessarily a relationship to the edition named
    by the calendar.  Requiring even `own` to be written prevents a missing
    declaration from silently becoming an identity claim.
    """
    side = SIDE_BLOCKS[lang]
    block = section.get(side)
    if not isinstance(block, dict):
        raise SourceError(
            f"{name}: section {section['key']} carries {lang} artifact text but "
            f"declares no [{side}] provenance block"
        )
    unknown = set(block) - ARTIFACT_PROVENANCE_FIELDS
    if unknown:
        raise SourceError(
            f"{name}: section {section['key']} [{side}] provenance declares "
            f"unknown fields {', '.join(sorted(unknown))}"
        )
    if block.get("relation") is None:
        raise SourceError(
            f"{name}: section {section['key']} [{side}] provenance declares no "
            "relation; artifact-backed text must state own or antecedent explicitly"
        )
    relation = relation_of(block, key, lang, name)
    if block["relation"] == "own":
        extras = set(block) - {"relation"}
        if extras:
            raise SourceError(
                f"{name}: section {section['key']} [{side}] relation is own but "
                f"also declares {', '.join(sorted(extras))}"
            )
    return relation


def artifact_exclusion_table(section: dict, source_keys: set[str],
                             name: str) -> dict[str, str]:
    """Target-recension nonmembers explicitly named from artifact row ids."""
    declared = section.get("exclusions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed exclusions"
        )
    held = {}
    for exclusion in declared:
        if not isinstance(exclusion, dict):
            raise SourceError(
                f"{name}: section {section['key']} has a non-table exclusion"
            )
        unknown = set(exclusion) - EXCLUSION_FIELDS
        missing = EXCLUSION_FIELDS - set(exclusion)
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: section {section['key']} exclusion has {'; '.join(detail)}"
            )
        element = exclusion["element"]
        basis = exclusion["basis"]
        if not isinstance(element, str) or not element:
            raise SourceError(f"{name}: section {section['key']} exclusion has no element")
        if element in held:
            raise SourceError(
                f"{name}: section {section['key']} excludes {element} twice"
            )
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} excludes {element!r}, which its "
                "English artifact does not hold"
            )
        if not isinstance(basis, str) or not basis.strip():
            raise SourceError(
                f"{name}: section {section['key']} exclusion {element} has no basis"
            )
        held[element] = basis
    return held


def artifact_latin_absence_overrides(
    section: dict, source_keys: set[str], latin_keys: set[str],
    absences: dict, name: str,
) -> dict[str, str]:
    """Inventory-owned absence classifications for English artifact rows.

    The source artifacts own the blocks they print.  Why one of those blocks
    has no facing Latin is a later finding and therefore stays in the inventory.
    Excluded target-recension rows may still be classified here: the override
    accounts for the source witness, while the exclusion separately prevents
    that source row from being emitted as target text.
    """
    declared = section.get("absent_latin_by_element")
    if declared is None:
        return {}
    if not isinstance(declared, dict) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed "
            "absent_latin_by_element"
        )
    held: dict[str, str] = {}
    for element, reason in declared.items():
        if not isinstance(element, str) or not element:
            raise SourceError(
                f"{name}: section {section['key']} has an empty Latin absence "
                "override key"
            )
        if not isinstance(reason, str) or not reason.strip():
            raise SourceError(
                f"{name}: section {section['key']} Latin absence override for "
                f"{element} has no reason"
            )
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} overrides Latin absence for "
                f"{element!r}, which its English artifact does not hold"
            )
        if element in latin_keys:
            raise SourceError(
                f"{name}: section {section['key']} overrides Latin absence for "
                f"{element!r}, whose Latin artifact already holds text"
            )
        if reason not in absences:
            raise SourceError(
                f"{name}: section {section['key']} Latin absence override for "
                f"{element} names {reason!r}, which the file does not state"
            )
        held[element] = reason
    return held


def artifact_turn_partition_table(section: dict, name: str) -> dict[tuple[str, str], list]:
    """Optional language-local partitions, addressed only by source row seq."""
    declared = section.get("turn_partitions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed turn_partitions"
        )
    held = {}
    for partition in declared:
        if not isinstance(partition, dict):
            raise SourceError(
                f"{name}: section {section['key']} has a non-table turn partition"
            )
        unknown = set(partition) - TURN_PARTITION_FIELDS - TURN_PARTITION_OPTIONAL_FIELDS
        missing = TURN_PARTITION_FIELDS - set(partition)
        if unknown or missing:
            detail = []
            if unknown:
                detail.append(f"unknown fields {', '.join(sorted(unknown))}")
            if missing:
                detail.append(f"missing fields {', '.join(sorted(missing))}")
            raise SourceError(
                f"{name}: section {section['key']} turn partition has "
                f"{'; '.join(detail)}"
            )
        element = partition["element"]
        lang = partition["lang"]
        if not isinstance(element, str) or not element:
            raise SourceError(
                f"{name}: section {section['key']} turn partition has no element"
            )
        language_row(lang)
        reach = (element, lang)
        if reach in held:
            raise SourceError(
                f"{name}: section {section['key']} repeats turn partition for "
                f"{element} in {lang}"
            )
        parts = partition["parts"]
        if not isinstance(parts, list) or not parts:
            raise SourceError(
                f"{name}: section {section['key']} turn partition for {element} "
                f"in {lang} has empty or malformed parts"
            )
        basis = partition.get("basis")
        if basis is not None and (not isinstance(basis, str) or not basis.strip()):
            raise SourceError(
                f"{name}: section {section['key']} turn partition for {element} "
                f"in {lang} has an empty basis"
            )
        roles = any(
            isinstance(part, dict) and part.get("dialogue_role") is not None
            for part in parts
        )
        glosses = any(isinstance(part, dict) and part.get("gloss") is True for part in parts)
        if (roles or glosses) and basis is None:
            raise SourceError(
                f"{name}: section {section['key']} turn partition for {element} "
                f"in {lang} declares a {'source gloss' if glosses and not roles else 'dialogue role'} without a basis; a role is "
                "read from where the controlling book prints its versicle and "
                "response marks, and the partition must say where"
            )
        held[reach] = parts
    return held


def artifact_incipit_markers(section: dict, source_keys: set[str], name: str) -> dict[str, str]:
    """Reviewed incipit cue letters, by element; see INCIPIT_MARKER_FIELDS."""
    declared = section.get("incipit_markers")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed incipit_markers"
        )
    held: dict[str, str] = {}
    for entry in declared:
        if not isinstance(entry, dict) or set(entry) != INCIPIT_MARKER_FIELDS:
            raise SourceError(
                f"{name}: section {section['key']} incipit marker must carry exactly "
                f"{', '.join(sorted(INCIPIT_MARKER_FIELDS))}"
            )
        element, marker = entry["element"], entry["printed_marker"]
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} declares an incipit marker for "
                f"{element!r}, which its artifact does not hold"
            )
        if element in held:
            raise SourceError(
                f"{name}: section {section['key']} repeats incipit marker for {element}"
            )
        if marker not in TURN_PRINTED_MARKERS:
            raise SourceError(
                f"{name}: section {section['key']} incipit marker for {element} is "
                f"{marker!r}; one of {', '.join(TURN_PRINTED_MARKERS)} is required"
            )
        held[element] = marker
    return held


def incipit_without_marker(incipit: str, marker: str | None, where: str,
                           name: str) -> str:
    """The incipit a heading may print, with a declared printed cue set apart."""
    if marker is None:
        if incipit and TURN_MARKER_HEAD.match(incipit):
            raise SourceError(
                f"{name}: {where} incipit opens with an undeclared printed cue; "
                "declare its incipit_markers entry after review or the heading "
                "would print the speaker letter"
            )
        return incipit
    spoken = incipit[len(marker) + 1:]
    if not incipit.startswith(marker + " ") or not spoken or spoken[0].isspace():
        raise SourceError(
            f"{name}: {where} declares incipit marker {marker!r}, but its incipit "
            "does not open with that marker followed by one space and words"
        )
    return spoken


def artifact_translation(
    section: dict, row_key: str, lang: str, text: str, witness: dict,
    witness_id: str, artifact_id: str, column: str, partitions: dict,
    library: dict, name: str,
) -> dict:
    """One artifact-backed translation plus any exact source-row partition."""
    translation = {
        "lang": witness["lang"],
        "source_id": witness_id,
        "rights": witness["rights"],
        "text": text,
    } | artifact_provenance(section, lang, row_key, name)
    parts = partitions.pop((row_key, lang), None)
    if parts is not None:
        side = SIDE_BLOCKS[lang]
        turns = structured_turns(
            {side + "_turns": parts}, side, library, artifact_id, [row_key],
            column, section["key"] + "/" + row_key, name, text,
            role_basis_checked=True,
        )
        translation["turns"] = turns
    return translation


def consistent_artifact_field(rows: list[dict], field: str, artifact_id: str,
                              key: str) -> str:
    """One element-level value across source rows, or an explicit refusal."""
    values = {
        (row.get(field) or "").strip()
        for row in rows
        if (row.get(field) or "").strip()
    }
    if len(values) > 1:
        raise SourceError(
            f"{artifact_id}: rows for {key} disagree on element-level {field}"
        )
    return next(iter(values), "")


def artifact_element_conditions(
    section: dict, source_keys: set[str], excluded: dict, options: dict,
    appointments: dict, name: str,
) -> dict[str, list[dict]]:
    """Applicability conditions on rows an artifact prints, by source row key.

    The artifact owns the row; whether the row applies on a given day is a
    later, sourced finding and therefore lives in the inventory, under the
    same closed condition vocabulary inline elements use.
    """
    declared = section.get("element_conditions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed element_conditions"
        )
    held: dict[str, list[dict]] = {}
    for entry in declared:
        if not isinstance(entry, dict) or set(entry) != ELEMENT_CONDITION_FIELDS:
            raise SourceError(
                f"{name}: section {section['key']} element_conditions rows carry "
                "exactly element and conditions"
            )
        element = entry["element"]
        if element not in source_keys:
            raise SourceError(
                f"{name}: section {section['key']} conditions {element!r}, which its "
                "English artifact does not hold"
            )
        if element in excluded:
            raise SourceError(
                f"{name}: section {section['key']} conditions excluded element {element}"
            )
        if element in held:
            raise SourceError(
                f"{name}: section {section['key']} conditions {element} twice"
            )
        held[element] = element_conditions(
            entry, options, section["key"] + "/" + element, name, appointments
        )
    return held


def through_markers(declared: object, where: str, name: str) -> dict[str, str]:
    """A `through` table: one nonblank marker per declared language."""
    if not isinstance(declared, dict) or not declared:
        raise SourceError(f"{name}: {where} through must be a nonempty table by language")
    for lang, marker in declared.items():
        language_row(lang)
        if not isinstance(marker, str) or not marker.strip():
            raise SourceError(f"{name}: {where} through for {lang} has no marker")
    return dict(declared)


def cut_through(translations: list[dict], markers: dict[str, str], where: str,
                name: str) -> list[dict]:
    """Each translation's exact prefix through its language's printed marker."""
    held = {row["lang"] for row in translations}
    if held != set(markers):
        raise SourceError(
            f"{name}: {where} declares a junction for {', '.join(sorted(markers))} "
            f"but holds text in {', '.join(sorted(held)) or 'no language'}; a row "
            "cut in one language and whole in another would pair unlike texts"
        )
    out = []
    for row in translations:
        if row.get("turns"):
            raise SourceError(f"{name}: {where} cannot cut a row partitioned into turns")
        marker = markers[row["lang"]]
        text = row["text"]
        if text.count(marker) != 1:
            raise SourceError(
                f"{name}: {where} junction marker for {row['lang']} occurs "
                f"{text.count(marker)} times; it must occur exactly once"
            )
        end = text.index(marker) + len(marker)
        if not text[end:].strip():
            raise SourceError(
                f"{name}: {where} junction for {row['lang']} cuts nothing; the "
                "marker ends the row"
            )
        out.append(dict(row) | {"text": text[:end].rstrip(), "through": marker})
    return out


def artifact_junction_table(section: dict, source_keys: set[str], excluded: dict,
                            name: str) -> dict[str, dict]:
    """Source rows the frame carries only through a printed junction."""
    declared = section.get("junctions")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: section {section['key']} has empty or malformed junctions")
    held: dict[str, dict] = {}
    for entry in declared:
        if not isinstance(entry, dict) or set(entry) != JUNCTION_FIELDS:
            raise SourceError(
                f"{name}: section {section['key']} junction rows carry exactly "
                f"{', '.join(sorted(JUNCTION_FIELDS))}"
            )
        element = entry["element"]
        if element not in source_keys or element in excluded or element in held:
            raise SourceError(
                f"{name}: section {section['key']} junction names {element!r}, which "
                "is no single emitted row of its artifact"
            )
        if not isinstance(entry["basis"], str) or not entry["basis"].strip():
            raise SourceError(f"{name}: section {section['key']} junction {element} has no basis")
        held[element] = {
            "through": through_markers(entry["through"], f"junction {element}", name),
            "basis": entry["basis"],
        }
    return held


def artifact_element_provenance(section: dict, keys: set[str], name: str) -> dict:
    """Element-level provenance blocks by (element, lang)."""
    declared = section.get("element_provenance")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed element_provenance"
        )
    held: dict[tuple[str, str], dict] = {}
    for entry in declared:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: section {section['key']} has a non-table provenance row")
        unknown = set(entry) - ELEMENT_PROVENANCE_FIELDS
        if unknown or "element" not in entry or "lang" not in entry:
            raise SourceError(
                f"{name}: section {section['key']} element_provenance rows carry element, "
                f"lang and provenance fields only"
            )
        element, lang = entry["element"], entry["lang"]
        language_row(lang)
        if element not in keys:
            raise SourceError(
                f"{name}: section {section['key']} declares provenance for {element!r}, "
                "which it does not emit"
            )
        if (element, lang) in held:
            raise SourceError(
                f"{name}: section {section['key']} declares provenance for {element} "
                f"in {lang} twice"
            )
        block = {k: v for k, v in entry.items() if k not in ("element", "lang")}
        if block.get("relation") != "antecedent":
            raise SourceError(
                f"{name}: section {section['key']} element provenance for {element} must "
                "declare relation = antecedent; an own relation needs no override"
            )
        held[(element, lang)] = block
    return held


def artifact_conditional_spans(section: dict, keys: set[str], name: str) -> dict:
    """Declared conditional words by (element, lang)."""
    declared = section.get("conditional_spans")
    if declared is None:
        return {}
    if not isinstance(declared, list) or not declared:
        raise SourceError(
            f"{name}: section {section['key']} has empty or malformed conditional_spans"
        )
    held: dict[tuple[str, str], list[dict]] = {}
    for entry in declared:
        if not isinstance(entry, dict) or set(entry) != CONDITIONAL_SPAN_FIELDS:
            raise SourceError(
                f"{name}: section {section['key']} conditional_spans rows carry exactly "
                f"{', '.join(sorted(CONDITIONAL_SPAN_FIELDS))}"
            )
        element, lang = entry["element"], entry["lang"]
        language_row(lang)
        if element not in keys:
            raise SourceError(
                f"{name}: section {section['key']} conditions words of {element!r}, "
                "which it does not emit"
            )
        said = entry["said"]
        if (
            not isinstance(said, dict)
            or set(said) != CONDITIONAL_SAID_FIELDS
            or said["anchor"] not in APPOINTMENT_ANCHORS
            or any(not isinstance(said[one], int) or isinstance(said[one], bool)
                   for one in ("from", "to"))
            or said["from"] > said["to"]
        ):
            raise SourceError(
                f"{name}: section {section['key']} conditional span on {element} needs "
                "said = {anchor, from, to} with a declared anchor and from <= to"
            )
        for field in ("text", "rubric", "locus"):
            if not isinstance(entry[field], str) or not entry[field].strip():
                raise SourceError(
                    f"{name}: section {section['key']} conditional span on {element} "
                    f"has no {field}"
                )
        held.setdefault((element, lang), []).append(
            {"text": entry["text"], "said": dict(said), "rubric": entry["rubric"],
             "locus": entry["locus"]}
        )
    return held


def artifact_inserted(
    section: dict, source_keys: set[str], excluded: dict, absences: dict,
    options: dict, appointments: dict, name: str,
    witnesses: dict | None = None, restricted: dict | None = None,
    library: dict | None = None,
) -> tuple[dict[str, list[dict]], dict[str, list[dict]]]:
    """Elements the inventory stands beside an artifact's rows.

    They exist for one purpose: where a day appoints a text this witness does
    not print (a proper Communicantes) or where nothing has established which
    text is appointed (the Preface), the frame still owes the reader the
    appointed text or a typed statement IN THE APPOINTED PLACE.  Each must be
    conditioned on an appointment, so it can never stand on a day it does not
    describe.  It is one of three things: a text-free stand-in naming both
    absences; a second occurrence of a row (`text_of`, optionally cut
    `through` a printed junction); or a text from another declared witness
    (`latin`/`english` blocks, resolved by `side_text` under that witness's
    own rights, with a typed absence for any language it does not reach).
    """
    declared = section.get("inserted")
    before: dict[str, list[dict]] = {}
    after: dict[str, list[dict]] = {}
    if declared is None:
        return before, after
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: section {section['key']} has empty or malformed inserted")
    seen: set[str] = set()
    for entry in declared:
        if not isinstance(entry, dict):
            raise SourceError(f"{name}: section {section['key']} has a non-table inserted row")
        unknown = set(entry) - INSERTED_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: section {section['key']} inserted row declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        key = entry.get("key")
        if not isinstance(key, str) or not APPOINTMENT_OPTION_RE.fullmatch(key):
            raise SourceError(f"{name}: section {section['key']} inserted row has no kebab-case key")
        if key in source_keys or key in seen:
            raise SourceError(
                f"{name}: section {section['key']} inserted key {key} collides with a row"
            )
        seen.add(key)
        sides = [one for one in ("before", "after") if entry.get(one)]
        if len(sides) != 1:
            raise SourceError(
                f"{name}: inserted {key} must name exactly one of before or after"
            )
        target = entry[sides[0]]
        if target not in source_keys or target in excluded:
            raise SourceError(
                f"{name}: inserted {key} stands {sides[0]} {target!r}, which is no "
                "emitted row of this section"
            )
        kind = entry.get("kind")
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{name}: inserted {key} has kind {kind!r}")
        conditions = element_conditions(
            entry, options, section["key"] + "/" + key, name, appointments
        )
        if not any(one["kind"] in ("appointed", "unappointed") for one in conditions):
            raise SourceError(
                f"{name}: inserted {key} carries no appointment condition; a text-free "
                "stand-in that is not tied to an appointment would print every day"
            )
        text_of = entry.get("text_of")
        own_text = [lang for lang, side in SIDE_BLOCKS.items() if entry.get(side)]
        translations = None
        if text_of is not None and own_text:
            raise SourceError(
                f"{name}: inserted {key} both repeats {text_of} and carries its own "
                "text; an occurrence adds no words"
            )
        if "through" in entry and text_of is None:
            raise SourceError(
                f"{name}: inserted {key} declares through without text_of; a "
                "junction cuts a repeated row and nothing else"
            )
        if text_of is not None:
            # A second occurrence of a row the book prints once and then cues
            # by incipit: the 1861 prints the Sanctus after the common Preface
            # only and ends every proper Preface "Holy, &c.".  The occurrence
            # carries that row's own text and absences, never new words; with
            # `through` it carries an exact prefix of them (the common
            # Preface as far as the asterisk at which a proper clause joins).
            if text_of not in source_keys or text_of in excluded:
                raise SourceError(
                    f"{name}: inserted {key} takes its text from {text_of!r}, which "
                    "is no emitted row of this section"
                )
            if "absent_english" in entry or "absent_latin" in entry:
                raise SourceError(
                    f"{name}: inserted {key} takes the text of {text_of}; its "
                    "absences are that row's and are not restated"
                )
            absent = {side: None for side in ABSENT_SIDES}
        elif own_text:
            # Text a witness other than the frame's artifact prints, from a
            # declared, publishable witness and checked exactly as an inline
            # element's: each language either reaches a text or names why not.
            where = section["key"] + "/" + key
            translations = [
                row for row in (
                    side_text(entry, language["lang"], witnesses or {}, restricted or {},
                              library or {}, where, name)
                    for language in LANGUAGES
                ) if row
            ]
            absent = absent_pair(entry, {}, absences, key, name)
            for language in LANGUAGES:
                if any(row["lang"] == language["lang"] for row in translations):
                    if absent[language["absent"]] is not None:
                        raise SourceError(
                            f"{name}: inserted {key} holds {language['lang']} text and "
                            "also names its absence"
                        )
                elif absent[language["absent"]] is None:
                    raise SourceError(
                        f"{name}: inserted {key} carries no {language['lang']} text and "
                        "names no absence; a silent gap is the one thing this layer "
                        "must never emit"
                    )
        else:
            absent = absent_pair(entry, {}, absences, key, name)
            if any(absent[side] is None for side in ABSENT_SIDES):
                raise SourceError(
                    f"{name}: inserted {key} must name both absences; it carries no text"
                )
        entry_name = entry.get("name")
        if entry_name is not None and (not isinstance(entry_name, str) or not entry_name.strip()):
            raise SourceError(f"{name}: inserted {key} has an empty name")
        if entry_name is None and not own_text:
            # A stand-in or occurrence is identified by its name; a text-bearing
            # continuation may stand under the heading of what it continues.
            raise SourceError(f"{name}: inserted {key} has no name")
        element = {
            "key": section["key"] + "/" + key,
            "kind": kind,
            "speaker": entry.get("speaker") or None,
            "name": entry_name,
            "latin_incipit": entry.get("latin_incipit") or None,
            "locus": None,
            "note": entry.get("note") or None,
            "variant": None,
            "alternatives": [],
            "conditions": conditions,
            "absent": absent,
            "translations": translations or None,
        }
        if text_of is not None:
            element["occurrence_of"] = section["key"] + "/" + text_of
            if "through" in entry:
                element["_through"] = through_markers(entry["through"], f"inserted {key}", name)
        (before if sides[0] == "before" else after).setdefault(target, []).append(element)
    return before, after


def artifact_additional_texts(
    section: dict, source_keys: set[str], excluded: dict, elements: list[dict],
    witnesses: dict, restricted: dict, library: dict, absences: dict, name: str,
) -> None:
    """Fill an absent language, preserving the original source finding.

    Source-specific absences were already checked against the section's own
    artifacts. A separately identified witness can supply that language here;
    it does not change what the base witness printed or the element's identity.
    All source, rights, relation and exact-row turn checks stay in side_text.
    """
    declared = section.get("additional_texts")
    if declared is None:
        return
    if not isinstance(declared, list) or not declared:
        raise SourceError(f"{name}: section {section['key']} has empty or malformed additional_texts")
    by_key = {element["key"]: element for element in elements}
    seen = set()
    for entry in declared:
        where = f"{name}: section {section['key']} additional_texts"
        if not isinstance(entry, dict):
            raise SourceError(f"{where} has a non-table entry")
        unknown = set(entry) - ADDITIONAL_TEXT_FIELDS
        if unknown:
            raise SourceError(f"{where} declares unknown fields {', '.join(sorted(unknown))}")
        local = entry.get("element")
        if not isinstance(local, str) or local not in source_keys or local in excluded:
            raise SourceError(f"{where} must name a nonexcluded original source element")
        key = section["key"] + "/" + local
        element = by_key.get(key)
        if element is None or element.get("occurrence_of"):
            raise SourceError(f"{where} cannot target an inserted or occurrence element")
        languages = [lang for lang, side in SIDE_BLOCKS.items() if side in entry]
        if len(languages) != 1:
            raise SourceError(f"{where} for {local} must declare exactly one language side")
        lang = languages[0]
        side = SIDE_BLOCKS[lang]
        if (local, lang) in seen:
            raise SourceError(f"{where} repeats {local} for {lang}")
        seen.add((local, lang))
        if any(row["lang"] == lang for row in element.get("translations") or []):
            raise SourceError(f"{where} for {local} cannot replace an already held {lang} side")
        reason = (element.get("absent") or {}).get(side)
        if not isinstance(reason, str) or reason not in absences:
            raise SourceError(f"{where} for {local} has no declared {lang} absence to resolve")
        block = entry[side]
        if not isinstance(block, dict) or not block:
            raise SourceError(f"{where} for {local} has an empty or malformed {side} source block")
        unknown = set(block) - ADDITIONAL_SIDE_FIELDS
        if unknown:
            raise SourceError(f"{where} for {local} declares unknown {side} fields {', '.join(sorted(unknown))}")
        for field in ("witness", "artifact", "column"):
            if not isinstance(block.get(field), str) or not block[field].strip():
                raise SourceError(f"{where} for {local} must explicitly declare a nonempty {field}")
        selectors = [field for field in ("element", "elements") if field in block]
        if len(selectors) != 1:
            raise SourceError(f"{where} for {local} must declare exactly one source element selector")
        selected = [block["element"]] if selectors[0] == "element" else block["elements"]
        if (not isinstance(selected, list) or not selected
                or any(not isinstance(one, str) or not one.strip() for one in selected)
                or len(selected) != len(set(selected))):
            raise SourceError(f"{where} for {local} needs distinct nonempty source element keys")
        if block.get("relation") not in RELATIONS:
            raise SourceError(f"{where} for {local} must explicitly declare its source relation")
        turns = side + "_turns"
        if element.get("kind") in ("prayer", "form", "dialogue") and turns not in entry:
            raise SourceError(
                f"{where} for {local} needs an exact {turns} partition for spoken text; "
                "a new witness cannot inherit the base element's speaker"
            )
        other_turns = [one + "_turns" for one in SIDE_BLOCKS.values() if one != side]
        if any(field in entry for field in other_turns):
            raise SourceError(f"{where} for {local} declares turns for a language it does not join")
        basis = entry.get("turns_basis")
        if turns in entry and (not isinstance(basis, str) or not basis.strip()):
            raise SourceError(f"{where} for {local} needs a nonempty turns_basis for its source-row partition")
        if turns not in entry and basis is not None:
            raise SourceError(f"{where} for {local} states turns_basis without a turn partition")
        translation = side_text(entry, lang, witnesses, restricted, library, key, name)
        if translation is None:
            raise SourceError(f"{where} for {local} did not resolve its declared {lang} side")
        element["translations"] = [*(element.get("translations") or []), translation]
        element["absent"][side] = None


def from_artifact(
    section: dict, witnesses: dict, restricted: dict, absences: dict,
    library: dict, name: str, options: dict | None = None,
    appointments: dict | None = None,
) -> tuple[list[dict], list[dict]]:
    """The elements of a section whose text an artifact holds.

    Nothing about order, part, kind, speaker or wording is restated in the
    inventory: every one of them is read from the artifact's own row, which is
    the row that carries the hash.
    """
    artifact_id = section["artifact"]
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: section {section['key']} names unknown artifact {artifact_id}")
    witness_id = section.get("witness")
    if (witness_id, "en") in restricted:
        raise SourceError(
            f"{name}: section {section['key']} attempts an English text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, "en"))
    if witness is None:
        raise SourceError(f"{name}: section {section['key']} names undeclared witness {witness_id!r}")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: section {section['key']} draws on {artifact_id}, which witness "
            f"{witness_id} does not list; the rights check would not have covered it"
        )
    latin_rows, latin_witness, latin_id = latin_side(
        section, witnesses, restricted, library, name
    )

    source_rows = payload_rows(record)
    source_order = []
    source_groups: dict[str, list[dict]] = {}
    for row in source_rows:
        key = (row.get("element_key") or "").strip()
        if not key:
            raise SourceError(f"{artifact_id}: a row has no element_key")
        if key not in source_groups:
            source_order.append(key)
            source_groups[key] = []
        source_groups[key].append(row)
    excluded = artifact_exclusion_table(section, set(source_groups), name)
    latin_absence_overrides = artifact_latin_absence_overrides(
        section, set(source_groups), set(latin_rows), absences, name
    )
    partitions = artifact_turn_partition_table(section, name)
    incipit_markers = artifact_incipit_markers(section, set(source_groups), name)
    conditioned = artifact_element_conditions(
        section, set(source_groups), excluded, options or {}, appointments or {}, name
    )
    inserted_before, inserted_after = artifact_inserted(
        section, set(source_groups), excluded, absences, options or {},
        appointments or {}, name, witnesses, restricted, library,
    )
    inserted_keys = {
        element["key"].split("/", 1)[1]
        for table in (inserted_before, inserted_after)
        for rows in table.values()
        for element in rows
    }
    emitted_keys = (set(source_groups) - set(excluded)) | inserted_keys
    junctions = artifact_junction_table(section, set(source_groups), excluded, name)
    element_provenance = artifact_element_provenance(section, emitted_keys, name)
    conditional_spans = artifact_conditional_spans(section, emitted_keys, name)

    elements = []
    exclusions = []
    for key in source_order:
        rows = source_groups[key]
        elements.extend(inserted_before.get(key, []))
        if key in excluded:
            if (key, "en") in partitions or (key, "la") in partitions:
                raise SourceError(
                    f"{name}: section {section['key']} declares turns for excluded "
                    f"element {key}"
                )
            sources = [
                {
                    "lang": "en",
                    "source_id": witness_id,
                    "artifact_id": artifact_id,
                    "element": key,
                }
                | artifact_provenance(section, "en", key, name)
            ]
            if key in latin_rows:
                sources.append(
                    {
                        "lang": "la",
                        "source_id": latin_id,
                        "artifact_id": section["artifact_latin"],
                        "element": key,
                    }
                    | artifact_provenance(section, "la", key, name)
                )
                latin_rows.pop(key)
            exclusions.append(
                {
                    "key": section["key"] + "/" + key,
                    "state": EXCLUSION_STATE,
                    "basis": excluded[key],
                    "sources": sorted({source["source_id"] for source in sources}),
                    "evidence": sources,
                }
            )
            continue
        kind = consistent_artifact_field(rows, "kind", artifact_id, key)
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{artifact_id}: row {key} has kind {kind!r}")
        english_lines = [(row.get("english") or "").strip() for row in rows]
        if any(english_lines) and not all(english_lines):
            raise SourceError(
                f"{artifact_id}: rows for {key} mix English text with empty rows; "
                "the section must state absence once, not between source turns"
            )
        english = "\n".join(english_lines) if all(english_lines) else ""
        incipit_marker = incipit_markers.pop(key, None)
        incipit = incipit_without_marker(
            consistent_artifact_field(rows, "latin_incipit", artifact_id, key),
            incipit_marker, f"element {section['key']}/{key}", name,
        )
        latin = (latin_rows.pop(key, {}) or {}).get("latin", "")
        absence_holder = {}
        if key in latin_absence_overrides:
            absence_holder["absent_latin"] = latin_absence_overrides[key]
        absent = absent_pair(absence_holder, section, absences, key, name)
        if english:
            absent["english"] = None
        elif absent["english"] is None:
            raise SourceError(
                f"{artifact_id}: row {key} has no English and its section names no "
                "reason; a silent gap is the one thing this layer must never emit"
            )
        if latin:
            absent["latin"] = None
        elif absent["latin"] is None:
            raise SourceError(
                f"{artifact_id}: row {key} has no Latin and its section names no "
                "reason; a silent gap is the one thing this layer must never emit"
            )
        translations = []
        if english:
            translations.append(
                artifact_translation(
                    section, key, "en", english, witness, witness_id, artifact_id,
                    "english", partitions, library, name,
                )
            )
        elif (key, "en") in partitions:
            raise SourceError(
                f"{name}: section {section['key']} declares English turns for {key}, "
                "which carries no English text"
            )
        if latin:
            translations.append(
                artifact_translation(
                    section, key, "la", latin, latin_witness, latin_id,
                    section["artifact_latin"], "latin", partitions, library, name,
                )
            )
        elif (key, "la") in partitions:
            raise SourceError(
                f"{name}: section {section['key']} declares Latin turns for {key}, "
                "which carries no Latin text"
            )
        speakers = {
            (row.get("speaker") or "").strip()
            for row in rows
            if (row.get("speaker") or "").strip()
        }
        if len(speakers) > 1 and not any(
            translation.get("turns") for translation in translations
        ):
            raise SourceError(
                f"{artifact_id}: rows for {key} name multiple speakers but no "
                "source-row turn partition"
            )
        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": next(iter(speakers)) if len(speakers) == 1 else None,
                "name": incipit or None,
                "latin_incipit": incipit or None,
                "locus": consistent_artifact_field(
                    rows, "printed_page", artifact_id, key
                ) or None,
                "note": consistent_artifact_field(
                    rows, "notes", artifact_id, key
                ) or None,
                "variant": None,
                "alternatives": [],
                "conditions": conditioned.get(key, []),
                "absent": absent,
                "translations": translations or None,
            }
            | ({"incipit_printed_marker": incipit_marker} if incipit_marker else {})
        )
        elements.extend(inserted_after.get(key, []))
    by_key = {element["key"]: element for element in elements}
    for element in elements:
        source = element.get("occurrence_of")
        if source:
            held = by_key[source]
            element["absent"] = dict(held["absent"])
            element["translations"] = [
                {key: value for key, value in row.items() if key != "turns"}
                for row in held["translations"] or []
            ] or None
            element["locus"] = held["locus"]
            if element["note"] is None:
                element["note"] = held["note"]
    prefix = section["key"] + "/"
    for element in elements:
        local = element["key"][len(prefix):]
        markers = element.pop("_through", None)
        where = f"element {element['key']}"
        if local in junctions:
            if element.get("occurrence_of"):
                raise SourceError(f"{name}: {where} is an occurrence; cut it with through")
            markers = junctions[local]["through"]
            element["junction"] = {"basis": junctions[local]["basis"]}
        if markers is not None:
            element["translations"] = cut_through(
                element["translations"] or [], markers, where, name)
        for lang in ("en", "la"):
            block = element_provenance.pop((local, lang), None)
            if block is None:
                continue
            rows = [row for row in element["translations"] or [] if row["lang"] == lang]
            if len(rows) != 1:
                raise SourceError(
                    f"{name}: {where} declares {lang} provenance but holds no {lang} text"
                )
            row = rows[0]
            for field in ("relation", "collation", "collation_finding", "note",
                          "target_wording", "coverage_relationship"):
                row.pop(field, None)
            row.update(relation_of(block, element["key"], lang, name))
        for lang in ("en", "la"):
            spans = conditional_spans.pop((local, lang), None)
            if spans is None:
                continue
            rows = [row for row in element["translations"] or [] if row["lang"] == lang]
            if len(rows) != 1:
                raise SourceError(
                    f"{name}: {where} conditions {lang} words but holds no {lang} text"
                )
            for span in spans:
                if rows[0]["text"].count(span["text"]) != 1:
                    raise SourceError(
                        f"{name}: {where} conditional words for {lang} must occur "
                        "exactly once in its text"
                    )
            rows[0]["conditional_spans"] = spans
    if element_provenance or conditional_spans:
        left = sorted(set(element_provenance) | set(conditional_spans))[0]
        raise SourceError(f"{name}: section {section['key']} leaves {left} unapplied")
    if latin_rows:
        raise SourceError(
            f"{name}: section {section['key']} carries Latin for "
            f"{', '.join(sorted(latin_rows))}, which its English artifact does not hold"
        )
    if incipit_markers:
        raise SourceError(
            f"{name}: section {section['key']} declares an incipit marker for "
            f"{sorted(incipit_markers)[0]}, which it does not emit"
        )
    if partitions:
        element, lang = sorted(partitions)[0]
        raise SourceError(
            f"{name}: section {section['key']} declares a turn partition for "
            f"{element} in {lang}, which its selected artifact text does not hold"
        )
    artifact_additional_texts(
        section, set(source_groups), excluded, elements,
        witnesses, restricted, library, absences, name,
    )
    return elements, exclusions


def artifact_text(library: dict, artifact_id: str, element: str, name: str,
                  column: str = "text") -> str:
    """One artifact element's words, out of the column that holds them.

    The column is named because the library does not use one name. Some
    artifacts carry `text`; the 1861 facing-column artifacts carry `latin`,
    beside the `seq`, `part`, `printed_page`, `ia_leaf` and `notes` that make
    the row checkable against the leaf. Guessing `text` on those raised nothing
    useful --- it raised KeyError from inside a dict comprehension --- so the
    column is declared by the block that draws on the artifact and refused here
    when the artifact does not have it.

    An empty cell is refused rather than joined. Absence is carried by NOT
    having a row, so an empty one is a row that should not exist, and letting it
    through would turn a transcription gap into a silent blank under a heading
    that names a missal.
    """
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: unknown artifact {artifact_id}")
    lines = []
    for row in payload_rows(record):
        if (row.get("element_key") or "").strip() != element:
            continue
        if column not in row:
            raise SourceError(
                f"{name}: {artifact_id} has no column {column!r}; it carries "
                f"{', '.join(sorted(one for one in row if one))}"
            )
        line = (row[column] or "").strip()
        if not line:
            raise SourceError(
                f"{name}: {artifact_id} row {element!r} carries nothing in "
                f"{column!r}; an absence is stated once and an empty cell states it nowhere"
            )
        lines.append(line)
    if not lines:
        raise SourceError(f"{name}: {artifact_id} holds no element {element!r}")
    return "\n".join(lines)


def relation_of(block: dict, key: str, lang: str, name: str) -> dict:
    """What this element is doing with that book, and what has been established.

    Declared per element and never on the witness, because it is a relation
    between two texts and not a property of a printing --- there is no
    antecedent edition of anything. The propers file records what happened when
    the two were run together into one invented witness id: it resolved nowhere,
    and 63 translations served under a bare dotted id with no label and no
    caution.
    """
    relation = block.get("relation")
    if relation is None:
        return {"relation": "own"}
    if relation not in RELATIONS:
        raise SourceError(
            f"{name}: element {key} declares relation {relation!r} for {lang}; "
            f"one of {', '.join(RELATIONS)} is required"
        )
    if relation not in NEEDS_RELATION_NOTE:
        return {"relation": relation}
    collation = block.get("collation")
    if collation not in COLLATIONS:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and declares "
            f"collation {collation!r}; one of {', '.join(COLLATIONS)} is required, "
            "because an established identity and an unestablished one must not look the same"
        )
    note = (block.get("note") or "").strip()
    if not note:
        raise SourceError(
            f"{name}: element {key} is {relation} for {lang} and states no note; "
            "a relation nobody can check is a claim nobody made"
        )
    out = {"relation": relation, "collation": collation, "note": note}
    finding = (block.get("collation_finding") or "").strip()
    if collation == "collated":
        if not finding:
            raise SourceError(
                f"{name}: element {key} claims a collated identity for {lang} and "
                "cites no finding; the grade would be an assertion, which is the "
                "one thing the other grade exists to be distinguished from"
            )
        out["collation_finding"] = finding
    elif finding:
        raise SourceError(
            f"{name}: element {key} is uncollated for {lang} and cites "
            f"{finding!r}; a citation on an uncollated row invites the reader to "
            "read it as the collation that was not made"
        )
    wording = block.get("target_wording")
    if wording is not None:
        if wording not in TARGET_WORDINGS:
            raise SourceError(
                f"{name}: element {key} declares target_wording {wording!r} for "
                f"{lang}; one of {', '.join(TARGET_WORDINGS)} is required"
            )
        if collation != "collated":
            raise SourceError(
                f"{name}: element {key} declares target_wording for {lang} without "
                "a collation; word-exactness is a collation finding or nothing"
            )
        out["target_wording"] = wording
        out["coverage_relationship"] = "exact-target"
    return out


def structured_turns(entry: dict, side: str, library: dict, artifact_id: str,
                     named: list[str], column: str, key: str, name: str,
                     parent_text: str, *, role_basis_checked: bool = False,
                     ) -> list[dict] | None:
    """Validate and project one side's explicit artifact-row turn partition.

    Turn boundaries are source row identities, never offsets or prose matches.
    The declarations must partition exactly the same rows, in the same order,
    that produced the parent translation.  This makes turns additive metadata:
    joining their text is byte-for-byte the already selected parent text.
    """
    field = side + "_turns"
    declarations = entry.get(field)
    if declarations is None:
        return None
    if not isinstance(declarations, list) or not declarations:
        raise SourceError(f"{name}: element {key} has an empty or malformed {field}")
    record = library.get(artifact_id)
    if record is None:
        raise SourceError(f"{name}: element {key} names unknown artifact {artifact_id}")
    payload = payload_rows(record)
    selected = []
    for element in named:
        selected.extend(
            row for row in payload
            if (row.get("element_key") or "").strip() == element
        )

    source_sequence = []
    source_rows = {}
    for row in selected:
        raw_seq = (row.get("seq") or "").strip()
        if not raw_seq.isdecimal():
            raise SourceError(
                f"{name}: {artifact_id} row for {key} has non-integer seq {raw_seq!r}"
            )
        seq = int(raw_seq)
        if seq in source_rows:
            raise SourceError(
                f"{name}: {artifact_id} repeats seq {seq}; turn boundaries would be ambiguous"
            )
        if column not in row:
            raise SourceError(
                f"{name}: {artifact_id} has no column {column!r} for turn seq {seq}"
            )
        text = (row[column] or "").strip()
        if not text:
            raise SourceError(
                f"{name}: {artifact_id} turn seq {seq} carries no {column!r} text"
            )
        source_sequence.append(seq)
        source_rows[seq] = text

    turns = []
    declared_sequence = []
    seen_keys = set()
    for declaration in declarations:
        if not isinstance(declaration, dict):
            raise SourceError(f"{name}: element {key} has a non-table turn in {field}")
        unknown = set(declaration) - TURN_FIELDS
        if unknown:
            raise SourceError(
                f"{name}: element {key} turn declares unknown fields "
                f"{', '.join(sorted(unknown))}"
            )
        turn_key = declaration.get("key")
        if not isinstance(turn_key, str) or not turn_key:
            raise SourceError(f"{name}: element {key} has a turn with no key in {field}")
        turn_key_parts = turn_key.split("-")
        if any(
            not part
            or not part.isascii()
            or not part.isalnum()
            or part.lower() != part
            for part in turn_key_parts
        ):
            raise SourceError(
                f"{name}: element {key} turn key {turn_key!r} is not stable kebab-case"
            )
        if turn_key in seen_keys:
            raise SourceError(f"{name}: element {key} repeats turn key {turn_key!r} in {field}")
        seen_keys.add(turn_key)

        sequence = declaration.get("seq")
        if (
            not isinstance(sequence, list)
            or not sequence
            or any(not isinstance(one, int) or isinstance(one, bool) for one in sequence)
        ):
            raise SourceError(
                f"{name}: element {key} turn {turn_key} needs a nonempty integer seq array"
            )
        declared_sequence.extend(sequence)

        speaker = declaration.get("speaker")
        if speaker is not None and speaker not in TURN_SPEAKERS:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} has speaker {speaker!r}; "
                f"one of {', '.join(TURN_SPEAKERS)} is required"
            )
        dialogue_role = declaration.get("dialogue_role")
        if dialogue_role is not None and dialogue_role not in TURN_DIALOGUE_ROLES:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} has dialogue_role "
                f"{dialogue_role!r}; one of {', '.join(TURN_DIALOGUE_ROLES)} is required"
            )
        action = declaration.get("action") if "action" in declaration else None
        if "action" in declaration and action is not True:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} action must be true or omitted"
            )
        if action and (speaker is not None or dialogue_role is not None):
            raise SourceError(
                f"{name}: element {key} turn {turn_key} cannot be both an action "
                "and a spoken turn"
            )
        gloss = declaration.get("gloss") if "gloss" in declaration else None
        if "gloss" in declaration and gloss is not True:
            raise SourceError(f"{name}: element {key} turn {turn_key} gloss must be true or omitted")
        if gloss and (speaker is not None or dialogue_role is not None or action):
            raise SourceError(f"{name}: element {key} turn {turn_key} source gloss cannot carry a speaker, dialogue role or action")
        printed_marker = declaration.get("printed_marker")
        if gloss and printed_marker is not None:
            raise SourceError(f"{name}: element {key} turn {turn_key} source gloss cannot carry a printed marker")
        if printed_marker is not None and printed_marker not in TURN_PRINTED_MARKERS:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} has printed_marker "
                f"{printed_marker!r}; one of {', '.join(TURN_PRINTED_MARKERS)} is required"
            )
        if printed_marker is not None and action:
            raise SourceError(
                f"{name}: element {key} turn {turn_key} is an action and cannot "
                "carry a printed speaker or response marker"
            )
        turns.append(
            {
                "key": turn_key,
                "speaker": speaker,
                "dialogue_role": dialogue_role,
                "action": action,
                "printed_marker": printed_marker,
                "text": None,
            } | ({"gloss": True} if gloss else {})
        )

    # The inline counterpart of the artifact partition's `basis` rule (C4,
    # 2026-10-19): a dialogue role is a reviewed reading of where the
    # controlling book prints its versicle and response marks, so a turn may
    # declare one only where the element's `turns_basis` says where.  The
    # Orate fratres roles, which predated the rule, were withdrawn on that
    # date because the 2002 Ordo n. 29 prints speaker rubrics only.  An
    # artifact turn partition has already been held to its own `basis` by
    # artifact_turn_partition_table, and says so with role_basis_checked.
    if not role_basis_checked and any(
        turn["dialogue_role"] is not None or turn.get("gloss") is True for turn in turns
    ) and not isinstance(entry.get("turns_basis"), str):
        raise SourceError(
            f"{name}: element {key} declares a {'source gloss' if any(turn.get('gloss') is True for turn in turns) else 'dialogue role'} in {field} without a "
            "turns_basis; a role is read from where the controlling book prints "
            "its versicle and response marks, and the element must say where"
        )

    if declared_sequence != source_sequence:
        raise SourceError(
            f"{name}: element {key} {field} seq {declared_sequence} does not exactly "
            f"partition source seq {source_sequence} in order"
        )
    offset = 0
    for turn, declaration in zip(turns, declarations):
        count = len(declaration["seq"])
        sequence = declared_sequence[offset:offset + count]
        turn["text"] = "\n".join(source_rows[one] for one in sequence)
        offset += count
        marker = turn["printed_marker"]
        if marker is not None:
            # Exactly the marker, one space, then spoken matter: the reader
            # removes precisely `len(marker) + 1` characters and nothing else.
            spoken = turn["text"][len(marker) + 1:]
            if (
                not turn["text"].startswith(marker + " ")
                or not spoken
                or spoken[0].isspace()
            ):
                raise SourceError(
                    f"{name}: element {key} turn {turn['key']} declares printed_marker "
                    f"{marker!r}, but its source row does not open with that marker "
                    "followed by one space and spoken text"
                )
        elif not turn["action"] and TURN_MARKER_HEAD.match(turn["text"]):
            raise SourceError(
                f"{name}: element {key} turn {turn['key']} opens with an undeclared "
                "printed cue; declare its printed_marker after review or the reader "
                "would set two cues on one turn"
            )
    if "\n".join(turn["text"] for turn in turns) != parent_text:
        raise SourceError(
            f"{name}: element {key} {field} changes the selected parent text"
        )
    return turns


def side_text(entry: dict, lang: str, witnesses: dict, restricted: dict, library: dict,
              key: str, name: str) -> dict | None:
    """One element's text in one language, from whichever edition holds it.

    Resolved identically for both languages. What differs between them is
    declared in the block --- the witness, the artifact, which of its elements,
    and the column --- and never inferred from which language is being asked
    for, so that adding the Latin could not quietly change what the English did.
    """
    side = SIDE_BLOCKS[lang]
    block = entry.get(side)
    if not block:
        if side + "_turns" in entry:
            raise SourceError(
                f"{name}: element {key} declares {side}_turns without a {side} text block"
            )
        return None
    witness_id = block.get("witness")
    if (witness_id, lang) in restricted:
        raise SourceError(
            f"{name}: element {key} attempts a {lang} text join to "
            f"rights-restricted witness {witness_id!r}"
        )
    witness = witnesses.get((witness_id, lang))
    if witness is None:
        raise SourceError(
            f"{name}: element {key} names undeclared witness {witness_id!r} for {lang}"
        )
    artifact_id = block.get("artifact")
    if artifact_id not in (witness.get("artifacts") or []):
        raise SourceError(
            f"{name}: element {key} draws on {artifact_id}, which witness "
            f"{witness_id} does not list for {lang}; the rights check would not "
            "have covered it"
        )
    # A list, because the granularity of a book is not the granularity of an
    # element. The Missal sets the Creed as one text where the 1861 sets it as
    # three, and the join has to be stated in the file rather than worked out by
    # anything downstream.
    named = block.get("elements") or ([block["element"]] if block.get("element") else [])
    if not named:
        raise SourceError(f"{name}: element {key} names no artifact element for {lang}")
    column = block.get("column") or "text"
    text = "\n".join(
        artifact_text(library, artifact_id, one, name, column) for one in named
    )
    translation = {
        "lang": lang,
        "source_id": witness_id,
        "rights": witness["rights"],
        "text": text,
    } | relation_of(block, key, lang, name)
    if (
        witness["rights"] == "project-created"
        and lang == "la"
        and translation.get("target_wording") is None
    ):
        # A project-created Latin text is an editorial projection.  Coverage
        # would read its rights as a study translation's; only a collated
        # word-exact finding gives it a relationship the vocabulary can state.
        raise SourceError(
            f"{name}: element {key} draws project-created Latin from "
            f"{witness_id} without a collated word-exact target_wording"
        )
    turns = structured_turns(
        entry, SIDE_BLOCKS[lang], library, artifact_id, named, column, key, name, text
    )
    if turns is not None:
        translation["turns"] = turns
    return translation


def from_inventory(
    section: dict, witnesses: dict, restricted: dict, absences: dict,
    options: dict, library: dict, name: str, appointments: dict | None = None,
) -> list[dict]:
    """The elements of a section the inventory states itself.

    Used where no artifact of the rite's own text exists to draw on. The
    inventory may still not hold a prayer: it holds the element's identity, its
    received Latin incipit, and either a licensed text drawn from an artifact or
    a named reason for the absence.
    """
    elements = []
    for entry in section.get("elements") or []:
        key = entry.get("key")
        if not isinstance(key, str) or not key:
            raise SourceError(f"{name}: an element of {section['key']} has no key")
        kind = entry.get("kind")
        if kind not in ELEMENT_KINDS:
            raise SourceError(f"{name}: element {key} has kind {kind!r}")
        variant, alternatives = element_alternatives(entry, options, key, name)
        conditions = element_conditions(entry, options, key, name, appointments)
        # Where an inline element's turns carry a speaker or a dialogue role,
        # `turns_basis` names the printing it was read from.  It is required
        # wherever a turn declares a dialogue role (structured_turns refuses
        # one without it) and optional for speakers alone; see
        # TURN_PARTITION_OPTIONAL_FIELDS for the artifact rule.
        turns_basis = entry.get("turns_basis")
        if turns_basis is not None:
            if not isinstance(turns_basis, str) or not turns_basis.strip():
                raise SourceError(f"{name}: element {key} has an empty turns_basis")
            if "latin_turns" not in entry and "english_turns" not in entry:
                raise SourceError(
                    f"{name}: element {key} states a turns_basis but declares no turns"
                )

        held = [
            row
            for row in (
                side_text(
                    entry, language["lang"], witnesses, restricted, library, key, name
                )
                for language in LANGUAGES
            )
            if row
        ]
        translations = held or None

        absent = absent_pair(entry, section, absences, key, name)
        # Per language, not per element. The refusal below used to be checked
        # for English alone, which was right while English was the only side an
        # element could carry: an element with a Latin text and no English and
        # no reason would have passed it silently, and a silent gap under a
        # heading naming a missal reads as a rite that omits the prayer.
        for language in LANGUAGES:
            reached = any(row["lang"] == language["lang"] for row in held)
            if reached:
                absent[language["absent"]] = None
            elif absent[language["absent"]] is None:
                raise SourceError(
                    f"{name}: element {key} carries no {language['lang']} text and "
                    "names no absence; a silent gap is the one thing this layer "
                    "must never emit"
                )

        elements.append(
            {
                "key": section["key"] + "/" + key,
                "kind": kind,
                "speaker": entry.get("speaker") or None,
                "name": entry.get("name") or entry.get("latin_incipit") or None,
                "latin_incipit": entry.get("latin_incipit") or None,
                "locus": entry.get("missal_number") or None,
                "note": entry.get("note") or None,
                "variant": variant,
                "alternatives": alternatives,
                "conditions": conditions,
                "absent": absent,
                "translations": translations,
            }
        )
    return elements


