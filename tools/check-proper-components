#!/usr/bin/env python3
"""Validate the provider-neutral component manifest used by proper guides."""

from __future__ import annotations

import argparse
import re
import subprocess
import sys
import tomllib
from pathlib import Path
# Shared CLI helpers live outside tools/ so that tmt's registry scan, which
# requires every file in tools/ to be a registered tool, stays clean.
sys.path.insert(0, str(Path(__file__).resolve().parents[1] / "scripts"))

from _tooling import Example, with_examples  # noqa: E402
from _proper_components import (  # noqa: E402
    audit_v2, liturgical_family, outputs as proper_outputs, relative_id,
)

# Captured transcripts, never composed; see scripts/_tooling.py.
EXAMPLES = {
    "": (
        Example(
            "tools/check-proper-components",
            (
                "Proper component manifests valid: 14.",
            ),
        ),
        Example(
            "tools/check-proper-components --list-synthesis",
            (
                "liturgy/roman-rite/1962/propers/temporal/49-ninth-after-pentecost-synthesis",
                "liturgy/roman-rite/1962/propers/temporal/50-tenth-after-pentecost-synthesis",
                "liturgy/roman-rite/1962/propers/temporal/51-eleventh-after-pentecost-synthesis",
                "... 11 more lines",
            ),
            "prints the synthesis leaf ids instead of the count",
        ),
    ),
}


ROOT = Path(__file__).resolve().parents[1]
MANIFEST = "proper-components.toml"
KEY_RE = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*")
KINDS = {
    "front-matter",
    "appointed-text",
    "proper-treatment",
    "brief-synthesis",
    "integrated-commentary",
    "source-grounded-synthesis",
    "exploratory-synthesis",
    "notable-quotable",
    "terminal-apparatus",
}
MODES = {"research", "synthesis"}
EVIDENCE = {
    "textual-observation",
    "documented-historical-orientation",
    "documented-reception",
    "source-grounded-synthesis",
    "exploratory-proposal",
}
LABELS = (
    "triptych:brief-synthesis:start",
    "triptych:brief-synthesis:end",
    "triptych:brief-synthesis:next",
)
# The profile's Reader-Facing Order fixes the brief synthesis at pages 3-4.
# Checking only that the three anchors are adjacent accepted a whole reader
# order displaced by a constant, which is exactly what a page-1 overflow
# produces; one did, and it was caught by a worker reading page numbers.
BRIEF_START_PAGE = 3
# The one value of a schema-1 manifest's optional reader_order field.
LEGACY_READER_ORDER = "legacy"
# Both profiles' Reader-Facing Order puts the notable gallery before the
# exploratory proposals, under these exact headings. They are matched as whole
# lines of the built PDF's text, because the manifest's component list is not
# what a leaf prints (see audit_manifest). Every schema-1 leaf prints both
# names; the two pc-s43 leaves printed "Interpretive Possibilities Across the
# Propers" until 87f8784d1 and 342cd1bd3.
NOTABLE_HEADING = re.compile(re.escape("The Propers: Notable and Quotable"))
EXPLORATORY_HEADING = re.compile(re.escape("The Propers: Interpretive Possibilities"))


def safe_file(leaf: Path, value: object, field: str) -> Path:
    if not isinstance(value, str) or not value:
        raise ValueError(f"{field} must be a nonempty relative path")
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        raise ValueError(f"{field} must remain inside the canonical leaf")
    resolved = leaf / path
    if not resolved.is_file():
        raise ValueError(f"{field} names a missing file: {value}")
    return resolved


def string_list(value: object, field: str, *, nonempty: bool = False) -> list[str]:
    if not isinstance(value, list) or not all(
        isinstance(item, str) and item for item in value
    ):
        raise ValueError(f"{field} must be a list of nonempty strings")
    if nonempty and not value:
        raise ValueError(f"{field} must not be empty")
    return value


def parse_manifest(path: Path) -> dict:
    data = tomllib.loads(path.read_text(encoding="utf-8"))
    if data.get("schema") not in {1, 2} or data.get("record_type") != "proper-components":
        raise ValueError("manifest requires schema = 1 or 2 and record_type = 'proper-components'")
    validate_reader_order(data)
    if data["schema"] == 2:
        proper_outputs(data)
        return data
    document = data.get("document")
    if not isinstance(document, str) or not document:
        raise ValueError("document must be a provider-relative canonical leaf id")
    if document.endswith("-synthesis"):
        raise ValueError("document must name the canonical research edition")
    outputs = data.get("outputs")
    if not isinstance(outputs, dict):
        raise ValueError("[outputs] is required")
    if outputs.get("research") != document:
        raise ValueError("outputs.research must equal document")
    if outputs.get("synthesis") != f"{document}-synthesis":
        raise ValueError("outputs.synthesis must equal document plus '-synthesis'")
    if outputs.get("web") != document:
        raise ValueError("outputs.web must name only the canonical research edition")
    completeness = data.get("appointed_text_completeness")
    if completeness not in {"complete", "rights-limited"}:
        raise ValueError(
            "appointed_text_completeness must be 'complete' or 'rights-limited'"
        )
    expected_label = "Full PDF" if completeness == "complete" else "Research PDF"
    if outputs.get("canonical_label") != expected_label:
        raise ValueError(
            f"outputs.canonical_label must be {expected_label!r} for "
            f"{completeness!r} appointed text"
        )
    if outputs.get("synthesis_label") != "Synthesis PDF":
        raise ValueError("outputs.synthesis_label must be 'Synthesis PDF'")
    return data


def audit_manifest(path: Path, provider_root: Path, *, phase: str = "content",
                   edition: str | None = None, build_root: Path | None = None) -> None:
    data = parse_manifest(path)
    if data["schema"] == 2:
        audit_v2(data, path, provider_root, phase=phase, edition=edition, build_root=build_root)
        return
    leaf = path.parent
    relative = str(leaf.relative_to(provider_root))
    if data["document"] != relative:
        raise ValueError(f"document must match canonical leaf id {relative!r}")
    safe_file(leaf, data.get("entrypoint"), "entrypoint")
    safe_file(leaf, data.get("synthesis_entrypoint"), "synthesis_entrypoint")

    element_keys = string_list(data.get("element_keys"), "element_keys", nonempty=True)
    if len(element_keys) != len(set(element_keys)):
        raise ValueError("element_keys contains a duplicate")
    if any(not KEY_RE.fullmatch(key) for key in element_keys):
        raise ValueError("element_keys must use stable lowercase kebab-case keys")

    components = data.get("components")
    if not isinstance(components, list) or not components:
        raise ValueError("[[components]] must declare the ordered component graph")
    keys: set[str] = set()
    records: dict[str, dict] = {}
    for index, component in enumerate(components):
        if not isinstance(component, dict):
            raise ValueError(f"components[{index}] must be a table")
        key = component.get("key")
        if not isinstance(key, str) or not KEY_RE.fullmatch(key):
            raise ValueError(f"components[{index}].key must be lowercase kebab-case")
        if key in keys:
            raise ValueError(f"duplicate component key {key!r}")
        keys.add(key)
        records[key] = component
        if component.get("kind") not in KINDS:
            raise ValueError(f"component {key!r} has an invalid kind")
        safe_file(leaf, component.get("path"), f"component {key!r} path")
        modes = string_list(component.get("modes"), f"component {key!r} modes", nonempty=True)
        if set(modes) - MODES or len(modes) != len(set(modes)):
            raise ValueError(f"component {key!r} has invalid or duplicate modes")
        string_list(component.get("depends_on", []), f"component {key!r} depends_on")
        references = string_list(
            component.get("references", []), f"component {key!r} references"
        )
        for reference in references:
            safe_file(leaf, reference, f"component {key!r} reference")
        bound = string_list(
            component.get("element_keys", []), f"component {key!r} element_keys"
        )
        if set(bound) - set(element_keys):
            raise ValueError(f"component {key!r} uses an undeclared element key")

    for key, component in records.items():
        dependencies = component.get("depends_on", [])
        if set(dependencies) - keys:
            raise ValueError(f"component {key!r} has an unknown dependency")
        for mode in component["modes"]:
            omitted = [
                dependency
                for dependency in dependencies
                if mode not in records[dependency]["modes"]
            ]
            if omitted:
                raise ValueError(
                    f"component {key!r} in {mode} depends on omitted component(s): "
                    + ", ".join(omitted)
                )

    kinds = [component["kind"] for component in components]
    required_once = {
        "appointed-text",
        "proper-treatment",
        "brief-synthesis",
        "source-grounded-synthesis",
        "exploratory-synthesis",
        "notable-quotable",
        "terminal-apparatus",
    }
    for kind in required_once:
        if kinds.count(kind) != 1:
            raise ValueError(f"exactly one {kind} component is required")
    by_kind = {
        component["kind"]: component for component in components
        if component["kind"] in required_once
    }
    integrated = [
        component for component in components
        if component["kind"] == "integrated-commentary"
    ]
    if len(integrated) > 1:
        raise ValueError("at most one integrated-commentary component is allowed")
    if set(by_kind["appointed-text"]["modes"]) != {"research"}:
        raise ValueError("appointed-text must occur only in research mode")
    treatment_modes = set(by_kind["proper-treatment"]["modes"])
    if integrated:
        if treatment_modes != {"research"}:
            raise ValueError(
                "proper-treatment must occur only in research mode when an "
                "integrated-commentary is declared"
            )
        if set(integrated[0]["modes"]) != {"synthesis"}:
            raise ValueError(
                "integrated-commentary must occur only in synthesis mode"
            )
    elif treatment_modes not in ({"research"}, MODES):
        raise ValueError(
            "proper-treatment must occur in research mode and may also occur "
            "in synthesis mode in a legacy manifest"
        )
    synthesis_required = {
        "brief-synthesis",
        "source-grounded-synthesis",
        "exploratory-synthesis",
        "notable-quotable",
        "terminal-apparatus",
    }
    for kind in synthesis_required:
        if set(by_kind[kind]["modes"]) != MODES:
            raise ValueError(f"{kind} must occur in both research and synthesis modes")
    ordered = [
        "brief-synthesis",
        "source-grounded-synthesis",
        "notable-quotable",
        "exploratory-synthesis",
    ]
    if integrated:
        ordered.insert(1, "integrated-commentary")
    positions = [kinds.index(kind) for kind in ordered]
    # The final two may be listed either way here. Most schema-1 manifests
    # list exploratory before notable, the order of the component list the
    # profiles once carried, while their leaves print notable first, as the
    # Reader-Facing Order requires. Refusing the list would refuse leaves that
    # print correctly, and in the scope phase would empty the Makefile's
    # --list-synthesis. The printed order is proved at build time instead, by
    # validate_tail_order.
    reversed_tail = positions[:-2] + positions[-2:][::-1]
    if positions != sorted(positions) and reversed_tail != sorted(positions):
        raise ValueError(
            "component order must be brief synthesis, integrated commentary, "
            "source-grounded synthesis, then notable and quotable and "
            "exploratory synthesis in either order (the build checks the "
            "printed order)"
        )

    relations = data.get("relations")
    if not isinstance(relations, list):
        raise ValueError("[[relations]] must declare synthesis relations")
    relation_keys: set[str] = set()
    for index, relation in enumerate(relations):
        if not isinstance(relation, dict):
            raise ValueError(f"relations[{index}] must be a table")
        key = relation.get("key")
        if not isinstance(key, str) or not KEY_RE.fullmatch(key) or key in relation_keys:
            raise ValueError(f"relations[{index}].key must be unique lowercase kebab-case")
        relation_keys.add(key)
        anchors = string_list(
            relation.get("element_keys"), f"relation {key!r} element_keys", nonempty=True
        )
        if len(set(anchors)) < 2 or set(anchors) - set(element_keys):
            raise ValueError(f"relation {key!r} must join at least two declared elements")
        evidence = string_list(
            relation.get("evidence"), f"relation {key!r} evidence", nonempty=True
        )
        if set(evidence) - EVIDENCE:
            raise ValueError(f"relation {key!r} has an invalid evidence class")


def aux_page(text: str, label: str) -> int:
    match = re.search(
        rf"\\newlabel\{{{re.escape(label)}\}}\{{\{{[^}}]*\}}\{{([0-9]+)\}}", text
    )
    if not match:
        raise ValueError(f"aux file lacks page marker {label!r}")
    return int(match.group(1))


def has_integrated_commentary(data: dict) -> bool:
    components = data.get("components")
    return isinstance(components, list) and any(
        isinstance(component, dict)
        and component.get("kind") == "integrated-commentary"
        for component in components
    )


def validate_reader_order(data: dict) -> None:
    """A declared legacy order belongs only to a legacy-shaped schema-1 manifest."""
    if "reader_order" not in data:
        return
    if data.get("schema") != 1 or data["reader_order"] != LEGACY_READER_ORDER:
        raise ValueError(
            f"reader_order may only be {LEGACY_READER_ORDER!r}, in a schema-1 manifest"
        )
    if has_integrated_commentary(data):
        raise ValueError(
            "reader_order = 'legacy' is refused beside an integrated-commentary: "
            "that manifest has had the revision that ends the legacy order"
        )


def legacy_reader_order(data: dict) -> str | None:
    """Why a manifest's research edition keeps an order older than the fixed one.

    The 1962 profile's Component architecture requires new and substantially
    revised guides to declare exactly one synthesis-only integrated-commentary
    and keeps "legacy manifests" valid until their next substantive revision.
    Its Reader-Facing Order names 49-ninth-after-pentecost, which front-loads
    the formulary ahead of the thematic movement, as legacy under that rule.
    So a 1962 schema-1 manifest without an integrated-commentary is legacy by
    its own data. The postconciliar profile has no integrated commentary, so
    its schema-1 manifests all look alike, and one that front-loads its
    formulary is legacy only if it says so with reader_order = 'legacy'.

    A legacy manifest keeps the whole older order, and that includes putting
    Interpretive Possibilities before Notable and Quotable. Both 49s print
    them that way in both editions. The page-3 exemption reaches only the
    research edition, because every legacy synthesis companion keeps page 3.
    The tail exemption reaches both editions.
    """
    if data.get("schema") != 1 or has_integrated_commentary(data):
        return None
    if liturgical_family(data.get("document", "")) == "roman-1962":
        return "1962 schema-1 manifest without integrated-commentary"
    if data.get("reader_order") == LEGACY_READER_ORDER:
        return "declared reader_order = 'legacy'"
    return None


def validate_brief_pages(aux: Path, *, fixed_start: bool = True) -> None:
    """Prove the brief synthesis fills exactly two pages and starts on page 3.

    The research edition and the synthesis companion carry the same markers
    and the same pages: both proper profiles put pages 1 and 2 first, the
    brief synthesis on pages 3-4 and reader-order position 4 on page 5. A
    legacy research edition is exempt from the start page, never from the
    two-page extent.
    """
    text = aux.read_text(encoding="utf-8", errors="replace")
    start, end, following = (aux_page(text, label) for label in LABELS)
    if end != start + 1 or following != start + 2:
        raise ValueError(
            "brief synthesis must occupy exactly two physical pages: "
            f"start={start}, end={end}, next={following}"
        )
    if fixed_start and start != BRIEF_START_PAGE:
        raise ValueError(
            "brief synthesis must begin on page "
            f"{BRIEF_START_PAGE}, as the profile fixes it, not page {start}: "
            "the reader order is displaced, most often by page 1 or page 2 "
            "overflowing"
        )


def built_pdf(aux: Path) -> Path:
    """The PDF the aux file was written beside, which a named build must have."""
    pdf = aux.with_suffix(".pdf")
    if not pdf.is_file():
        raise ValueError(
            f"no built PDF beside {aux}: a named document's printed order is "
            "checked on the PDF its aux file belongs to"
        )
    return pdf


def pdf_text(pdf: Path) -> str:
    result = subprocess.run(
        ["pdftotext", "-enc", "UTF-8", str(pdf), "-"],
        capture_output=True, text=True, timeout=120, check=False,
    )
    if result.returncode:
        raise ValueError(f"pdftotext failed for {pdf}: {result.stderr.strip()}")
    return result.stdout


def validate_tail_order(text: str) -> None:
    """Prove a built PDF prints Notable and Quotable before Interpretive Possibilities.

    Both proper profiles' Reader-Facing Order fixes that sequence. The text
    is pdftotext output; a heading is the first line that is nothing but the
    heading, and a page break's form feed does not hide one. A PDF that
    prints either heading nowhere fails, because a schema-1 manifest
    requires both components.
    """
    lines = [line.strip() for line in text.replace("\f", "\n").splitlines()]
    first = {}
    for name, pattern in (("Notable and Quotable", NOTABLE_HEADING),
                          ("Interpretive Possibilities", EXPLORATORY_HEADING)):
        first[name] = next(
            (index for index, line in enumerate(lines) if pattern.fullmatch(line)),
            None,
        )
        if first[name] is None:
            raise ValueError(f"PDF prints no {name} heading on a line of its own")
    if first["Interpretive Possibilities"] < first["Notable and Quotable"]:
        raise ValueError(
            "PDF prints Interpretive Possibilities before Notable and Quotable; "
            "the profile's Reader-Facing Order puts Notable and Quotable first"
        )


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--provider", default="gpt")
    parser.add_argument("--root", type=Path, default=ROOT)
    parser.add_argument("--phase", choices=("scope", "content", "artifacts"), default="content")
    parser.add_argument("--edition", choices=("research", "synthesis", "homily"))
    parser.add_argument("--build-root", type=Path, help="provider build directory (artifacts phase)")
    parser.add_argument("--document")
    parser.add_argument("--aux", type=Path)
    parser.add_argument("--list-synthesis", action="store_true")
    parser.add_argument("--list-homily", action="store_true")
    parser.add_argument("--list-derived", action="store_true")
    with_examples(parser, EXAMPLES[""])
    args = parser.parse_args()
    try:
        relative_id(args.provider, "provider")
        if "/" in args.provider:
            raise ValueError("provider must be one path component")
        if args.document:
            relative_id(args.document, "document")
    except ValueError as exc:
        parser.error(str(exc))
    provider_root = args.root / "src" / args.provider
    paths = (
        [provider_root / args.document / MANIFEST]
        if args.document
        else sorted(provider_root.rglob(MANIFEST))
    )
    errors = []
    for path in paths:
        try:
            if not path.is_file():
                raise ValueError(f"missing manifest {path}")
            audit_manifest(path, provider_root, phase=args.phase,
                           edition=args.edition, build_root=args.build_root)
        except (OSError, ValueError, tomllib.TOMLDecodeError) as exc:
            errors.append(f"{path}: {exc}")
    notes = []
    if args.aux:
        try:
            manifest = parse_manifest(paths[0]) if args.document else None
            if manifest is None or manifest["schema"] != 2:
                legacy = legacy_reader_order(manifest) if manifest is not None else None
                # Only the research edition carries the formulary and sweep a
                # legacy order front-loads; its companion keeps page 3.
                research = args.edition == "research"
                validate_brief_pages(args.aux, fixed_start=not (legacy and research))
                if manifest is None:
                    # Without --document there is no manifest to take a legacy
                    # status from, so the printed order cannot be judged. Every
                    # build names its document; say so rather than pass quietly.
                    print(
                        "proper-component warning: --aux without --document checks "
                        "the brief-synthesis pages only; the printed order of Notable "
                        "and Quotable and Interpretive Possibilities is not checked",
                        file=sys.stderr,
                    )
                elif legacy is None:
                    validate_tail_order(pdf_text(built_pdf(args.aux)))
                else:
                    extent = (
                        "research brief synthesis checked for its two-page "
                        f"extent, not its page-{BRIEF_START_PAGE} start; "
                        if research else ""
                    )
                    notes.append(
                        f"{args.document}: legacy reader order ({legacy}); "
                        f"{extent}Notable and Quotable not held ahead of "
                        "Interpretive Possibilities."
                    )
        except (OSError, ValueError, tomllib.TOMLDecodeError) as exc:
            errors.append(str(exc))
    if errors:
        for error in errors:
            print(f"proper-component error: {error}", file=sys.stderr)
        return 1
    if args.list_synthesis or args.list_homily or args.list_derived:
        for path in paths:
            data = parse_manifest(path)
            for mode in ("synthesis", "homily"):
                if (args.list_derived or getattr(args, f"list_{mode}")) and mode in data["outputs"]:
                    print(data["outputs"][mode])
        return 0
    for note in notes:
        print(note)
    print(f"Proper component manifests valid: {len(paths)}.")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
