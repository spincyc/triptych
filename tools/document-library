SORTS = ("leaf", "title", "pages", "revised")


def _title_of(document: Document) -> str | None:
    for issue in document.issues:
        if issue.kind == FULL:
            return issue.title.text
    return None


def _sort_key(sort: str):
    if sort == "title":
        return lambda document: ((_title_of(document) or "").lower(), document.leaf)
    if sort == "pages":
        return lambda document: (document.pages or 0, document.leaf)
    if sort == "revised":
        return lambda document: (document.provenance.revised, document.leaf)
    return lambda document: (document.leaf, document.provider)


def resolved_models(document: Document, by_key: dict[tuple[str, str], Document]) -> tuple[str, ...]:
    """Every model that contributed, following an inheritance pointer once.

    Six documents are set from a sibling's sources and record a pointer to it
    instead of a copy of its ledger. Resolving the pointer here, in the one pass
    that reads both, is what lets every consumer — the `--author` filter, the
    catalogue, the page's dropdown — ask a document which models wrote it
    without any of them re-implementing the hop.
    """
    if document.provenance.inherits is None:
        return document.models
    inherited = by_key.get((document.provider, document.provenance.inherits))
    return inherited.models if inherited is not None else ()


def selected(arguments: argparse.Namespace) -> tuple[tuple[Document, ...], dict]:
    """Read the corpus and narrow it to what the invocation asked for."""
    providers = (arguments.provider,) if arguments.provider else PROVIDERS
    found = documents(providers=providers, extents=not getattr(arguments, "brief", False))
    by_key = {document.key: document for document in found}
    rows = list(found)
    if getattr(arguments, "document", None):
        rows = [row for row in rows if row.leaf == arguments.document]
        if not rows:
            raise CorpusError(f"no document with leaf {arguments.document!r}")
    if getattr(arguments, "section", None):
        rows = [row for row in rows if row.section == arguments.section]
    if getattr(arguments, "eligibility", None):
        rows = [row for row in rows if row.eligibility == arguments.eligibility]
    if getattr(arguments, "author", None):
        rows = [row for row in rows if arguments.author in resolved_models(row, by_key)]
        if not rows:
            raise CorpusError(
                f"no document names {arguments.author!r} among its contributions"
            )
    rows.sort(key=_sort_key(getattr(arguments, "sort", "leaf") or "leaf"))
    return tuple(rows), by_key


def tally(rows: tuple[Document, ...]) -> dict:
    """How much there is: works, documents, issues, and pages.

    Pages are counted across documents and not across issues. A synthesis
    edition is the same document set a second time with parts left out, so
    adding its extent to the total would count the pages it shares with the
    full issue twice and report a corpus larger than the one that exists. The
    browser's own model counts it the same way, and `check` runs that model and
    holds the two to each other — which is how this was found, at 5,757 pages
    against a real 5,675.
    """
    return {
        "works": len({row.leaf for row in rows}),
        "documents": len(rows),
        "issues": sum(len(row.issues) for row in rows),
        "pages": sum(row.pages or 0 for row in rows),
    }


# --- check -----------------------------------------------------------------


def run_check(arguments: argparse.Namespace) -> dict:
    """Compare every derived title and subject with the PDF that was built.

    This is the whole gate, and it is the only kind that would have caught the
    defect this tool was most likely to ship: a title that resolves, reads
    correctly, and names the document something it is not. A regex over
    `main.tex` produced exactly that for thirty-four documents — plausible
    short titles, none of them what the PDF prints — and nothing but a
    comparison against the built artifact distinguished them from the hundred
    and fifty-two it got right.
    """
    rows, by_key = selected(arguments)
    confirmed, unconfirmed, unrecorded, unbuilt = 0, [], [], []
    for row in rows:
        for issue in row.issues:
            if issue.title.absent:
                unrecorded.append(f"{row.provider} {issue.stem}: {issue.title.absent}")
            if issue.pdf is None:
                unbuilt.append(f"{row.provider} {issue.stem}: {issue.pdf_absent}")
                continue
            metadata = read_pdf(ROOT / issue.pdf)
            if issue.title.text is not None and metadata.title != issue.title.text:
                unconfirmed.append(
                    f"{issue.pdf}: source states {issue.title.text!r}, "
                    f"the PDF carries {metadata.title!r}"
                )
            elif (metadata.subject or None) != issue.title.subject:
                unconfirmed.append(
                    f"{issue.pdf}: source states subject {issue.title.subject!r}, "
                    f"the PDF carries {metadata.subject!r}"
                )
            elif issue.title.text is not None:
                confirmed += 1
    if unconfirmed:
        raise CorpusError("; ".join(unconfirmed[:3]) + _and_more(unconfirmed, 3))

    replayed, skipped = replay_browser_model(catalogue(rows, by_key))
    if replayed:
        raise CorpusError("; ".join(replayed[:3]) + _and_more(replayed, 3))
    return {
        **tally(rows),
        "confirmed": confirmed,
        "unrecorded": unrecorded,
        "unbuilt": unbuilt,
        "replayed": skipped or BROWSER_MODEL.as_posix(),
        "status": "ok",
    }


def _and_more(items: list[str], shown: int) -> str:
    return f" (and {len(items) - shown} more)" if len(items) > shown else ""


# --- the page's own derivation, replayed ------------------------------------
#
# The catalogue states four summaries — how much there is, and how much of it
# each edition, each model and each section accounts for — and the page derives
# the same four out of the works array every time a control moves. Two
# derivations of one count is the pairing this repository has been bitten by, so
# rather than trusting them to agree this runs the browser's own file under node
# and compares. A control that offers a model no document will match, or a total
# that disagrees with the rows under it, fails here instead of on the site.

HARNESS = """
const fs = require('fs');
const source = fs.readFileSync(process.argv[1], 'utf8');
const holder = { exports: {} };
new Function('module', 'exports', source)(holder, holder.exports);
const model = holder.exports;
const catalogue = JSON.parse(fs.readFileSync(process.argv[2], 'utf8'));
const works = catalogue.works || [];

function count(state) {
  return model.tally(model.narrow(works, Object.assign(
    { author: '', edition: '', section: '', reading: '', sort: 'section', find: '' },
    state
  )));
}

const answer = {
  whole: count({}),
  providers: {},
  models: {},
  sections: {},
  orders: {}
};
for (const provider of catalogue.providers || []) {
  answer.providers[provider.id] = count({ edition: provider.id }).documents;
}
for (const one of catalogue.models || []) {
  answer.models[one.id] = count({ author: one.id }).documents;
}
for (const section of catalogue.sections || []) {
  answer.sections[section.id] = count({ section: section.id }).works;
}
// Every ordering must be a permutation of the same set: a sort that dropped or
// duplicated a work would show a different corpus depending on the control.
const everything = model.narrow(works, {
  author: '', edition: '', section: '', reading: '', sort: 'section', find: ''
});
for (const sort of ['section', 'title', 'revised', 'pages']) {
  const ordered = model.order(everything.slice(), sort);
  answer.orders[sort] = ordered.map(function (row) { return row.work.leaf; }).sort();
}
process.stdout.write(JSON.stringify(answer));
"""


def replay_browser_model(built: dict) -> tuple[list[str], str]:
    """Run the page's model over the catalogue and hold it to the summaries."""
    model = ROOT / BROWSER_MODEL
    if not model.is_file():
        return ([f"{BROWSER_MODEL.as_posix()}: not found"], "")
    scratch = ROOT / "build" / "document-library-replay.json"
    scratch.parent.mkdir(parents=True, exist_ok=True)
    scratch.write_text(_serialise(built), encoding="utf-8")
    try:
        completed = subprocess.run(
            ["node", "-e", HARNESS, str(model), str(scratch)],
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        return ([], "node is not installed; the page's own derivation was not replayed")
    finally:
        scratch.unlink(missing_ok=True)
    if completed.returncode != 0:
        return ([f"the page's derivation failed: {completed.stderr.strip()}"], "")

    answer = json.loads(completed.stdout)
    problems: list[str] = []
    for field in ("works", "documents", "pages"):
        if answer["whole"][field] != built["counted"][field]:
            problems.append(
                f"the page counts {answer['whole'][field]} {field} where the "
                f"catalogue states {built['counted'][field]}"
            )
    if answer["whole"]["unrecorded"] != built["counted"]["titles_unrecorded"]:
        problems.append(
            f"the page counts {answer['whole']['unrecorded']} unrecorded titles "
            f"where the catalogue states {built['counted']['titles_unrecorded']}"
        )
    for kind, key, rows in (
        ("providers", "documents", built["providers"]),
        ("models", "documents", built["models"]),
        ("sections", "works", built["sections"]),
    ):
        for row in rows:
            selected_count = answer[kind].get(row["id"])
            if selected_count != row[key]:
                problems.append(
                    f"choosing {row['id']!r} selects {selected_count} {key} where "
                    f"the catalogue offers it as {row[key]}"
                )
    whole = sorted(work["leaf"] for work in built["works"])
    for sort, leaves in answer["orders"].items():
        if leaves != whole:
            problems.append(f"ordering by {sort} does not return every work exactly once")
    return (problems, "")


