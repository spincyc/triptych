# The page's own derivation — what a choice selects, what a document is called,
# and in what order. It exists once, in the browser, because the browser is
# what performs it; re-deriving it here in Python would be the second copy this
# repository keeps being bitten by. `check` runs that file instead.
BROWSER_MODEL = Path("src/web/browser/texts/catalogue-model.js")

# The two editions, named as ABOUT.md names them: "one by GPT and one by
# Claude". The label is here and nowhere else, so a page cannot invent a third
