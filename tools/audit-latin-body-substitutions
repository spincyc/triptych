#!/usr/bin/env python3
"""Report Latin bodies whose tokens read as a known word, damaged.

The pattern screen in `scripts/_latin_body_damage.py` refuses damage it can
describe: an accent read as a digit, the ae ligature read as se or x, u read as
ii. It cannot catch damage that produces a real Latin-looking word -- `seterna`
for `aeterna`, `quassumus` for `quaesumus`, `animas` for `animae` -- and neither
can agreement between witnesses, because the SAME recogniser error recurs across
independent scans of different books. A lane that compared four witnesses and an
8,536-form consensus lexicon still shipped five such tokens.

What does catch them is asking a different question: does this token become a
word the corpus already uses, under exactly one substitution from the damage
families? A token that does is almost certainly that word, damaged. On 2026-09-03
this found six in bodies already committed, against two false positives it
reported honestly -- `per maris undas`, the sea St Raymund crossed, and
`imitatores effecti`, an ordinary participle.

It reports; it does not decide, and it never edits. Every hit is a candidate for
someone to read on a page image, which is the only thing that settles one.
"""

from __future__ import annotations

import argparse
import collections
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / "scripts"))

import yaml  # noqa: E402

# Each pair is a substitution this corpus's recognisers actually make, written
# damaged-form first.
SUBSTITUTIONS = (
    ("se", "ae"), ("s", "ae"), ("e", "ae"), ("as", "ae"), ("es", "ae"),
    ("ii", "u"), ("i", "u"), ("rn", "m"), ("m", "rn"),
    ("l", "ll"), ("ll", "l"), ("c", "e"), ("e", "c"), ("t", "f"), ("f", "t"),
)
# A form the corpus uses this often, across bodies, is treated as known-good.
GOLD_THRESHOLD = 3
# Only propose a correction toward a form the corpus uses at least this often,
# so a rare word is not "corrected" into a common one.
TARGET_THRESHOLD = 5
SHORTEST = 4
# Words the audit proposes a correction for and should not: each was opened on
# the 1962 page image and prints exactly as stored. `per maris undas
# mirabiliter traduxisti` is the sea St Raymund crossed, not a damaged Mariae;
# `imitatores effecti` is an ordinary participle, not a damaged effectu. Keyed
# by the body so a genuine damage of the same form elsewhere still reports.
READ_ON_THE_PAGE = {
    ("s-raymundi-penafort-confessoris", "Collect", "maris"),
    ("s-silvestri-abbatis", "Secret", "effecti"),
}
# Settled on grammar rather than on the page, which is weaker and is recorded as
# such: `beatae Monicae pias lacrimas` is an accusative plural agreeing with its
# own noun, and `nos in tua simus voluntate concordes` is a present subjunctive.
# Either would be worth a page reading if it ever mattered to a publication
# decision; neither is a substitution the corpus supports.
SETTLED_ON_GRAMMAR = {
    ("s-monicae-viduae", "Collect", "pias"),
    ("s-augustini-episcopi-confessoris", "Collect", "simus"),
    # "et dictis exsequamur, et factis" -- an ablative plural parallel to
    # dictis, not a damaged factus.
    ("epiphany-6", "Collect", "factis"),
    # "sanctificet animas nostras" -- accusative plural object.
    ("s-lucae-evangelistae", "Postcommunion", "animas"),
    # "imitatores effecti, consortes simus et gloriae" -- participle and
    # subjunctive, both ordinary.
    ("s-ioannis-cantii-confessoris", "Postcommunion", "effecti"),
    ("s-ioannis-cantii-confessoris", "Postcommunion", "simus"),
    # "Sancte Dominice, ora" -- St Dominic in the vocative, not a damaged
    # dominicae.
    ("easter-vigil", "Litany of the Saints, first part", "dominice"),
    # "Ecclesiae tuae filiis" -- ablative plural, not a damaged filius.
    ("easter-vigil", "Oration after the Third Prophecy", "filiis"),
}


def tokens(text: str) -> list[str]:
    return [word.strip(".,:;!?'’()-").lower() for word in re.findall(r"[^\s]+", text)]


def bodies(document: dict):
    for section in document["sections"].values():
        for mass in section.get("masses") or []:
            for proper in mass.get("propers") or []:
                if isinstance(proper, dict) and proper.get("text"):
                    yield mass["key"], proper["name"], proper["text"]


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--calendar", default="roman-1962")
    arguments = parser.parse_args()
    path = ROOT / f"src/sources/calendars/{arguments.calendar}/propers.yaml"
    document = yaml.safe_load(path.read_text(encoding="utf-8"))

    every = list(bodies(document))
    frequency = collections.Counter(
        word for _, _, text in every for word in tokens(text) if word
    )
    gold = {word for word, count in frequency.items() if count >= GOLD_THRESHOLD}

    hits: list[tuple[str, str, str, str]] = []
    for mass, proper, text in every:
        for word in tokens(text):
            if not word or word in gold or len(word) < SHORTEST:
                continue
            for damaged, true in SUBSTITUTIONS:
                if damaged not in word:
                    continue
                candidate = None
                for index in range(len(word)):
                    if word.startswith(damaged, index):
                        maybe = word[:index] + true + word[index + len(damaged):]
                        if maybe in gold and frequency[maybe] >= TARGET_THRESHOLD:
                            candidate = maybe
                            break
                known = READ_ON_THE_PAGE | SETTLED_ON_GRAMMAR
                if candidate and (mass, proper, word) not in known:
                    hits.append((mass, proper, word, candidate))
                    break
                if candidate:
                    break

    for mass, proper, word, candidate in sorted(hits):
        print(f"{mass}/{proper}\t{word}\treads as\t{candidate}")
    print(
        f"{len(every)} bodies, {len(frequency)} distinct tokens, "
        f"{len(gold)} known forms, {len(hits)} to read on a page image",
        file=sys.stderr,
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
