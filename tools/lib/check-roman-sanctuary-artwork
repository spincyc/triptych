#!/usr/bin/env python3
"""Validate Roman Sanctuary Dictionary artwork identity and object coverage."""

from __future__ import annotations

import argparse
import hashlib
import re
import struct
import sys
import tomllib
from pathlib import Path


REPO = Path(__file__).resolve().parents[2]
DEFAULT_OWNER = (
    REPO
    / "src/gpt/liturgy/roman-rite/1962/reference/roman-sanctuary-dictionary"
)
DICTIONARY_PREFIX = (
    "src/gpt/liturgy/roman-rite/1962/reference/roman-sanctuary-dictionary/"
)
ID = {
    "art": re.compile(r"^art-[a-z0-9]+(?:-[a-z0-9]+)*$"),
    "obj": re.compile(r"^obj-[a-z0-9]+(?:-[a-z0-9]+)*$"),
    "var": re.compile(r"^var-[a-z0-9]+(?:-[a-z0-9]+)*$"),
    "src": re.compile(r"^src-[a-z0-9]+(?:-[a-z0-9]+)*$"),
    "plt": re.compile(r"^plt-[a-z0-9]+(?:-[a-z0-9]+)*$"),
    "ed": re.compile(r"^ed-[a-z0-9]+(?:-[a-z0-9]+)*$"),
}
VIEWS = {
    "isolated", "front", "back", "side", "top", "folded", "unfolded",
    "open", "closed", "worn", "in-use", "context-inset", "detail",
    "comparison", "composition",
}
WORKFLOW = {
    "generated", "factual-review-passed", "visual-review-passed",
    "plate-review-passed", "consumer-review-passed", "rejected",
}
REVIEWS = {"pending", "passed", "failed", "not-applicable"}
BOUNDARY_TREATMENTS = {
    "transparent", "page-ground", "intentional-frame", "full-bleed",
}
ART_FIELDS = {
    "id", "object_ids", "variant_ids", "view", "workflow_state", "purpose",
    "depicted_state", "source_controlled_features", "deliberate_omissions",
    "brief", "exact_prompt", "generator", "generated_on", "asset", "received",
    "normalized", "reference_ids", "precursor_ids", "corrections",
    "baked_content_audit", "tex_overlays",
    "consumer_plate_ids", "consumer_edition_ids", "rights", "reviews",
}
ASSET_FILE_REQUIRED_FIELDS = {"id", "path", "state", "audit_record", "technical"}
ASSET_FILE_OPTIONAL_FIELDS = {
    "boundary_treatment", "boundary_treatment_rationale",
}
ASSET_FILE_FIELDS = ASSET_FILE_REQUIRED_FIELDS | ASSET_FILE_OPTIONAL_FIELDS
ROOT_FIELDS = {
    "schema_version", "manifest_id", "owner", "asset_root", "status",
    "asset_files", "artwork_links", "artworks", "coverage",
}


class Problems:
    def __init__(self) -> None:
        self.items: list[str] = []
        self.notices: list[str] = []

    def add(self, message: str) -> None:
        self.items.append(message)

    def check(self, condition: bool, message: str) -> None:
        if not condition:
            self.add(message)

    def notice(self, message: str) -> None:
        self.notices.append(message)


def load_toml(path: Path) -> dict:
    try:
        return tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ValueError(f"{path}: {exc}") from exc


def string_list(value: object, field: str, problems: Problems) -> list[str]:
    if not isinstance(value, list) or not all(
        isinstance(item, str) and item for item in value
    ):
        problems.add(f"{field} must be a list of nonempty strings")
        return []
    return value


def safe_relative(value: object, field: str, problems: Problems) -> Path | None:
    if not isinstance(value, str) or not value:
        problems.add(f"{field} must be a nonempty relative path")
        return None
    path = Path(value)
    if path.is_absolute() or ".." in path.parts:
        problems.add(f"{field} must remain inside the dictionary owner")
        return None
    return path


def canonical_asset_path(value: str) -> str:
    return value[len(DICTIONARY_PREFIX):] if value.startswith(DICTIONARY_PREFIX) else value


def png_properties(path: Path) -> tuple[int, int, int, str]:
    header = path.read_bytes()[:29]
    if len(header) < 29 or header[:8] != b"\x89PNG\r\n\x1a\n":
        raise ValueError("not a PNG")
    width, height, bit_depth, color_type = struct.unpack(">IIBB", header[16:26])
    modes = {0: "grayscale", 2: "rgb", 3: "indexed", 4: "grayscale-alpha", 6: "rgba"}
    return width, height, bit_depth, modes.get(color_type, f"png-type-{color_type}")


def object_records(owner: Path, glob: str, excluded: set[str], problems: Problems) -> dict[str, dict]:
    records: dict[str, dict] = {}
    for path in sorted(owner.glob(glob)):
        relative = path.relative_to(owner).as_posix()
        if relative in excluded:
            continue
        try:
            data = load_toml(path)
        except ValueError as exc:
            problems.add(str(exc))
            continue
        object_id = data.get("id")
        if not isinstance(object_id, str) or not ID["obj"].fullmatch(object_id):
            problems.add(f"{relative}: invalid or missing object ID")
            continue
        if object_id in records:
            problems.add(f"duplicate object ID: {object_id}")
            continue
        data["_path"] = relative
        records[object_id] = data
    return records


def asset_local_staging_path(path: Path, problems: Problems) -> bool:
    """Recognize an explicitly reviewed asset-local staging PNG.

    Staging records are not canonical manifest admission.  They remain
    discoverable beside their pixels while an admitted deterministic
    derivative receives a separate canonical manifest identity.
    """
    sidecar = path.with_suffix(".toml")
    if not sidecar.is_file():
        return False
    try:
        data = load_toml(sidecar)
    except ValueError as exc:
        problems.add(str(exc))
        return False
    artwork_id = data.get("artwork_id")
    review_state = data.get("review_state")
    digest = data.get("sha256")
    if not (
        isinstance(artwork_id, str)
        and ID["art"].fullmatch(artwork_id)
        and isinstance(review_state, str)
        and review_state
        and isinstance(digest, str)
        and re.fullmatch(r"[0-9a-f]{64}", digest)
    ):
        problems.add(f"{sidecar}: incomplete asset-local staging identity")
        return False
    problems.check(
        hashlib.sha256(path.read_bytes()).hexdigest() == digest,
        f"{sidecar}: staging sha256 does not match adjacent PNG",
    )
    return True


def validate_boundary_treatment(entry: dict, label: str, problems: Problems) -> None:
    treatment_present = "boundary_treatment" in entry
    rationale_present = "boundary_treatment_rationale" in entry
    if not treatment_present:
        if rationale_present:
            problems.add(
                f"{label}.boundary_treatment_rationale requires boundary_treatment"
            )
        return

    treatment = entry.get("boundary_treatment")
    if treatment not in BOUNDARY_TREATMENTS:
        problems.add(f"{label}.boundary_treatment has invalid state")
        return

    if treatment in {"intentional-frame", "full-bleed"}:
        rationale = entry.get("boundary_treatment_rationale")
        problems.check(
            isinstance(rationale, str) and bool(rationale.strip()),
            f"{label}.boundary_treatment_rationale must be nonempty for {treatment}",
        )
    elif rationale_present:
        problems.add(
            f"{label}.boundary_treatment_rationale is not allowed for {treatment}"
        )


def publication_mode_allowed(mode: str, boundary_treatment: str | None) -> bool:
    if boundary_treatment == "transparent":
        return mode == "grayscale-alpha"
    return mode == "grayscale"


def validate_artwork(
    owner: Path,
    asset_root: Path,
    asset_boundaries: dict[str, str | None],
    entry: object,
    problems: Problems,
) -> tuple[str | None, dict]:
    if not isinstance(entry, dict):
        problems.add("each artworks item must be a table")
        return None, {}
    artwork_id = entry.get("id")
    label = artwork_id if isinstance(artwork_id, str) else "<missing-artwork-id>"
    unknown = set(entry) - ART_FIELDS
    missing = ART_FIELDS - set(entry)
    if unknown:
        problems.add(f"{label}: unknown fields: {', '.join(sorted(unknown))}")
    if missing:
        problems.add(f"{label}: missing fields: {', '.join(sorted(missing))}")
    if not isinstance(artwork_id, str) or not ID["art"].fullmatch(artwork_id):
        problems.add(f"{label}: invalid artwork ID")
        return None, entry
    objects = string_list(entry.get("object_ids"), f"{label}.object_ids", problems)
    problems.check(bool(objects), f"{label}.object_ids must not be empty")
    for object_id in objects:
        problems.check(bool(ID["obj"].fullmatch(object_id)), f"{label}: invalid object ID {object_id}")
    for variant_id in string_list(entry.get("variant_ids"), f"{label}.variant_ids", problems):
        problems.check(bool(ID["var"].fullmatch(variant_id)), f"{label}: invalid variant ID {variant_id}")
    for prefix, field in (("art", "precursor_ids"), ("plt", "consumer_plate_ids"),
                          ("ed", "consumer_edition_ids")):
        for linked_id in string_list(entry.get(field), f"{label}.{field}", problems):
            problems.check(bool(ID[prefix].fullmatch(linked_id)), f"{label}: invalid {field} ID {linked_id}")
    for linked_id in string_list(entry.get("reference_ids"), f"{label}.reference_ids", problems):
        problems.check(
            bool(ID["art"].fullmatch(linked_id) or ID["src"].fullmatch(linked_id)),
            f"{label}: invalid reference ID {linked_id}",
        )

    problems.check(entry.get("view") in VIEWS, f"{label}: invalid view")
    state = entry.get("workflow_state")
    problems.check(state in WORKFLOW, f"{label}: invalid workflow_state")
    for field in ("purpose", "depicted_state", "brief", "exact_prompt", "generator",
                  "generated_on", "rights"):
        problems.check(isinstance(entry.get(field), str) and bool(entry[field].strip()),
                       f"{label}.{field} must be nonempty")
    for field in ("source_controlled_features", "deliberate_omissions", "corrections",
                  "baked_content_audit", "tex_overlays"):
        string_list(entry.get(field), f"{label}.{field}", problems)

    reviews = entry.get("reviews")
    review_keys = {"factual", "visual", "print", "rights", "consumer", "release"}
    if not isinstance(reviews, dict):
        problems.add(f"{label}.reviews must be a table")
    else:
        problems.check(set(reviews) == review_keys, f"{label}.reviews must contain exactly {sorted(review_keys)}")
        for key, value in reviews.items():
            problems.check(value in REVIEWS, f"{label}.reviews.{key} has invalid state")

    asset = safe_relative(entry.get("asset"), f"{label}.asset", problems)
    normalized = entry.get("normalized")
    normalized_keys = {
        "path", "width_px", "height_px", "bit_depth", "color_mode", "bytes",
        "sha256", "max_placement_width_in", "max_placement_height_in",
        "effective_dpi",
    }
    if not isinstance(normalized, dict):
        problems.add(f"{label}.normalized must be a table")
        return artwork_id, entry
    problems.check(set(normalized) == normalized_keys,
                   f"{label}.normalized must contain exactly {sorted(normalized_keys)}")
    for field in ("max_placement_width_in", "max_placement_height_in", "effective_dpi"):
        value = normalized.get(field)
        problems.check(isinstance(value, (int, float)) and not isinstance(value, bool) and value > 0,
                       f"{label}.normalized.{field} must be a positive number")
    if all(isinstance(normalized.get(field), (int, float))
           and not isinstance(normalized.get(field), bool)
           and normalized[field] > 0
           for field in ("width_px", "height_px", "max_placement_width_in",
                         "max_placement_height_in", "effective_dpi")):
        calculated_dpi = min(
            normalized["width_px"] / normalized["max_placement_width_in"],
            normalized["height_px"] / normalized["max_placement_height_in"],
        )
        problems.check(abs(normalized["effective_dpi"] - calculated_dpi) <= 0.1,
                       f"{label}.normalized.effective_dpi does not match dimensions and placement")
        if calculated_dpi < 300:
            message = f"{label}: normalized asset is below 300 effective dpi"
            if state == "consumer-review-passed":
                problems.add(message)
            else:
                problems.notice(message)
    normalized_path = safe_relative(normalized.get("path"), f"{label}.normalized.path", problems)
    if asset is not None and normalized_path is not None:
        problems.check(asset == normalized_path, f"{label}: asset and normalized.path must match")
        problems.check(asset_root in (asset.parents or [asset_root]) or asset.parts[:len(asset_root.parts)] == asset_root.parts,
                       f"{label}.asset must be beneath configured asset_root")
        absolute = owner / asset
        if not absolute.is_file():
            problems.add(f"{label}: missing normalized asset {asset}")
        else:
            try:
                width, height, depth, mode = png_properties(absolute)
                digest = hashlib.sha256(absolute.read_bytes()).hexdigest()
                actual = {
                    "width_px": width, "height_px": height, "bit_depth": depth,
                    "color_mode": mode, "bytes": absolute.stat().st_size,
                    "sha256": digest,
                }
                for key, value in actual.items():
                    problems.check(normalized.get(key) == value,
                                   f"{label}.normalized.{key} does not match asset")
                boundary_treatment = asset_boundaries.get(asset.as_posix())
                if not (
                    depth == 8
                    and publication_mode_allowed(mode, boundary_treatment)
                ):
                    message = (
                        f"{label}: publication input must be 8-bit grayscale, "
                        "or grayscale-alpha with boundary_treatment='transparent'"
                    )
                    if state == "consumer-review-passed":
                        problems.add(message)
                    else:
                        problems.notice(message)
            except (OSError, ValueError) as exc:
                problems.add(f"{label}: cannot inspect asset: {exc}")
    received = entry.get("received")
    received_keys = {"width_px", "height_px", "bit_depth", "color_mode", "bytes", "sha256"}
    if not isinstance(received, dict):
        problems.add(f"{label}.received must be a table")
    else:
        problems.check(set(received) == received_keys,
                       f"{label}.received must contain exactly {sorted(received_keys)}")
        for field in ("width_px", "height_px", "bit_depth", "bytes"):
            problems.check(isinstance(received.get(field), int) and received[field] > 0,
                           f"{label}.received.{field} must be a positive integer")
        problems.check(isinstance(received.get("color_mode"), str) and bool(received["color_mode"]),
                       f"{label}.received.color_mode must be nonempty")
        problems.check(isinstance(received.get("sha256"), str)
                       and bool(re.fullmatch(r"[0-9a-f]{64}", received["sha256"])),
                       f"{label}.received.sha256 must be lowercase SHA-256")
    return artwork_id, entry


def validate(owner: Path) -> tuple[list[str], list[str]]:
    problems = Problems()
    manifest_path = owner / "research/artwork-manifest.toml"
    try:
        manifest = load_toml(manifest_path)
    except ValueError as exc:
        return [str(exc)], []
    problems.check(set(manifest) == ROOT_FIELDS, f"manifest fields must be exactly {sorted(ROOT_FIELDS)}")
    problems.check(manifest.get("schema_version") == 1, "schema_version must be 1")
    problems.check(manifest.get("manifest_id") == "roman-sanctuary-dictionary-artwork",
                   "unexpected manifest_id")
    asset_root = safe_relative(manifest.get("asset_root"), "asset_root", problems) or Path("shared/artwork")
    asset_files = manifest.get("asset_files")
    if not isinstance(asset_files, list):
        problems.add("asset_files must be an array")
        asset_files = []
    registered_paths: set[str] = set()
    registered_file_ids: set[str] = set()
    asset_file_paths: dict[str, str] = {}
    asset_boundaries: dict[str, str | None] = {}
    for row in asset_files:
        if not isinstance(row, dict):
            problems.add("each asset_files row must be a table")
            continue
        unknown = set(row) - ASSET_FILE_FIELDS
        missing = ASSET_FILE_REQUIRED_FIELDS - set(row)
        if unknown:
            problems.add(
                f"asset_files row has unknown fields: {', '.join(sorted(unknown))}"
            )
        if missing:
            problems.add(
                f"asset_files row is missing fields: {', '.join(sorted(missing))}"
            )
        file_id = row.get("id")
        if not isinstance(file_id, str) or not re.fullmatch(r"file-[a-z0-9]+(?:-[a-z0-9]+)*", file_id):
            problems.add(f"invalid asset file ID: {file_id}")
            continue
        if file_id in registered_file_ids:
            problems.add(f"duplicate asset file ID: {file_id}")
        registered_file_ids.add(file_id)
        validate_boundary_treatment(row, file_id, problems)
        path = safe_relative(row.get("path"), f"{file_id}.path", problems)
        audit = safe_relative(row.get("audit_record"), f"{file_id}.audit_record", problems)
        problems.check(row.get("state") in {
            "canonical-alpha-eligible", "held", "rejected", "consumer-eligible"
        },
                       f"{file_id}: invalid state")
        if audit is not None:
            problems.check((owner / audit).is_file(), f"{file_id}: missing audit record {audit}")
        technical = row.get("technical")
        keys = {"width_px", "height_px", "bit_depth", "color_mode", "bytes", "sha256"}
        if not isinstance(technical, dict) or set(technical) != keys:
            problems.add(f"{file_id}.technical must contain exactly {sorted(keys)}")
        if path is not None:
            relative = path.as_posix()
            asset_file_paths[file_id] = relative
            if relative in registered_paths:
                problems.add(f"duplicate registered asset path: {relative}")
            registered_paths.add(relative)
            treatment = row.get("boundary_treatment")
            asset_boundaries[relative] = (
                treatment if isinstance(treatment, str) else None
            )
            absolute = owner / path
            if not absolute.is_file():
                problems.add(f"{file_id}: missing asset {relative}")
            elif isinstance(technical, dict):
                try:
                    width, height, depth, mode = png_properties(absolute)
                    actual = {
                        "width_px": width,
                        "height_px": height,
                        "bit_depth": depth,
                        "color_mode": mode,
                        "bytes": absolute.stat().st_size,
                        "sha256": hashlib.sha256(absolute.read_bytes()).hexdigest(),
                    }
                    for key, value in actual.items():
                        problems.check(technical.get(key) == value,
                                       f"{file_id}.technical.{key} does not match asset")
                    if row.get("state") in {"consumer-eligible", "canonical-alpha-eligible"}:
                        problems.check(
                            depth == 8
                            and publication_mode_allowed(
                                mode, asset_boundaries[relative]
                            ),
                            f"{file_id}: consumer-eligible file must be 8-bit "
                            "grayscale, or grayscale-alpha with "
                            "boundary_treatment='transparent'",
                        )
                except (OSError, ValueError) as exc:
                    problems.add(f"{file_id}: cannot inspect asset: {exc}")
    physical_paths = {
        path.relative_to(owner).as_posix()
        for path in (owner / asset_root).rglob("*.png")
        if path.is_file()
    }
    for path in sorted(physical_paths - registered_paths):
        absolute = owner / path
        if asset_local_staging_path(absolute, problems):
            continue
        problems.add(f"unregistered dictionary PNG: {path}")
    for path in sorted(registered_paths - physical_paths):
        problems.add(f"registered path is outside the current PNG inventory: {path}")
    coverage = manifest.get("coverage")
    coverage_keys = {
        "object_record_glob", "exclude_paths", "publication_ready_workflow_state",
        "required_artwork_workflow_state", "require_bidirectional_links",
        "require_variant_coverage",
    }
    if not isinstance(coverage, dict):
        problems.add("[coverage] is required")
        coverage = {}
    else:
        problems.check(set(coverage) == coverage_keys,
                       f"coverage fields must be exactly {sorted(coverage_keys)}")
        problems.check(coverage.get("publication_ready_workflow_state") == "publication-ready",
                       "coverage publication-ready state must remain publication-ready")
        problems.check(coverage.get("required_artwork_workflow_state") == "consumer-review-passed",
                       "coverage required artwork state must remain consumer-review-passed")
        problems.check(coverage.get("require_bidirectional_links") is True,
                       "bidirectional object/artwork links must be required")
        problems.check(coverage.get("require_variant_coverage") is True,
                       "substantive variant artwork coverage must be required")
    glob = coverage.get("object_record_glob", "shared/objects/**/*.toml")
    if not isinstance(glob, str) or not glob:
        problems.add("coverage.object_record_glob must be nonempty")
        glob = "shared/objects/**/*.toml"
    excluded = set(string_list(coverage.get("exclude_paths", []), "coverage.exclude_paths", problems))
    objects = object_records(owner, glob, excluded, problems)

    artworks: dict[str, dict] = {}
    artwork_paths: dict[str, str] = {}
    entries = manifest.get("artworks")
    if not isinstance(entries, list):
        problems.add("artworks must be an array")
        entries = []
    for entry in entries:
        artwork_id, parsed = validate_artwork(
            owner, asset_root, asset_boundaries, entry, problems
        )
        if artwork_id:
            if artwork_id in artworks:
                problems.add(f"duplicate artwork ID: {artwork_id}")
            else:
                artworks[artwork_id] = parsed
                asset = parsed.get("asset")
                if isinstance(asset, str):
                    artwork_paths[artwork_id] = canonical_asset_path(asset)

    links = manifest.get("artwork_links")
    if not isinstance(links, list):
        problems.add("artwork_links must be an array")
        links = []
    for link in links:
        required = {"id", "asset_file_id", "object_ids", "variant_ids", "view", "workflow_state"}
        if not isinstance(link, dict) or set(link) != required:
            problems.add(f"each artwork_links row must contain exactly {sorted(required)}")
            continue
        artwork_id = link.get("id")
        if not isinstance(artwork_id, str) or not ID["art"].fullmatch(artwork_id):
            problems.add(f"invalid artwork link ID: {artwork_id}")
            continue
        if artwork_id in artworks:
            problems.add(f"duplicate artwork ID across full records and links: {artwork_id}")
            continue
        asset_file_id = link.get("asset_file_id")
        problems.check(asset_file_id in registered_file_ids,
                       f"{artwork_id}: unknown asset file ID {asset_file_id}")
        if asset_file_id in asset_file_paths:
            artwork_paths[artwork_id] = asset_file_paths[asset_file_id]
        objects_for_link = string_list(link.get("object_ids"), f"{artwork_id}.object_ids", problems)
        problems.check(bool(objects_for_link), f"{artwork_id}.object_ids must not be empty")
        for object_id in objects_for_link:
            problems.check(object_id in objects, f"{artwork_id}: unknown depicted object {object_id}")
        for variant_id in string_list(link.get("variant_ids"), f"{artwork_id}.variant_ids", problems):
            problems.check(bool(ID["var"].fullmatch(variant_id)),
                           f"{artwork_id}: invalid variant ID {variant_id}")
        problems.check(link.get("view") in VIEWS, f"{artwork_id}: invalid view")
        problems.check(link.get("workflow_state") in WORKFLOW,
                       f"{artwork_id}: invalid workflow_state")
        artworks[artwork_id] = link

    for artwork_id, entry in artworks.items():
        for object_id in entry.get("object_ids", []):
            if object_id not in objects:
                message = f"{artwork_id}: unknown depicted object {object_id}"
                if entry.get("workflow_state") == "consumer-review-passed":
                    problems.add(message)
                else:
                    problems.notice(message)
        for linked_id in entry.get("precursor_ids", []):
            if linked_id not in artworks:
                problems.add(f"{artwork_id}: unknown linked artwork {linked_id}")
        for linked_id in entry.get("reference_ids", []):
            if linked_id.startswith("art-") and linked_id not in artworks:
                problems.add(f"{artwork_id}: unknown artwork reference {linked_id}")

    for object_id, record in objects.items():
        path = record["_path"]
        links = record.get("artwork", [])
        if not isinstance(links, list):
            problems.add(f"{path}: artwork must be an array of tables")
            links = []
        linked_ids: set[str] = set()
        for link in links:
            if not isinstance(link, dict) or not isinstance(link.get("id"), str):
                problems.add(f"{path}: artwork link lacks an ID")
                continue
            artwork_id = link["id"]
            linked_ids.add(artwork_id)
            if artwork_id not in artworks:
                message = f"{object_id}: artwork link {artwork_id} is absent from canonical manifest"
                if record.get("workflow_state") == "publication-ready":
                    problems.add(message)
                else:
                    problems.notice(message)
            elif object_id not in artworks[artwork_id].get("object_ids", []):
                problems.add(f"{object_id}: {artwork_id} does not link back to the object")
            else:
                object_asset = link.get("asset")
                manifest_asset = artwork_paths.get(artwork_id)
                if not isinstance(object_asset, str) or not manifest_asset:
                    problems.add(
                        f"{object_id}: {artwork_id} lacks an exact object-to-manifest asset identity"
                    )
                elif canonical_asset_path(object_asset) != manifest_asset:
                    problems.add(
                        f"{object_id}: {artwork_id} asset {object_asset} does not match "
                        f"canonical manifest path {manifest_asset}"
                    )
        if record.get("workflow_state") == "publication-ready":
            if not linked_ids:
                problems.add(f"{object_id}: publication-ready object has no artwork")
            for artwork_id in linked_ids:
                if artwork_id in artworks and artworks[artwork_id].get("workflow_state") != "consumer-review-passed":
                    problems.add(f"{object_id}: publication-ready artwork {artwork_id} is not consumer-review-passed")
            variants = record.get("variants", [])
            if isinstance(variants, list):
                for variant in variants:
                    if not isinstance(variant, dict):
                        continue
                    variant_id = variant.get("id")
                    required = variant.get("artwork_ids", [])
                    if isinstance(variant_id, str) and (not isinstance(required, list) or not required):
                        problems.add(f"{object_id}: substantive variant {variant_id} has no artwork")
                    for artwork_id in required if isinstance(required, list) else []:
                        if artwork_id not in artworks:
                            problems.add(f"{object_id}: variant {variant_id} names absent artwork {artwork_id}")
                        elif variant_id not in artworks[artwork_id].get("variant_ids", []):
                            problems.add(f"{object_id}: {artwork_id} does not link back to variant {variant_id}")
    return problems.items, problems.notices


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--root", type=Path, default=DEFAULT_OWNER,
                        help="dictionary owner root")
    args = parser.parse_args()
    owner = args.root.resolve()
    failures, notices = validate(owner)
    for notice in notices:
        print(f"NOTICE: {notice}", file=sys.stderr)
    if failures:
        for failure in failures:
            print(f"ERROR: {failure}", file=sys.stderr)
        print(f"Roman sanctuary artwork validation failed: {len(failures)} error(s)", file=sys.stderr)
        return 1
    print(
        "Roman sanctuary artwork manifest valid; "
        f"{len(notices)} held object-link notice(s)."
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
