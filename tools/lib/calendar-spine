#!/usr/bin/env python3
"""Derive the date-ordered sanctoral spine from the repo's calendar references.

Usage: calendar-spine [derive] [--calendar NAME] [--kind KIND]

Parses the verified calendar-reference publications — the 1962 sanctorale
sections and the postconciliar general-calendar section — into one date-ordered
list per calendar, each entry classified as marian, christological, seasonal, or
saintly.
The spine is the identity and ordering source for the sanctoral mass indexes
under src/sources/calendars; it carries no propers.

Classification follows the edition's own printed title. The 1962 books title
February 2 and March 25 as feasts of Our Lady (In Purificatione, Annuntiatio
Beatae Mariae Virginis) while the postconciliar books title them of the Lord,
and this tool reproduces that difference rather than harmonizing it.
"""
from __future__ import annotations

import argparse
import re
import sys
import unicodedata
from pathlib import Path
from _tooling import print_json, run_verb_cli

ROOT = Path(__file__).resolve().parents[2]
SOURCES = {
    "roman-1962": (
        ROOT / "src/gpt/liturgy/roman-rite/1962/reference/liturgical-calendar/sections",
        ("50-sanctorale-jan-jun.tex", "60-sanctorale-jul-dec.tex"),
    ),
    "postconciliar": (
        ROOT
        / "src/gpt/liturgy/roman-rite/postconciliar"
        / "roman-missal-third-edition-en-us-2011/reference/liturgical-calendar/sections",
        ("50-general-calendar.tex",),
    ),
}
KINDS = ("christological", "marian", "saintly", "seasonal")

MONTHS = (
    "January", "February", "March", "April", "May", "June",
    "July", "August", "September", "October", "November", "December",
)
MONTH_NUMBER = {name: number for number, name in enumerate(MONTHS, start=1)}
ABBREVIATED = {
    "Jan.": 1, "Feb.": 2, "March": 3, "Mar.": 3, "April": 4, "Apr.": 4,
    "May": 5, "June": 6, "Jun.": 6, "July": 7, "Jul.": 7, "Aug.": 8,
    "Sept.": 9, "Sep.": 9, "Oct.": 10, "Nov.": 11, "Dec.": 12,
}

CALENTRY = re.compile(r"\\calentry\{([^}]*)\}\{(.*?)\}\{([^}]*)\}\s*$")
CALMONTH = re.compile(r"\\calmonth\{([^}]*)\}")
TABLE_MONTH = re.compile(r"\\bfseries\s+([A-Z][a-z]+)\}")
TABLE_ROW = re.compile(r"^(\d{1,2})\s*&\s*(.+?)\s*&\s*\\calrank\{([^}]*)\}")

LORD = (
    "domini", "iesu christi", "jesu christi", "of the lord", "name of jesus",
    "transfiguration", "transfiguratione", "sacred heart", "sacratissimi cordis",
    "christ the king", "christi regis", "precious blood", "pretiosissimi sanguinis",
    "corpus christi", "corporis christi", "sanctissimi", "crucis", "cross",
)
MARIAN = (
    "beatae mariae virginis", "mariae virginis", "blessed virgin mary",
    "virgin mary", "our lady", "mother of god", "annuntiatione", "purificatione",
    "assumptione", "immaculata", "immaculate", "rosarii", "carmelo", "guadalupe",
    "lourdes", "fatima", "loreto", "maternitatis", "visitatione", "septem dolorum",
    "sorrows", "queenship", "assumption",
)
# A day within the octave is a seasonal celebration for the fixed-calendar spine.
OCTAVE_DAY = re.compile(r"^\w+\s+day\s+within\s+the\s+octave\b", re.IGNORECASE)
VIGIL_OF = re.compile(r"^vigil\s+of\s+(?:the\s+)?(.*)$", re.IGNORECASE)
# A word boundary after a literal period never matches before a space, so these
# head patterns require the following whitespace explicitly.
PERSON_HEAD = re.compile(r"^(ss?\.\s|saints?\s|beati\s|beatae\s(?!mariae))", re.IGNORECASE)
DROP_FROM_SLUG = re.compile(r"\b(ss?\.|comm\.|in|the|of|and|et|de|with|at)\b")


def strip_tex(text: str) -> str:
    for _ in range(3):
        text = re.sub(r"\\[a-zA-Z]+\{(.*?)\}", r"\1", text)
    text = text.replace("``", '"').replace("''", '"').replace("~", " ")
    text = text.replace(r"\&", "&").replace("--", "-")
    return re.sub(r"\s+", " ", text).strip()


def fold(text: str) -> str:
    decomposed = unicodedata.normalize("NFKD", text)
    return "".join(c for c in decomposed if not unicodedata.combining(c)).lower()


def classify(title: str) -> str:
    """Classify by the head of the edition's printed title.

    A title headed by a person is that person's feast even when it names Our
    Lady, so Saint Joachim and Saint Joseph, Spouse of the Blessed Virgin Mary
    are saints' feasts. Matching is whole-word, so "S. Dominici" is not read as
    a feast of the Lord.
    """
    head = re.sub(r"^comm\.\s*", "", title.strip(), flags=re.IGNORECASE)
    if OCTAVE_DAY.match(head):
        return "seasonal"
    # A vigil belongs to the celebration it precedes.
    vigil = VIGIL_OF.match(head.split(";")[0])
    if vigil and vigil.group(1).strip():
        return classify(vigil.group(1).strip())
    if PERSON_HEAD.match(head):
        return "saintly"
    folded = fold(head)

    def has(tokens: tuple[str, ...]) -> bool:
        return any(
            re.search(rf"(?<![a-z]){re.escape(token)}(?![a-z])", folded)
            for token in tokens
        )

    if has(MARIAN):
        return "marian"
    if has(LORD):
        return "christological"
    return "saintly"


def make_key(title: str, used: set[str]) -> str:
    """Key an entry by its principal celebration, not by its commemorations."""
    base = DROP_FROM_SLUG.sub(" ", fold(title.split(";")[0]))
    base = re.sub(r"[^a-z0-9]+", "-", base).strip("-")
    base = "-".join([part for part in base.split("-") if part][:6]) or "celebration"
    candidate, suffix = base, 2
    while candidate in used:
        candidate = f"{base}-{suffix}"
        suffix += 1
    used.add(candidate)
    return candidate


def parse_calentries(directory: Path, names: tuple[str, ...]) -> list[dict]:
    entries: list[dict] = []
    for name in names:
        path = directory / name
        if not path.is_file():
            raise ValueError(f"missing calendar section: {path}")
        month = None
        for line in path.read_text(encoding="utf-8").splitlines():
            found_month = CALMONTH.search(line)
            if found_month:
                month = MONTH_NUMBER.get(strip_tex(found_month.group(1)))
                continue
            found = CALENTRY.search(line.strip())
            if not found:
                continue
            date_text = strip_tex(found.group(1))
            bits = date_text.split()
            if len(bits) != 2 or bits[0] not in ABBREVIATED or not bits[1].isdigit():
                raise ValueError(f"{path.name}: unreadable date {date_text!r}")
            entries.append(
                {
                    "month": ABBREVIATED[bits[0]],
                    "day": int(bits[1]),
                    "title": strip_tex(found.group(2)),
                    "rank": strip_tex(found.group(3)),
                }
            )
    return entries


def parse_table(directory: Path, names: tuple[str, ...]) -> list[dict]:
    entries: list[dict] = []
    month = None
    for name in names:
        path = directory / name
        if not path.is_file():
            raise ValueError(f"missing calendar section: {path}")
        for line in path.read_text(encoding="utf-8").splitlines():
            found_month = TABLE_MONTH.search(line)
            if found_month:
                month = MONTH_NUMBER.get(found_month.group(1))
                continue
            found = TABLE_ROW.match(line.strip())
            if not found:
                continue
            if month is None:
                raise ValueError(f"{path.name}: a row precedes its month heading")
            entries.append(
                {
                    "month": month,
                    "day": int(found.group(1)),
                    "title": strip_tex(found.group(2)),
                    "rank": strip_tex(found.group(3)),
                }
            )
    return entries


PARSERS = {"roman-1962": parse_calentries, "postconciliar": parse_table}
PREFIX = {"roman-1962": "1962", "postconciliar": "pc"}


def spine(calendar: str) -> list[dict]:
    directory, names = SOURCES[calendar]
    entries = PARSERS[calendar](directory, names)
    if not entries:
        raise ValueError(f"{calendar}: no calendar entries found")
    entries.sort(key=lambda entry: (entry["month"], entry["day"]))
    used: set[str] = set()
    for entry in entries:
        entry["kind"] = classify(entry["title"])
        entry["key"] = make_key(entry["title"], used)
        entry["date"] = f"{entry['month']:02d}-{entry['day']:02d}"
        entry["registry"] = f"{PREFIX[calendar]}-{entry['date']}"
    return entries


def run(calendar: str | None, kind: str | None) -> dict[str, object]:
    if calendar is not None and calendar not in SOURCES:
        raise ValueError(f"unknown calendar: {calendar}")
    if kind is not None and kind not in KINDS:
        raise ValueError(f"unknown kind: {kind}")
    calendars = [calendar] if calendar else sorted(SOURCES)
    result: dict[str, object] = {}
    counts: dict[str, dict[str, int]] = {}
    for name in calendars:
        entries = spine(name)
        if kind:
            entries = [entry for entry in entries if entry["kind"] == kind]
        result[name] = entries
        tally: dict[str, int] = {}
        for entry in entries:
            tally[entry["kind"]] = tally.get(entry["kind"], 0) + 1
        counts[name] = dict(sorted(tally.items()))
    return {"calendars": result, "counts": counts, "status": "ok"}


def main(argv: list[str] | None = None) -> int:
    shared = argparse.ArgumentParser(add_help=False)
    shared.add_argument("--calendar", choices=sorted(SOURCES))
    shared.add_argument("--kind", choices=KINDS)
    shared.add_argument(
        "--json",
        action="store_true",
        help="emit one compact key-sorted JSON object (cli-v1)",
    )
    parser = argparse.ArgumentParser(
        prog="calendar-spine",
        description=(
            "Derive the date-ordered sanctoral spine from the repo's "
            "calendar references."
        ),
        parents=[shared],
    )
    sub = parser.add_subparsers(dest="command")
    sub.add_parser("derive", help="derive the date-ordered sanctoral spine", parents=[shared])

    def dispatch(arguments):
        return run(arguments.calendar, arguments.kind)

    def render(payload: object, arguments: argparse.Namespace) -> int:
        as_json = bool(getattr(arguments, "json", False))
        if as_json:
            print_json(payload if isinstance(payload, dict) else {})
            return 0
        if not isinstance(payload, dict):
            print("calendar-spine error: invalid payload", file=sys.stderr)
            return 70
        for name, entries in payload["calendars"].items():
            for entry in entries:
                print(
                    f"{name}\t{entry['date']}\t{entry['kind']}\t{entry['registry']}"
                    f"\t{entry['rank']}\t{entry['key']}\t{entry['title']}"
                )
        for name, tally in payload["counts"].items():
            detail = ", ".join(f"{count} {kind}" for kind, count in tally.items())
            print(f"# {name}: {sum(tally.values())} entries ({detail})", file=sys.stderr)
        return 0

    return run_verb_cli(
        parser=parser,
        handlers={"derive": dispatch},
        renderer=render,
        prefix="calendar-spine",
        argv=argv,
        default_verb="derive",
    )


if __name__ == "__main__":
    raise SystemExit(main())
