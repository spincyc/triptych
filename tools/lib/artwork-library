#!/usr/bin/env python3
"""Normalize and validate repository-owned monochrome publishing artwork."""

from __future__ import annotations

import argparse
import hashlib
import shutil
import struct
import subprocess
import sys
import tempfile
import tomllib
import zlib
from dataclasses import dataclass
from pathlib import Path

PNG_SIGNATURE = b"\x89PNG\r\n\x1a\n"
ALLOWED_COLOR_TYPES = {0: "grayscale", 4: "grayscale-alpha"}
ALLOWED_BOUNDARY_TREATMENTS = {
    "transparent",
    "page-ground",
    "intentional-frame",
    "full-bleed",
}


class ArtworkError(ValueError):
    pass


@dataclass(frozen=True)
class PngInfo:
    width: int
    height: int
    depth: int
    color_type: int
    has_alpha: bool
    has_color_profile: bool

    @property
    def mode(self) -> str:
        return ALLOWED_COLOR_TYPES.get(self.color_type, "non-grayscale")


def _paeth(left: int, above: int, upper_left: int) -> int:
    estimate = left + above - upper_left
    left_distance = abs(estimate - left)
    above_distance = abs(estimate - above)
    upper_left_distance = abs(estimate - upper_left)
    if left_distance <= above_distance and left_distance <= upper_left_distance:
        return left
    if above_distance <= upper_left_distance:
        return above
    return upper_left


def grayscale_rows(path: Path, info: PngInfo) -> list[bytes]:
    """Decode the narrow PNG subset used by the page-ground edge audit."""
    if info.depth != 8 or info.color_type != 0 or info.has_alpha:
        raise ArtworkError(
            f"{path}: page-ground edge audit requires opaque 8-bit grayscale PNG"
        )
    data = path.read_bytes()
    offset = len(PNG_SIGNATURE)
    interlace = None
    compressed = bytearray()
    while offset + 12 <= len(data):
        length = struct.unpack(">I", data[offset : offset + 4])[0]
        kind = data[offset + 4 : offset + 8]
        payload = data[offset + 8 : offset + 8 + length]
        if kind == b"IHDR":
            interlace = payload[12]
        elif kind == b"IDAT":
            compressed.extend(payload)
        elif kind == b"IEND":
            break
        offset += 12 + length
    if interlace != 0:
        raise ArtworkError(
            f"{path}: page-ground edge audit does not support interlaced PNG"
        )
    try:
        encoded = zlib.decompress(bytes(compressed))
    except zlib.error as exc:
        raise ArtworkError(f"{path}: cannot decode PNG pixels: {exc}") from exc
    stride = info.width
    expected = info.height * (stride + 1)
    if len(encoded) != expected:
        raise ArtworkError(f"{path}: unexpected grayscale PNG scanline size")
    rows: list[bytes] = []
    previous = bytes(stride)
    cursor = 0
    for _ in range(info.height):
        filter_type = encoded[cursor]
        raw = encoded[cursor + 1 : cursor + 1 + stride]
        cursor += stride + 1
        reconstructed = bytearray(stride)
        for column, value in enumerate(raw):
            left = reconstructed[column - 1] if column else 0
            above = previous[column]
            upper_left = previous[column - 1] if column else 0
            if filter_type == 0:
                predictor = 0
            elif filter_type == 1:
                predictor = left
            elif filter_type == 2:
                predictor = above
            elif filter_type == 3:
                predictor = (left + above) // 2
            elif filter_type == 4:
                predictor = _paeth(left, above, upper_left)
            else:
                raise ArtworkError(f"{path}: unsupported PNG filter {filter_type}")
            reconstructed[column] = (value + predictor) & 0xFF
        row = bytes(reconstructed)
        rows.append(row)
        previous = row
    return rows


def audit_page_ground_perimeter(path: Path, info: PngInfo) -> list[str]:
    """Conservatively reject dark or extensive non-white marks at asset edges."""
    rows = grayscale_rows(path, info)
    if not rows or not rows[0]:
        return [f"{path}: page-ground edge audit found an empty image"]
    perimeter = list(rows[0])
    if len(rows) > 1:
        perimeter.extend(rows[-1])
    if len(rows[0]) > 1:
        perimeter.extend(row[0] for row in rows[1:-1])
        perimeter.extend(row[-1] for row in rows[1:-1])
    dark = sum(pixel < 224 for pixel in perimeter)
    unmatched = sum(pixel < 248 for pixel in perimeter)
    allowed_unmatched = max(1, len(perimeter) // 100)
    errors: list[str] = []
    if dark:
        errors.append(
            f"{path}: page-ground perimeter has {dark} materially dark edge pixel(s)"
        )
    if unmatched > allowed_unmatched:
        errors.append(
            f"{path}: page-ground perimeter has {unmatched}/{len(perimeter)} "
            "edge pixels below the near-white threshold"
        )
    return errors


def validate_boundary_treatment(
    label: str, artwork: Path, info: PngInfo, asset: dict
) -> list[str]:
    treatment = asset.get("boundary_treatment")
    rationale = asset.get("boundary_treatment_rationale")
    if treatment is None:
        errors = []
        if rationale is not None:
            errors.append(
                f"{label}: boundary_treatment_rationale requires boundary_treatment"
            )
        if info.has_alpha:
            errors.append(
                f"{label}: alpha/transparency requires boundary_treatment='transparent'"
            )
        return errors
    if treatment not in ALLOWED_BOUNDARY_TREATMENTS:
        allowed = ", ".join(sorted(ALLOWED_BOUNDARY_TREATMENTS))
        return [f"{label}: boundary_treatment must be one of: {allowed}"]
    errors: list[str] = []
    if treatment == "transparent":
        if not info.has_alpha:
            errors.append(
                f"{label}: transparent boundary_treatment requires alpha/transparency"
            )
    elif info.has_alpha:
        errors.append(
            f"{label}: alpha/transparency requires boundary_treatment='transparent'"
        )
    if treatment in {"intentional-frame", "full-bleed"}:
        if not isinstance(rationale, str) or not rationale.strip():
            errors.append(
                f"{label}: {treatment} boundary_treatment requires a nonempty "
                "boundary_treatment_rationale"
            )
    elif rationale is not None:
        errors.append(
            f"{label}: boundary_treatment_rationale is not allowed for {treatment}"
        )
    if treatment != "page-ground":
        return errors
    try:
        errors.extend(audit_page_ground_perimeter(artwork, info))
    except ArtworkError as exc:
        errors.append(f"{label}: {exc}")
    return errors


def sha256(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as stream:
        for block in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(block)
    return digest.hexdigest()


def inspect_png(path: Path) -> PngInfo:
    data = path.read_bytes()
    if not data.startswith(PNG_SIGNATURE):
        raise ArtworkError(f"{path}: not a PNG")
    offset = len(PNG_SIGNATURE)
    width = height = depth = color_type = None
    has_alpha = False
    has_color_profile = False
    while offset + 12 <= len(data):
        length = struct.unpack(">I", data[offset : offset + 4])[0]
        kind = data[offset + 4 : offset + 8]
        payload = data[offset + 8 : offset + 8 + length]
        crc_at = offset + 8 + length
        if crc_at + 4 > len(data):
            raise ArtworkError(f"{path}: truncated PNG chunk")
        expected = struct.unpack(">I", data[crc_at : crc_at + 4])[0]
        actual = zlib.crc32(kind + payload) & 0xFFFFFFFF
        if expected != actual:
            raise ArtworkError(f"{path}: corrupt PNG chunk {kind!r}")
        if kind == b"IHDR":
            if length != 13:
                raise ArtworkError(f"{path}: invalid IHDR")
            width, height, depth, color_type, compression, filtering, interlace = (
                struct.unpack(">IIBBBBB", payload)
            )
            if compression != 0 or filtering != 0 or interlace not in (0, 1):
                raise ArtworkError(f"{path}: unsupported PNG encoding")
            has_alpha = color_type in (4, 6)
        elif kind in (b"iCCP", b"sRGB", b"cHRM"):
            has_color_profile = True
        elif kind == b"tRNS":
            has_alpha = True
        elif kind == b"IEND":
            break
        offset = crc_at + 4
    if None in (width, height, depth, color_type):
        raise ArtworkError(f"{path}: missing IHDR")
    return PngInfo(
        width=width,
        height=height,
        depth=depth,
        color_type=color_type,
        has_alpha=has_alpha,
        has_color_profile=has_color_profile,
    )


def load_manifest(path: Path) -> list[dict]:
    try:
        document = tomllib.loads(path.read_text(encoding="utf-8"))
    except (OSError, tomllib.TOMLDecodeError) as exc:
        raise ArtworkError(f"{path}: cannot read manifest: {exc}") from exc
    assets = document.get("asset")
    if not isinstance(assets, list):
        raise ArtworkError(f"{path}: expected one or more [[asset]] tables")
    return assets


def validate_manifest(path: Path) -> list[str]:
    document = tomllib.loads(path.read_text(encoding="utf-8"))
    if "asset_files" in document:
        return validate_dictionary_manifest(path, document)
    errors: list[str] = []
    seen_ids: set[str] = set()
    seen_paths: set[Path] = set()
    root = path.parent
    for number, asset in enumerate(load_manifest(path), start=1):
        label = str(asset.get("id", f"asset #{number}"))
        required = ("id", "path", "sha256", "width", "height", "depth", "mode")
        missing = [key for key in required if key not in asset]
        if missing:
            errors.append(f"{label}: missing {', '.join(missing)}")
            continue
        if label in seen_ids:
            errors.append(f"{label}: duplicate artwork ID")
        seen_ids.add(label)
        relative = Path(str(asset["path"]))
        if relative.is_absolute() or ".." in relative.parts:
            errors.append(f"{label}: path must remain below the manifest directory")
            continue
        artwork = root / relative
        if artwork in seen_paths:
            errors.append(f"{label}: duplicate asset path {relative}")
        seen_paths.add(artwork)
        if not artwork.is_file():
            errors.append(f"{label}: missing asset {relative}")
            continue
        try:
            info = inspect_png(artwork)
        except ArtworkError as exc:
            errors.append(str(exc))
            continue
        expected = {
            "sha256": sha256(artwork),
            "width": info.width,
            "height": info.height,
            "depth": info.depth,
            "mode": info.mode,
        }
        for key, actual in expected.items():
            if asset[key] != actual:
                errors.append(
                    f"{label}: manifest {key}={asset[key]!r}, actual {actual!r}"
                )
        if info.depth != 8:
            errors.append(f"{label}: publishing PNG must be 8-bit")
        if info.color_type not in ALLOWED_COLOR_TYPES:
            errors.append(
                f"{label}: publishing PNG must be grayscale color type 0 or "
                "grayscale-alpha color type 4"
            )
        if info.has_color_profile:
            errors.append(f"{label}: publishing PNG must not embed a color profile")
        errors.extend(validate_boundary_treatment(label, artwork, info, asset))
        placement = asset.get("largest_placement_inches")
        if placement is not None:
            if not isinstance(placement, (int, float)) or placement <= 0:
                errors.append(f"{label}: largest_placement_inches must be positive")
            elif info.width / placement < 300:
                errors.append(
                    f"{label}: {info.width / placement:.1f} effective dpi is below 300"
                )
    return errors


def validate_dictionary_manifest(path: Path, document: dict) -> list[str]:
    """Validate the canonical dictionary manifest and every tracked PNG row."""
    errors: list[str] = []
    root = path.parent.parent
    seen_ids: set[str] = set()
    seen_paths: set[Path] = set()
    assets = document.get("asset_files")
    if not isinstance(assets, list) or not assets:
        return [f"{path}: expected one or more [[asset_files]] tables"]
    for number, asset in enumerate(assets, start=1):
        label = str(asset.get("id", f"asset_files #{number}"))
        relative = Path(str(asset.get("path", "")))
        technical = asset.get("technical", {})
        if label in seen_ids:
            errors.append(f"{label}: duplicate asset-file ID")
        seen_ids.add(label)
        if not relative.parts or relative.is_absolute() or ".." in relative.parts:
            errors.append(f"{label}: path must remain below the dictionary root")
            continue
        artwork = root / relative
        if artwork in seen_paths:
            errors.append(f"{label}: duplicate asset path {relative}")
        seen_paths.add(artwork)
        if not artwork.is_file():
            errors.append(f"{label}: missing asset {relative}")
            continue
        if not isinstance(technical, dict):
            errors.append(f"{label}: missing technical table")
            continue
        try:
            info = inspect_png(artwork)
        except ArtworkError as exc:
            errors.append(str(exc))
            continue
        expected = {
            "width_px": info.width,
            "height_px": info.height,
            "bit_depth": info.depth,
            "color_mode": (
                info.mode
                if info.mode in {"grayscale", "grayscale-alpha"}
                else "rgb"
            ),
            "bytes": artwork.stat().st_size,
            "sha256": sha256(artwork),
        }
        for key, actual in expected.items():
            if technical.get(key) != actual:
                errors.append(
                    f"{label}: manifest technical.{key}={technical.get(key)!r}, "
                    f"actual {actual!r}"
                )
        # Rejected research leads remain exact audit objects and need not meet
        # publishing constraints. Every other row is a potential review-edition
        # input and must meet the repository monochrome contract.
        if asset.get("state") != "rejected":
            if info.depth != 8:
                errors.append(f"{label}: publishing PNG must be 8-bit")
            if info.color_type not in ALLOWED_COLOR_TYPES:
                errors.append(
                    f"{label}: non-rejected publishing PNG must be grayscale color "
                    "type 0 or grayscale-alpha color type 4"
                )
            if info.has_color_profile:
                errors.append(f"{label}: publishing PNG must not embed a color profile")
            errors.extend(validate_boundary_treatment(label, artwork, info, asset))
    return errors


def normalize(source: Path, destination: Path) -> None:
    executable = shutil.which("magick")
    if executable is None:
        raise ArtworkError("ImageMagick `magick` is required for normalization")
    destination.parent.mkdir(parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(
        prefix=f".{destination.name}.", suffix=".png", dir=destination.parent, delete=False
    ) as stream:
        temporary = Path(stream.name)
    try:
        command = [
            executable,
            str(source),
            "-colorspace",
            "Gray",
            "-alpha",
            "off",
            "-strip",
            "-depth",
            "8",
            "-define",
            "png:color-type=0",
            str(temporary),
        ]
        completed = subprocess.run(command, text=True, capture_output=True)
        if completed.returncode:
            raise ArtworkError(completed.stderr.strip() or "normalization failed")
        info = inspect_png(temporary)
        if info.depth != 8 or info.color_type != 0 or info.has_alpha:
            raise ArtworkError("normalizer did not produce stripped 8-bit grayscale")
        temporary.replace(destination)
    finally:
        temporary.unlink(missing_ok=True)


def audit_pdf(path: Path) -> tuple[list[str], list[str]]:
    """Return hard failures and repository review triggers from pdfimages."""
    executable = shutil.which("pdfimages")
    if executable is None:
        raise ArtworkError("Poppler `pdfimages` is required for PDF artwork audit")
    completed = subprocess.run(
        [executable, "-list", str(path)], text=True, capture_output=True
    )
    if completed.returncode:
        raise ArtworkError(completed.stderr.strip() or f"cannot inspect {path}")
    failures: list[str] = []
    triggers: list[str] = []
    for line in completed.stdout.splitlines():
        fields = line.split()
        if len(fields) < 14 or not fields[0].isdigit() or fields[2] != "image":
            continue
        page, number = int(fields[0]), int(fields[1])
        try:
            width, height = int(fields[3]), int(fields[4])
            x_ppi, y_ppi = int(fields[12]), int(fields[13])
        except ValueError:
            continue
        effective = min(x_ppi, y_ppi)
        identity = f"{path}: page {page}, image {number} ({width}x{height})"
        if effective < 300:
            failures.append(f"{identity}: {effective} effective dpi is below 300")
        elif effective > 450:
            triggers.append(
                f"{identity}: {effective} effective dpi exceeds the 450 review trigger"
            )
    return failures, triggers


def main() -> int:
    parser = argparse.ArgumentParser()
    commands = parser.add_subparsers(dest="command", required=True)
    check = commands.add_parser("check", help="validate assets against a TOML manifest")
    check.add_argument("manifest", type=Path)
    normal = commands.add_parser("normalize", help="write a normalized publishing PNG")
    normal.add_argument("source", type=Path)
    normal.add_argument("destination", type=Path)
    identify = commands.add_parser("identify", help="print manifest-ready PNG fields")
    identify.add_argument("asset", type=Path)
    pdf_check = commands.add_parser(
        "check-pdf", help="audit embedded publishing-raster effective resolution"
    )
    pdf_check.add_argument("pdf", type=Path)
    pdf_check.add_argument(
        "--strict-review-triggers",
        action="store_true",
        help="make effective resolutions above 450 dpi fail as review triggers",
    )
    args = parser.parse_args()
    try:
        if args.command == "check":
            errors = validate_manifest(args.manifest)
            if errors:
                for error in errors:
                    print(f"ERROR: {error}", file=sys.stderr)
                return 1
            print(f"artwork manifest valid: {args.manifest}")
        elif args.command == "normalize":
            normalize(args.source, args.destination)
            info = inspect_png(args.destination)
            print(
                f"{args.destination}: {info.width}x{info.height}, "
                f"{info.depth}-bit {info.mode}, sha256={sha256(args.destination)}"
            )
        elif args.command == "identify":
            info = inspect_png(args.asset)
            print(f'sha256 = "{sha256(args.asset)}"')
            print(f"width = {info.width}")
            print(f"height = {info.height}")
            print(f"depth = {info.depth}")
            print(f'mode = "{info.mode}"')
        else:
            failures, triggers = audit_pdf(args.pdf)
            for trigger in triggers:
                print(f"REVIEW: {trigger}", file=sys.stderr)
            for failure in failures:
                print(f"ERROR: {failure}", file=sys.stderr)
            if failures or (triggers and args.strict_review_triggers):
                return 1
            print(
                f"PDF artwork audit passed: {args.pdf} "
                f"({len(triggers)} review trigger(s))"
            )
    except ArtworkError as exc:
        print(f"ERROR: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
