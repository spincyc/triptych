\zlabel{triptych:concise:inventory:start}
% Scratch drafting only. No accepted pagination or new review is claimed.
\begin{properstable}
\properrow{Introit}{Ps.~118:137,124; v.~1}{Justice and mercy}{The servant confesses just judgment and asks help to walk God's law.}
\properrow{Collect}{\latin{Da, quaesumus, Domine}}{Undivided allegiance}{God's people asks freedom from corruption and a pure following of him alone.}
\properrow{Epistle}{Eph.~4:1--6}{One calling}{Humility and patient charity express the body, faith, baptism and hope already shared.}
\properrow{Gradual}{Ps.~32:12,6}{Election and creation}{The chosen people depends on the Word and Spirit who establish the heavens.}
\properrow{Alleluia}{Ps.~101:2}{Afflicted prayer}{Praise carries a needy person's plea to be heard before the Gospel.}
\properrow{Gospel}{Matt.~22:34--46; Credo}{Love and lordship}{The two love commands lead to the identity of David's Son and Lord.}
\properrow{Offertory}{Dan.~9:17--19, adapted}{Common intercession}{Daniel asks mercy for the sanctuary and people bearing God's name.}
\properrow{Secret}{\latin{Maiestatem tuam}; Trinity Preface}{Healing and preservation}{The holy action is asked to free the people from past and future offenses.}
\properrow{Communion}{Ps.~75:12--13}{Gifts and fidelity}{Vows are paid before the sovereign Lord who humbles earthly princes.}
\properrow{Postcommunion}{\latin{Sanctificationibus tuis}}{Lasting remedy}{The mysteries heal vices and bring the eternal good for which charity longs.}
\end{properstable}
\zlabel{triptych:concise:inventory:end}
