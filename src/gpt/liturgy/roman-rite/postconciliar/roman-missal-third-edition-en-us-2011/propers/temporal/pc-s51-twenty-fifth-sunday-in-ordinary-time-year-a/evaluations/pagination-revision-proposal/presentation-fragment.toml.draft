# Scratch additive fragment, not a complete manifest or an adopted schema result.
presentation_contract = "interpretive-pagination-v1"

[presentation]
inventory = "concise-inventory"
overview = "concise-overview"
chronology = "concise-chronology"
themes = "concise-themes"
commentary = "integrated"

[[components]]
key = "concise-inventory"
kind = "front-matter"
path = "sections/synthesis-inventory.tex"
modes = ["synthesis"]
element_keys = ["entrance", "collect", "first-reading", "responsorial-psalm", "second-reading", "acclamation", "gospel", "offerings", "communion-ps119", "communion-jn10", "after-communion"]
depends_on = []
references = ["propers/verified.md", "instance/manifest.md"]

[[components]]
key = "concise-overview"
kind = "front-matter"
path = "sections/synthesis-overview.tex"
modes = ["synthesis"]
