    "John.10.14": {
      "path": ".scratch/no-production/pagination-revision/chronology/John.10.14.json",
      "sha256": "6e13170d889b46160533ab76deaa50fbac4561faeab865fa1c75af0eaa00bcfe",
      "command": [
        "tools/tpt",
        "scripture-chronology",
        "query",
        "John.10.14",
        "--json"
      ],
      "answer": {
        "assertions": [
          {
            "answerability": "answerable",
            "basis": "Durand's article \"The New Testament\" in the Catholic Encyclopedia (vol. 14, 1912) dates the Johannine corpus as a body: \"The Johannine writings belong to the end of the first century, from the year 90 to 100 (approximately).\"",
            "basis_class": "traditional-catholic",
            "date": "90 A.D. to 100 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "from the year 90 to 100 (approximately)",
            "note": "The window is asserted of the Johannine writings collectively \u2014 the Gospel, the three Epistles and, with a noted exception, the Apocalypse \u2014 not of the Fourth Gospel by itself.",
            "precision": "interval",
            "profile": "catholic-traditional-v1",
            "relation": "composition",
            "reporting_exception": null,
            "scope": "John",
            "sources": [
              "artifact.catholic-encyclopedia.volume-14.new-york-1912.newadvent-14530a-0a19aa2c"
            ],
            "subject": "composition.gospel-of-john",
            "title": "The Gospel of St John"
          },
          {
            "answerability": "answerable",
            "basis": "Fonck's article \"Gospel of St. John\" in the Catholic Encyclopedia (vol. 8, 1910): \"According to the general opinion, the Gospel is to be referred to the last decade of the first century, or to be still more precise, to 96 or one of the succeeding years.\" The PRECEDING sentence admits that \"As to the date of its composition we possess no certain historical information\".",
            "basis_class": "traditional-catholic",
            "date": "96 A.D. to 100 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "96 or one of the succeeding years",
            "note": "The same article reaches the same figure by a second route, from the Monarchian Prologue's statement that John wrote the Gospel \"after he had composed the Apocalypse on the Island of Patmos\", which \"would therefore refer the composition of the Gospel to A.D. 96 or one of the years immediately following\" \u2014 an argument that puts the Gospel later than the Apocalypse. Recorded as an interval and not as an approximate year: the source prints no \"about\", and both bounds are its own \u2014 \"the last decade of the first century\" caps it and \"96 or one of the succeeding years\" opens it. The approximate-year encoding this claim carried until now was rendered to consumers as \"about 96 A.D.\", a hedge the source does not print, and it both admitted years the source excludes (94-95) and excluded years it allows (97-100).",
            "precision": "interval",
            "profile": "catholic-traditional-v1",
            "relation": "composition",
            "reporting_exception": null,
            "scope": "John",
            "sources": [
              "artifact.catholic-encyclopedia.volume-8.new-york-1910.newadvent-08438a-7620a92c"
            ],
            "subject": "composition.gospel-of-john",
            "title": "The Gospel of St John"
          }
        ],
        "chronology_status": "composition-only",
        "locus": "John.10.14",
        "reason": "",
        "requested_profile": "catholic-comprehensive-v1",
        "resolved_profiles": {
          "composition": "catholic-traditional-v1"
        },
        "status": "ok",
        "v": 1
      }
    },
    "Acts.16.14": {
      "path": ".scratch/no-production/pagination-revision/chronology/Acts.16.14.json",
      "sha256": "91b9f37a153a6a28f58e7452f5a421d9f640caccf1dc41a9d6a226cf4fe450a8",
      "command": [
        "tools/tpt",
        "scripture-chronology",
        "query",
        "Acts.16.14",
        "--json"
      ],
      "answer": {
        "assertions": [
          {
            "answerability": "answerable",
            "basis": "Breen's article \"Acts of the Apostles\" in the Catholic Encyclopedia (vol. 1, 1907): \"Writers are quite concordant in placing the date of Paul's coming to Rome in the year 62; hence the year 64 is the most probable date for the Acts.\" The article says of itself that \"we may at most assign a probable date for the completion of the book\".",
            "basis_class": "traditional-catholic",
            "date": "about 64 A.D.",
            "derived": false,
            "disposition": "preferred",
            "inherited": true,
            "label": "the year 64 is the most probable date",
            "note": "The figure is the article's own inference from Paul's arrival at Rome in 62 plus the two years of Acts xxviii, 30, not an independently attested date; the same encyclopedia's St. Paul article instead puts the departure for Rome in 59 and the Roman captivity at 60-62, which would move it. Jerome (De viris illustribus 7) ties the book's composition to Rome and to the terminus of its narrative in \"the fourth year of Nero\", giving no A.D. year; that regnal reckoning is not converted here.",
            "precision": "approximate-year",
            "profile": "catholic-traditional-v1",
            "relation": "composition",
            "reporting_exception": null,
            "scope": "Acts",
            "sources": [
              "artifact.catholic-encyclopedia.volume-1.new-york-1907.newadvent-01117a-582c8526"
            ],
            "subject": "composition.acts-of-the-apostles",
            "title": "The Acts of the Apostles"
          },
          {
            "answerability": "answerable",
            "basis": "The Catholic Encyclopedia's \"St. Paul\" (Prat, vol. 11) chronological table prints \"second mission, 50-53\".",
            "basis_class": "traditional-catholic",
            "date": "50 A.D.-53 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "second mission, 50-53",
            "note": "",
            "precision": "range",
            "profile": "catholic-traditional-v1",
            "relation": "narrated-event",
            "reporting_exception": null,
            "scope": "Acts.15.36- Acts.16 Acts.17 Acts.18.1-22",
            "sources": [
              "artifact.catholic-encyclopedia.volume-11.new-york-1911.newadvent-11567b-bff0dda8"
            ],
            "subject": "apostolic-age.saint-paul-second-mission",
            "title": "St Paul's Second Missionary Journey"
          },
          {
            "answerability": "answerable",
            "basis": "The Catholic Encyclopedia's \"Biblical Chronology\" (Howlett, vol. 3) gives a different span: the second journey \"ended not very long before the third missionary expedition began, probably in 54, and began about three years previously, in 51.\"",
            "basis_class": "traditional-catholic",
            "date": "51 A.D.-54 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "began about three years previously, in 51 ... probably in 54",
            "note": "Hedged throughout (\"probably\", \"about three years previously\"), and tied to this article's council date of 51.",
            "precision": "range",
            "profile": "catholic-traditional-v1",
            "relation": "narrated-event",
            "reporting_exception": null,
            "scope": "Acts.15.36- Acts.16 Acts.17 Acts.18.1-22",
            "sources": [
              "artifact.catholic-encyclopedia.volume-3.new-york-1908.newadvent-03731a-f5f96f04"
            ],
            "subject": "apostolic-age.saint-paul-second-mission",
            "title": "St Paul's Second Missionary Journey"
          }
        ],
        "chronology_status": "dated",
        "locus": "Acts.16.14",
        "reason": "",
        "requested_profile": "catholic-comprehensive-v1",
        "resolved_profiles": {
          "composition": "catholic-traditional-v1",
          "narrated-event": "catholic-traditional-v1"
        },
        "status": "ok",
        "v": 1
      }
    },
    "Phil.1.20": {
      "path": ".scratch/no-production/pagination-revision/chronology/Phil.1.20.json",
      "sha256": "55cbab15552ecb70177b7bb8507a55c9ae3443d8957fbcd9db6c40592afbb60a",
      "command": [
        "tools/tpt",
        "scripture-chronology",
        "query",
        "Phil.1.20",
        "--json"
      ],
      "answer": {
        "assertions": [
          {
            "answerability": "answerable",
            "basis": "Prat's article \"St. Paul\" in the same encyclopedia (vol. 11, 1911) gives a single year for the four captivity letters: \"(Philemon; Colossians; Ephesians; Philippians), 61\" \u2014 a year that falls outside the Philippians article's own 62-64 window.",
            "basis_class": "traditional-catholic",
            "date": "61 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "(Philemon; Colossians; Ephesians; Philippians), 61",
            "note": "",
            "precision": "year",
            "profile": "catholic-traditional-v1",
            "relation": "composition",
            "reporting_exception": null,
            "scope": "Phil",
            "sources": [
              "artifact.catholic-encyclopedia.volume-11.new-york-1911.newadvent-11567b-bff0dda8"
            ],
            "subject": "composition.epistle-to-the-philippians",
            "title": "The Epistle to the Philippians"
          },
          {
            "answerability": "answerable",
            "basis": "Vander Heeren's article \"Epistle to the Philippians\" in the Catholic Encyclopedia (vol. 12, 1911): \"it is certain that it was written not at Caesarea, as some have maintained, but at Rome (A.D. 62-64).\"",
            "basis_class": "traditional-catholic",
            "date": "62 A.D. to 64 A.D.",
            "derived": false,
            "disposition": "disputed",
            "inherited": true,
            "label": "at Rome (A.D. 62-64)",
            "note": "Within that window the article leaves the position unsettled: \"Critics do not agree as to whether the Epistle was written at the beginning of the sojourn at Rome or at the end, before or after the other three Epistles of the captivity\", the writer himself holding for the end.",
            "precision": "interval",
            "profile": "catholic-traditional-v1",
            "relation": "composition",
            "reporting_exception": null,
            "scope": "Phil",
            "sources": [
              "artifact.catholic-encyclopedia.volume-12.new-york-1911.newadvent-12008a-1e39e824"
            ],
            "subject": "composition.epistle-to-the-philippians",
            "title": "The Epistle to the Philippians"
          }
        ],
        "chronology_status": "composition-only",
        "locus": "Phil.1.20",
        "reason": "",
        "requested_profile": "catholic-comprehensive-v1",
        "resolved_profiles": {
          "composition": "catholic-traditional-v1"
        },
        "status": "ok",
        "v": 1
      }
    },
