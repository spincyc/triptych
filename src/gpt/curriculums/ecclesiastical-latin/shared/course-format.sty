}

\newcommand{\Lexeme}[4]{\Latin{#1} --- #2; #3. #4}

% The same exercise source renders a spacious student worksheet or a compact key.
\newif\ifsolutions
\solutionsfalse
\newcounter{exercisebank}
\newcounter{worksheet}
\newcounter{exercise}[worksheet]
\newcounter{passage}[worksheet]
\newcommand{\CourseBankID}{UNSET}
\newcommand{\CourseWorksheetID}{UNSET}
\newcommand{\CourseItemNamespace}{UNSET}
\def\theHworksheet{\arabic{exercisebank}.\CourseWorksheetID}
\def\theHexercise{\arabic{exercisebank}.\CourseItemNamespace.\arabic{exercise}}
\def\theHpassage{\arabic{exercisebank}.\CourseWorksheetID.\arabic{passage}}
\newcommand{\BeginExerciseBank}[1]{%
  \stepcounter{exercisebank}%
  \setcounter{worksheet}{0}%
  \setcounter{exercise}{0}%
  \setcounter{passage}{0}%
  \renewcommand{\CourseBankID}{#1}%
}

\newcommand{\SelectedWorksheetVariants}{all}
\newcommand{\SelectWorksheetVariants}[1]{%
  \renewcommand{\SelectedWorksheetVariants}{#1}}
\newif\ifrendercourseworksheet
\NewEnviron{worksheet}[6]{%
  \rendercourseworksheetfalse
  \IfStrEq{\SelectedWorksheetVariants}{all}{\rendercourseworksheettrue}{%
    \IfSubStr{,\SelectedWorksheetVariants,}{,#2,}{\rendercourseworksheettrue}{}%
  }%
  \ifrendercourseworksheet
    \renewcommand{\CourseWorksheetID}{#1}%
    \renewcommand{\CourseItemNamespace}{#1}%
    \ifsolutions\Needspace{16\baselineskip}\else\clearpage\fi
    \refstepcounter{worksheet}%
    \setcounter{passage}{0}%
    \section*{#3 — #4}%
    \textbf{Worksheet ID:} #1\par
    \textbf{Focus:} #5\par
    \textbf{Use:} #6\par
    \ifsolutions\small\fi
    \begin{enumerate}[label=\textbf{\arabic*.},leftmargin=2em]
      \BODY
    \end{enumerate}
    \ifsolutions\normalsize\else
      \vfill
      {\scriptsize\textbf{Definition/error check:} First define uncertain Focus
      terms from memory; after the work, record each correction's rule.}\par
      \vspace{0.18in}\hrule
    \fi
  \fi
}

\newcommand{\Exercise}[3][0.38in]{%
  \refstepcounter{exercise}\item #2
  \ifsolutions
    \par\textbf{Answer / model:} #3\par\smallskip
  \else
    \par\vspace{#1}\hrulefill\par\smallskip
  \fi
}

\newcommand{\ShortExercise}[2]{\Exercise[0.22in]{#1}{#2}}
\newcommand{\LongExercise}[2]{\Exercise[0.9in]{#1}{#2}}
\newcommand{\PassageExercise}[3]{%
  \refstepcounter{passage}\item \textbf{Text:} \Latin{#1}\par
  {\scriptsize\textit{Passage ID: \CourseWorksheetID.\arabic{passage};
  exact source and collation state are recorded in the passage inventory.}}\par
  #2
  \ifsolutions\par\textbf{Answer / notes:} #3\par\smallskip
  \else\par\vspace{1.15in}\hrulefill\par\smallskip\fi
}

\newcommand{\SelectedAssessments}{all}
\newcommand{\SelectAssessments}[1]{\renewcommand{\SelectedAssessments}{#1}}
\newcommand{\CourseAssessmentID}{UNSET}
\newif\ifrendercourseassessment
\NewEnviron{assessment}[4]{%
  \rendercourseassessmentfalse
  \IfStrEq{\SelectedAssessments}{all}{\rendercourseassessmenttrue}{%
    \IfSubStr{,\SelectedAssessments,}{,#1,}{\rendercourseassessmenttrue}{}%
  }%
  \ifrendercourseassessment
    \renewcommand{\CourseAssessmentID}{#1}%
    \renewcommand{\CourseItemNamespace}{#1}%
    \setcounter{exercise}{0}%
    \clearpage\chapter*{#2}\addcontentsline{toc}{chapter}{#2}%
    \textbf{Assessment ID:} #1\par
    \textbf{Level:} #3\par
    \textbf{Conditions:} #4\par\medskip
    \begin{enumerate}[label=\textbf{\arabic*.},leftmargin=2em]
      \BODY
    \end{enumerate}
  \fi
}

\newcommand{\AssessmentItem}[3][0.65in]{%
  \Exercise[#1]{{\scriptsize\textit{Item ID: \CourseAssessmentID.\arabic{exercise}}}\par #2}{#3}}

