\newcommand{\CoursePacing}{Advance by demonstrated mastery; module packets use two focused sessions as a planning envelope}

% Course units remain authoritative in the stage source files while individual
% packet publications select one unit.  The default keeps shared companion
% renderings able to include every unit deliberately.
\newcommand{\SelectedCourseUnits}{all}
\newcommand{\SelectCourseUnits}[1]{\renewcommand{\SelectedCourseUnits}{#1}}
\NewEnviron{courseunit}[1]{%
  \IfStrEq{\SelectedCourseUnits}{all}{\BODY}{%
    \IfSubStr{,\SelectedCourseUnits,}{,#1,}{\BODY}{}%
  }%
}

% A consistent retrieval cue for terms that the learner must be able to use.
% Definitions may intentionally recur after a long gap or before a new use.
\newcommand{\Definition}[2]{%
  \par\Needspace{5\baselineskip}\medskip
  \noindent\fcolorbox{black}{LatinGray}{%
    \begin{minipage}{0.94\linewidth}
      \textbf{Definition --- #1.} #2
    \end{minipage}}
  \par\medskip
}

\newcommand{\Contrast}[3]{%
  \par\Needspace{6\baselineskip}\smallskip
  \noindent\begin{minipage}{\linewidth}
    \textbf{Do not confuse #1 with #2.} #3
  \end{minipage}
  \par\smallskip
}

