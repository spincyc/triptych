% Stable lessons remain authoritative in the stage source files while each
% substantial packet selects a comma-separated group.  The membership test
% already treats a single ID as a one-item list.  The default keeps shared
% companion renderings able to include every lesson deliberately.
\newcommand{\SelectedCourseUnits}{all}
\newcommand{\SelectCourseUnits}[1]{\renewcommand{\SelectedCourseUnits}{#1}}
% Every selected unit begins with its source-owned chapter.  Reserve the
% chapter display and the first form's own opening guard together; otherwise a
% first worksheet or solution can move to the next page while its chapter is
% left behind at the foot of the preceding page.
\newcommand{\CourseUnitOpeningGuard}{%
  % Worksheet banks may contain several independently selectable units.  The
  % first-form flag therefore belongs to the selected unit, not merely to the
  % bank: without this reset a later unit's first worksheet clears the page
  % immediately after the unit chapter heading.
  \global\firstcourseworksheettrue
  \ifsolutions
    \par\Needspace{40\baselineskip}%
  \else
    \par\Needspace{40\baselineskip}%
  \fi
}
\NewEnviron{courseunit}[1]{%
  \IfStrEq{\SelectedCourseUnits}{all}{\CourseUnitOpeningGuard\BODY}{%
    \IfSubStr{,\SelectedCourseUnits,}{,#1,}{\CourseUnitOpeningGuard\BODY}{}%
  }%
}

