% The same exercise source renders a spacious practice worksheet or a compact key.
\newif\ifsolutions
\solutionsfalse
\newcounter{exercisebank}
\newcounter{worksheet}
\newcounter{exercise}[worksheet]
\newcounter{passage}[worksheet]
\newcommand{\CourseBankID}{UNSET}
\newcommand{\CourseWorksheetID}{UNSET}
\newcommand{\CourseItemNamespace}{UNSET}
\newif\iffirstcourseworksheet
\def\theHworksheet{\arabic{exercisebank}.\CourseWorksheetID}
\def\theHexercise{\arabic{exercisebank}.\CourseItemNamespace.\arabic{exercise}}
\def\theHpassage{\arabic{exercisebank}.\CourseWorksheetID.\arabic{passage}}
\newcommand{\BeginExerciseBank}[1]{%
  \stepcounter{exercisebank}%
  \setcounter{worksheet}{0}%
  \setcounter{exercise}{0}%
  \setcounter{passage}{0}%
  \firstcourseworksheettrue
  \renewcommand{\CourseBankID}{#1}%
}

\newcommand{\SelectedWorksheetVariants}{all}
\newcommand{\SelectWorksheetVariants}[1]{%
  \renewcommand{\SelectedWorksheetVariants}{#1}}
\newif\ifrendercourseworksheet
\NewEnviron{worksheet}[6]{%
  \rendercourseworksheetfalse
  \IfStrEq{\SelectedWorksheetVariants}{all}{\rendercourseworksheettrue}{%
    \IfSubStr{,\SelectedWorksheetVariants,}{,#2,}{\rendercourseworksheettrue}{}%
  }%
  \ifrendercourseworksheet
    \renewcommand{\CourseWorksheetID}{#1}%
    \renewcommand{\CourseItemNamespace}{#1}%
    \ifsolutions
      \iffirstcourseworksheet
        % The worksheet environment is grouped; retain this bank-level state
        % after the first rendered form closes.
        \global\firstcourseworksheetfalse
        \par\Needspace{16\baselineskip}%
      \else
        % Keep each later selected solution together as a navigable key leaf.
        % A fixed reserve proved fragile because solution lengths vary by
        % module and could still leave one answer on a tail-only page.
        \par\removelastskip\clearpage
      \fi
    \else
      \iffirstcourseworksheet
        \global\firstcourseworksheetfalse
        % Do not begin the first form beneath a long unit-selection note when
        % too little room remains for a useful block of exercises.
        \par\Needspace{28\baselineskip}%
      \else
        \par\removelastskip\clearpage
      \fi
    \fi
    \refstepcounter{worksheet}%
    \setcounter{passage}{0}%
    \ifsolutions
      \section*{Solution #1 — #4}%
      \phantomsection
      \CourseUnnumberedSectionContents{Solution #1 — #4}%
      \markboth{Solution #1 — #4}{Solution #1 — #4}%
    \else
      \section*{Worksheet #1 — #4}%
      \phantomsection
      \CourseUnnumberedSectionContents{Worksheet #1 — #4}%
      \markboth{Worksheet #1 — #4}{Worksheet #1 — #4}%
    \fi
    \textbf{Worksheet ID:} #1\par
    \textbf{Focus:} #5\par
    \textbf{Use:} #6\par
    \ifsolutions\small\fi
    \begin{enumerate}[label=\textbf{\arabic*.},leftmargin=2em]
      \BODY
    \end{enumerate}
    \ifsolutions\normalsize\fi
  \fi
}

\newcommand{\Exercise}[3][0.38in]{%
  \refstepcounter{exercise}\item
  % Keep a prompt with its response space or keyed answer.  Apart from making
  % each item reviewable as a unit, this prevents an answer rule from spilling
  % onto a page that would otherwise contain only running furniture.
  \begin{minipage}[t]{\linewidth}
    #2
    \ifsolutions
      \par\textbf{Answer / model:} #3\par\smallskip
    \else
      \par\vspace{#1}\hrulefill\par\smallskip
    \fi
  \end{minipage}%
}

\newcommand{\ShortExercise}[2]{\Exercise[0.22in]{#1}{#2}}
\newcommand{\LongExercise}[2]{\Exercise[0.9in]{#1}{#2}}
% Long learner forms may declare a deliberate midpoint after visual review.
% Keys remain compact; their independently reviewed pagination is unchanged.
\newcommand{\LearnerWorksheetBreak}{%
  \ifsolutions\else\par\removelastskip\clearpage\fi}
\newcommand{\SolutionWorksheetBreak}{%
  \ifsolutions\par\removelastskip\clearpage\fi}
\newcommand{\PassageExercise}[3]{%
  \refstepcounter{passage}\item
  \begin{minipage}[t]{\linewidth}
    \textbf{Text:} \Latin{#1}\par
    {\scriptsize\textit{Passage ID: \CourseWorksheetID.\arabic{passage};
    exact source and collation state are recorded in the passage inventory.}}\par
    #2
    \ifsolutions\par\textbf{Answer / notes:} #3\par\smallskip
    \else\par\vspace{1.15in}\hrulefill\par\smallskip\fi
  \end{minipage}%
}

\newcommand{\SelectedAssessments}{all}
\newif\iffirstcourseassessment
\newcommand{\SelectAssessments}[1]{%
  \renewcommand{\SelectedAssessments}{#1}%
  \firstcourseassessmenttrue
}
\newcommand{\CourseAssessmentID}{UNSET}
\newif\ifrendercourseassessment
\newif\ifrenderassessmentgroup
\newcommand{\CheckAssessmentGroupSelection}[1]{%
  \IfStrEq{\SelectedAssessments}{all}{\renderassessmentgrouptrue}{%
    \IfSubStr{,\SelectedAssessments,}{,#1,}{\renderassessmentgrouptrue}{}%
  }%
}
\NewEnviron{assessmentgroup}[2]{%
  \renderassessmentgroupfalse
  \forcsvlist{\CheckAssessmentGroupSelection}{#1}%
  \ifrenderassessmentgroup
    \chapter{#2}%
    \BODY
  \fi
}
\NewEnviron{assessment}[4]{%
  \rendercourseassessmentfalse
  \IfStrEq{\SelectedAssessments}{all}{\rendercourseassessmenttrue}{%
    \IfSubStr{,\SelectedAssessments,}{,#1,}{\rendercourseassessmenttrue}{}%
  }%
  \ifrendercourseassessment
    \renewcommand{\CourseAssessmentID}{#1}%
    \renewcommand{\CourseItemNamespace}{#1}%
    \setcounter{exercise}{0}%
    \iffirstcourseassessment
      % Cumulative-review environments are grouped just like worksheets.
      \global\firstcourseassessmentfalse
    \else
      \par\removelastskip\clearpage
    \fi
    \section*{#2}%
    \phantomsection
    \CourseUnnumberedSectionContents{#2}%
    \markboth{#2}{#2}%
    \textbf{Review form ID:} #1\par
    \textbf{Focus:} #3\par
    \textbf{Use:} #4\par\medskip
    \begin{enumerate}[label=\textbf{\arabic*.},leftmargin=2em]
      \BODY
    \end{enumerate}
  \fi
}

\newcommand{\AssessmentItem}[3][0.65in]{%
  \refstepcounter{exercise}\item
  % One cumulative-review item is one reviewable unit. Keeping its identifier,
  % prompt, response space, and (in a key) answer in an unbreakable block
  % prevents identifiers and one-word answer tails from crossing pages.
  \begin{minipage}[t]{\linewidth}
    {\scriptsize\textit{Item ID: \CourseAssessmentID.\arabic{exercise}}}\par
    #2
    \ifsolutions
      \par\textbf{Answer / model:} #3\par\smallskip
    \else
      \par\vspace{#1}\hrulefill\par\smallskip
    \fi
  \end{minipage}}

