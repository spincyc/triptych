\newcommand{\Parse}[6]{%
  \begin{tabularx}{\linewidth}{@{}P{0.95in}P{1.05in}P{1.0in}P{0.85in}X@{}}
    \toprule
    \textbf{Form} & \textbf{Dictionary form} & \textbf{Morphology} & \textbf{Function} & \textbf{Sense here} \\
