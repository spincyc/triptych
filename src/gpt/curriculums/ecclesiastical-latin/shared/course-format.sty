\newcommand{\MasteryGate}[1]{%
  \par\medskip
  \noindent\fcolorbox{black}{LatinGray}{%
    \begin{minipage}{0.94\linewidth}
      \textbf{Advance when:} #1
    \end{minipage}}
  \par\medskip
}

\newcommand{\StudyLoop}{%
  \begin{enumerate}
    \item Read the lesson once without taking notes.
    \item Copy every paradigm and worked Latin example by hand.
    \item Close the lesson and retrieve the new definitions and forms from
          memory; for each definition, state the decisive feature and add an
          example or contrast before checking it.
    \item Complete two contrasting worksheet variants in ink.
    \item Check in a different color, explain each correction in writing, and
          choose more practice only where the error pattern persists.
    \item Attempt the unit gate on an unseen text before advancing.
  \end{enumerate}}

