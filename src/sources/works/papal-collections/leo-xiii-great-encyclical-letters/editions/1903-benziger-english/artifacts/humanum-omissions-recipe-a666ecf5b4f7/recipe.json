  "python3_program": "from pathlib import Path\nimport hashlib,json,sys,zipfile,io,csv\nH=lambda b:hashlib.sha256(b).hexdigest()\nr=json.loads(Path(sys.argv[1]).read_text());b=Path(r['source']['path']).read_bytes()\nassert H(b)==r['source']['sha256'],'source hash'\ne=Path(r['evidence']['path']).read_bytes();assert H(e)==r['evidence']['sha256'],'evidence hash'\nz=zipfile.ZipFile(io.BytesIO(e));w=json.loads(z.read('witness.json'))\nfor n,p in w['members'].items():assert H(z.read(n))==p['sha256'] and len(z.read(n))==p['byte_size'],'member hash'\nlo,hi=r['selection_absolute_byte_range'];selected=b[lo:hi]\nassert H(selected)==r['selection_sha256'],'selection hash'\nassert b[:lo].count(b'\\n')==458 and selected.count(b'\\n')==79,'selection LF bounds'\nlast=-1\nfor q in r['changes']:\n a=q['absolute_source_byte_offset'];p=q['selected_byte_offset'];assert lo<=a<=hi and p==a-lo and a>last,'insertion offset';last=a\n left=bytes.fromhex(q['left_context_hex']);right=bytes.fromhex(q['right_context_hex'])\n assert b[a-len(left):a]==left and b[a:a+len(right)]==right,'source context'\n raw=z.read(q['ocr_member']);i,j=q['ocr_byte_range'];v=raw[i:j];assert v.hex()==q['raw_ocr_hex'],'OCR slice'\n assert v.replace(b'\\n',b' ').hex()==q['replacement_hex'],'OCR composition'\n i,j=q['full_page_ocr_byte_range'];assert z.read('full-page.txt')[i:j]==v,'full-page agreement'\n crop=list(csv.DictReader(io.StringIO(z.read(q['tsv_member']).decode()),delimiter='\\t'))\n full=list(csv.DictReader(io.StringIO(z.read('full-page.tsv').decode()),delimiter='\\t'))\n for pair in q['tsv_corroboration']:\n  c,f=pair['crop'],pair['full_page'];assert c in crop and f in full and c['text']==f['text'],'TSV record'\n  assert float(c['conf'])>95 and float(f['conf'])>95,'TSV confidence'\n  assert int(c['left'])+q['crop_origin'][0]==int(f['left']) and int(c['top'])+q['crop_origin'][1]==int(f['top']),'native coordinates'\n  assert all(abs(int(c[k])-int(f[k]))<=1 for k in ('width','height')),'native token dimensions'\nout=selected\nfor q in reversed(r['changes']):\n p=q['selected_byte_offset'];i,j=q['ocr_byte_range'];v=z.read(q['ocr_member'])[i:j].replace(b'\\n',b' ');out=out[:p]+v+out[p:]\nassert H(out)==r['output_sha256'] and len(out)==r['output_byte_size'],'output hash/extent'\nrestored=out\nfor q in r['changes']:\n p=q['selected_byte_offset'];v=bytes.fromhex(q['replacement_hex']);assert restored[p:p+len(v)]==v,'inserted span';restored=restored[:p]+restored[p+len(v):]\nassert restored==selected and out.count(b'\\n')==selected.count(b'\\n'),'conservation'\nPath(sys.argv[2]).write_bytes(out)\n",
