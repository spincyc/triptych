      "publication": {
        "basis": "public-domain",
        "basis_source_id": "artifact.archdiocese-of-toledo.missale-mixtum-mozarabicum.rome-fulgoni-1804.ordo-missae-checked",
        "jurisdiction": "United States",
        "status": "permitted",
        "surfaces": [
          "public-git",
