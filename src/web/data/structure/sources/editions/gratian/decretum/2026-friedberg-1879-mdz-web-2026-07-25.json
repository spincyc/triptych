 "work": {
  "alternate_titles": [
   "Decretum Gratiani",
   "Concordia discordantium canonum"
  ],
  "author": "Gratian",
  "category": "canonical-collection",
  "description": "The mid-twelfth-century canonical collection whose first-part distinctions open with the taxonomy of law received from Isidore and whose second part includes the Tractatus de poenitentia at C.33 q.3. First-part loci use d-N-pr for the dictum Gratiani opening a distinction and d-N-c-M for a chapter with any adjoining dicta. De poenitentia loci retain their full address as c-N-q-N-de-poenitentia-d-N, followed by c-M for a chapter or da-c-M/dp-c-M for a dictum before or after it; -ss-N or -ss-N-M bounds numbered sections. The Munich (MDZ) online transcription and page images of Friedberg's 1879 Leipzig edition serve as the accessible public-domain-based witnesses.",
  "id": "work.gratian.decretum",
  "languages": [
   "la"
  ],
  "title": "Decretum (Concordia discordantium canonum)"
 }
}
