ng":"la","reason":"text-withheld","status":"unavailable"},{"available":true,"held":true,"lang":"en","reason":null,"status":"full-text"}],"latin":{"available":false,"held":false,"state":"unavailable","target":"Postcommunion","withheld":true},"name":"Postcommunion","source":"composed","taken_from":null,"text":null,"text_status":{"scope":"proper-body","state":"unavailable"},"translations":[{"caution":"A pre-1955 lay hand missal, not an approved liturgical translation and never an altar book. Its rubrics, its seasonal second and third orations, its Holy Week and its sanctoral are not those of 1962. It is carried only where a 1962 formulary is the same prayer, and nothing here may be used for recitation.\n\nSame leaf as the Secret above, headed `P. COMM. Sanctificet, of St. SATURNINUS.`, answering `Sanctificet nos, quaesumus Domine`. The page prints no conclusion. Page-image collation confirms that this historical English body answers the complete target Latin identity; publication is limited to the 1861 wording and does not claim that Cummiskey appoints the 1962 celebration.","lang":"en","rights":"public-domain","source_id":"edition.eugene-cummiskey.roman-missal-english-laity.philadelphia-1861","source_label":"The Roman Missal translated into the English language for the use of the laity, first revised edition (Philadelphia: Eugene Cummiskey, 1861)","text":"May the receiving of this thy sacrament, O Lord, we beseech thee, sanctify us: and by the intercession of thy saints, make us acceptable to thee."}],"unavailable_translations":null,"untranslated":null}],"registry":"1962-11-29","season":null,"takes_from":{"citation":"Commune Sanctorum [8]","mass":"commune-unius-martyris-4"},"text_status":null},"schema":"triptych-propers-read-mass/v1"}
