  "findings": [
    {
      "accepted_because": "Both substantive liturgical facts are accurate (the Profession of Faith is required on Sundays and the Apostles' Creed is permitted in place of the Nicene Creed), sections/synthesis/90-apparatus.tex:18 already lists both Missale Romanum Ordo Missae and GIRM 68, and a reader who never notices the compressed parenthetical source tag is not misled; adding words to settled page-1 inventory and page-3-4 themes prose would risk shifting print pagination to save a reader nothing.",
      "id": "SYN-007",
      "location": "sections/synthesis/30-themes.tex:21 (parallel in sections/synthesis/10-inventory.tex:12)",
      "problem": "The parenthetical rubric citation for the Profession of Faith ('Nicene Creed, or Apostles' Creed permitted, GIRM~68' at 30-themes.tex:21; 'Nicene Creed required, or Apostles' Creed permitted, GIRM~68' at 10-inventory.tex:12) cites GIRM 68 alone for both the Sunday obligation and the Apostles' Creed alternative. As recorded in the held source passages (GIRM 68 and Missale Romanum 2002 Ordo Missae nn. 1-20), instance/manifest.md:58, and sections/80-liturgical-resolution.tex:19, GIRM 68 establishes the Sunday requirement of the Creed, whereas the permission to use the Apostles' Creed in place of the Nicene Creed stands in the Ordo Missae rubric.",
      "required_result": "Pair GIRM~68 with the Order of Mass rubric (e.g., 'GIRM~68; \\work{Ordo Missae}') whenever the concise study cites authority for both the Sunday obligation of the Profession of Faith and the Apostles' Creed alternative.",
      "severity": "accepted"
    }
  ],
