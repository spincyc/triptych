diff --git a/src/web/browser/liturgy/reader-instrument.css b/src/web/browser/liturgy/reader-instrument.css
new file mode 100644
index 0000000000000000000000000000000000000000..634c97d094ad71f5c68cb2cfa5d74255d5dbf70e
--- /dev/null
+++ b/src/web/browser/liturgy/reader-instrument.css
@@ -0,0 +1,689 @@
+/*
+ * Accepted Liturgical Instrument presentation for the unlinked production
+ * reader candidates. State, interaction, renderers, and liturgical text remain
+ * owned by their existing production modules.
+ */
+:root {
+  --instrument-serif: Charter, "Bitstream Charter", "Iowan Old Style", Baskerville, Georgia, serif;
+  --instrument-sans: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
+  --instrument-mono: ui-monospace, SFMono-Regular, Consolas, monospace;
+  --instrument-ink: #1d211f;
+  --instrument-soft: #555e59;
+  --instrument-faint: #747d77;
+  --instrument-paper: #f4f1ea;
+  --instrument-panel: #faf8f2;
+  --instrument-line: #cfd3ce;
+  --instrument-accent: #8f292b;
+  --instrument-accent-soft: #efe3e1;
+  --instrument-focus: #1f5d8b;
+  --instrument-control: 3rem;
+  --reader-shell-height: 4.25rem;
+}
+
+html:has(.reader-instrument) {
+  scroll-behavior: smooth;
+  scroll-padding-block: 5rem calc(var(--reader-shell-height) + var(--reader-safe-bottom) + 1rem);
+  background: var(--instrument-paper);
+}
+
+body:has(.reader-instrument),
+.page-shell:has(.reader-instrument) {
+  width: 100%;
+  max-width: none;
+  margin: 0;
+  padding: 0;
+  overflow-x: clip;
+  background: var(--instrument-paper);
+  color: var(--instrument-ink);
+}
+
+body:has(.reader-instrument) > .site-header,
+body:has(.reader-instrument) > .release-banner,
+body:has(.reader-instrument) > .site-footer,
+.page-shell:has(.reader-instrument) > .breadcrumb {
+  display: none;
+}
+
+.day-reader-candidate-frame:has(.reader-instrument),
+.propers-reader-candidate-frame:has(.reader-instrument) {
+  min-width: 0;
+  background: var(--instrument-paper);
+}
+
+.candidate-flag:has(+ .reader-instrument) {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  overflow: hidden;
+  clip-path: inset(50%);
+  white-space: nowrap;
+}
+
+.reader-instrument {
+  position: relative;
+  container: reader-shell / inline-size;
+  min-width: 0;
+  min-height: 100svh;
+  padding-bottom: calc(var(--reader-shell-height) + var(--reader-safe-bottom) + 2rem);
+  background: var(--instrument-paper);
+  color: var(--instrument-ink);
+  font-family: var(--instrument-serif);
+}
+
+.reader-instrument .reader-masthead {
+  position: relative;
+  z-index: 30;
+  display: grid;
+  grid-template-columns: 1fr auto;
+  align-items: center;
+  min-height: 3.5rem;
+  padding: max(0.5rem, var(--reader-safe-top)) max(1.25rem, var(--reader-safe-right)) 0.5rem max(1.25rem, var(--reader-safe-left));
+  border-bottom: 3px solid var(--instrument-ink);
+  background: color-mix(in srgb, var(--instrument-paper) 96%, transparent);
+  font-family: var(--instrument-sans);
+}
+
+.reader-instrument .reader-brand {
+  display: inline-flex;
+  align-items: center;
+  gap: 0.55rem;
+  justify-self: start;
+  color: var(--instrument-ink);
+  font-size: 0.84rem;
+  font-weight: 650;
+  letter-spacing: 0.02em;
+  text-decoration: none;
+}
+
+.reader-instrument .reader-brand-mark {
+  display: grid;
+  width: 1.55rem;
+  height: 1.5rem;
+  background:
+    linear-gradient(currentColor, currentColor) left bottom / 0.24rem 78% no-repeat,
+    linear-gradient(currentColor, currentColor) center / 0.24rem 100% no-repeat,
+    linear-gradient(currentColor, currentColor) right bottom / 0.24rem 78% no-repeat;
+  color: var(--instrument-ink);
+}
+
+.reader-instrument .reader-place {
+  display: flex;
+  align-items: center;
+  gap: 0.45rem;
+  justify-self: end;
+  color: var(--instrument-soft);
+  font-size: 0.75rem;
+  font-weight: 560;
+}
+
+.reader-instrument .place-separator { color: var(--instrument-line); }
+
+.reader-instrument .reader-identity {
+  width: min(calc(100% - 3rem), 56rem);
+  margin: 0 auto;
+  padding: clamp(1.45rem, 4vw, 2.5rem) 0 1.4rem;
+  text-align: left;
+}
+
+.reader-instrument .reader-context {
+  margin: 0 0 0.45rem;
+  color: var(--instrument-accent);
+  font: 650 0.68rem/1.3 var(--instrument-sans);
+  letter-spacing: 0.11em;
+  text-transform: uppercase;
+}
+
+.reader-instrument .reader-identity .celebration-title {
+  max-width: 30ch;
+  margin: 0;
+  color: var(--instrument-ink);
+  font: 720 clamp(1.85rem, 3.6vw, 2.7rem)/1.08 var(--instrument-sans);
+  letter-spacing: -0.035em;
+}
+
+.reader-instrument .reader-identity .entry-title {
+  margin: 0.65rem 0 0;
+  color: var(--instrument-soft);
+  font: 500 1rem/1.35 var(--instrument-sans);
+  text-align: left;
+}
+
+.reader-instrument .reader-identity .entry-meta {
+  max-width: 60ch;
+  margin: 0.28rem 0 0;
+  color: var(--instrument-faint);
+  font: 0.78rem/1.5 var(--instrument-sans);
+  text-align: left;
+}
+
+.reader-instrument .coverage-notice {
+  max-width: 52ch;
+  margin: 0.75rem 0 0;
+  padding: 0.15rem 0 0.15rem 0.7rem;
+  border: 0;
+  border-left: 2px solid var(--instrument-accent);
+  background: transparent;
+  color: var(--instrument-soft);
+  font: 0.76rem/1.45 var(--instrument-sans);
+  text-align: left;
+}
+
+.reader-instrument .coverage-notice .uncompiled-mark {
+  color: var(--instrument-faint);
+  font-size: 0.62rem;
+}
+
+.reader-instrument [hidden] { display: none !important; }
+
+.reader-instrument .reader-document {
+  width: min(calc(100% - 3rem), 56rem);
+  margin: 0 auto;
+  padding: 0 0 7rem;
+  border: 0;
+  background: transparent;
+  box-shadow: none;
+  font-family: var(--instrument-serif);
+}
+
+.reader-instrument .reader-document > * {
+  width: auto;
+  max-width: 100%;
+  margin-inline: 0;
+}
+
+.reader-instrument .reader-document:focus-visible {
+  outline: 2px solid var(--instrument-focus);
+  outline-offset: 0.45rem;
+}
+
+.reader-instrument .reader-document [data-semantic-location],
+.reader-instrument .reader-document .proper,
+.reader-instrument .reader-document .ordinary-element,
+.reader-instrument .reader-document .ordinary-division {
+  scroll-margin-block: 5rem calc(var(--reader-shell-height) + 1rem);
+}
+
+.reader-instrument .reader-document .proper {
+  max-width: 43rem;
+  margin: 0 0 clamp(2.7rem, 6vw, 4.4rem) 8rem;
+  padding: 0;
+  border: 0;
+}
+
+.reader-instrument .reader-document .proper:focus-visible,
+.reader-instrument .reader-document .cycle-choice:focus-visible {
+  outline: 2px solid var(--instrument-focus);
+  outline-offset: 0.4rem;
+}
+
+.reader-instrument .reader-document .proper-name,
+.reader-instrument .reader-document .cycle-choice > h2 {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  justify-content: space-between;
+  gap: 0.25rem 1rem;
+  margin: 0 0 0.8rem -8rem;
+  padding: 0 0 0.48rem 8rem;
+  border: 0;
+  border-bottom: 2px solid var(--instrument-line);
+  color: var(--instrument-ink);
+  font: 650 0.83rem/1.4 var(--instrument-sans);
+  letter-spacing: 0.045em;
+  text-align: left;
+  text-transform: none;
+}
+
+.reader-instrument .reader-document .proper-ref {
+  color: var(--instrument-faint);
+  font: 500 0.74rem/1.4 var(--instrument-sans);
+  letter-spacing: 0;
+}
+
+.reader-instrument .reader-document .proper-form,
+.reader-instrument .reader-document .proper-incipit {
+  color: var(--instrument-faint);
+  font-family: var(--instrument-sans);
+  font-size: 0.76rem;
+}
+
+.reader-instrument .reader-document .passage,
+.reader-instrument .reader-document .composed {
+  color: var(--instrument-ink);
+  font-family: var(--instrument-serif);
+  font-size: 1.18rem;
+  line-height: 1.68;
+  text-align: left;
+}
+
+.reader-instrument .reader-document .passage { margin-block: 0.8rem 0; }
+.reader-instrument .reader-document .citation { margin-top: 0.9rem; }
+.reader-instrument .reader-document .citation-ref { color: var(--instrument-faint); font: 500 0.76rem/1.4 var(--instrument-sans); text-align: left; }
+.reader-instrument .reader-document .verse-num { color: var(--instrument-accent); font: 600 0.62em/1 var(--instrument-sans); }
+.reader-instrument .reader-document .row-meta { color: var(--instrument-faint); font-family: var(--instrument-sans); font-size: 0.78rem; line-height: 1.5; }
+.reader-instrument .reader-document .tag,
+.reader-instrument .reader-document .locus { border: 0; border-radius: 0; background: transparent; color: var(--instrument-faint); }
+
+.reader-instrument .reader-document .ordinary-frame { margin-top: 0.5rem; }
+.reader-instrument .reader-document .ordinary-division {
+  margin: 3.5rem 0 1.6rem;
+  padding: 0.75rem 0 0.7rem 8rem;
+  border: 0;
+  border-block: 2px solid var(--instrument-ink);
+  color: var(--instrument-ink);
+  font: 750 0.82rem/1.3 var(--instrument-sans);
+  letter-spacing: 0.08em;
+  text-align: left;
+  text-transform: uppercase;
+  text-wrap: balance;
+  hyphens: none;
+}
+
+.reader-instrument .reader-document .ordinary-frame > .ordinary-division:first-child { margin-top: 1.25rem; }
+.reader-instrument .reader-document .ordinary-frame > .ordinary-element {
+  display: grid;
+  grid-template-columns: 7rem minmax(0, 43rem);
+  column-gap: 1rem;
+  margin: 0 0 1.15rem;
+  padding: 0;
+  border: 0;
+}
+.reader-instrument .reader-document .ordinary-element > * { grid-column: 2; }
+.reader-instrument .reader-document .ordinary-element > .proper-name {
+  grid-column: 1;
+  align-self: start;
+  margin: 0;
+  padding: 0.22rem 0.75rem 0 0;
+  border: 0;
+  color: var(--instrument-accent);
+  font-size: 0.67rem;
+  letter-spacing: 0.055em;
+  text-align: right;
+}
+.reader-instrument .reader-document .ordinary-frame > .annotated {
+  max-width: 43rem;
+  margin: 3.2rem 0 3.2rem 8rem;
+  padding: 1.1rem 0 0.2rem 1rem;
+  border-left: 3px solid var(--instrument-accent);
+}
