+    def test_a_polluted_id_composes_nothing_though_it_does_not_contaminate(self):
+        # THE ONE ASYMMETRY IN `REQUEST_MEMBERS`, PINNED RATHER THAN
+        # ASSERTED. `id` is snapshotted — it is read once, off the same
