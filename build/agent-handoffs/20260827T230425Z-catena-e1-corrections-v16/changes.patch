+                    self.assertEqual(one["contentPrototype"], "null")
+                    self.assertEqual(one["contentKeys"], self.SCHEMA)
+                    self.assertIs(one["contentScalars"], True,
+                                  "the finished value carries something "
+                                  "mutable")
