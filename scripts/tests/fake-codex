#!/usr/bin/env python3
"""Hermetic fake Codex used by test_triptych_codex.py."""

from __future__ import annotations

import base64
import fcntl
import json
import os
import signal
import subprocess
import sys
import time
from pathlib import Path


def git(cwd: Path, *args: str, check: bool = True) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=cwd,
        check=check,
        capture_output=True,
        text=True,
    )


def codex_workdir(arguments: list[str]) -> Path:
    try:
        index = arguments.index("-C")
        return Path(arguments[index + 1]).resolve()
    except (ValueError, IndexError) as exc:
        raise RuntimeError("launcher did not provide -C WORKTREE") from exc


def append_record(path: Path, record: dict) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as stream:
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        json.dump(record, stream, sort_keys=True)
        stream.write("\n")
        stream.flush()
        fcntl.flock(stream.fileno(), fcntl.LOCK_UN)


def main() -> int:
    arguments = sys.argv[1:]
    workdir = codex_workdir(arguments)
    stdin = sys.stdin.buffer.read()
    root = Path(git(workdir, "rev-parse", "--show-toplevel").stdout.strip()).resolve()
    common = Path(
        git(workdir, "rev-parse", "--path-format=absolute", "--git-common-dir").stdout.strip()
    ).resolve()
    branch = git(workdir, "symbolic-ref", "--quiet", "--short", "HEAD", check=False)
    record = {
        "argv": arguments,
        "stdin": base64.b64encode(stdin).decode("ascii"),
        "process_cwd": str(Path.cwd().resolve()),
        "workdir": str(workdir),
        "root": str(root),
        "common_git_dir": str(common),
        "branch": branch.stdout.strip() if branch.returncode == 0 else None,
        "head": git(workdir, "rev-parse", "HEAD").stdout.strip(),
        "status": git(
            workdir,
            "status",
            "--porcelain=v1",
            "--untracked-files=all",
        ).stdout,
        "role": os.environ.get("TRIPTYCH_CODEX_ROLE"),
        "run_id": os.environ.get("TRIPTYCH_CODEX_RUN_ID"),
        "git_environment": {
            name: os.environ[name]
            for name in (
                "CDPATH",
                "EDITOR",
                "GIT_ATTR_GLOBAL",
                "GIT_ATTR_NOSYSTEM",
                "GIT_CONFIG_COUNT",
                "GIT_CONFIG_GLOBAL",
                "GIT_CONFIG_KEY_0",
                "GIT_CONFIG_NOSYSTEM",
                "GIT_CONFIG_VALUE_0",
                "GIT_DIR",
                "GIT_EDITOR",
                "GIT_EXEC_PATH",
                "GIT_EXTERNAL_DIFF",
                "GIT_NO_REPLACE_OBJECTS",
                "GIT_OPTIONAL_LOCKS",
                "GIT_TRACE",
                "GIT_WORK_TREE",
                "SSH_ASKPASS",
                "VISUAL",
            )
            if name in os.environ
        },
    }
    append_record(Path(os.environ["FAKE_CODEX_LOG"]), record)

    action = os.environ.get("FAKE_CODEX_ACTION", "none")
    if action == "dirty":
        (root / "agent-result.txt").write_text(
            os.environ.get("FAKE_CODEX_CONTENT", "isolated result\n"),
            encoding="utf-8",
        )
    elif action == "commit":
        (root / "agent-result.txt").write_text("committed result\n", encoding="utf-8")
        git(root, "add", "agent-result.txt")
        git(root, "commit", "-m", "Test isolated result")
    elif action == "commit-conflict-with-companion":
        (root / "agent-result.txt").write_text("committed result\n", encoding="utf-8")
        (root / "companion-result.txt").write_text(
            "protected companion result\n",
            encoding="utf-8",
        )
        git(root, "add", "agent-result.txt", "companion-result.txt")
        git(root, "commit", "-m", "Test conflict with protected companion")
    elif action == "commit-two-conflicts":
        for index in (1, 2):
            path = root / f"conflict-{index}.txt"
            path.write_text(f"worker conflict {index}\n", encoding="utf-8")
            git(root, "add", path.name)
            git(root, "commit", "-m", f"Add worker conflict {index}")
    elif action == "commit-ignored":
        (root / "build").mkdir(exist_ok=True)
        (root / "build/collision.txt").write_text("tracked worker result\n", encoding="utf-8")
        git(root, "add", "--force", "build/collision.txt")
        git(root, "commit", "-m", "Test ignored-path result")
    elif action == "commit-edit-path":
        modified = root / os.environ.get(
            "FAKE_CODEX_MODIFIED_PATH",
            "rename-source.txt",
        )
        lines = modified.read_text(encoding="utf-8").splitlines(keepends=True)
        lines[0] = os.environ.get("FAKE_CODEX_CONTENT", "worker changed line 1\n")
        modified.write_text(
            "".join(lines),
            encoding="utf-8",
        )
        git(root, "add", str(modified.relative_to(root)))
        git(root, "commit", "-m", "Edit worker path")
    elif action == "stage-conflict":
        conflict_path = root / os.environ.get(
            "FAKE_CODEX_CONFLICT_PATH",
            "agent-result.txt",
        )
        conflict_path.write_text(
            os.environ.get("FAKE_CODEX_CONTENT", "manually resolved result\n"),
            encoding="utf-8",
        )
        git(root, "add", str(conflict_path.relative_to(root)))
        extra_staged = os.environ.get("FAKE_CODEX_EXTRA_STAGED")
        if extra_staged:
            extra_path = root / extra_staged
            extra_path.write_text("unexpected staged resolver work\n", encoding="utf-8")
            git(root, "add", str(extra_path.relative_to(root)))
    elif action == "correct-overstage":
        extra_staged = os.environ["FAKE_CODEX_EXTRA_STAGED"]
        extra_path = root / extra_staged
        tracked = git(root, "cat-file", "-e", f"HEAD:{extra_staged}", check=False)
        if tracked.returncode == 0:
            git(
                root,
                "restore",
                "--source=HEAD",
                "--staged",
                "--worktree",
                "--",
                extra_staged,
            )
        else:
            git(root, "rm", "--cached", "--ignore-unmatch", "--", extra_staged)
            extra_path.unlink(missing_ok=True)
        conflict_path = root / os.environ.get(
            "FAKE_CODEX_CONFLICT_PATH",
            "agent-result.txt",
        )
        conflict_path.write_text(
            os.environ.get("FAKE_CODEX_CONTENT", "manually resolved result\n"),
            encoding="utf-8",
        )
        git(root, "add", str(conflict_path.relative_to(root)))
    elif action == "correct-protected-overstage":
        protected_path = os.environ["FAKE_CODEX_EXTRA_STAGED"]
        git(
            root,
            "restore",
            "--source=REBASE_HEAD",
            "--staged",
            "--worktree",
            "--",
            protected_path,
        )
        conflict_path = root / os.environ.get(
            "FAKE_CODEX_CONFLICT_PATH",
            "agent-result.txt",
        )
        conflict_path.write_text(
            os.environ.get("FAKE_CODEX_CONTENT", "manually resolved result\n"),
            encoding="utf-8",
        )
        git(root, "add", str(conflict_path.relative_to(root)))
    elif action == "tamper-rebase-todo":
        rebase_directory = Path(
            git(root, "rev-parse", "--git-path", "rebase-merge").stdout.strip()
        )
        if not rebase_directory.is_absolute():
            rebase_directory = root / rebase_directory
        with (rebase_directory / "git-rebase-todo").open("a", encoding="utf-8") as stream:
            stream.write("exec false\n")
    elif action == "reset-parent":
        git(root, "reset", "--hard", "HEAD^")
    elif action == "rewrite-sibling":
        git(root, "reset", "--hard", "HEAD^")
        (root / "rewritten-sibling-result.txt").write_text(
            "clean rewritten sibling result\n",
            encoding="utf-8",
        )
        git(root, "add", "rewritten-sibling-result.txt")
        git(root, "commit", "-m", "Replace audited result with sibling history")
    elif action == "remove-dirty-result":
        (root / "agent-result.txt").unlink(missing_ok=True)
    elif action == "recursive":
        nested_environment = os.environ.copy()
        nested_environment["FAKE_CODEX_ACTION"] = "none"
        nested_environment["FAKE_CODEX_EXIT"] = "0"
        result = subprocess.run(
            [str(root / "scripts/triptych-codex"), "nested invocation"],
            cwd=root,
            env=nested_environment,
            check=False,
        )
        if result.returncode != 2:
            return result.returncode
    elif action == "recursive-detached":
        git(root, "switch", "--detach")
        nested_environment = os.environ.copy()
        nested_environment.pop("TRIPTYCH_CODEX_ROLE", None)
        nested_environment.pop("TRIPTYCH_CODEX_RUN_ID", None)
        nested_environment["FAKE_CODEX_ACTION"] = "none"
        nested_environment["FAKE_CODEX_EXIT"] = "0"
        result = subprocess.run(
            [str(root / "scripts/triptych-codex"), "marker-free nested invocation"],
            cwd=root,
            env=nested_environment,
            check=False,
        )
        if result.returncode != 2:
            return result.returncode
    elif action == "retarget-git":
        git_link = Path(os.environ["FAKE_CODEX_GIT_LINK"])
        git_link.unlink()
        git_link.symlink_to(Path(os.environ["FAKE_CODEX_GIT_REPLACEMENT"]))
    elif action == "ignored":
        (root / "build").mkdir(exist_ok=True)
        (root / "build/generated.tmp").write_text("transient output\n", encoding="utf-8")
    elif action == "signal":
        os.kill(os.getpid(), signal.SIGTERM)
    elif action == "background":
        ready = os.environ["FAKE_CODEX_BACKGROUND_READY"]
        release = os.environ["FAKE_CODEX_BACKGROUND_RELEASE"]
        program = (
            "import pathlib,sys,time; "
            "ready=pathlib.Path(sys.argv[1]); release=pathlib.Path(sys.argv[2]); "
            "ready.write_text('ready\\n', encoding='utf-8'); "
            "deadline=time.monotonic()+15; "
            "\nwhile not release.exists() and time.monotonic() < deadline: time.sleep(0.02)"
        )
        subprocess.Popen(
            [sys.executable, "-c", program, ready, release],
            close_fds=False,
            stdin=subprocess.DEVNULL,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

    ready = os.environ.get("FAKE_CODEX_READY")
    release = os.environ.get("FAKE_CODEX_RELEASE")
    if ready:
        Path(ready).write_text("ready\n", encoding="utf-8")
    if release:
        release_path = Path(release)
        deadline = time.monotonic() + 15
        while not release_path.exists():
            if time.monotonic() >= deadline:
                return 124
            time.sleep(0.02)
    delay = float(os.environ.get("FAKE_CODEX_SLEEP", "0"))
    if delay:
        time.sleep(delay)

    sys.stdout.write(os.environ.get("FAKE_CODEX_STDOUT", ""))
    sys.stderr.write(os.environ.get("FAKE_CODEX_STDERR", ""))
    return int(os.environ.get("FAKE_CODEX_EXIT", "0"))


if __name__ == "__main__":
    raise SystemExit(main())
