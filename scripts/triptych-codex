#!/usr/bin/env python3
"""Run Triptych's co-located Worktree Marshal compatibility engine."""

from __future__ import annotations

import sys
from collections.abc import Callable
from pathlib import Path


def bootstrap() -> tuple[Callable[..., int], Path]:
    try:
        invocation_path = Path(__file__).resolve(strict=True)
        source_root = (
            invocation_path.parents[1]
            / "tools"
            / "worktree-marshal"
            / "src"
        ).resolve(strict=True)
        expected_engine = (
            source_root / "worktree_marshal" / "triptych_compat.py"
        ).resolve(strict=True)
    except (IndexError, OSError) as exc:
        raise RuntimeError("the co-located Worktree Marshal engine is unavailable") from exc

    sys.path.insert(0, str(source_root))
    try:
        from worktree_marshal import triptych_compat
    except ImportError as exc:
        raise RuntimeError("the co-located Worktree Marshal engine is unavailable") from exc

    try:
        imported_engine = Path(triptych_compat.__file__).resolve(strict=True)
    except (OSError, TypeError) as exc:
        raise RuntimeError("cannot authenticate the Worktree Marshal engine") from exc
    if imported_engine != expected_engine:
        raise RuntimeError("the imported Worktree Marshal engine is not co-located")
    return triptych_compat.main, invocation_path


def main() -> int:
    try:
        engine_main, invocation_path = bootstrap()
    except RuntimeError as exc:
        print(f"triptych-codex: {exc}", file=sys.stderr)
        return 2
    return engine_main(invocation_path=invocation_path)


if __name__ == "__main__":
    raise SystemExit(main())
