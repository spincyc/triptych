#!/usr/bin/env python3
"""Prepare memory-bounded page rasters for Triptych PDF review."""

from __future__ import annotations

import argparse
from collections.abc import Callable, Iterator
import concurrent.futures
import contextlib
import dataclasses
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import resource
import shutil
import signal
import stat
import subprocess
import sys
import tempfile
import threading
import time
import uuid


ROOT = Path(__file__).resolve().parents[1]
DEFAULT_OUTPUT = ROOT / "build/pdf-review"
MIB = 1024 * 1024
GIB = 1024 * MIB
RESERVE_BYTES = GIB
CHILD_ADDRESS_SPACE_BYTES = GIB
WORKER_BYTES = CHILD_ADDRESS_SPACE_BYTES
FULL_PAGE_MAX_DIMENSION = 1600
THUMBNAIL_MAX_DIMENSION = 420
CONTACT_BATCH_SIZE = 20
CONTACT_COLUMNS = 4
THUMBNAIL_BATCH_SIZE = 20
CONTACT_GEOMETRY = "+8+8"
MAGICK_MEMORY = "256MiB"
MAGICK_MAP = "512MiB"
MAGICK_DISK = "2GiB"
MAGICK_AREA = "64MP"
DIAGNOSTIC_TAIL_BYTES = 64 * 1024
CACHE_SCHEMA = 1
RENDERER_SCHEMA = "triptych-pdf-review-v3-explicit-font"
CONTACT_FONT_FILENAME = "lmsans10-regular.otf"
METADATA_NAME = "review-cache.json"
RUN_MANIFEST_NAME = "review-run.json"
RUN_MANIFEST_SCHEMA = 1
RUN_ID_RE = re.compile(r"^[0-9]{8}t[0-9]{6}z-[0-9a-f]{12}$")


class ReviewError(RuntimeError):
    """A safe, operator-facing PDF review failure."""


class ReviewSignal(BaseException):
    """A termination signal converted into controlled subprocess cleanup."""

    def __init__(self, signum: int) -> None:
        super().__init__(signum)
        self.signum = signum


class TerminationController:
    """Raise once so repeated termination cannot interrupt child cleanup."""

    def __init__(self) -> None:
        self.signum: int | None = None
        self.cleanup_armed = False
        self._cleanup: Callable[[], None] | None = None

    def arm_cleanup(self) -> None:
        self.cleanup_armed = True

    def register_cleanup(self, callback: Callable[[], None]) -> None:
        self._cleanup = callback

    def clear_cleanup(self, callback: Callable[[], None]) -> None:
        if self._cleanup is callback:
            self._cleanup = None

    def ensure_cleanup(self) -> None:
        callback = self._cleanup
        if callback is not None:
            self.arm_cleanup()
            callback()

    def __call__(self, signum: int, _frame: object) -> None:
        if self.signum is not None or self.cleanup_armed:
            return
        self.signum = signum
        raise ReviewSignal(signum)


@dataclasses.dataclass(frozen=True)
class ResourcePlan:
    host_available: int | None
    cgroup_available: int | None
    effective_available: int | None
    reserve: int
    per_worker: int
    cpu_limit: int
    jobs: int
    override: int | None


@dataclasses.dataclass(frozen=True)
class PdfTask:
    source: Path
    relative_output: Path
    pdf_sha256: str | None = None
    render_source: Path | None = None


@dataclasses.dataclass(frozen=True)
class ReviewResult:
    task: PdfTask
    pdf_sha256: str
    page_count: int


def read_text(path: Path) -> str | None:
    try:
        return path.read_text(encoding="utf-8").strip()
    except (OSError, UnicodeError):
        return None


def parse_memavailable(path: Path = Path("/proc/meminfo")) -> int | None:
    text = read_text(path)
    if text is None:
        return None
    match = re.search(r"^MemAvailable:\s+(\d+)\s+kB$", text, re.MULTILINE)
    if not match:
        return None
    return int(match.group(1)) * 1024


def cgroup_limit(path: Path) -> tuple[int | None, bool]:
    value = read_text(path)
    if value == "max":
        return None, True
    if value is None or not value.isdecimal():
        return None, False
    return int(value), True


def cgroup2_location(
    cgroup_file: Path = Path("/proc/self/cgroup"),
    mountinfo_file: Path = Path("/proc/self/mountinfo"),
) -> tuple[Path, Path] | None:
    cgroup_text = read_text(cgroup_file)
    mountinfo_text = read_text(mountinfo_file)
    if cgroup_text is None or mountinfo_text is None:
        return None
    relative: str | None = None
    for line in cgroup_text.splitlines():
        fields = line.split(":", 2)
        if len(fields) == 3 and fields[0] == "0" and fields[1] == "":
            relative = fields[2]
            break
    if relative is None:
        return None
    for line in mountinfo_text.splitlines():
        before, separator, after = line.partition(" - ")
        if not separator or not after.startswith("cgroup2 "):
            continue
        fields = before.split()
        if len(fields) < 5:
            continue
        mount = Path(fields[4])
        mount_root = Path(fields[3])
        cgroup_path = Path(relative)
        try:
            inside_mount = cgroup_path.relative_to(mount_root)
        except ValueError:
            inside_mount = Path(relative.lstrip("/"))
        return mount, mount / inside_mount
    return None


def unified_cgroup_member(
    cgroup_file: Path = Path("/proc/self/cgroup"),
) -> bool:
    text = read_text(cgroup_file)
    if text is None:
        return False
    for line in text.splitlines():
        fields = line.split(":", 2)
        if len(fields) == 3 and fields[0] == "0" and fields[1] == "":
            return True
    return False


def legacy_cgroup_controllers(
    cgroup_file: Path = Path("/proc/self/cgroup"),
) -> set[str]:
    """Return controllers delegated through cgroup v1 or a hybrid hierarchy."""

    text = read_text(cgroup_file)
    if text is None:
        return set()
    controllers: set[str] = set()
    for line in text.splitlines():
        fields = line.split(":", 2)
        if len(fields) != 3 or fields[0] == "0":
            continue
        controllers.update(value for value in fields[1].split(",") if value)
    return controllers


def cgroup_ancestors(mount: Path, leaf: Path) -> list[Path]:
    try:
        relative = leaf.resolve().relative_to(mount.resolve())
    except (OSError, ValueError):
        return []
    result = [mount.resolve() / relative]
    while result[-1] != mount.resolve():
        result.append(result[-1].parent)
    return result


def cgroup_memory_probe(mount: Path, leaf: Path) -> tuple[int | None, bool]:
    directories = cgroup_ancestors(mount, leaf)
    if not directories:
        return None, False
    headrooms: list[int] = []
    observed = False
    for directory in directories:
        current_text = read_text(directory / "memory.current")
        if current_text is None or not current_text.isdecimal():
            # The cgroup2 root cannot itself be resource-limited and may omit
            # controller interfaces; a missing non-root ancestor is unsafe.
            if observed and directory == mount.resolve():
                break
            return None, False
        current = int(current_text)
        for name in ("memory.max", "memory.high"):
            limit, resolved = cgroup_limit(directory / name)
            if not resolved:
                return None, False
            if limit is not None:
                headrooms.append(max(0, limit - current))
        observed = True
    return (min(headrooms) if headrooms else None), True


def cgroup_memory_headroom(mount: Path, leaf: Path) -> int | None:
    return cgroup_memory_probe(mount, leaf)[0]


def cgroup_cpu_probe(mount: Path, leaf: Path) -> tuple[int | None, bool]:
    directories = cgroup_ancestors(mount, leaf)
    if not directories:
        return None, False
    quotas: list[int] = []
    observed = False
    for directory in directories:
        value = read_text(directory / "cpu.max")
        if value is None:
            # As above, only the cgroup2 mount root may omit this interface.
            if observed and directory == mount.resolve():
                break
            return None, False
        fields = value.split()
        if len(fields) != 2:
            return None, False
        try:
            period = int(fields[1])
        except ValueError:
            return None, False
        if period <= 0:
            return None, False
        if fields[0] == "max":
            observed = True
            continue
        try:
            quota = int(fields[0])
        except ValueError:
            return None, False
        if quota <= 0:
            return None, False
        quotas.append(max(1, math.ceil(quota / period)))
        observed = True
    return (min(quotas) if quotas else None), True


def cgroup_cpu_quota(mount: Path, leaf: Path) -> int | None:
    return cgroup_cpu_probe(mount, leaf)[0]


def available_cpus() -> int:
    try:
        affinity = len(os.sched_getaffinity(0))
    except (AttributeError, OSError):
        affinity = os.cpu_count() or 1
    location = cgroup2_location()
    quota, resolved = cgroup_cpu_probe(*location) if location else (None, False)
    unresolved_unified = location is None and unified_cgroup_member()
    if quota is None and (
        (location is not None and not resolved)
        or unresolved_unified
        or {"cpu", "cpuacct"} & legacy_cgroup_controllers()
    ):
        # Stay conservative when a unified mount cannot be resolved or a v1
        # controller may impose a quota we cannot safely traverse.
        quota = 1
    return max(1, min(affinity, quota) if quota is not None else affinity)


def make_plan(
    host_available: int | None,
    cgroup_available: int | None,
    cpu_limit: int,
    override: int | None = None,
) -> ResourcePlan:
    candidates = [value for value in (host_available, cgroup_available) if value is not None]
    effective = min(candidates) if candidates else None
    cpu_limit = max(1, cpu_limit)
    if override is not None and override < 1:
        raise ReviewError("--jobs must be a positive integer")
    if effective is None:
        automatic_jobs = 1
    else:
        usable = max(0, effective - RESERVE_BYTES)
        if usable < WORKER_BYTES:
            raise ReviewError(
                "insufficient memory for PDF review: "
                f"{format_bytes(effective)} available; "
                f"need {format_bytes(RESERVE_BYTES + WORKER_BYTES)} "
                "for the reserve and one bounded worker"
            )
        automatic_jobs = usable // WORKER_BYTES
        automatic_jobs = min(automatic_jobs, cpu_limit)
    jobs = min(automatic_jobs, override) if override is not None else automatic_jobs
    return ResourcePlan(
        host_available=host_available,
        cgroup_available=cgroup_available,
        effective_available=effective,
        reserve=RESERVE_BYTES,
        per_worker=WORKER_BYTES,
        cpu_limit=cpu_limit,
        jobs=int(jobs),
        override=override,
    )


def current_plan(override: int | None = None) -> ResourcePlan:
    location = cgroup2_location()
    cgroup_available, resolved = (
        cgroup_memory_probe(*location) if location else (None, False)
    )
    unresolved_unified = location is None and unified_cgroup_member()
    if cgroup_available is None and (
        (location is not None and not resolved)
        or unresolved_unified
        or "memory" in legacy_cgroup_controllers()
    ):
        # A unified hierarchy is unresolved/unreadable or a v1 controller is
        # present; either way, do not guess at an effective ancestor limit.
        cgroup_available = 0
    return make_plan(parse_memavailable(), cgroup_available, available_cpus(), override)


def format_bytes(value: int | None) -> str:
    if value is None:
        return "unknown"
    return f"{value / GIB:.2f} GiB"


def describe_plan(plan: ResourcePlan) -> str:
    override = f", requested-cap={plan.override}" if plan.override is not None else ""
    return (
        "pdf-review: "
        f"host-available={format_bytes(plan.host_available)}, "
        f"cgroup-headroom={format_bytes(plan.cgroup_available)}, "
        f"effective={format_bytes(plan.effective_available)}, "
        f"reserve={format_bytes(plan.reserve)}, "
        f"per-worker={format_bytes(plan.per_worker)}, "
        f"cpu-cap={plan.cpu_limit}, jobs={plan.jobs}{override}"
    )


def positive_integer(value: str) -> int:
    try:
        parsed = int(value, 10)
    except ValueError as exc:
        raise argparse.ArgumentTypeError("must be a positive integer") from exc
    if parsed < 1:
        raise argparse.ArgumentTypeError("must be a positive integer")
    return parsed


def is_relative_to(path: Path, parent: Path) -> bool:
    try:
        path.relative_to(parent)
    except ValueError:
        return False
    return True


def validate_artifact_root(value: Path, option: str) -> Path:
    output = (ROOT / value).resolve() if not value.is_absolute() else value.resolve()
    build_root = (ROOT / "build").resolve()
    run_id = os.environ.get("TRIPTYCH_CODEX_RUN_ID")
    managed_worker = (
        os.environ.get("TRIPTYCH_CODEX_ROLE") in {"worker", "resolver"}
        and isinstance(run_id, str)
        and RUN_ID_RE.fullmatch(run_id) is not None
    )
    temporary_roots: list[Path] = []
    if managed_worker:
        configured_values = {
            os.environ.get(name) for name in ("TMPDIR", "TMP", "TEMP")
        }
        if None not in configured_values and len(configured_values) == 1:
            configured_value = configured_values.pop()
            assert configured_value is not None
            candidate = Path(configured_value)
            try:
                candidate_metadata = candidate.lstat()
                parent_metadata = candidate.parent.lstat()
            except OSError:
                pass
            else:
                if (
                    candidate.is_absolute()
                    and candidate.name == run_id
                    and candidate.parent.name == "tmp"
                    and stat.S_ISDIR(candidate_metadata.st_mode)
                    and stat.S_ISDIR(parent_metadata.st_mode)
                    and candidate_metadata.st_uid == os.getuid()
                    and parent_metadata.st_uid == os.getuid()
                    and candidate == candidate.resolve()
                ):
                    temporary_roots.append(candidate)
    else:
        temporary_roots.append(Path("/tmp").resolve())
    allowed_temporary = any(
        output != temporary_root and is_relative_to(output, temporary_root)
        for temporary_root in temporary_roots
    )
    allowed = is_relative_to(output, build_root) or allowed_temporary
    if not allowed:
        temporary_description = (
            "the managed TMPDIR"
            if managed_worker
            else "/tmp"
        )
        raise ReviewError(
            f"{option} must remain under this checkout's build/ tree or a "
            f"{temporary_description} subdirectory"
        )
    return output


def validate_output_root(value: Path) -> Path:
    return validate_artifact_root(value, "--output")


def validate_cache_root(value: Path) -> Path:
    return validate_artifact_root(value, "--cache")


def safe_component(value: str) -> str:
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", value).strip("-.")
    return cleaned or "pdf"


def task_for_pdf(value: str) -> PdfTask:
    path = Path(value)
    source = (Path.cwd() / path).resolve() if not path.is_absolute() else path.resolve()
    if not source.is_file() or source.suffix.lower() != ".pdf":
        raise ReviewError(f"not a readable PDF: {value}")
    try:
        relative = source.relative_to(ROOT)
        output = relative.with_suffix("")
    except ValueError:
        digest = hashlib.sha256(os.fsencode(source)).hexdigest()[:12]
        output = Path("external") / f"{safe_component(source.stem)}-{digest}"
    return PdfTask(source=source, relative_output=output)


def repository_identity_digest() -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--git-common-dir"],
        cwd=ROOT,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.DEVNULL,
    )
    identity = (result.stdout.strip() if result.returncode == 0 else str(ROOT.resolve()))
    common = Path(identity)
    if not common.is_absolute():
        common = ROOT / common
    return hashlib.sha256(os.fsencode(common.resolve())).hexdigest()[:16]


def default_cache_root() -> Path:
    return ROOT / "build/pdf-review-cache"


def review_lock_path() -> Path:
    return Path("/tmp") / (
        f"triptych-pdf-review-{os.getuid()}-{repository_identity_digest()}.lock"
    )


@contextlib.contextmanager
def exclusive_review_lock():
    path = review_lock_path()
    flags = os.O_RDWR | os.O_CREAT | getattr(os, "O_CLOEXEC", 0) | getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags, 0o600)
    except OSError as exc:
        raise ReviewError(f"cannot open review lock {path}: {exc}") from exc
    stream = os.fdopen(descriptor, "a+", encoding="utf-8")
    try:
        details = os.fstat(stream.fileno())
        if not stat.S_ISREG(details.st_mode) or details.st_uid != os.getuid():
            raise ReviewError(f"unsafe review lock: {path}")
        fcntl.flock(stream.fileno(), fcntl.LOCK_EX)
        yield
    finally:
        with contextlib.suppress(OSError):
            fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
        stream.close()


class CommandRunner:
    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._processes: set[subprocess.Popen[bytes]] = set()
        self._cancelled = False

    def run(
        self,
        command: list[str],
        *,
        environment: dict[str, str] | None = None,
        capture: bool = False,
    ) -> bytes:
        limited_command = [
            sys.executable,
            str(Path(__file__).resolve()),
            "--_limit-child",
            str(CHILD_ADDRESS_SPACE_BYTES),
            "--",
            *command,
        ]
        with self._lock:
            if self._cancelled:
                raise ReviewError("review cancelled")
            process = subprocess.Popen(
                limited_command,
                cwd=ROOT,
                env=environment,
                stdout=subprocess.PIPE if capture else subprocess.DEVNULL,
                stderr=subprocess.STDOUT if capture else subprocess.PIPE,
                start_new_session=True,
            )
            self._processes.add(process)
        diagnostic_tail = bytearray()
        try:
            diagnostic_stream = process.stdout if capture else process.stderr
            if diagnostic_stream is None:
                raise ReviewError("bounded child has no diagnostic stream")
            while chunk := diagnostic_stream.read(8192):
                diagnostic_tail.extend(chunk)
                if len(diagnostic_tail) > DIAGNOSTIC_TAIL_BYTES:
                    del diagnostic_tail[:-DIAGNOSTIC_TAIL_BYTES]
            process.wait()
        except BaseException:
            if process.poll() is None:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGKILL)
                with contextlib.suppress(subprocess.TimeoutExpired):
                    process.wait(timeout=3)
            raise
        finally:
            with self._lock:
                if process.poll() is not None:
                    self._processes.discard(process)
        if process.returncode:
            detail = diagnostic_tail.decode("utf-8", errors="replace").strip()
            suffix = f": {detail}" if detail else ""
            raise ReviewError(f"command failed ({process.returncode}): {command[0]}{suffix}")
        return bytes(diagnostic_tail)

    def capture(
        self, command: list[str], *, environment: dict[str, str] | None = None
    ) -> str:
        return self.run(command, environment=environment, capture=True).decode(
            "utf-8", errors="replace"
        ).strip()

    def terminate_all(self) -> None:
        with self._lock:
            self._cancelled = True
            processes = list(self._processes)
        for process in processes:
            if process.poll() is None:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGTERM)
        deadline = time.monotonic() + 3
        while time.monotonic() < deadline and any(
            process.poll() is None for process in processes
        ):
            time.sleep(0.05)
        for process in processes:
            if process.poll() is None:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(process.pid, signal.SIGKILL)


def executable_from_environment(name: str, default: str) -> str:
    value = os.environ.get(name, default)
    resolved = shutil.which(value)
    if resolved is None:
        raise ReviewError(f"missing required executable: {value}")
    return str(Path(resolved).resolve())


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    try:
        with path.open("rb") as stream:
            while chunk := stream.read(MIB):
                digest.update(chunk)
    except OSError as exc:
        raise ReviewError(f"cannot hash {path}: {exc}") from exc
    return digest.hexdigest()


def required_regular_file(path: Path, description: str) -> Path:
    try:
        resolved = path.resolve(strict=True)
    except OSError as exc:
        raise ReviewError(f"cannot resolve {description} {path}: {exc}") from exc
    if not resolved.is_file() or not os.access(resolved, os.R_OK):
        raise ReviewError(f"{description} is not a readable regular file: {resolved}")
    return resolved


def contact_font(runner: CommandRunner) -> Path:
    override = os.environ.get("TRIPTYCH_PDF_REVIEW_FONT")
    if override:
        return required_regular_file(Path(override), "review contact-sheet font")
    kpsewhich = executable_from_environment(
        "TRIPTYCH_PDF_REVIEW_KPSEWHICH", "kpsewhich"
    )
    result = runner.capture([kpsewhich, CONTACT_FONT_FILENAME])
    lines = result.splitlines()
    if len(lines) != 1 or not lines[0]:
        raise ReviewError(
            f"kpsewhich did not resolve exactly one {CONTACT_FONT_FILENAME} path"
        )
    return required_regular_file(Path(lines[0]), "review contact-sheet font")


def snapshot_pdf(task: PdfTask, snapshot_root: Path) -> PdfTask:
    """Copy one open PDF stream and bind the immutable copy to its digest."""

    snapshot_root.mkdir(parents=True, exist_ok=True)
    descriptor, raw_path = tempfile.mkstemp(
        prefix=f".{safe_component(task.source.stem)}.snapshot-",
        suffix=".pdf",
        dir=snapshot_root,
    )
    snapshot = Path(raw_path)
    digest = hashlib.sha256()
    try:
        with task.source.open("rb") as source, os.fdopen(descriptor, "wb") as target:
            descriptor = -1
            while chunk := source.read(MIB):
                digest.update(chunk)
                target.write(chunk)
        return dataclasses.replace(
            task,
            pdf_sha256=digest.hexdigest(),
            render_source=snapshot,
        )
    except BaseException:
        if descriptor >= 0:
            os.close(descriptor)
        snapshot.unlink(missing_ok=True)
        raise


def canonical_json(value: object) -> bytes:
    return json.dumps(
        value, sort_keys=True, separators=(",", ":"), ensure_ascii=True
    ).encode("ascii")


def tool_record(
    executable: str, version_arguments: list[str], runner: CommandRunner
) -> dict[str, str]:
    path = Path(executable)
    if not path.is_file():
        raise ReviewError(f"renderer is not a regular file: {path}")
    version = runner.capture([executable, *version_arguments])
    if not version:
        raise ReviewError(f"renderer reported no version: {path}")
    return {
        "path": str(path),
        "sha256": sha256_file(path),
        "version": version,
    }


def renderer_record(
    pdftoppm: str,
    magick: str,
    font: Path,
    font_sha256: str,
    runner: CommandRunner,
) -> tuple[str, dict[str, object]]:
    record: dict[str, object] = {
        "schema": RENDERER_SCHEMA,
        "tools": {
            "pdftoppm": tool_record(pdftoppm, ["-v"], runner),
            "magick": tool_record(magick, ["-version"], runner),
        },
        "raster": {
            "format": "png",
            "full_page_max_dimension": FULL_PAGE_MAX_DIMENSION,
            "thumbnail_max_dimension": THUMBNAIL_MAX_DIMENSION,
            "thumbnail_batch_size": THUMBNAIL_BATCH_SIZE,
        },
        "contact_sheets": {
            "batch_size": CONTACT_BATCH_SIZE,
            "columns": CONTACT_COLUMNS,
            "geometry": CONTACT_GEOMETRY,
            "background": "white",
            "fill": "black",
            "font": {
                "path": str(font),
                "sha256": font_sha256,
            },
            "label": "Page {number}",
        },
        "limits": {
            "address_space_bytes": CHILD_ADDRESS_SPACE_BYTES,
            "magick_memory": MAGICK_MEMORY,
            "magick_map": MAGICK_MAP,
            "magick_disk": MAGICK_DISK,
            "magick_area": MAGICK_AREA,
            "magick_threads": 1,
            "omp_threads": 1,
        },
    }
    return hashlib.sha256(canonical_json(record)).hexdigest(), record


def cache_key(pdf_sha256: str, renderer_fingerprint: str) -> str:
    return hashlib.sha256(
        canonical_json(
            {
                "schema": CACHE_SCHEMA,
                "pdf_sha256": pdf_sha256,
                "renderer_fingerprint": renderer_fingerprint,
            }
        )
    ).hexdigest()


def numeric_pngs(directory: Path) -> list[tuple[int, Path]]:
    result: list[tuple[int, Path]] = []
    for path in directory.glob("page-*.png"):
        match = re.fullmatch(r"page-(\d+)\.png", path.name)
        if match:
            result.append((int(match.group(1)), path))
    return sorted(result)


def magick_environment(temporary: Path) -> dict[str, str]:
    environment = os.environ.copy()
    environment.update(
        {
            "MAGICK_MEMORY_LIMIT": MAGICK_MEMORY,
            "MAGICK_MAP_LIMIT": MAGICK_MAP,
            "MAGICK_DISK_LIMIT": MAGICK_DISK,
            "MAGICK_AREA_LIMIT": MAGICK_AREA,
            "MAGICK_THREAD_LIMIT": "1",
            "MAGICK_TEMPORARY_PATH": str(temporary),
            "OMP_NUM_THREADS": "1",
        }
    )
    return environment


def magick_limits() -> list[str]:
    return [
        "-limit",
        "memory",
        MAGICK_MEMORY,
        "-limit",
        "map",
        MAGICK_MAP,
        "-limit",
        "disk",
        MAGICK_DISK,
        "-limit",
        "area",
        MAGICK_AREA,
        "-limit",
        "thread",
        "1",
    ]


def artifact_file_records(directory: Path) -> list[dict[str, object]] | None:
    records: list[dict[str, object]] = []
    for parent, directory_names, file_names in os.walk(directory, followlinks=False):
        parent_path = Path(parent)
        for name in directory_names:
            candidate = parent_path / name
            try:
                details = candidate.lstat()
            except OSError:
                return None
            if not stat.S_ISDIR(details.st_mode):
                return None
        for name in file_names:
            candidate = parent_path / name
            relative = candidate.relative_to(directory)
            if relative == Path(METADATA_NAME):
                continue
            try:
                details = candidate.lstat()
            except OSError:
                return None
            if not stat.S_ISREG(details.st_mode):
                return None
            try:
                digest = sha256_file(candidate)
            except ReviewError:
                return None
            records.append(
                {
                    "path": relative.as_posix(),
                    "size": details.st_size,
                    "sha256": digest,
                }
            )
    return sorted(records, key=lambda item: str(item["path"]))


def complete_page_numbers(directory: Path) -> list[int] | None:
    numbered = numeric_pngs(directory)
    numbers = [number for number, _path in numbered]
    if not numbers or numbers != list(range(1, len(numbers) + 1)):
        return None
    return numbers


def complete_sheet_numbers(directory: Path, page_count: int) -> bool:
    expected = list(range(1, math.ceil(page_count / CONTACT_BATCH_SIZE) + 1))
    actual: list[int] = []
    for path in directory.glob("sheet-*.png"):
        match = re.fullmatch(r"sheet-(\d+)\.png", path.name)
        if match:
            actual.append(int(match.group(1)))
    return sorted(actual) == expected


def cache_metadata(
    directory: Path,
    *,
    key: str,
    pdf_sha256: str,
    renderer_fingerprint: str,
    renderer: dict[str, object],
) -> dict[str, object] | None:
    metadata_path = directory / METADATA_NAME
    try:
        details = metadata_path.lstat()
        if not stat.S_ISREG(details.st_mode):
            return None
        value = json.loads(metadata_path.read_text(encoding="utf-8"))
    except (OSError, UnicodeError, json.JSONDecodeError):
        return None
    if not isinstance(value, dict):
        return None
    expected_values = {
        "schema": CACHE_SCHEMA,
        "cache_key": key,
        "pdf_sha256": pdf_sha256,
        "renderer_fingerprint": renderer_fingerprint,
        "renderer": renderer,
    }
    if any(value.get(name) != expected for name, expected in expected_values.items()):
        return None
    pages = complete_page_numbers(directory / "pages")
    thumbnails = complete_page_numbers(directory / "thumbnails")
    if pages is None or pages != thumbnails:
        return None
    if value.get("page_count") != len(pages):
        return None
    if not complete_sheet_numbers(directory / "contact-sheets", len(pages)):
        return None
    records = artifact_file_records(directory)
    if records is None or value.get("files") != records:
        return None
    return value


def chmod_nofollow(path: Path, mode: int, expected_type: int) -> None:
    """Change a known real entry without ever following a replaced symlink."""

    details = path.lstat()
    if stat.S_IFMT(details.st_mode) != expected_type:
        if stat.S_ISLNK(details.st_mode):
            return
        raise ReviewError(f"unexpected review-artifact entry type: {path}")
    os.chmod(path, mode, follow_symlinks=False)


def make_tree_readonly(directory: Path) -> None:
    for parent, directory_names, file_names in os.walk(directory, topdown=False):
        parent_path = Path(parent)
        for name in file_names:
            chmod_nofollow(parent_path / name, 0o444, stat.S_IFREG)
        for name in directory_names:
            chmod_nofollow(parent_path / name, 0o755, stat.S_IFDIR)
        # Files reject accidental in-place edits. Directories remain removable
        # so the repository's ordinary `make clean` can discard all of build/.
        # Every cache hit still verifies the recorded SHA-256 of every file.
        chmod_nofollow(parent_path, 0o755, stat.S_IFDIR)


def make_tree_writable(directory: Path) -> None:
    for parent, directory_names, file_names in os.walk(directory, topdown=False):
        parent_path = Path(parent)
        for name in file_names:
            chmod_nofollow(parent_path / name, 0o644, stat.S_IFREG)
        for name in directory_names:
            chmod_nofollow(parent_path / name, 0o755, stat.S_IFDIR)
        chmod_nofollow(parent_path, 0o755, stat.S_IFDIR)


def tree_is_readonly(directory: Path) -> bool:
    try:
        for parent, directory_names, file_names in os.walk(directory, followlinks=False):
            parent_path = Path(parent)
            for name in directory_names:
                details = (parent_path / name).lstat()
                if not stat.S_ISDIR(details.st_mode):
                    return False
            for name in file_names:
                details = (parent_path / name).lstat()
                if not stat.S_ISREG(details.st_mode):
                    return False
                if details.st_mode & 0o222:
                    return False
        return stat.S_ISDIR(directory.lstat().st_mode)
    except OSError:
        return False


def remove_artifact_tree(path: Path, parent_root: Path) -> None:
    try:
        details = path.lstat()
    except FileNotFoundError:
        return
    except OSError as exc:
        raise ReviewError(f"cannot inspect stale review artifact {path}: {exc}") from exc
    try:
        path.parent.resolve().relative_to(parent_root.resolve())
    except ValueError as exc:
        raise ReviewError(f"unsafe review artifact path: {path}") from exc
    if not stat.S_ISDIR(details.st_mode):
        raise ReviewError(f"refusing to replace non-directory review artifact: {path}")
    try:
        make_tree_writable(path)
        shutil.rmtree(path)
    except OSError as exc:
        raise ReviewError(f"cannot remove stale review artifact {path}: {exc}") from exc


def install_artifact_directory(staged: Path, destination: Path, output_root: Path) -> None:
    backup = destination.parent / (
        f".{destination.name}.old-{os.getpid()}-{uuid.uuid4().hex}"
    )
    had_destination = False
    try:
        destination.lstat()
        had_destination = True
    except FileNotFoundError:
        pass
    if had_destination:
        try:
            details = destination.lstat()
        except OSError as exc:
            raise ReviewError(f"cannot inspect review destination {destination}: {exc}") from exc
        if not stat.S_ISDIR(details.st_mode):
            raise ReviewError(
                f"refusing to replace non-directory review destination: {destination}"
            )
        os.replace(destination, backup)
    try:
        os.replace(staged, destination)
    except BaseException:
        if had_destination and backup.exists() and not destination.exists():
            os.replace(backup, destination)
        raise
    if had_destination:
        remove_artifact_tree(backup, output_root)


def materialize_cache_entry(
    entry: Path,
    destination: Path,
    output_root: Path,
    *,
    key: str,
    pdf_sha256: str,
    renderer_fingerprint: str,
    renderer: dict[str, object],
) -> Path:
    if destination.exists():
        destination_metadata = cache_metadata(
            destination,
            key=key,
            pdf_sha256=pdf_sha256,
            renderer_fingerprint=renderer_fingerprint,
            renderer=renderer,
        )
        if destination_metadata is not None and tree_is_readonly(destination):
            return destination
    destination.parent.mkdir(parents=True, exist_ok=True)
    staged = destination.parent / (
        f".{destination.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}"
    )
    try:
        shutil.copytree(entry, staged, symlinks=False)
        if cache_metadata(
            staged,
            key=key,
            pdf_sha256=pdf_sha256,
            renderer_fingerprint=renderer_fingerprint,
            renderer=renderer,
        ) is None:
            raise ReviewError(f"cached review artifact changed while copying: {entry}")
        install_artifact_directory(staged, destination, output_root)
    except BaseException:
        if staged.exists():
            shutil.rmtree(staged, ignore_errors=True)
        raise
    return destination


def write_cache_metadata(
    directory: Path,
    *,
    key: str,
    pdf_sha256: str,
    renderer_fingerprint: str,
    renderer: dict[str, object],
    page_count: int,
) -> None:
    records = artifact_file_records(directory)
    if records is None:
        raise ReviewError(f"cannot inventory review artifact: {directory}")
    value = {
        "schema": CACHE_SCHEMA,
        "cache_key": key,
        "pdf_sha256": pdf_sha256,
        "renderer_fingerprint": renderer_fingerprint,
        "renderer": renderer,
        "page_count": page_count,
        "files": records,
    }
    (directory / METADATA_NAME).write_bytes(canonical_json(value) + b"\n")


def render_pdf_artifact(
    task: PdfTask,
    temporary: Path,
    pdftoppm: str,
    magick: str,
    font: Path,
    runner: CommandRunner,
) -> int:
    if task.render_source is None:
        raise ReviewError(f"PDF has no immutable review snapshot: {task.source}")
    pages = temporary / "pages"
    thumbnails = temporary / "thumbnails"
    sheets = temporary / "contact-sheets"
    magick_tmp = temporary / "magick-tmp"
    for directory in (pages, thumbnails, sheets, magick_tmp):
        directory.mkdir(parents=True, exist_ok=True)
    runner.run(
        [
            pdftoppm,
            "-png",
            "-scale-to",
            str(FULL_PAGE_MAX_DIMENSION),
            str(task.render_source),
            str(pages / "page"),
        ]
    )
    page_files = numeric_pngs(pages)
    page_numbers = [number for number, _path in page_files]
    if not page_files or page_numbers != list(range(1, len(page_files) + 1)):
        raise ReviewError(f"incomplete page raster for {task.source}")
    environment = magick_environment(magick_tmp)
    for offset in range(0, len(page_files), THUMBNAIL_BATCH_SIZE):
        batch = page_files[offset : offset + THUMBNAIL_BATCH_SIZE]
        runner.run(
            [
                magick,
                "mogrify",
                *magick_limits(),
                "-path",
                str(thumbnails),
                "-thumbnail",
                f"{THUMBNAIL_MAX_DIMENSION}x{THUMBNAIL_MAX_DIMENSION}",
                *(str(page) for _number, page in batch),
            ],
            environment=environment,
        )
    thumbnail_files = numeric_pngs(thumbnails)
    if page_numbers != [number for number, _path in thumbnail_files]:
        raise ReviewError(f"thumbnail raster mismatch for {task.source}")
    for offset in range(0, len(thumbnail_files), CONTACT_BATCH_SIZE):
        batch = thumbnail_files[offset : offset + CONTACT_BATCH_SIZE]
        sheet = sheets / f"sheet-{offset // CONTACT_BATCH_SIZE + 1:03d}.png"
        command = [
            magick,
            "montage",
            *magick_limits(),
            "-font",
            str(font),
            "-background",
            "white",
            "-fill",
            "black",
        ]
        for page_number, thumbnail in batch:
            command.extend(["-label", f"Page {page_number}", str(thumbnail)])
        command.extend(
            [
                "-tile",
                f"{CONTACT_COLUMNS}x",
                "-geometry",
                CONTACT_GEOMETRY,
                str(sheet),
            ]
        )
        runner.run(command, environment=environment)
    shutil.rmtree(magick_tmp)
    return len(page_files)


def process_pdf(
    task: PdfTask,
    output_root: Path,
    cache_root: Path,
    pdftoppm: str,
    magick: str,
    font: Path,
    font_sha256: str,
    renderer_fingerprint: str,
    renderer: dict[str, object],
    key_lock: threading.Lock,
    runner: CommandRunner,
    termination: TerminationController,
) -> ReviewResult:
    temporary: Path | None = None
    try:
        if task.pdf_sha256 is None or task.render_source is None:
            raise ReviewError(f"PDF was not snapshotted before review: {task.source}")
        key = cache_key(task.pdf_sha256, renderer_fingerprint)
        destination = output_root / task.relative_output
        try:
            destination.resolve().relative_to(output_root.resolve())
        except ValueError as exc:
            raise ReviewError(f"unsafe review destination: {destination}") from exc
        entry = cache_root / "objects" / key[:2] / key
        with key_lock:
            entry_metadata = cache_metadata(
                entry,
                key=key,
                pdf_sha256=task.pdf_sha256,
                renderer_fingerprint=renderer_fingerprint,
                renderer=renderer,
            )
            if entry_metadata is not None and not tree_is_readonly(entry):
                entry_metadata = None
            if entry_metadata is None:
                if entry.exists():
                    remove_artifact_tree(entry, cache_root)
                entry.parent.mkdir(parents=True, exist_ok=True)
                temporary = entry.parent / (
                    f".{entry.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}"
                )
                temporary.mkdir()
                page_count = render_pdf_artifact(
                    task, temporary, pdftoppm, magick, font, runner
                )
                if sha256_file(font) != font_sha256:
                    raise ReviewError(
                        f"review contact-sheet font changed during rendering: {font}"
                    )
                write_cache_metadata(
                    temporary,
                    key=key,
                    pdf_sha256=task.pdf_sha256,
                    renderer_fingerprint=renderer_fingerprint,
                    renderer=renderer,
                    page_count=page_count,
                )
                entry_metadata = cache_metadata(
                    temporary,
                    key=key,
                    pdf_sha256=task.pdf_sha256,
                    renderer_fingerprint=renderer_fingerprint,
                    renderer=renderer,
                )
                if entry_metadata is None:
                    raise ReviewError(f"new review cache entry failed validation: {task.source}")
                make_tree_readonly(temporary)
                os.replace(temporary, entry)
                temporary = None
        materialize_cache_entry(
            entry,
            destination,
            output_root,
            key=key,
            pdf_sha256=task.pdf_sha256,
            renderer_fingerprint=renderer_fingerprint,
            renderer=renderer,
        )
        page_count = entry_metadata.get("page_count")
        if not isinstance(page_count, int) or page_count < 1:
            raise ReviewError(f"review cache has an invalid page count: {entry}")
        return ReviewResult(
            task=task,
            pdf_sha256=task.pdf_sha256,
            page_count=page_count,
        )
    except BaseException:
        termination.arm_cleanup()
        if temporary is not None:
            with contextlib.suppress(OSError):
                make_tree_writable(temporary)
            shutil.rmtree(temporary, ignore_errors=True)
        raise


def prepare_tasks(values: list[str]) -> list[PdfTask]:
    tasks: list[PdfTask] = []
    outputs: set[Path] = set()
    for value in values:
        task = task_for_pdf(value)
        if task.relative_output in outputs:
            raise ReviewError(f"duplicate review output for {value}")
        outputs.add(task.relative_output)
        tasks.append(task)
    return tasks


def hash_tasks(tasks: list[PdfTask]) -> list[PdfTask]:
    return [
        task
        if task.pdf_sha256 is not None
        else dataclasses.replace(task, pdf_sha256=sha256_file(task.source))
        for task in tasks
    ]


def changed_mirror_path(source: Path, against: Path) -> Path:
    build_root = (ROOT / "build").resolve()
    doc_root = (ROOT / "doc").resolve()
    try:
        source_relative = source.relative_to(build_root)
        against_relative = against.relative_to(doc_root)
    except ValueError:
        source_relative = None
        against_relative = None
    if source_relative is not None and against_relative is not None:
        prefix = against_relative.parts
        if source_relative.parts[: len(prefix)] != prefix:
            raise ReviewError(
                f"cannot map {source} into comparison root {against}; "
                "the build/doc mirror prefixes differ"
            )
        return against.joinpath(*source_relative.parts[len(prefix) :])
    if against.name:
        for ancestor in (source.parent, *source.parents):
            if ancestor.name == against.name:
                return against / source.relative_to(ancestor)
    return against / source.name


def select_changed_against(
    tasks: list[PdfTask], against: Path
) -> tuple[list[PdfTask], list[tuple[PdfTask, Path]]]:
    if not against.is_dir():
        raise ReviewError(f"--changed-against is not a readable directory: {against}")
    selected: list[PdfTask] = []
    unchanged: list[tuple[PdfTask, Path]] = []
    for task in hash_tasks(tasks):
        mirror = changed_mirror_path(task.source, against)
        if (
            mirror.is_file()
            and mirror.suffix.lower() == ".pdf"
            and task.pdf_sha256 == sha256_file(mirror)
        ):
            unchanged.append((task, mirror))
        else:
            selected.append(task)
    return selected, unchanged


def resolved_git_commit(value: str) -> str:
    result = subprocess.run(
        ["git", "rev-parse", "--verify", "--end-of-options", f"{value}^{{commit}}"],
        cwd=ROOT,
        check=False,
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    resolved = result.stdout.strip()
    if result.returncode or not re.fullmatch(r"[0-9a-fA-F]{40,64}", resolved):
        detail = result.stderr.strip()
        suffix = f": {detail}" if detail else ""
        raise ReviewError(f"cannot resolve Git revision {value!r}{suffix}")
    return resolved


def nul_paths(output: bytes) -> list[Path]:
    result: list[Path] = []
    for value in output.split(b"\0"):
        if not value:
            continue
        path = Path(os.fsdecode(value))
        if path.is_absolute() or ".." in path.parts:
            raise ReviewError("Git returned an unsafe changed path")
        result.append(path)
    return result


def git_changed_pdf_paths(base: str, target: str | None) -> set[Path]:
    base_commit = resolved_git_commit(base)
    command = ["git", "diff", "--name-only", "-z", "--diff-filter=ACMRT", base_commit]
    if target is not None:
        command.append(resolved_git_commit(target))
    command.extend(["--", "doc"])
    result = subprocess.run(
        command,
        cwd=ROOT,
        check=False,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )
    if result.returncode:
        detail = result.stderr.decode("utf-8", errors="replace").strip()
        suffix = f": {detail}" if detail else ""
        raise ReviewError(f"cannot inspect changed PDFs{suffix}")
    changed = set(nul_paths(result.stdout))
    if target is None:
        untracked = subprocess.run(
            ["git", "ls-files", "--others", "--exclude-standard", "-z", "--", "doc"],
            cwd=ROOT,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        if untracked.returncode:
            detail = untracked.stderr.decode("utf-8", errors="replace").strip()
            suffix = f": {detail}" if detail else ""
            raise ReviewError(f"cannot inspect untracked PDFs{suffix}")
        changed.update(nul_paths(untracked.stdout))
    return {path for path in changed if path.suffix.lower() == ".pdf"}


def task_git_candidates(task: PdfTask) -> set[Path]:
    try:
        relative = task.source.relative_to(ROOT)
    except ValueError:
        return set()
    candidates = {relative}
    if relative.parts[:1] == ("build",):
        candidates.add(Path("doc", *relative.parts[1:]))
    return candidates


def select_git_changed(
    tasks: list[PdfTask], base: str, target: str | None
) -> list[PdfTask]:
    changed = git_changed_pdf_paths(base, target)
    if not tasks:
        return prepare_tasks(
            [str(ROOT / path) for path in sorted(changed) if (ROOT / path).is_file()]
        )
    return [task for task in tasks if task_git_candidates(task) & changed]


def manifest_source(path: Path) -> str:
    try:
        return path.relative_to(ROOT).as_posix()
    except ValueError:
        return str(path)


def write_run_manifest(
    directory: Path,
    results: list[ReviewResult],
    renderer_fingerprint: str | None,
    renderer: dict[str, object] | None,
) -> None:
    value = {
        "schema": RUN_MANIFEST_SCHEMA,
        "renderer_fingerprint": renderer_fingerprint,
        "renderer": renderer,
        "pdfs": [
            {
                "source": manifest_source(result.task.source),
                "output": result.task.relative_output.as_posix(),
                "pdf_sha256": result.pdf_sha256,
                "page_count": result.page_count,
            }
            for result in results
        ],
    }
    (directory / RUN_MANIFEST_NAME).write_bytes(canonical_json(value) + b"\n")


@contextlib.contextmanager
def snapshotted_pdf_tasks(
    tasks: list[PdfTask], parent: Path, output_name: str
) -> Iterator[list[PdfTask]]:
    parent.mkdir(parents=True, exist_ok=True)
    snapshot_root = parent / (
        f".{safe_component(output_name)}.snapshots-{os.getpid()}-{uuid.uuid4().hex}"
    )
    try:
        yield [snapshot_pdf(task, snapshot_root) for task in tasks]
    finally:
        remove_artifact_tree(snapshot_root, parent)


def run_review(
    tasks: list[PdfTask],
    output: Path,
    cache: Path,
    plan: ResourcePlan | None,
    termination: TerminationController,
) -> list[Path]:
    output.parent.mkdir(parents=True, exist_ok=True)
    staged_output = output.parent / (
        f".{output.name}.tmp-{os.getpid()}-{uuid.uuid4().hex}"
    )
    staged_output.mkdir()
    snapshot_root = output.parent / (
        f".{output.name}.snapshots-{os.getpid()}-{uuid.uuid4().hex}"
    )
    runner = CommandRunner()
    results: dict[Path, ReviewResult] = {}
    executor: concurrent.futures.ThreadPoolExecutor | None = None
    futures: dict[concurrent.futures.Future[ReviewResult], PdfTask] = {}

    def abort_review() -> None:
        termination.arm_cleanup()
        for future in futures:
            future.cancel()
        runner.terminate_all()
        if executor is not None:
            executor.shutdown(wait=True, cancel_futures=True)
        remove_artifact_tree(snapshot_root, output.parent)
        remove_artifact_tree(staged_output, output.parent)
        termination.clear_cleanup(abort_review)

    termination.register_cleanup(abort_review)
    try:
        renderer_fingerprint: str | None = None
        renderer: dict[str, object] | None = None
        if tasks:
            if plan is None:
                raise ReviewError("review resource plan is missing")
            pdftoppm = executable_from_environment(
                "TRIPTYCH_PDF_REVIEW_PDFTOPPM", "pdftoppm"
            )
            magick = executable_from_environment(
                "TRIPTYCH_PDF_REVIEW_MAGICK", "magick"
            )
            font = contact_font(runner)
            font_sha256 = sha256_file(font)
            cache.mkdir(parents=True, exist_ok=True)
            tasks = [
                task
                if task.pdf_sha256 is not None and task.render_source is not None
                else snapshot_pdf(task, snapshot_root)
                for task in tasks
            ]
            renderer_fingerprint, renderer = renderer_record(
                pdftoppm, magick, font, font_sha256, runner
            )
            key_locks: dict[str, threading.Lock] = {}
            for task in tasks:
                assert task.pdf_sha256 is not None
                key_locks.setdefault(
                    cache_key(task.pdf_sha256, renderer_fingerprint), threading.Lock()
                )
            executor = concurrent.futures.ThreadPoolExecutor(
                max_workers=min(plan.jobs, len(tasks))
            )
            for task in tasks:
                assert task.pdf_sha256 is not None
                key = cache_key(task.pdf_sha256, renderer_fingerprint)
                future = executor.submit(
                    process_pdf,
                    task,
                    staged_output,
                    cache,
                    pdftoppm,
                    magick,
                    font,
                    font_sha256,
                    renderer_fingerprint,
                    renderer,
                    key_locks[key],
                    runner,
                    termination,
                )
                futures[future] = task
            for future in concurrent.futures.as_completed(futures):
                task = futures[future]
                results[task.source] = future.result()
            executor.shutdown(wait=True)
            executor = None
            remove_artifact_tree(snapshot_root, output.parent)
        ordered_results = [results[task.source] for task in tasks]
        write_run_manifest(
            staged_output,
            ordered_results,
            renderer_fingerprint,
            renderer,
        )
        install_artifact_directory(staged_output, output, output.parent)
    except BaseException:
        abort_review()
        raise
    else:
        termination.clear_cleanup(abort_review)
    return [output / task.relative_output for task in tasks]


def parse_arguments(argv: list[str]) -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Prepare bounded page rasters and contact sheets for visual PDF review.",
        formatter_class=argparse.ArgumentDefaultsHelpFormatter,
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=DEFAULT_OUTPUT,
        help="inspection artifact root",
    )
    parser.add_argument(
        "--cache",
        type=Path,
        default=default_cache_root(),
        help="persistent content-addressed raster cache",
    )
    parser.add_argument(
        "--jobs",
        type=positive_integer,
        help="cap the automatic memory- and CPU-bounded worker count",
    )
    parser.add_argument(
        "--explain",
        action="store_true",
        help="print the current resource plan without rendering PDFs",
    )
    parser.add_argument(
        "--changed-from",
        metavar="REVISION",
        help="select tracked PDFs changed since this Git revision",
    )
    parser.add_argument(
        "--changed-to",
        metavar="REVISION",
        help="compare --changed-from with this revision instead of the worktree",
    )
    parser.add_argument(
        "--changed-against",
        type=Path,
        metavar="DIRECTORY",
        help=(
            "select only input PDFs whose exact bytes differ from their mirrored "
            "files below DIRECTORY (for example, build/gpt PDFs against doc/gpt)"
        ),
    )
    parser.add_argument("pdf", nargs="*", help="PDFs to rasterize")
    arguments = parser.parse_args(argv)
    if arguments.changed_to and not arguments.changed_from:
        parser.error("--changed-to requires --changed-from")
    if not arguments.explain and not arguments.pdf and not arguments.changed_from:
        parser.error("at least one PDF or --changed-from is required")
    return arguments


def limited_child(argv: list[str]) -> int:
    if len(argv) < 3 or argv[1] != "--":
        print("pdf-review: invalid internal child invocation", file=sys.stderr)
        return 2
    try:
        requested_limit = int(argv[0], 10)
        if requested_limit < 1:
            raise ValueError
        inherited_soft, inherited_hard = resource.getrlimit(resource.RLIMIT_AS)
        finite_limits = [requested_limit]
        finite_limits.extend(
            limit
            for limit in (inherited_soft, inherited_hard)
            if limit != resource.RLIM_INFINITY
        )
        address_limit = min(finite_limits)
        resource.setrlimit(resource.RLIMIT_AS, (address_limit, address_limit))
        os.execvpe(argv[2], argv[2:], os.environ)
    except (OSError, ValueError) as exc:
        print(f"pdf-review: cannot start bounded child: {exc}", file=sys.stderr)
        return 126
    return 0


def main(argv: list[str] | None = None) -> int:
    previous_handlers: dict[signal.Signals, object] = {}
    termination = TerminationController()
    for handled_signal in (signal.SIGHUP, signal.SIGINT, signal.SIGTERM):
        previous_handlers[handled_signal] = signal.signal(handled_signal, termination)
    try:
        arguments = parse_arguments(sys.argv[1:] if argv is None else argv)
        if arguments.explain:
            print(describe_plan(current_plan(arguments.jobs)))
            return 0
        tasks = prepare_tasks(arguments.pdf)
        if arguments.changed_from:
            tasks = select_git_changed(tasks, arguments.changed_from, arguments.changed_to)
        against: Path | None = None
        if arguments.changed_against:
            against = (
                (ROOT / arguments.changed_against).resolve()
                if not arguments.changed_against.is_absolute()
                else arguments.changed_against.resolve()
            )
        output = validate_output_root(arguments.output)
        cache = validate_cache_root(arguments.cache)
        if is_relative_to(output, cache) or is_relative_to(cache, output):
            raise ReviewError("--output and --cache must not contain one another")
        with exclusive_review_lock():
            task_context = (
                snapshotted_pdf_tasks(tasks, output.parent, output.name)
                if against is not None
                else contextlib.nullcontext(tasks)
            )
            with task_context as candidates:
                if against is not None:
                    tasks, unchanged = select_changed_against(candidates, against)
                    if unchanged:
                        print(
                            "pdf-review: skipped "
                            f"{len(unchanged)} byte-identical PDF(s) already "
                            f"mirrored under {against}",
                            file=sys.stderr,
                        )
                else:
                    tasks = candidates
                plan: ResourcePlan | None = None
                if tasks:
                    plan = current_plan(arguments.jobs)
                    plan = dataclasses.replace(plan, jobs=min(plan.jobs, len(tasks)))
                    print(describe_plan(plan), file=sys.stderr)
                results = run_review(tasks, output, cache, plan, termination)
        if not tasks:
            print("pdf-review: no changed PDFs selected", file=sys.stderr)
            return 0
        for task, destination in zip(tasks, results, strict=True):
            print(f"{task.source} -> {destination}")
        return 0
    except ReviewSignal as exc:
        name = signal.Signals(exc.signum).name
        print(f"pdf-review: terminated by {name}", file=sys.stderr)
        return 128 + exc.signum
    except KeyboardInterrupt:
        print("pdf-review: interrupted", file=sys.stderr)
        return 130
    except (ReviewError, OSError) as exc:
        print(f"pdf-review: {exc}", file=sys.stderr)
        return 1
    finally:
        try:
            termination.ensure_cleanup()
        finally:
            for handled_signal, previous_handler in previous_handlers.items():
                signal.signal(handled_signal, previous_handler)


if __name__ == "__main__":
    if sys.argv[1:2] == ["--_limit-child"]:
        raise SystemExit(limited_child(sys.argv[2:]))
    raise SystemExit(main())
