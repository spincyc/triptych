#!/usr/bin/env python3
"""Validate canonical dictionary fixtures and render deterministic TeX views.

This is production plumbing, not a completeness claim.  Only records that pass
the publication gate in the schema are emitted.
"""

from __future__ import annotations

import argparse
import hashlib
import importlib.util
import re
import sys
import tomllib
from pathlib import Path

OBJECT_KEYS = {
    "schema_version", "id", "workflow_state", "preferred_english_name",
    "latin_headword", "alternate_english_names", "alternate_latin_names",
    "sort_name", "categories", "periods", "statuses", "ceremonies",
    "parent_object", "component_objects", "confusable_with", "related_objects",
    "presence", "handling", "claims", "sources", "artwork", "variants",
    "audience_relevance", "audience_note", "pronunciation_key", "editorial_note",
    "presentation_mode",
}
NESTED_KEYS = {
    "presence": {"locations", "contexts", "composition_ids", "local_variability"},
    "handling": {"ordinary_handlers", "server_relation", "prepares", "presents", "receives", "stores", "warnings"},
    "audience_relevance": {"altar_server", "sacristan", "mc_trainer", "general_reader", "pontifical"},
    "claims": {"id", "kind", "text", "evidence_state", "source_ids", "applies_to_variants",
               "jurisdiction", "as_of", "rights_note", "publication_note"},
    "sources": {"id", "binding", "locus", "role", "verification_state", "checked_on", "note"},
    "artwork": {"id", "view", "asset", "review_state", "depicts", "variant_id",
                "scale_mode", "context_object_ids", "review_note", "render_owner"},
    "variants": {"id", "preferred_name", "distinguishing_features", "status", "source_ids",
                 "artwork_ids", "latin_name", "periods", "regions", "communities",
                 "ceremonies", "dimensions", "note"},
    "audience_note": {"audience", "text", "claim_ids"},
}
ID = re.compile(r"^(obj|var|clm|src|art|plt|ed)-[a-z0-9]+(?:-[a-z0-9]+)*$")
TEX_NATIVE_ARTWORK_IDS = {
    "obj-epistle-book",
    "obj-gospel-book",
}
TEX_ESCAPE = str.maketrans({
    "\\": r"\textbackslash{}", "{": r"\{", "}": r"\}", "#": r"\#",
    "$": r"\$", "%": r"\%", "&": r"\&", "_": r"\_", "^": r"\^{}",
    "~": r"\~{}",
})

REPOSITORY_ROOT = Path(__file__).resolve().parent.parent
DICTIONARY_PREFIX = (
    "src/gpt/liturgy/roman-rite/1962/reference/roman-sanctuary-dictionary/"
)
VALIDATOR_PATH = (
    REPOSITORY_ROOT
    / "src/gpt/liturgy/roman-rite/1962/reference/roman-sanctuary-dictionary"
    / "shared/schema/validate_inventory.py"
)


def load_canonical_validator():
    spec = importlib.util.spec_from_file_location("rsd_validate_inventory", VALIDATOR_PATH)
    if spec is None or spec.loader is None:
        raise ContractError(f"cannot load canonical validator: {VALIDATOR_PATH}")
    module = importlib.util.module_from_spec(spec)
    sys.modules[spec.name] = module
    spec.loader.exec_module(module)
    return module


class ContractError(ValueError):
    pass


def load(path: Path) -> dict:
    with path.open("rb") as stream:
        return tomllib.load(stream)


def tex(value: object) -> str:
    if value is None:
        return ""
    if isinstance(value, list):
        value = ", ".join(str(item) for item in value)
    return str(value).translate(TEX_ESCAPE)


def canonical_asset_path(value: str) -> str:
    """Return the manifest/TeX path relative to the dictionary root."""
    return value[len(DICTIONARY_PREFIX):] if value.startswith(DICTIONARY_PREFIX) else value


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ContractError(message)


def validate_record(record: dict, filename: Path, schema: dict) -> None:
    unknown = set(record) - OBJECT_KEYS
    require(not unknown, f"{filename}: unknown fields: {', '.join(sorted(unknown))}")
    for table, allowed in NESTED_KEYS.items():
        values = record.get(table, [])
        if isinstance(values, dict):
            values = [values]
        for value in values:
            nested_unknown = set(value) - allowed
            require(not nested_unknown,
                    f"{filename}: unknown {table} fields: {', '.join(sorted(nested_unknown))}")
    for key in schema["record"]["required"]:
        require(key in record, f"{filename}: missing required field {key}")
    require(record["schema_version"] == 1, f"{filename}: unsupported schema version")
    require(bool(ID.fullmatch(record["id"])) and record["id"].startswith("obj-"),
            f"{filename}: invalid object id")
    sources = {item["id"] for item in record.get("sources", [])}
    art = {item["id"] for item in record.get("artwork", [])}
    require(len(sources) == len(record.get("sources", [])), f"{filename}: duplicate source id")
    require(len(art) == len(record.get("artwork", [])), f"{filename}: duplicate artwork id")
    for claim in record["claims"]:
        require(all(source in sources for source in claim.get("source_ids", [])),
                f"{filename}: claim {claim['id']} references an unknown source")
    for variant in record.get("variants", []):
        require(all(source in sources for source in variant["source_ids"]),
                f"{filename}: variant {variant['id']} references an unknown source")
        require(all(item in art for item in variant["artwork_ids"]),
                f"{filename}: variant {variant['id']} references unknown artwork")


def publication_ready(record: dict, schema: dict, manifest_assets: set[str]) -> bool:
    gate = schema["publication_gate"]
    if record["workflow_state"] not in gate["selectable_workflow_states"]:
        return False
    claim_states = set(gate["allowed_claim_states"])
    claims = record["claims"]
    if any(claim["evidence_state"] not in claim_states for claim in claims):
        return False
    kinds = {claim["kind"] for claim in claims}
    if not set(gate["required_claim_kinds"]).issubset(kinds):
        return False
    if any(item["review_state"] not in gate["allowed_artwork_states"]
           or item["asset"] not in manifest_assets for item in record["artwork"]):
        return False
    return True


def selected(record: dict, edition: dict) -> bool:
    if record["id"] in edition.get("explicit_exclusions", []):
        return False
    if set(record["statuses"]) & set(edition.get("exclude_statuses", [])):
        return False
    if record["workflow_state"] not in edition["include_workflow_states"]:
        return False
    if edition["kind"] == "comprehensive":
        return bool(set(record["statuses"]) & set(edition.get("include_statuses", []))) \
            and bool(set(record["periods"]) & set(edition.get("include_periods", [])))
    field = edition["relevance_field"].split(".")[-1]
    by_relevance = record["audience_relevance"][field] in edition["include_relevance"]
    by_category = bool(set(record["categories"]) & set(edition.get("include_categories", [])))
    return by_relevance or by_category


def alpha_gate_failure(record: dict, alpha_assets: set[str]) -> str | None:
    """Return the first defect that bars the canonical alpha rendering."""
    if record["workflow_state"] not in {
        "source-audited", "art-reviewed", "publication-ready"
    }:
        return f"workflow state {record['workflow_state']}; identity/source audit incomplete"
    if "unresolved" in record["statuses"]:
        return "object identity or governing status remains unresolved"
    if any(
        claim["evidence_state"] == "unverified-lead"
        for claim in record["claims"]
    ):
        return "a printed claim remains an unverified lead"
    sources = {source["id"]: source for source in record["sources"]}
    if any(
        source_id not in sources
        or sources[source_id]["verification_state"] != "claim-verified"
        for claim in record["claims"]
        if claim["evidence_state"] != "editorial-proposal"
        for source_id in claim["source_ids"]
    ):
        return "a printed factual claim lacks a claim-verified source binding"
    if (
        not record["artwork"]
        and record["id"] not in TEX_NATIVE_ARTWORK_IDS
        and record.get("presentation_mode") != "text-only"
    ):
        return "no artwork is registered"
    if any(
        canonical_asset_path(artwork["asset"]) not in alpha_assets
        for artwork in record["artwork"]
    ):
        return "artwork lacks recorded rights, provenance, and asset identity"
    if any(
        artwork["review_state"] not in {
            "identity-checked", "liturgically-checked", "print-checked", "approved"
        }
        for artwork in record["artwork"]
    ):
        return "artwork has not passed basic identity and visual review"
    return None


def alpha_selected(record: dict, edition: dict, alpha_assets: set[str]) -> bool:
    """Select the canonical source-bounded alpha view for one edition."""
    if alpha_gate_failure(record, alpha_assets) is not None:
        return False
    if record["id"] in edition.get("explicit_exclusions", []):
        return False
    if edition["kind"] == "comprehensive":
        return True
    field = edition["relevance_field"].split(".")[-1]
    by_relevance = record["audience_relevance"][field] in edition["include_relevance"]
    by_category = bool(set(record["categories"]) & set(edition.get("include_categories", [])))
    return by_relevance or by_category


def alpha_omission_reason(
    record: dict, edition: dict, alpha_assets: set[str]
) -> str:
    gate_failure = alpha_gate_failure(record, alpha_assets)
    if gate_failure is not None:
        return gate_failure
    if record["id"] in edition.get("explicit_exclusions", []):
        return "explicitly excluded by the edition selection"
    if edition["kind"] != "comprehensive":
        return "not selected for this use-derived audience"
    return "not admitted by the canonical alpha selection"


def record_tex(record: dict, edition: dict, artwork_render_owners: dict[str, str]) -> str:
    lines = [
        f"\\RSDObjectRecord{{{tex(record['id'])}}}"
        f"{{{tex(record['preferred_english_name'])}}}{{{tex(record['latin_headword'])}}}",
        f"\\RSDObjectAliases{{{tex(record.get('alternate_english_names', []))}}}"
        f"{{{tex(record.get('alternate_latin_names', []))}}}",
        f"\\RSDObjectClassification{{{tex(record['categories'])}}}{{{tex(record['periods'])}}}"
        f"{{{tex(record['statuses'])}}}{{{tex(record['ceremonies'])}}}",
        f"\\RSDObjectPresence{{{tex(record['presence']['locations'])}}}"
        f"{{{tex(record['presence']['contexts'])}}}",
        f"\\RSDObjectHandling{{{tex(record['handling']['ordinary_handlers'])}}}"
        f"{{{tex(record['handling']['server_relation'])}}}",
        f"\\RSDObjectRelations{{{tex(record.get('confusable_with', []))}}}"
        f"{{{tex(record.get('related_objects', []))}}}",
    ]
    if record.get("pronunciation_key"):
        lines.append(f"\\RSDObjectPronunciationKey{{{tex(record['pronunciation_key'])}}}")
    for claim in record["claims"]:
        if claim["evidence_state"] == "editorial-proposal":
            continue
        lines.append("\\RSDClaim"
                     f"{{{tex(claim['id'])}}}{{{tex(claim['kind'])}}}{{{tex(claim['text'])}}}"
                     f"{{{tex(claim['evidence_state'])}}}{{{tex(claim['source_ids'])}}}"
                     f"{{{tex(claim.get('applies_to_variants', []))}}}")
    for variant in record.get("variants", []):
        lines.append("\\RSDVariant"
                     f"{{{tex(variant['id'])}}}{{{tex(variant['preferred_name'])}}}"
                     f"{{{tex(variant.get('latin_name', ''))}}}"
                     f"{{{tex(variant['distinguishing_features'])}}}{{{tex(variant['status'])}}}"
                     f"{{{tex(variant['source_ids'])}}}{{{tex(variant['artwork_ids'])}}}")
    for source in record.get("sources", []):
        lines.append("\\RSDSourceBinding"
                     f"{{{tex(source['id'])}}}{{{tex(source['binding'])}}}{{{tex(source['locus'])}}}"
                     f"{{{tex(source['role'])}}}{{{tex(source['verification_state'])}}}"
                     f"{{{tex(source.get('checked_on', ''))}}}")
    for artwork in record["artwork"]:
        render_owner = artwork_render_owners[artwork["id"]]
        lines.append("\\RSDArtwork"
                     f"{{{tex(artwork['id'])}}}{{{tex(artwork['view'])}}}"
                     f"{{{tex(canonical_asset_path(artwork['asset']))}}}"
                     f"{{{tex(artwork['review_state'])}}}{{{tex(artwork['depicts'])}}}"
                     f"{{{tex(artwork.get('variant_id', ''))}}}"
                     f"{{{tex(artwork.get('scale_mode', 'not-applicable'))}}}"
                     f"{{{tex(render_owner)}}}")
    for note in record.get("audience_note", []):
        lines.append("\\RSDAudienceNote"
                     f"{{{tex(note['audience'])}}}{{{tex(note['text'])}}}"
                     f"{{{tex(note['claim_ids'])}}}{{{tex(record['id'])}}}")
        if note["audience"] == edition["audience"]:
            lines.append(f"\\RSDSelectedAudienceNote{{{tex(note['text'])}}}")
    lines.append("\\RSDEndObjectRecord")
    return "\n".join(lines)


def primary_category(record: dict) -> str:
    """Choose one stable display category without changing canonical identity."""
    precedence = (
        "church-and-sanctuary", "altar-and-appointments", "sacred-vessels",
        "linens-and-textiles", "books-and-printed-objects", "service-objects",
        "incense", "priestly-vestments", "deacon-and-subdeacon",
        "pontifical-and-prelatial", "servers-ministers-and-choir", "requiem",
        "nuptial-and-ritual", "holy-week", "pontifical-mass-compositions",
        "related-ceremonies", "historical",
    )
    categories = set(record["categories"])
    return next((category for category in precedence if category in categories),
                record["categories"][0])


def section_for(record: dict, edition: dict) -> str:
    """Route an admitted record through the edition's declared reader order."""
    category = primary_category(record)
    edition_id = edition["id"]
    if edition_id == "ed-comprehensive":
        return category
    if edition_id == "ed-altar-server":
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial",
                        "servers-ministers-and-choir"}:
            return "vestments-ministers-and-insignia"
        if category in {"related-ceremonies", "requiem", "nuptial-and-ritual",
                        "holy-week", "pontifical-mass-compositions"}:
            return "special-masses-and-related-ceremonies"
        if category in {"church-and-sanctuary", "altar-and-appointments"}:
            return "sanctuary-orientation"
        return "objects-around-the-server"
    if edition_id == "ed-sacristan":
        if category in {"church-and-sanctuary", "altar-and-appointments",
                        "service-objects"}:
            return "sanctuary-and-altar-preparation"
        if category in {"sacred-vessels", "linens-and-textiles",
                        "books-and-printed-objects", "incense"}:
            return "vessels-linens-and-books"
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial"}:
            return "vestments-and-insignia"
        return "special-ceremony-equipment"
    if edition_id == "ed-mc-trainer":
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial", "servers-ministers-and-choir",
                        "church-and-sanctuary"}:
            return "people-roles-and-stations"
        if category in {"related-ceremonies", "requiem", "nuptial-and-ritual",
                        "holy-week", "pontifical-mass-compositions"}:
            return "branches-and-special-ceremonies"
        if record.get("confusable_with"):
            return "training-comparisons"
        return "objects-and-handoffs"
    if edition_id == "ed-general-reader":
        if category in {"church-and-sanctuary", "altar-and-appointments"}:
            return "sanctuary"
        if category in {"priestly-vestments", "deacon-and-subdeacon",
                        "pontifical-and-prelatial"}:
            return "vestments-and-insignia"
        if category == "historical":
            return "historical-perspective"
        return "objects-and-linens"
    if edition_id == "ed-pontifical":
        if category in {"priestly-vestments", "deacon-and-subdeacon"}:
            return "pontifical-vesture"
        if category == "pontifical-and-prelatial":
            return "insignia"
        if category in {"church-and-sanctuary", "altar-and-appointments",
                        "books-and-printed-objects"}:
            return "furnishings-and-books"
        return "ministers-and-object-transfers"
    raise ContractError(f"{edition_id}: no dense-layout section router")


def section_label(section: str) -> str:
    return section.replace("-", " ").title()


def dense_edition_tex(
    chosen: list[dict], edition: dict, artwork_render_owners: dict[str, str]
) -> list[str]:
    """Render section-ordered comparison plates in the edition's layout mode.

    Records remain canonical and audience notes remain edition-selected; this
    function changes only their comparison grouping and page architecture.
    """
    layout_mode = edition.get("layout_mode", "dense-six-v1")
    require(layout_mode in {"dense-six-v1", "story-spread-v1"},
            f"{edition['id']}: unsupported layout_mode: {layout_mode}")
    section_order = [
        section for section in edition["section_order"]
        if section not in {
            "recognition-and-handling-key", "status-and-handling-key",
            "relational-symbol-key", "visual-and-status-key",
            "status-and-relationship-key", "terminal-apparatus",
        }
    ]
    grouped = {section: [] for section in section_order}
    for record in chosen:
        section = section_for(record, edition)
        require(section in grouped,
                f"{edition['id']}: record {record['id']} routed outside section_order: {section}")
        grouped[section].append(record)
    category_rank = {
        name: index for index, name in enumerate((
            "church-and-sanctuary", "altar-and-appointments", "sacred-vessels",
            "linens-and-textiles", "books-and-printed-objects", "service-objects",
            "incense", "priestly-vestments", "deacon-and-subdeacon",
            "pontifical-and-prelatial", "servers-ministers-and-choir", "requiem",
            "nuptial-and-ritual", "holy-week", "pontifical-mass-compositions",
            "related-ceremonies", "historical",
        ))
    }
    lines: list[str] = []
    for section in section_order:
        records = grouped[section]
        records.sort(key=lambda record: (
            category_rank.get(primary_category(record), 999),
            record.get("sort_name", record["preferred_english_name"]).casefold(),
            record["id"],
        ))
        plate_size = 5 if layout_mode == "story-spread-v1" else 6
        for offset in range(0, len(records), plate_size):
            plate = records[offset:offset + plate_size]
            if layout_mode == "story-spread-v1":
                lines.append(
                    f"\\RSDStoryPlateStart{{{tex(section_label(section))}}}"
                    f"{{{offset // plate_size + 1}}}"
                )
                for index, record in enumerate(plate):
                    if index == 0:
                        lines.append("\\RSDStoryHeroNext")
                    elif index == 1:
                        lines.append("\\RSDStoryCompanionsStart")
                    else:
                        lines.append("\\RSDStoryCompanionBreak")
                    lines.append(record_tex(record, edition, artwork_render_owners))
                if len(plate) > 1:
                    lines.append("\\RSDStoryCompanionsEnd")
                lines.append("\\RSDStoryPlateEnd")
                continue
            lines.append(
                f"\\RSDDensePlateStart{{{tex(section_label(section))}}}"
                f"{{{offset // plate_size + 1}}}"
            )
            for index, record in enumerate(plate):
                if index == 3:
                    lines.append("\\RSDDensePlateRowBreak")
                elif index in {1, 2, 4, 5}:
                    lines.append("\\RSDDensePlateCellBreak")
                lines.append(record_tex(record, edition, artwork_render_owners))
            lines.append("\\RSDDensePlateEnd")
    return lines


def resolve_artwork_render_owners(records: dict[str, dict]) -> dict[str, str]:
    """Assign each shared asset to one canonical linking object.

    An explicit render_owner wins. Otherwise the first depicted object that
    actually links the artwork owns its generated rendering. This makes the
    declared depicts order a deterministic default without suppressing an
    artwork whose contextual depicted objects do not link it.
    """
    links: dict[str, set[str]] = {}
    definitions: dict[str, dict] = {}
    for object_id, record in records.items():
        for artwork in record["artwork"]:
            links.setdefault(artwork["id"], set()).add(object_id)
            definitions.setdefault(artwork["id"], artwork)
    owners: dict[str, str] = {}
    for artwork_id, artwork in definitions.items():
        linked = links[artwork_id]
        explicit = artwork.get("render_owner")
        if explicit is not None:
            require(
                explicit in linked,
                f"{artwork_id}: render_owner {explicit} must link the shared artwork",
            )
            owners[artwork_id] = explicit
            continue
        owners[artwork_id] = next(
            (object_id for object_id in artwork["depicts"] if object_id in linked),
            sorted(linked)[0],
        )
    return owners


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--schema", type=Path, required=True)
    parser.add_argument("--selections", type=Path, required=True)
    parser.add_argument("--artwork-manifest", type=Path, required=True)
    parser.add_argument("--records", type=Path, required=True)
    parser.add_argument("--output", type=Path, required=True)
    args = parser.parse_args()
    try:
        schema, selections, manifest = load(args.schema), load(args.selections), load(args.artwork_manifest)
        # Production manifests use ``asset_files``; the small schema fixture
        # retains ``asset``.  Both carry the same dictionary-relative path.
        manifest_assets = {
            canonical_asset_path(item["path"])
            for table in ("asset_files", "asset")
            for item in manifest.get(table, [])
        }
        alpha_assets = {
            canonical_asset_path(item["path"])
            for table in ("asset_files", "asset")
            for item in manifest.get(table, [])
            if item.get("state") in {
                "accepted-for-priestly-review", "canonical-alpha-eligible"
            }
        }
        canonical = load_canonical_validator()
        validator = canonical.Validator(schema, selections)
        record_paths = canonical.discover([args.records])
        require(bool(record_paths), f"{args.records}: no object TOML files found")
        validator.validate(record_paths)
        if validator.problems:
            detail = "\n".join(
                str(problem)
                for problem in sorted(
                    validator.problems,
                    key=lambda problem: (str(problem.path), problem.field, problem.message),
                )
            )
            raise ContractError("canonical inventory validation failed:\n" + detail)
        records = {object_id: data for object_id, (_, data) in validator.records.items()}
        artwork_render_owners = resolve_artwork_render_owners(records)
        for object_id, record in records.items():
            for index, artwork in enumerate(record["artwork"]):
                require(
                    canonical_asset_path(artwork["asset"]) in manifest_assets,
                    f"{object_id}: artwork[{index}] asset is absent from canonical artwork manifest: "
                    f"{artwork['asset']}",
                )
        args.output.mkdir(parents=True, exist_ok=True)
        for edition in selections["editions"]:
            chosen = [
                record for record in records.values()
                if alpha_selected(record, edition, alpha_assets)
            ]
            chosen.sort(key=lambda item: (
                item.get("sort_name", item["preferred_english_name"]).casefold(),
                item["id"],
            ))
            body = [
                "% Generated deterministically; do not edit.",
                "% Canonical source-bounded alpha view.",
                f"% edition: {edition['id']}",
            ]
            if edition["id"] == "ed-altar-server":
                body.extend(
                    record_tex(record, edition, artwork_render_owners)
                    for record in chosen
                )
            else:
                body.extend(dense_edition_tex(chosen, edition, artwork_render_owners))
            data = ("\n".join(body) + "\n").encode()
            (args.output / f"{edition['id']}.tex").write_bytes(data)
            if edition["id"] == "ed-altar-server":
                vestments = [
                    record for record in chosen
                    if primary_category(record)
                    in {"priestly-vestments", "deacon-and-subdeacon"}
                ]
                vestment_body = [
                    "% Generated deterministically; do not edit.",
                    "% Canonical altar-server sacred-minister vestment alpha slice.",
                    "% edition: ed-altar-server",
                    *dense_edition_tex(
                        vestments, edition, artwork_render_owners
                    ),
                ]
                (args.output / "ed-altar-server-vestments.tex").write_text(
                    "\n".join(vestment_body) + "\n", encoding="utf-8"
                )

            chosen_ids = {record["id"] for record in chosen}
            omitted = [
                record for record in records.values()
                if record["id"] not in chosen_ids
            ]
            omitted.sort(
                key=lambda item: (
                    item.get("sort_name", item["preferred_english_name"]).casefold(),
                    item["id"],
                )
            )
            omission_body = [
                "% Generated deterministically; do not edit.",
                "% Canonical alpha omission register.",
            ]
            omission_body.extend(
                "\\RSDAlphaOmission"
                f"{{{tex(record['id'])}}}"
                f"{{{tex(record['preferred_english_name'])}}}"
                f"{{{tex(alpha_omission_reason(record, edition, alpha_assets))}}}"
                for record in omitted
            )
            if not omitted:
                omission_body.append("\\RSDAlphaNoOmissions")
            (args.output / f"{edition['id']}.alpha-omissions.tex").write_text(
                "\n".join(omission_body) + "\n", encoding="utf-8"
            )
            admitted_assets = sorted({
                canonical_asset_path(artwork["asset"])
                for record in chosen
                for artwork in record["artwork"]
            })
            sidecar = [
                "schema_version = 1",
                f'edition_id = "{edition["id"]}"',
                'status = "alpha"',
                'distribution_state = "public-alpha"',
                'admission_rule = "identity and governing status resolved; source-audited or later; every rendered factual claim has a claim-verified binding; illustrated records have manifest identity, rights/provenance, and identity-checked or later visual state; explicitly text-only records have no publication artwork; the two exact-source lesson-book records use the audited TeX-native generic-book contract; unresolved and unverified-lead records excluded"',
                f"admitted_object_count = {len(chosen)}",
                f"omitted_object_count = {len(omitted)}",
                "admitted_object_ids = [",
                *(f'  "{record["id"]}",' for record in chosen),
                "]",
                "admitted_artwork_paths = [",
                *(f'  "{path}",' for path in admitted_assets),
                "]",
                "",
            ]
            (args.output / f"{edition['id']}.alpha-admissions.toml").write_text(
                "\n".join(sidecar), encoding="utf-8"
            )
        digest = hashlib.sha256(args.selections.read_bytes()).hexdigest()
        (args.output / "selection-input.sha256").write_text(digest + "\n", encoding="ascii")
    except (OSError, tomllib.TOMLDecodeError, ContractError, KeyError, TypeError) as error:
        print(f"dictionary generation error: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
