{
  "name": "proper-study-web-review",
  "description": "Independent cold review with explicit upstream repair ownership.",
  "required_fields": [
    "stage",
    "iteration",
    "disposition",
    "findings"
  ],
  "valid_dispositions": [
    "PASS",
    "CHANGES_REQUIRED",
    "BLOCKED"
  ],
  "finding_fields": [
    "id",
    "severity",
    "location",
    "problem",
    "required_result"
  ],
  "blocking_finding_fields": [
    "repair_target"
  ],
  "finding_enums": {
    "severity": [
      "blocking",
      "accepted",
      "escalation",
      "advisory"
    ],
    "repair_target": [
      "research",
      "study",
      "publication"
    ]
  },
  "optional_fields": [
    "summary",
    "observations"
  ],
  "observation_fields": [
    "location",
    "note"
  ],
  "escalation_finding_fields": [
    "escalated_to"
  ],
  "accepted_finding_fields": [
    "accepted_because"
  ],
  "optional_finding_fields": [
    "out_of_scope_reason"
  ]
}
