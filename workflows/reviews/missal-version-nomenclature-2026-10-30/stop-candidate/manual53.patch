+"""Exercise public reader keys at the generators' real CLI dispatch boundary."""
+from __future__ import annotations
+
+import contextlib
+import hashlib
+from importlib.machinery import SourceFileLoader
+from importlib.util import module_from_spec, spec_from_loader
+import io
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import unittest
+from unittest import mock
+
+ROOT = Path(__file__).resolve().parents[2]
+PAIRS = (("roman-pre-1955", "roman-bonn-2004-study"),
+         ("postconciliar", "roman-2008-study"))
+BOOKS = ("roman-la-2004-bonn-ed28", "roman-la-2008-typica3-emended", "roman-la-1962-typica")
+VERBS = {
+    "mass-propers": ("show", "list", "structure", "census"),
+    "mass-ordinary": ("check", "structure", "coverage", "show"),
+    "calendar-days": ("check", "structure", "coverage", "day"),
+    "calendar-rubrics": ("check", "structure", "assign", "day"),
+}
+BONN = {
+    "Collect": ("collect", "76c16b62811f77c6e969be1b9db9809a4e5a9a94896bdd30e4e1c7b3df2066f9"),
+    "Secret": ("secret", "e4149297fffeccff97a8a51d5f15207e9cea2d9f9617a77d82a9bb6f62681d86"),
+    "Postcommunion": ("postcommunion", "b39663c740af3058e521609ba2567e183e6fc1f2d0eeb9361bd74e54e3ed8d87"),
+}
+
+
+def command(tool, *args):
+    return subprocess.run(
+        [sys.executable, str(ROOT / "tools" / tool), *args],
+        cwd=ROOT, capture_output=True, text=True, timeout=90,
+        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1", "TRIPTYCH_YAML_CACHE": "0"},
+    )
+
+
+def load_tool(name):
+    loader = SourceFileLoader("_generator_alias_test_" + name.replace("-", "_"), str(ROOT / "tools" / name))
+    spec = spec_from_loader(loader.name, loader)
+    module = module_from_spec(spec)
+    sys.modules[spec.name] = module
+    loader.exec_module(module)
+    return module
+
+
+class GeneratorDispatchTests(unittest.TestCase):
+    def test_every_verb_normalizes_before_any_handler_runs(self):
+        # Handler spies ensure write verbs cannot write. They also prove the
+        # boundary precedes raw source/overlay/inventory/target dispatch.
+        for tool, verbs in VERBS.items():
+            module = load_tool(tool)
+            root = ROOT / "src/sources"
+            if tool != "mass-ordinary":
+                root = root / "calendars"
+            for internal, public in PAIRS:
+                for verb in verbs:
+                    with self.subTest(tool=tool, verb=verb, public=public):
+                        seen = []
+                        def handler(arguments):
+                            seen.append(arguments.calendar)
+                            return {"calendar": arguments.calendar}
+                        function = "run_" + verb
+                        with mock.patch.object(module, function, side_effect=handler), mock.patch.object(module, "print_json"), mock.patch.object(module._missal_versions, "normalize_calendar_key", wraps=module._missal_versions.normalize_calendar_key) as normalize, contextlib.redirect_stdout(io.StringIO()):
+                            status = module.main([verb, "--root", str(root), "--calendar", public, "--json"])
+                        self.assertEqual(status, 0)
+                        self.assertEqual(seen, [internal])
+                        normalize.assert_called_once_with((ROOT / "src/sources/calendars").resolve(), public)
+
+    def test_unknown_and_formal_books_refuse_before_any_handler_runs(self):
+        for tool, verbs in VERBS.items():
+            module = load_tool(tool)
+            verb = "list" if tool == "mass-propers" else "show" if tool == "mass-ordinary" else "day"
+            for key in ("unknown-reader-version", *BOOKS):
+                with self.subTest(tool=tool, key=key):
+                    held = io.StringIO()
+                    with mock.patch.object(module, "run_" + verb, side_effect=AssertionError("handler must not run")), contextlib.redirect_stdout(held), contextlib.redirect_stderr(held):
+                        status = module.main([verb, "--calendar", key, "--json"])
+                    self.assertEqual(status, 2)
+                    error = json.loads(held.getvalue())
+                    self.assertIn("unknown reader calendar", json.dumps(error))
+
+
+class GeneratorPublicCommandTests(unittest.TestCase):
+    def equal_payloads(self, tool, arguments, internal, public):
+        old, new = [command(tool, *arguments, "--calendar", key, "--json") for key in (internal, public)]
+        for result in (old, new):
+            self.assertEqual(result.returncode, 0, result.stderr or result.stdout)
+        # Compare entire machine bytes: all calendar/source/target/choice
+        # coordinates and all body/provenance facts remain identical.
+        self.assertEqual(old.stdout, new.stdout)
+        self.assertEqual(old.stderr, new.stderr)
+        return json.loads(new.stdout)
+
+    def test_calendar_days_both_public_keys_keep_internal_appointments(self):
+        for internal, public in PAIRS:
+            with self.subTest(public=public):
+                data = self.equal_payloads("calendar-days", ["day", "--date", "2026-09-05"], internal, public)
+                self.assertEqual([row["calendar"] for row in data["days"]], [internal])
+
+    def test_calendar_rubrics_both_public_keys_keep_internal_decisions(self):
+        for internal, public in PAIRS:
+            with self.subTest(public=public):
+                data = self.equal_payloads("calendar-rubrics", ["day", "--date", "2026-09-05"], internal, public)
+                self.assertTrue(data)
+
+    def test_mass_ordinary_both_public_keys_keep_whole_ordinary_and_sources(self):
+        for internal, public in PAIRS:
+            with self.subTest(public=public):
+                data = self.equal_payloads("mass-ordinary", ["show"], internal, public)
+                self.assertEqual([row["calendar"] for row in data["ordinary"]], [internal])
+
+    def test_mass_propers_list_both_public_keys_keep_internal_mapping_keys(self):
+        for internal, public in PAIRS:
+            with self.subTest(public=public):
+                data = self.equal_payloads("mass-propers", ["list"], internal, public)
+                self.assertEqual(set(data["calendars"]), {internal})
+
+    def test_public_bonn_show_keeps_exact_three_bodies_and_source_identities(self):
+        data = self.equal_payloads(
+            "mass-propers", ["show", "--mass", "pentecost", "--lang", "la"],
+            "roman-pre-1955", "roman-bonn-2004-study")
+        self.assertEqual(data["calendar"], "roman-pre-1955")
+        self.assertEqual(data["mass"]["key"], "pentecost")
+        bodies = {row["name"]: row for row in data["mass"]["propers"] if row.get("text")}
+        self.assertEqual(set(bodies), set(BONN))
+        for name, (suffix, expected) in BONN.items():
+            row = bodies[name]
+            self.assertEqual(hashlib.sha256(row["text"].encode()).hexdigest(), expected)
+            self.assertFalse(row["latin"].get("withheld", False))
+            provenance = row["latin"]["provenance"]
+            self.assertEqual(provenance["relationship"], "editorial-projection-exact-to-target")
+            self.assertEqual(provenance["source_id"], "passage.triptych.bonn-pre-1955-pentecost-latin-projection.editorial-projection-2026-10-26.pentecost-" + suffix)
+
+
+if __name__ == "__main__":
+    unittest.main()
