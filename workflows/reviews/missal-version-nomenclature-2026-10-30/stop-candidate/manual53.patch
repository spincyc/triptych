+def digest(value):
+    return hashlib.sha256(json.dumps(value, sort_keys=True, ensure_ascii=False).encode()).hexdigest()
+
+
+class CalendarBoundaryTests(unittest.TestCase):
+    def test_aliases_resolve_before_directory_filter_and_preserve_documents(self):
+        for internal, public in PAIRS + (("roman-1962", "roman-1962"),):
+            with self.subTest(public=public):
+                old = _calendars.partition(CALENDARS, internal)
+                new = _calendars.partition(CALENDARS, public)
+                self.assertTrue(old[0])
+                self.assertEqual(old, new)
+                self.assertEqual(new[0][0].parent.name, internal)
+                self.assertEqual(_calendars.index_header(CALENDARS, public, "calendar"), internal)
+                self.assertEqual(_calendars.base_of(CALENDARS, public), _calendars.base_of(CALENDARS, internal))
+                self.assertEqual(digest(_calendars.load_document(CALENDARS, public)),
+                                 digest(_calendars.load_document(CALENDARS, internal)))
+
