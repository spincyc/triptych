+#!/usr/bin/env node
+/* Public names are lexical aliases, never new v1 source/event identities. */
+import assert from 'node:assert/strict';
+import { createHash } from 'node:crypto';
+import { readFileSync } from 'node:fs';
+import { createRequire } from 'node:module';
+import { resolve } from 'node:path';
+import test from 'node:test';
+import vm from 'node:vm';
+
+const ROOT = resolve(import.meta.dirname, '../..');
+const require = createRequire(import.meta.url);
+const C = require(resolve(ROOT, 'src/web/browser/liturgy/reader-state.js'));
+const A = require(resolve(ROOT, 'src/web/browser/liturgy/reader-state-adapters.js'));
+const json = path => JSON.parse(readFileSync(resolve(ROOT, path), 'utf8'));
+const index = json('src/web/data/structure/propers/index.json');
+const rubrics = json('src/web/data/structure/rubrics/index.json');
+const bibles = json('src/web/data/bibles.json');
+const rows = index.missals.filter(row => row.reader_contribution?.eligible === true);
+const keys = C.missalKeyContext(rows);
+const structures = Object.fromEntries(rows.map(row => [row.id,
+  json('src/web/data/structure/propers/' + row.id + '.json')]));
+const context = entrance => A.validationContext({ entrance, bibles,
+  properIndex: index, rubricsIndex: rubrics, ordinaryIndex: { calendars: [] }, structures });
+const normalize = (entrance, hash, remembered = {}) => C.normalizeLegacy(C.parseLegacy(entrance, hash), {
+  context: context(entrance), remembered,
+  defaults: { date: '2026-05-24', missal: index.default, bible: 'douay-rheims', orations: 'la' }
+});
+const digest = value => createHash('sha256').update(JSON.stringify(value)).digest('hex');
+
+test('manifest declares exactly the three contributed readers, with bidirectional keys', () => {
+  assert.equal(index.default, 'roman-1962');
+  assert.deepEqual(rows.map(row => row.reader_version.id).sort(),
+    ['roman-1962', 'roman-2008-study', 'roman-bonn-2004-study']);
+  for (const row of rows) {
+    assert.equal(C.normalizeMissalKey(row.reader_version.id, keys), row.id);
+    assert.equal(C.publicMissalKey(row.id, keys), row.reader_version.id);
+    for (const alias of row.reader_version.aliases) {
+      assert.equal(C.normalizeMissalKey(alias, keys), row.id);
+      assert.equal(C.publicMissalKey(alias, keys), row.reader_version.id);
+    }
+  }
+  for (const unknown of ['roman-1920', 'roman-la-2002-typica3', 'no-reader', '', '__proto__']) {
+    assert.equal(C.normalizeMissalKey(unknown, keys), null);
+    assert.equal(C.publicMissalKey(unknown, keys), null);
+  }
+});
+
+test('duplicate, malformed, cross-row ambiguous and undeclared storage aliases refuse', () => {
+  const clone = () => structuredClone(rows);
+  let bad = clone(); bad.push(structuredClone(bad[0]));
+  assert.throws(() => C.missalKeyContext(bad));
+  bad = clone(); bad[0].reader_version.aliases.push(bad[0].reader_version.id);
+  assert.throws(() => C.missalKeyContext(bad));
+  bad = clone(); bad[0].reader_version.aliases.push(bad[1].reader_version.id);
+  assert.throws(() => C.missalKeyContext(bad));
+  bad = clone(); bad.find(row => row.id !== row.reader_version.id).reader_version.aliases = [];
+  assert.throws(() => C.missalKeyContext(bad));
+  bad = clone(); bad[0].reader_version.aliases.push(' bad ');
+  assert.throws(() => C.missalKeyContext(bad));
+});
+
+test('old and public keys produce equal v1 states, exact selected bodies and event hashes', () => {
+  for (const row of rows) {
+    const form = row.id === 'postconciliar' ? '&form=day&cycle=A' : '';
+    const hash = '#missal=' + row.id + '&type=seasonal&mass=pentecost&bible=douay-rheims&orations=la' + form;
+    const old = normalize('propers', hash);
+    const canonical = normalize('propers', hash.replace('missal=' + row.id, 'missal=' + row.reader_version.id));
+    assert.equal(old.ok, true, JSON.stringify(old.errors));
+    assert.deepEqual(canonical.state, old.state);
+    assert.equal(old.state.edition.id, row.id);
+    const left = A.adaptPropers({ request: old.state, structure: structures[row.id] });
+    const right = A.adaptPropers({ request: canonical.state, structure: structures[row.id] });
+    assert.equal(digest(left.events.map(event => event.selected)), digest(right.events.map(event => event.selected)));
+    assert.equal(digest(left.events.map(event => event.id)), digest(right.events.map(event => event.id)));
+    const encoded = C.serializeLegacy(old, { missalKeys: keys });
+    assert.equal(new URLSearchParams(encoded.slice(1)).get('missal'), row.reader_version.id);
+    assert.deepEqual(normalize('propers', encoded).state, old.state);
+    assert.equal(C.serializeLegacy(old).includes('missal=' + row.id), true);
+  }
+});
+
+test('Day Compare canonicalizes both reader fields without touching opaque values', () => {
+  const opaque = 'proper-choice/postconciliar/pentecost/day/antiphon/source';
+  const query = new URLSearchParams({ date: '2026-05-24', missal: 'roman-pre-1955',
+    bible: 'douay-rheims', orations: 'la', mode: 'compare', compare: 'recension',
+    'peer-missal': 'postconciliar', territory: 'universal', location: 'proper/roman-pre-1955/pentecost/001',
+    'future-source': opaque, 'proper-choices': JSON.stringify({ 'proper-choice/roman-pre-1955/pentecost/main/antiphon': 'postconciliar' }) });
+  const old = normalize('day', '#' + query);
+  assert.equal(old.ok, true, JSON.stringify(old.errors));
+  const encoded = C.serializeLegacy(old, { missalKeys: keys });
+  const output = new URLSearchParams(encoded.slice(1));
+  assert.equal(output.get('missal'), 'roman-bonn-2004-study');
+  assert.equal(output.get('peer-missal'), 'roman-2008-study');
+  assert.equal(output.get('location'), query.get('location'));
+  assert.equal(output.get('proper-choices'), query.get('proper-choices'));
+  assert.equal(output.get('future-source'), opaque);
+  assert.deepEqual(normalize('day', encoded).state, old.state);
+  assert.equal(C.serializeLegacy(normalize('day', encoded), { missalKeys: keys }), encoded);
+  for (const hash of ['#missal=unknown', '#missal=postconciliar&missal=roman-2008-study',
+    '#' + query + '&peer-missal=roman-2008-study', '#' + query.toString().replace('peer-missal=postconciliar', 'peer-missal=unknown')]) {
+    assert.equal(normalize('day', hash).ok, false, hash);
+  }
+});
+
+test('remembered public and legacy keys normalize identically and unknown memory falls back', () => {
+  assert.deepEqual(C.readerPreferences({ missal: 'roman-2008-study', bible: 'douay-rheims',
+    orations: 'la', date: '2026-05-24', form: 'day', locality: 'invented' }, keys),
+  { missal: 'postconciliar', bible: 'douay-rheims', orations: 'la' });
+  for (const bad of [null, false, [], 'not-an-object']) assert.deepEqual(C.readerPreferences(bad, keys), {});
+  assert.deepEqual(normalize('propers', '', { missal: 'postconciliar' }).state,
+    normalize('propers', '', { missal: 'roman-2008-study' }).state);
+  assert.equal(normalize('propers', '', { missal: 'not-held' }).state.edition.id, index.default);
+  assert.equal(normalize('propers', '#missal=not-held', { missal: 'roman-2008-study' }).ok, false);
+});
+
+test('contribution removal excludes an object from both entrance contexts', () => {
+  const properIndex = structuredClone(index), rubricsIndex = structuredClone(rubrics);
+  properIndex.missals.find(row => row.id === 'postconciliar').reader_contribution.eligible = false;
+  for (const entrance of ['day', 'propers']) {
+    const held = A.validationContext({ entrance, bibles, properIndex, rubricsIndex,
+      ordinaryIndex: { calendars: [] }, structures });
+    assert.equal(held.missals.postconciliar, undefined);
+    assert.equal(C.normalizeMissalKey('roman-2008-study', held.missalKeys), null);
+  }
+});
+
+test('query restrictions accept only unique eligible public/legacy members', () => {
+  const source = readFileSync(resolve(ROOT, 'src/web/browser/liturgy/propers-reader.js'), 'utf8');
+  const start = source.indexOf('    runtime.missals = Contract.readerMissalRows(');
+  assert.ok(start >= 0);
+  const code = source.slice(start, source.indexOf(';', start) + 1);
+  const offered = query => {
+    const realm = vm.createContext({ Contract: C, T: { params: new URLSearchParams(query) },
+      runtime: {}, loaded: [null, index] });
+    vm.runInContext(code, realm);
+    return realm.runtime.missals.map(row => row.id).join(',');
+  };
+  assert.equal(offered('missals=roman-2008-study,roman-pre-1955'), 'postconciliar,roman-pre-1955');
+  for (const query of ['missals=not-held', 'missals=roman-1920', 'missals=',
+    'missals=postconciliar,roman-2008-study', 'missals=roman-1962&missals=roman-1962']) {
+    assert.throws(() => offered(query), query);
+  }
+});
+
+test('shared notice retains actual source and temporal limits for all view contexts', () => {
+  const realm = vm.createContext({ window: { location: { search: '' }, addEventListener() {} },
+    document: { addEventListener() {} }, URLSearchParams, URL });
+  vm.runInContext(readFileSync(resolve(ROOT, 'src/web/browser/shared/browser-core.js'), 'utf8'), realm);
+  const T = realm.window.Triptych;
+  for (const row of rows) {
+    const notice = T.recensionContext(structures[row.id], null).notice;
+    assert.ok(notice.includes(row.reader_version.correspondence));
+    assert.ok(notice.includes(row.reader_version.book_label));
+  }
+  const bonn = rows.find(row => row.id === 'roman-pre-1955').reader_version.correspondence;
+  assert.match(bonn, /Three Pentecost Latin prayers/);
+  assert.match(bonn, /1962/); assert.match(bonn, /1861/); assert.match(bonn, /1920\/1948/);
+  const later = rows.find(row => row.id === 'postconciliar');
+  assert.match(later.reader_version.correspondence, /later source-recorded calendar additions/);
+  assert.match(later.reader_version.correspondence, /no single frozen or complete-current calendar horizon/);
+  assert.match(later.reader_version.correspondence, /no body is graded exact 2008 target/);
+  const mass = structures.postconciliar.masses.find(row => row.key === 'saint-teresa-calcutta-virgin');
+  assert.ok(mass);
+  const normalized = normalize('propers', '#missal=roman-2008-study&type=' + mass.kind + '&mass=' + mass.key);
+  assert.equal(normalized.ok, true, JSON.stringify(normalized.errors));
+  assert.equal(normalized.state.formulary.id, mass.key);
+});
