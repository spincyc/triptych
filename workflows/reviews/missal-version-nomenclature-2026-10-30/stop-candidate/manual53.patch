+"""Source-owned reader names and contribution from fresh public producer output.
+
+Book manifestations, scholarly identities and mixed reader views are separate.
+This module never reads generated JSON to decide whether a view has words.
+"""
+from __future__ import annotations
+
+import copy
+import json
+import re
+import sys
+from collections import Counter
+from importlib.machinery import SourceFileLoader
+from importlib.util import module_from_spec, spec_from_loader
+from pathlib import Path
+
+VERSION_SCHEMA = "triptych-missal-reader-version/v1"
+CONTRIBUTION_SCHEMA = "triptych-missal-reader-contribution/v1"
+VERSION_FIELDS = frozenset({"schema", "id", "book_id", "kind", "label", "short_label", "correspondence", "aliases", "book_label"})
+SOURCE_VERSION_FIELDS = VERSION_FIELDS - {"book_label"}
+PUBLIC_RIGHTS = frozenset({"public-domain", "project-created"})
+ID = re.compile(r"[a-z0-9]+(?:-[a-z0-9]+)*\Z")
+
+
+def catalog(calendars_root: Path) -> dict:
+    path = Path(calendars_root) / "recensions.json"
+    data = json.loads(path.read_text(encoding="utf-8")) if path.is_file() else {}
+    if not isinstance(data, dict):
+        raise ValueError("version catalog must be an object")
+    return data
+
+
+def reader_version(calendars_root: Path, calendar: str) -> dict | None:
+    rows = [r for r in catalog(calendars_root).get("reader_views", []) if r.get("calendar") == calendar]
+    if len(rows) > 1:
+        raise ValueError(f"ambiguous reader view for {calendar!r}")
+    if not rows:
+        return None
+    version = copy.deepcopy(rows[0]["reader_version"])
+    book = next((b for b in catalog(calendars_root).get("books", []) if b.get("id") == version["book_id"]), None)
+    if book is None or not isinstance(book.get("citation"), str) or not book["citation"].strip():
+        raise ValueError(f"reader book {version['book_id']!r} has no formal citation")
+    return {**version, "book_label": book["citation"]}
+
+
+def normalize_calendar_key(calendars_root: Path, value: str) -> str:
+    """Resolve only explicit public/legacy view names; never a book equivalence."""
+    data = catalog(calendars_root)
+    if data.get("schema") != "triptych-roman-recensions/v2":
+        return value  # custom pre-v2 source roots retain their existing discovery
+    views = data.get("reader_views")
+    if not isinstance(views, list):
+        raise ValueError("reader_views must be a list")
+    aliases: dict[str, str] = {}
+    calendars: set[str] = set()
+    for row in views:
+        if not isinstance(row, dict):
+            raise ValueError("invalid reader view declaration")
+        version = row.get("reader_version")
+        if not isinstance(version, dict) or set(version) != SOURCE_VERSION_FIELDS or version.get("schema") != VERSION_SCHEMA:
+            raise ValueError("invalid reader version declaration")
+        declared = version["aliases"]
+        if not isinstance(declared, list) or any(not isinstance(key, str) or not ID.fullmatch(key) for key in declared):
+            raise ValueError("invalid reader alias declaration")
+        calendar = row.get("calendar")
+        if (not isinstance(version["id"], str) or not ID.fullmatch(version["id"])
+                or not isinstance(calendar, str) or not ID.fullmatch(calendar)):
+            raise ValueError("invalid public/internal reader key")
+        if calendar in calendars:
+            raise ValueError(f"duplicate reader calendar {calendar!r}")
+        calendars.add(calendar)
+        if len(set(declared)) != len(declared) or version["id"] in declared:
+            raise ValueError(f"duplicate reader alias for {version['id']!r}")
+        if version["id"] != calendar and calendar not in declared:
+            raise ValueError(f"missing storage reader alias for {calendar!r}")
+        for key in [row["calendar"], version["id"], *declared]:
+            previous = aliases.get(key)
+            if previous is not None and previous != row["calendar"]:
+                raise ValueError(f"ambiguous reader alias {key!r}")
+            aliases[key] = row["calendar"]
+    if value not in aliases:
+        raise ValueError(f"unknown reader calendar {value!r}")
+    return aliases[value]
+
+
+def calendar_key_handlers(handlers: dict, calendars_root_for_arguments) -> dict:
+    """Normalize a CLI selection before any source, overlay or target dispatch.
+
+    Tools declare their owning calendar root once at the command boundary.
+    Every handler then receives only the retained internal calendar identity.
+    """
+    def wrap(handler):
+        def invoke(arguments):
+            if arguments.calendar is not None:
+                root = Path(calendars_root_for_arguments(arguments)).resolve()
+                arguments.calendar = normalize_calendar_key(root, arguments.calendar)
+            return handler(arguments)
+        return invoke
+    return {verb: wrap(handler) for verb, handler in handlers.items()}
+
+
+def version_problems(document: dict, root: Path) -> list[str]:
+    problems: list[str] = []
+    books = document.get("books")
+    if not isinstance(books, list) or not books:
+        return ["version books must be a nonempty list"]
+    book_ids: set[str] = set()
+    legacy_ids = {r["id"] for family in ("recensions", "expressions")
+                  for r in (document.get(family) if isinstance(document.get(family), list) else [])
+                  if isinstance(r, dict) and isinstance(r.get("id"), str)}
+    for book in books:
+        if not isinstance(book, dict):
+            problems.append("version book must be an object")
+            continue
+        identifier = book.get("id")
+        if not isinstance(identifier, str) or not ID.fullmatch(identifier) or identifier in book_ids:
+            problems.append(f"invalid or duplicate book id {identifier!r}")
+        else:
+            book_ids.add(identifier)
+        if book.get("legacy_id") is not None and (not isinstance(book["legacy_id"], str) or book["legacy_id"] not in legacy_ids):
+            problems.append(f"book {identifier!r} names unknown scholarly identity")
+        if not isinstance(book.get("publication_year"), int) or isinstance(book.get("publication_year"), bool):
+            problems.append(f"book {identifier!r} needs a publication year")
+        for field in ("label", "language", "edition_kind", "manifestation", "publisher", "basis_limit", "citation"):
+            if not isinstance(book.get(field), str) or not book[field].strip():
+                problems.append(f"book {identifier!r} needs {field}")
+    views = document.get("reader_views")
+    if not isinstance(views, list):
+        return problems + ["reader_views must be a list"]
+    calendars: set[str] = set()
+    keys: dict[str, str] = {}
+    for row in views:
+        if not isinstance(row, dict):
+            problems.append("reader view must be an object")
+            continue
+        calendar = row.get("calendar")
+        if not isinstance(calendar, str) or not ID.fullmatch(calendar) or calendar in calendars:
+            problems.append(f"invalid or duplicate reader calendar {calendar!r}")
+            continue
+        calendars.add(calendar)
+        v = row.get("reader_version")
+        if not isinstance(v, dict) or set(v) != SOURCE_VERSION_FIELDS:
+            problems.append(f"{calendar}: reader_version has wrong fields")
+            continue
+        if v["schema"] != VERSION_SCHEMA or not isinstance(v["kind"], str) or v["kind"] not in {"study-projection", "edition-reader"}:
+            problems.append(f"{calendar}: invalid reader version schema/kind")
+        if not isinstance(v["id"], str) or not ID.fullmatch(v["id"]):
+            problems.append(f"{calendar}: invalid public reader id")
+            continue
+        if isinstance(v.get("aliases"), list) and v["id"] in v["aliases"]:
+            problems.append(f"{calendar}: duplicate public reader alias")
+        if not isinstance(v["book_id"], str) or v["book_id"] not in book_ids:
+            problems.append(f"{calendar}: unknown reader book {v['book_id']!r}")
+        for field in ("id", "label", "short_label", "correspondence"):
+            if not isinstance(v[field], str) or not v[field].strip():
+                problems.append(f"{calendar}: invalid reader {field}")
+        if not isinstance(v["aliases"], list) or any(not isinstance(x, str) or not ID.fullmatch(x) for x in v["aliases"]):
+            problems.append(f"{calendar}: invalid aliases")
+            continue
+        if len(set(v["aliases"])) != len(v["aliases"]):
+            problems.append(f"{calendar}: duplicate aliases")
+        if v["id"] != calendar and calendar not in v["aliases"]:
+            problems.append(f"{calendar}: missing storage reader alias")
+        for key in [calendar, v["id"], *v["aliases"]]:
+            if key in keys and keys[key] != calendar:
+                problems.append(f"ambiguous reader alias {key!r}")
+            keys[key] = calendar
+        path = root / calendar / "propers.yaml"
+        if not path.is_file():
+            problems.append(f"{calendar}: reader calendar has no source index")
+        if v["kind"] == "study-projection" and path.is_file():
+            from _calendars import index_header
+            if index_header(root, calendar, "edition") != v["label"] or index_header(root, calendar, "edition_short") != v["short_label"]:
+                problems.append(f"{calendar}: reader labels disagree with calendar header")
+    return problems
+
+
+def contribution_from_published(*, propers: dict | None = None, ordinary: dict | None = None, connected_bodies: list[dict] | None = None) -> dict:
+    """Count literal lawful bodies, never coverage totals or citation metadata.
+
+    Inputs are the owning producers' already publication-filtered structures.
+    Connected routes must supply their actual body and rights, not a locator.
+    This gate describes contribution only and grants no target correspondence.
+    """
+    counts: dict[str, Counter] = {"propers": Counter(), "ordinary": Counter(), "connected-source": Counter(), "bible-reconstruction": Counter()}
+    def nonempty(value: object) -> bool:
+        return isinstance(value, str) and bool(value.strip())
+    def owner(node: dict, scope: str) -> None:
+        if not isinstance(node, dict):
+            return
+        if node.get("kind") in {"heading", "rubric", "action"} or node.get("name") == "Placeholder":
+            return
+        latin = node.get("latin") or {}
+        coverage = {r.get("lang"): r for r in (node.get("coverage") or {}).get("languages", [])}
+        if (scope == "propers" and nonempty(node.get("text")) and not latin.get("withheld")
+                and coverage.get("la", {}).get("availability") == "available"
+                and coverage.get("la", {}).get("publication_basis") in PUBLIC_RIGHTS):
+            counts[scope]["la"] += 1
+        for text in node.get("translations") or []:
+            if nonempty(text.get("text")) and text.get("rights") in PUBLIC_RIGHTS and nonempty(text.get("lang")):
+                counts[scope][text["lang"]] += 1
+        for family in ("cycles", "weekday_cycles"):
+            for child in (node.get(family) or {}).values():
+                owner(child, scope)
+    for mass in (propers or {}).get("masses", []):
+        for proper in mass.get("propers") or []:
+            owner(proper, "propers")
+    for section in (ordinary or {}).get("sections", []):
+        for element in section.get("elements") or []:
+            owner(element, "ordinary")
+    for route in connected_bodies or []:
+        if (route.get("kind") in {"connected-source", "bible-reconstruction"}
+                and nonempty(route.get("route")) and nonempty(route.get("text"))
+                and nonempty(route.get("lang")) and route.get("rights") in PUBLIC_RIGHTS
+                and nonempty(route.get("qualification"))):
+            counts[route["kind"]][route["lang"]] += 1
+    total = sum(sum(v.values()) for v in counts.values())
+    return {"schema": CONTRIBUTION_SCHEMA, "eligible": total > 0,
+            "count_basis": "literal published body occurrences; witness alternatives and repeats remain distinct",
+            "body_occurrences": total, "components": {k: dict(sorted(v.items())) for k, v in counts.items()},
+            "qualification": "Readable contribution does not establish exact Missal wording, target collation, calendar completeness or recitation authority."}
+
+
+def _producer(calendars_root: Path, name: str):
+    repository = Path(calendars_root).resolve().parents[2]
+    path = repository / "tools" / name
+    key = "_missal_version_producer_" + name.replace("-", "_") + "_" + str(repository)
+    if key not in sys.modules:
+        loader = SourceFileLoader(key, str(path))
+        spec = spec_from_loader(key, loader)
+        module = module_from_spec(spec)
+        sys.modules[key] = module
+        loader.exec_module(module)
+    return sys.modules[key]
+
+
+def reader_metadata(calendars_root: Path, calendar: str, *, propers: dict | None = None, ordinary: dict | None = None) -> dict:
+    version = reader_version(calendars_root, calendar)
+    if version is None:
+        return {}  # custom source roots have no registered public reader views
+    if propers is None:
+        producer = _producer(calendars_root, "mass-propers")
+        propers = producer.calendar_structure(Path(calendars_root), calendar, producer.book_tokens())
+    if ordinary is None:
+        producer = _producer(calendars_root, "mass-ordinary")
+        sources = Path(calendars_root).parent
+        path = sources / "inventories" / (calendar + producer.INVENTORY_SUFFIX)
+        ordinary = producer.calendar_structure(sources, path, producer.artifact_records(sources)) if path.is_file() else {}
+    return {"reader_version": version, "reader_contribution": contribution_from_published(propers=propers, ordinary=ordinary)}
+
+
+def public_metadata_problems(value: dict, calendars_root: Path, calendar: str) -> list[str]:
+    """Validate the two exact public metadata objects at a reader selector."""
+    problems = []
+    if value.get("reader_version") != reader_version(calendars_root, calendar):
+        problems.append("reader_version differs from its source-owned descriptor")
+    contribution = value.get("reader_contribution")
+    template = contribution_from_published()
+    if not isinstance(contribution, dict) or set(contribution) != set(template):
+        return problems + ["reader_contribution has unexpected fields"]
+    for field in ("schema", "count_basis", "qualification"):
+        if contribution.get(field) != template[field]:
+            problems.append(f"reader_contribution has invalid {field}")
+    components = contribution.get("components")
+    total = 0
+    if not isinstance(components, dict) or set(components) != set(template["components"]):
+        problems.append("reader_contribution has invalid components")
+    else:
+        for scope, counts in components.items():
+            if not isinstance(counts, dict):
+                problems.append(f"invalid {scope} contribution language counts")
+                continue
+            for lang, count in counts.items():
+                if not isinstance(lang, str) or not lang.strip() or not isinstance(count, int) or isinstance(count, bool) or count <= 0:
+                    problems.append(f"invalid {scope} contribution count")
+                else:
+                    total += count
+    if (not isinstance(contribution.get("body_occurrences"), int)
+            or isinstance(contribution.get("body_occurrences"), bool)
+            or contribution.get("body_occurrences") != total
+            or contribution.get("eligible") is not True or total <= 0):
+        problems.append("reader_contribution must prove positive actual-body contribution")
+    return problems
