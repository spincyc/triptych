        ],
        "translation_review": "workflows/reviews/missal-english-completion-2026-10-29/roman-1962/translation-review.json",
        "translations": [
          {
            "lang": "en",
            "rights": "project-created",
            "text": "Where charity and love are, God is there.\nV. Christ's love has gathered us into one.\nV. Let us exult and rejoice in him.\nV. Let us fear and love the living God.\nV. And let us love one another with a sincere heart.\n\nAnd the antiphon is repeated:\nWhere charity and love are, God is there.\nV. Therefore, as we gather together into one,\nV. let us take care that we are not divided in mind.\nV. Let malicious quarrels cease, let disputes cease.\nV. And may Christ, God, be in our midst.\n\nAnd the antiphon is repeated:\nWhere charity and love are, God is there.\nV. May we also, together with the blessed, see\nV. your face in glory, Christ, God:\nV. a joy that is boundless and good,\nV. through endless ages of ages. Amen.\n"
          }
        ]
      },
