  "findings": [
    {
      "id": "RES-001",
      "location": "research/review-dependencies.toml:18-19,63; research/scope.md:144,255-263; research/source-plan.md rights policy row",
      "problem": "The sealed dependencies stop at summary inventories or a derivative even though the research adopts their controlling evidence. The ICEL rights inventory is sealed, but none of src/sources/works/international-commission-on-english-in-the-liturgy/publication-policies/ is in REVIEW_INPUTS: the inventory's [the_grant] source_ids expressly identify the 2013 booklet artifact, global-computer-networks passage and permissions-and-royalties passage. Scope relies on that inventory's surface-limited permission conclusion. Separately, scope adopts comparison with the 1854 Honorius checked transcription; only its artifact.toml and text are sealed, while its edition record and declared derived_from parent, artifact.honorius-augustodunensis.gemma-animae.1854-migne-pl-172.migne-facsimile-pdf-906be8c5, are absent. The sealed 1895 OCR edition does not supply the 1854 derivative's ancestry. These missing controlling records prevent the seal from reproducing the adopted rights and collation evidence.",
      "repair_target": "research",
      "required_result": "Complete the research bindings/dependency manifest for the adopted ICEL policy authorities and the 1854 Honorius transcription ancestry, including their work/edition/artifact/passage records as applicable, and check the remaining adopted rights and collation chains for the same omission. Obtain a fresh research-review seal containing those controlling records; preserve restricted/remote storage and do not add protected source bodies to public Git.",
      "severity": "blocking"
    },
    {
      "id": "RES-002",
      "location": "research/scope.md:136,141-142; corresponding loci/context entries in research/source-bindings.toml",
      "problem": "Several physical line ranges do not cover the complete sections the records say were inspected. Chrysostom Matthew 68 sections 1-2 is given as lines 38374-38580, but section 2 continues beyond 38580 until the heading for section 3; First Corinthians 24 sections 1-5 is given as 12239-12445, but 12445 cuts inside section 5, before its discussion of verse 20. The Aquinas III.79.1 range ends at 43165 while its last sentence continues on the following line. The substantive adopted claims checked out when I read the complete loci, so this is a locator/inspection-scope inconsistency rather than an unsupported interpretation.",
      "required_result": "Reconcile the stated section extents and physical line ranges with the actual inspected source spans, either recording complete checked bounds or explicitly naming a partial section; keep scope and source bindings consistent.",
      "severity": "advisory"
    },
    {
      "id": "RES-003",
      "location": "research/scope.md:144,164-167,175 (Honorius IV.65 comparison)",
      "problem": "The local research record correctly restricts Honorius to the shared Collect and does not count him as a carrying Father or saint, but gives his own Mass only as an 'older Mass' with different Entrance and Communion. The sealed formulary index and source supply the identifying heading and fuller comparison: Dominica undecima post Pentecosten, Deus in loco, sub lege; Entrance Psalm 67:6, Epistle 1 Corinthians 15, Gospel Luke 18, Communion Proverbs 3:9. Keeping these facts only in the generic index makes the required local comparison less reproducible than the rest of the dossier.",
      "required_result": "Record Honorius's own Mass heading and the concrete shared/different element comparison in scope, retaining his Collect-only historical role and ecclesiastical-writer standing.",
      "severity": "advisory"
    }
  ],
