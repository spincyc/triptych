[
  {
    "name": "base-check",
    "cwd": "tree",
    "command": [
      "python3",
      "../apply-prepared.py",
      "--repo",
      "."
    ],
    "exit": 0,
    "log": "base-check.log"
  },
  {
    "name": "patch-apply",
    "cwd": "tree",
    "command": [
      "git",
