  "findings": [
    {
      "id": "STU-001",
      "location": "src/gpt/liturgy/roman-rite/1962/propers/temporal/61-twenty-first-after-pentecost/research/scope.md:335; src/gpt/liturgy/roman-rite/1962/propers/temporal/61-twenty-first-after-pentecost/sections/70-date-location.tex:69\u201370 (study p.24); Haydock Bible (1859), printed p.781 / PDF p.817, Psalm 118:1 note",
      "problem": "The research record says Haydock records David, Solomon and captive-period alternatives, and the study repeats differing attributions to David, Solomon, or captivity. The inspected page does not attribute the Psalm to Solomon: it first proposes David writing for Solomon\u2019s instruction, then David writing while persecuted by Saul, then Daniel writing for the captives. Solomon is the intended pupil in the first explanation, not a proposed author. The current wording gives readers a false source-supported authorship alternative.",
      "repair_target": "research",
      "required_result": "Correct the research account of the actual Haydock note and propagate that correction into the study. Distinguish David writing for Solomon, David\u2019s youth under Saul, and the Daniel/captivity conjecture as far as the prose reports those alternatives. Preserve the conditional relation of the Davidic era to the Psalm and the unresolved occasion; this finding supplies no replacement date and does not require alteration of the generated chronology row.",
      "severity": "blocking"
    },
    {
      "id": "STU-002",
      "location": "src/gpt/liturgy/roman-rite/1962/propers/temporal/61-twenty-first-after-pentecost/sections/70-date-location.tex:74 (study p.24, footnote 41)",
      "problem": "The footnote pinpoints Augustine, Psalm 89 \u00a71 (NPNF Psalm 90) for his caution against inferring Mosaic composition. The statement is in \u00a72 of the inspected NPNF text; \u00a71 introduces the Mosaic title and typological frame. The substantive claim is supported, but this pinpoint sends the reader to the preceding paragraph.",
      "required_result": "When editing this paragraph, change the pinpoint to \u00a72 or \u00a7\u00a71\u20132 so the citation includes the actual caveat.",
      "severity": "advisory"
    }
  ],
