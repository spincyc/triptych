      "before_untranslated_sha256": "2def00de22f053736bab07c33139af5c1350a25736d4b07d9c7c8f003374b63e",
      "after_entry": {
        "mass": "easter-2",
        "form_id": "main",
        "proper": "Collect",
        "cycle": "all",
        "occurrence": 1,
        "incipit": "Deus misericordiae sempiternae",
        "relation": "variant",
        "ancient_witness": "De Liturgia Gallicana libriIII, Paris, apudMontalant,1729; printed258; Missale Gothicum, XLIII Missa in die Sabbato Octavae Paschae, Post nomina",
        "witness_edition_id": "edition.jean-mabillon.de-liturgia-gallicana.paris-montalant-1729",
        "witness_artifact_id": "artifact.jean-mabillon.de-liturgia-gallicana.paris-montalant-1729.easter2-collect-20261113-easter2-collect",
        "ancient_passage_id": "passage.jean-mabillon.de-liturgia-gallicana.paris-montalant-1729.easter2-collect-20261113-easter2-collect-text",
        "ancient_reading": "Deus misericordiae sempiternae, qui in ipso Paschalis festi recursu fidem sacratae tibi plebis accendis : auge gratiam, quam dedisti : ut digna omnes intelligentia comprehendant, quo lavacro abluti, quo Spiritu regenerati, quo Sanguine sunt redempti. Per.",
        "divergence": "Normalize the old spelling intelligentia to the modern comparison intellegentia. All substantive petition words and their order are unchanged. Normalize ligatures, stress accents, case, punctuation and print line wrapping; the old source already prints festi, recursu and lavacro, so no grammatical repairs of those words are imported from the modern text. The old printed Per. cue is retained as such in the historical body. The receiving Per Dominum cue is assembled as the full Father-addressed conclusion actually printed in secondary2002IGMR54, separately and completely witnessed with distinct R.Amen in Pustet1862AP88. No expansion is falsely attributed to Mabillon. Exact new study English passage.triptych.easter2-collect-study-english-20261113.2026-11-13.easter2-collect. Modern comparison passage.catholic-church.missale-romanum.vatican-typica-tertia-2002.easter2-collect-20261113-easter2-collect-comparison. Project-created study English from the complete Gallican post-nomina prayer printed in 1729, with one spelling normalization and a separately witnessed full 1862 conclusion and marked response. The comparison is a secondary digital 2002 Roman Collect; agreement with printed 2002 and the exact 2008 text remains unestablished. This is neither historical human English nor approved liturgical English, and is not for recitation.",
        "witness_note": "Project-created study English from the complete Gallican post-nomina prayer printed in 1729, with one spelling normalization and a separately witnessed full 1862 conclusion and marked response. The comparison is a secondary digital 2002 Roman Collect; agreement with printed 2002 and the exact 2008 text remains unestablished. This is neither historical human English nor approved liturgical English, and is not for recitation.",
        "translations": [
          {
            "lang": "en",
            "rights": "project-created",
            "text": "God of everlasting mercy, at the very recurrence of the paschal feast you kindle the faith of the people consecrated to you. Increase the grace you have given, so that all may understand with worthy insight by what washing they have been cleansed, by what Spirit they have been born anew, and by what blood they have been redeemed. Through our Lord Jesus Christ, your Son, who lives and reigns with you in the unity of the Holy Spirit, God, for ever and ever. R. Amen."
          }
        ]
      },
