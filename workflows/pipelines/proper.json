{
  "id": "proper",
  "version": 8,
  "description": "1962 propers synthesis production workflow",
  "document_argument": "proper",
  "document_discovery": {
    "search": "src/*/liturgy/roman-rite/1962/propers/*/*",
    "marker": "main.tex",
    "id_drops_leading": 2
  },
  "argument_schema": {
    "proper": {
      "type": "string",
      "required": true,
      "description": "Canonical proper leaf id (e.g. liturgy/roman-rite/1962/propers/temporal/46-ninth-after-pentecost)"
    },
    "provider": {
      "type": "string",
      "required": false,
      "default": "gpt",
      "description": "Provider directory (gpt or claude)"
    }
  },
  "stages": [
    {
      "id": "seed",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/seed.md"
      ],
      "result_schema": "worker-result.json",
      "next": "resolve-context"
    },
    {
      "id": "resolve-context",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/resolve-context.md"
      ],
      "result_schema": "worker-result.json",
      "next": "source-audit"
    },
    {
      "id": "source-audit",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/source-audit.md"
      ],
      "result_schema": "worker-result.json",
      "next": "research"
    },
    {
      "id": "research",
      "type": "linear",
      "execution": {
        "mode": "fanout",
        "parallelism": "host-max",
        "join": "strict-union",
        "lanes": [
          {
            "id": "scripture-context",
            "fragments": [
              "propers/lanes/research-scripture-context.md"
            ]
          },
          {
            "id": "patristic-reception",
            "fragments": [
              "propers/lanes/research-patristic-reception.md"
            ]
          },
          {
            "id": "liturgical-history",
            "fragments": [
              "propers/lanes/research-liturgical-history.md"
            ]
          },
          {
            "id": "theological-synthesis",
            "fragments": [
              "propers/lanes/research-theological-synthesis.md"
            ]
          },
          {
            "id": "source-citation-coverage",
            "fragments": [
              "propers/lanes/research-source-citation-coverage.md"
            ]
          },
          {
            "id": "cultural-afterlife",
            "fragments": [
              "propers/lanes/research-cultural-afterlife.md"
            ]
          },
          {
            "id": "precedent-search",
            "fragments": [
              "propers/lanes/research-precedent-search.md"
            ]
          }
        ]
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/research.md"
      ],
      "result_schema": "research-result.json",
      "next": "research-synthesis"
    },
    {
      "id": "research-synthesis",
      "type": "evaluator",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/research-synthesis.md"
      ],
      "result_schema": "research-synthesis-result.json",
      "pass_transition": "author-proper",
      "fail_transition": "research",
      "max_iterations": 3
    },
    {
      "id": "author-proper",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/author-proper.md"
      ],
      "result_schema": "worker-result.json",
      "next": "content-evaluation"
    },
    {
      "id": "content-evaluation",
      "type": "evaluator",
      "execution": {
        "mode": "fanout",
        "parallelism": "host-max",
        "join": "strict-union",
        "lanes": [
          {
            "id": "evidence-discipline",
            "fragments": [
              "propers/lanes/content-evidence-discipline.md"
            ]
          },
          {
            "id": "reception-sweep",
            "fragments": [
              "propers/lanes/content-reception-sweep.md"
            ]
          },
          {
            "id": "synthesis-argument",
            "fragments": [
              "propers/lanes/content-synthesis-argument.md"
            ]
          },
          {
            "id": "citation-integrity",
            "fragments": [
              "propers/lanes/content-citation-integrity.md"
            ]
          },
          {
            "id": "profile-conformance",
            "fragments": [
              "propers/lanes/content-profile-conformance.md"
            ]
          }
        ]
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/content-evaluation.md"
      ],
      "result_schema": "content-evaluation-result.json",
      "pass_transition": "build-artifacts",
      "fail_transition": "content-revision",
      "repair_routes": [
        {
          "repair_target": "research",
          "transition": "research"
        },
        {
          "repair_target": "authoring",
          "transition": "content-revision"
        }
      ],
      "max_iterations": 3
    },
    {
      "id": "content-revision",
      "type": "bounded-revision",
      "execution": {
        "mode": "single"
      },
      "revision_target": "author-proper",
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/content-revision.md",
        "propers/author-proper.md"
      ],
      "result_schema": "worker-result.json",
      "next": "content-evaluation"
    },
    {
      "id": "build-artifacts",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/build-artifacts.md"
      ],
      "result_schema": "worker-result.json",
      "next": "mechanical-gates"
    },
    {
      "id": "mechanical-gates",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "proper-components",
          "command": "tools/tpt check-proper-components --provider {provider} --document {proper}",
          "required_result": "proper-components manifest must be valid"
        },
        {
          "id": "build-canonical",
          "command": "make doc DOC={proper} PROVIDER={provider}",
          "required_result": "canonical PDF must build without fatal errors"
        },
        {
          "id": "build-synthesis",
          "command": "make doc DOC={proper}-synthesis PROVIDER={provider}",
          "required_result": "synthesis PDF must build without fatal errors"
        }
      ],
      "pass_transition": "visual-evaluation",
      "fail_transition": "artifact-revision",
      "max_iterations": 3
    },
    {
      "id": "artifact-revision",
      "type": "bounded-revision",
      "execution": {
        "mode": "single"
      },
      "revision_target": "build-artifacts",
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/artifact-revision.md",
        "propers/build-artifacts.md"
      ],
      "result_schema": "worker-result.json",
      "next": "mechanical-gates"
    },
    {
      "id": "visual-evaluation",
      "type": "evaluator",
      "execution": {
        "mode": "fanout",
        "parallelism": "host-max",
        "join": "strict-union",
        "lanes": [
          {
            "id": "density-and-hierarchy",
            "fragments": [
              "propers/lanes/visual-density-and-hierarchy.md"
            ]
          },
          {
            "id": "page-rhythm",
            "fragments": [
              "propers/lanes/visual-page-rhythm.md"
            ]
          },
          {
            "id": "fixed-pagination",
            "fragments": [
              "propers/lanes/visual-fixed-pagination.md"
            ]
          },
          {
            "id": "clipping-and-apparatus",
            "fragments": [
              "propers/lanes/visual-clipping-and-apparatus.md"
            ]
          }
        ]
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/visual-evaluation.md"
      ],
      "result_schema": "evaluator-result.json",
      "pass_transition": "final-acceptance",
      "fail_transition": "visual-revision",
      "max_iterations": 3
    },
    {
      "id": "visual-revision",
      "type": "bounded-revision",
      "execution": {
        "mode": "single"
      },
      "revision_target": "build-artifacts",
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "propers/visual-revision.md",
        "propers/build-artifacts.md"
      ],
      "result_schema": "worker-result.json",
      "next": "mechanical-gates"
    },
    {
      "id": "final-acceptance",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "canonical-pdf",
          "command": "test -f build/{provider}/{proper}.pdf",
          "required_result": "the canonical PDF must exist for {proper}"
        },
        {
          "id": "synthesis-pdf",
          "command": "test -f build/{provider}/{proper}-synthesis.pdf",
          "required_result": "the synthesis PDF must exist for {proper}"
        },
        {
          "id": "proper-components",
          "command": "tools/tpt check-proper-components --provider {provider} --document {proper} --aux build/{provider}/{proper}-synthesis.aux",
          "required_result": "the proper-components manifest must be consistent with the built artifacts, and the brief synthesis must occupy exactly two pages"
        },
        {
          "id": "generation-metadata",
          "command": "tools/tpt check-generation-metadata --provider {provider} --pdf {proper} build/{provider}/{proper}.pdf",
          "required_result": "tracked revision timestamps and AI provenance must be valid in source and PDF"
        }
      ],
      "pass_transition": "ACCEPTED",
      "fail_transition": "artifact-revision",
      "max_iterations": 3
    }
  ]
}
