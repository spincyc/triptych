          "id": "generated-documents-current",
          "command": "tools/tpt document-types refresh --check --leaf {provider}/{proper}",
          "required_result": "Every entrypoint and the Scriptural Date and Location page must be exactly what the proper-study-v1 document type generates from publication.toml [document] and the leaf's chronology record, and no authored file may be or import a date page. Run tools/tpt document-types refresh; never edit a generated file.",
          "repair_target": "study"
        }
      ],
      "pass_transition": "generate-web",
      "fail_transition": "build-artifacts",
      "max_iterations": 4,
      "verify_review_inputs": true,
      "review_input_stages": [
        "research-review",
        "study-review",
        "synthesis-review",
        "homily-review"
      ],
      "result_schema": "proper-study-artifact-gate.json",
      "repair_routes": [
        {
          "repair_target": "research",
          "transition": "research"
        },
        {
          "repair_target": "study",
          "transition": "author-study"
        },
        {
          "repair_target": "synthesis",
          "transition": "derive-synthesis"
        },
        {
          "repair_target": "homily",
          "transition": "derive-homily"
        }
      ]
    },
    {
      "id": "generate-web",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/generate-web.md"
      ],
      "result_schema": "worker-result.json",
      "next": "web-review",
      "repairs": [
        "publication"
      ],
      "reports_repairs": true
    },
    {
      "id": "web-review",
      "type": "evaluator",
      "effort": "xhigh",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/review.md",
        "proper-study/web-review.md"
      ],
      "result_schema": "proper-study-web-review.json",
      "pass_transition": "install-publication",
      "fail_transition": "generate-web",
      "repair_routes": [
        {
          "repair_target": "research",
          "transition": "research"
        },
        {
          "repair_target": "study",
          "transition": "author-study"
        },
        {
          "repair_target": "publication",
          "transition": "generate-web"
        }
      ],
      "max_iterations": 4,
      "max_total_iterations": 10,
      "max_novel_iterations": 4,
      "review_scope": true,
      "records_standing_findings": true,
      "review_input_command": "python3 scripts/_proper_study.py seal --provider {provider} --document {proper} --review web --mode source",
      "review_input_repair_target": "publication"
    },
    {
      "id": "install-publication",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/install-publication.md"
      ],
      "result_schema": "worker-result.json",
      "next": "publication-gates",
      "repairs": [
        "publication"
      ],
      "reports_repairs": true
    },
    {
      "id": "publication-gates",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "three-document-publication",
          "command": "python3 scripts/_proper_study.py check --provider {provider} --document {proper} --date {date} --phase publication --require-presentation --require-format --require-authority --require-orientation --require-orientation-v3 --mode source",
          "required_result": "Current source identities, canonical reviewed web bytes, exact release IDs and the owning catalog must match this provider and family; no PDF is required.",
          "repair_target": "study"
        },
        {
          "id": "release-bindings",
          "command": "make check-release-bindings",
          "required_result": "The site authorization must bind the current reader-facing sources."
        },
        {
          "id": "public-alpha",
          "command": "tools/tpt public-alpha check --provider {provider} --document {proper}",
          "required_result": "Every publication record and catalog link must satisfy the public release contract."
        },
        {
          "id": "document-catalogue",
          "command": "tools/tpt document-library check --provider {provider} --document {proper} && tools/tpt document-library structure --check",
          "required_result": "The deterministic corpus catalog must include the current publications."
        },
        {
          "id": "web-editions-current",
          "command": "python3 tools/tpt web-edition check --leaf {provider}/{proper}",
          "required_result": "Every web reader output of this study, companions included, must convert from its current canonical TeX with every fidelity audit."
        }
      ],
      "pass_transition": "ACCEPTED",
      "fail_transition": "install-publication",
      "max_iterations": 4,
      "verify_review_inputs": true,
      "result_schema": "proper-study-publication-gate.json",
      "repair_routes": [
        {
          "repair_target": "research",
          "transition": "research"
        },
        {
          "repair_target": "study",
          "transition": "author-study"
        },
        {
          "repair_target": "synthesis",
          "transition": "derive-synthesis"
        },
        {
          "repair_target": "homily",
          "transition": "derive-homily"
        },
        {
          "repair_target": "artifacts",
          "transition": "build-artifacts"
        },
        {
          "repair_target": "publication",
          "transition": "generate-web"
        }
      ]
    }
  ]
}
