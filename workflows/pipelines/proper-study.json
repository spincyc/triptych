{
  "id": "proper-study",
  "version": 19,
  "description": "Source-first proper study, concise study and standalone homily, with independent reviews",
  "default_effort": "high",
  "document_argument": "proper",
  "document_root": "src/{provider}/{proper}",
  "document_discovery": {
    "search": "src/*/liturgy/roman-rite/**/propers/*/*",
    "marker": "main.tex",
    "id_drops_leading": 2,
    "validator": "python3 scripts/_proper_study.py identity --document {proper}"
  },
  "argument_schema": {
    "proper": {
      "type": "string",
      "required": true,
      "description": "Canonical 1962 or postconciliar proper leaf id"
    },
    "provider": {
      "type": "string",
      "required": false,
      "default": "gpt",
      "description": "Provider directory (gpt or claude)"
    },
    "date": {
      "type": "string",
      "required": false,
      "default": "undated",
      "description": "Requested civil date YYYY-MM-DD, or undated for a formulary study"
    },
    "audience": {
      "type": "string",
      "required": false,
      "default": "adult parish assembly",
      "description": "Intended homily audience"
    },
    "research_handoff": {
      "type": "string",
      "required": false,
      "default": "none",
      "description": "Repository-relative preliminary research dossier path; evidence leads only"
    }
  },
  "stages": [
    {
      "id": "scope-gate",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "authorized-identity",
          "command": "python3 scripts/_proper_study.py check --provider {provider} --document {proper} --date {date} --phase scope --mode source",
          "required_result": "An exact registered identity, edition-locale and provider authorization are required before research."
        }
      ],
      "pass_transition": "resolve-context",
      "fail_transition": "BLOCKED",
      "max_iterations": 4
    },
    {
      "id": "resolve-context",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/resolve-context.md"
      ],
      "result_schema": "worker-result.json",
      "next": "research"
    },
    {
      "id": "research",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/research.md"
      ],
      "result_schema": "worker-result.json",
      "next": "source-registration",
      "repairs": [
        "research"
      ],
      "reports_repairs": true
    },
    {
      "id": "source-registration",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/source-registration.md"
      ],
      "result_schema": "worker-result.json",
      "next": "research-preflight",
      "repairs": [
        "research"
      ],
      "reports_repairs": true
    },
    {
      "id": "research-preflight",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "research-records",
          "command": "python3 scripts/_proper_study.py check --provider {provider} --document {proper} --date {date} --phase research --require-source-dispositions --mode source",
          "required_result": "Research must bind exact used witnesses and reconcile every binding with a validated fragment admission or an explicit durable disposition before cold evidence review."
        },
        {
          "id": "source-projection-current",
          "command": "tools/tpt source-reader structure --strict --check",
          "required_result": "The strict working source-library projection must reflect the registered records. Generate it after source registration; aggregate browser products wait until publication declarations and release records exist."
        }
      ],
      "pass_transition": "research-review",
      "fail_transition": "source-registration",
      "max_iterations": 4
    },
    {
      "id": "research-review",
      "type": "evaluator",
      "effort": "xhigh",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/review.md",
        "proper-study/research-review.md"
      ],
      "result_schema": "proper-study-research-review.json",
      "pass_transition": "author-study",
      "fail_transition": "research",
      "repair_routes": [
        {
          "repair_target": "research",
          "transition": "research"
        }
      ],
      "max_iterations": 4,
      "max_total_iterations": 10,
      "max_novel_iterations": 4,
      "review_scope": true,
      "records_standing_findings": true,
      "review_input_command": "python3 scripts/_proper_study.py seal --provider {provider} --document {proper} --review research --review-contract proper-study-v5 --mode source",
      "review_input_repair_target": "research"
    },
    {
      "id": "author-study",
      "type": "linear",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/author-study.md"
      ],
      "result_schema": "worker-result.json",
      "next": "study-preflight",
      "repairs": [
        "study"
      ],
      "reports_repairs": true
    },
    {
      "id": "study-preflight",
      "type": "gate",
      "execution": {
        "mode": "program"
      },
      "checks": [
        {
          "id": "generated-documents-current",
          "command": "tools/tpt document-types refresh --check --leaf {provider}/{proper}",
          "required_result": "Every entrypoint and the Scriptural Date and Location page must be exactly what the proper-study-v1 document type generates from publication.toml [document] and the leaf's chronology record, and no authored file may be or import a date page. Run tools/tpt document-types refresh; never edit a generated file."
        },
        {
          "id": "component-contract",
          "command": "python3 scripts/_proper_study.py check --provider {provider} --document {proper} --date {date} --phase content --edition research --require-presentation --require-format --require-authority --require-orientation --require-orientation-v3 --mode source",
          "required_result": "The schema-2 component graph must faithfully describe this edition and its complete interpretive lanes."
        },
        {
          "id": "study-web-conversion",
          "command": "tools/tpt web-edition --provider {provider} --output build/tpt-runs/{run.run_id}/artifacts/study-web-probe {proper}",
          "required_result": "The canonical study must pass the converter's source and rendered appointed-anchor coverage and fidelity audits before study review. Use pandoc and the exact Markdown pin in requirements-public-alpha.txt; this probe is not web acceptance or installation."
        },
        {
          "id": "references-used",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check references-used",
          "required_result": "This edition must pass the owning references-used check."
        },
        {
          "id": "identifiers-resolve",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check identifiers-resolve",
          "required_result": "This edition must pass the owning identifiers-resolve check."
        },
        {
          "id": "bindings-valid",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check bindings-valid",
          "required_result": "This edition must pass the owning bindings-valid check."
        },
        {
          "id": "restricted-not-reproduced",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check restricted-not-reproduced",
          "required_result": "This edition must pass the owning restricted-not-reproduced check."
        },
        {
          "id": "relation-coverage",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check relation-coverage",
          "required_result": "This edition must pass the owning relation-coverage check."
        },
        {
          "id": "unquoted-not-quoted",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check unquoted-not-quoted",
          "required_result": "This edition must pass the owning unquoted-not-quoted check."
        },
        {
          "id": "structural-meta-labels",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check structural-meta-labels",
          "required_result": "This edition must pass the owning structural-meta-labels check."
        },
        {
          "id": "house-voice",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check house-voice",
          "required_result": "This edition must pass the owning house-voice check."
        },
        {
          "id": "chronology-record-current",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check chronology-record-current",
          "required_result": "This edition must pass the owning chronology-record-current check."
        },
        {
          "id": "chronology-annotations-current",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check chronology-annotations-current",
          "required_result": "This edition must pass the owning chronology-annotations-current check."
        },
        {
          "id": "chronology-claims-supported",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check chronology-claims-supported",
          "required_result": "This edition must pass the owning chronology-claims-supported check."
        },
        {
          "id": "provenance-matches-run",
          "command": "tools/tpt check-content-preflight --provider {provider} --document {proper} --edition research --check provenance-matches-run --run-workflow {run.workflow_id} --run-workflow-version {run.workflow_version} --run-workflow-digest {run.workflow_digest} --run-id {run.run_id} --run-seed-commit {run.repo_commit}",
          "required_result": "Generation provenance must identify this actual workflow run."
        }
      ],
      "pass_transition": "study-review",
      "fail_transition": "author-study",
      "max_iterations": 4
    },
    {
      "id": "study-review",
      "type": "evaluator",
      "effort": "xhigh",
      "execution": {
        "mode": "single"
      },
      "fragments": [
        "common/agent-brief.md",
        "common/result-format.md",
        "proper-study/contract.md",
        "proper-study/review.md",
        "proper-study/study-review.md"
