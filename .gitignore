/build/
__pycache__/
*.py[cod]

# flock guards beside the files they protect. Deliberately not removed after
# unlocking: unlinking would let two processes create separate inodes and each
# believe it holds the lock. `tools/harvest` makes one beside its ledger.
*.lock

# Canonical publications are plaintext. PDFs are explicit on-demand exports.
*.pdf
*.zip
*.zip.part-*
.scratch/

# Exact binary source evidence is delivered through artifact-delivery.json.
# Product artwork and fonts outside the source artifact library stay tracked.
/src/sources/works/**/*.djvu
/src/sources/works/**/*.zip
/src/sources/works/**/*.gz
/src/sources/works/**/*.jpg
/src/sources/works/**/*.jpeg
/src/sources/works/**/*.png
/src/sources/works/**/*.jp2
/src/sources/works/**/*.epub
/src/sources/works/**/*.tar
/src/sources/works/**/*.traineddata
/src/sources/works/**/*.iff

# Frozen evidence and generated browser deliveries are resolved outside Git.
/release/papal-documents/inputs/
/src/web/data/
