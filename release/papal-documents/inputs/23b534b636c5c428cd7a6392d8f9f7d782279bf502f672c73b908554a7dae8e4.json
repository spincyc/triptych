  "layout_review": {
    "documents": [
      {
        "evidence": [
          {
            "index": 1,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "440cd52ccdbf267ff8c366b2c8e85d11e98c60981faee6c829fef9b7a828a2f7",
            "text": "Proemium"
          },
          {
            "index": 2,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "dedba59a674df0f2716c6207c66d33c2fef8480d07a129e3d65a786d8cf0cff5",
            "text": "Finis Iubilaei indicti"
          },
          {
            "index": 4,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "741d5aed65b26845c1cbb520f73a4f1b4944b82f1306344cb01795cabfe53e22",
            "text": "Fructus Iubilaei peracti"
          },
          {
            "index": 6,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "1e70bbbde1ed77afbbe3ca6b68cbf3577b5f390112a0d215f0f5a85ddd932da4",
            "text": "Quomodo hi fructus conservandi"
          },
          {
            "index": 9,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "a2ab3002fdf65a75310248f42cfad003f9fb0279a1d8678d7cd0296b63f5622a",
            "text": "Exercitiorum Spiritualium usus ad id commendandus ducitur"
          },
          {
            "index": 11,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "f96996fed9822471eff3b17a08594b9aea8a9f5562a18069fd2baa71ebb306e4",
            "text": "II. Exercitiorum spiritualium momentum, opportunitas, utilitas."
          },
          {
            "index": 12,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "e451b3cca30b9c1d198831cf529c1af60923a199fb871dd54b6a83ddbc6a3e6f",
            "text": "Pro nostra aetate potissimum."
          },
          {
            "index": 14,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "26ba9ec541d88e2db4875651fd5dd97854aa1701e4a7294dde1a8dffdc223e79",
            "text": "Ad efformandum hominem."
          },
          {
            "index": 18,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "e456c130c4435eddb6b602f23c4b991094d8b06b6c5f9c4ad683510bf9811e4b",
            "text": "Ad efformandum apostolum."
          },
          {
            "index": 20,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "81d7f24de711aa6240a9ff4c318c0714de12e3ea5406c2aa83538168f19be932",
            "text": "Exercitia spiritualia in ecclesiae historia."
          },
          {
            "index": 21,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "fb494a450069c3b724387df22883fbc3a87e710c0c0ad866fa73ee15641f0a04",
            "text": "In Ecclesiae exordio."
          },
          {
            "index": 24,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "081ca3875433b958304e020a82f4a85170753618e06f9c23f23115c1c665a894",
            "text": "S. Ignatius de Loyola."
          },
          {
            "index": 26,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "28ea0a067a0bd246638ff87d2373ec06d124386e339a7561075093592f90f5ac",
            "text": "S. Carolus Borromaeus."
          },
          {
            "index": 28,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "5a461adf1dadb09638aa360d0237317e9638ff5edc3771dbb98bb012daa7ca42",
            "text": "Domus peculiares Exercitiis habendis."
          },
          {
            "index": 30,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "c9b4416efdc8afd3c4cdb4552ee5bcf434ca230d3ce29c72f37936784d522bf4",
            "text": "Exercitia spiritualia pro variis hominum classibus."
          },
          {
            "index": 32,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "30a3e62bdea5a8a4743ccc0c9f50c778ce8b1d5fd61bb426be33115243a8f1f7",
            "text": "Pro Curia Pontificia."
          },
          {
            "index": 34,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "9e140459d35408c586ef67329adaf0765a90b95966ea8ef33b62883887d8581c",
            "text": "Pro Episcopis."
          },
          {
            "index": 36,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "ea677bfa2611c1ee1ce758574aefc09360bec43992c1d6cd4b2815d303c19c34",
            "text": "Pro Sacerdotibus et Religiosis."
          },
          {
            "index": 41,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "db79e50f7730f4bec04f8663861de7ceb1c5c0bc4a2bdf36b27f4af66a307531",
            "text": "Pro laicis Actionis Catholicae"
          },
          {
            "index": 43,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "59bcb0be18198dae47951a1812999846b43abed0022dfa8486da10d98654f4c6",
            "text": "Pro omnibus hominum coetibus."
          },
          {
            "index": 45,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "f7f450d92e0c7cb49f5fcf3edcb34f9943891adc86029bd5f261426c8173891d",
            "text": "Modus peragendi exercitia spiritualia."
          },
          {
            "index": 47,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "19eb8318fbb7976cbf4e8fb28c15a9d99651f8d10a79853c98a296c2bb3a8cef",
            "text": "Sollicitudo et quies ab exterioribus curis."
          },
          {
            "index": 49,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "cbe9ef9d2ca0e67534e55094e4f5c85da97454e9bd5fcdae009b050974aeea29",
            "text": "Congruum temporis spatium."
          },
          {
            "index": 51,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "ee3608dc929711d5fac144c1a3c4ccd6bb73683affc4ff21f6b52c2b0d5b2496",
            "text": "Methodus optima adhibenda."
          },
          {
            "index": 54,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "8f35f1565bc7fd301cbcd761c878e3ce1ccda22076cfa3c926b0d8d6ce533e06",
            "text": "Recollectio menstrua."
          },
          {
            "index": 56,
            "rule": "reviewed-source-heading-or-subtitle",
            "sha256": "4552f18cd40181cec230d78404ed6e5ffe2d61f57bc5d304be5a6bea616c5d9d",
            "text": "Conclusio."
          }
        ],
